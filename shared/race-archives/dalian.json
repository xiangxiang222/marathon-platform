  },
  "highlights": [
    {
      "title": "海港与广场建筑群",
      "body": "2026年从东港出发，沿线包括东方水城、中山广场、人民广场和南山风情街等地标；这些是景观节点，不能替代道路导航。",
      "sourceIds": [
        "dl-preview-2026"
      ],
      "applicableYears": [
        "2026"
      ]
    },
    {
      "title": "赛期并非固定季节",
      "body": "2024年官方预告为10月20日，2025年5月11日举办，2026年第36届于4月26日举办。",
      "sourceIds": [
        "dl-preview-2024",
