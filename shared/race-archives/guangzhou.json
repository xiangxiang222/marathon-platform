  "stories": [
    {
      "title": "2025：两秒定胜负",
      "body": "沃德腾塞先冲线，科瓦两秒后抵达海心沙。扎西次仁以2小时14分06秒获得男子第三；当届男子前八名有五位中国选手。这场比赛把国际选手的冲刺和中国选手的整体表现留在了同一张成绩单上。",
      "sourceIds": [
        "gz-results-2025"
      ]
    },
    {
      "title": "2025：随脚步流动的珠江",
      "body": "2025届完赛奖牌把广州的建筑群留在正面，以流沙表现江水；背面用立体线条勾勒广州塔。那届赛道亦沿用珠江两岸，从天河体育中心跑向海心沙。",
      "sourceIds": [
        "gz-kit-2025",
        "gz-map-2025"
      ]
    },
    {
      "title": "2024：男子前五名跑进旧纪录",
      "body": "该届全马规模为26000人，也是终点迁至海心沙的一年。格比塞·德贝莱以2小时06分28秒夺冠；组委会赛后回顾指出，男子前五名均快于此前广马赛会纪录。",
      "sourceIds": [
        "gz-city-review-2024",
        "gz-wa-2024"
      ]
    }
  ],
