{
  "raceId": "guangzhou",
  "updatedAt": "2026-11-18",
  "intro": "广州马拉松赛创办于2012年，以珠江“一江两岸”为代表性城市路线。赛道将天河体育中心、珠江桥梁与滨江城市景观连接起来；2023的全半马设置与近届全马赛事不同，项目和终点需逐年阅读。",
  "introSourceIds": [
    "gz-intro",
    "gz-reg-2026"
  ],
  "profile": {
    "foundingYear": "2012",
    "foundingYearSourceIds": [
      "gz-intro"
    ],
    "positioning": "以珠江两岸展示岭南文化与现代城市景观的城市马拉松。官网介绍记载2018年开始获得世界田联金标，档案保留该历史年份。",
    "positioningSourceIds": [
      "gz-intro",
      "gz-reg-2026",
      "guangzhou-caa-2026"
    ],
    "entryNotes": "2026届为30000人全马，超额抽签，并可能按实际缴费补录。报名时的存包选择与中签概率无关；年龄、成绩门槛及缴费期限均按该届须知核对。",
    "entrySourceIds": [
      "gz-entry-2026"
    ]
  },
  "highlights": [
    {
      "title": "一江两岸的路线骨架",
      "body": "2025规程从天河体育中心出发，经猎德大桥、滨江路、人民桥等路段抵达海心沙。桥梁、折返和不同滨江路段构成赛道阅读重点，不能仅凭“沿江”二字判断难度。",
      "sourceIds": [
        "gz-reg-2025"
      ],
      "applicableYears": [
        "2025"
      ]
    },
    {
      "title": "项目与终点均有变化",
      "body": "2023全马终点花城广场，另设半马；2025改为26000人全马，终点海心沙；2026计划30000人全马、海心沙星光大道终点。",
      "sourceIds": [
        "gz-reg-2023",
        "gz-reg-2025",
        "gz-reg-2026"
      ],
      "applicableYears": [
        "2023",
        "2025",
