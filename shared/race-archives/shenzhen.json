{
  "schemaVersion": 2,
  "raceId": "shenzhen",
  "updatedAt": "2026-11-18",
  "intro": "深圳马拉松创办于2013年。近年线路从市民中心沿深南大道展开，再进入深圳湾与前海，将现代城市大道、滨海休闲带和宝安终点连接起来。2024年为两万人全马，2025年规程计划扩至三万人；2026年比赛仍在筹备日期内，档案明确区分已发生的成绩与尚待确认的安排。",
  "introSourceIds": [
    "sz-history-2024",
    "sz-report-2024",
    "sz-regulations-2025",
    "shenzhen-caa-2026"
  ],
  "profile": {
    "foundingYear": "2013",
    "foundingYearSourceIds": [
      "sz-history-2024"
    ],
    "positioning": "以深南大道、深圳湾和前海为代表景观的城市马拉松。2026年世界田联日历为金标；该届尚未举办。",
    "positioningSourceIds": [
      "sz-report-2024",
      "shenzhen-wa-2026"
    ],
    "entryNotes": "2025年全马报名费200元，预报名后抽签、中签缴费；精英通道超额也抽签。以上规则不自动适用于2026年。",
    "entrySourceIds": [
      "sz-regulations-2025"
    ]
  },
  "highlights": [
    {
      "title": "从城市轴线跑向湾区景观",
      "body": "2024线路经过深南大道、深圳湾滨海休闲带、南头古城和前海石公园，最后到达宝安区海滨广场。",
      "sourceIds": [
        "sz-report-2024"
      ],
      "applicableYears": [
        "2024"
      ]
    },
    {
      "title": "扩容只写入对应届次",
