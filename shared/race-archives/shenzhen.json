      "sz-history-2024"
    ],
    "positioning": "以深南大道、深圳湾和前海为代表景观的城市马拉松。2026年世界田联日历为金标；该届尚未举办。",
    "positioningSourceIds": [
      "sz-report-2024",
      "shenzhen-wa-2026"
    ],
    "entryNotes": "2025年全马报名费200元，预报名后抽签、中签缴费；精英通道超额也抽签。以上规则不自动适用于2026年。",
    "entrySourceIds": [
      "sz-regulations-2025"
    ]
  },
  "highlights": [
    {
      "title": "从城市轴线跑向湾区景观",
      "body": "2024线路经过深南大道、深圳湾滨海休闲带、南头古城和前海石公园，最后到达宝安区海滨广场。",
      "sourceIds": [
        "sz-report-2024"
      ],
      "applicableYears": [
        "2024"
      ]
    },
    {
      "title": "扩容只写入对应届次",
