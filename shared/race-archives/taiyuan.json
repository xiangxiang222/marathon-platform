  "stories": [
    {
      "id": "ty-story-new-start-2024",
      "editionYear": "2024",
      "tag": "赛事故事",
      "title": "迎泽大街第一次成为起跑线",
      "summary": "2024太马把起点设在改造后的迎泽大街，从太原站西侧出发。",
      "body": "选手沿迎泽大街经过五一广场、迎泽公园和迎泽大桥，再进入汾河两岸的滨河路。下一届出发点改到五一广场；同一条城市轴线的不同起点，让前几公里看到的街景及参赛集合地点都发生了变化。",
      "sourceIds": [
        "ty-route-2024",
        "ty-report-2024",
        "ty-report-2025"
      ]
    },
    {
      "id": "ty-story-women-2026",
      "editionYear": "2026",
      "tag": "赛事故事",
      "title": "三位中国选手一同跑进旧纪录",
      "summary": "2026太马女子比赛，三名中国选手都快于2024年的中国籍旧纪录。",
      "body": "2024年白丽的中国籍纪录是2:31:16。2026年，路颖、刘敏和徐冰洁分别跑出2:29:45、2:30:40和2:31:10；路颖取得新的中国籍赛会纪录。巴林选手蒂吉斯特·加肖·贝莱在同场比赛跑出2:24:11，刷新的是女子公开组纪录。两项纪录同日升级，组别仍分别记录。",
      "sourceIds": [
        "ty-report-2026",
        "ty-wa-results-2026"
      ]
    },
    {
      "id": "ty-2026-two-distances",
      "editionYear": "2026",
      "tag": "报名与赛道",
      "title": "2026太马的四万名额分给全马和半马",
      "summary": "半马计划22000人，全马计划18000人。",
      "body": "2026太马组委会在竞赛规程中设置两个项目。全马18000人包含特邀选手，半马22000人。预报名从7月15日下午3时开始，7月29日23时59分截止。\n\n两项报名均先缴费，费用分别为200元和180元。未中签的选手在组委会公布抽签结果后按规程退费。\n\n两个距离同在五一广场起跑、长兴北街结束。全马过迎泽大桥后还有柴村桥、滨河东路折返以及祥云桥等路段。全马与半马各自的折返点以当届参赛手册标示为准。",
      "sourceIds": [
        "ty-rules-2026",
        "ty-handbook-2026"
      ]
    },
    {
      "id": "ty-2025-breakthrough",
      "editionYear": "2025",
      "tag": "报名与成绩",
      "title": "2025太马报名突破16万，半马女子改写赛会纪录",
      "summary": "山西省体育局赛后披露总中签率25%，刘敏以1小时12分29秒获半马女子冠军。",
      "body": "太原马拉松在2025年从五一广场发枪，赛事设置全马、半马、健康跑和欢乐跑，总规模4万人。山西省体育局赛后报道，报名人数超过16万，赛事总体中签率为25%。\n\n全程男女公开组冠军分别由肯尼亚选手道格拉斯·基普鲁古特和埃塞俄比亚选手科贝布什·兹沃德玛丽获得。\n\n半程女子组有两位选手快于此前1小时15分21秒的赛会最佳成绩。刘敏率先到达终点，成绩1小时12分29秒，郑小倩以1小时13分17秒获得第二。",
      "sourceIds": [
        "ty-provincial-sport-recap-2025",
        "ty-preview-2025"
      ]
    },
    {
      "id": "ty-2024-start-station",
      "editionYear": "2024",
      "tag": "赛道变化",
      "title": "2024太马把起跑区搬到太原站旁",
      "summary": "从迎泽大街进城，过迎泽大桥后再接入汾河两岸。",
      "body": "太原站旁的迎泽大街成为2024太原马拉松起点。组委会调整赛道后，五一广场和迎泽公园在起跑后的市中心路段相继出现。\n\n全马与半马越过迎泽大桥，沿滨河东西路奔向晋阳湖国际会展中心。迷你跑和家庭亲子跑则到望景路结束，附近分布着山西博物院等公共文化场馆。\n\n次年起点又从太原站移到五一广场。查看历史赛事时，起跑位置要随着年份对应，当届终点名称相近也不足以说明途中走法完全相同。",
      "sourceIds": [
        "ty-route-2024",
        "ty-report-2024",
        "ty-report-2025"
      ]
    }
  ],
