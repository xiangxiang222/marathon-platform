  "stories": [
    {
      "id": "cd-tenth-kit-2026",
      "title": "十年成马，熊猫跑进了奖牌和参赛服",
      "tag": "装备故事",
      "editionYear": "2026",
      "summary": "一对金银色奖牌、一件橙色参赛服，都留下了蓉城的熊猫印记。",
      "body": "2017年，成都举办了首届成马。十年后的发布会上，组委会用黑白分明的熊猫形态做设计：在奖牌上刻进芙蓉花与太阳神鸟，在橙色参赛服上让熊猫跑动回头。组委会还把虚拟赛道做进终点体验，扫码识别完赛奖牌后可回看沿路的动画。",
      "sourceIds": [
        "cd-history-2017",
        "cd-gear-release-2026"
      ]
    },
    {
      "id": "cd-story-underpass-2025",
      "editionYear": "2025",
      "tag": "赛事故事",
      "title": "路面少了两段下穿",
      "summary": "2025成马保留金沙到世纪城的城市路线，同时让跑者少进两处下穿隧道。",
      "body": "四川省体育局赛后回顾记载，2025路线取消了两处下穿和桂溪生态公园内部路段。第二年发布会又公布杜甫草堂、四川博物院、青羊宫和琴台路等新增点位。路线改善和城市景观不是同一个指标，读图时值得一起看，也要按自己的参赛年份分开。",
      "sourceIds": [
        "cd-report-2025",
        "cd-preview-2026"
      ]
    },
    {
      "id": "cd-story-draw-2026",
      "editionYear": "2026",
      "tag": "赛事故事",
      "title": "先抽签，再决定是否缴费",
      "summary": "2026成都马拉松调整报名流程，中签后才进入缴费阶段。",
      "body": "在以前报名时缴费、落签再退款的流程下，跑者先付钱再等结果。2026发布会公布改为报名后抽签，中签者限期缴费，另设退赛窗口。对隔年参赛的人来说，这项变化比沿用上一次保存的报名攻略更值得关注。",
      "sourceIds": [
        "cd-preview-2026"
      ]
    }
  ],
