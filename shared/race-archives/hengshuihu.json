  "stories": [
    {
      "id": "hs-story-lake-start-2025",
      "editionYear": "2025",
      "tag": "赛事故事",
      "title": "环湖起跑从一枪变成三枪",
      "summary": "2025衡马首次分三枪起跑，把全马和健康跑按时间分流。",
      "body": "跑者从衡水湖马拉松广场出发，发枪分别定在7:30、7:38和7:45，现场引入赛道智能语音播报。当天同时举办全国马拉松锦标赛第二站，因此新闻中的锦标赛冠军和大众组赛事总名次需要按各自口径阅读。",
      "sourceIds": [
        "hs-start-2025",
        "hs-race-2025"
      ]
    },
    {
      "id": "hs-story-pb-2024",
      "editionYear": "2024",
      "tag": "赛事故事",
      "title": "大赛成绩之外，还有3853次自己的纪录",
      "summary": "2024衡马报告把赛会名次与跑者个人最好成绩同时写进赛后回顾。",
      "body": "组委会称当年3853人刷新个人最好成绩，并分别列出赛事总排名与全国锦标赛优胜者。女子总排名第一的成绩为2:23:39；这项赛会纪录仅标为核实至2024届，不由这篇回顾推定后续年份的数据。",
      "sourceIds": [
        "hs-race-2024"
      ]
    },
    {
      "id": "hs-lifetime-bib-2026",
      "editionYear": "2026",
      "tag": "赛事故事",
      "title": "两年不计，连续五届才算终身号",
      "summary": "衡马十五周年报名须知用连续完赛记录认定终身号资格。",
      "body": "2026衡马报名须知为终身号列出可核对的年份：2019、2021、2023、2024、2025五届全马均按时完赛可获资格，2020和2022不计入连续届次。持终身号的选手仍须预报名，之后按系统流程缴费和选号。",
      "sourceIds": [
        "hs-signup-2026"
      ]
    },
    {
      "id": "hs-2025-entry-guide",
      "editionYear": "2025",
      "tag": "报名与装备",
      "title": "衡马2025两类跑者的报名截止日不同",
      "summary": "全马7月31日截止，健康跑报名延续到8月10日。",
      "body": "衡水湖马拉松在7月27日上午同时开放全马和健康跑报名。全马报名窗口到7月31日17时，健康跑持续到8月10日同一时刻。组委会采用预报名、抽签、缴费的步骤。\n\n赛事给全马安排12000人、健康跑8000人。全马150元、健康跑50元。连续五届按规定完成全马的跑者符合规则时可走终身号通道，2020年和2022年从连续届次中跳过。\n\n完赛奖牌的中心是一组可旋转的花瓣，花瓣里面藏着可取出的成绩纪念装置。赛后人民日报报道，全国锦标赛第二站男子冠军为解云策，女子冠军为跑出2小时28分10秒的徐冰洁。",
      "sourceIds": [
        "hs-entry-report-2025",
        "hs-fee-2025",
        "hs-race-2025"
      ]
    },
    {
      "id": "hs-2024-two-standings",
      "editionYear": "2024",
      "tag": "成绩",
      "title": "1554名跑者在衡水湖跑进三小时",
      "summary": "新华社赛后统计同时记录了148名跑进2小时30分的选手。",
      "body": "2024年9月22日，衡水湖马拉松在湖畔开跑。跑者从马拉松广场出发，绕湖后回到同一广场。新华社报道，赛道平均海拔22米，共有10处拐弯。\n\n公开组男女冠军分别是肯尼亚选手基普科里尔和埃塞俄比亚选手安姆特，后者以2小时23分39秒改写女子赛会纪录。同期全国锦标赛第二站另有排名，中国选手丰配友、次仁措姆分获男女冠军。\n\n赛后统计中，1554名选手跑进三小时，其中148人跑进2小时30分。这个统计针对达到成绩门槛的选手，无法从中读出赛事的全部完赛人数。",
      "sourceIds": [
        "hs-xinhua-recap-2024"
      ]
    },
    {
      "id": "hs-2026-five-editions",
      "editionYear": "2026",
      "tag": "报名",
      "title": "衡马终身号按连续五届全马核定",
      "summary": "2026报名须知列明跳过2020年和2022年。",
      "body": "2026年衡水湖马拉松的终身号延续了逐届累计规则。符合条件的跑者需要连续五届完成全马，核算时跳过2020年和2022年，仍需在报名窗口内提交预报名。\n\n普通全马选手从7月24日10时开始预报名，至7月30日18时结束。报名达到上限后抽签，中签运动员按规定缴费，首轮未中签的选手等待后续抽签安排。\n\n当届全马的起终点都在衡水湖马拉松广场。最终全马男子冠军为李子成，女子冠军为冯丹，成绩分别是2小时15分08秒、2小时34分07秒。",
      "sourceIds": [
        "hs-signup-2026",
        "hs-reg-2026",
        "hs-result-2026"
      ]
    }
  ],
