  "stories": [
    {
      "title": "2026：从13公里出发，下一站是半马",
      "body": "武汉市政府网站在2026届赛前报道了艾斌的备赛：膝盖骨折、韧带断裂后，他逐步重拾运动，在2025届完成13公里跑，把奖牌、号码布和证书装框留念。到2026年，他为自己定下了半马目标。",
      "sourceIds": [
        "wh-history"
      ]
    },
    {
      "title": "2024：用编钟和楚剧为选手加油",
      "body": "2024届赛道沿线设置了40多个音乐加油站，编钟、楚剧和汉味乐队各有一站。男子冠军约翰·姆布鲁·姆伊鲁利在赛后提到，沿途的音乐、舞蹈和跑友的加油声给他留下了很深的印象。",
      "sourceIds": [
        "wh-result-2024"
      ]
    },
    {
      "title": "2026：把明金锭和漆盘放进一枚奖牌",
      "body": "完赛奖牌主体参考湖北省博物馆馆藏明金锭；内圈借鉴花瓣形漆盘，红黑相间，还可以转动。赛事把两种不同材质和年代感的元素结合起来，让跑者把荆楚文物的细节带回家。",
      "sourceIds": [
        "wh-kit-2026"
      ]
    }
  ],
