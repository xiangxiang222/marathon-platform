{
  "raceId": "wuhan",
  "updatedAt": "2026-11-20",
  "intro": "武汉马拉松首届于2016年4月10日举行。赛事以跨江越湖的城市穿行呈现武汉三镇，春季樱花与江湖景观构成鲜明体验；2026届终点移至青山江滩，说明汉马路线也在持续更新。",
  "introSourceIds": [
    "wh-history",
    "wh-reg-2026"
  ],
  "profile": {
    "foundingYear": "2016",
    "foundingYearSourceIds": [
      "wh-history"
    ],
    "positioning": "以武汉三镇、长江桥梁和湖泊景观为舞台的城市路跑赛事。",
    "positioningSourceIds": [
      "wh-history",
      "wh-reg-2026",
      "wuhan-caa-2026"
    ],
    "entryNotes": "汉马近届采用超额抽签，并按项目区分出发与终点。2026取消13公里跑后仅设全马、半马；不可沿用2025的项目选择、终点和关门表。",
    "entrySourceIds": [
      "wh-reg-2026",
      "wh-reg-2025",
      "wh-entry-2026"
    ]
  },
  "highlights": [
    {
      "title": "从江滩到江滩的2026新路线",
      "body": "2026起点仍在沿江大道三阳路口，马拉松终点改为青山江滩；官方城市回顾说明该届首次串联全部七个中心城区。此变化不能套用至2024、2025届。",
      "sourceIds": [
        "wh-history",
        "wh-reg-2026"
      ],
      "applicableYears": [
        "2026"
      ]
    },
    {
      "title": "樱花与城市风味",
      "body": "2024、2025组委会回顾记录沿江大道、东湖等春日风景以及音乐加油、热干面和樱花糕点等特色活动。特色补给为当届安排，跑者仍需按个人训练中的补给方案参赛。",
      "sourceIds": [
        "wh-result-2024",
        "wh-result-2025"
      ],
      "applicableYears": [
        "2024",
        "2025"
      ]
    }
