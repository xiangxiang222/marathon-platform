  "stories": [
    {
      "title": "2024：从新加坡海滨和洛杉矶跑回蠡湖",
      "body": "无锡市体育局刊载的赛前报道记录了两段不同的备赛路线：新加坡椰风跑团十多位跑友沿狮城海滨做了32公里长距离训练；从洛杉矶回到无锡的跑者老金，则与老朋友绕蠡湖训练。他特地回到家乡参加锡马。",
      "sourceIds": [
        "wx-history-2024"
      ],
      "editionYear": "2024"
    },
    {
      "title": "2026：跑团比的也是配合",
      "body": "2026届全马跑团赛要求每队15人、至少4名女性。团体排名取前两名女性，再从其余队员中选净计时最快的8人，计算平均成绩。赛后公示中，湘军跑团以2小时22分40秒的平均成绩排在第一。",
      "sourceIds": [
        "wx-regulations-2026",
        "wx-results-2026"
      ],
      "editionYear": "2026"
    },
    {
      "title": "锡马奖牌里藏着一扇会亮的窗",
      "editionYear": "2026",
      "body": "2026锡马把江南窗格做进全马与半马的完赛牌。按下背面的玉飞凤按键，内层亮起；把手机贴近绶带上的NFC感应区，还能查看参赛者的完赛数据。",
      "sourceIds": [
        "wx-recap-2026"
      ]
    }
