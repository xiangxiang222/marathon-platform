  "stories": [
    {
      "id": "lz-story-yellow-river-2026",
      "editionYear": "2026",
      "tag": "奖牌与参赛服",
      "title": "奖牌上的黄河，终点的一碗面",
      "summary": "兰马将黄河放进完赛纪念，赛道沿江展开，终点延续兰州牛肉面服务。",
      "body": "2026兰州马拉松全马、半马都从兰州奥体中心一带起跑。对全马跑者，黄河不只是远处的景色，两岸公路和跨河大桥共同组成赛道。\n\n赛后报道介绍，奖牌沿用黄河的城市线索。跑完才能领到的奖牌，和赛后现场供应的兰州牛肉面，分别让跑者带走一份纪念、留下一个味道。\n\n这届还为跑出个人最好成绩的选手提供专属证书与成绩展示。计时、奖牌和完赛服务由不同环节提供，具体领奖资格按当届规程。",
      "sourceIds": [
        "lz-report-2026",
        "lz-course-original-2026",
        "lz-regulations-2026"
      ]
    },
    {
      "id": "lz-draw-2026",
      "editionYear": "2026",
      "tag": "报名",
      "title": "36万人预报名，中签后还有体检和缴费",
      "summary": "2026兰马公布361356人预报名。当届还安排二次抽签和按序候补。",
      "body": "甘肃网络广播电视报道，2026兰马累计接收361356人预报名。规程公布了全马25000席、半马8000席的计划，各项目实际进入抽签的有效人数仍需单独的统计。\n\n3月6日上午公布首轮结果。抽中之后须提交体检报告，通过审核者于3月15日10时至17日17时缴费。\n\n第二轮及候补结果于3月19日公布。二次中签并通过体检审核者另有3月27日至29日的缴费窗口，3月30日开始按序通知候补。",
      "sourceIds": [
        "lz26-draw-gs",
        "lz-regulations-2026"
      ]
    },
    {
      "id": "lz-story-lifetime-2025",
      "editionYear": "2025",
      "tag": "报名",
      "title": "第八次跑完兰马之后",
      "summary": "2025兰马保留累计八届全马的终身号通道，普通报名仍采用抽签。",
      "body": "2025兰马有311352人预报名。其中，全马报名101745人，半马报名93146人，其余是健康跑和家庭跑。四个项目的名额和流程并不一样。\n\n全马报名中有一条为老跑者保留的资格。此前累计完成八届兰州马拉松全马且通过审核的人，可以申请终身号。2025年也为全马和半马另设150个公益名额。\n\n这一届普通报名没有成绩直通，抽中全马或半马后仍需经过体检审核再缴费。候补也须在预报名时作出选择。",
      "sourceIds": [
        "lz-registration-2025",
        "lz-applicants-2025",
        "lz-entry-rules-2025"
      ]
    },
    {
      "id": "lz-results-2024",
      "editionYear": "2024",
      "tag": "成绩",
      "title": "从奥体中心出发，女子冠军跑出2:24:46",
      "summary": "玛格德琳·马赛赢下2024女子全马，男子冠军是阿费沃尔克·梅斯芬。",
      "body": "2024年5月26日，兰马从奥体中心起跑。全马跑上金雁大桥并沿北岸折返，经过银滩黄河大桥回到南岸。半马在雁白大桥站附近结束。\n\n赛事官网记录，男子全马冠军阿费沃尔克·梅斯芬跑出2:10:23，女子冠军玛格德琳·马赛用时2:24:46。贾俄仁加以2:14:33拿到中国籍男子第一。\n\n2:24:46是2024届刷新赛会纪录时的用时。2025年女子公开组三位选手均已跑得更快，现行纪录还要由历届成绩与官方纪录认定共同确认。",
      "sourceIds": [
        "lz-report-2024",
        "lz-competition-rules-2024",
        "lz-podium-2025"
      ]
    }
  ],
