  "stories": [
    {
      "id": "cs-story-anniversary-medal",
      "editionYear": "2024",
      "tag": "赛事故事",
      "title": "十片火苗围成十周年",
      "summary": "2024长马十周年奖牌上的火苗，是一枚可以刻名字的小纪念。",
      "body": "十片火苗朝奖牌中心旋转，正面留出十周年标识。最上方的火苗背面装有磁铁，可以拆下刻姓名。两年后，组委会又面向历届跑者征集奖牌、号码布和老照片，让旧奖牌有机会带着主人记得的那一段赛道再次亮相。",
      "sourceIds": [
        "cs-history-2024",
        "cs-preview-2026"
      ]
    },
    {
      "id": "cs-story-isle-2025",
      "editionYear": "2025",
      "tag": "赛事故事",
      "title": "把进橘子洲的时刻往后移",
      "summary": "2025长马将进入橘子洲的路段安排到约10公里。",
      "body": "起点从贺龙体育场东广场移到杜甫江阁旁后，跑者先在湘江路完成路段和折返，再经橘子洲大桥上岛。发布会把缓解赛道前段拥挤列为调整原因。橘子洲仍是长马的标志景观，但它在跑者比赛节奏中的位置可以随届改变。",
      "sourceIds": [
        "cs-preview-2025"
      ]
    },
    {
      "id": "cs-story-medical-pacer",
      "editionYear": "2026",
      "tag": "赛事人物",
      "title": "给需要帮忙的跑者留一点余力",
      "summary": "曾和跑友绕橘子洲夜跑的郑曦，2026年第四次成为长马急救跑者。",
      "body": "郑曦从和跑友绕橘子洲夜跑起步，后来参加岳麓区红十字会培训，从2022年开始以急救跑者身份参赛。2026年他在3小时50分左右的队列服务。组委会的人物稿记录了配速分组和赛前三次培训：这些跑者把速度留在自己的纪录之外，把位置留在人群之中。",
      "sourceIds": [
        "cs-story-official-2026"
      ]
    }
  ],
