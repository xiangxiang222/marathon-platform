      "sourceIds": [
        "cs-history-2024"
      ]
    },
    {
      "date": "2024-10-20",
      "title": "十年长马的线下相聚",
      "body": "赛事以30000人规模举办；国家体育总局回顾称截至当时累计7届线下与3届线上，不将两者混算为线下届次。",
      "sourceIds": [
        "cs-history-2024"
      ]
    },
    {
      "date": "2025-07-30",
      "title": "宣布起点与橘子洲路段调整",
      "body": "发布会公布起点移至湘江中路、延后进入橘子洲的方案。",
      "sourceIds": [
        "cs-preview-2025"
      ]
    },
    {
      "date": "2026-11-15",
      "title": "全马与半马两项目举行",
      "body": "2026年全马18000人、半马17000人，赛事报道确认实际开赛。",
      "sourceIds": [
        "cs-report-2026"
      ]
    }
  ],
