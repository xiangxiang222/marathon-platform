{
  "schemaVersion": 2,
  "raceId": "changsha",
  "updatedAt": "2026-11-18",
  "intro": "长沙马拉松自2015年创办，将湘江、橘子洲、岳麓山与洋湖等景观带入城市跑步线路。长马的阅读重点是沿江起跑与跨江路段的年度组织：2025年调整起点并延后进入橘子洲，2026年半程终点转到渔人码头，项目也收敛为全马和半马。",
  "introSourceIds": [
    "cs-history-2024",
    "cs-preview-2025",
    "cs-preview-2026"
  ],
  "profile": {
    "foundingYear": "2015",
    "foundingYearSourceIds": [
      "cs-history-2024"
    ],
    "positioning": "依托湘江两岸、橘子洲与岳麓文化景观的城市马拉松。2026年中国田协条目为A类；世界田联等级未核实，暂不标注。",
    "positioningSourceIds": [
      "cs-history-2024",
      "changsha-caa-2026"
    ],
    "entryNotes": "2026年预报名超过19万人，需区分报名总数、抽签资格人数与实际抽签名额；领物须预约并本人到场。",
    "entrySourceIds": [
      "cs-preview-2026",
      "cs-collection-2026"
    ]
  },
  "highlights": [
    {
      "title": "进橘子洲的节奏曾被调整",
      "body": "2025年起点移至杜甫江阁旁，官方解释将进入橘子洲延后至约10公里，以减轻早段拥挤。",
      "sourceIds": [
        "cs-preview-2025"
      ],
      "applicableYears": [
        "2025"
      ]
    },
    {
      "title": "半马终点要按年份确认",
      "body": "2025年发布会写明西湖公园东门，2026年则为渔人码头；同行人员接应和住宿安排应随届更新。",
      "sourceIds": [
        "cs-preview-2025",
        "cs-preview-2026"
      ],
      "applicableYears": [
        "2025",
        "2026"
      ]
    },
    {
      "title": "湖湘景观与城市助威",
      "body": "2026年赛后报道记录橘子洲头、岳麓山、洋湖湿地等景观，以及68处助威点；属于该届现场体验。",
      "sourceIds": [
        "cs-report-2026"
      ],
      "applicableYears": [
        "2026"
      ]
    }
  ],
  "history": [
    {
      "date": "2015",
