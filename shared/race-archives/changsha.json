        "cs-preview-2026"
      ],
      "applicableYears": [
        "2025",
        "2026"
      ]
    },
    {
      "title": "湖湘景观与城市助威",
      "body": "2026年赛后报道记录橘子洲头、岳麓山、洋湖湿地等景观，以及68处助威点；属于该届现场体验。",
      "sourceIds": [
        "cs-report-2026"
      ],
      "applicableYears": [
        "2026"
      ]
    }
