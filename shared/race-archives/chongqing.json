  "stories": [
    {
      "title": "2024：从龙门浩老街跑向慈云寺",
      "body": "2024届全马沿南滨路江岸，从海棠烟雨公园起跑，经过龙门浩老街、故宫文物南迁纪念馆和慈云寺。赛道的变化很小，同一届却见证此前分别保持多年的男女赛会纪录同时改写。",
      "sourceIds": [
        "cq-xinhua-2024",
        "cq-people-2024"
      ]
    },
    {
      "title": "2025：最后百米才分出胜负",
      "body": "据青海省体育局赛后介绍，2025重马的中国籍男子组争夺一直持续到终点前。青海选手尹顺金在最后约100米超过杨定宏，拿到中国籍男子第一。",
      "sourceIds": [
        "cq-yin-2025"
      ]
    },
    {
      "title": "2026：全场第二改写中国籍男子纪录",
      "body": "丰配友在2026届以公开组第二名完赛，赛后贵州省体育局确认他刷新了重马中国籍男子赛会纪录。",
      "sourceIds": [
        "cq-domestic-record-2026",
        "cq-results-2026"
      ]
