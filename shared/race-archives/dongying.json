  "stories": [
    {
      "title": "2024：男子前三名均跑进旧赛会纪录",
      "body": "2024届下雨，男子前三名仍分别跑出2小时05分52秒、2小时06分22秒和2小时07分17秒，均快于原赛会纪录2小时08分27秒。冠军来自肯尼亚；组委会后两届成绩中，男子冠军均未超过这一成绩。",
      "sourceIds": [
        "dy-race-2024",
        "dy-wa-2025",
        "dy-wa-2026"
      ]
    },
    {
      "title": "2025：沿线的83支助威队伍招募计划",
      "body": "东营市体育局在2025届比赛前招募83支沿途助威队伍，每队40至50人，可报名带来乐队、舞蹈、拉拉操等表演。83支是招募目标；公开公告没有列出最终到场名单。",
      "sourceIds": [
        "dy-cheering-2025"
      ]
    },
    {
      "title": "2026：全马先发，两批半马接力出发",
      "body": "2026届组委会采用三枪起跑：全马先出发，半马分两枪。不同项目的跑者在胜利大街和胶州路分流集结；档案的赛道入口保留当届组委会路线图，便于区分两条路线。",
      "sourceIds": [
        "dy-review-2026",
        "dy-map-2026"
      ]
    },
    {
      "title": "2025：两位女子选手成绩表上同秒",
      "body": "世界田联成绩表上，穆卢哈布特·策加和阿费拉·戈德法伊都跑出2小时26分36秒，名次依然分列第一、第二；中国跑者黄雪梅列第三。",
      "sourceIds": [
        "dy-wa-2025"
      ]
    }
  ],
