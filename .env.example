PORT=3790
BASE_PATH=/marathon
NODE_ENV=production
# 本地库路径。不填则用 server/data/app.sqlite。测试会自己建临时库。
# MARATHON_DB=
# 两场全马比赛日相距少于此天数时提醒。默认 21。
# FULL_MARATHON_GAP_DAYS=21
# 赛历后台账号。第一次启动时写入数据库，之后在页面上改密码。不要提交到仓库。
# ADMIN_USER=
# ADMIN_PASSWORD=
# 给脚本用的后台口令。页面登录不用填这个。不填则不按口令放行。
# ADMIN_TOKEN=
# Grok 上传比赛详情的口令。不填则上传接口不放行。不要提交到仓库。
# GROK_BOT_TOKEN=

# 协议中心：只填写已核实、允许公开的信息。缺失时 /api/legal 返回待确认版本。
# 核实项目：docs/legal/README.md；不要把示例邮箱、测试主体当成真实联系方式。
# LEGAL_CONTACT_EMAIL=
# LEGAL_CONTACT_ADDRESS=
# LEGAL_STORAGE_REGION=
# 腾讯云合同中的真实受托法律主体，不能只填产品品牌。
# LEGAL_HOSTING_ENTITY=
# 完成主体核验后方可设 true。
# LEGAL_OPERATOR_CONFIRMED=false
# 完成文档及实际数据流程验收后方可设 true，此标记不代表自动合规认证。
# LEGAL_PUBLICATION_CONFIRMED=false
# 核实并确定正式生效日期后填写 YYYY-MM-DD。
# LEGAL_EFFECTIVE_DATE=
