page {
  min-height: 100%;
  background: #f5f6fa;
  color: #1f2026;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.45;
}

button, input, textarea {
  font-family: inherit;
  color: #1f2026;
}

button {
  margin: 0;
  border: 0;
  min-height: 80rpx;
  border-radius: 16rpx;
  background: #f0f1f6;
  font-size: 30rpx;
}

input, textarea {
  box-sizing: border-box;
  border: 1rpx solid #f0f1f5;
  border-radius: 16rpx;
  background: #f5f6fa;
  color: #1f2026;
  font-size: 30rpx;
}

button::after { border: 0; }

.pad { padding: 24rpx; }
.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 24rpx;
  background: #fff;
}
.muted { color: #8a8e99; font-size: 26rpx; }
.slot {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f5f6fa;
  font-size: 30rpx;
}
.slot-state { color: #8a8e99; font-size: 26rpx; }
.teal { color: #ff0a30; }
.title { font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}
.row .k { flex: none; color: #8a8e99; }
.soon { color: #c87825; }
.err { margin-top: 8rpx; color: #c73540; font-size: 26rpx; }
.note { margin-top: 8rpx; color: #ff0a30; font-size: 26rpx; }
.empty { padding: 48rpx 24rpx; color: #8a8e99; text-align: center; }

.field { display: flex; align-items: center; gap: 16rpx; }
.field input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #fff;
}
.btn {
  display: block;
  margin: 0;
  padding: 0 28rpx;
  min-height: 80rpx;
  border-radius: 16rpx;
  background: #ff0a30;
  color: #fff;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}
button.ghost {
  margin: 16rpx 16rpx 0 0;
  padding: 0 24rpx;
  min-height: 80rpx;
  border-radius: 16rpx;
  background: #f0f1f6;
  color: #1f2026;
  font-size: 26rpx;
  line-height: 80rpx;
}
button.ghost.on { background: #ff0a30; color: #fff; }
button[disabled], button.btn[disabled] { background: #f0f1f6; color: #a5a9b2; }
.chip {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #f0f1f6;
  color: #8a8e99;
  font-size: 22rpx;
}
.login-go {
  display: block;
  height: 80rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #ff0a30;
  color: #fff;
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
}
.foot {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #8a8e99;
  font-size: 26rpx;
}
