bottom button{color:var(--text-secondary);background:none;font-size: 12px;min-height:44px;text-align:left;padding:0;margin:12rpx 0 0}.state{padding:40rpx;color:var(--text-secondary);font-size: 12px;line-height:1.9;text-align:center}.rights-card {margin-top:31rpx; background: #ffffff; }.rights-card>.summary{margin-top:20rpx  }.field-label{font-size: 12px;color:var(--text-secondary);line-height:1.8;margin:29rpx 0 15rpx}.type-picker{display:flex;align-items:center;justify-content:space-between;gap:15rpx;padding:23rpx;background:var(--page-bg);border:1rpx solid var(--border);font-size: 12px;color:var(--text-secondary);line-height:1.8}.rights-card textarea{box-sizing:border-box;width:100%;min-height:250rpx;line-height:1.95;font-size: 14px;padding:25rpx;border:1rpx solid var(--border);background:var(--page-bg);color:var(--text-secondary)}.close-note{font-size: 12px;color:var(--text-secondary);background:var(--page-bg);line-height:1.9;padding:24rpx;border-radius:15rpx;margin-top:25rpx}.primary{background:var(--brand);color:#fff;font-size: 12px;line-height:1.6;min-height:44px;padding:23rpx 25rpx;margin:28rpx 0 0;font-weight:600}.request-message{font-size: 12px;line-height:1.9;color:var(--text-secondary);background:var(--brand-soft);padding:23rpx;border-radius:14rpx;margin-top:27rpx}.request-list{margin-top:42rpx;border-top:1rpx solid var(--border);padding-top:32rpx}.list-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.list-heading button{font-size: 12px;color:var(--text-secondary);background:none;min-height:44px;margin:0;padding:15rpx 0}.request-record{border:1rpx solid var(--border);border-radius:18rpx;padding:26rpx;margin-top:25rpx}.request-status{color:var(--text-secondary);font-size: 12px;line-height:1.8}.request-title{font-size: 14px;color:var(--text-secondary);line-height:1.7;margin-top:11rpx}.request-date{font-size: 12px;color:var(--text-secondary);margin-top:8rpx;line-height:1.8}.request-detail,.response{font-size: 12px;color:var(--text-secondary);line-height:1.95;white-space:pre-wrap;margin-top:21rpx;word-break:break-all}.response{background:var(--page-bg);padding:22rpx;border-radius:13rpx;color:var(--text-secondary)}.response>view:first-child{font-size: 12px;color:var(--text-secondary);margin-bottom:12rpx}button::after{border:0}button[disabled]{opacity:.5}

.operator-card {background: #ffffff;border:1rpx solid var(--border);padding:36rpx;margin-bottom:26rpx}.operator-field{display:flex;gap:24rpx;font-size: 12px;line-height:1.9;margin-top:18rpx;color:var(--text-secondary)}.operator-field>text:first-child{width:160rpx;flex:none;color:var(--text-secondary)}.operator-field>text:last-child{flex:1;min-width:0;word-break:break-all}

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-legal-legal .document-card, .mini-legal-legal .rights-card, .mini-legal-legal .operator-card { border-radius: 36rpx; }
.mini-legal-legal .primary, .mini-legal-legal .type-picker { border-radius: 24rpx; }
.mini-legal-legal .document-nav { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-legal-legal { color: var(--text); }
.mini-legal-legal button { font-weight: 500; border-radius: 24rpx; }

.legal-page { color: var(--text); background: transparent; }
.hero-title { font-size: 26px; font-weight: 600; }
.document-card { border: 1px solid var(--border); background: #ffffff; }
.rights-card { border: 1px solid var(--border); background: #ffffff; }
.operator-card { border: 1px solid var(--border); background: #ffffff; }
.document-nav { gap: 20rpx; padding: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; }
.document-nav button { position: relative; padding: 12rpx 0; border-radius: 0; background: transparent; font-size: 13px; }
.document-nav button.active { color: var(--text); background: transparent; box-shadow: inset 0 -2px var(--brand); }
.document-nav button text { color: var(--text-secondary); font-size: 11px; }
.paragraph,.summary,.list-item { color: var(--text); font-size: 14px; line-height: 1.9; }
.rights-card textarea,.type-picker { border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); font-size: 14px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-legal-legal .primary { font-size: 14px; font-weight: 500; }
.cell-value,.request-detail,.response { font-size: 14px; line-height: 1.85; }
