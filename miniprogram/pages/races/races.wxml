<view class="page mini-races-races">
  <view class="home-navigation">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="home-nav" style="height: {{navHeight}}px; padding-right: {{headerRight}}px;">
      <navigator class="home-calendar-link" url="/pages/calendar/calendar"><view class="calendar-mark"></view><text>{{todayLabel}}</text><text aria-hidden="true">›</text></navigator>
    </view>
  </view>
  <view class="home-header">
    <view class="home-search-area">
    <view class="search">
      <view class="lens"></view>
      <input class="search-input" placeholder-class="search-placeholder" placeholder="搜赛事名称或城市" value="{{q}}" bindinput="onQ" bindconfirm="load" confirm-type="search" aria-label="搜赛事名称或城市" />
      <button class="find" bindtap="load" aria-label="搜索赛事"><text>搜索</text></button>
    </view>
    </view>
    <block wx:if="{{!searching}}">
      <view class="quick-entries">
        <navigator class="quick-entry" url="/pages/calendar/calendar">
          <image class="quick-icon" src="/images/quick-calendar.png" mode="aspectFit" />
          <text>赛事日历</text>
        </navigator>
        <navigator class="quick-entry" url="/pages/radar/radar">
          <image class="quick-icon" src="/images/quick-radar.png" mode="aspectFit" />
          <text>拿奖雷达</text>
        </navigator>
        <navigator class="quick-entry" open-type="switchTab" url="/pages/clubs/clubs">
          <image class="quick-icon" src="/images/quick-clubs.png" mode="aspectFit" />
          <text>发现跑团</text>
        </navigator>
        <navigator class="quick-entry" url="/pages/news/news">
          <image class="quick-icon" src="/images/quick-news.png" mode="aspectFit" />
          <text>跑圈资讯</text>
        </navigator>
      </view>
    </block>
  </view>

  <view wx:if="{{!searching}}" class="home-discover">
    <navigator url="/pages/calendar/calendar" class="discover-calendar">
      <view class="discover-copy"><text class="discover-kicker">赛事日历</text><text class="discover-title">近期赛历</text><text class="discover-sub">{{races[0].raceDate || '选择你的比赛日'}}</text><text class="discover-race-name">{{races[0].name || '按日期查找，安排下一场比赛'}}</text></view><image class="calendar-art" src="/images/quick-calendar.png" mode="aspectFit" />
    </navigator>
    <view class="discover-side">
      <navigator url="/pages/news/news?tab=athlete" class="discover-person"><view><text class="discover-card-title">见证中国速度</text><text class="discover-card-sub">赛季成绩 · 人物履历</text></view><image src="/images/quick-radar.png" mode="aspectFit" /></navigator>
      <navigator url="/pages/news/news" class="discover-news"><view><text class="discover-card-title">跑圈新鲜事</text><text class="discover-card-sub">资讯 · 官兔 · 跑团</text></view><image src="/images/quick-news.png" mode="aspectFit" /></navigator>
    </view>
  </view>

  <view wx:if="{{!searching}}" class="home-race-catalog">
    <view class="catalog-heading"><text class="catalog-title">热门赛事档案</text><navigator class="catalog-all" url="/pages/race-catalog/race-catalog">全部档案 <text aria-hidden="true">›</text></navigator></view>
    <view class="catalog-intro">历年路线、中签与完赛记忆</view>
    <view wx:if="{{catalogError}}" class="catalog-state"><text>{{catalogError}}</text><button class="catalog-retry" bindtap="loadCatalog">重试</button></view>
    <view wx:elif="{{!catalogLoaded}}" class="catalog-state"><text>正在加载赛事档案…</text></view>
    <view wx:elif="{{!catalogRaces.length}}" class="catalog-state"><text>赛事档案整理中</text></view>
    <view wx:else class="catalog-grid">
      <navigator wx:for="{{catalogRaces}}" wx:key="id" class="catalog-race" url="/pages/race-archive/race-archive?id={{item.id}}">
        <image wx:if="{{item.landmarkSrc}}" class="catalog-landmark" src="{{item.landmarkSrc}}" mode="aspectFit" aria-hidden="true" />
        <view class="catalog-race-name">{{item.name}}</view>
        <view class="catalog-certifications">
          <view><text>田联 · {{item.waLabel}}</text><text wx:if="{{item.waYear}}" class="catalog-certification-year">{{item.waYear}}年</text></view>
          <view><text>田协 · {{item.caaLabel}}</text><text wx:if="{{item.caaYear}}" class="catalog-certification-year">{{item.caaYear}}年</text></view>
          <text wx:if="{{item.certificationYear}}" class="catalog-certification-year">{{item.certificationYear}}认证</text>
        </view>
        <view wx:if="{{item.archiveCount}}" class="catalog-editions">{{item.archiveCount}}届档案 <text aria-hidden="true">›</text></view>
      </navigator>
    </view>
  </view>

  <view wx:if="{{!searching && reminders.length}}" class="reminder">
    <swiper class="reminder-swiper" autoplay="{{reminders.length > 1}}" interval="{{5000}}" duration="{{350}}" circular="{{true}}">
      <swiper-item wx:for="{{reminders}}" wx:key="key">
        <navigator class="reminder-item" url="/pages/race/race?id={{item.race.id}}">
          <view class="reminder-clock"></view>
          <view class="reminder-copy">
            <view class="reminder-reason">{{item.hit.reason}}</view>
            <view class="reminder-name">{{item.race.name}}</view>
          </view>
          <text class="reminder-arrow">›</text>
        </navigator>
      </swiper-item>
    </swiper>
  </view>

  <view class="results">
    <view class="results-head"><text class="results-title">{{searching ? '搜索结果' : '全部赛事'}}</text><text class="total">{{loaded ? (searching ? '' : statusLabel + ' · ') + total + ' 场' : '正在加载赛事'}}</text></view>
    <view wx:if="{{!searching}}" class="filter-panel">
      <view class="filter-top"><view class="kind-options" role="group" aria-label="赛事类型"><button wx:for="{{kinds}}" wx:key="kind" class="kind-tab {{kind === item.kind ? 'on' : ''}}" aria-pressed="{{kind === item.kind}}" aria-label="{{item.short}}" data-kind="{{item.kind}}" bindtap="setKind">{{item.short}}</button></view><button class="filter-more {{meet || status !== 'upcoming' ? 'on' : ''}}" data-sheet="status" bindtap="openSheet" aria-label="更多筛选"><view class="filter-icon" aria-hidden="true"></view>筛选</button></view>
      <view class="filter-row"><button class="filter-chip {{city ? 'on' : ''}}" data-sheet="city" bindtap="openSheet" aria-label="比赛地点"><text>{{city || '地点'}}</text><view class="chip-arrow" aria-hidden="true"></view></button><button class="filter-chip {{month ? 'on' : ''}}" data-sheet="time" bindtap="openSheet" aria-label="比赛时间"><text>{{month ? monthLabel : '时间'}}</text><view class="chip-arrow" aria-hidden="true"></view></button><button class="filter-chip {{full ? 'on' : ''}}" data-which="full" bindtap="toggleDist" aria-label="马拉松" aria-pressed="{{full}}">全马</button><button class="filter-chip {{half ? 'on' : ''}}" data-which="half" bindtap="toggleDist" aria-label="半程马拉松" aria-pressed="{{half}}">半马</button></view>
    </view>
    <view wx:if="{{!searching && filterSummary}}" class="filter-summary"><text>{{filterSummary}}</text><button class="clear-filters" bindtap="clearFilters">清空筛选</button></view>
    <view wx:if="{{message}}" class="page-error"><text>{{message}}</text><text class="retry" bindtap="load">重试</text></view>
    <view wx:if="{{!loaded && !message}}" class="empty">正在加载赛事…</view>
    <view wx:for="{{races}}" wx:key="id" class="race">
      <navigator class="race-main" url="/pages/race/race?id={{item.id}}"><view class="date"><text class="mo">{{item.monthText}}</text><text class="da">{{item.day || '—'}}</text><text class="ye">{{item.yearText}}</text></view><view class="race-body"><view class="race-name">{{item.name}}</view><view class="race-meta">{{item.city}}{{item.distanceText}}</view><view class="race-footer"><text class="status-pill {{item.statusMuted ? 'muted-status' : ''}}">{{item.displayStatus}}</text><text wx:if="{{item.showWhen}}" class="deadline {{item.soon ? 'hot' : ''}}">{{item.deadlineLabel}}</text></view></view></navigator>
      <view class="race-personal"><navigator class="race-plan-link" url="/pages/race/race?id={{item.id}}&amp;plan=1" aria-label="{{item.myStatus ? '我的计划：' + item.myStatus : '添加参赛计划'}}"><view class="plan-flag" aria-hidden="true"></view><view><text>{{item.myStatus ? '我的计划' : '添加参赛计划'}}</text><text wx:if="{{item.myStatus}}" class="my-state">{{item.myStatus}}</text></view><text class="plan-link-arrow" aria-hidden="true">›</text></navigator><button class="race-follow {{item.following ? 'on' : ''}}" aria-label="{{item.following ? '取消关注' : '关注'}}{{item.name}}" aria-pressed="{{item.following}}" data-id="{{item.id}}" bindtap="toggleFollow" disabled="{{!!followBusyId}}"><view class="list-bookmark" aria-hidden="true"></view>{{followBusyId === item.id + '' ? '保存中' : item.following ? '已关注' : '关注'}}</button></view>
    </view>
    <view wx:if="{{loaded && !races.length && !message}}" class="empty">{{searching ? '没有找到这场赛事' : '这个分类还没有赛事'}}</view>
    <view wx:if="{{pages > 1}}" class="pager"><view class="pager-step {{page <= 1 ? 'off' : ''}}" bindtap="prevPage">上一页</view><view wx:for="{{pageNumbers}}" wx:key="*this" class="pager-num {{page === item ? 'on' : ''}}" data-page="{{item}}" bindtap="goPage">{{item}}</view><view class="pager-step {{page >= pages ? 'off' : ''}}" bindtap="nextPage">下一页</view></view>
  </view>
</view>

<view wx:if="{{sheet}}" class="dim" bindtap="closeSheet" catchtouchmove="noop"></view>
<view wx:if="{{sheet}}" class="drop">
  <view class="sheet-head"><view>{{sheet === 'city' ? '比赛地点' : sheet === 'time' ? '比赛时间' : '更多筛选'}}</view><button bindtap="closeSheet" aria-label="关闭筛选"><view class="sheet-close" aria-hidden="true"></view></button></view>
  <view wx:if="{{sheet === 'city'}}" class="loc"><scroll-view class="prov" scroll-y><view wx:for="{{provinces}}" wx:key="name" class="prov-item {{item.on ? 'on' : ''}}" data-name="{{item.name}}" bindtap="pickProvince">{{item.name}}</view></scroll-view><view class="cities"><view wx:for="{{cities}}" wx:key="name" class="pick {{item.on ? 'on' : ''}}" data-name="{{item.name}}" bindtap="pickCity">{{item.name}}</view></view></view>
  <scroll-view wx:elif="{{sheet === 'time'}}" class="time" scroll-y><view class="pick {{month ? '' : 'on'}}" bindtap="clearMonth">不限</view><block wx:for="{{yearBlocks}}" wx:key="year"><view class="year">{{item.year}}年</view><view class="months"><view wx:for="{{item.months}}" wx:for-item="mon" wx:key="value" class="pick {{mon.on ? 'on' : ''}}" data-value="{{mon.value}}" bindtap="pickMonth">{{mon.m}}月</view></view></block></scroll-view>
  <view wx:else class="status-sheet"><view class="sheet-title">赛事形式</view><view class="months"><button wx:for="{{meets}}" wx:key="meet" class="pick {{draftMeet === item.meet ? 'on' : ''}}" data-meet="{{item.meet}}" bindtap="setMeet" aria-pressed="{{draftMeet === item.meet}}">{{item.short}}</button></view><view class="sheet-title">赛事状态</view><view class="months"><button wx:for="{{statusOptions}}" wx:key="value" class="pick {{item.on ? 'on' : ''}}" data-value="{{item.value}}" bindtap="pickStatus" aria-pressed="{{item.on}}">{{item.label}}</button></view><view class="actions"><button class="act ghost" bindtap="resetStatus">重置</button><button class="act ok" bindtap="confirmStatus">确认筛选</button></view></view>
</view>
