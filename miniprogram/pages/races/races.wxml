<view class="page mini-races-races">
  <view class="home-navigation">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="home-nav" style="height: {{navHeight}}px; padding-right: {{headerRight}}px;">
      <navigator class="home-calendar-link" url="/pages/calendar/calendar"><view class="calendar-mark"></view><text>{{todayLabel}}</text><text aria-hidden="true">›</text></navigator>
    </view>
  </view>
  <view class="home-header">
    <view class="home-search-area">
      <view class="home-scene">
        <view class="home-scene-title">赛事</view>
        <image class="home-landmark" src="/images/race-landmarks/beijing.png" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="find-card">
        <view class="find-title">找比赛</view>
        <view class="find-modes" role="group" aria-label="找比赛方式">
          <button class="{{mode === 'filters' ? 'on' : ''}}" aria-pressed="{{mode === 'filters'}}" data-mode="filters" bindtap="switchMode">按条件找赛</button>
          <button class="{{mode === 'keyword' ? 'on' : ''}}" aria-pressed="{{mode === 'keyword'}}" data-mode="keyword" bindtap="switchMode">搜赛事</button>
        </view>
        <block wx:if="{{mode === 'filters'}}">
          <view class="filter-panel">
            <button class="filter-chip {{city ? 'on' : ''}}" data-sheet="city" bindtap="openSheet" aria-label="比赛地点，{{cityLabel}}"><view><text class="filter-label">比赛地点</text><text class="filter-value">{{cityLabel}}</text></view><view class="chip-arrow" aria-hidden="true"></view></button>
            <button class="filter-chip {{month ? 'on' : ''}}" data-sheet="time" bindtap="openSheet" aria-label="比赛时间，{{monthLabel}}"><view><text class="filter-label">比赛时间</text><text class="filter-value">{{monthLabel}}</text></view><view class="chip-arrow" aria-hidden="true"></view></button>
            <button class="filter-chip filter-more {{advancedCount ? 'on' : ''}}" data-sheet="status" bindtap="openSheet" aria-label="更多筛选"><text>更多筛选</text><text wx:if="{{advancedCount}}" class="filter-count">{{advancedCount}}</text><view wx:else class="chip-arrow" aria-hidden="true"></view></button>
          </view>
          <view class="kind-options" role="group" aria-label="赛事类型"><button wx:for="{{kinds}}" wx:key="kind" class="kind-tab {{kind === item.kind ? 'on' : ''}}" aria-pressed="{{kind === item.kind}}" data-kind="{{item.kind}}" bindtap="setKind">{{item.short}}</button></view>
          <view wx:if="{{filterTags.length}}" class="filter-tags" aria-label="已选筛选条件"><button wx:for="{{filterTags}}" wx:key="key" class="filter-tag" data-key="{{item.key}}" bindtap="clearFilter" aria-label="取消{{item.category}}：{{item.label}}"><text>{{item.label}}</text><view class="tag-close" aria-hidden="true"></view></button><button class="clear-filters" bindtap="clearFilters">清空筛选</button></view>
        </block>
        <block wx:else>
          <view class="search">
            <view class="lens" aria-hidden="true"></view>
            <input class="search-input" placeholder-class="search-placeholder" placeholder="搜赛事名称或城市" value="{{q}}" bindinput="onQ" bindconfirm="submitFind" confirm-type="search" aria-label="搜赛事名称或城市" />
          </view>
          <view class="find-help">可搜索往届赛事</view>
        </block>
        <button class="find-submit" bindtap="submitFind" disabled="{{mode === 'keyword' && !hasKeyword}}">{{mode === 'filters' ? '查找比赛' : '搜索'}}</button>
      </view>
    </view>
    <block wx:if="{{!searching}}">
      <view class="quick-entries" role="group" aria-label="常用功能">
        <navigator class="quick-entry" url="/pages/calendar/calendar">
          <image class="quick-icon" src="/images/quick-calendar.png" mode="aspectFit" />
          <text>赛事日历</text>
        </navigator>
        <navigator class="quick-entry" url="/pages/radar/radar">
          <image class="quick-icon" src="/images/quick-radar.png" mode="aspectFit" />
          <text>拿奖雷达</text>
        </navigator>
        <navigator class="quick-entry" open-type="switchTab" url="/pages/clubs/clubs">
          <image class="quick-icon" src="/images/quick-clubs.png" mode="aspectFit" />
          <text>发现跑团</text>
        </navigator>
        <navigator class="quick-entry" url="/pages/news/news">
          <image class="quick-icon" src="/images/quick-news.png" mode="aspectFit" />
          <text>跑圈资讯</text>
        </navigator>
      </view>
    </block>
  </view>

  <view wx:if="{{!searching && reminders.length}}" class="reminder">
    <navigator class="reminder-item" url="/pages/race/race?id={{reminders[reminderIndex].race.id}}">
      <view class="reminder-clock" aria-hidden="true"></view>
      <view class="reminder-copy"><view class="reminder-reason">{{reminders[reminderIndex].hit.reason}}</view><view class="reminder-name">{{reminders[reminderIndex].race.name}}</view></view>
      <text wx:if="{{reminders.length === 1}}" aria-hidden="true">›</text>
    </navigator>
    <button wx:if="{{reminders.length > 1}}" class="reminder-next" bindtap="nextReminder" aria-label="查看下一条提醒">下一条</button>
  </view>

  <view class="results" id="race-results" style="{{resultsHeight ? 'min-height:calc(100vh - ' + resultsHeight + 'px)' : ''}}">
    <view class="results-head">
      <view><view class="results-title">{{searching ? '搜索结果' : '全部赛事'}}</view><text wx:if="{{!message}}" class="total">{{loaded ? (searching ? '' : resultStatusLabel + ' · ') + total + ' 场' : '正在加载赛事'}}</text></view>
      <navigator wx:if="{{!searching}}" class="results-archive" url="/pages/race-catalog/race-catalog">赛事档案 <text aria-hidden="true">›</text></navigator>
    </view>
    <view wx:if="{{resultSummary}}" class="result-summary">{{resultSummary}}</view>
    <view wx:if="{{message}}" class="page-error"><text>{{message}}</text><button class="retry" bindtap="retryFind">重试</button></view>
    <view wx:if="{{followError}}" class="page-error">{{followError}}</view>
    <view wx:if="{{!loaded && !message}}" class="empty">正在加载赛事…</view>
    <block wx:if="{{loaded && !message}}">
    <view wx:for="{{races}}" wx:key="id" class="race">
      <navigator class="race-main" url="/pages/race/race?id={{item.id}}"><view class="date"><text class="mo">{{item.monthText}}</text><text class="da">{{item.day || '—'}}</text><text class="ye">{{item.yearText}}</text></view><view class="race-body"><view class="race-name">{{item.name}}</view><view class="race-meta">{{item.city}}{{item.distanceText}}</view><view class="race-footer"><text class="status-pill {{item.statusMuted ? 'muted-status' : ''}}">{{item.displayStatus}}</text><text wx:if="{{item.showWhen}}" class="deadline {{item.soon ? 'hot' : ''}}">{{item.deadlineLabel}}</text></view></view></navigator>
      <view class="race-personal"><navigator class="race-plan-link" url="/pages/race/race?id={{item.id}}&amp;plan=1" aria-label="{{item.myStatus ? '我的计划：' + item.myStatus : '添加参赛计划'}}"><image class="action-art" src="{{item.myStatus ? '/images/race-actions/plan-active.png' : '/images/race-actions/plan.png'}}" mode="aspectFit" aria-hidden="true"/><view><text>{{item.myStatus ? '我的计划' : '添加参赛计划'}}</text><text wx:if="{{item.myStatus}}" class="my-state">{{item.myStatus}}</text></view><text class="plan-link-arrow" aria-hidden="true">›</text></navigator><button class="race-follow {{item.following ? 'on' : ''}}" aria-label="{{item.following ? '取消关注' : '关注'}}{{item.name}}" aria-pressed="{{item.following}}" data-id="{{item.id}}" bindtap="toggleFollow" disabled="{{!!followBusyId}}"><image class="action-art" src="{{item.following ? '/images/race-actions/follow-active.png' : '/images/race-actions/follow.png'}}" mode="aspectFit" aria-hidden="true"/>{{followBusyId === item.id + '' ? '保存中' : item.following ? '已关注' : '关注'}}</button></view>
    </view>
    <view wx:if="{{!races.length}}" class="empty">{{searching ? '没有找到这场赛事' : '这个分类还没有赛事'}}</view>
    <view wx:if="{{pages > 1}}" class="pager"><button class="pager-step" bindtap="prevPage" disabled="{{page <= 1}}">上一页</button><button wx:for="{{pageNumbers}}" wx:key="*this" class="pager-num {{page === item ? 'on' : ''}}" data-page="{{item}}" bindtap="goPage" aria-current="{{page === item ? 'page' : 'false'}}">{{item}}</button><button class="pager-step" bindtap="nextPage" disabled="{{page >= pages}}">下一页</button></view>
    </block>
  </view>

  <view wx:if="{{!searching}}" class="home-discover">
    <view class="catalog-title">赛事探索</view>
    <navigator url="/pages/calendar/calendar"><image src="/images/quick-calendar.png" mode="aspectFit"/><text>近期赛历</text><text aria-hidden="true">›</text></navigator>
    <navigator url="/pages/news/news?tab=athlete"><image src="/images/quick-radar.png" mode="aspectFit"/><text>赛道人物</text><text aria-hidden="true">›</text></navigator>
    <navigator url="/pages/news/news"><image src="/images/quick-news.png" mode="aspectFit"/><text>跑圈新鲜事</text><text aria-hidden="true">›</text></navigator>
  </view>

  <view wx:if="{{!searching}}" class="home-race-catalog">
    <view class="catalog-heading"><text class="catalog-title">热门赛事档案</text><navigator class="catalog-all" url="/pages/race-catalog/race-catalog">全部档案 <text aria-hidden="true">›</text></navigator></view>
    <view wx:if="{{catalogError}}" class="catalog-state"><text>{{catalogError}}</text><button class="catalog-retry" bindtap="loadCatalog">重试</button></view>
    <view wx:elif="{{!catalogLoaded}}" class="catalog-state"><text>正在加载赛事档案…</text></view>
    <view wx:elif="{{!catalogRaces.length}}" class="catalog-state"><text>赛事档案整理中</text></view>
    <view wx:else class="catalog-grid">
      <navigator wx:for="{{catalogRaces}}" wx:key="id" class="catalog-race" url="/pages/race-archive/race-archive?id={{item.id}}">
        <image wx:if="{{item.landmarkSrc}}" class="catalog-landmark" src="{{item.landmarkSrc}}" mode="aspectFit" aria-hidden="true" />
        <view class="catalog-race-name">{{item.name}}</view>
        <view class="catalog-certifications">
          <view><text>田联 · {{item.waLabel}}</text><text wx:if="{{item.waYear}}" class="catalog-certification-year">{{item.waYear}}年</text></view>
          <view><text>田协 · {{item.caaLabel}}</text><text wx:if="{{item.caaYear}}" class="catalog-certification-year">{{item.caaYear}}年</text></view>
          <text wx:if="{{item.certificationYear}}" class="catalog-certification-year">{{item.certificationYear}}认证</text>
        </view>
        <view wx:if="{{item.archiveCount}}" class="catalog-editions">{{item.archiveCount}}届档案 <text aria-hidden="true">›</text></view>
      </navigator>
    </view>
  </view>

</view>

<view wx:if="{{sheet}}" class="dim" bindtap="closeSheet" catchtouchmove="noop"></view>
<view wx:if="{{sheet}}" class="drop">
  <view class="sheet-head"><view><view class="sheet-title">{{sheet === 'city' ? '想去哪里跑' : sheet === 'time' ? '选个比赛时间' : '找到心仪赛事'}}</view><text class="sheet-help">选好条件后，点击「查找比赛」</text></view><button bindtap="closeSheet" aria-label="关闭筛选"><view class="sheet-close" aria-hidden="true"></view></button></view>
  <view wx:if="{{sheet === 'city'}}" class="panel-columns" style="height:{{panelHeight}}px"><scroll-view class="panel-menu" aria-label="省份导航" scroll-y><button wx:for="{{provinces}}" wx:key="name" class="menu-option {{item.on ? 'on' : ''}}" data-name="{{item.name}}" bindtap="pickProvince" aria-pressed="{{item.on}}">{{item.label}}</button></scroll-view><scroll-view class="panel-options" scroll-y><view class="choice-grid"><button wx:for="{{cities}}" wx:key="name" class="pick {{item.on ? 'on' : ''}}" data-name="{{item.name}}" bindtap="pickCity" aria-pressed="{{item.on}}">{{item.label}}</button></view></scroll-view></view>
  <view wx:elif="{{sheet === 'time'}}" class="panel-columns time-columns" style="height:{{panelHeight}}px"><scroll-view class="panel-menu" aria-label="年份导航" scroll-y><button wx:for="{{years}}" wx:key="year" class="menu-option {{item.on ? 'on' : ''}}" data-year="{{item.year}}" bindtap="pickYear" aria-pressed="{{item.on}}">{{item.year}}年</button></scroll-view><scroll-view class="panel-options" scroll-y><button class="pick unlimited {{month ? '' : 'on'}}" bindtap="clearMonth">不限时间</button><view class="choice-grid month-grid"><button wx:for="{{months}}" wx:key="value" class="pick {{item.on ? 'on' : ''}}" data-value="{{item.value}}" bindtap="pickMonth" aria-pressed="{{item.on}}">{{item.m}}月</button></view></scroll-view></view>
  <scroll-view wx:else class="more-options" scroll-y><view class="option-group"><view class="option-label">赛事形式</view><view class="choice-grid three-grid" role="group" aria-label="赛事形式"><button wx:for="{{meets}}" wx:key="meet" class="pick {{meet === item.meet ? 'on' : ''}}" data-meet="{{item.meet}}" bindtap="setMeet" aria-pressed="{{meet === item.meet}}">{{item.short}}</button></view></view><view class="option-group"><view class="option-label">比赛距离</view><view class="choice-grid distance-grid" role="group" aria-label="比赛距离"><button wx:for="{{distances}}" wx:key="value" class="pick {{distance === item.value ? 'on' : ''}}" data-value="{{item.value}}" bindtap="setDistance" aria-pressed="{{distance === item.value}}">{{item.label}}</button></view></view><view class="option-group"><view class="option-label">公开赛事状态</view><view class="choice-grid three-grid"><button wx:for="{{statusOptions}}" wx:key="value" class="pick {{item.on ? 'on' : ''}}" data-value="{{item.value}}" bindtap="pickStatus" aria-pressed="{{item.on}}">{{item.label}}</button></view></view></scroll-view>
</view>
