.page { min-height: 100vh; color: var(--text); }
.home-navigation { position: sticky; top: 0; z-index: 12; background: #ff1838; color: #fff; }
.home-nav { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-left: 32rpx; box-sizing: border-box; overflow: hidden; }
.home-title { flex: none; font-size: 24px; font-weight: 600; line-height: 1.3; }
.today { min-width: 0; overflow: hidden; padding: 5px 9px; border: 1px solid #ffffff30; border-radius: 20px; color: #fff; background: #ffffff12; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.home-header { background: #fff; }
.home-search-area { position: relative; overflow: hidden; padding: 4rpx 0 28rpx; background: radial-gradient(ellipse at 100% 0%,#ff536a 0,transparent 70%),var(--brand-header); }
.home-search-area::before,.home-search-area::after { position: absolute; top: -40px; right: -80px; width: 240px; height: 240px; border: 1px solid #ffffff29; border-radius: 50%; content: ''; pointer-events: none; }
.home-search-area::after { top: -24px; right: -64px; width: 208px; height: 208px; }
.home-feature { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 106px; margin: 0 16px 10px; color: #fff; }
.home-feature-copy { flex: 1; min-width: 0; }.home-feature-eyebrow { display: inline-flex; align-items: center; color: #ffffffdf; font-size: 12px; line-height: 1.5; }.home-feature-eyebrow::before { width: 3px; height: 11px; margin-right: 6px; border-radius: 2px; background: currentColor; content: ''; }
.home-feature-headline { margin: 6px 0; font-size: 20px; line-height: 1.4; font-weight: 600; letter-spacing: normal; }.home-feature-subtitle { color: #ffffffdf; font-size: 12px; line-height: 1.6; }
.home-feature-art { position: relative; display: flex; align-items: center; justify-content: center; flex: 0 0 104px; width: 104px; height: 104px; }.home-feature-art::before { position: absolute; top: 12px; right: 2px; bottom: 4px; left: 2px; border-radius: 50%; background: #ffffff17; content: ''; }.home-feature-art image { position: relative; display: block; width: 104px; height: 104px; }
.home-search-area .search { position: relative; z-index: 1; }
@media (max-width: 350px) { .home-feature { gap: 8px; margin-right: 14px; margin-left: 14px; }.home-feature-headline { font-size: 18px; }.home-feature-art { flex-basis: 84px; width: 84px; height: 92px; }.home-feature-art image { width: 88px; height: 88px; } }
.search { display: flex; align-items: center; height: 46px; margin: 0 24rpx; padding: 0 3px 0 24rpx; border: 1px solid #fff; border-radius: 10px; box-sizing: border-box; background: #fff; }
.lens { position: relative; flex: none; width: 24rpx; height: 24rpx; border: 3rpx solid #888; border-radius: 50%; }
.lens::after { position: absolute; right: -9rpx; bottom: -4rpx; width: 11rpx; height: 3rpx; background: #888; transform: rotate(45deg); content: ''; }
.search-input { flex: 1; min-width: 0; height: 38px; margin-left: 18rpx; padding: 0; border: 0; border-radius: 0; background: transparent; font-size: 14px; }
.search-placeholder { color: #888; font-size: 14px; }
.find { flex: 0 0 56px; width: 56px; height: 44px; min-height: 44px; padding: 0; border: 0; border-radius: 7px; background: transparent; color: #fff; font-size: 13px; font-weight: 600; line-height: 1.4; }
.find > text { display: flex; align-items: center; justify-content: center; width: 56px; height: 34px; border-radius: 7px; background: var(--brand); }
.kind-tab { position: relative; display: flex; flex: none; align-items: center; justify-content: center; min-width: 0; min-height: 44px; height: 46px; color: #555; font-size: 15px; font-weight: 400; white-space: nowrap; }
.kind-tab.on { color: var(--brand); font-weight: 600; }
.kind-tab.on::after { position: absolute; bottom: 5px; left: 50%; width: 18px; height: 3px; border-radius: 3px; background: var(--brand); transform: translateX(-50%); content: ''; }
.quick-entries { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin: 0 24rpx; padding-bottom: 20rpx; }
.quick-entry { display: flex; min-width: 0; min-height: 76px; padding-top:12px; gap:8px; flex-direction: column; align-items: center; color: #444; font-size: 12px; line-height: 20px; }
.quick-icon { display: block; width: 44px; height: 44px; }
.home-discover { display: grid; grid-template-columns: 1.08fr 1fr; gap:12px; min-height:144px; margin:12px 16px 0; }
.discover-calendar { position: relative; display: flex; overflow: hidden; border-radius: 12px; background: linear-gradient(135deg,#fff,#fff0f2); }
.calendar-art { position: absolute; right: 8px; top: 8px; width: 44px; height: 44px; }
.discover-copy { position: relative; z-index: 1; padding: 12px; }
.discover-kicker { padding-right:38px; display: block; color: var(--brand); font-size: 12px; line-height: 18px; }
.discover-title { padding-right:38px; display: block; margin-top: 4px; font-size: 18px; line-height: 1.3; font-weight: 600; white-space: nowrap; }
.discover-sub { display: block; margin-top: 8px; color: #888; font-size: 12px; line-height: 1.5; }
.discover-side { display: grid; grid-template-rows: 1fr 1fr; gap: 16rpx; min-width: 0; }
.discover-side > navigator { display: flex; align-items: center; justify-content: space-between; overflow: hidden; gap: 4px; padding: 10px; border-radius: 12px; background: var(--surface); }
.discover-side .discover-news { background:#fff; }
.discover-card-title { display: block; font-size: 15px; font-weight: 600; line-height: 1.5; white-space: nowrap; }
.discover-card-sub { display: block; margin-top: 4px; color: #888; font-size: 12px; line-height:1.5; white-space: normal; }
.discover-side image { flex: none; width: 36px; height: 36px; margin: 0; }
.reminder { height: 49px; margin: 20rpx 24rpx 0; overflow: hidden; border-radius: 10px; background: #fff; }
.reminder-swiper { width: 100%; height: 49px; }
.reminder-item { display: flex; align-items: center; gap: 16rpx; height: 49px; padding: 8px 12px; box-sizing: border-box; }
.reminder-clock { position: relative; flex: none; width: 24px; height: 24px; border: 3rpx solid var(--brand); border-radius: 50%; box-sizing: border-box; }
.reminder-clock::before { position: absolute; top: 8rpx; left: 19rpx; width: 3rpx; height: 13rpx; background: var(--brand); content: ''; }
.reminder-clock::after { position: absolute; top: 20rpx; left: 19rpx; width: 10rpx; height: 3rpx; background: var(--brand); content: ''; }
.reminder-copy { flex: 1; min-width: 0; }
.reminder-reason,.reminder-name { overflow: hidden; font-size: 12px; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.reminder-reason { color: var(--brand); }
.reminder-name { color: #555; }
.reminder-arrow { flex: none; color: #999; font-size: 22px; line-height: 1; }
.results { padding-bottom: 24rpx; }
.results-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18px 16px 10px; }
.results-title { font-size: 18px; font-weight: 600; line-height: 1.5; }
.total { color: #888; font-size: 12px; }
.race-format-filter { display: flex; align-items: center; gap: 12px; margin: 0 24rpx 8px; }
.format-label { flex: none; color: #888; font-size: 12px; }
.meet-tabs { display: flex; gap: 6px; flex: 1; min-width: 0; }
.meet-tabs .kind-tab { flex: 1; min-width: 0; min-height: 32px; height: 32px; padding: 0 6px; border-radius: 6px; background: #fff; font-size: 12px; font-weight: 400; }
.meet-tabs .kind-tab.on { color: var(--brand); background: var(--brand-soft); font-weight: 500; }
.meet-tabs .kind-tab.on::after { display: none; }
.filter-row { display: flex; gap: 6px; padding-right: 24rpx; }
.filter-fixed { flex: none; height: 32px; padding: 0 10px; border-radius: 6px; background: #fff; color: #555; font-size: 12px; line-height: 32px; }
.filter-fixed.on { color: var(--brand); background: var(--brand-soft); }
.filters { flex: 1; min-width: 0; width: 0; height: 42px; overflow: hidden; white-space: nowrap; }
.filter-chip { display: inline-block; height: 32px; margin-right: 6px; padding: 0 9px; border-radius: 6px; background: #fff; color: #555; font-size: 12px; line-height: 32px; vertical-align: top; }
.filter-chip:first-child { margin-left: 24rpx; }
.filter-chip:last-child { margin-right: 24rpx; }
.filter-chip.on { background: var(--brand-soft); color: var(--brand); }
.race { display: flex; align-items: flex-start; gap: 12px; margin: 0 24rpx 8px; padding: 14px 12px; border-radius: 12px; background: #fff; }
.date { position: relative; display: flex; overflow: hidden; flex: none; width: 58px; height: 70px; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #f4e1e3; border-radius: 8px; background: var(--surface); }
.mo { display: block; position: absolute; top: 0; left: 0; right: 0; background: #fff0f2; color: var(--brand); font-size: 12px; line-height: 23px; text-align: center; }
.da { margin-top: 19px; color: #252525; font-size: 30px; font-weight: 600; line-height: 36px; }
.race-body { flex: 1; min-width: 0; }
.race-name { display: -webkit-box; overflow: hidden; color: var(--text); font-size: 15px; font-weight: 500; line-height: 1.5; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.race-meta { margin-top: 6px; overflow: hidden; color: #888; font-size: 12px; line-height: 19px; text-overflow: ellipsis; white-space: nowrap; }
.race-footer { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 5px; }
.status-pill { flex: none; padding: 1px 5px; border-radius: 4px; background: var(--brand-soft); color: var(--brand); font-size: 12px; line-height: 18px; white-space: nowrap; }
.status-pill.muted-status { background: #f5f5f5; color: #777; }
.deadline { flex: 1; min-width: 0; overflow: hidden; color: #888; font-size: 12px; line-height: 18px; text-overflow: ellipsis; white-space: nowrap; }
.deadline.hot { color: var(--brand); }
.page-error { margin: 12px; color: var(--brand); font-size: 12px; }
.page-error .retry { margin-left: 8px; }
.empty { padding: 32px 16px; color: #888; font-size: 14px; text-align: center; }
.pager { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 10px 12px; }
.pager-step { min-height: 40px; padding: 0 8px; color: var(--brand); font-size: 12px; line-height: 40px; }
.pager-step.off { color: #bbb; }
.pager-num { min-width: 24px; height: 40px; padding: 0 8px; border-radius: 8px; background: #fff; font-size: 12px; line-height: 40px; text-align: center; }
.pager-num.on { background: var(--brand); color: #fff; }
.dim { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 20; background: rgba(0, 0, 0, 0.45); }
.drop { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 70vh; padding-bottom: env(safe-area-inset-bottom); border-radius: var(--control-radius) 24rpx 0 0; background: #fff; }
.loc { display: flex; height: 680rpx; }
.prov { flex: none; width: 224rpx; height: 680rpx; background: var(--page-bg); }
.prov-item { padding: 28rpx 32rpx; color: var(--text); font-size: 14px; }
.prov-item.on { background: #fff; color: var(--brand); font-weight: 600; }
.cities, .months { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 16rpx; }
.cities { flex: 1; min-width: 0; padding: 24rpx; box-sizing: border-box; }
.time { max-height: 70vh; padding: 24rpx 28rpx 32rpx; box-sizing: border-box; }
.year { margin: 20rpx 0 16rpx; font-size: 14px; font-weight: 600; }
.pick { padding: 16rpx 24rpx;  background: var(--page-bg); color: var(--text); font-size: 12px; }
.pick.on { background: var(--brand); color: #fff;  }
.status-sheet { padding: 32rpx 28rpx 28rpx; }
.sheet-title { margin-bottom: 24rpx; font-size: 18px; font-weight: 600; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.act { flex: 1; height: 88rpx;  font-size: 14px; font-weight: 600; line-height: 88rpx; text-align: center; }
.act.ghost { background: var(--page-bg);  }
.act.ok { background: var(--brand); color: #fff;  }


@media(max-width:350px) {
 .discover-copy { padding: 12px 10px; }
 .discover-title { font-size: 17px; }
 .calendar-art { width: 40px; height: 40px; }
 .discover-side > navigator { padding: 8px; }
 .discover-card-title { font-size: 14px; }
 .discover-side image { width: 28px; height: 28px; }
}

.discover-copy { padding:14px; min-width:0; }.discover-title { font-size:18px; }.discover-race-name { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; margin-top:8px; font-size:12px; line-height:1.6; color:var(--text-secondary); }

.discover-side>navigator>view{flex:1;min-width:0}
