.home-scene{position:relative;height:92px;padding:10px 3px}
.home-scene-title{font-size:30px;font-weight:650}
.home-landmark{position:absolute;right:6px;bottom:-22px;width:146px;height:133px;opacity:.52;filter:grayscale(.65)}
.find-card{position:relative;display:grid;gap:10px;padding:15px;border-radius:23px;background:#fff;box-shadow:0 8px 20px #39276217}
.find-title{color:#282134;font-size:21px;font-weight:650}
.find-modes,.filter-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px;border-radius:13px;background:var(--tint)}
.find-modes{padding:3px}
.find-card button{min-width:0}
.find-card .find-modes button,.find-card .filter-chip{width:100%;margin:0;padding:6px 9px;border:0;color:#62596f;font-size:13px}
.find-modes button{border-radius:10px;background:transparent}
.find-modes button.on{color:var(--purple);background:#fff;font-weight:650}
.filter-panel{overflow:hidden;gap:1px;border:1px solid #ece8f4;background:#ece8f4}
.find-card .filter-chip{justify-content:space-between;gap:7px;border-radius:0;background:#f8f7fa;text-align:left}
.filter-chip>view:first-child{flex:1;min-width:0}
.filter-chip text{display:block;overflow-wrap:anywhere}
.filter-label{font-size:11px}
.filter-value{color:#2d2735;font-weight:600}
.find-card .filter-more{grid-column:span 2}
.filter-chip.on,.filter-chip.on .filter-value{color:var(--purple)}
.chip-arrow{width:6px;height:6px;flex:none;border-right:1px solid;border-bottom:1px solid;transform:rotate(45deg)}
.filter-count{padding:2px 6px;border-radius:10px;background:var(--tint);color:var(--purple)}
.kind-options,.filter-tags{display:flex;flex-wrap:wrap;gap:4px}
.find-card .kind-tab,.find-card .filter-tags button{width:auto;margin:0;padding:4px 8px;border:1px solid #ece8f4;border-radius:22px;color:#62596f;font-size:12px}
.find-card .kind-tab{min-width:44px}
.find-card .kind-tab.on,.filter-tags .filter-tag{background:var(--tint);color:var(--purple)}
.filter-tag{max-width:100%;gap:5px;overflow-wrap:anywhere}
.tag-close::after{content:"\00d7"}
.search{display:flex;align-items:center;gap:12px;padding:0 12px;border:1px solid #ece8f4;border-radius:13px;background:#f8f7fa}
.lens{position:relative;width:13px;height:13px;flex:none;border:1px solid var(--purple);border-radius:50%}
.lens::after{position:absolute;right:-4px;bottom:-3px;width:5px;border-top:1px solid var(--purple);transform:rotate(45deg);content:""}
.search-input{min-width:0;flex:1;padding:0;border:0;background:transparent}
.search-placeholder,.find-help{color:#62596f;font-size:12px}
.find-card button.find-submit{width:100%;margin:0;min-height:48px;border:0;border-radius:28px;background:linear-gradient(110deg,#7453b5,var(--purple));color:#fff;font-size:16px;font-weight:650}
.find-card button.find-submit[disabled]{background:#e8e1f2;color:#62596f}
.page-error{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:12px 0;color:#a81035;font-size:13px}
.page-error button.retry{width:auto;flex:none;margin:0;padding:6px 12px;border:1px solid #ddd2ef;border-radius:20px;color:#50378c;font-size:13px}
@media(max-width:350px){.page{--gutter:12px}.find-card{padding:13px}}
