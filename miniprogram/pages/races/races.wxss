.page { min-height: 100vh; background: #f5f6fa; color: #1f2026; font-weight: 400; }
.home-navigation { position: sticky; top: 0; z-index: 12; background: #fff1f3; }
.home-header { padding-bottom: 16rpx; background: linear-gradient(180deg, #fff1f3 0%, #fff 75%); }
.home-nav { display: flex; align-items: center; gap: 16rpx; padding-left: 24rpx; box-sizing: border-box; overflow: hidden; }
.home-title { flex: none; font-size: 48rpx; font-weight: 700; line-height: 1.2; }
.today { min-width: 0; overflow: hidden; color: #8a8e99; font-size: 22rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }

.search { display: flex; align-items: center; height: 80rpx; margin: 12rpx 24rpx 0; padding: 0 20rpx; border: 1px solid #ff0a30; border-radius: 20rpx; box-sizing: border-box; background: #fff; }
.lens { position: relative; flex: none; width: 22rpx; height: 22rpx; border: 2rpx solid #8a8e99; border-radius: 50%; }
.lens::after { position: absolute; right: -8rpx; bottom: -3rpx; width: 10rpx; height: 2rpx; background: #8a8e99; transform: rotate(45deg); content: ''; }
.search-input { flex: 1; min-width: 0; height: 76rpx; margin-left: 16rpx; padding: 0; border: 0; border-radius: 0; background: transparent; font-size: 28rpx; }
.search-placeholder { color: #8a8e99; font-size: 28rpx; }
.find { flex: none; padding-left: 20rpx; color: #ff0a30; font-size: 30rpx; font-weight: 600; line-height: 76rpx; }

.kind-tabs { display: flex; width: 100%; height: 80rpx; padding: 0 16rpx; box-sizing: border-box; }
.kind-tab { position: relative; display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; height: 80rpx; color: #1f2026; font-size: 32rpx; font-weight: 600; white-space: nowrap; }
.kind-tab.on { color: #ff0a30; }
.kind-tab.on::after { position: absolute; bottom: 6rpx; left: 50%; width: 36rpx; height: 5rpx; border-radius: 3rpx; background: #ff0a30; transform: translateX(-50%); content: ''; }
.meet-tabs { height: 64rpx; }
.meet-tabs .kind-tab { height: 64rpx; color: #8a8e99; font-size: 26rpx; font-weight: 500; }
.meet-tabs .kind-tab.on { color: #ff0a30; }
.meet-tabs .kind-tab.on::after { bottom: 2rpx; width: 28rpx; }
.meet-tabs .kind-tab:first-child { flex: 1.4; }
.quick-entries { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 8rpx 24rpx 0; }
.quick-entry { display: flex; min-width: 0; flex-direction: column; align-items: center; gap: 8rpx; color: #1f2026; font-size: 24rpx; line-height: 32rpx; white-space: nowrap; }
.quick-icon { display: block; width: 64rpx; height: 64rpx; margin: 0; border: 0; background: transparent; }

.reminder { height: 100rpx; margin: 20rpx 24rpx; overflow: hidden; border-radius: 16rpx; background: #fff0f3; }
.reminder-swiper { width: 100%; height: 100rpx; }
.reminder-item { display: flex; align-items: center; gap: 16rpx; height: 100rpx; padding: 16rpx 20rpx; box-sizing: border-box; }
.reminder-clock { position: relative; flex: none; width: 34rpx; height: 34rpx; border: 2rpx solid #ff0a30; border-radius: 50%; box-sizing: border-box; }
.reminder-clock::before { position: absolute; top: 6rpx; left: 14rpx; width: 2rpx; height: 10rpx; border-radius: 1rpx; background: #ff0a30; content: ''; }
.reminder-clock::after { position: absolute; top: 14rpx; left: 14rpx; width: 9rpx; height: 2rpx; border-radius: 1rpx; background: #ff0a30; content: ''; }
.reminder-copy { flex: 1; min-width: 0; }
.reminder-reason { overflow: hidden; color: #ff0a30; font-size: 22rpx; line-height: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.reminder-name { margin-top: 4rpx; overflow: hidden; color: #1f2026; font-size: 26rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.reminder-arrow { flex: none; color: #ff0a30; font-size: 34rpx; line-height: 1; }

.results { padding: 12rpx 0 24rpx; }
.results-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 24rpx 12rpx; }
.results-title { color: #1f2026; font-size: 36rpx; font-weight: 700; line-height: 50rpx; }
.total { flex: none; color: #8a8e99; font-size: 24rpx; line-height: 34rpx; }
.filters { width: 100%; height: 76rpx; overflow: hidden; white-space: nowrap; }
.filter-chip { display: inline-block; height: 60rpx; margin-right: 12rpx; padding: 0 20rpx; border-radius: 16rpx; background: #f0f1f6; color: #1f2026; font-size: 24rpx; line-height: 60rpx; vertical-align: top; }
.filter-chip:first-child { margin-left: 24rpx; }
.filter-chip:last-child { margin-right: 24rpx; }
.filter-chip.on { background: #fff0f3; color: #ff0a30; }
.race { display: flex; align-items: center; gap: 20rpx; margin: 0 24rpx 16rpx; padding: 24rpx; border-radius: 24rpx; background: #fff; }
.date { display: flex; flex: none; width: 100rpx; height: 116rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 16rpx; background: #f5f6f8; }
.mo { color: #8a8e99; font-size: 22rpx; line-height: 28rpx; }
.da { margin-top: 4rpx; color: #ff0a30; font-size: 52rpx; font-weight: 700; line-height: 60rpx; }
.race-body { flex: 1; min-width: 0; }
.race-name { display: -webkit-box; overflow: hidden; color: #1f2026; font-size: 32rpx; font-weight: 600; line-height: 40rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.race-meta { margin-top: 4rpx; overflow: hidden; color: #8a8e99; font-size: 24rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.race-footer { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.status-pill { flex: none; padding: 2rpx 10rpx; border-radius: 8rpx; background: #fff0f3; color: #ff0a30; font-size: 22rpx; line-height: 28rpx; white-space: nowrap; }
.status-pill.muted-status { background: #f0f1f6; color: #8a8e99; }
.deadline { flex: 1; min-width: 0; overflow: hidden; color: #8a8e99; font-size: 22rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.deadline.hot { color: #ff0a30; }
.page-error { margin: 16rpx 24rpx; color: #c73540; font-size: 26rpx; }
.page-error .retry { margin-left: 16rpx; color: #ff0a30; font-weight: 600; }
.empty { padding: 48rpx 24rpx; color: #8a8e99; font-size: 28rpx; text-align: center; }
.pager { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 24rpx 8rpx; }
.pager-step { height: 64rpx; padding: 0 8rpx; color: #ff0a30; font-size: 26rpx; font-weight: 600; line-height: 64rpx; }
.pager-step.off { color: #c9ccd3; }
.pager-num { min-width: 48rpx; height: 64rpx; padding: 0 16rpx; border-radius: 16rpx; background: #f0f1f6; color: #1f2026; font-size: 26rpx; font-weight: 600; line-height: 64rpx; text-align: center; }
.pager-num.on { background: #ff0a30; color: #fff; }

.dim { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 20; background: rgba(0, 0, 0, 0.45); }
.drop { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 70vh; padding-bottom: env(safe-area-inset-bottom); border-radius: 24rpx 24rpx 0 0; background: #fff; }
.loc { display: flex; height: 680rpx; }
.prov { flex: none; width: 224rpx; height: 680rpx; background: #f5f6fa; }
.prov-item { padding: 28rpx 32rpx; color: #1f2026; font-size: 28rpx; }
.prov-item.on { background: #fff; color: #ff0a30; font-weight: 600; }
.cities, .months { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 16rpx; }
.cities { flex: 1; min-width: 0; padding: 24rpx; box-sizing: border-box; }
.time { max-height: 70vh; padding: 24rpx 28rpx 32rpx; box-sizing: border-box; }
.year { margin: 20rpx 0 16rpx; font-size: 28rpx; font-weight: 600; }
.pick { padding: 16rpx 24rpx; border-radius: 16rpx; background: #f0f1f6; color: #1f2026; font-size: 26rpx; }
.pick.on { background: #ff0a30; color: #fff; }
.status-sheet { padding: 32rpx 28rpx 28rpx; }
.sheet-title { margin-bottom: 24rpx; font-size: 34rpx; font-weight: 600; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.act { flex: 1; height: 88rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; line-height: 88rpx; text-align: center; }
.act.ghost { background: #f0f1f6; }
.act.ok { background: #ff0a30; color: #fff; }

@media (max-width: 350px) {
  .home-title { font-size: 24px; }
  .today { font-size: 11px; }
  .kind-tab { font-size: 14px; }
  .quick-entry { font-size: 12px; line-height: 18px; }
  .quick-icon { width: 30px; height: 30px; }
  .race-name { font-size: 15px; line-height: 21px; }
  .race-meta { font-size: 12px; line-height: 18px; }
  .status-pill, .deadline { font-size: 11px; line-height: 16px; }
  .race-footer { flex-wrap: wrap; }
  .race { gap: 10px; }
  .date { width: 46px; height: 58px; }
  .mo { font-size: 11px; line-height: 16px; }
  .da { font-size: 26px; line-height: 28px; }
}
