.page { min-height: 100vh; background: transparent; color: var(--text); font-weight: 400; }
.home-navigation { position: sticky; top: 0; z-index: 12; background: linear-gradient(110deg,#fff7f1,#ffffff); }
.home-header { padding-bottom: 12rpx; background: linear-gradient(145deg,#fff0e7 0%,#fff8f3 34%,#ffffff 100%); }
.home-nav { display: flex; align-items: center; gap: 16rpx; padding-left: 24rpx; box-sizing: border-box; overflow: hidden; }
.home-title { flex: none; font-size: 26px; font-weight: 700; line-height: 1.2; }
.intro-title { font-size: 24px; line-height: 1.4; font-weight: 750; letter-spacing: -.5px; }
.intro-caption { margin-top: 10rpx; color: var(--text-secondary); font-size: 12px; line-height: 1.7; }
.today { min-width: 0; overflow: hidden; color: var(--text-secondary); font-size: 12px; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }

.search { display: flex; align-items: center; height: 52px; margin: 20rpx 24rpx 0; padding: 4px 5px 4px 22rpx;  box-sizing: border-box; background: #fff; }
.lens { position: relative; flex: none; width: 22rpx; height: 22rpx; border: 2rpx solid var(--text-secondary); border-radius: 50%; }
.lens::after { position: absolute; right: -8rpx; bottom: -3rpx; width: 10rpx; height: 2rpx; background: var(--text-secondary); transform: rotate(45deg); content: ''; }
.search-input { flex: 1; min-width: 0; min-height: 44px; height: 44px; margin-left: 16rpx; padding: 0; border: 0; border-radius: 0; background: transparent; font-size: 14px; }
.search-placeholder { color: var(--text-secondary); font-size: 14px; }
.find { flex: none; padding-left: 20rpx; color: #fff; line-height: 44px;  min-height: 44px; height: 44px; padding: 0 24rpx; background: var(--brand); }

.kind-tabs { display: flex; gap: 40rpx; width: 100%; height: 96rpx; padding: 0 32rpx; box-sizing: border-box; }
.kind-tab { min-height: 44px; position: relative; display: flex; flex: none; min-width: 0; align-items: center; justify-content: center; height: 96rpx; color: var(--text-secondary); font-size: 16px; font-weight: 500; white-space: nowrap;  }
.kind-tab.on { font-size: 18px;  }
.kind-tab.on::after { position: absolute; bottom: 12rpx; left: 50%; width: 40rpx;  background: var(--brand); transform: translateX(-50%); content: ''; }
.quick-entries { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 8rpx 24rpx 0; padding: 28rpx 0 20rpx;  background: #ffffff; border-color: #dfebfa; box-shadow: var(--card-shadow); }
.quick-entry { display: flex; min-width: 0; min-height: 116rpx; flex-direction: column; align-items: center; gap: 14rpx; color: var(--text-secondary); font-size: 12px; line-height: 40rpx; white-space: nowrap; }
.quick-icon { display: block; width: 64rpx; height: 64rpx; margin: 0; border: 0; background: transparent; }

.reminder { height: 100rpx; margin: 20rpx 24rpx; overflow: hidden;  background: linear-gradient(100deg,#fff0e7,#fff4d7); }
.reminder-swiper { width: 100%; height: 100rpx; }
.reminder-item { display: flex; align-items: center; gap: 16rpx; height: 100rpx; padding: 16rpx 20rpx; box-sizing: border-box; }
.reminder-clock { position: relative; flex: none; width: 34rpx; height: 34rpx; border: 2rpx solid var(--brand); border-radius: 50%; box-sizing: border-box; }
.reminder-clock::before { position: absolute; top: 6rpx; left: 14rpx; width: 2rpx; height: 10rpx; border-radius: 1rpx; background: var(--brand); content: ''; }
.reminder-clock::after { position: absolute; top: 14rpx; left: 14rpx; width: 9rpx; height: 2rpx; border-radius: 1rpx; background: var(--brand); content: ''; }
.reminder-copy { flex: 1; min-width: 0; }
.reminder-reason { overflow: hidden; color: var(--brand); font-size: 12px; line-height: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.reminder-name { margin-top: 4rpx; overflow: hidden; color: var(--text); font-size: 12px; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.reminder-arrow { flex: none; color: var(--brand); font-size: 18px; line-height: 1; }

.results { padding: 12rpx 0 24rpx; }
.results-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 24rpx 12rpx; }
.results-title { color: var(--text); font-size: 19px; font-weight: 700; line-height: 50rpx; }
.total { flex: none; color: var(--text-secondary); font-size: 12px; line-height: 34rpx; }
.race-format-filter { display: flex; align-items: center; gap: 24rpx; margin: 0 24rpx 24rpx; }
.format-label { flex: none; color: var(--text-secondary); font-size: 12px; line-height: 40rpx; }
.meet-tabs { display: flex; flex: 1; min-width: 0; max-width: 560rpx; }
.meet-tabs .kind-tab { flex: 1; height: 44px; min-height: 44px; padding: 0 8rpx;  color: var(--text-secondary); line-height: 40rpx; font-weight: 400; box-sizing: border-box; }
.meet-tabs .kind-tab.on { font-size: 12px; font-weight: 600;  }
.meet-tabs .kind-tab.on::after { display: none;  }
.filters { width: 100%; height: 56px; overflow: hidden; white-space: nowrap; }
.filter-chip { display: inline-block; height: 40px; margin-right: 12rpx; padding: 0 20rpx;  background: #fff; color: var(--text); font-size: 12px; line-height: 40px; vertical-align: top;  min-height: 40px; border: 1rpx solid var(--border);}
.filter-chip:first-child { margin-left: 24rpx;  }
.filter-chip:last-child { margin-right: 24rpx;  }
.filter-chip.on { background: #fff0e7; color: var(--brand);  }
.race { display: flex; align-items: flex-start; gap: 20rpx; margin: 0 24rpx 20rpx; padding: 28rpx;  background: #ffffff;  border: 1rpx solid #fff; box-shadow: var(--card-shadow); }
.date { display: flex; flex: none; width: 104rpx; height: 124rpx; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(145deg,#fff0e7,#fff4d7); }
.mo { color: var(--text-secondary); font-size: 12px; line-height: 28rpx; }
.da { margin-top: 4rpx; font-size: 52rpx; font-weight: 700; line-height: 60rpx; }
.race-body { flex: 1; min-width: 0; }
.race-name { display: -webkit-box; overflow: hidden; color: var(--text); line-height: 1.5; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.race-meta { margin-top: 8rpx; overflow: hidden; color: var(--text-secondary); font-size: 12px; line-height: 1.7; text-overflow: ellipsis; white-space: nowrap; }
.race-footer { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx;  flex-wrap: wrap;}
.status-pill { flex: none; padding: 2rpx 10rpx;  background: var(--brand-soft); color: var(--brand); font-size: 12px; line-height: 28rpx; white-space: nowrap; }
.status-pill.muted-status { background: var(--sky-soft); color: var(--text-secondary);  }
.deadline { flex: 1; min-width: 0; overflow: hidden; color: var(--text-secondary); font-size: 12px; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.deadline.hot { color: var(--brand); }
.page-error { margin: 16rpx 24rpx; color: var(--brand); font-size: 12px; }
.page-error .retry { margin-left: 16rpx; color: var(--brand); font-weight: 600; }
.empty { padding: 48rpx 24rpx; color: var(--text-secondary); font-size: 14px; text-align: center; }
.pager { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 24rpx 8rpx; }
.pager-step { height: 64rpx; padding: 0 8rpx; color: var(--brand); font-size: 12px; font-weight: 600; line-height: 64rpx; }
.pager-step.off { color: #c9ccd3; }
.pager-num { min-width: 48rpx; height: 64rpx; padding: 0 16rpx; border-radius: 16rpx; background: var(--page-bg); color: var(--text); font-size: 12px; font-weight: 600; line-height: 64rpx; text-align: center; }
.pager-num.on { background: var(--brand); color: #fff; }

.dim { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 20; background: rgba(0, 0, 0, 0.45); }
.drop { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 70vh; padding-bottom: env(safe-area-inset-bottom); border-radius: 24rpx 24rpx 0 0; background: #fff; }
.loc { display: flex; height: 680rpx; }
.prov { flex: none; width: 224rpx; height: 680rpx; background: var(--page-bg); }
.prov-item { padding: 28rpx 32rpx; color: var(--text); font-size: 14px; }
.prov-item.on { background: #fff; color: var(--brand); font-weight: 600; }
.cities, .months { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 16rpx; }
.cities { flex: 1; min-width: 0; padding: 24rpx; box-sizing: border-box; }
.time { max-height: 70vh; padding: 24rpx 28rpx 32rpx; box-sizing: border-box; }
.year { margin: 20rpx 0 16rpx; font-size: 14px; font-weight: 600; }
.pick { padding: 16rpx 24rpx;  background: var(--page-bg); color: var(--text); font-size: 12px; }
.pick.on { background: var(--brand); color: #fff;  }
.status-sheet { padding: 32rpx 28rpx 28rpx; }
.sheet-title { margin-bottom: 24rpx; font-size: 18px; font-weight: 600; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.act { flex: 1; height: 88rpx;  font-size: 14px; font-weight: 600; line-height: 88rpx; text-align: center; }
.act.ghost { background: var(--page-bg);  }
.act.ok { background: var(--brand); color: #fff;  }

@media (max-width: 350px) {
  .home-title { font-size: 26px; }
  .today { font-size: 11px; }
  .kind-tabs { gap: 40rpx; padding-left: 24rpx;  height: 96rpx;}
  .kind-tab { min-height: 44px; font-size: 16px;  height: 96rpx;  }
  .kind-tab.on { font-size: 18px;  }
  .quick-entry { font-size: 12px; line-height: 18px;  color: var(--text-secondary); gap: 14rpx;}
  .quick-icon { width: 30px; height: 30px; }
  .race-format-filter { gap: 10px; }
  .format-label { font-size: 12px; }
  .meet-tabs .kind-tab, .meet-tabs .kind-tab.on { font-size: 12px;  }
  .race-name { font-size: 18px; line-height: 1.5;  font-weight: 650;}
  .race-meta { font-size: 12px; line-height: 1.7;  margin-top: 8rpx;}
  .status-pill, .deadline { font-size: 11px; line-height: 16px;  }
  .race-footer { flex-wrap: wrap;  margin-top: 14rpx;}
  .race { gap: 10px;  padding: 28rpx; margin: 0 24rpx 20rpx; border: 1rpx solid #fff; align-items: flex-start; box-shadow: var(--card-shadow); background: #ffffff; }
  .date { width: 104rpx; height: 124rpx;  background: linear-gradient(145deg,#fff0e7,#fff4d7); border-radius: 20rpx;}
  .mo { font-size: 11px; line-height: 16px; }
  .da { font-size: 26px; line-height: 28px; }
}

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-races-races .race, .mini-races-races .quick-entries, .mini-races-races .reminder { border-radius: 36rpx; }
.mini-races-races .search, .mini-races-races .find, .mini-races-races .filter-chip, .mini-races-races .pick, .mini-races-races .act { border-radius: 24rpx; }
.mini-races-races .status-pill, .mini-races-races .kind-tab { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-races-races { color: var(--text); }
.mini-races-races button { font-weight: 500; border-radius: 24rpx; }

.home-title,.intro-title { font-weight: 600; }
.home-intro { padding: 32rpx 28rpx 0; }
.search { border: 1px solid var(--border); border-radius: 24rpx; }
.find { border-radius: 24rpx; font-size: 12px; font-weight: 500; }
.kind-tab,.kind-tab.on { font-size: 14px; font-weight: 500; border-radius: 0; }
.kind-tab.on { color: var(--text); font-weight: 600; }
.kind-tab.on::after { height: 2px; border-radius: 0; }
.meet-tabs { gap: 12rpx; padding: 0; border-radius: 0; background: transparent; }
.meet-tabs .kind-tab { border: 1px solid var(--border); border-radius: 14rpx; background: #fff; font-size: 12px; }
.meet-tabs .kind-tab.on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); box-shadow: none; }
.filter-chip { border-radius: 14rpx; }
.filter-chip.on { border-color: var(--brand); background: #fff0e7; }
.race { border: 1px solid var(--border); box-shadow: var(--card-shadow); background: #ffffff; }
.quick-entries { border: 1px solid var(--border); background: #ffffff; border-color: #dfebfa; box-shadow: var(--card-shadow); }
.race-name { font-size: 18px; font-weight: 600; }
.race-meta,.deadline,.status-pill { font-size: 11px; }
.date { border-radius: 24rpx; background: linear-gradient(145deg,#fff0e7,#fff4d7); }
.da { color: var(--text); }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-races-races .find { font-size: 14px; font-weight: 500; }
