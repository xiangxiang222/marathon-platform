<view class="radar-page">
  <block wx:if="{{!selected}}">
    <view class="intro"><view class="intro-title">用成绩，选对下一场</view><view class="intro-caption">对照历年前八，关注今年参赛阵容</view></view>
    <view wx:if="{{preview}}" class="preview-bar"><view><text class="preview-dot"></text>模拟体验 · 非真实赛事</view><button bindtap="exitPreview">退出体验</button></view>
    <view class="target-panel">
      <view class="distance-tabs"><button wx:for="{{distances}}" wx:key="key" class="{{distance === item.key ? 'on' : ''}}" data-distance="{{item.key}}" bindtap="setDistance">{{item.label}}</button></view>
      <view class="condition-row"><text>{{preview ? '示例目标' : '我的目标'}}</text><view class="gender-switch"><button class="{{gender === '男' ? 'on' : ''}}" data-gender="男" bindtap="setGender">男子组</button><button class="{{gender === '女' ? 'on' : ''}}" data-gender="女" bindtap="setGender">女子组</button></view></view>
      <view class="time-action"><view class="time-inputs"><view class="time-part"><input type="number" maxlength="2" value="{{hours}}" placeholder="00" data-part="hours" bindinput="onTimePart" aria-label="目标小时" /><text>时</text></view><text class="time-colon">:</text><view class="time-part"><input type="number" maxlength="2" value="{{minutes}}" placeholder="00" data-part="minutes" bindinput="onTimePart" aria-label="目标分钟" /><text>分</text></view><text class="time-colon">:</text><view class="time-part"><input type="number" maxlength="2" value="{{seconds}}" placeholder="00" data-part="seconds" bindinput="onTimePart" aria-label="目标秒" /><text>秒</text></view></view><button class="search-action" disabled="{{busy || loading}}" loading="{{busy}}" bindtap="save">选比赛<text>↗</text></button></view>
      <view class="input-note">{{preview ? '调整示例成绩，看看适合哪场比赛' : '目标留空时，使用已有同项目 PB'}}</view>
    </view>
    <view wx:if="{{message}}" class="error-card"><view>{{message}}</view><button bindtap="load" disabled="{{loading}}">重新加载</button></view>
    <view class="results-head"><view class="results-title">选赛参考<text>{{filtered.length}}</text></view><view class="list-filters"><button class="{{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setFilter">全部</button><button class="{{filter === 'opportunity' ? 'active' : ''}}" data-filter="opportunity" bindtap="setFilter">有竞争力</button></view></view>
    <view wx:if="{{loading}}" class="empty">正在比较赛事资料…</view>
    <view wx:elif="{{ready && !filtered.length}}" class="empty"><view class="empty-mark">↗</view><view class="empty-title">{{filter === 'opportunity' ? '这个目标暂未匹配到比赛' : '这个项目暂未收录可比赛事'}}</view><view class="copy">{{filter === 'opportunity' ? '试着调整目标，或查看全部赛事的历史门槛。' : '资料收录后会出现在这里。可以先体验完整的选赛流程。'}}</view><button wx:if="{{!preview}}" class="outline" bindtap="enterPreview">查看模拟赛事</button><button wx:else class="outline" data-filter="all" bindtap="setFilter">查看全部参考</button></view>
    <view wx:for="{{filtered}}" wx:key="id" class="race-row" data-id="{{item.id}}" bindtap="openDetail">
      <view class="race-heading"><view class="race-name">{{item.shortName}}</view><text class="level level-{{item.level}}">{{item.levelText}}</text></view>
      <view class="race-meta">{{item.race.raceDate}}<text>·</text>{{item.race.city}}<text>·</text>{{item.gender}}子{{item.distanceLabel}}<text wx:if="{{item.demo}}" class="demo">模拟</text></view>
      <view class="metrics"><view><view class="metric-label">历史奖励线 · 前 {{item.awardDepth}}</view><view class="clock">{{item.history.clock || '待收录'}}</view></view><view class="my-metric"><view class="metric-label">{{preview ? '示例目标' : item.ability ? item.ability.label : '我的成绩'}}</view><view class="clock">{{item.ability.clock || '—'}}</view></view></view>
      <view wx:if="{{item.hasScale}}" class="performance-scale"><view class="scale-track"><view class="scale-point scale-history" style="left:{{item.linePosition}}%"></view><view class="scale-point scale-me" style="left:{{item.myPosition}}%"></view></view><view class="scale-legend"><text>← 更快</text><view><text class="legend-me">● {{preview ? '目标' : '我'}}</text><text>● 历史奖励线</text></view></view></view>
      <view class="race-summary"><text class="gap">{{item.gapLabel}}</text><text>今年已知 {{item.competition.knownCount}} 人<text wx:if="{{item.competition.fasterCount !== null}}"> · {{item.competition.fasterCount}} 人更快</text></text></view>
      <view class="card-foot"><text>历年前八 · 今年阵容</text><text>↗</text></view>
    </view>
    <view class="method-note">历史奖励线取近三届同口径成绩中位数。已知阵容可能不完整，PB 只作竞争参考。</view>
  </block>
  <block wx:else>
    <button class="back-button" bindtap="closeDetail">‹ 返回比赛列表</button>
    <view class="detail-hero"><view class="eyebrow">{{selected.gender}}子{{selected.distanceLabel}} · {{selected.timingLabel}}</view><view wx:if="{{selected.demo}}" class="demo">模拟数据 · 非真实赛事成绩</view><view class="hero-title">{{selected.race.name}}</view><view class="muted">{{selected.race.raceDate}} · {{selected.race.city}}</view></view>
    <view class="card assessment"><view class="level level-{{selected.level}}">{{selected.levelLabel}}</view><view class="copy">{{selected.reason}}</view><view class="metrics"><view><view class="metric-label">历史奖励线</view><view class="clock">{{selected.history.clock || '待收录'}}</view></view><view><view class="metric-label">{{selected.ability ? selected.ability.label : '我的成绩'}}</view><view class="clock">{{selected.ability.clock || '—'}}</view></view></view><view class="gap">{{selected.gapLabel}}</view></view>
    <view class="card reward-card"><view class="section-label">当届奖励 <text>前 {{selected.awardDepth}} 名</text></view><view class="copy">{{selected.eligibility || '参赛资格以当届规程为准'}}</view><view class="award-row" wx:for="{{selected.awards}}" wx:key="place"><text>第 {{item.place}} 名</text><text>{{item.amount ? item.amount + ' 元' : '非现金奖励'}}</text></view><view class="muted">{{selected.ruleSource}}</view></view>
    <view class="card history-card"><view class="section-label">历年前八 <text>{{yearTiming}}</text></view><view class="muted">逐届查看；缺失名次保持未收录。</view><scroll-view class="year-scroll" scroll-x><view class="year-tabs"><button wx:for="{{selected.histories}}" wx:key="year" class="{{selectedYear === item.year ? 'on' : ''}}" data-year="{{item.year}}" bindtap="chooseYear">{{item.year}}</button></view></scroll-view>
      <view wx:if="{{!selected.histories.length}}" class="empty">历届成绩待收录</view>
      <block wx:else><view class="rank-row rank-head"><text>名次</text><text>选手</text><text>完赛成绩</text></view><view wx:for="{{yearRows}}" wx:key="place" class="rank-row {{item.rewarded ? 'rewarded' : ''}}"><text class="rank-number">{{item.place}}</text><text>{{item.name}}</text><text class="rank-clock">{{item.clock}}</text></view><view class="muted">{{yearSource}}</view></block>
    </view>
    <view class="card"><view class="section-label">今年已知阵容 <text>{{selected.competition.knownCount}} 人</text></view><view class="copy">{{selected.competition.notice}}</view><view wx:if="{{!selected.entrants.length}}" class="empty">暂无已知选手；没有标记不代表没有强手。</view><view wx:for="{{selected.entrants}}" wx:key="key" class="entrant"><view class="entrant-top"><text>{{item.name}}</text><text class="rank-clock">{{item.clock}}</text></view><view class="muted">{{item.status}} · {{item.evidenceLabel}} · PB {{item.pbDate}}</view></view>
      <button wx:if="{{!selected.demo && !preview}}" class="outline" bindtap="openEntry">{{selected.myEntry ? '管理我的参赛线索' : '我已中签，补充阵容'}}</button>
      <view wx:if="{{selected.demo}}" class="muted">当前阵容为模拟资料。</view>
      <view wx:if="{{entryOpen}}" class="entry-form"><view class="title">我的参赛线索</view><view class="copy">仅提交本人该项目的最好成绩。提交后会同步更新这场比赛的参赛状态，其他用户可看到匿名 PB、日期、项目、性别与自报状态。</view><view class="target-label">本人 PB</view><input value="{{entryClock}}" bindinput="onEntryClock" placeholder="例如 2:18:30" aria-label="本人 PB" /><view class="target-label">PB 日期</view><picker mode="date" value="{{entryDate}}" bindchange="onEntryDate"><view class="picker-field">{{entryDate || '选择成绩日期'}}</view></picker><view class="target-label">当前参赛状态</view><picker range="{{entryStatuses}}" value="{{entryStatusIndex}}" bindchange="onEntryStatus"><view class="picker-field">{{entryStatuses[entryStatusIndex]}}</view></picker><checkbox-group bindchange="onConsent"><label class="consent"><checkbox value="agree" checked="{{consent}}" color="#ff1838" /><text>同意将以上内容匿名用于今年阵容分析，可随时撤回。</text></label></checkbox-group><view wx:if="{{entryMessage}}" class="err">{{entryMessage}}</view><button class="btn" disabled="{{busy}}" loading="{{busy}}" bindtap="saveEntry">保存参赛线索</button><button wx:if="{{selected.myEntry}}" class="outline" disabled="{{busy}}" bindtap="withdrawEntry">撤回雷达授权</button></view>
    </view>
    <navigator wx:if="{{!preview}}" class="btn race-link" url="/pages/race/race?id={{selected.race.id}}">查看赛事详情 ↗</navigator>
    <view class="method-note">近三届同计时口径奖励线的中位数作为参考。目标成绩用于情景比较，PB 不等于本场必然表现；今年已知选手与历年榜单分开统计。</view>
  </block>
</view>
