.radar-page{padding-bottom:40px}.radar-hero,.detail-hero{padding:14px 4px 24px}.eyebrow{color:var(--brand);font-size:12px;font-weight:600;letter-spacing:1px}.hero-title{margin:10px 0 10px;font-size:30px;font-weight:700;line-height:1.3;letter-spacing:-1px}.card{padding:20px;border-radius:16px}.section-label,.results-head,.card-top,.card-foot,.entrant-top,.award-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.section-label{font-size:16px;font-weight:600}.section-label>text{color:var(--text-secondary);font-size:12px;font-weight:400}.segments,.gender-row{display:flex;gap:6px;margin-top:16px}.segments button,.gender-row button{flex:1;padding:8px 2px;min-height:40px;border-color:transparent;background:var(--page-bg);color:var(--text-secondary);font-size:13px}.segments .on,.gender-row .on{background:var(--brand-soft);color:var(--brand);border-color:#ffd3d9}.gender-row{margin-top:8px}.target-label{margin:20px 0 8px;color:var(--text-secondary);font-size:12px}.target-input{height:60px;min-height:60px;font-size:32px;font-weight:600;letter-spacing:2px;font-variant-numeric:tabular-nums}.target-card .muted{margin-top:10px}.btn{min-height:48px;margin-top:20px;border:0;gap:12px}.results-head{margin:26px 2px 12px}.filters{display:flex;gap:8px;margin-bottom:14px}.filters button{padding:8px 14px;min-height:40px;background:transparent;border-color:transparent;font-size:13px;color:var(--text-secondary)}.filters .active{background:var(--text);color:#fff}.level{display:inline-flex;border-radius:5px;padding:4px 7px;font-size:11px;background:#f3f3f3;color:#666}.level-priority{color:#137458;background:#eaf7f0}.level-challenge{color:#9a6211;background:#fff5e5}.level-pressure{color:#b93243;background:#fff0f2}.demo{display:inline-block;color:#8c6a32;background:#fff8ec;font-size:10px;padding:3px 6px;border:1px solid #f1dfbe;border-radius:4px}.race-name{font-size:20px;font-weight:650;line-height:1.45;margin:14px 0 5px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:20px 0}.metrics>view+view{border-left:1px solid var(--border);padding-left:14px}.metric-label{color:var(--text-secondary);font-size:11px}.clock{font-size:25px;font-weight:650;line-height:1.6;letter-spacing:-1px;font-variant-numeric:tabular-nums}.gap{color:var(--brand);font-size:11px;line-height:1.7}.competition-note{font-size:12px;padding:10px 12px;background:var(--page-bg);border-radius:8px;color:#565656}.card-foot{border-top:1px solid var(--border);margin-top:16px;padding-top:14px;font-size:12px}.card-foot>text:last-child{font-size:20px;color:var(--brand)}.copy{font-size:13px;line-height:1.8;color:var(--text-secondary);margin-top:12px;overflow-wrap:anywhere}.method-note{color:#888;font-size:11px;line-height:1.9;padding:10px 6px}.empty .title{font-size:16px;color:var(--text)}.back-button{padding:0;background:transparent;justify-content:flex-start;border:0;font-size:13px;color:var(--text-secondary)}.detail-hero .demo{margin-top:10px}.assessment .metrics{padding-bottom:8px}.year-scroll{width:100%;margin-top:16px}.year-tabs{display:flex;gap:6px;white-space:nowrap;padding-bottom:12px}.year-tabs button{flex-shrink:0;min-height:38px;padding:6px 14px;border-color:transparent;font-size:13px;background:var(--page-bg)}.year-tabs .on{color:var(--brand);background:var(--brand-soft)}.rank-row{display:grid;grid-template-columns:36px minmax(0,1fr) 90px;align-items:center;gap:8px;min-height:46px;font-size:13px;border-bottom:1px solid var(--border)}.rank-row>text:nth-child(2){overflow-wrap:anywhere}.rank-row>text:last-child{text-align:right}.rank-head{min-height:36px;color:var(--text-secondary);font-size:11px}.rank-number{font-weight:600;color:#999}.rewarded .rank-number{color:var(--brand)}.rank-clock{font-variant-numeric:tabular-nums;letter-spacing:.2px}.history-card>.muted:last-child{margin-top:14px;overflow-wrap:anywhere}.entrant{padding:14px 0;border-bottom:1px solid var(--border)}.entrant-top{font-size:14px;margin-bottom:4px}.outline{width:100%;min-height:44px;margin-top:16px;border:1px solid var(--border);background:#fff;font-size:13px}.entry-form{margin-top:20px;padding-top:20px;border-top:1px solid var(--border)}.entry-form input{height:46px}.picker-field{padding:12px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font-size:14px}.consent{display:flex;align-items:flex-start;gap:8px;margin-top:18px;font-size:12px;color:var(--text-secondary);line-height:1.8}.consent checkbox{flex-shrink:0;transform:scale(.8);transform-origin:left top;width:24px}.award-row{padding:10px 0;border-bottom:1px solid var(--border);font-size:13px}.race-link{margin:8px 0 16px}.error-card{padding:14px;background:#fff0f2;color:#b93243;border-radius:12px;font-size:12px}.error-card button{margin-top:10px;min-height:40px;font-size:12px}
