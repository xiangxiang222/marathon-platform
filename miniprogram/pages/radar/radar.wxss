 .mini-radar-radar{padding:16px;color:var(--text)}.card{padding:16px;margin:0 0 12px;border:0;border-radius:12px;background:#fff}.title{font-size:18px;font-weight:600}.card:first-child>.title{font-size:24px}.src{margin-top:8px;color:var(--text-secondary);font-size:12px;line-height:1.8}.slot{display:flex;justify-content:space-between;gap:12px;margin:16px 0 0;padding:12px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);font-size:14px}.slot-state{font-size:12px;color:var(--text-secondary)}.field-label{display:flex;justify-content:space-between;gap:12px;margin-top:16px;font-size:14px}.field-label text{color:var(--text-secondary);font-size:12px}.radar-gender{display:flex;gap:8px;margin-top:8px}.radar-gender .ghost{flex:1;width:0;min-height:44px;margin:0;border:1px solid var(--border);border-radius:8px;font-size:14px;background:#fff;color:var(--text-secondary)}.radar-gender .on{border-color:var(--brand);background:var(--brand-soft);color:var(--brand)}input{width:100%;height:44px;min-height:44px;margin-top:8px;padding:0 12px;box-sizing:border-box;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font-size:14px}.card .btn{display:flex;align-items:center;justify-content:center;width:100%;min-height:44px;margin-top:24px;border-radius:8px;background:var(--brand);color:#fff;font-size:14px;font-weight:500}.card navigator:not(.btn){display:block;padding:12px 0;border-bottom:1px solid var(--border)}.err{margin-top:12px;font-size:14px;color:var(--brand)}

.radar-kicker { font-size:12px; color:var(--brand); margin-bottom:6px; }.radar-section-label { display:flex; justify-content:space-between; gap:8px; margin-top:20px; padding-top:16px; border-top:1px solid var(--border); font-size:16px; font-weight:600; }.radar-section-label text { color:var(--text-secondary); font-size:12px; font-weight:400; }.radar-targets { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 12px; }.radar-targets .field-label { margin-top:12px; }.radar-notes { margin-top:16px; color:var(--text-secondary); font-size:12px; line-height:1.7; }
