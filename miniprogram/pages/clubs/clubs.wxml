<view class="pad">
  <view wx:if="{{!ready}}" class="card">
    <view class="muted">先起个昵称。有口令直接进，没有就申请。</view>
    <view class="field">
      <input placeholder="怎么称呼你" value="{{draft}}" bindinput="onDraft" />
      <button class="btn" bindtap="enter">进入</button>
    </view>
    <view wx:if="{{message}}" class="err">{{message}}</view>
  </view>
  <block wx:else>
    <view class="card">
      <view class="h2">建一个团</view>
      <view wx:if="{{leader}}" class="muted">只有团长能提交。通过后你是团长，可以在这里管理成员、活动和组别。</view>
      <view wx:else class="muted">只有团长可以建团。请跑团管理员先把你设为团长。</view>
      <view wx:if="{{leader && application}}" class="foot"><text>{{application.name}}</text><text>等待审核</text></view>
      <view wx:elif="{{leader}}" class="field">
        <input placeholder="跑团名称" value="{{name}}" bindinput="onName" />
        <button class="btn" bindtap="create">提交</button>
      </view>
    </view>
    <view class="card">
      <view class="h2">加入跑团</view>
      <view class="muted">有口令直接进。不填口令就申请，等团长或跑团管理通过。</view>
      <view class="field">
        <input placeholder="口令，可空" value="{{code}}" bindinput="onCode" />
        <button class="btn" bindtap="join">用口令加入</button>
      </view>
      <view wx:if="{{message}}" class="err">{{message}}</view>
    </view>
    <view wx:for="{{openClubs}}" wx:key="id" class="card">
      <view class="title">{{item.name}}</view>
      <view class="foot">
        <text>{{item.members}} 人</text>
        <text wx:if="{{item.pending}}">等待审核</text>
        <button wx:else class="ghost" data-id="{{item.id}}" bindtap="apply">申请加入</button>
      </view>
    </view>
    <navigator wx:for="{{clubs}}" wx:key="id" class="card link" url="/pages/club/club?id={{item.id}}">
      <view class="title">{{item.name}}</view>
      <view class="foot"><text>口令，发到微信群</text><text>{{item.code}}</text></view>
    </navigator>
    <view wx:if="{{loaded && !clubs.length && !openClubs.length}}" class="empty">还没有跑团。建一个，把口令发到微信群。别人也可以不填口令来申请。</view>
  </block>
</view>
