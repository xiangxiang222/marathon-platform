<view class="pad">
  <view wx:if="{{!ready}}" class="card">
    <view class="muted">先到「我的」登录。登录之后才能加入跑团。</view>
    <navigator class="login-go" open-type="switchTab" url="/pages/mine/mine">去登录</navigator>
  </view>
  <block wx:else>
    <view class="card">
      <view class="h2">加入跑团</view>
      <view class="muted">两种方式选一种。</view>
      <view class="modes">
        <view class="mode {{mode === 'search' ? 'on' : ''}}" data-mode="search" bindtap="pickMode">搜跑团</view>
        <view class="mode {{mode === 'code' ? 'on' : ''}}" data-mode="code" bindtap="pickMode">用口令</view>
      </view>
      <view wx:if="{{mode === 'code'}}" class="muted">填群里的口令，马上进团。</view>
      <view wx:else class="muted">边输入边列出来。跑团名以输入开头的排在前面，也可以搜团长或跑团管理。先显示 6 个。</view>
      <view wx:if="{{mode === 'code'}}" class="field">
        <input placeholder="口令" value="{{code}}" bindinput="onCode" confirm-type="done" bindconfirm="join" />
        <button class="btn" bindtap="join">加入</button>
      </view>
      <view wx:else class="field">
        <input placeholder="跑团名、团长" value="{{query}}" bindinput="onQuery" confirm-type="search" bindconfirm="search" />
      </view>
      <view wx:if="{{message}}" class="err">{{message}}</view>
    </view>
    <view wx:if="{{mode === 'search'}}" wx:for="{{openClubs}}" wx:key="id" class="card">
      <view class="title">{{item.name}}</view>
      <view class="foot">
        <text>{{item.members}} 人{{item.leader ? ' · 团长 ' + item.leader : ''}}</text>
        <navigator wx:if="{{item.joined}}" url="/pages/club/club?id={{item.id}}">已加入</navigator>
        <text wx:elif="{{item.pending}}">等待审核</text>
        <button wx:else class="ghost" data-id="{{item.id}}" bindtap="apply">申请加入</button>
      </view>
    </view>
    <view wx:if="{{mode === 'search' && more}}" class="more" bindtap="showRest">还有 {{more}} 个，显示全部</view>
    <navigator wx:for="{{clubs}}" wx:key="id" class="card link" url="/pages/club/club?id={{item.id}}">
      <view class="title">{{item.name}}</view>
      <view class="foot"><text>{{item.roleLabel}} · 口令</text><text>{{item.code}}</text></view>
    </navigator>
    <view wx:if="{{loaded && mode === 'search' && !query && !clubs.length && !openClubs.length}}" class="empty">还没有可加入的跑团。</view>
    <view class="card">
      <view class="h2">创建跑团</view>
      <view wx:if="{{leader}}" class="muted">只有团长能提交。通过后你是团长，可以在这里管理成员、活动和组别。</view>
      <view wx:else class="muted">只有团长可以建团。请跑团管理员先把你设为团长。</view>
      <view wx:if="{{foundingMessage}}" class="err">{{foundingMessage}}</view>
      <view wx:if="{{leader && application}}" class="foot"><text>{{application.name}}</text><text>等待审核</text></view>
      <view wx:elif="{{leader}}" class="field">
        <input placeholder="跑团名称" value="{{name}}" bindinput="onName" />
        <button class="btn" bindtap="create">提交</button>
      </view>
    </view>
  </block>
</view>
