<page-header title="跑团" subtitle="和同频的人，一起出发"></page-header>
<view class="clubs-page mini-clubs-clubs">
  <view class="my-clubs">
    <view class="section-heading"><text class="section-title">我的跑团</text><text wx:if="{{ready && clubs.length}}" class="section-count">{{clubs.length}} 个</text></view>
    <view wx:if="{{!ready}}" class="login-card">
      <view class="club-letter">团</view>
      <view class="login-copy"><view class="club-name">登录后查看我的跑团</view><view class="meta">团练、赛事与跑步记录都在这里</view></view>
      <navigator class="small-action" open-type="switchTab" url="/pages/mine/mine">登录</navigator>
    </view>
    <block wx:else>
      <view wx:if="{{clubs.length > 4}}" class="mine-search"><view class="search-icon"></view><input placeholder="搜索名称、城市或团号" value="{{mineQuery}}" bindinput="onMineQuery" confirm-type="search" aria-label="搜索我的跑团" /></view>
      <view wx:if="{{mineSearching}}" class="mine-search-status">找到 {{mineMatchCount}} 个已加入的跑团</view>
      <view wx:if="{{shownClubs.length}}" class="my-club-list">
        <view wx:for="{{shownClubs}}" wx:key="id" class="my-club">
          <navigator class="club-main" url="/pages/club/club?id={{item.id}}" aria-label="{{item.name}}，进入跑团"><image wx:if="{{item.logo && !item.logoFailed}}" class="club-letter" src="{{item.logo}}" data-id="{{item.id}}" data-src="{{item.logo}}" binderror="clubLogoError" mode="aspectFill" /><view wx:else class="club-letter">{{item.initial}}</view><view class="club-copy"><view class="club-name">{{item.name}}</view><view class="meta my-club-meta"><text class="my-club-city">{{item.cityLabel}}</text><text wx:if="{{item.memberCount != null}}">· {{item.memberCount}}人</text><text wx:if="{{item.roleLabel}}" class="my-role {{item.role === 'owner' || item.role === 'manager' ? 'leader' : ''}}">{{item.roleLabel}}</text></view></view></navigator>
          <view class="club-quick-actions"><navigator url="/pages/club/club?id={{item.id}}&tab=training" aria-label="{{item.name}}的团练"><text>团练</text></navigator><navigator url="/pages/club/club?id={{item.id}}&tab=matches" aria-label="{{item.name}}的赛事"><text>赛事</text></navigator></view>
        </view>
      </view>
      <button wx:if="{{clubs.length > 4 && !mineSearching}}" class="mine-expand" bindtap="toggleMineExpanded" aria-expanded="{{mineExpanded}}">{{mineExpanded ? '收起跑团' : '查看全部 ' + clubs.length + ' 个跑团'}}<text>{{mineExpanded ? '⌃' : '⌄'}}</text></button>
      <view wx:if="{{clubs.length && !shownClubs.length}}" class="no-clubs">没有找到这个跑团，试试其他名称。</view>
      <view wx:if="{{!clubs.length}}" class="no-clubs"><view class="no-club-title">{{loaded ? '跑团生活，从一起出发开始' : '正在加载跑团…'}}</view><view wx:if="{{loaded}}" class="meta">搜一搜熟悉的跑团，或输入朋友分享的口令</view></view>
    </block>
  </view>

  <view id="create-club" class="create-card">
    <button class="create-entry" bindtap="openCreate" aria-label="创建跑团，打开独立填写页"><view class="create-mark">＋</view><view class="create-copy"><view class="club-name">{{application ? '继续创建跑团' : '创建一个新跑团'}}</view><view class="meta">{{application ? '继续之前未完成的申请' : '把一起跑步的人聚在一起'}}</view></view><text class="create-toggle">›</text></button>
  </view>

  <view id="discover-clubs" class="discover">
    <view class="directory-heading"><view class="section-title">发现跑团</view><text class="section-count">找同城跑友</text></view>
    <view class="directory-tools">
      <view class="modes">
        <button class="mode {{mode === 'search' ? 'on' : ''}}" data-mode="search" bindtap="pickMode">搜索跑团</button>
        <button class="mode {{mode === 'code' ? 'on' : ''}}" data-mode="code" bindtap="pickMode">口令加入</button>
      </view>
      <block wx:if="{{mode === 'search'}}">
        <view class="search-row"><view class="search-field"><view class="search-icon"></view><input placeholder="跑团名称、负责人或团号" value="{{query}}" bindinput="onQuery" confirm-type="search" bindconfirm="search" aria-label="跑团名称、负责人或团号" /><button class="search-action" bindtap="search"><text>搜索</text></button></view></view>
        <view class="city-filter"><view class="city-pin" aria-hidden="true"></view><text>活动城市</text><input placeholder="不限城市" maxlength="30" value="{{searchCity}}" bindinput="onSearchCity" bindconfirm="search" confirm-type="search" aria-label="筛选活动城市" /><button wx:if="{{searchCity}}" class="city-reset" bindtap="clearSearchCity">不限</button><button class="city-apply" bindtap="search">筛选</button></view>
      </block>
      <view wx:else class="search-field code-field"><view class="search-icon"></view><input placeholder="输入朋友分享的跑团口令" value="{{code}}" bindinput="onCode" confirm-type="done" bindconfirm="join" aria-label="输入朋友分享的跑团口令" /><button class="search-action" bindtap="join"><text>查看</text></button></view>
      <view wx:if="{{mode === 'code'}}" class="helper">输入口令查看跑团介绍，再申请加入。</view>
      <view wx:if="{{message}}" class="message">{{message}}</view>
      <block wx:if="{{ready && mode === 'search'}}">
        <view wx:for="{{openClubs}}" wx:key="id" class="result-row">
          <image wx:if="{{item.logo && !item.logoFailed}}" class="result-avatar" src="{{item.logo}}" data-id="{{item.id}}" data-src="{{item.logo}}" binderror="clubLogoError" mode="aspectFill" /><view wx:else class="result-avatar">{{item.initial}}</view>
          <view class="club-copy"><view class="club-name">{{item.name}}</view><view class="meta">{{item.cityLabel}} · {{item.memberCount != null ? item.memberCount + ' 位成员' : '查看跑友'}}</view><button wx:if="{{item.verified}}" class="verified-mark" data-id="{{item.id}}" bindtap="verifiedInfo" aria-label="查看跑团身份核验信息">✓ 身份已核验</button></view>
          <navigator wx:if="{{item.joined}}" class="result-action joined" url="/pages/club/club?id={{item.id}}"><text>进入</text><text class="action-arrow">›</text></navigator>
          <text wx:elif="{{item.pending}}" class="pending-badge">审核中</text>
          <button wx:else class="result-action" data-id="{{item.id}}" bindtap="openClub"><text>查看</text><text class="action-arrow">›</text></button>
        </view>
        <button wx:if="{{more}}" class="show-more" loading="{{directoryBusy}}" disabled="{{directoryBusy}}" bindtap="showRest">继续查看跑团 · 第 {{directoryPage}} / {{directoryPages}} 页</button><view wx:elif="{{directoryBusy}}" class="helper">正在寻找跑友…</view>
        <view wx:if="{{loaded && !query && !openClubs.length}}" class="helper">暂时没有更多跑团，试试搜索或口令加入</view>
      </block>
    </view>
  </view>

  <navigator wx:if="{{ready}}" class="private-reports-link" url="/pages/club-report/club-report">跑团身份反馈与申诉 ›</navigator>
</view>
