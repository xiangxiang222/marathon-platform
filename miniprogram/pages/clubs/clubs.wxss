page{background:#f7f5fa}
.clubs-page{--accent:#55388c;--tint:#f3eefc;--line:#eae6ef;--muted:#655d70;--ink:#302740;padding:0 16px 20px;color:var(--ink);font-size:14px;line-height:1.5}
.clubs-page button{display:flex;align-items:center;justify-content:center;width:auto;min-width:0;min-height:44px;margin:0;padding:0 8px;border:0;border-radius:9px;background:transparent;font-size:14px;line-height:1.4}
.clubs-page button::after{border:0}
.club-hero{position:relative;min-height:132px;margin:0 -16px;padding:16px 20px 48px;background:radial-gradient(ellipse at 76% 5%,#fcf9ff 0%,#ffffff00 56%),linear-gradient(110deg,#e0d5f3,#e9e2f6 60%,#f3eefc);color:var(--ink);font-size:30px;font-weight:650}
.club-hero image{position:absolute;top:4px;right:24px;width:108px;height:100px;opacity:.72}
.club-services,.my-clubs,.discover{margin-bottom:12px;padding:14px 15px;border-radius:18px;background:#fff}
.club-services{position:relative;margin-top:-36px;box-shadow:0 8px 24px #37264d14}
.directory-heading,.results-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.section-title{margin-bottom:8px;font-size:18px;font-weight:650}.directory-heading .section-title{margin:0}
.section-count,.meta,.helper,.mine-search-status{color:var(--muted);font-size:12px}
.clubs-page .club-primary{display:flex;align-items:center;justify-content:center;width:100%;min-height:48px;border-radius:24px;background:linear-gradient(110deg,#7453b5,var(--accent));color:#fff;font-weight:600}
.club-services-links{display:flex;gap:8px;margin-top:8px}.club-services-links button{flex:1;gap:4px;background:var(--tint);color:var(--accent);font-size:13px}
.create-entry image{width:20px;height:20px}
.club-letter,.result-avatar{display:grid;place-items:center;flex:none;width:42px;height:42px;border-radius:10px;overflow:hidden;background:var(--tint);color:var(--accent);font-size:18px}
.club-copy{flex:1;min-width:0}.club-title-line{display:flex;align-items:center;flex-wrap:wrap;gap:5px}.club-name{min-width:0;overflow-wrap:anywhere;font-size:15px;font-weight:550}
.meta{margin-top:4px;overflow-wrap:anywhere}.my-club-meta{display:flex;gap:4px;flex-wrap:wrap}
.mine-search,.search-field{display:flex;align-items:center;gap:8px;min-height:46px;padding:0 6px 0 10px;border-radius:9px;background:#f8f6fb}
.mine-search input,.search-field input,.city-filter input{flex:1;width:0;min-width:0;height:44px;padding:0;border:0;background:transparent;color:var(--ink);font-size:14px}
.mine-search-status{margin-top:8px}
.my-club,.result-row{display:flex;align-items:center;min-height:76px;gap:8px;padding:8px 0}
.my-club+.my-club,.result-row+.result-row{border-top:1px solid var(--line)}
.club-main{display:flex;align-items:center;flex:1;min-width:0;min-height:54px;gap:8px}
.my-role,.pending-badge{padding:1px 5px;border-radius:4px;background:var(--tint);color:var(--muted);font-size:12px}
.my-role.leader,.result-action.joined{color:var(--accent)}
.club-quick-actions{display:flex;flex:none;gap:2px}
.club-quick-actions navigator,.clubs-page .result-action{display:flex;align-items:center;justify-content:center;flex:none;gap:3px;min-width:44px;min-height:44px;color:var(--muted);font-size:12px}
.club-quick-actions navigator>text{padding:5px 3px;border:1px solid var(--line);border-radius:6px}
.clubs-page .mine-expand,.clubs-page .show-more{width:100%;gap:6px;border-top:1px solid var(--line);color:var(--accent);font-size:12px}
.no-clubs,.helper{padding:9px 0}
.modes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding:3px;margin-bottom:10px;border-radius:13px;background:var(--tint)}
.clubs-page .mode{width:100%;color:var(--muted)}
.clubs-page .mode.on{background:#fff;color:var(--accent);font-weight:600}
.search-icon{position:relative;flex:none;width:13px;height:13px;margin-right:2px;border:1.5px solid var(--muted);border-radius:50%}
.search-icon::after{position:absolute;right:-4px;bottom:-2px;width:5px;height:1.5px;background:var(--muted);content:'';transform:rotate(45deg)}
.clubs-page .search-action{flex:none;width:56px;color:var(--accent)}
.city-filter{display:flex;align-items:center;gap:6px;min-height:48px;border-bottom:1px solid var(--line);color:var(--muted);font-size:12px}
.city-filter input{font-size:12px}.city-filter>text{flex:none}.city-pin{width:8px;height:10px;border:1.2px solid var(--muted);border-radius:7px 7px 7px 0;transform:rotate(-45deg)}
.clubs-page .city-reset,.clubs-page .city-apply{min-width:44px;padding:0;color:var(--accent);font-size:12px}
.results-heading{margin-top:12px;font-weight:600}.results-heading .section-count{font-weight:400}
.directory-context,.message{padding:6px 8px;border-radius:8px;color:var(--accent);background:var(--tint);font-size:12px;overflow-wrap:anywhere}
.message{display:flex;align-items:center;justify-content:space-between;gap:8px}.message button{flex:none;color:var(--accent);font-size:12px}
.action-arrow{font-size:17px}.clubs-page .result-action{padding:0}.clubs-page .verified-mark{justify-content:flex-start;padding:0;color:var(--accent);font-size:12px}
.private-reports-link{display:flex;align-items:center;justify-content:center;min-height:44px;color:var(--muted);font-size:12px}
