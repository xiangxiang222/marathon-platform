.clubs-page { min-height:100vh; padding:8rpx 24rpx 48rpx; box-sizing:border-box; color:#252932; background:#f5f6f8; font-size:27rpx; line-height:1.5; }
.clubs-page button { display:flex; align-items:center; justify-content:center; min-height:88rpx; margin:0; padding:16rpx 22rpx; box-sizing:border-box; border-radius:14rpx; font-size:26rpx; font-weight:500; line-height:1.25; }
.clubs-page button::after { border:0; }
.clubs-welcome { padding:28rpx 8rpx 24rpx; }
.welcome-eyebrow { color:#b1a0a6; font-size:20rpx; font-weight:500; letter-spacing:4rpx; }
.welcome-title { margin-top:14rpx; color:#252932; font-size:42rpx; font-weight:700; line-height:1.55; letter-spacing:-1rpx; }
.welcome-copy { margin-top:12rpx; color:#969ba5; font-size:24rpx; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:24rpx 4rpx 16rpx; }
.section-title { color:#252932; font-size:32rpx; font-weight:700; }
.section-count { color:#9a9faa; font-size:23rpx; }
.surface { margin-bottom:18rpx; border-radius:24rpx; background:#fff; }
.my-club { overflow:hidden; border:1rpx solid #eeedf0; box-shadow:0 8rpx 24rpx #251a2303; }
.club-main { display:flex; align-items:center; gap:20rpx; padding:26rpx; }
.club-letter { display:flex; flex:none; align-items:center; justify-content:center; width:84rpx; height:84rpx; color:#e70027; background:#fff0f3; border-radius:22rpx; font-size:36rpx; font-weight:600; }
.club-copy,.login-copy { flex:1; min-width:0; }
.club-name { color:#30343d; font-size:30rpx; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.my-meta { display:flex; flex-wrap:wrap; align-items:center; gap:8rpx 14rpx; margin-top:10rpx; color:#959aa4; font-size:22rpx; }
.role-badge { padding:2rpx 10rpx; color:#d5536c; background:#fff1f4; border-radius:6rpx; font-size:20rpx; }
.enter { flex:none; color:#b4b7be; font-size:38rpx; font-weight:400; }
.club-quick-actions { display:flex; gap:20rpx; margin:0 26rpx; padding:10rpx 0; border-top:1rpx solid #f2f3f5; }
.club-quick-actions navigator { display:flex; flex:1; align-items:center; justify-content:space-between; min-height:72rpx; padding:0 8rpx; box-sizing:border-box; color:#737b87; font-size:24rpx; }
.club-quick-actions navigator+ navigator { border-left:1rpx solid #f1f2f4; padding-left:24rpx; }
.club-quick-actions navigator>text:last-child { color:#c5a0aa; }
.mine-search { display:flex; align-items:center; gap:18rpx; min-height:88rpx; margin-bottom:18rpx; padding:0 24rpx; border:1rpx solid #eceef2; border-radius:16rpx; background:#fff; }
.mine-search input { flex:1; min-width:0; height:88rpx; font-size:25rpx; }
.login-card { display:flex; align-items:center; gap:18rpx; padding:26rpx; }
.meta { margin-top:6rpx; color:#959ba6; font-size:23rpx; line-height:1.6; overflow-wrap:anywhere; }
.small-action { display:flex; flex:none; align-items:center; justify-content:center; min-height:80rpx; padding:0 18rpx; border-radius:14rpx; color:#ff0a30; background:#fff0f3; font-size:25rpx; }
.no-clubs { padding:30rpx 26rpx; color:#9ba0a9; font-size:25rpx; line-height:1.8; }
.discover { padding:22rpx 24rpx; }
.modes { display:flex; gap:12rpx; padding:4rpx; margin-bottom:20rpx; border-radius:14rpx; background:#f1f3f6; }
.clubs-page .mode { flex:1; min-height:76rpx; padding:12rpx; color:#9298a2; background:transparent; font-size:25rpx; }
.clubs-page .mode.on { color:#343a45; background:#fff; font-weight:600; box-shadow:0 2rpx 6rpx #151a2305; }
.search-field { display:flex; align-items:center; gap:18rpx; padding:0 16rpx; min-height:88rpx; box-sizing:border-box; border:1rpx solid #eceef3; border-radius:14rpx; background:#f8f9fb; }
.search-field input { flex:1; min-width:0; height:88rpx; font-size:25rpx; }
.search-icon { position:relative; flex:none; width:22rpx; height:22rpx; margin-right:4rpx; border:3rpx solid #afb5bf; border-radius:50%; }
.search-icon::after { position:absolute; right:-9rpx; bottom:-6rpx; content:''; width:12rpx; height:3rpx; background:#afb5bf; transform:rotate(45deg); }
.clubs-page .search-action { flex:none; min-height:80rpx; padding:12rpx 6rpx; color:#ff0a30; background:transparent; font-size:25rpx; }
.helper { margin-top:18rpx; color:#a0a5af; font-size:23rpx; line-height:1.7; }
.message { margin-top:20rpx; padding:16rpx; border-radius:10rpx; color:#bc5367; background:#fff2f5; font-size:24rpx; }
.result-row { display:flex; align-items:center; gap:18rpx; min-height:122rpx; padding:22rpx 0; border-bottom:1rpx solid #f1f2f5; box-sizing:border-box; }
.result-row:last-child { border-bottom:0; }
.result-avatar { display:flex; flex:none; align-items:center; justify-content:center; width:68rpx; height:68rpx; border-radius:18rpx; color:#81828d; background:#f1f2f6; font-size:30rpx; font-weight:600; }
.result-row .club-name { font-size:27rpx; }
.result-row .meta { font-size:21rpx; }
.clubs-page .result-action,.result-action { display:flex; flex:none; align-items:center; justify-content:center; min-height:76rpx; padding:12rpx 16rpx; box-sizing:border-box; color:#e70027; background:#fff0f3; border-radius:12rpx; font-size:23rpx; }
.result-action.joined { color:#8b929e; background:#f3f4f7; }
.pending-badge { flex:none; color:#b98243; font-size:23rpx; }
.clubs-page .show-more { width:100%; min-height:88rpx; padding:16rpx 0; color:#8c939e; background:transparent; font-size:24rpx; }
.create-card { margin-top:24rpx; overflow:hidden; }
.clubs-page .create-entry { justify-content:space-between; gap:20rpx; width:100%; padding:24rpx; min-height:120rpx; color:#30343d; background:#fff; text-align:left; }
.create-entry .club-name { font-size:28rpx; }
.create-toggle { flex:none; color:#9ba0aa; font-size:23rpx; }
.create-form { padding:0 24rpx 24rpx; border-top:1rpx solid #f2f3f5; }
.application { display:flex; justify-content:space-between; align-items:center; gap:20rpx; margin-top:18rpx; font-size:25rpx; }
.create-field { display:flex; gap:16rpx; margin-top:18rpx; }
.create-field input { flex:1; min-width:0; height:88rpx; padding:0 18rpx; border-radius:14rpx; background:#f6f7f9; font-size:25rpx; }
.clubs-page .submit { flex:none; color:#fff; background:#ff0a30; font-size:25rpx; }
@media (max-width:350px) {
 .clubs-page { padding-left:20rpx; padding-right:20rpx; }
 .welcome-title { font-size:40rpx; }
 .welcome-copy { font-size:25rpx; }
 .login-card { flex-wrap:wrap; }
 .login-copy { min-width:300rpx; }
 .small-action { width:100%; }
 .result-row { gap:14rpx; }
 .result-avatar { width:64rpx; height:64rpx; }
}

.city-filter { margin-top:14rpx; }
.city-filter input,.create-input { width:100%; height:88rpx; padding:0 20rpx; font-size:26rpx; }
.field-label { display:flex; flex-wrap:wrap; gap:12rpx; margin:26rpx 0 12rpx; color:#333945; font-size:26rpx; font-weight:600; }
.field-label text { color:#989ca6; font-size:22rpx; font-weight:400; }
.city-choices { display:flex; gap:14rpx; margin-top:8rpx; }
.clubs-page .city-choices button { min-width:116rpx; min-height:88rpx; padding:12rpx 20rpx; color:#737985; background:transparent; font-size:24rpx; }
.create-intro { width:100%; min-height:132rpx; padding:20rpx; font-size:26rpx; line-height:1.6; }
.name-notice,.legacy-application { margin-top:22rpx; padding:20rpx; border-radius:16rpx; background:#f7f6f8; }
.notice-title { font-size:26rpx; font-weight:600; }
.name-notice .helper,.legacy-application .helper { margin-top:8rpx; }
.duplicate-row { display:flex; align-items:center; gap:16rpx; padding:20rpx 0; border-bottom:1rpx solid #e9e8ec; }
.duplicate-row:last-child { padding-bottom:0; border-bottom:0; }
.clubs-page .verified-mark { display:inline-flex; justify-content:flex-start; min-height:88rpx; padding:8rpx 0; color:#5e686b; background:transparent; font-size:22rpx; }
.clubs-page .create-submit { width:100%; margin-top:24rpx; min-height:96rpx; }
.clubs-page .secondary-action { width:100%; margin-top:16rpx; color:#67707c; background:#fff; }
.private-reports-link { display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:12rpx 20rpx; color:#8a8e99; font-size:23rpx; }
.result-action,.small-action,.club-quick-actions navigator { min-height:88rpx; }
@media (max-width:350px) { .result-row { flex-wrap:wrap; } .result-row .club-copy { min-width:340rpx; } .result-row .result-action,.result-row .pending-badge { margin-left:78rpx; } }

@media (max-width:350px) { .clubs-page button,.clubs-page .result-action,.clubs-page .small-action,.clubs-page .club-quick-actions navigator,.private-reports-link { min-height:44px; } }
