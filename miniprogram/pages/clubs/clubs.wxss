page { background:var(--page-bg,#f5f5f5); }
.clubs-directory-heading { display:flex; align-items:center; gap:8px; min-width:0; min-height:44px; }
.clubs-directory-title { flex:none; color:var(--text); font-size:16px; font-weight:600; line-height:1.4; }
.clubs-directory-count { color:var(--text-secondary); font-size:12px; line-height:1.5; white-space:nowrap; }
.clubs-page { padding:0 16px 24px; color:var(--text); font-size:14px; line-height:1.5; }
.clubs-page button { display:flex; align-items:center; justify-content:center; width:auto; min-width:0; min-height:44px; margin:0; padding:0 12px; border:0; border-radius:8px; background:transparent; font-size:14px; font-weight:500; line-height:1.4; }
.clubs-page button::after { border:0; }
.my-clubs,.directory-tools,.create-card { border:0; border-radius:12px; background:#fff; }
.my-clubs { padding:14px 16px 0; }
.section-heading,.directory-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:12px; }
.section-title { font-size:16px; font-weight:600; line-height:1.4; }
.section-count,.directory-section-note { color:var(--text-secondary); font-size:12px; }
.directory-section-note { margin-top:5px; }
.login-card { display:flex; align-items:center; gap:10px; padding:10px 0 18px; }
.club-letter,.result-avatar { display:flex; flex:none; align-items:center; justify-content:center; width:44px; height:44px; overflow:hidden; border:0; border-radius:10px; background:var(--page-bg); color:var(--text); font-size:18px; font-weight:500; }
.login-copy,.club-copy { flex:1; min-width:0; }
.club-title-line { display:flex; align-items:center; flex-wrap:wrap; gap:6px; }
.club-name { min-width:0; overflow:hidden; color:var(--text); font-size:15px; font-weight:500; line-height:1.5; text-overflow:ellipsis; white-space:nowrap; }
.club-title-line .club-name { flex:0 1 auto; }
.meta { margin-top:5px; color:var(--text-secondary); font-size:12px; line-height:1.5; }
.small-action { display:flex; flex:none; align-items:center; justify-content:center; min-width:52px; min-height:44px; border-radius:8px; color:var(--brand); background:var(--brand-soft); font-size:14px; }
.mine-search,.search-field { display:flex; align-items:center; gap:10px; min-height:46px; padding:0 12px; border:0; border-radius:8px; background:var(--page-bg); }
.mine-search { margin:0 0 4px; }
.mine-search input,.search-field input { flex:1; width:0; min-width:0; height:44px; min-height:44px; padding:0; border:0; border-radius:0; background:transparent; color:var(--text); font-size:14px; }
.mine-search-status { margin:12px 0 2px; color:var(--text-secondary); font-size:12px; }
.my-club-list { width:100%; }
.my-club { display:flex; align-items:center; gap:8px; min-height:76px; padding:8px 0; }
.my-club+.my-club { border-top:1px solid var(--border); }
.club-main { display:flex; align-items:center; flex:1; min-width:0; min-height:62px; gap:10px; }
.my-club-meta { display:flex; align-items:center; gap:4px; overflow:hidden; }
.my-club-city { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.my-club-meta>text:last-child { flex:none; white-space:nowrap; }
.my-role { flex:none; padding:1px 5px; border-radius:4px; background:var(--page-bg); color:var(--text-secondary); font-size:12px; line-height:18px; }
.my-role.leader { color:var(--brand); background:var(--brand-soft); }
.club-quick-actions { display:flex; flex:none; align-items:center; gap:2px; }
.club-quick-actions navigator { display:flex; align-items:center; justify-content:center; width:44px; min-height:44px; color:var(--text-secondary); font-size:12px; }
.club-quick-actions navigator>text { padding:5px 3px; }
.clubs-page .mine-expand { width:100%; gap:8px; border-top:1px solid var(--border); color:var(--brand); font-size:12px; }
.mine-expand text { color:var(--text-secondary); font-size:16px; }
.no-clubs { padding:16px 0 20px; color:var(--text-secondary); font-size:12px; line-height:1.7; }
.no-club-title { color:var(--text); font-size:15px; font-weight:500; }
.create-card { overflow:hidden; margin:12px 0 24px; background:linear-gradient(110deg,#fff0f2 0%,#fff9fa 55%,#fff 100%); }
.clubs-page .create-entry { width:100%; min-height:84px; gap:12px; padding:14px; border-radius:12px; text-align:left; }
.create-entry:active { background:#ffe8ec; }
.create-icon { display:block; flex:none; width:56px; height:56px; }
.create-copy { flex:1; min-width:0; }
.create-title { color:var(--text); font-size:16px; font-weight:600; line-height:1.4; }
.create-description { margin-top:5px; color:var(--text-secondary); font-size:12px; font-weight:400; line-height:1.6; }
.create-arrow { display:flex; align-items:center; justify-content:center; flex:none; width:28px; height:28px; border-radius:50%; background:#fff; }
.create-arrow>view { width:6px; height:6px; margin-left:-2px; border-top:1.5px solid var(--brand); border-right:1.5px solid var(--brand); transform:rotate(45deg); }
.discover { margin-bottom:12px; }
.directory-tools { padding:0 16px 4px; }
.modes { display:flex; gap:20px; border-bottom:1px solid var(--border); }
.clubs-page .mode { position:relative; min-height:48px; padding:0; border-radius:0; color:var(--text-secondary); font-size:14px; }
.clubs-page .mode.on { color:var(--brand); }
.mode.on::after { position:absolute; bottom:0; left:0; right:0; height:2px; border:0; background:var(--brand); content:''; }
.directory-filter-group { padding:14px 0 0; }
.search-field { padding:0 6px 0 12px; }
.search-row { display:flex; }
.search-row .search-field { flex:1; min-width:0; }
.search-icon { position:relative; flex:none; width:13px; height:13px; margin-right:2px; border:1.5px solid #999; border-radius:50%; }
.search-icon::after { position:absolute; right:-4px; bottom:-2px; width:5px; height:1.5px; background:#999; content:''; transform:rotate(45deg); }
.clubs-page .search-action { flex:none; width:56px; min-height:44px; padding:0; color:#fff; font-size:12px; }
.search-action>text { display:flex; align-items:center; justify-content:center; width:56px; height:34px; border-radius:8px; background:var(--brand); }
.city-filter { display:flex; align-items:center; gap:8px; min-height:48px; border-bottom:1px solid var(--border); color:var(--text-secondary); font-size:12px; }
.city-filter>text { flex:none; }
.city-filter input { flex:1; width:0; min-width:0; min-height:44px; height:44px; padding:0; border:0; background:transparent; font-size:12px; }
.city-pin { width:9px; height:11px; border:1.3px solid #999; border-radius:7px 7px 7px 0; transform:rotate(-45deg); }
.clubs-page .city-reset,.clubs-page .city-apply { flex:none; min-width:36px; padding:0; color:var(--text-secondary); font-size:12px; }
.clubs-page .city-apply { color:var(--brand); }
.code-field { margin-top:14px; }
.helper { margin:10px 0; color:var(--text-secondary); font-size:12px; line-height:1.7; }
.message { margin:12px 0; padding:10px; border-radius:8px; color:var(--brand); background:var(--brand-soft); font-size:12px; line-height:1.7; }
.result-row { display:flex; align-items:center; min-height:84px; gap:10px; padding:12px 0; }
.result-row+.result-row { border-top:1px solid var(--border); }
.result-row .club-name { font-size:15px; }
.clubs-page .result-action { display:flex; align-items:center; justify-content:flex-end; flex:none; gap:4px; min-width:44px; min-height:44px; padding:0; color:var(--text-secondary); font-size:12px; }
.clubs-page .result-action.joined { color:var(--brand); }
.action-arrow { font-size:18px; }
.pending-badge { flex:none; padding:4px 6px; border-radius:4px; color:var(--text-secondary); background:var(--page-bg); font-size:12px; }
.clubs-page .verified-mark { justify-content:flex-start; min-height:44px; padding:0; color:var(--brand); font-size:12px; }
.clubs-page .show-more { width:100%; border-top:1px solid var(--border); color:var(--brand); font-size:12px; }
.private-reports-link { display:flex; align-items:center; justify-content:center; min-height:44px; color:var(--text-secondary); font-size:12px; }
@media(max-width:350px) { .club-main { gap:8px; } .club-quick-actions { gap:0; } }
