.h2 { font-size: 30rpx; font-weight: 650; margin-bottom: 16rpx; }
.field { margin-top: 16rpx; }
.modes { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.mode { height: 64rpx; line-height: 64rpx; padding: 0 28rpx; border-radius: 999rpx; background: rgba(118, 118, 128, 0.12); font-size: 28rpx; font-weight: 600; }
.mode.on { background: #007aff; color: #fff; }
.hit { display: flex; align-items: baseline; gap: 16rpx; margin: 0 0 0; padding: 24rpx 8rpx; border-bottom: 1rpx solid rgba(60, 60, 67, 0.12); }
.hit-name { min-width: 0; font-size: 30rpx; font-weight: 650; }
.hit-meta, .hit-wait { flex: none; color: #8e8e93; font-size: 26rpx; }
.hit navigator, .hit-go { margin-left: auto; flex: none; color: #007aff; font-weight: 650; font-size: 28rpx; background: none; padding: 0; line-height: 1.4; }
.more { margin: 0 0 24rpx; padding: 24rpx; border-radius: 24rpx; background: #fff; color: #007aff; text-align: center; font-weight: 650; }
.link { display: block; }
