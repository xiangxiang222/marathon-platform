.clubs-page { position:relative; margin-top:-28rpx; padding:0 24rpx 36rpx; box-sizing:border-box; color:var(--text); background:transparent; font-size:14px; line-height:1.5; }
.clubs-page button { display:flex; align-items:center; justify-content:center; min-height:44px; margin:0; box-sizing:border-box; border:0; border-radius:8px; font-size:13px; font-weight:500; line-height:1.25; }
.clubs-page button::after { border:0; }
.clubs-header-create { display:flex; align-items:center; justify-content:center; min-height:40px; margin:0 0 0 12rpx; padding:0 18rpx; border:1px solid rgba(255,255,255,.48); border-radius:9px; box-sizing:border-box; background:rgba(255,255,255,.1); color:#fff; font-size:12px; font-weight:500; line-height:1.2; white-space:nowrap; }
.clubs-header-create::after { border:0; }
.my-clubs { margin-bottom:36rpx; padding:26rpx; border-radius:14px; background:#fff; }
.section-heading { display:flex; align-items:center; gap:14rpx; min-height:46rpx; margin-bottom:20rpx; }
.section-title { color:var(--text); font-size:18px; font-weight:600; line-height:1.3; }
.section-count { color:var(--text-secondary); font-size:12px; }
.login-card { display:flex; align-items:center; gap:20rpx; }
.club-letter { display:flex; flex:none; align-items:center; justify-content:center; width:76rpx; height:76rpx; border-radius:10px; background:var(--brand-soft); color:var(--brand); font-size:18px; font-weight:600; }
.login-copy,.club-copy { flex:1; min-width:0; }
.club-name { overflow:hidden; color:var(--text); font-size:14px; font-weight:600; line-height:1.4; white-space:nowrap; text-overflow:ellipsis; }
.meta { margin-top:5rpx; overflow:hidden; color:var(--text-secondary); font-size:12px; line-height:1.4; white-space:nowrap; text-overflow:ellipsis; }
.small-action { display:flex; flex:none; align-items:center; justify-content:center; min-width:56px; min-height:44px; padding:0 20rpx; border-radius:8px; background:var(--brand); color:#fff; font-size:13px; font-weight:600; }
.mine-search { display:flex; align-items:center; gap:18rpx; min-height:44px; margin-bottom:18rpx; padding:0 22rpx; border:1px solid var(--border); border-radius:8px; background:var(--page-bg); }
.mine-search input { flex:1; min-width:0; height:44px; background:transparent; font-size:13px; }
.my-club-rail { display:flex; width:calc(100% + 52rpx); margin:0 -26rpx; padding:0 26rpx 2rpx; box-sizing:border-box; white-space:nowrap; }
.my-club { display:inline-flex; flex:0 0 535rpx; flex-direction:column; width:535rpx; min-height:208rpx; margin-right:18rpx; padding:20rpx; border:1px solid var(--border); border-radius:10px; box-sizing:border-box; background:#fff; vertical-align:top; white-space:normal; }
.my-club.single { flex-basis:100%; width:100%; }
.my-club:last-child { margin-right:0; }
.club-main { display:flex; align-items:center; gap:18rpx; }
.club-main > .club-letter { width:68rpx; height:68rpx; border-radius:9px; font-size:16px; }
.enter { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border-radius:50%; color:var(--text-secondary); background:var(--page-bg); font-size:19px; }
.my-club .club-copy { margin:0; }
.my-club .club-name { font-size:15px; }
.club-quick-actions { display:flex; gap:14rpx; margin-top:auto; padding-top:18rpx; }
.club-quick-actions navigator { display:flex; flex:1; align-items:center; justify-content:center; min-height:44px; border-radius:7px; background:var(--page-bg); color:var(--text-secondary); font-size:12px; }
.no-clubs { padding:4rpx 0; color:var(--text-secondary); font-size:12px; }
.no-club-title { color:var(--text); font-size:14px; font-weight:600; }
.discover-feature { display:flex; align-items:center; justify-content:space-between; gap:12rpx; min-height:108px; margin-bottom:36rpx; padding:24rpx 28rpx; overflow:hidden; box-sizing:border-box; border:1px solid #f4e4e5; border-radius:12px; background:linear-gradient(110deg,#fff5f5,#fffaf7); color:var(--text); }
.club-artwork { display:block; flex:none; width:80px; height:80px; }
.feature-copy { display:flex; flex:1; min-width:0; flex-direction:column; align-items:flex-start; gap:10rpx; }
.feature-title { color:var(--text); font-size:17px; font-weight:600; line-height:1.3; }
.feature-meta { color:var(--text-secondary); font-size:12px; line-height:1.4; }
.feature-action { margin-top:4rpx; color:var(--brand); font-size:12px; font-weight:600; }
.discover { margin-bottom:32rpx; }
.directory-heading { display:flex; align-items:flex-end; justify-content:space-between; margin:0 4rpx 22rpx; }
.directory-tools { padding:0 24rpx; border:1px solid var(--border); border-radius:12px; background:#fff; }
.modes { display:flex; gap:38rpx; border-bottom:1px solid var(--border); }
.clubs-page .mode { position:relative; min-height:44px; padding:0 4rpx; border-radius:0; color:var(--text-secondary); background:transparent; font-size:13px; }
.clubs-page .mode.on { color:var(--text); font-weight:600; }
.mode.on::after { position:absolute; right:0; bottom:-1px; left:0; height:2px; border-radius:2px; content:''; background:var(--brand); }
.search-row { display:flex; gap:14rpx; margin-top:22rpx; }
.search-field { display:flex; flex:1; align-items:center; gap:14rpx; min-width:0; min-height:44px; padding:0 16rpx; box-sizing:border-box; border:1px solid var(--border); border-radius:8px; background:var(--page-bg); }
.search-field input { flex:1; min-width:0; height:40px; padding:0; border:0; background:transparent; font-size:13px; }
.search-icon { position:relative; flex:none; width:22rpx; height:22rpx; margin-right:2rpx; border:3rpx solid #8b9099; border-radius:50%; }
.search-icon::after { position:absolute; right:-8rpx; bottom:-5rpx; width:10rpx; height:3rpx; border-radius:1px; background:#8b9099; content:''; transform:rotate(45deg); }
.clubs-page .search-action { flex:none; min-height:34px; padding:0 16rpx; border-radius:7px; color:#fff; background:var(--brand); font-size:12px; font-weight:600; }
.city-filter { display:flex; flex:none; align-items:center; gap:8rpx; width:144rpx; min-height:44px; padding:0 10rpx; box-sizing:border-box; border:1px solid var(--border); border-radius:8px; background:var(--page-bg); color:var(--text-secondary); font-size:12px; }
.city-filter > text { flex:none; white-space:nowrap; }
.city-filter input { flex:1; min-width:0; height:40px; padding:0; background:transparent; color:var(--text); font-size:12px; }
.code-field { margin-top:22rpx; }
.helper { margin:16rpx 0; color:var(--text-secondary); font-size:12px; line-height:1.6; }
.message { margin:16rpx 0; padding:14rpx 16rpx; border-radius:8px; color:var(--brand); background:var(--brand-soft); font-size:12px; line-height:1.5; }
.result-row { display:flex; align-items:center; gap:16rpx; min-height:124rpx; padding:14rpx 0; box-sizing:border-box; border-bottom:1px solid var(--border); }
.result-row:last-child { border-bottom:0; }
.result-avatar { display:flex; flex:none; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:9px; color:var(--brand); background:var(--page-bg); font-size:15px; font-weight:600; }
.result-row .club-name { font-size:14px; }
.result-row .meta { font-size:12px; }
.clubs-page .result-action,.result-action { display:flex; flex:none; align-items:center; justify-content:center; min-width:44px; min-height:44px; padding:0 16rpx; border-radius:7px; box-sizing:border-box; color:var(--brand); background:var(--brand-soft); font-size:12px; font-weight:600; }
.result-action.joined { background:var(--brand-soft); }
.pending-badge { display:flex; flex:none; align-items:center; justify-content:center; min-width:48px; min-height:32px; border-radius:7px; color:#a47733; background:#f5f2eb; font-size:12px; }
.clubs-page .verified-mark { justify-content:flex-start; min-height:28px; padding:0; background:transparent; color:var(--text-secondary); font-size:12px; }
.clubs-page .show-more { width:100%; min-height:44px; padding:0; border-top:1px solid var(--border); border-radius:0; color:var(--brand); background:transparent; font-size:12px; }
.create-card { overflow:hidden; border:1px solid var(--border); border-radius:10px; background:#fff; }
.clubs-page .create-entry { width:100%; gap:20rpx; min-height:64px; padding:20rpx 24rpx; border-radius:0; color:var(--text); background:#fff; text-align:left; }
.create-mark { display:flex; flex:none; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:9px; background:var(--brand-soft); color:var(--brand); font-size:20px; }
.create-copy { flex:1; min-width:0; }
.create-toggle { flex:none; color:var(--text-secondary); font-size:20px; font-weight:400; }
.create-form { padding:0 24rpx 24rpx; border-top:1px solid var(--border); }
.field-label { display:flex; align-items:center; flex-wrap:wrap; gap:12rpx; margin:24rpx 0 12rpx; color:var(--text); font-size:13px; font-weight:600; }
.field-label text { color:var(--text-secondary); font-size:12px; font-weight:400; }
.create-input,.create-intro { width:100%; min-height:44px; padding:18rpx 20rpx; box-sizing:border-box; border:1px solid var(--border); border-radius:8px; background:var(--page-bg); color:var(--text); font-size:14px; }
.create-intro { min-height:100px; line-height:1.5; }
.city-choices { display:flex; gap:14rpx; margin-top:12rpx; }
.clubs-page .city-choices button { min-width:60px; min-height:36px; padding:0 18rpx; border:1px solid var(--border); color:var(--text-secondary); background:#fff; font-size:12px; }
.name-notice,.legacy-application { margin-top:22rpx; padding:20rpx; border-radius:9px; background:var(--page-bg); }
.notice-title { color:var(--text); font-size:13px; font-weight:600; }
.duplicate-row { display:flex; align-items:center; gap:18rpx; padding:20rpx 0; border-bottom:1px solid var(--border); }
.duplicate-row .club-copy { min-width:0; }
.duplicate-row:last-child { border-bottom:0; }
.clubs-page .secondary-action { width:100%; margin-top:14rpx; border:1px solid var(--border); color:var(--text-secondary); background:#fff; font-size:13px; }
.clubs-page .submit { width:100%; margin-top:24rpx; padding:0 20rpx; color:#fff; background:var(--brand); font-size:14px; font-weight:600; }
.private-reports-link { display:flex; align-items:center; justify-content:center; min-height:44px; color:var(--text-secondary); font-size:12px; }
@media(max-width:350px) {
 .clubs-page { padding-right:20rpx; padding-left:20rpx; }
 .my-clubs { padding-right:22rpx; padding-left:22rpx; }
 .my-club-rail { width:calc(100% + 44rpx); margin-right:-22rpx; margin-left:-22rpx; padding-right:22rpx; padding-left:22rpx; }
 .my-club { flex-basis:535rpx; width:535rpx; }
 .discover-feature { min-height:104px; padding:24rpx; }
 .club-artwork { width:72px; height:72px; }
 .directory-tools { padding-right:20rpx; padding-left:20rpx; }
 .search-row { gap:12rpx; }
 .search-field { gap:12rpx; padding-right:12rpx; padding-left:14rpx; }
 .search-field input { font-size:12px; }
 .city-filter { width:168rpx; gap:8rpx; padding:0 12rpx; }
 .result-row { gap:14rpx; }
}
