page { --page-bg:#f5f5f5; --surface:#fff; --text:#1a1a1a; --text-secondary:#777777; --border:#eeeeee; --brand:#ff1838; --brand-soft:#fff0f2; background:#f5f5f5; }
.clubs-page{position:relative;padding:12px 16px 24px;box-sizing:border-box;color:var(--text);background:var(--page-bg);font-size:14px;line-height:1.5}
.clubs-page button { display:flex; align-items:center; justify-content:center; width:auto; min-width:0; min-height:44px; margin:0; box-sizing:border-box; border:0; border-radius:8px; font-size:13px; font-weight:500; line-height:1.4; }
.clubs-page button::after { border:0; }
.my-clubs{margin-bottom:24px;padding:16px 16px 4px;border:1px solid var(--border);border-radius:12px;background:#fff;box-shadow:none}
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:25px; margin:0 1px 12px; }
.section-title { color:var(--text); font-size:18px; font-weight:600; line-height:1.4; }
.section-count{color:var(--text-secondary);font-size:12px;line-height:1.4}
.login-card { display:flex; align-items:center; gap:10px; padding:6px 0 14px; }
.club-letter,.result-avatar{display:flex;flex:none;align-items:center;justify-content:center;width:40px;height:40px;overflow:hidden;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);color:var(--text);font-size:18px;font-weight:500}
.login-copy,.club-copy { flex:1; min-width:0; }
.club-name{overflow:hidden;color:var(--text);font-size:15px;font-weight:500;line-height:1.5;white-space:nowrap;text-overflow:ellipsis}
.meta { margin-top:4px; overflow:hidden; color:var(--text-secondary); font-size:12px; line-height:1.5; white-space:nowrap; text-overflow:ellipsis; }
.small-action { display:flex; flex:none; align-items:center; justify-content:center; min-width:52px; min-height:44px; padding:0 11px; border:1px solid #ffdce2; border-radius:9px; background:var(--brand-soft); color:var(--brand); font-size:13px; font-weight:600; }
.mine-search { display:flex; align-items:center; gap:10px; min-height:44px; margin:0 0 5px; padding:0 12px; border:1px solid transparent; border-radius:10px; background:var(--page-bg); }
.mine-search input { flex:1; min-width:0; min-height:44px; height:44px; padding:0; border:0; border-radius:0; background:transparent; color:var(--text); font-size:13px; }
.mine-search-status { margin:10px 0 2px; color:var(--text-secondary); font-size:12px; }
.my-club-list { width:100%; }
.my-club { position:relative; display:flex; align-items:center; gap:10px; width:100%; min-height:76px; padding:8px 0; box-sizing:border-box; }
.my-club + .my-club::before { position:absolute; top:0; right:0; left:50px; height:1px; background:var(--border); content:''; }
.club-main { display:flex; flex:1; align-items:center; gap:10px; min-width:0; min-height:60px; }
.my-club .club-copy { margin:0; }
.my-club-meta { display:flex; align-items:center; gap:4px; min-height:19px; }
.my-club-meta > text { flex:none; }
.my-club-meta .my-club-city { flex:0 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; }
.my-role{padding:0 4px;border:1px solid var(--border);border-radius:3px;background:#fff;color:var(--text-secondary);font-size:12px;line-height:18px}
.my-role.leader{border-color:#ffdce2;background:var(--brand-soft);color:var(--brand)}
.club-quick-actions { display:flex; flex:none; align-items:center; gap:4px; }
.club-quick-actions navigator { display:flex; flex:none; align-items:center; justify-content:center; width:44px; min-height:44px; color:#555555; font-size:12px; }
.club-quick-actions navigator > text { display:flex; align-items:center; justify-content:center; width:42px; min-height:30px; border:1px solid #eeeeee; border-radius:8px; background:#fff; }
.club-quick-actions navigator:active > text { border-color:#ffb6c0; background:#f5f5f5; }
.club-main:active { opacity:.72; }
.clubs-page .mine-expand { width:100%; gap:7px; padding:0; border-top:1px solid var(--border); border-radius:0; background:transparent; color:#ff1838; font-size:12px; }
.mine-expand text { color:#999999; font-size:16px; }
.no-clubs { padding:12px 0 18px; color:var(--text-secondary); font-size:12px; line-height:1.6; }
.no-club-title { color:var(--text); font-size:14px; font-weight:600; }
.discover { margin-bottom:16px; }
.directory-heading { display:flex; align-items:center; justify-content:space-between; margin:0 1px 12px; }
.directory-heading .section-count{color:var(--text-secondary);font-size:12px;line-height:1.4}
.directory-tools{padding:0 16px 4px;border:1px solid var(--border);border-radius:12px;background:#fff;box-shadow:none}
.modes{display:flex;gap:0;margin:0 0 14px;padding:0;border-bottom:1px solid var(--border);border-radius:0;background:#fff}
.clubs-page .mode{position:relative;flex:1;width:0;min-width:0;min-height:48px;padding:0 8px;border:0;border-radius:0;background:transparent;color:var(--text-secondary);font-size:14px}
.clubs-page .mode.on{border:0;background:#fff;color:var(--brand);font-weight:500;box-shadow:none}
.mode.on::before{position:absolute;bottom:0;left:calc(50% - 10px);width:20px;height:2px;border-radius:0;background:var(--brand);content:""}
.search-row { display:flex; margin-top:12px; }
.search-field { display:flex; flex:1; align-items:center; gap:9px; min-width:0; min-height:46px; padding:0 7px 0 12px; box-sizing:border-box; border:1px solid #eeeeee; border-radius:10px; background:#fff; }
.search-field input { flex:1; min-width:0; min-height:44px; height:44px; padding:0; border:0; border-radius:0; background:transparent; color:var(--text); font-size:13px; }
.search-icon { position:relative; flex:none; width:12px; height:12px; margin-right:2px; border:1.5px solid #999999; border-radius:50%; }
.search-icon::after { position:absolute; right:-4px; bottom:-2px; width:5px; height:1.5px; border-radius:1px; background:#999999; content:''; transform:rotate(45deg); }
.clubs-page .search-action { flex:0 0 56px; width:56px; height:44px; min-width:0; min-height:44px; padding:0; border-radius:8px; color:#fff; background:transparent; font-size:12px; font-weight:600; line-height:1.4; }
.search-action > text { display:flex; align-items:center; justify-content:center; width:56px; height:32px; border-radius:8px; background:var(--brand); }
.search-action:active > text { background:#e91432; }
.city-filter { display:flex; align-items:center; gap:8px; width:100%; min-height:44px; margin:4px 0 2px; padding:0; box-sizing:border-box; border-bottom:1px solid var(--border); color:var(--text-secondary); font-size:12px; }
.city-filter > text { flex:none; white-space:nowrap; }
.city-pin { position:relative; flex:none; width:10px; height:12px; border:1.3px solid #999999; border-radius:7px 7px 7px 0; transform:rotate(-45deg); }
.city-pin::after { position:absolute; top:3px; left:3px; width:2px; height:2px; border-radius:50%; background:#999999; content:''; }
.city-filter input { flex:1; min-width:0; min-height:42px; height:42px; padding:0 0 0 2px; border:0; border-radius:0; background:transparent; color:var(--text); font-size:12px; }
.clubs-page .city-reset,.clubs-page .city-apply { flex:none; width:auto; min-width:36px; min-height:44px; padding:0; border-radius:0; background:transparent; color:var(--text-secondary); font-size:12px; }
.clubs-page .city-apply { color:#ff1838; }
.code-field { margin-top:12px; }
.helper { margin:10px 0; color:var(--text-secondary); font-size:12px; line-height:1.6; }
.message { margin:12px 0; padding:10px; border-radius:9px; color:#ad2a44; background:var(--brand-soft); font-size:12px; line-height:1.6; }
.result-row { position:relative; display:flex; align-items:center; gap:10px; min-height:78px; padding:10px 0; box-sizing:border-box; }
.result-row + .result-row::before { position:absolute; top:0; right:0; left:48px; height:1px; background:var(--border); content:''; }
.result-avatar { width:38px; height:38px; border-radius:11px; font-size:16px; }
.result-row .club-name{overflow:hidden;color:var(--text);font-size:15px;font-weight:500;line-height:1.5;white-space:nowrap;text-overflow:ellipsis}
.result-row .meta { font-size:12px; }
.clubs-page .result-action { display:flex; flex:none; align-items:center; justify-content:flex-end; gap:4px; min-width:48px; min-height:44px; padding:0; border-radius:0; box-sizing:border-box; color:var(--text-secondary); background:transparent; font-size:12px; font-weight:500; }
.clubs-page .result-action.joined { color:#ff1838; }
.action-arrow { color:#999999; font-size:18px; font-weight:400; line-height:1; }
.joined .action-arrow { color:#ff1838; }
.result-action:active { opacity:.6; }
.pending-badge { display:flex; flex:none; align-items:center; justify-content:center; min-width:48px; min-height:28px; padding:4px 6px; border-radius:6px; color:#777777; background:#f5f5f5; font-size:12px; }
.clubs-page .verified-mark { justify-content:flex-start; min-height:44px; padding:0; background:transparent; color:#ff1838; font-size:12px; }
.clubs-page .show-more { width:100%; min-height:44px; padding:0; border-top:1px solid var(--border); border-radius:0; color:#ff1838; background:transparent; font-size:12px; }
.create-card{overflow:hidden;border:1px solid var(--border);border-radius:12px;background:#fff;box-shadow:none}
.clubs-page .create-entry{display:flex;align-items:center;width:100%;text-align:left;gap:12px;min-height:76px;padding:16px;background:#fff}
.create-mark { display:flex; flex:none; align-items:center; justify-content:center; width:36px; height:36px; border:0; border-radius:8px; background:var(--brand-soft); color:var(--brand); font-size:24px; font-weight:400; }
.create-copy { flex:1; min-width:0; }
.create-copy .meta { white-space:normal; }
.create-toggle { display:flex; align-items:center; justify-content:center; width:26px; height:26px; flex:none; border-radius:50%; background:#fff; color:var(--text-secondary); font-size:20px; font-weight:400; }
.create-form { padding:0 14px 16px; border-top:1px solid var(--border); }
.field-label { display:flex; align-items:center; flex-wrap:wrap; gap:6px; margin:16px 0 8px; color:var(--text); font-size:13px; font-weight:600; }
.field-label text { color:var(--text-secondary); font-size:12px; font-weight:400; }
.create-input,.create-intro { width:100%; min-height:44px; padding:10px 12px; box-sizing:border-box; border:1px solid var(--border); border-radius:10px; background:var(--page-bg); color:var(--text); font-size:14px; }
.create-intro { min-height:100px; line-height:1.6; }
.city-choices { display:flex; gap:8px; margin-top:8px; }
.clubs-page .city-choices button { flex:none; width:auto; min-width:60px; min-height:44px; padding:0 12px; border:1px solid var(--border); color:#555555; background:#fff; font-size:12px; }
.name-notice,.legacy-application { margin-top:14px; padding:12px; border-radius:10px; background:var(--page-bg); }
.notice-title { color:var(--text); font-size:13px; font-weight:600; }
.duplicate-row { display:flex; align-items:center; gap:10px; padding:12px 0; border-bottom:1px solid var(--border); }
.duplicate-row .club-copy { min-width:0; }
.duplicate-row:last-child { border-bottom:0; }
.clubs-page .secondary-action { width:100%; margin-top:8px; border:1px solid var(--border); color:#555555; background:#fff; font-size:13px; }
.clubs-page .submit { width:100%; margin-top:16px; padding:0 12px; color:#fff; background:var(--brand); font-size:14px; font-weight:600; }
.private-reports-link { display:flex; align-items:center; justify-content:center; min-height:44px; margin-top:8px; color:#999999; font-size:12px; }
@media(max-width:350px) {
 .my-clubs{margin-bottom:24px;padding:16px 16px 4px;border:1px solid var(--border);border-radius:12px;background:#fff;box-shadow:none}
 .my-club { gap:6px; }
 .club-main { gap:8px; }
 .club-main > .club-letter { width:36px; height:36px; border-radius:10px; font-size:16px; }
 .club-quick-actions { gap:2px; }
 .club-quick-actions navigator { width:44px; }
 .club-quick-actions navigator > text { width:40px; }
 .my-club + .my-club::before { left:44px; }
 .directory-tools{padding:0 16px 4px;border:1px solid var(--border);border-radius:12px;background:#fff;box-shadow:none}
 .search-field { gap:7px; padding-left:10px; }
 .search-field input { font-size:12px; }
 .city-filter { gap:6px; }
 .city-filter input { font-size:12px; }
 .result-row { gap:8px; }
 .result-avatar { width:36px; height:36px; }
}
