<view class="feedback-page mini-feedback-feedback">
  <block wx:if="{{composeOpen}}">
    <view class="compose-heading"><view><view class="page-title">提交建议</view></view><button class="quiet-button" disabled="{{busy}}" bindtap="closeCompose">收起</button></view>
    <view class="compose-card"><view class="form-task-heading"><view class="section-title">问题与改进建议</view><text>具体场景更有帮助</text></view>
      <view class="field-label">这是关于什么的想法？</view><view class="form-categories"><button wx:for="{{formCategories}}" wx:key="key" class="category-pill {{draft.category === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="pickFormCategory">{{item.label}}</button></view>
      <view class="field-label">一句话概括<text class="field-count">{{draft.title.length}} / 80</text></view><input class="title-input" placeholder="例如：跑团首页优先显示下次团练" value="{{draft.title}}" maxlength="80" data-field="title" bindinput="inputDraft" disabled="{{busy}}" aria-label="例如：跑团首页优先显示下次团练"/>
      <view class="field-label">展开说说你的想法<text class="field-count">{{draft.body.length}} / 3000</text></view><textarea class="body-input" value="{{draft.body}}" placeholder="你在什么场景遇到问题？希望如何改进？一个具体的例子会很有帮助。" maxlength="3000" data-field="body" bindinput="inputDraft" disabled="{{busy}}" auto-height cursor-spacing="120" aria-label="你在什么场景遇到问题？希望如何改进？一个具体的例子会很有帮助。"/>
      <view class="form-task-heading feedback-context-heading"><view class="section-title">补充信息</view><text>选填</text></view><view class="field-label">相关页面<text class="optional">选填</text></view><picker mode="selector" range="{{modules}}" range-key="label" value="{{moduleIndex}}" bindchange="pickModule" disabled="{{busy}}"><view class="module-picker">{{modules[moduleIndex].label}}<text>⌄</text></view></picker>
      <view class="field-label">补充截图<text class="optional">选填 · 最多 3 张</text></view><view class="image-grid"><view wx:for="{{draftImages}}" wx:key="path" class="image-tile"><image src="{{item.path}}" mode="aspectFill" data-url="{{item.path}}" bindtap="previewImage"/><button class="image-remove" data-index="{{index}}" catchtap="removeDraftImage" disabled="{{busy}}" aria-label="移除截图">×</button></view><button wx:if="{{draftImages.length < 3}}" class="image-add" disabled="{{busy}}" bindtap="chooseImages"><text>＋</text><text>添加截图</text></button></view>
      <view class="caption">每张不超过 5 MB。请勿上传身份证、电话、住址等个人资料。文字会按当前账号自动保存为草稿。</view>
    </view>
    <view class="submit-note"><text class="note-dot"></text><view>审核通过后公开展示，其他跑者可以投票支持。采纳结果与进度会更新在「我的建议」。</view></view>
    <view wx:if="{{actionError}}" class="error-box" role="alert">{{actionError}}</view><button class="primary-button submit-button" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{busy ? '正在提交…' : '提交建议'}}</button>
  </block>
  <block wx:elif="{{id}}">
    <view class="detail-top"><view bindtap="backToBoard" class="back-link">‹ 建议板</view><button wx:if="{{detail.publicShare}}" open-type="share" class="quiet-button">分享想法 ↗</button></view>
    <view wx:if="{{loading && !detail}}" class="state-card"><view class="loading-dot"></view><view>正在打开这条建议…</view></view>
    <view wx:if="{{error}}" class="error-box" role="alert"><view>{{error}}</view><button class="quiet-button" bindtap="load">重新加载</button></view>
    <block wx:if="{{detail}}">
      <view wx:if="{{notice}}" class="notice-box">{{notice}}</view>
      <view class="detail-card"><view class="card-meta"><text class="type-label">{{detail.categoryLabel}} · {{detail.moduleLabel}}</text><text class="status-tag status-{{detail.status}}">{{detail.statusLabel}}</text></view><view class="detail-title">{{detail.title}}</view><view class="byline"><text>{{detail.author.nickname}}</text><text>{{detail.dateLabel}} 提交</text></view><view class="detail-body">{{detail.body}}</view><view wx:if="{{detail.images.length}}" class="image-grid detail-images"><view wx:for="{{detail.images}}" wx:key="id" class="image-tile"><image src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"/><button wx:if="{{detail.isMine && detail.status === 'pending'}}" class="image-remove" data-id="{{item.id}}" catchtap="removeImage" disabled="{{busy}}" aria-label="移除截图">×</button></view></view><button wx:if="{{detail.isMine && detail.status === 'pending' && detail.images.length < 3}}" class="add-detail-images" disabled="{{busy}}" bindtap="chooseImages">＋ 补充截图</button><view class="detail-foot"><text>{{detail.votes}} 位跑者支持</text><text wx:if="{{detail.isMine}}">我的建议</text><text wx:elif="{{detail.voted}}">你已支持这条想法</text></view></view>
      <view wx:if="{{detail.status === 'pending'}}" class="pending-hint"><text class="note-dot"></text><view>正在等待审核，当前仅你和平台管理员可见。</view></view>
      <view wx:if="{{detail.reply || detail.events.length}}" class="progress-card"><view class="section-heading"><view class="section-title">每个好想法，都有回响</view><text>官方进度</text></view><view wx:if="{{detail.reply}}" class="official-reply"><view class="official-label"><text class="official-dot"></text>赛历团队</view><view class="reply-body">{{detail.reply}}</view></view><view class="timeline"><view wx:for="{{detail.events}}" wx:key="key" class="timeline-item"><view class="timeline-dot"></view><view class="timeline-heading"><text>{{item.statusLabel}}</text><text>{{item.dateLabel}}</text></view><view wx:if="{{item.reply}}" class="timeline-reply">{{item.reply}}</view></view></view></view>
      <view wx:if="{{detail.reward}}" class="reward-card"><view class="reward-heading"><view class="gift-mark"><view></view><text></text></view><view><view class="eyebrow">好想法的回礼</view><view class="reward-name">{{detail.reward.name}}</view></view><text class="reward-state">{{detail.reward.statusLabel}}</text></view><view class="caption">感谢为赛历贡献灵感。奖品由平台运营确认并安排寄送。</view>
        <block wx:if="{{detail.isMine}}">
          <view wx:if="{{detail.reward.status === 'claimed' && !claimOpen}}" class="private-address"><text>收件信息 · 仅本人和平台管理员可见</text><view>{{detail.reward.receiver}} · {{detail.reward.phone}}</view><view>{{detail.reward.address}}</view></view>
          <view wx:if="{{detail.reward.status === 'shipped' || detail.reward.status === 'received'}}" class="shipment"><view>{{detail.reward.carrier}}<text class="tracking" bindtap="copyTracking">{{detail.reward.tracking}} 复制</text></view><view class="caption">{{detail.reward.status === 'received' ? '奖励已签收，期待你的下一个好想法。' : '奖励已寄出，收到实物后再确认收货。'}}</view></view>
          <button wx:if="{{!claimOpen && (detail.reward.status === 'unclaimed' || detail.reward.status === 'claimed')}}" class="primary-button reward-action" disabled="{{busy}}" bindtap="openClaim">{{detail.reward.status === 'unclaimed' ? '填写收件信息，领取奖励' : '修改收件信息'}}</button><button wx:if="{{detail.reward.status === 'shipped'}}" class="primary-button reward-action" disabled="{{busy}}" loading="{{busy}}" bindtap="receiveReward">已收到奖励，确认收货</button>
          <view wx:if="{{claimOpen}}" class="claim-form"><view class="field-label">收件人</view><input class="claim-input" value="{{claim.receiver}}" maxlength="40" data-field="receiver" bindinput="inputClaim" placeholder="收件人姓名" disabled="{{busy}}" aria-label="收件人姓名"/><view class="field-label">手机号码</view><input class="claim-input" value="{{claim.phone}}" type="number" maxlength="11" data-field="phone" bindinput="inputClaim" placeholder="中国大陆手机号码" disabled="{{busy}}" aria-label="中国大陆手机号码"/><view class="field-label">详细地址</view><textarea class="address-input" value="{{claim.address}}" maxlength="300" data-field="address" bindinput="inputClaim" placeholder="省、市、区及街道门牌号" auto-height disabled="{{busy}}" cursor-spacing="100" aria-label="省、市、区及街道门牌号"/><view class="consent" bindtap="toggleConsent" role="checkbox" aria-checked="{{consent}}"><view class="checkbox {{consent ? 'checked' : ''}}">{{consent ? '✓' : ''}}</view><text>同意仅为寄送奖励使用以上收件信息，仅本人和平台管理员可见。</text></view><view class="claim-buttons"><button class="quiet-button" disabled="{{busy}}" bindtap="closeClaim">取消</button><button class="primary-button" loading="{{busy}}" disabled="{{busy}}" bindtap="submitClaim">确认收件信息</button></view><view class="privacy-link" bindtap="openPrivacy">查看隐私保护指引 ›</view></view>
        </block>
      </view>
      <view wx:if="{{actionError}}" class="error-box" role="alert">{{actionError}}</view><view class="vote-explainer">投票帮助团队了解需求，采纳会综合考虑实际价值与开发计划。</view>
      <view class="detail-actions"><button wx:if="{{detail.canWithdraw}}" class="quiet-button withdraw" disabled="{{busy}}" bindtap="withdraw">撤回建议</button><view wx:else class="action-subtitle">{{detail.isMine ? '谢谢你，让赛历更好' : '让真正有用的想法被看见'}}</view><button wx:if="{{detail.status === 'published' && !detail.isMine}}" class="vote-button {{detail.voted ? 'voted' : ''}}" loading="{{busy}}" disabled="{{busy}}" bindtap="toggleVote">{{detail.voted ? '已支持 · 可取消' : (ready ? '支持这个想法' : '登录后支持')}}<text>{{detail.votes}}</text></button><view wx:else class="vote-total"><text>{{detail.votes}}</text> 位支持</view></view>
    </block>
  </block>
  <block wx:else>
    <view class="board-hero"><view class="hero-title">一起改进赛历</view><view class="hero-caption">反馈使用问题，提出功能和界面建议。</view><view class="hero-footer"><text wx:if="{{summary.adopted}}">已有 {{summary.adopted}} 个想法被采纳</text><text wx:else>审核、投票和处理进度公开</text><view bindtap="toggleRules">共创规则 {{rulesOpen ? '⌄' : '›'}}</view></view></view>
    <view wx:if="{{rulesOpen}}" class="rules-card"><view class="section-title">建议处理规则</view><view>1. 登录后提交功能、界面或问题反馈，审核通过后公开展示。</view><view>2. 每个账号每条建议一票，可取消支持，不能给自己投票。</view><view>3. 团队评估后公示采纳和开发进度。采纳时会明确实物奖励，票数不等同于获奖。</view><view>4. 收件信息仅用于奖励寄送；进度请在「我的建议」查看。</view></view>
    <view class="scope-tabs"><view class="{{!mine ? 'on' : ''}}" data-scope="public" bindtap="pickScope">大家的建议</view><view class="{{mine ? 'on' : ''}}" data-scope="mine" bindtap="pickScope">我的建议<text wx:if="{{unread}}" class="unread">{{unread > 99 ? '99+' : unread}}</text></view></view>
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="category-row"><button wx:for="{{categories}}" wx:key="key" class="category-pill {{category === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="pickCategory">{{item.label}}</button></view></scroll-view>
    <view class="list-heading"><text>{{mine ? '我的建议' : '公开建议'}}</text><view class="sort-row"><view wx:for="{{sorts}}" wx:key="key" class="{{sort === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="pickSort">{{item.label}}</view></view></view>
    <view wx:if="{{error}}" class="error-box" role="alert"><view>{{error}}</view><button class="quiet-button" bindtap="load">重新加载</button></view><view wx:if="{{loading && !items.length}}" class="state-card"><view class="loading-dot"></view><view>正在收集跑者的好想法…</view></view>
    <view wx:for="{{items}}" wx:key="id" class="idea-card" data-id="{{item.id}}" bindtap="openDetail" role="button" aria-label="查看建议：{{item.title}}"><view class="idea-main"><view class="card-meta"><text class="type-label">{{item.categoryLabel}}</text><text wx:if="{{item.unread}}" class="update-dot">有新进度</text><text class="status-tag status-{{item.status}}">{{item.statusLabel}}</text></view><view class="idea-title">{{item.title}}</view><view class="byline"><text>{{item.author.nickname}}</text><text>{{item.dateLabel}}</text></view><view wx:if="{{item.reply}}" class="list-reply">官方回复 · {{item.reply}}</view><view wx:if="{{item.reward}}" class="list-reward">已采纳 · 回礼 {{item.reward.name}}</view></view><view class="support-count {{item.voted ? 'supported' : ''}}"><text class="support-arrow">⌃</text><text>{{item.votes}}</text><text class="support-label">{{item.voted ? '已支持' : '支持'}}</text></view></view>
    <view wx:if="{{!loading && !error && !items.length}}" class="state-card empty-state"><view class="empty-symbol"><text>＋</text></view><view class="empty-title">{{mine ? '你的第一个好想法，留在这里' : '一起写下赛历的下一步'}}</view><view class="caption">{{mine ? '功能不好找，或者界面可以更顺手？欢迎告诉我们。' : '还没有符合条件的建议，试试其他分类，或分享你的灵感。'}}</view><button class="empty-action" disabled="{{busy}}" bindtap="openCompose">提个建议 ›</button></view>
    <view wx:if="{{pages > 1}}" class="pagination"><button class="quiet-button" disabled="{{page <= 1 || loading}}" data-direction="-1" bindtap="movePage">上一页</button><text>{{page}} / {{pages}}</text><button class="quiet-button" disabled="{{page >= pages || loading}}" data-direction="1" bindtap="movePage">下一页</button></view>
    <view class="board-bottom"><view><text>在「我的建议」跟进回复</text><text>被采纳后，可获得实物回礼</text></view><button class="primary-button" loading="{{busy}}" disabled="{{busy}}" bindtap="openCompose">＋ 提个建议</button></view>
  </block>
</view>
