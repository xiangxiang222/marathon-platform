<view class="pad">
  <view class="card">
    <block wx:if="{{nickname}}">
      <view class="title">{{nickname}}</view>
      <view wx:if="{{leader}}" class="teal">建团资格</view>
      <navigator wx:for="{{clubs}}" wx:key="id" url="/pages/club/club?id={{item.id}}">{{item.name}} · {{item.roleLabel}}</navigator>
      <view class="account-line" bindtap="togglePassword">
        <text>{{hasPassword ? '修改密码' : '设置登录密码'}}</text>
        <view class="chev {{passwordOpen ? 'open' : ''}}"></view>
      </view>
      <view wx:if="{{passwordOpen}}" class="stack">
        <view class="muted">{{hasPassword ? '请填写当前密码和新密码。' : '设置后，可使用此昵称与密码在其他设备登录。'}}</view>
        <input wx:if="{{hasPassword}}" placeholder="当前密码" password value="{{currentPassword}}" bindinput="onCurrent" />
        <input placeholder="新密码" password value="{{nextPassword}}" bindinput="onNext" />
        <view class="req">8 到 128 位</view>
        <input placeholder="再输入一次" password value="{{nextPassword2}}" bindinput="onNext2" />
        <button class="btn block" bindtap="savePassword">保存</button>
        <view class="cancel" bindtap="cancelPassword">取消</view>
        <view wx:if="{{message}}" class="{{ok ? 'ok' : 'err'}}">{{message}}</view>
      </view>
      <view wx:elif="{{message}}" class="{{ok ? 'ok' : 'err'}}">{{message}}</view>
      <view class="quit" bindtap="logout">退出</view>
    </block>
    <block wx:else>
      <view class="modes">
        <view class="mode {{tab === 'login' ? 'on' : ''}}" data-tab="login" bindtap="setTab">登录</view>
        <view class="mode {{tab === 'register' ? 'on' : ''}}" data-tab="register" bindtap="setTab">注册</view>
      </view>
      <view class="muted">{{tab === 'login' ? '用昵称和密码。换手机也能回到同一个人。' : '第一次使用就注册。这个昵称以前只出现过一次、还没设密码的话，会设在原来那个人身上。'}}</view>
      <view class="stack">
        <input placeholder="昵称" value="{{draft}}" bindinput="onDraft" />
        <input placeholder="密码，至少 8 位" password value="{{password}}" bindinput="onPassword" />
        <input wx:if="{{tab === 'register'}}" placeholder="再输入一次密码" password value="{{password2}}" bindinput="onPassword2" />
        <block wx:if="{{tab === 'login'}}">
          <view class="captcha" bindtap="loadCaptcha">
            <image wx:if="{{captchaImage}}" class="captcha-img" src="{{captchaImage}}" mode="aspectFit" />
            <view wx:else class="muted">{{captchaLoading ? '加载中…' : '点击获取验证码'}}</view>
          </view>
          <input placeholder="上图字符" value="{{captcha}}" bindinput="onCaptcha" maxlength="4" />
        </block>
        <button class="btn block" bindtap="submitAuth">{{tab === 'login' ? '登录' : '注册'}}</button>
      </view>
    </block>
    <view wx:if="{{message && !nickname}}" class="{{ok ? 'ok' : 'err'}}">{{message}}</view>
  </view>
  <view class="card" wx:if="{{conflicts.length}}">
    <view class="h2">全马间隔</view>
    <view wx:for="{{conflicts}}" wx:key="text" class="warn">{{item.text}}</view>
  </view>
  <view class="card" wx:if="{{reminders.length}}">
    <view class="h2">截止提醒</view>
    <navigator wx:for="{{reminders}}" wx:key="key" class="plan" url="/pages/race/race?id={{item.race.id}}">
      <text class="warn">{{item.hit.reason}}</text>
      <text> {{item.race.name}}</text>
    </navigator>
  </view>
  <view class="card" wx:if="{{nickname}}">
    <view class="h2">赛事生涯</view>
    <view class="sum">完赛 {{career.finished}} 场 · 足迹 {{career.provinces.length}} 省 {{career.cities.length}} 市</view>
    <view class="sum">半程 {{career.pb.half || '--'}} · 全程 {{career.pb.full || '--'}}</view>
    <view class="sum">本年比赛 {{career.yearKm}} 公里</view>
    <navigator wx:for="{{results}}" wx:key="raceId" class="plan" url="/pages/race/race?id={{item.race.id}}">
      <image wx:if="{{item.proofSrc}}" src="{{item.proofSrc}}" mode="aspectFill" />
      <text class="teal">{{item.clock}}</text>
      <text wx:if="{{item.pb}}"> PB</text>
      <text> {{item.race.name}} · 未核验</text>
    </navigator>
    <view wx:if="{{loaded && !results.length}}" class="muted">在赛事页记下成绩后，会出现在这里</view>
    <navigator url="/pages/radar/radar">拿奖雷达</navigator>
  </view>
  <view class="card" wx:if="{{nickname}}">
    <view class="h2">我标过的场</view>
    <navigator wx:for="{{plans}}" wx:key="raceId" class="plan" url="/pages/race/race?id={{item.race.id}}">
      <text class="teal">{{item.status}}</text>
      <text> {{item.race.name}}</text>
    </navigator>
    <view wx:if="{{loaded && !plans.length}}" class="muted">还没有标记</view>
  </view>
  <view class="legal">{{company}} · {{icp}}</view>
</view>
