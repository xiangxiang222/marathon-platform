<page-header title="{{mainTab === 'settings' ? '设置' : '我的'}}" subtitle="{{mainTab === 'settings' ? '管理账号与使用偏好' : '每一程，都有记录'}}"><button wx:if="{{mainTab !== 'settings'}}" class="header-settings" bindtap="openSettings" aria-label="设置"><text class="settings-gear" aria-hidden="true">⚙</text><text>设置</text></button><button wx:else class="header-settings" bindtap="closeSettings" aria-label="返回我的">‹ 返回</button></page-header>
<view class="mine-page mini-mine-mine">
  <view wx:if="{{mainTab === 'settings'}}" class="surface account-settings">
    <view class="settings-title">账号与隐私</view>
    <view wx:if="{{nickname}}" class="setting-row" data-tab="profile" bindtap="pickMainTab" role="button"><view><view>个人资料与账号</view><view class="subtitle">头像、昵称与登录方式</view></view><text class="arrow">›</text></view>
    <view class="setting-row" data-doc="privacy" bindtap="openLegal" role="button"><text>隐私政策</text><text class="arrow">›</text></view>
    <view class="setting-row" data-doc="rights" bindtap="openLegal" role="button"><text>个人信息权利</text><text class="arrow">›</text></view>
    <button wx:if="{{nickname}}" class="logout" bindtap="logout">退出登录</button>
    <button wx:else class="primary settings-login" bindtap="settingsLogin">登录 / 注册</button>
  </view>
  <block wx:else>
  <view wx:if="{{nickname}}" class="surface account-hero">
    <view class="identity-panel"><view class="identity-copy"><text class="identity-kicker">个人档案</text><view class="hero-line"><image wx:if="{{avatar}}" class="hero-avatar" src="{{avatar}}" mode="aspectFill"/><view wx:else class="hero-avatar avatar-empty">{{nickname[0]}}</view><view class="hero-copy"><view class="nickname">{{nickname}}</view><view class="subtitle">{{clubs.length ? clubs[0].name : '和志同道合的人一起跑'}}<text wx:if="{{clubs.length > 1}}"> 等 {{clubs.length}} 个跑团</text></view><text wx:if="{{leader}}" class="role-tag">建团资格</text></view></view></view></view>
    <view class="account-stats"><view data-tab="plans" bindtap="pickMainTab"><text class="stat-value">{{plans.length}}</text><text class="stat-label">已标记赛事</text></view><view data-tab="results" bindtap="pickMainTab"><text class="stat-value">{{career.finished}}</text><text class="stat-label">已完赛</text></view><navigator open-type="switchTab" url="/pages/clubs/clubs"><text class="stat-value">{{clubs.length}}</text><text class="stat-label">已加入跑团</text></navigator></view>
  </view>
  <view wx:else class="surface guest-hero">
    <view class="identity-panel guest-identity"><view class="identity-copy"><text class="identity-kicker">个人中心</text><view class="guest-title">我的运动与赛事</view><view class="guest-subtitle">管理运动记录、参赛计划与跑团。</view></view></view>
    <view class="guest-actions">
    <view class="auth-legal"><checkbox-group bindchange="onLegalConsent"><label><checkbox value="accepted" checked="{{legalAccepted}}" color="#ff1838"/><text>我已阅读并同意用户协议，并已阅读隐私政策</text></label></checkbox-group><view class="auth-legal-links"><text data-doc="terms" bindtap="openLegal">《用户协议》</text><text data-doc="privacy" bindtap="openLegal">《隐私政策》</text></view><view class="auth-legal-note">账号服务暂面向已满14周岁的用户。运动资料、文件与领奖地址等可选信息，将在使用对应功能时另行说明。</view></view>
    <button wx:if="{{!wechatRegistrationRequired}}" class="primary" loading="{{wxLoading}}" disabled="{{wxLoading}}" bindtap="wechatLogin">{{wxLoading ? '正在登录' : '微信登录'}}</button>
    <view class="hint account-guidance">已有账号请先用昵称和密码登录，再绑定微信，以保留原有赛事与跑团记录。</view>
    <view wx:if="{{wechatRegistrationRequired}}" class="wechat-choice">
      <view class="section-title">这个微信尚未绑定账号</view><view class="hint">请选择已有账号，或创建一个数据独立的新账号。</view>
      <button class="primary" disabled="{{wxLoading}}" bindtap="useExistingAccount">登录旧账号并绑定微信</button>
      <button class="secondary" loading="{{wxLoading}}" disabled="{{wxLoading}}" bindtap="createWechatAccount">确认创建独立新账号</button>
    </view>
    <view class="auth-toggle" bindtap="toggleAuth">{{authOpen ? '收起账号登录' : '账号密码登录 / 注册'}}</view><view wx:if="{{message && !authOpen}}" class="message">{{message}}</view></view>
  </view>
  <view wx:if="{{!nickname && authOpen}}" class="surface auth-panel"><view class="auth-tabs"><view class="{{tab === 'login' ? 'on' : ''}}" data-tab="login" bindtap="setTab">账号登录</view><view class="{{tab === 'register' ? 'on' : ''}}" data-tab="register" bindtap="setTab">注册账号</view></view><view class="hint">{{tab === 'login' ? (bindAfterLogin ? '登录成功后将绑定当前微信，并保留原账号记录。' : '使用已注册的昵称和密码登录。') : '首次使用请设置昵称和密码。旧账号请使用原密码登录。'}}</view><view class="stack"><input placeholder="昵称" value="{{draft}}" bindinput="onDraft" aria-label="昵称"/><input placeholder="密码，至少 8 位" password value="{{password}}" bindinput="onPassword" aria-label="密码，至少 8 位"/><input wx:if="{{tab === 'register'}}" placeholder="再输入一次密码" password value="{{password2}}" bindinput="onPassword2" aria-label="再输入一次密码"/><block wx:if="{{tab === 'login'}}"><view class="captcha" bindtap="loadCaptcha"><image wx:if="{{captchaImage}}" src="{{captchaImage}}" mode="aspectFit"/><text wx:else>{{captchaLoading ? '加载中…' : '点击获取验证码'}}</text></view><input placeholder="上图字符" maxlength="4" value="{{captcha}}" bindinput="onCaptcha" aria-label="上图字符"/></block><button class="primary" bindtap="submitAuth">{{tab === 'login' ? '登录' : '注册'}}</button></view><view wx:if="{{message}}" class="message">{{message}}</view></view>
  <view class="main-tabs"><view class="{{mainTab === 'overview' ? 'on' : ''}}" data-tab="overview" bindtap="pickMainTab">总览</view><view class="{{mainTab === 'plans' ? 'on' : ''}}" data-tab="plans" bindtap="pickMainTab">我的赛事</view><view class="{{mainTab === 'results' ? 'on' : ''}}" data-tab="results" bindtap="pickMainTab">完赛记录</view><view class="{{mainTab === 'profile' ? 'on' : ''}}" data-tab="profile" bindtap="pickMainTab">个人资料</view></view>
  <block wx:if="{{mainTab === 'overview'}}">
    <view wx:if="{{nickname}}" class="surface weekly-card">
      <view class="dashboard-head"><view class="section-title">本周运动</view><view class="dashboard-more" data-view="stats" bindtap="openRunner">数据详情 ›</view></view>
      <view wx:if="{{runner}}" class="weekly-content"><view class="weekly-copy"><view class="weekly-label">本周跑步</view><view class="weekly-value">{{runner.overview.weekKmLabel}}<text>公里</text></view><view class="weekly-meta">{{runner.overview.weekCount}} 次运动 · {{runner.overview.weekMinutes}} 分钟</view></view><view class="weekly-chart"><view wx:for="{{runner.training.bars}}" wx:key="key" class="weekly-bar"><view class="weekly-plot"><view class="weekly-fill {{item.height ? '' : 'zero'}} {{item.key === runner.asOf ? 'today' : ''}}" style="height: {{item.height}}%;"></view></view><text>{{item.label}}</text></view></view></view>
      <view wx:elif="{{runnerLoading}}" class="dashboard-loading">正在整理本周数据…</view><view wx:else class="dashboard-error"><text>{{runnerError || '运动摘要暂时无法加载'}}</text><view bindtap="loadRunner">点击重试</view></view>
      <view wx:if="{{runner && runner.training.isCurrentWeek}}" class="weekly-compare">{{runner.training.comparisonText}}</view>
      <view class="weekly-footer"><text>{{runner && runner.overview.weekCount ? '每一次出发，都算数' : '从一次轻松跑开始'}}</text><view data-view="stats" bindtap="openRunner">查看运动数据 ›</view></view>
    </view>
    <navigator wx:if="{{nickname && nextRace}}" class="surface next-race" url="/pages/race/race?id={{nextRace.race.id}}"><view class="next-days"><text>{{nextRace.days ? nextRace.days : '今'}}</text><text>{{nextRace.days ? '天后' : '天开跑'}}</text></view><view class="next-copy"><view class="dashboard-eyebrow">下一场期待</view><view class="next-name">{{nextRace.race.name}}</view><view class="subtitle">{{nextRace.race.raceDate}}<text wx:if="{{nextRace.race.city}}"> · {{nextRace.race.city}}</text><text> · {{nextRace.status}}</text></view></view><text class="arrow">›</text></navigator>
    <view wx:if="{{nickname}}" class="surface career-overview"><view class="dashboard-head"><view class="section-title career-heading">我的完赛成绩</view><view class="dashboard-more" data-view="career" bindtap="openRunner">赛事生涯 ›</view></view><view wx:if="{{runner && runner.career.pb.length}}" class="best-grid career-best-grid"><navigator wx:for="{{runner.career.pb}}" wx:key="distance" url="/pages/race/race?id={{item.race.id}}"><text class="best-label">{{item.distanceLabel}} PB</text><text class="best-time">{{item.clock}}</text><text class="best-race">{{item.race.name}}</text></navigator></view><view class="career-totals"><view><text class="career-total-number">{{runner ? runner.career.finished : '—'}}</text><text class="career-total-label">场完赛</text></view><view><text class="career-total-number">{{runner ? runner.career.cities.length : '—'}}</text><text class="career-total-label">座城市</text></view><view><text class="career-total-number">{{runner ? runner.career.kmLabel : '—'}}</text><text class="career-total-label">比赛里程 · 公里</text></view></view><view class="compact-poster"><text>{{posterAvailable ? '让完赛记录成为一张留念' : '记下第一场完赛，再制作成绩海报'}}</text><button data-mode="results" bindtap="openAchievementPoster">{{posterAvailable ? '制作成绩海报 ↗' : '去记录成绩 ›'}}</button></view></view>
    <view class="archive-workbench"><view class="dashboard-heading"><view class="section-title">跑者工作台</view><text>个人运动档案</text></view>
    <view class="runner-entry-grid"><view wx:for="{{runnerViews}}" wx:key="key" class="runner-entry {{item.tone}}" data-view="{{item.key}}" bindtap="openRunner" role="button" aria-label="{{item.title}}"><view class="entry-copy"><view class="entry-title">{{item.title}}</view><view class="entry-caption">{{item.shortCaption}}</view></view></view></view>
    <navigator class="history-entry" url="/pages/history/history"><view><text class="profile-history-kicker">历史赛事记录</text><view class="section-title">我的跑史 <text class="arrow">↗</text></view><view class="runner-help-copy">导入历史成绩，管理参赛履历。</view></view></navigator></view>
    <navigator class="feedback-entry" url="/pages/feedback/feedback{{feedbackUnread ? '?mine=1' : ''}}"><view class="feedback-entry-mark"><text>＋</text></view><view class="feedback-entry-copy"><view>共创建议<text>一起让赛历更好</text></view><text>提功能、聊设计，好想法有实物回礼</text></view><text wx:if="{{feedbackUnread}}" class="feedback-entry-badge">{{feedbackUnread > 99 ? '99+' : feedbackUnread}}<text>新进度</text></text><text class="feedback-entry-arrow">›</text></navigator>
    <view class="surface runner-help"><view class="help-heading" bindtap="toggleHelp" role="button" aria-label="查看使用帮助"><view class="help-title"><text>使用帮助</text></view><text class="arrow">{{helpOpen ? '⌄' : '›'}}</text></view><view wx:if="{{helpOpen}}" class="help-details"><view class="help-question">如何记录赛事与成绩？</view><view>在赛事详情标记报名、中签等状态，比赛后填写成绩；暂不提供赛事报名与支付。</view><view class="help-question">运动数据和比赛里程有什么不同？</view><view>运动数据统计已记录的跑步与越野实际距离，赛事生涯统计个人填写的有效完赛成绩，两者分别汇总。</view><view class="help-question">荣誉与影像会公开吗？</view><view>个人运动、收藏与赛事影像仅自己可见。跑团内的赛事成绩仍按原有跑团权限展示。</view><view class="help-question">支持手表自动同步吗？</view><view>目前可手动记录，设备自动同步需完成厂商接入。详细状态可在「数据来源」查看。</view><view class="help-source" data-view="devices" bindtap="openRunner">查看数据来源与统计口径 ›</view></view></view>
  </block>
  <block wx:elif="{{mainTab === 'plans'}}">
    <view wx:if="{{conflicts.length}}" class="surface"><view class="section-title">比赛安排提醒</view><view wx:for="{{conflicts}}" wx:key="text" class="message">{{item.text}}</view></view>
    <view wx:if="{{reminders.length}}" class="surface"><view class="section-title">截止提醒</view><navigator wx:for="{{reminders}}" wx:key="key" class="reminder-row" url="/pages/race/race?id={{item.race.id}}"><text class="accent">{{item.hit.reason}}</text><text class="reminder-name">{{item.race.name}}</text><text class="arrow">›</text></navigator></view>
    <view wx:if="{{plans.length}}" class="surface plan-list"><navigator wx:for="{{plans}}" wx:key="raceId" class="plan-row" url="/pages/race/race?id={{item.race.id}}"><view class="row-copy"><text class="state-tag">{{item.status}}</text><view class="race-name">{{item.race.name}}</view><view class="subtitle">{{item.race.raceDate}}<text wx:if="{{item.race.city}}"> · {{item.race.city}}</text></view></view><text class="arrow">›</text></navigator></view>
    <view wx:else class="surface empty-state"><view class="section-title">{{nickname ? '下一场，想去哪里跑？' : '把想跑的比赛放进这里'}}</view><view class="hint">{{nickname ? '在赛事详情页标记报名或中签状态，随时查看参赛安排。' : '登录后，你标记的比赛会自动汇总在这里。'}}</view><navigator class="text-action" open-type="switchTab" url="/pages/races/races">去看赛事 ›</navigator></view>
  </block>
  <block wx:elif="{{mainTab === 'results'}}"><view class="surface results-summary"><view class="career-summary"><view><text class="stat-label">完赛场数</text><text class="career-number">{{nickname ? career.finished : '—'}}<text class="unit"> 场</text></text></view><view><text class="stat-label">半马最好成绩</text><text class="career-clock">{{career.pb.half || '—'}}</text></view><view><text class="stat-label">全马最好成绩</text><text class="career-clock">{{career.pb.full || '—'}}</text></view></view><view wx:if="{{nickname}}" class="compact-poster"><text>{{posterAvailable ? '把自己的成绩，留作纪念' : '在赛事详情页记下完赛成绩，即可制作海报'}}</text><button wx:if="{{posterAvailable}}" data-mode="results" bindtap="openAchievementPoster">制作成绩海报 ↗</button><navigator wx:else open-type="switchTab" url="/pages/races/races">去看赛事 ›</navigator></view></view><view wx:if="{{career.finished}}" class="career-note">跑过 {{career.provinces.length}} 个省、{{career.cities.length}} 个城市 · 本年比赛 {{career.yearKm}} 公里</view><view class="surface"><navigator wx:for="{{results}}" wx:key="raceId" class="result-row" url="/pages/race/race?id={{item.race.id}}"><view class="result-clock">{{item.clock}}<text wx:if="{{item.pb}}" class="pb"> PB</text></view><view class="race-name">{{item.race.name}}</view><view class="subtitle">{{item.race.raceDate}} · 成绩未核验</view><image wx:if="{{item.proofSrc}}" class="proof-image" src="{{item.proofSrc}}" mode="widthFix"/></navigator><view wx:if="{{!results.length}}" class="hint empty-copy">在赛事详情页记下完赛成绩，留住你的每次突破。</view></view></block>
  <view wx:elif="{{nickname}}" class="surface settings profile-settings">
    <view class="profile-settings-intro"><view class="profile-settings-kicker">账号与身份</view><view class="profile-settings-title">个人资料</view><view class="profile-settings-note">管理你的头像、昵称和登录方式</view></view>
    <view class="profile-section">
      <view class="profile-section-title"><view class="profile-section-icon profile-section-icon-user"></view><view><view>公开资料</view><text>跑团成员可以看到这些信息</text></view></view>
      <view class="setting-row profile-row" bindtap="toggleProfile"><view class="row-copy"><text>修改头像与昵称</text><view class="subtitle">{{nickname}} · 点击编辑资料</view></view><text class="arrow">{{profileOpen ? '⌄' : '›'}}</text></view>
    </view>
    <view wx:if="{{profileOpen}}" class="profile-form">
      <view class="profile-edit"><button class="avatar-picker" open-type="chooseAvatar" disabled="{{avatarSaving}}" bindchooseavatar="chooseAvatar"><image wx:if="{{avatarPreview || avatar}}" class="profile-avatar" src="{{avatarPreview || avatar}}" mode="aspectFill"/><view wx:else class="profile-avatar avatar-empty">{{nickname[0]}}</view></button><view class="profile-fields"><text class="field-label">昵称</text><input type="nickname" placeholder="设置昵称" value="{{nicknameDraft}}" bindinput="onNickname" aria-label="设置昵称"/></view></view>
      <view class="hint">头像与昵称由你选择，保存后团友可见。</view><button class="primary" loading="{{avatarSaving}}" disabled="{{avatarSaving}}" bindtap="saveProfile">保存个人资料</button>
    </view>
    <view class="profile-section">
      <view class="profile-section-title"><view class="profile-section-icon profile-section-icon-lock"></view><view><view>账号安全</view><text>保护你的赛事与运动记录</text></view></view>
      <view class="setting-row profile-row" bindtap="togglePassword"><view class="row-copy"><text>{{hasPassword ? '修改密码' : '设置登录密码'}}</text><view class="subtitle">{{hasPassword ? '定期更新密码，保障账号安全' : '设置密码后可在其他设备登录'}}</view></view><text class="arrow">{{passwordOpen ? '⌄' : '›'}}</text></view>
    </view>
    <view wx:if="{{passwordOpen}}" class="stack password-form"><view class="hint">{{hasPassword ? '请填写当前密码和新密码。' : '设置后，可使用昵称与密码在其他设备登录。'}}</view><input wx:if="{{hasPassword}}" placeholder="当前密码" password value="{{currentPassword}}" bindinput="onCurrent" aria-label="当前密码"/><input placeholder="新密码，8 到 128 位" password value="{{nextPassword}}" bindinput="onNext" aria-label="新密码，8 到 128 位"/><input placeholder="再输入一次" password value="{{nextPassword2}}" bindinput="onNext2" aria-label="再输入一次"/><button class="primary" bindtap="savePassword">保存密码</button><button class="secondary" bindtap="cancelPassword">取消</button></view>
    <view wx:if="{{message}}" class="message">{{message}}</view>
    <view class="profile-section">
      <view class="profile-section-title"><view class="profile-section-icon profile-section-icon-wechat"></view><view><view>登录方式</view><text>选择更方便的登录方式</text></view></view>
      <view class="setting-row profile-row profile-wechat-row"><view class="row-copy"><view>微信登录</view><view class="subtitle">{{hasWechatLogin ? '微信账号已绑定' : '绑定后可用微信登录当前账号'}}</view></view><button wx:if="{{!hasWechatLogin}}" class="bind-button" loading="{{wxLoading}}" disabled="{{wxLoading}}" bindtap="bindWechat">绑定</button><button wx:else class="bind-button" disabled="{{unbindLoading}}" bindtap="toggleUnbind">{{unbindOpen ? '收起' : '解绑'}}</button></view>
    </view>
    <view wx:if="{{hasWechatLogin && !hasPassword}}" class="hint">解绑微信前，请先设置登录密码，确保能继续登录当前账号。</view>
    <view wx:if="{{unbindOpen}}" class="stack password-form"><view class="hint">验证当前密码后解绑微信，赛事与跑团记录仍保留在当前账号。</view><input placeholder="当前登录密码" password value="{{unbindPassword}}" bindinput="onUnbindPassword" aria-label="当前登录密码"/><button class="primary" loading="{{unbindLoading}}" disabled="{{unbindLoading}}" bindtap="unbindWechat">验证密码并解绑</button><button class="secondary" disabled="{{unbindLoading}}" bindtap="toggleUnbind">取消</button><view wx:if="{{unbindMessage}}" class="message">{{unbindMessage}}</view></view>
    <view wx:if="{{profileMessage}}" class="hint">{{profileMessage}}</view>
    <view wx:if="{{clubs.length}}" class="profile-section profile-clubs-section">
      <view class="profile-section-title"><view class="profile-section-icon profile-section-icon-club"></view><view><view>我的跑团</view><text>你加入的跑团与身份</text></view></view>
      <navigator wx:for="{{clubs}}" wx:key="id" class="setting-row profile-row" url="/pages/club/club?id={{item.id}}"><view class="row-copy"><view>{{item.name}}</view><view class="subtitle">{{item.roleLabel}}</view></view><text class="arrow">›</text></navigator>
    </view>
  </view>
  <view wx:else class="surface empty-state"><view class="section-title">你的资料，由你管理</view><view class="hint">登录后设置头像、昵称和账号密码。</view></view>
  </block>
  <view class="legal"><view class="legal-links"><text data-doc="terms" bindtap="openLegal">用户协议</text><text data-doc="privacy" bindtap="openLegal">隐私政策</text><text data-doc="collection" bindtap="openLegal">个人信息收集清单</text><text data-doc="sharing" bindtap="openLegal">第三方信息共享清单</text><text data-doc="rights" bindtap="openLegal">个人信息权利</text><text class="legal-link" bindtap="openPrivacy">微信隐私保护指引</text></view><text>{{company}} · {{icp}}</text></view>
</view>
