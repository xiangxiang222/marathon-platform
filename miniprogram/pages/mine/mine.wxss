/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-mine-mine .surface, .mini-mine-mine .account-hero, .mini-mine-mine .runner-entry, .mini-mine-mine .feedback-entry { border-radius: 36rpx; }
.mini-mine-mine .primary, .mini-mine-mine .secondary, .mini-mine-mine .bind-button, .mini-mine-mine .stack, .mini-mine-mine .captcha { border-radius: 24rpx; }
.mini-mine-mine .role-tag, .mini-mine-mine .state-tag { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-mine-mine { color: var(--text); }
.mini-mine-mine button { font-weight: 500; border-radius: 24rpx; }
.mine-page .avatar-picker { border-radius: 50%; }

.mine-page { color: var(--text); background: transparent; }
.surface { border: 1px solid var(--border); box-shadow: var(--card-shadow); background: #ffffff; }
.account-hero { border: 1px solid var(--border); background: linear-gradient(135deg,#f2edff,#ffffff); border-color: #e8def8; box-shadow: var(--card-shadow); }
.runner-entry { border: 1px solid var(--border); }
.feedback-entry { border: 1px solid var(--border); background: #ffffff; }
.nickname,.guest-title { font-size: 24px; font-weight: 600; }
.main-tabs { gap: 32rpx; padding: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; }
.main-tabs > view { position: relative; border-radius: 0; background: transparent; font-size: 14px; font-weight: 400; }
.main-tabs > .on { color: var(--text); background: transparent; font-weight: 600; }
.main-tabs > .on::after { display: block; position: absolute; right: 22rpx; left: 22rpx; bottom: -1px; height: 2px; border-radius: 0; background: var(--brand); content: ''; }
.auth-tabs { border-bottom: 1px solid var(--border); }
.auth-tabs .on { border-bottom: 2px solid var(--brand); }
.stack input,.profile-fields input { border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); font-size: 14px; }
.secondary,.bind-button { border: 1px solid var(--border); background: #fff; font-size: 12px; }
.feedback-entry { color: var(--text); background: #ffffff; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-mine-mine .primary { font-size: 14px; font-weight: 500; }
.mini-mine-mine .secondary, .mini-mine-mine .bind-button { font-size: 13px; font-weight: 500; }
.dashboard-heading > text { font-size: 12px; } .weekly-fill { background: var(--brand); }

/* Color surfaces use existing semantic page elements; layout stays unchanged. */
.guest-hero { background: linear-gradient(135deg,#f2edff,#ffffff); }

/* A private poster studio, opened only from the current runner account. */
.achievement-poster-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;box-sizing:border-box;margin:0 0 24rpx;padding:26rpx 28rpx;border:1rpx solid #eee4cf;border-radius:28rpx;background:linear-gradient(110deg,#fff7e7,#fffdfa);color:#8d6f40;text-align:left;line-height:1.6}.achievement-poster-entry::after{border:0}.achievement-poster-entry>view{flex:1;min-width:0}.achievement-poster-entry>view>view{font-size:14px;font-weight:600;color:#65563e}.achievement-poster-entry>view>text{display:block;margin-top:6rpx;font-size:11px;font-weight:400;color:#a99a80}.achievement-poster-entry>text{flex:none;font-size:12px;font-weight:500;white-space:nowrap}
