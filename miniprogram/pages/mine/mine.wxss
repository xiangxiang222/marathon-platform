/* Profile editors and archive rows share one reading and interaction scale. */
.mini-mine-mine .surface,.mini-mine-mine .runner-entry,.mini-mine-mine .feedback-entry{border-radius:12px}.section-title,.settings-title{font-size:18px;font-weight:600;line-height:1.5}.setting-row,.race-name,.entry-title,.next-name{font-size:16px;font-weight:500;line-height:1.6}.mini-mine-mine .primary,.mini-mine-mine .secondary,.mini-mine-mine .bind-button,.mini-mine-mine .account-settings .logout{min-height:44px;font-size:14px;border-radius:10px}.stack input,.profile-fields input{height:46px;font-size:14px;border-radius:10px}.weekly-value,.career-total-number,.stat-value,.career-number{font-size:24px;color:var(--text);letter-spacing:normal}.weekly-fill{background:var(--brand-soft)}.weekly-fill.today{background:var(--brand)}.weekly-fill.zero{background:var(--border)}.best-time,.career-clock{font-size:18px;letter-spacing:normal}.compact-poster>button,.compact-poster>navigator{font-size:14px;min-height:44px}.empty-state>.hint{font-size:14px;line-height:1.75}

.header-settings{color:#fff}

/* Personal workspace: compact identity, summaries and a shared tool grid. */
.mine-page{position:relative;margin-top:0;padding:0 28rpx calc(52rpx + env(safe-area-inset-bottom));font-family:inherit;color:var(--text)}
.surface{margin-bottom:28rpx;padding:32rpx;border:1px solid var(--border);border-radius:10px;background:#fff;box-shadow:none}
.account-hero,.guest-hero{overflow:hidden;margin-bottom:36rpx;padding:0;border-radius:12px}
.profile-cover{position:relative;height:320rpx;overflow:hidden;background:#3c4a41}
.profile-cover-image{position:absolute;inset:0;width:100%;height:100%;object-position:center 54%}
.profile-cover-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(16,28,25,.78),rgba(16,28,25,.37) 58%,rgba(16,28,25,.14)),linear-gradient(0deg,rgba(16,28,25,.3),transparent 55%)}
.profile-cover-copy{position:absolute;right:36rpx;bottom:34rpx;left:36rpx;color:#fff}
.profile-kicker{display:block;margin-bottom:22rpx;color:rgba(255,255,255,.84);font-size:12px;font-weight:600;line-height:1.4;letter-spacing:1px}
.hero-line{gap:22rpx}.hero-avatar{width:96rpx;height:96rpx;border:2px solid rgba(255,255,255,.9);border-radius:50%;background:var(--brand);color:#fff;font-size:20px;font-weight:600}
.nickname{font-size:20px;line-height:1.35;font-weight:600;color:#fff}.profile-cover .subtitle{margin-top:6rpx;color:rgba(255,255,255,.86);font-size:12px;line-height:1.45;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.role-tag{margin-top:8rpx;padding:4rpx 14rpx;border-radius:4px;background:rgba(255,255,255,.92);font-size:12px;line-height:1.4;color:var(--brand)}
.account-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:0;padding:22rpx 8rpx 24rpx;border:0}
.account-stats>view,.account-stats>navigator{justify-content:center;min-height:44px;gap:6rpx}
.account-stats>view+view,.account-stats>view+navigator{border-left:1px solid var(--border)}
.stat-value{font-size:20px;line-height:1.2;font-weight:600}.stat-label{font-size:12px;line-height:1.4;white-space:nowrap}
.guest-cover{height:340rpx}.guest-cover-copy{position:absolute;top:36rpx;right:36rpx;left:36rpx;color:#fff}
.guest-cover .profile-kicker{margin-bottom:36rpx}.guest-title{font-size:24px;font-weight:600;line-height:1.35;color:#fff}
.guest-subtitle{margin-top:12rpx;color:rgba(255,255,255,.88);font-size:14px;line-height:1.55}
.guest-actions{padding:20rpx 30rpx 28rpx}.guest-hero .primary{min-height:46px;margin-top:24rpx;border-radius:8px;font-size:14px;font-weight:500}
.main-tabs{gap:0;margin:0 0 28rpx;padding:0;border-bottom:1px solid var(--border)}
.main-tabs>view{position:relative;height:46px;min-height:46px;line-height:46px;padding:0 6rpx;font-size:14px;font-weight:400;white-space:nowrap}
.main-tabs>.on{font-weight:600;color:var(--text)}.main-tabs>.on::after{right:calc(50% - 15px);left:calc(50% - 15px);bottom:0;width:30px;height:3px;border-radius:2px;background:var(--brand)}
.section-title,.settings-title{font-size:18px;line-height:1.4;font-weight:600}
.dashboard-head{gap:20rpx}.dashboard-more{display:flex;align-items:center;min-height:44px;padding:0;font-size:12px;line-height:1.5;color:var(--text-secondary)}
.weekly-card{padding:28rpx 32rpx 12rpx}.weekly-content{align-items:flex-end;gap:24rpx;padding:16rpx 0 20rpx}
.weekly-value{margin-top:4rpx;font-size:32px;line-height:1.15;font-weight:600;letter-spacing:-.6px;color:var(--text)}
.weekly-value text{font-size:12px;letter-spacing:0}.weekly-label,.weekly-meta{font-size:12px;line-height:1.5}.weekly-meta{margin-top:14rpx}
.weekly-chart{width:246rpx;gap:14rpx;padding-bottom:4rpx}.weekly-plot{height:104rpx;border-radius:3px;background:#f6f6f6}.weekly-fill{border-radius:3px;background:#ffb5bf}.weekly-fill.today{background:var(--brand)}.weekly-fill.zero{background:var(--border)}.weekly-bar>text{margin-top:12rpx;font-size:12px}
.weekly-compare{margin:0 0 14rpx;padding:0;background:transparent;border-radius:0;font-size:12px;line-height:1.5}
.weekly-footer{min-height:42px;gap:20rpx;padding:14rpx 0 0;font-size:12px;border-color:var(--border)}.weekly-footer>text{font-size:12px;line-height:1.5}.weekly-footer>view,.weekly-footer>navigator{display:flex;align-items:center;flex:none;min-height:44px;color:var(--brand);font-size:12px}
.next-race{gap:22rpx;padding:24rpx 28rpx;background:#fff7f7;border-color:#ffe1e5}.next-days{width:86rpx;height:94rpx;border:1px solid #ffd4dc;border-radius:7px;background:#fff}.next-days>text:first-child{font-size:22px;line-height:1.2}.next-days>text+text{font-size:12px;line-height:1.4}.next-name{font-size:15px;line-height:1.45;font-weight:500}.next-race .subtitle,.dashboard-eyebrow{font-size:12px;line-height:1.5}
.career-overview{padding:26rpx 32rpx 6rpx}.career-totals{grid-template-columns:.85fr .85fr 1.3fr;gap:20rpx;margin:30rpx 0 0;padding-bottom:28rpx}.career-total-number{font-size:20px;line-height:1.2;letter-spacing:0}.career-total-label{margin-top:8rpx;font-size:12px;line-height:1.5}
.career-best-grid{gap:20rpx;margin-top:20rpx}.best-grid navigator{position:relative;overflow:hidden;padding:24rpx 20rpx;border:1px solid #ffe1e5;border-radius:8px;background:#fff3f3}.best-label{font-size:12px;line-height:1.5;color:#925a62}.best-time{position:relative;margin-top:12rpx;font-size:24px;line-height:1.2;font-weight:600;letter-spacing:-.5px;color:var(--brand)}.best-race{margin-top:12rpx;font-size:12px;line-height:1.5;color:#a17b81}
.compact-poster{gap:20rpx;min-height:49px;margin-top:0;padding-top:6rpx;font-size:12px}.compact-poster>text{max-width:48%;font-size:12px;line-height:1.5}.compact-poster>button,.compact-poster>navigator{font-size:13px;line-height:1.5}
.archive-workbench{overflow:hidden;margin-bottom:28rpx;border:1px solid var(--border);border-radius:10px;background:#fff}.dashboard-heading{padding:20rpx 32rpx 0;gap:20rpx}.dashboard-heading>text{font-size:12px;line-height:1.5}
.runner-entry-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin-bottom:0;padding:18rpx 10rpx 22rpx}.runner-entry{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;min-height:184rpx;padding:20rpx 6rpx;border:0;border-radius:0;background:transparent;text-align:center}.runner-entry:nth-child(-n+3){border-bottom:1px solid var(--border)}
.entry-icon{width:68rpx;height:68rpx;border-radius:9px;background:#fff1f3;padding:10rpx;box-sizing:border-box}.entry-copy{flex:none;width:100%}.entry-title{font-size:14px;line-height:1.4;font-weight:500;white-space:nowrap}.entry-caption{margin-top:8rpx;font-size:12px;line-height:1.4;white-space:nowrap}
.history-entry{display:flex;align-items:center;gap:24rpx;margin:0 24rpx 24rpx;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:#fafafa}.history-entry>image{flex:none;width:164rpx;height:170rpx}.history-entry>view{flex:1;min-width:0;padding:18rpx 22rpx 18rpx 0}.profile-history-kicker{font-size:12px;font-weight:500;letter-spacing:.5px;color:var(--text-secondary)}.history-entry .section-title{margin:8rpx 0;font-size:16px;line-height:1.4}.history-entry .arrow{float:right;color:var(--brand);font-size:17px}.history-entry .runner-help-copy{margin-top:0;font-size:12px;line-height:1.5}
.feedback-entry{gap:24rpx;min-height:62px;margin:0 0 28rpx;padding:24rpx 28rpx;border:1px solid var(--border);border-radius:10px}.feedback-entry-mark{width:68rpx;height:68rpx;background:var(--brand-soft);font-size:22px}.feedback-entry-copy>view{font-size:14px;color:var(--text)}.feedback-entry-copy>view>text{display:none}.feedback-entry-copy>text{font-size:12px;line-height:1.5}.feedback-entry-badge{font-size:14px}
.help-heading{min-height:44px}.help-title{font-size:14px;font-weight:500}.help-details,.help-question{font-size:12px;line-height:1.65}.runner-help{padding:18rpx 28rpx}
.results-summary{padding:30rpx 24rpx}.career-summary{gap:12rpx}.career-clock{margin-top:16rpx;font-size:16px;line-height:1.4;white-space:nowrap}.career-number{font-size:24px;line-height:1.2}.career-note{font-size:12px;line-height:1.5}.result-clock{font-size:18px;line-height:1.4}.race-name{font-size:16px;line-height:1.5;font-weight:500}.result-row{padding:26rpx 0}.result-row .subtitle{font-size:12px;line-height:1.5}
.setting-row{min-height:58px;font-size:15px;line-height:1.5}.account-settings{padding:32rpx}.account-settings .setting-row{min-height:60px}.stack input,.profile-fields input{height:46px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font-size:14px}.primary,.secondary,.bind-button{min-height:44px;border-radius:8px;font-size:14px;font-weight:500}.settings{padding-top:4rpx}.hint{font-size:13px;line-height:1.65}.legal{padding:28rpx 4rpx}.legal-links text{min-height:32px;font-size:12px;line-height:1.5}
@media(max-width:350px){.mine-page{padding-right:24rpx;padding-left:24rpx}.profile-cover{height:356rpx}.guest-cover{height:384rpx}.profile-cover-copy{right:28rpx;left:28rpx;bottom:28rpx}.guest-cover-copy{top:30rpx;right:28rpx;left:28rpx}.guest-title{font-size:22px}.stat-value{font-size:18px}.account-stats .stat-label{font-size:12px}.main-tabs>view{font-size:13px}.surface{padding:28rpx}.account-hero,.guest-hero{padding:0}.weekly-chart{width:240rpx;gap:12rpx}.weekly-value{font-size:30px}.career-overview{padding:26rpx 28rpx 6rpx}.career-total-number{font-size:18px}.career-best-grid{gap:14rpx}.best-grid navigator{padding:22rpx 16rpx}.best-time{font-size:21px}.dashboard-heading>text{display:none}.runner-entry{padding:20rpx 4rpx}.entry-title{font-size:14px}.entry-caption{font-size:12px}.history-entry>image{width:174rpx}.compact-poster>button,.compact-poster>navigator{font-size:12px}.results-summary{padding:26rpx 18rpx}.career-clock{font-size:15px}.settings{padding-top:4rpx}}

/* Original spot illustrations support the profile and archive tools. */
.identity-panel{display:flex;align-items:center;gap:16rpx;min-height:244rpx;padding:32rpx 20rpx 28rpx 32rpx;box-sizing:border-box;background:linear-gradient(115deg,#fff,#fff9f6);color:var(--text)}.identity-copy{flex:1;min-width:0}.identity-kicker{display:block;margin-bottom:24rpx;color:var(--text-secondary);font-size:12px;font-weight:400;line-height:1.5}.profile-art{display:block;flex:none;width:154rpx;height:170rpx}.identity-panel .hero-avatar{width:86rpx;height:86rpx;border:0;background:var(--brand-soft);color:var(--brand);font-size:18px}.identity-panel .nickname{font-size:18px;line-height:1.35;color:var(--text)}.identity-panel .subtitle{margin-top:10rpx;color:var(--text-secondary);font-size:12px;line-height:1.5}.identity-panel .role-tag{background:var(--brand-soft);color:var(--brand)}.guest-identity{min-height:252rpx}.guest-identity .guest-title{font-size:22px;line-height:1.35;color:var(--text)}.guest-identity .guest-subtitle{margin-top:14rpx;color:var(--text-secondary);font-size:12px;line-height:1.6}.guest-actions{padding-top:20rpx}.account-stats{margin:0 24rpx;padding:24rpx 0;border-top:1px solid var(--border)}.career-heading{display:flex;align-items:center;gap:12rpx}.career-heading>image{width:66rpx;height:74rpx}.compact-poster{gap:16rpx}.compact-poster>.poster-art{display:block;flex:none;width:74rpx;height:78rpx}.compact-poster>text{max-width:none;font-size:12px}.compact-poster>button,.compact-poster>navigator{font-size:13px}.history-entry{flex-direction:row;gap:8rpx;padding:20rpx 24rpx;background:#fcfaf7;border-color:#f3ede7}.history-entry>view{padding:0;flex:1;min-width:0}.history-entry>image{width:136rpx;height:144rpx}.profile-history-kicker{font-size:12px;letter-spacing:normal;color:var(--text-secondary)}.history-entry .runner-help-copy{font-size:12px}.runner-entry-grid .runner-entry{border-radius:0}.next-days>text+text{white-space:nowrap}
@media(max-width:350px){.identity-panel{min-height:282rpx;padding-left:28rpx}.identity-panel .hero-line{gap:16rpx}.identity-panel .hero-avatar{width:94rpx;height:94rpx;font-size:17px}.identity-panel .nickname{font-size:17px}.profile-art{width:150rpx;height:182rpx}.guest-identity .guest-title{font-size:20px}.account-stats .stat-label{font-size:12px}.career-heading{gap:8rpx;font-size:17px}.career-heading>image{width:68rpx;height:80rpx}.compact-poster>.poster-art{width:74rpx;height:84rpx}.compact-poster>button,.compact-poster>navigator{font-size:12px}.history-entry{padding:20rpx}.history-entry>image{width:150rpx;height:164rpx}}
.legal,.legal>text,.legal-links text,.legal-link{font-size:12px;line-height:1.6}.legal-links text{min-height:44px}.setting-row{font-size:16px}
