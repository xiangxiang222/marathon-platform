.mine-page { padding: 0 24rpx 32rpx; color: #1f2026; }.surface { padding: 32rpx; margin-bottom: 24rpx; border-radius: 24rpx; background: #fff; }.hero-line { display: flex; align-items: center; gap: 24rpx; }.hero-avatar { display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; flex: none; border-radius: 50%; }.avatar-empty { background: #fff0f3; color: #ff0a30; font-size: 44rpx; font-weight: 600; }.hero-copy,.row-copy { flex: 1; min-width: 0; }.nickname { font-size: 40rpx; line-height: 56rpx; font-weight: 600; overflow-wrap: anywhere; }.subtitle { margin-top: 10rpx; color: #8a8e99; font-size: 24rpx; line-height: 36rpx; }.hero-arrow,.arrow { flex: none; color: #b9bdc7; font-size: 44rpx; line-height: 1; }.hero-arrow { padding: 16rpx 0 16rpx 12rpx; }.role-tag,.state-tag { display: inline-block; margin-top: 8rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: #fff0f3; color: #ff0a30; font-size: 22rpx; }.account-stats { display: flex; margin-top: 40rpx; }.account-stats > view,.account-stats > navigator { flex: 1; display: flex; align-items: center; flex-direction: column; gap: 10rpx; min-width: 0; }.stat-value { font-size: 48rpx; line-height: 60rpx; font-weight: 700; }.stat-label { display: block; color: #8a8e99; font-size: 24rpx; }.guest-title { font-size: 36rpx; font-weight: 600; line-height: 52rpx; }.primary { display: block; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 16rpx; background: #ff0a30; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 88rpx; }.primary::after,.secondary::after,.avatar-picker::after,.bind-button::after,.logout::after { border: 0; }.guest-hero .primary { margin-top: 32rpx; }.auth-toggle { padding: 24rpx 0 0; text-align: center; color: #8a8e99; font-size: 24rpx; }.auth-tabs { display: flex; gap: 40rpx; margin-bottom: 20rpx; }.auth-tabs > view { padding: 12rpx 0; color: #8a8e99; font-size: 28rpx; }.auth-tabs > .on { color: #ff0a30; font-weight: 600; }.stack input,.profile-fields input { display: block; width: 100%; min-width: 0; height: 88rpx; margin-top: 20rpx; padding: 0 24rpx; border: 0; border-radius: 16rpx; background: #f5f6fa; color: #1f2026; font-size: 30rpx; box-sizing: border-box; }.stack .primary,.stack .secondary { margin-top: 20rpx; }.captcha { display: flex; align-items: center; justify-content: center; height: 96rpx; margin-top: 20rpx; border-radius: 16rpx; background: #f5f6fa; color: #8a8e99; font-size: 24rpx; }.captcha image { width: 100%; height: 88rpx; }.hint { margin-top: 16rpx; color: #8a8e99; font-size: 24rpx; line-height: 40rpx; }.message { margin-top: 16rpx; color: #ff0a30; font-size: 24rpx; line-height: 40rpx; }.quick-links { display: flex; padding: 28rpx 8rpx; }.quick-links navigator { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; min-width: 0; font-size: 24rpx; white-space: nowrap; }.quick-links image { width: 72rpx; height: 72rpx; }.main-tabs { display: flex; margin-bottom: 24rpx; border-bottom: 1rpx solid #e9ebf1; }.main-tabs > view { position: relative; flex: 1; min-width: 0; height: 92rpx; line-height: 92rpx; text-align: center; color: #8a8e99; font-size: 32rpx; font-weight: 600; }.main-tabs > .on { color: #ff0a30; }.main-tabs > .on::after { position: absolute; bottom: 0; left: calc(50% - 24rpx); width: 48rpx; height: 6rpx; border-radius: 4rpx; background: #ff0a30; content: ''; }.section-title { font-size: 32rpx; line-height: 48rpx; font-weight: 600; }.reminder-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f0f1f5; font-size: 26rpx; }.reminder-row:last-child { border: 0; padding-bottom: 0; }.accent { flex: none; color: #ff0a30; }.reminder-name { flex: 1; min-width: 0; }.plan-list { padding-top: 0; padding-bottom: 0; }.plan-row { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid #f0f1f5; }.plan-row:last-child { border: 0; }.state-tag { margin-top: 0; }.race-name { margin-top: 12rpx; font-size: 32rpx; line-height: 46rpx; font-weight: 600; }.empty-state { padding: 56rpx 32rpx; text-align: center; }.text-action { margin-top: 28rpx; color: #ff0a30; font-size: 28rpx; }.career-summary { display: flex; gap: 16rpx; }.career-summary > view { flex: 1; min-width: 0; }.career-summary .stat-label { font-size: 22rpx; }.career-number { display: block; margin-top: 16rpx; font-size: 48rpx; font-weight: 600; }.career-clock { display: block; margin-top: 26rpx; font-size: 30rpx; font-weight: 600; }.unit { font-size: 22rpx; font-weight: 400; }.career-note { margin: 0 8rpx 24rpx; color: #8a8e99; font-size: 24rpx; line-height: 38rpx; }.result-row { display: block; padding: 24rpx 0; border-bottom: 1rpx solid #f0f1f5; }.result-row:first-child { padding-top: 0; }.result-row:last-child { border: 0; padding-bottom: 0; }.result-clock { color: #ff0a30; font-size: 36rpx; font-weight: 600; }.pb { font-size: 22rpx; }.proof-image { width: 100%; margin-top: 20rpx; border-radius: 16rpx; }.empty-copy { margin-top: 0; }.settings { padding-top: 0; }.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 112rpx; border-bottom: 1rpx solid #f0f1f5; font-size: 30rpx; }.setting-row .subtitle { margin-top: 6rpx; }.profile-form,.password-form { padding: 24rpx 0; }.profile-edit { display: flex; align-items: center; gap: 24rpx; }.avatar-picker { flex: none; width: 104rpx; height: 104rpx; margin: 0; padding: 0; border-radius: 50%; background: transparent; }.profile-avatar { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 50%; }.profile-fields { flex: 1; min-width: 0; }.profile-fields input { margin-top: 8rpx; }.field-label { color: #8a8e99; font-size: 24rpx; }.profile-form .primary { margin-top: 24rpx; }.secondary { width: 100%; min-height: 80rpx; margin: 0; border-radius: 16rpx; background: #f0f1f6; color: #1f2026; font-size: 28rpx; line-height: 80rpx; }.bind-button { flex: none; min-height: 64rpx; margin: 0; padding: 0 24rpx; border-radius: 12rpx; background: #f0f1f6; color: #1f2026; font-size: 26rpx; line-height: 64rpx; }.logout { width: 100%; min-height: 88rpx; margin-top: 20rpx; background: transparent; color: #8a8e99; font-size: 28rpx; line-height: 88rpx; }.legal { padding: 20rpx 0; text-align: center; color: #a5a9b2; font-size: 20rpx; }
.account-guidance { text-align: left; }.wechat-choice { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f1f5; }.wechat-choice .primary,.wechat-choice .secondary { margin-top: 20rpx; }.wechat-choice .section-title { font-size: 30rpx; }
@media(max-width:375px){
