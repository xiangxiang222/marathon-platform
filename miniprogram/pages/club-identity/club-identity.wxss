.identity-page { min-height:100vh; padding:28rpx 24rpx 48rpx; box-sizing:border-box; color:#252932; background:#f5f6f8; }
.hero { padding:18rpx 8rpx 30rpx; }
.eyebrow { color:#a4949c; font-size:21rpx; letter-spacing:3rpx; }
.title { margin-top:16rpx; font-size:44rpx; font-weight:700; }
.copy { margin-top:14rpx; color:#868c97; font-size:25rpx; line-height:1.8; overflow-wrap:anywhere; }
.panel { margin-bottom:20rpx; padding:28rpx; border-radius:24rpx; background:#fff; }
.name { font-size:31rpx; font-weight:600; overflow-wrap:anywhere; }
.state { display:inline-block; margin-top:20rpx; padding:10rpx 16rpx; color:#626c78; background:#f0f2f5; border-radius:10rpx; font-size:25rpx; }
.decision { margin-top:20rpx; padding:20rpx; border-radius:14rpx; color:#785867; background:#fff4f6; font-size:25rpx; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; }
.label { display:flex; flex-wrap:wrap; gap:12rpx; margin:28rpx 0 12rpx; font-size:27rpx; font-weight:600; }
.label text { color:#999faa; font-size:23rpx; font-weight:400; }
.identity-page input { width:100%; height:96rpx; padding:0 20rpx; font-size:26rpx; }
.identity-page textarea { width:100%; min-height:250rpx; padding:20rpx; font-size:26rpx; line-height:1.7; }
.identity-page button,.action-link { display:flex; align-items:center; justify-content:center; width:100%; min-height:96rpx; padding:20rpx; box-sizing:border-box; border:0; border-radius:16rpx; font-size:27rpx; line-height:1.5; }
.identity-page button::after { border:0; }
.primary { margin-top:28rpx; color:#fff; background:#ff0a30; }
.secondary { color:#68717e; background:#fff; }
.panel .secondary { margin-top:24rpx; background:#f1f3f6; }
.identity-page .short-intro { min-height:140rpx; }
.message { margin:20rpx 0; padding:24rpx; border-radius:16rpx; color:#b45369; background:#fff0f3; font-size:25rpx; line-height:1.8; overflow-wrap:anywhere; }

@media (max-width:350px) { .identity-page button,.action-link { min-height:44px; } .identity-page input { min-height:44px; } }
