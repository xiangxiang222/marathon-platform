.sport-page { padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom)); background: transparent; }.surface { padding: 32rpx; margin-bottom: 24rpx;  background: #ffffff; box-shadow: var(--card-shadow); }.hero-top,.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }.field-label { color: var(--text-secondary); font-size: 12px; }.month-value { margin-top: 10rpx; font-size: 14px; }.month-value text { color: var(--text-secondary); }.text-button { display: flex; align-items: center; min-height: 44px; flex: none; padding: 12rpx 0; color: var(--brand); font-size: 12px; }.mileage-value { display: flex; align-items: baseline; gap: 16rpx; margin: 24rpx 0 28rpx; }.mileage-number { font-size: 56px; line-height: 1.15; letter-spacing: -1px; font-weight: 750;  color: var(--brand);}.mileage-unit { color: var(--text-secondary); font-size: 14px; }.progress-track { height: 12rpx; border-radius: 8rpx; overflow: hidden; background: #d8eae5; }.progress-value { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#f46c56,#e1251b); }.target-caption { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; color: var(--text-secondary); font-size: 12px; }.accent { color: var(--brand); }.no-target { color: var(--text-secondary); font-size: 12px; line-height: 40rpx; }.run-metrics { display: flex; padding-top: 28rpx; margin-top: 28rpx; border-top: 1rpx solid var(--border); background: rgba(255,255,255,.55); }.run-metrics > view { flex: 1; min-width: 0; text-align: center; }.run-metrics > view:first-child { text-align: left; }.run-metrics > view:last-child { text-align: right; }.metric-value { display: block; font-size: 22px; line-height: 56rpx; font-weight: 650; }.metric-label { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 12px; }.primary { display: block; width: 100%; min-height:44px; margin: 0; padding: 0 24rpx;  background: var(--brand); color: #fff; font-size: 14px; font-weight: 600; line-height: 88rpx; }.primary::after,.secondary::after,.delete-button::after,.choices button::after { border: 0;  }.manual-note { margin: 16rpx 0 40rpx; text-align: center; color: var(--text-secondary); font-size: 12px; line-height: 36rpx; }.section-title { font-size: 19px; line-height: 48rpx; font-weight: 600; }.records-heading { margin: 40rpx 8rpx 24rpx; }.records-title { font-size: 20px; line-height: 52rpx; font-weight: 600; }.run-date { margin: 12rpx 0 28rpx; color: var(--text-secondary); font-size: 12px; line-height: 36rpx; }.record-data { display: flex; gap: 14rpx;  padding: 24rpx 0;}.record-data > view { flex: 1; min-width: 0; }.record-number { display: block; font-size: 18px; line-height: 1.4; font-weight: 600; }.record-unit { display: block; margin-top: 6rpx; color: var(--text-secondary); font-size: 12px; }.hint { margin-top: 20rpx; color: var(--text-secondary); font-size: 12px; line-height: 38rpx; }.stack { display: flex; flex-direction: column; gap: 24rpx; margin-top: 28rpx; }.stack input { width: 100%; min-width: 0; height: 88rpx; padding: 0 24rpx; border: 0; border-radius: 16rpx; background: var(--page-bg); color: var(--text); font-size: 14px; box-sizing: border-box; }.stack > .field-label + input { margin-top: -12rpx; }.field-pair { display: flex; gap: 20rpx; }.field-pair > view { flex: 1; min-width: 0; }.field-pair input,.picker-value { margin-top: 12rpx;  }.picker-value { height: 88rpx; padding: 0 24rpx;  background: var(--page-bg); font-size: 14px; line-height: 88rpx; }.choices { display: flex;  }.choices button { flex: none; min-width: 124rpx; margin: 0; line-height: 72rpx; }.close-button { display: flex; align-items: center; min-height: 44px; padding: 12rpx 0; color: var(--text-secondary); font-size: 12px; }.secondary { width: 100%; min-height:44px; margin: 0; padding: 0 24rpx; color: var(--text); font-size: 12px; line-height: 88rpx; }.record-editor { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border); }.delete-button { min-height:44px; margin: 0; color: var(--text-secondary); background: transparent; font-size: 12px; line-height: 80rpx; }.shot { display: block; width: 100%; margin-top: 24rpx; border-radius: 16rpx; }.guest-state { padding: 56rpx 40rpx; text-align: center; background: linear-gradient(135deg,#e9f7f2,#ffffff); }
.empty-state { padding: 56rpx 40rpx; text-align: center; }.guest-title { margin-top: 24rpx; font-size: 24px; line-height: 56rpx; font-weight: 600; }.guest-state .hint { margin: 16rpx 0 40rpx; }.guest-mark { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin: auto; border-radius: 50%; background: var(--brand-soft); color: var(--brand); font-size: 60rpx; }.year-note,.loading-copy { margin: 32rpx 8rpx; color: var(--text-secondary); font-size: 12px; line-height: 40rpx; }.message { margin: 24rpx 8rpx; color: var(--brand); font-size: 12px; line-height: 40rpx; }
@media(max-width:375px){
  .sport-page { font-size: 15px;  padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom)); background: transparent; }
  .surface { padding: 14px; box-shadow: var(--card-shadow); background: #ffffff; }
  .field-label,.text-button,.target-caption,.no-target,.metric-label,.manual-note,.run-date,.record-unit,.hint,.close-button,.year-note,.loading-copy,.message { font-size: 12px; line-height: 19px; }
  .month-value { font-size: 15px; line-height: 23px; }
  .mileage-number { font-size: 56px;  color: var(--brand); font-weight: 750; letter-spacing: -1px;}
  .mileage-unit { font-size: 15px; }
  .metric-value { font-size: 22px; line-height: 28px;  font-weight: 650;}
  .section-title,.records-title,.guest-title { font-size: 20px; line-height: 26px; }
  .record-data { gap: 14rpx;  padding: 24rpx 0;}
  .record-number { font-size: 18px; line-height: 1.4; }
  .field-pair { gap: 8px; }
  .primary,.secondary,.delete-button,.choices button { min-height: 44px; font-size: 15px; line-height: 44px;  }
  .stack input,.picker-value { height: 44px; font-size: 15px; line-height: 44px;  }
  .target-caption { flex-wrap: wrap; }
}

.record-actions { display: flex; gap: 16rpx; }.record-actions > button { flex: 1; min-width: 0; }.import-button { display: block; min-height: 44px; margin: 0; padding: 0 16rpx; border: 1rpx solid var(--border);  background: var(--sky-soft); color: var(--brand); font-size: 14px; font-weight: 600; line-height: 44px; }.import-button::after { border: 0;  }
.sport-eyebrow { margin-bottom: 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border); color: var(--text-secondary); font-size: 12px; font-weight: 600; letter-spacing: 1rpx; }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-sport-sport .surface { border-radius: 36rpx; }
.mini-sport-sport .primary, .mini-sport-sport .secondary, .mini-sport-sport .import-button, .mini-sport-sport .picker-value { border-radius: 24rpx; }
.mini-sport-sport .choices { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-sport-sport { color: var(--text); }
.mini-sport-sport button { font-weight: 500; border-radius: 24rpx; }

.sport-page { color: var(--text); background: transparent; }
.surface { border: 1px solid var(--border); box-shadow: var(--card-shadow); background: #ffffff; }
.section-title,.records-title { font-weight: 600; }
.stack input,.picker-value { border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); font-size: 14px; }
.choices { gap: 12rpx; border-radius: 0; }
.choices button { min-height: 36px; padding: 8rpx 16rpx; border: 1px solid var(--border); border-radius: 14rpx; background: #fff; color: var(--text-secondary); font-size: 12px; }
.choices button.on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
.secondary { border: 1px solid var(--border); background: #fff; }
.record-data { font-size: 14px; }
.run-date,.manual-note,.record-unit { font-size: 11px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-sport-sport .primary { font-size: 14px; font-weight: 500; }
.mini-sport-sport .secondary, .mini-sport-sport .import-button { font-size: 13px; font-weight: 500; }

/* Color surfaces use existing semantic page elements; layout stays unchanged. */
.mileage-hero { background: linear-gradient(135deg,#e9f7f2,#ffffff); border-color: #dcece8; box-shadow: var(--card-shadow); }
.editor { background: #ffffff; }
