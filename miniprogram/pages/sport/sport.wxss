.sport-page { padding: 0 24rpx 40rpx; color: #1f2026; }.surface { padding: 32rpx; margin-bottom: 24rpx; border-radius: 24rpx; background: #fff; }.hero-top,.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }.field-label { color: #8a8e99; font-size: 24rpx; }.month-value { margin-top: 10rpx; font-size: 28rpx; }.month-value text { color: #8a8e99; }.text-button { flex: none; padding: 12rpx 0; color: #ff0a30; font-size: 24rpx; }.mileage-value { display: flex; align-items: baseline; gap: 16rpx; margin: 32rpx 0; }.mileage-number { font-size: 96rpx; line-height: 1.15; letter-spacing: -2rpx; font-weight: 700; }.mileage-unit { color: #8a8e99; font-size: 28rpx; }.progress-track { height: 12rpx; border-radius: 8rpx; overflow: hidden; background: #f0f1f6; }.progress-value { height: 100%; border-radius: inherit; background: #ff0a30; }.target-caption { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; color: #8a8e99; font-size: 24rpx; }.accent { color: #ff0a30; }.no-target { color: #8a8e99; font-size: 24rpx; line-height: 40rpx; }.run-metrics { display: flex; padding-top: 40rpx; margin-top: 36rpx; border-top: 1rpx solid #f0f1f5; }.run-metrics > view { flex: 1; min-width: 0; text-align: center; }.run-metrics > view:first-child { text-align: left; }.run-metrics > view:last-child { text-align: right; }.metric-value { display: block; font-size: 40rpx; line-height: 56rpx; font-weight: 600; }.metric-label { display: block; margin-top: 8rpx; color: #8a8e99; font-size: 24rpx; }.primary { display: block; width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 16rpx; background: #ff0a30; color: #fff; font-size: 30rpx; font-weight: 600; line-height: 88rpx; }.primary::after,.secondary::after,.delete-button::after,.choices button::after { border: 0; }.manual-note { margin: 16rpx 0 40rpx; text-align: center; color: #8a8e99; font-size: 22rpx; line-height: 36rpx; }.section-title { font-size: 32rpx; line-height: 48rpx; font-weight: 600; }.records-heading { margin: 40rpx 8rpx 24rpx; }.records-title { font-size: 36rpx; line-height: 52rpx; font-weight: 600; }.run-date { margin: 12rpx 0 28rpx; color: #8a8e99; font-size: 24rpx; line-height: 36rpx; }.record-data { display: flex; gap: 24rpx; }.record-data > view { flex: 1; min-width: 0; }.record-number { display: block; font-size: 36rpx; line-height: 52rpx; font-weight: 600; }.record-unit { display: block; margin-top: 6rpx; color: #8a8e99; font-size: 22rpx; }.hint { margin-top: 20rpx; color: #8a8e99; font-size: 24rpx; line-height: 38rpx; }.stack { display: flex; flex-direction: column; gap: 24rpx; margin-top: 28rpx; }.stack input { width: 100%; min-width: 0; height: 88rpx; padding: 0 24rpx; border: 0; border-radius: 16rpx; background: #f5f6fa; color: #1f2026; font-size: 30rpx; box-sizing: border-box; }.stack > .field-label + input { margin-top: -12rpx; }.field-pair { display: flex; gap: 20rpx; }.field-pair > view { flex: 1; min-width: 0; }.field-pair input,.picker-value { margin-top: 12rpx; }.picker-value { height: 88rpx; padding: 0 24rpx; border-radius: 16rpx; background: #f5f6fa; font-size: 30rpx; line-height: 88rpx; }.choices { display: flex; gap: 16rpx; }.choices button { flex: none; min-width: 124rpx; min-height: 72rpx; margin: 0; padding: 0 24rpx; border-radius: 16rpx; background: #f0f1f6; color: #1f2026; font-size: 28rpx; line-height: 72rpx; }.choices button.on { color: #ff0a30; background: #fff0f3; }.close-button { padding: 12rpx 0; color: #8a8e99; font-size: 24rpx; }.secondary { width: 100%; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 16rpx; background: #f0f1f6; color: #1f2026; font-size: 26rpx; line-height: 88rpx; }.record-editor { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f1f5; }.delete-button { min-height: 80rpx; margin: 0; color: #8a8e99; background: transparent; font-size: 26rpx; line-height: 80rpx; }.shot { display: block; width: 100%; margin-top: 24rpx; border-radius: 16rpx; }.guest-state,.empty-state { padding: 56rpx 40rpx; text-align: center; }.guest-title { margin-top: 24rpx; font-size: 40rpx; line-height: 56rpx; font-weight: 600; }.guest-state .hint { margin: 16rpx 0 40rpx; }.guest-mark { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin: auto; border-radius: 50%; background: #fff0f3; color: #ff0a30; font-size: 60rpx; }.year-note,.loading-copy { margin: 32rpx 8rpx; color: #8a8e99; font-size: 24rpx; line-height: 40rpx; }.message { margin: 24rpx 8rpx; color: #ff0a30; font-size: 24rpx; line-height: 40rpx; }
@media(max-width:375px){
  .sport-page { font-size: 15px; }
  .surface { padding: 14px; }
  .field-label,.text-button,.target-caption,.no-target,.metric-label,.manual-note,.run-date,.record-unit,.hint,.close-button,.year-note,.loading-copy,.message { font-size: 12px; line-height: 19px; }
  .month-value { font-size: 15px; line-height: 23px; }
  .mileage-number { font-size: 44px; }
  .mileage-unit { font-size: 15px; }
  .metric-value { font-size: 20px; line-height: 28px; }
  .section-title,.records-title,.guest-title { font-size: 18px; line-height: 26px; }
  .record-data { gap: 8px; }
  .record-number { font-size: 18px; line-height: 26px; }
  .field-pair { gap: 8px; }
  .primary,.secondary,.delete-button,.choices button { min-height: 44px; font-size: 15px; line-height: 44px; }
  .stack input,.picker-value { height: 44px; font-size: 15px; line-height: 44px; }
  .target-caption { flex-wrap: wrap; }
}
