<view class="achievement-studio">
  <view class="studio-heading"><view class="studio-title">把热爱，定格成光<text>✦</text></view><view class="studio-subtitle">属于自己的成绩，值得好好分享。</view></view>
  <view wx:if="{{!ready}}" class="studio-state"><view class="state-symbol">↗</view><view class="state-title">先打开你的跑者档案</view><view>{{error || '登录后，用自己的成绩制作一张海报。'}}</view><button class="studio-primary" bindtap="login">去登录</button></view>
  <view wx:elif="{{loading}}" class="studio-state"><view class="studio-skeleton"></view><view>正在整理你的高光时刻…</view></view>
  <view wx:elif="{{error}}" class="studio-state"><view class="state-title">成绩暂时没有打开</view><view>{{error}}</view><button class="studio-primary" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="studio-modes"><button wx:for="{{modes}}" wx:key="id" class="{{mode === item.id ? 'selected' : ''}}" data-id="{{item.id}}" disabled="{{saving}}" bindtap="pickMode">{{item.id === 'pb' ? 'PB 荣誉卡' : item.name}}</button></view>
    <view class="studio-preview-wrap">
      <view class="studio-preview-label"><text>海报预览</text><text>{{selectedCount}} 条成绩 · 高清 PNG</text></view>
      <image wx:if="{{posterPath}}" class="studio-preview" src="{{posterPath}}" mode="widthFix" bindtap="previewPoster" aria-label="查看高清海报大图" />
      <view wx:elif="{{generating}}" class="studio-preview-placeholder"><view class="preview-spark">✦</view><view>正在排版你的高光…</view></view>
      <view wx:elif="{{generateError}}" class="studio-preview-placeholder"><view class="preview-spark">↻</view><view>{{generateError}}</view><button class="studio-outline" bindtap="generate">重新生成</button></view>
      <view wx:else class="studio-preview-placeholder"><view class="preview-spark">✧</view><view class="preview-empty-title">{{emptyText}}</view><view>{{availableCount ? '展开成绩选择，勾选想分享的记录。' : '记录有效的已完赛成绩，再来制作海报。'}}</view><button wx:if="{{!availableCount && !year}}" class="studio-outline" bindtap="goRecord">去记录成绩</button></view>
      <view wx:if="{{posterPath}}" class="studio-preview-hint">轻点海报，查看原尺寸大图 ↗</view>
      <view wx:if="{{pageCount > 1}}" class="studio-pagination"><button data-direction="-1" disabled="{{pageIndex === 0 || saving}}" bindtap="changePage" aria-label="上一张海报">‹</button><view>第 {{pageNumber}} / {{pageCount}} 张<text>全部 {{selectedCount}} 条均已保留，请逐张保存</text></view><button data-direction="1" disabled="{{pageNumber === pageCount || saving}}" bindtap="changePage" aria-label="下一张海报">›</button></view>
    </view>
    <view class="studio-section"><view class="studio-section-heading"><view>选择一种心情</view><text>三款配色</text></view><view class="studio-themes"><button wx:for="{{styles}}" wx:key="id" class="studio-theme theme-{{item.id}} {{style === item.id ? 'theme-selected' : ''}}" data-id="{{item.id}}" disabled="{{saving}}" bindtap="pickStyle"><view class="theme-paper"><text>PB</text><view></view><view></view></view><view>{{item.name}}<text>{{style === item.id ? '✓' : ''}}</text></view></button></view></view>
    <view class="studio-section studio-controls"><view class="studio-section-heading"><view>这一张，想怎么讲</view></view><picker range="{{quotes}}" value="{{quoteIndex}}" disabled="{{saving}}" bindchange="pickQuote"><view class="studio-control-row"><text class="control-label">分享文案</text><view class="control-value">{{quotes[quoteIndex]}}<text>⌄</text></view></view></picker>
      <picker wx:if="{{mode === 'results'}}" range="{{years}}" value="{{yearIndex}}" disabled="{{saving}}" bindchange="pickYear"><view class="studio-control-row"><text class="control-label">成绩年份</text><view class="control-value">{{years[yearIndex]}}<text>⌄</text></view></view></picker><view wx:else class="studio-control-row pb-note"><text class="control-label">统计范围</text><view>生涯最好 · 不受年份筛选</view></view>
      <button class="studio-control-row control-expand" disabled="{{saving}}" bindtap="toggleSelection"><text class="control-label">{{mode === 'pb' ? '展示哪些 PB' : '选择完赛成绩'}}</text><view>{{selectedCount}} / {{availableCount}} 条<text>{{selectionOpen ? '⌃' : '⌄'}}</text></view></button>
      <view wx:if="{{selectionOpen}}" class="studio-selection"><view class="selection-tools"><text>{{mode === 'pb' ? '仅线下公路赛事生涯最好成绩' : '可多选，超过20条自动分张'}}</text><button disabled="{{saving || !availableCount}}" bindtap="selectAll">全选</button><button disabled="{{saving || !selectedCount}}" bindtap="clearSelection">清空</button></view><button wx:for="{{choices}}" wx:key="key" class="selection-row {{item.selected ? 'is-selected' : ''}}" data-key="{{item.key}}" disabled="{{saving}}" bindtap="toggleResult"><text class="selection-check">{{item.selected ? '✓' : ''}}</text><view class="selection-copy"><view>{{item.raceName}}</view><text>{{item.raceDate}} · {{item.distanceLabel}}</text></view><text class="selection-clock">{{item.clock}}</text></button><view wx:if="{{!choices.length}}" class="selection-empty">这个范围还没有可选成绩。</view></view>
    </view>
    <view class="studio-section studio-privacy"><button class="studio-control-row control-expand" disabled="{{saving}}" bindtap="togglePrivacy"><view><text class="privacy-mark">◈</text><text>分享前，留一点自己的空间</text></view><text>{{privacyOpen ? '⌃' : '⌄'}}</text></button><view wx:if="{{privacyOpen}}" class="privacy-options"><view class="privacy-row"><text>显示昵称</text><switch checked="{{showName}}" color="#FF1838" disabled="{{saving}}" data-key="showName" bindchange="changePrivacy" aria-label="显示昵称" /></view><view class="privacy-row"><text>显示赛事名称</text><switch checked="{{showRace}}" color="#FF1838" disabled="{{saving}}" data-key="showRace" bindchange="changePrivacy" aria-label="显示赛事名称" /></view><view class="privacy-row"><text>显示比赛日期</text><switch checked="{{showDate}}" color="#FF1838" disabled="{{saving}}" data-key="showDate" bindchange="changePrivacy" aria-label="显示比赛日期" /></view><view class="privacy-row"><text>显示城市</text><switch checked="{{showCity}}" color="#FF1838" disabled="{{saving}}" data-key="showCity" bindchange="changePrivacy" aria-label="显示城市" /></view><view class="privacy-note">开关只影响本张海报，不修改你的资料与成绩。</view></view></view>
    <view class="studio-footnote">个人填写的成绩记录 · 未经赛事官方核验</view>
    <view class="studio-bottom"><view wx:if="{{saveMessage}}" class="studio-save-message" role="status">{{saveMessage}}<button wx:if="{{needsSetting}}" bindtap="openAlbumSettings">去设置 ›</button></view><view class="studio-bottom-actions"><button class="studio-outline" disabled="{{!posterPath || generating || saving}}" bindtap="previewPoster">查看大图</button><button class="studio-primary" loading="{{saving}}" disabled="{{!posterPath || generating || saving}}" bindtap="savePoster">{{saving ? '正在保存' : pageCount > 1 ? '保存第 ' + pageNumber + ' 张' : saved ? '再次保存海报' : '保存到相册'}}</button></view><view class="studio-save-caption">保存后，自行选择分享到朋友圈</view></view>
  </block>
  <canvas type="2d" id="achievement-canvas" class="studio-canvas" aria-hidden="true"></canvas>
</view>
