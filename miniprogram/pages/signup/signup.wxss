.signup-page { box-sizing: border-box; min-height: 100vh; padding: 0 24rpx 180rpx; color: #1f2026; }
.signup-hero { position: relative; overflow: hidden; margin: 0 -24rpx; padding: 34rpx 30rpx 30rpx; background: #1c1d22; color: #fff; }
.signup-hero::before { position: absolute; top: 0; right: 0; width: 12rpx; height: 100%; background: #ff0a30; content: ""; }
.hero-label { color: #ff647e; font-size: 22rpx; font-weight: 700; }
.signup-title { margin-top: 18rpx; font-size: 38rpx; line-height: 1.35; font-weight: 700; overflow-wrap: anywhere; }
.signup-time { margin-top: 24rpx; font-size: 27rpx; line-height: 1.45; }
.signup-place { margin-top: 8rpx; color: #c0c1c8; font-size: 23rpx; line-height: 1.45; overflow-wrap: anywhere; }
.signup-by { margin-top: 22rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255,255,255,.16); color: #aeb0b8; font-size: 21rpx; }
.selection-section { margin-top: 28rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin: 0 2rpx 14rpx; }
.section-title { font-size: 30rpx; line-height: 1.4; font-weight: 650; }
.required-mark { color: #ff0a30; font-size: 21rpx; }
.group-options { display: flex; flex-direction: column; gap: 10rpx; }
.group-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 100rpx; box-sizing: border-box; padding: 18rpx 20rpx; border: 2rpx solid transparent; border-radius: 12rpx; background: #fff; }
.group-option-on { border-color: #ff0a30; background: #fff8f9; }
.group-option-full { opacity: .55; }
.group-option-main { flex: 1; min-width: 0; }
.group-option-name { font-size: 27rpx; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
.group-option-pace { margin-left: 10rpx; color: #8a8e99; font-size: 21rpx; font-weight: 400; }
.group-option-sub { margin-top: 5rpx; color: #8a8e99; font-size: 21rpx; line-height: 1.35; }
.group-state { flex: none; min-width: 60rpx; color: #8a8e99; font-size: 22rpx; text-align: right; }
.group-option-on .group-state { color: #ff0a30; font-weight: 600; }
.group-option-full .group-state { color: #a5a9b2; }
.no-groups { padding: 26rpx 20rpx; border-radius: 12rpx; background: #fff; color: #737780; font-size: 23rpx; }
.signup-deadline { margin: 14rpx 4rpx 0; color: #c87825; font-size: 21rpx; line-height: 1.45; }
.optional-section { margin-top: 28rpx; border-radius: 12rpx; background: #fff; }
.optional-toggle { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 86rpx; padding: 0 20rpx; }
.optional-title { font-size: 25rpx; font-weight: 600; }
.optional-caption { margin-left: 10rpx; color: #8a8e99; font-size: 21rpx; }
.optional-arrow { flex: none; color: #ff0a30; font-size: 22rpx; }
.optional-fields { padding: 0 20rpx 22rpx; }
.field-label { margin: 4rpx 0 10rpx; color: #777b84; font-size: 21rpx; }
.choice-row { display: flex; gap: 10rpx; }
.choice { flex: 1; min-width: 0; height: 64rpx; border-radius: 8rpx; background: #f5f6fa; color: #636771; font-size: 22rpx; line-height: 64rpx; text-align: center; }
.choice-on { background: #fff0f3; color: #ff0a30; font-weight: 600; }
.level-label { margin-top: 22rpx; }
.level-list { overflow: hidden; border-radius: 8rpx; background: #f5f6fa; }
.level-option { display: flex; align-items: center; gap: 12rpx; min-height: 76rpx; padding: 12rpx 14rpx; border-bottom: 1rpx solid #e9eaf0; }
.level-option:last-child { border-bottom: 0; }
.level-name { flex: none; width: 72rpx; font-size: 22rpx; font-weight: 600; }
.level-description { flex: 1; min-width: 0; color: #858993; font-size: 19rpx; line-height: 1.4; }
.level-check { flex: none; width: 52rpx; color: #ff0a30; font-size: 18rpx; text-align: right; }
.error-line { margin-top: 16rpx; color: #c73540; font-size: 22rpx; line-height: 1.5; }
.action-hint { margin-top: 16rpx; color: #8a8e99; font-size: 22rpx; }
.bottom-space { height: 20rpx; }
.submit-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; min-height: 116rpx; padding: 16rpx 24rpx calc(16rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e9eaf0; background: rgba(255,255,255,.98); }
.submit-count { display: flex; align-items: baseline; gap: 6rpx; flex: 1; min-width: 0; }
.count-number { font-size: 34rpx; font-weight: 700; }
.count-label { color: #8a8e99; font-size: 20rpx; white-space: nowrap; }
.submit-button { flex: none; width: 360rpx; height: 82rpx; min-height: 82rpx; margin: 0; padding: 0 16rpx; border-radius: 10rpx; background: #ff0a30; color: #fff; font-size: 26rpx; line-height: 82rpx; }
.submit-button[disabled] { background: #e8e9ed; color: #8a8e99; }
.load-state { display: flex; align-items: center; flex-direction: column; justify-content: center; min-height: 70vh; padding: 40rpx; color: #777b84; font-size: 25rpx; text-align: center; }
.load-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; margin-bottom: 20rpx; border-radius: 50%; background: #1c1d22; color: #ff0a30; font-size: 25rpx; font-weight: 700; }
.retry-button { min-height: 72rpx; margin-top: 24rpx; padding: 0 28rpx; border-radius: 10rpx; background: #ff0a30; color: #fff; font-size: 24rpx; line-height: 72rpx; }

@media (max-width: 350px) {
  .signup-title { font-size: 35rpx; }
  .submit-bar { gap: 10rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .submit-button { width: 300rpx; font-size: 24rpx; }
  .level-option { gap: 8rpx; padding-right: 10rpx; padding-left: 10rpx; }
  .level-description { font-size: 18rpx; }
}
