.signup-page { box-sizing: border-box; min-height: 100vh; padding: 0 24rpx 180rpx; background: transparent; }
.signup-hero { position: relative; overflow: hidden; color: var(--text); background: var(--surface); border-color: var(--border); box-shadow: none; }
.signup-hero::before { position: absolute; top: 0; right: 0; width: 12rpx; height: 100%; background: var(--brand); content: "";  }
.hero-label { color: var(--brand); font-size: 12px; font-weight: 600; }
.signup-title { margin-top: 18rpx; overflow-wrap: anywhere; }
.signup-time { margin-top: 24rpx; font-size: 14px; line-height: 1.45; }
.signup-place { margin-top: 8rpx; color: var(--text-secondary); font-size: 12px; line-height: 1.45; overflow-wrap: anywhere; }
.signup-by { margin-top: 22rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border); color: var(--text-secondary); font-size: 12px; }
.selection-section { margin-top: 28rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin: 0 2rpx 14rpx; }
.section-title { font-size: 18px; line-height: 1.4; font-weight: 600; }
.required-mark { color: var(--brand); font-size: 12px; }
.group-options { display: flex; flex-direction: column; gap: 10rpx; }
.group-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 100rpx; box-sizing: border-box; background: #ffffff; }
.group-option-full { opacity: .55; }
.group-option-main { flex: 1; min-width: 0; }
.group-option-name { line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
.group-option-pace { margin-left: 10rpx; color: var(--text-secondary); font-size: 12px; font-weight: 400; }
.group-option-sub { margin-top: 5rpx; color: var(--text-secondary); font-size: 12px; line-height: 1.35; }
.group-state { flex: none; min-width: 60rpx; text-align: right; }
.group-option-on .group-state { color: var(--brand); font-weight: 600; }
.group-option-full .group-state { color: var(--text-secondary); }
.no-groups { padding: 26rpx 20rpx;  background: #fff; color: var(--text-secondary); font-size: 12px; }
.signup-deadline { margin: 14rpx 4rpx 0; color: var(--brand); font-size: 12px; line-height: 1.45; }
.optional-section { margin-top: 28rpx;  background: #ffffff; }
.optional-toggle { display: flex; justify-content: space-between; gap: 16rpx; min-height:44px; }
.optional-title { font-weight: 600; }
.optional-caption { margin-left: 10rpx; color: var(--text-secondary); }
.optional-arrow { flex: none; color: var(--brand); font-size: 12px; }
.optional-fields { padding: 0 20rpx 22rpx; }
.field-label { margin: 4rpx 0 10rpx; color: var(--text-secondary); font-size: 12px; }
.choice-row { display: flex; gap: 10rpx; }
.choice { flex: 1; min-width: 0; min-height: 44px; height: 44px; color: var(--text-secondary); text-align: center; }
.choice-on { font-weight: 600; }
.level-label { margin-top: 22rpx; }
.level-list { overflow: hidden; border-radius: 8rpx; background: var(--lilac-soft); }
.level-option { display: flex; align-items: center; gap: 12rpx; min-height:44px; padding: 12rpx 14rpx; border-bottom: 1rpx solid var(--border); }
.level-option:last-child { border-bottom: 0; }
.level-name { flex: none; width: 72rpx; font-size: 12px; font-weight: 600; }
.level-description { flex: 1; min-width: 0; color: var(--text-secondary); font-size: 12px; line-height: 1.4; }
.level-check { flex: none; width: 52rpx; color: var(--brand); font-size: 12px; text-align: right; }
.error-line { margin-top: 16rpx; color: var(--brand); font-size: 12px; line-height: 1.5; }
.action-hint { margin-top: 16rpx; color: var(--text-secondary); font-size: 12px; }
.bottom-space { height: 20rpx; }
.submit-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; min-height: 116rpx; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border); background: rgba(255,255,255,.98); }
.submit-count { display: flex; align-items: baseline; gap: 6rpx; flex: 1; min-width: 0; }
.count-number { font-size: 18px; font-weight: 600; }
.count-label { color: var(--text-secondary); font-size: 12px; white-space: nowrap; }
.submit-button { flex: none; width: 360rpx; height: 82rpx; min-height:44px; margin: 0; padding: 0 16rpx;  background: var(--brand); color: #fff; font-size: 12px; line-height: 82rpx; }
.submit-button[disabled] { background: var(--border); color: var(--text-secondary);  }
.load-state { display: flex; align-items: center; flex-direction: column; justify-content: center; min-height: 70vh; padding: 40rpx; color: var(--text-secondary); font-size: 12px; text-align: center; }
.load-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; margin-bottom: 20rpx; border-radius: 50%; background: var(--brand-soft); color: var(--brand); font-size: 12px; font-weight: 600; }
.retry-button { min-height:44px; margin-top: 24rpx; padding: 0 28rpx;  background: var(--brand); color: #fff; font-size: 12px; line-height: 72rpx; }

@media (max-width: 350px) {
  .signup-title { font-size: 24px; }
  .submit-bar { gap: 10rpx; padding-right: 24rpx; padding-left: 24rpx; }
  .submit-button { width: 300rpx; font-size: 12px;  }
  .level-option { gap: 8rpx; padding-right: 10rpx; padding-left: 10rpx; }
  .level-description { font-size: 12px; }
}

/* Use layout centering instead of inherited native button line heights. */
.signup-page button { display: flex; align-items: center; justify-content: center; line-height: 1.35; box-sizing: border-box; }

.signup-hero { margin: 24rpx 0 0; background: var(--surface); border-color: var(--border); box-shadow: none; }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-signup-signup .signup-hero, .mini-signup-signup .group-option, .mini-signup-signup .optional-section, .mini-signup-signup .no-groups { border-radius: 24rpx; }
.mini-signup-signup .submit-button, .mini-signup-signup .retry-button { border-radius: 24rpx; }
.mini-signup-signup .choice { border-radius: 14rpx; }
.mini-signup-signup { color: var(--text); }
.mini-signup-signup button { font-weight: 500; border-radius: 24rpx; }

.signup-page { background: transparent; color: var(--text); }
.signup-hero { padding: 30rpx; border: 1px solid var(--border); background: var(--surface); border-color: var(--border); box-shadow: none; }
.signup-title { font-size: 24px; font-weight: 600; line-height: 1.45; }
.hero-label,.signup-by,.group-option-sub { font-size: 12px; }
.signup-time,.signup-place { font-size: 13px; }
.group-option { padding: 28rpx; border: 1px solid var(--border); background: #ffffff; }
.group-option-on { border-color: var(--brand); background: var(--surface); }
.group-option-name { font-size: 15px; }
.group-state { color: var(--brand); font-size: 12px; }
.optional-section { border: 1px solid var(--border); background: #ffffff; }
.optional-toggle { align-items: flex-start; padding: 24rpx; }
.optional-title { display: block; font-size: 13px; }
.optional-caption { display: block; margin: 8rpx 0 0; font-size: 12px; line-height: 1.7; }
.choice { display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: 14rpx; background: #fff; font-size: 12px; line-height: 1.4; }
.choice-on { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
.submit-bar .submit-button { display: flex; align-items: center; justify-content: center; height: 44px; border-radius: 24rpx; line-height: 1.4; background: var(--brand); }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-signup-signup .submit-button { font-size: 14px; font-weight: 500; }
.mini-signup-signup .retry-button { font-size: 13px; font-weight: 500; }
.submit-bar .submit-button { font-size: 14px; }
