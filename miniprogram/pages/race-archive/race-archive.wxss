.archive-page {
  --archive-ink: #272329;
  --archive-muted: #685f66;
  --archive-bg: #f7f5f5;
  --archive-line: #eee8ea;
  --archive-accent: #a91635;
  --archive-tint: #fcecf0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--archive-bg);
  color: var(--archive-ink);
  line-height: 1.55;
}

.archive-page button {
  margin: 0;
  border: 0;
  font-weight: 400;
  line-height: 1.45;
}

.archive-page button::after { border: 0; }

.archive-tabs {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  background: #fff;
  border-bottom: 1px solid var(--archive-line);
}

.archive-tabs .archive-tab {
  flex: 1;
  padding: 8px 0;
  background: transparent;
  color: var(--archive-muted);
  border-radius: 8px;
  font-size: 14px;
  white-space: nowrap;
}

.archive-tabs .selected {
  color: var(--archive-accent);
  font-weight: 650;
  background: var(--archive-tint);
}

.archive-scroll,
.archive-reader-scroll {
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
}

.archive-body,
.archive-reader-body {
  max-width: 660px;
  margin: 0 auto;
  padding: 14px 16px calc(20px + env(safe-area-inset-bottom));
}

.archive-h2, .archive-h3, .archive-item-title, .archive-story-title, .archive-reader-title {
  font-weight: 650;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.archive-h2 { font-size: 23px; }
.archive-h3 { font-size: 17px; margin-bottom: 8px; }
.archive-item-title { font-size: 15px; }
.archive-meta { color: var(--archive-muted); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
.archive-prose { margin: 0 0 10px; font-size: 14px; line-height: 1.75; color: #544c53; white-space: pre-line; overflow-wrap: anywhere; }
.archive-intro { font-size: 15px; }
.archive-section { margin-top: 18px; }
.archive-surface { background: #fff; border-radius: 11px; }
.archive-chevron { flex: none; font-size: 23px; color: #8e7e86; line-height: 1; }
.archive-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }

.archive-section-head {
  min-height: 44px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.archive-select {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 10px;
  border-radius: 9px;
  background: #fff;
  color: var(--archive-muted);
  font-size: 13px;
  white-space: nowrap;
  border: 1px solid var(--archive-line);
}

.archive-caret {
  width: 6px;
  height: 6px;
  margin-top: -3px;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: rotate(45deg);
}

.archive-subnav {
  display: flex;
  gap: 6px;
  margin-bottom: 10px;
}

.archive-subnav > button {
  flex: 1;
  padding: 6px 3px;
  border-radius: 9px;
  background: #fff;
  color: var(--archive-muted);
  font-size: 13px;
  white-space: nowrap;
}

.archive-subnav > button.on { background: var(--archive-tint); color: var(--archive-accent); font-weight: 650; }
.archive-gallery-nav > button { font-size: 12px; }
.archive-empty { padding: 26px 12px; border-radius: 11px; background: #fff; text-align: center; color: var(--archive-muted); font-size: 14px; }

.archive-hero {
  position: relative;
  min-height: 156px;
  overflow: hidden;
  background: linear-gradient(135deg, #44242e, #281d26);
  color: #fff;
}

.archive-landmark, .archive-cover { position: absolute; }
.archive-landmark { width: 184px; height: 140px; right: -5px; bottom: -10px; opacity: .34; }
.archive-cover { inset: 0; width: 100%; height: 100%; opacity: .31; }
.archive-hero-copy { position: relative; padding: 38px 16px 18px; }
.archive-title { font-size: 29px; font-weight: 650; line-height: 1.34; }
.archive-hero-meta, .archive-hero-badges { font-size: 12px; color: #f5e8ec; }
.archive-hero-badges { display: flex; flex-wrap: wrap; gap: 5px 12px; margin-top: 8px; }
.archive-directory { position: absolute; top: 2px; right: 16px; min-height: 44px; display: flex; align-items: center; gap: 5px; font-size: 12px; }
.archive-return { padding: 10px 12px; margin-bottom: 12px; }
.archive-overview-edition { margin-top: 14px; }
.archive-edition-title { padding: 10px 12px; font-weight: 650; border-bottom: 1px solid var(--archive-line); }
.archive-menu-row { display: flex; width: 100%; padding: 8px 12px; text-align: left; background: transparent; }
.archive-menu-row + .archive-menu-row { border-top: 1px solid var(--archive-line); border-radius: 0; }
.archive-history { padding: 0 12px; }
.archive-history-node { display: grid; grid-template-columns: minmax(52px, auto) 1fr; gap: 9px; padding: 10px 0; }
.archive-history-node + .archive-history-node { border-top: 1px solid var(--archive-line); }
.archive-history-node .archive-prose, .archive-editorial .archive-prose { margin: 4px 0 0; }
.archive-editorial { padding: 10px 12px; }
.archive-jumps { display: flex; flex-wrap: wrap; gap: 0 10px; }

.archive-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 12px;
  padding: 12px;
}

.archive-metric { min-width: 0; }
.archive-entry-summary { border-top: 1px solid var(--archive-line); }
.archive-metric-value { margin-top: 2px; font-size: 15px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.archive-fact { display: grid; grid-template-columns: 75px 1fr; gap: 8px; padding: 7px 0; overflow-wrap: anywhere; }
.archive-fact > text { color: var(--archive-muted); font-size: 12px; }
.archive-fact > view { white-space: pre-line; }
.archive-lottery-year + .archive-lottery-year { margin-top: 8px; }
.archive-lottery-year .archive-menu-row { border-bottom: 1px solid var(--archive-line); border-radius: 0; }
.archive-guide-time { margin-bottom: 8px; }
.archive-guide { padding: 10px 12px; margin-bottom: 8px; }
.archive-guide .archive-prose { margin: 6px 0 0; }

.archive-map { overflow: hidden; margin-bottom: 8px; }
.archive-photo { display: block; width: 100%; }
.archive-map-footer { padding: 7px 10px; }

.archive-results { padding: 2px 12px; }
.archive-results-date { padding: 7px 0 0; }
.archive-result {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas: "athlete time" "group time";
  align-items: center;
  gap: 2px 8px;
  padding: 8px 0;
}

.archive-result + .archive-result { border-top: 1px solid var(--archive-line); }
.archive-result .archive-meta { grid-area: group; }
.archive-athlete { grid-area: athlete; font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.archive-result-time { grid-area: time; font-size: 22px; font-weight: 650; font-variant-numeric: tabular-nums; }

.archive-exhibit + .archive-exhibit { margin-top: 13px; }
.archive-exhibit-year { font-size: 16px; font-weight: 650; margin-bottom: 5px; }
.archive-exhibit-piece { padding: 9px; }
.archive-exhibit-piece + .archive-exhibit-piece { border-top: 1px solid var(--archive-line); }
.archive-gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; margin-top: 7px; }
.archive-gallery-grid.single { grid-template-columns: minmax(0, 1fr); }
.archive-gallery-item { min-width: 0; }
.archive-gallery-item > image { display: block; width: 100%; height: min(42vw, 250px); background: #f6f3f4; border-radius: 6px; }
.archive-gallery-grid.single image { height: min(62vw, 310px); }
.archive-photo-label { font-size: 13px; margin-top: 4px; }
.archive-piece-empty { padding: 12px 8px; }
.archive-page .archive-album { display: flex; width: 100%; gap: 10px; justify-content: space-between; padding: 8px; margin-bottom: 8px; text-align: left; }
.archive-album > image { flex: none; width: 66px; height: 66px; border-radius: 6px; background: var(--archive-bg); }
.archive-album > view { flex: 1; min-width: 0; }

.archive-page .archive-story {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 11px 12px;
  margin-bottom: 7px;
  text-align: left;
}

.archive-story-copy { flex: 1; min-width: 0; }
.archive-story-title { font-size: 17px; margin: 4px 0 3px; }
.archive-story-summary {
  color: #544c53;
  font-size: 13px;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: anywhere;
}

.archive-disclosures { background: #fff; border-radius: 11px; margin-top: 12px; overflow: hidden; }
.archive-disclosures .archive-disclosure { display: flex; width: 100%; justify-content: space-between; gap: 8px; padding: 7px 12px; background: transparent; text-align: left; }
.archive-disclosure + .archive-disclosure,
.archive-disclosure-body + .archive-disclosure { border-top: 1px solid var(--archive-line); border-radius: 0; }
.archive-disclosure-body { padding: 0 12px 8px; }
.archive-source { padding: 7px 0; }
.archive-source + .archive-source { border-top: 1px solid var(--archive-line); }
.archive-source-title { font-size: 13px; overflow-wrap: anywhere; }
.archive-support { margin-top: 16px; }
.archive-footer { margin-top: 10px; padding: 2px; }
.archive-state { padding: 36px 16px; text-align: center; }
.archive-page .archive-secondary { margin: 12px auto 2px; background: var(--archive-tint); color: var(--archive-accent); }
.archive-page .archive-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 3px; border: 0; background: transparent; color: var(--archive-muted); font-size: 13px; }

.archive-reader { position: fixed; inset: 0; z-index: 10; display: flex; flex-direction: column; background: #fff; }
.archive-reader-bar { display: flex; flex: none; padding-left: 13px; border-bottom: 1px solid var(--archive-line); }
.archive-reader-title { margin: 5px 0 16px; font-size: 24px; line-height: 1.35; }
.archive-reader-body { padding-top: 16px; }
.archive-reader-image { margin: 0 0 14px; }
.archive-paragraph { margin: 0 0 13px; font-size: 16px; line-height: 1.75; color: var(--archive-ink); }
.archive-reader-sources { padding-top: 12px; border-top: 1px solid var(--archive-line); }

@media (max-width: 350px) {
  .archive-body, .archive-reader-body { padding-right: 12px; padding-left: 12px; }
  .archive-tabs { padding-right: 8px; padding-left: 8px; }
  .archive-gallery-nav { gap: 4px; }
  .archive-gallery-nav > button { padding-right: 1px; padding-left: 1px; }
  .archive-result-time { font-size: 20px; }
}
