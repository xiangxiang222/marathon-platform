.archive-page{min-width:0;background:#f5f5f3;color:#222;font-size:14px;line-height:1.6}
.archive-intro{padding:12px 20px 20px;background:#fff}
.archive-topline{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
.archive-topline navigator{display:flex;align-items:center;min-height:36px;color:#e63245;font-size:13px}
.archive-kicker{display:block;font-size:12px;color:#898783;line-height:1.6}
.archive-hero{display:flex;align-items:center;justify-content:space-between;gap:12px}
.archive-hero-copy{flex:1;min-width:0}
.archive-landmark{flex:none;width:96px;height:80px}
.archive-title{margin:5px 0 7px;font-size:24px;line-height:1.4;font-weight:600;letter-spacing:-.5px}
.archive-lead{font-size:14px;color:#66635e;line-height:1.8}
.archive-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:20px;padding-top:16px;border-top:1px solid #f1efeb}
.archive-badges>text{max-width:100%;padding:3px 7px;border-radius:5px;background:#f6f5f2;color:#77736c;font-size:12px;line-height:1.7;word-break:break-all}
.archive-edition-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 20px;background:#fff;border-top:1px solid #eee}
.archive-edition-bar>view{display:flex;align-items:center;gap:10px}
.archive-edition-bar>view>text,.archive-edition-bar>text{font-size:12px;color:#777}
.archive-edition-bar>text{text-align:right}
.archive-select{min-height:44px;min-width:100px;padding:8px 10px;background:#fff;border:1px solid #e5e5e5;border-radius:8px;font-size:14px;line-height:26px}
.archive-tabs{position:sticky;top:0;z-index:10;display:flex;width:100%;height:50px;white-space:nowrap;background:#fff;border-bottom:1px solid #eee}
.archive-tab{display:inline-flex;position:relative;flex:none;min-height:48px;height:48px;padding:10px 16px;border:0;border-radius:0;background:transparent;color:#666;font-size:14px;line-height:28px;vertical-align:top}
.archive-tab.selected{color:#e63245;font-weight:600}
.archive-tab.selected::after{position:absolute;left:50%;bottom:0;width:20px;height:3px;margin-left:-10px;background:#e63245;border:0;border-radius:3px;content:''}
.archive-body{min-width:0;padding:16px}
.archive-panel{min-width:0;padding:20px;margin-bottom:12px;background:#fff;border-radius:16px}
.archive-h2{font-size:18px;margin-bottom:14px;font-weight:600;line-height:1.5}
.archive-h3{font-size:16px;margin-bottom:8px;line-height:1.6;font-weight:500}
.archive-prose{margin:12px 0;font-size:14px;line-height:1.9;white-space:pre-line;word-break:break-all}
.archive-caption{font-size:12px;color:#88847e;line-height:1.8;margin:12px 0;word-break:break-all}
.archive-fact{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #f0efeb;font-size:14px;line-height:1.8}
.archive-fact:last-child{border-bottom:0}
.archive-fact>text{flex:0 0 80px;color:#88847e}
.archive-fact>view{flex:1;min-width:0;white-space:pre-line;word-break:break-all}
.archive-editorial{padding:16px 0;border-top:1px solid #f0efeb}
.archive-editorial:last-child{padding-bottom:0}
.archive-return{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:12px;padding:12px 16px;margin-bottom:12px;background:#fff0f2;border-radius:12px}
.archive-return>view{min-width:0}
.archive-return>view>text{font-size:12px;color:#777}
.archive-return>view>view{font-size:14px;margin-top:4px}
.archive-return>text{font-size:24px;color:#e63245}
.archive-photo{display:block;width:100%;margin-top:16px;border-radius:8px}
.archive-image-credit{margin-top:8px;color:#88847e;font-size:12px;line-height:1.7;word-break:break-all}
.archive-external{display:flex;justify-content:flex-start;align-items:center;min-height:44px;padding:8px 0;border:0;border-radius:0;background:transparent;color:#e63245;font-size:14px;line-height:1.6;text-align:left;word-break:break-all}
.archive-route-endpoints{margin:16px 0 24px}
.archive-route-endpoint{display:flex;align-items:center;gap:12px;padding:14px;margin-bottom:8px;border-radius:10px;background:#f8f7f4}
.archive-point{display:flex;flex:none;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;font-size:12px;font-weight:600}
.archive-point.start{color:#e63245;background:#fce9eb}
.archive-point.finish{color:#76716a;background:#eae7e1}
.archive-route-endpoint>view{min-width:0}
.archive-route-endpoint>view>text{display:block;color:#88847e;font-size:11px;line-height:1.7}
.archive-route-endpoint>view>view{font-size:15px;line-height:1.7;word-break:break-all}
.archive-route-heading{font-size:15px;font-weight:500}
.archive-route-heading+.archive-caption{margin:4px 0 12px}
.archive-route-stage{display:flex;align-items:baseline;gap:14px;padding:11px 0;border-bottom:1px solid #f0efeb}
.archive-route-stage:last-child{border-bottom:0}
.archive-route-stage>text{flex:none;width:24px;color:#b2ada4;font-size:12px;font-variant-numeric:tabular-nums}
.archive-route-stage>view{flex:1;min-width:0;font-size:14px;line-height:1.8;word-break:break-all}
.archive-callout{margin:16px 0;padding:12px;background:#f8f7f4;border-radius:8px;font-size:14px;line-height:1.8}
.archive-table-scroll{display:block;width:100%;max-width:100%;margin-top:16px}
.archive-table{font-size:12px;line-height:1.7}
.archive-tr{display:flex;border-bottom:1px solid #eee}
.archive-tr>text{display:block;flex:none;min-width:0;padding:12px 10px;white-space:normal;word-break:break-all}
.archive-tr>text:first-child{width:70px}
.archive-tr>button{flex:0 0 70px;min-width:0;min-height:44px;padding:10px;border:0;border-radius:0;background:transparent;font-size:14px;color:#e63245}
.archive-thead{background:#f8f7f4;color:#777}
.archive-tr.current{background:#fff7f8}
.archive-result{display:flex;gap:12px;justify-content:space-between;align-items:center;padding:16px 0;border-top:1px solid #eee}
.archive-result>view{min-width:0}
.archive-result>view>text{display:block;font-size:12px;color:#777}
.archive-result>view>view{font-size:14px;margin:4px 0}
.archive-result>text{flex:none;font-size:20px;font-weight:500;font-variant-numeric:tabular-nums}
.archive-gear{padding:24px 0;border-top:1px solid #f0efeb}
.archive-gear:last-child{padding-bottom:0}
.archive-gear-heading{display:flex;align-items:center;gap:14px}
.archive-gear-order{flex:none;color:#bdb6aa;font-size:24px;font-weight:400;font-variant-numeric:tabular-nums;line-height:1.4}
.archive-gear-heading>view{flex:1;min-width:0}
.archive-gear-heading .archive-h3{margin:2px 0 0}
.archive-gear-items{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}
.archive-gear-pill{padding:5px 9px;border-radius:6px;background:#f7f5f0;color:#777064;font-size:12px;line-height:1.7;word-break:break-all}
.archive-related{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:10px 0;border-top:1px solid #eee}
.archive-related>view{min-width:0;font-size:14px}
.archive-related>view>text{display:block;margin-top:4px;font-size:12px;color:#777}
.archive-related>text{font-size:24px;color:#999}
.archive-updated{text-align:center}
.archive-state{padding:32px 16px;text-align:center;color:#777;font-size:14px}
.archive-secondary{min-height:44px;min-width:100px;margin:16px auto 0;padding:10px 16px;border:1px solid #e5e5e5;border-radius:8px;background:#fff;font-size:14px}
.archive-coverage-toggle{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:44px;margin:0;padding:0;border:0;border-radius:0;background:transparent;text-align:left;color:#88847e;font-size:12px;line-height:1.8}
.archive-coverage-toggle .archive-h3{margin:0 0 2px;color:#55514b;font-size:14px}
.archive-coverage-toggle>text{font-size:22px;font-weight:300}
.archive-coverage-detail{margin-top:12px;padding-top:12px;border-top:1px solid #f0efeb}
.archive-coverage-links{display:flex;flex-wrap:wrap;gap:4px 12px}
.archive-coverage-links button{display:flex;align-items:center;gap:8px;min-height:44px;margin:0;padding:0;border:0;background:transparent;color:#e63245;font-size:14px;line-height:1.6}
.archive-coverage .archive-caption{margin:8px 0 0}
@media(max-width:350px){.archive-intro{padding:12px 16px 16px}.archive-edition-bar{padding:12px 16px}.archive-edition-bar>view{gap:6px}.archive-select{min-width:94px}.archive-panel{padding:16px}.archive-fact>text{flex-basis:70px}.archive-fact{gap:10px}.archive-tab{padding-left:14px;padding-right:14px}.archive-title{font-size:23px}}
