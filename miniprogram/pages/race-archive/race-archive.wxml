<view class="archive-page">
  <view wx:if="{{message}}" class="archive-state"><view>{{message}}</view><button class="archive-secondary" bindtap="load">重新加载</button><navigator class="archive-external" url="/pages/race-catalog/race-catalog">返回赛事目录</navigator></view>
  <view wx:elif="{{loading}}" class="archive-state">正在加载年度档案…</view>
  <block wx:elif="{{race && archive}}">
    <view class="archive-intro">
      <view class="archive-topline"><text class="archive-kicker">赛事档案</text><navigator url="/pages/race-catalog/race-catalog">全部档案 ›</navigator></view>
      <view class="archive-hero"><view class="archive-hero-copy"><text class="archive-kicker">{{race.city}} · {{race.shortName}}</text><view class="archive-title">{{race.name}}</view><text class="archive-lead">{{race.tagline}}</text></view><image wx:if="{{landmarkSrc}}" class="archive-landmark" src="{{landmarkSrc}}" mode="aspectFit" /></view>
      <view class="archive-badges"><text>世界田联 {{waLabel}}</text><text>中国田协 {{caaLabel}}</text></view>
    </view>
    <view class="archive-edition-bar"><view><text>年度档案</text><picker range="{{years}}" value="{{yearIndex}}" bindchange="pickYear"><view class="archive-select">{{year}} 年 ⌄</view></picker></view><text>{{edition.date || '比赛日期待核验'}}</text></view>
    <scroll-view class="archive-tabs" scroll-x enable-flex show-scrollbar="{{false}}"><button wx:for="{{tabs}}" wx:key="id" class="archive-tab {{tab === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="pickTab" aria-label="{{item.label}}">{{item.label}}</button></scroll-view>
    <view class="archive-body">
      <navigator wx:if="{{fromRace}}" class="archive-return" url="/pages/race/race?id={{fromRace.id}}"><view><text>你正在了解这场报名赛事</text><view>{{fromRace.name}}</view></view><text>›</text></navigator>
      <view wx:if="{{!edition}}" class="archive-state">该年度资料尚未收录。</view>
      <block wx:else>
        <block wx:if="{{tab === 'overview'}}">
          <view wx:if="{{edition.logistics.tips.length}}" class="archive-panel"><view class="archive-h2">本届跑前提醒</view><view wx:for="{{edition.logistics.tips}}" wx:key="title" class="archive-editorial"><view class="archive-h3">{{item.title}}</view><view class="archive-prose">{{item.body}}</view></view></view>
          <view class="archive-panel"><view class="archive-h2">关于这场比赛</view><view class="archive-prose">{{archive.intro || race.summary || race.tagline}}</view><view class="archive-fact"><text>档案年份</text><view>{{year}} 年</view></view><view class="archive-fact"><text>比赛日期</text><view>{{edition.date || '待核验'}}</view></view><view class="archive-fact"><text>比赛项目</text><view>{{edition.distance || '待核验'}}</view></view></view>
          <view wx:if="{{archive.highlights.length}}" class="archive-panel"><view class="archive-h2">跑之前，先了解</view><view wx:for="{{archive.highlights}}" wx:key="title" class="archive-editorial"><view class="archive-h3">{{item.title}}</view><view class="archive-prose">{{item.body}}</view></view></view>
          <view wx:if="{{edition.notes.length}}" class="archive-panel"><view class="archive-h2">{{year}} 年资料说明</view><view wx:for="{{edition.notes}}" wx:key="*this" class="archive-prose">{{item}}</view></view>
          <view wx:if="{{edition.coverage}}" class="archive-panel archive-coverage">
            <button class="archive-coverage-toggle" bindtap="toggleCoverage" aria-expanded="{{coverageOpen}}"><view><view class="archive-h3">收录说明</view><text>{{year}} 年 · {{edition.coverage.available.length}} 类资料</text></view><text>{{coverageOpen ? '−' : '+'}}</text></button>
            <view wx:if="{{coverageOpen}}" class="archive-coverage-detail"><view class="archive-coverage-links"><button wx:for="{{edition.coverage.available}}" wx:key="id" data-id="{{item.id}}" bindtap="pickTab">{{item.label}} <text aria-hidden="true">›</text></button></view><view wx:if="{{edition.coverage.missing.length}}" class="archive-caption">待补充：{{edition.coverageText}}。</view><view wx:if="{{edition.upcoming}}" class="archive-caption">本届尚未举行，起跑、完赛人数及成绩待赛后收录。</view></view>
          </view>
        </block>
        <block wx:elif="{{tab === 'route'}}">
          <view class="archive-panel">
            <view class="archive-h2">{{year}} 年赛道</view>
            <view class="archive-route-endpoints"><view class="archive-route-endpoint"><text class="archive-point start">起</text><view><text>起点</text><view>{{edition.route.start || '待核验'}}</view></view></view><view class="archive-route-endpoint"><text class="archive-point finish">终</text><view><text>终点</text><view>{{edition.route.finish || '待核验'}}</view></view></view></view>
            <block wx:if="{{routeStages.length}}"><view class="archive-route-heading">沿途道路</view><view class="archive-caption">按比赛道路顺序整理，非导航地图</view><view class="archive-route-stages"><view wx:for="{{routeStages}}" wx:key="order" class="archive-route-stage"><text>{{item.order}}</text><view>{{item.name}}</view></view></view></block>
            <view wx:else class="archive-prose">{{edition.route.summary || '本届路线资料整理中。'}}</view>
            <block wx:if="{{edition.route.mapUrl && !edition.route.imageFailed}}"><image class="archive-photo" src="{{edition.route.mapUrl}}" mode="widthFix" data-url="{{edition.route.mapUrl}}" bindtap="previewImage" binderror="routeImageError" /><view wx:if="{{edition.route.imageCredit}}" class="archive-image-credit">{{edition.route.imageCredit}}</view><button class="archive-external" data-url="{{edition.route.mapUrl}}" bindtap="previewImage">查看路线大图</button></block>
          </view>
          <view wx:if="{{edition.route.changes || edition.route.analysis.length}}" class="archive-panel"><view class="archive-h2">路线变化与跑法参考</view><view wx:if="{{edition.route.changes}}" class="archive-prose">{{edition.route.changes}}</view><view wx:for="{{edition.route.analysis}}" wx:key="*this" class="archive-prose">{{item}}</view><view class="archive-caption">路线分析为编辑参考；比赛安排以本届组委会公告为准。</view></view>
        </block>
        <block wx:elif="{{tab === 'registration'}}"><view class="archive-panel"><view class="archive-h2">{{year}} 年报名与中签</view><view class="archive-prose">{{edition.registration.method || '报名方式待核验'}}</view><view wx:for="{{registrationFacts}}" wx:key="label" class="archive-fact"><text>{{item.label}}</text><view>{{item.value}}</view></view><view wx:if="{{edition.registration.lotteryNote}}" class="archive-callout">{{edition.registration.lotteryNote}}</view><view wx:if="{{edition.registration.note}}" class="archive-prose">{{edition.registration.note}}</view></view><view class="archive-panel"><view class="archive-h2">历年中签情况</view><view class="archive-caption">报名人数、抽签池与参赛规模口径不同。缺失数据不参与推算，中签率仅展示已核验公布值。</view><block wx:if="{{lotteryColumns.length}}"><scroll-view class="archive-table-scroll" scroll-x><view class="archive-table" style="width:{{lotteryTableWidth}}px"><view class="archive-tr archive-thead" style="width:{{lotteryTableWidth}}px"><text>年份</text><text wx:for="{{lotteryColumns}}" wx:key="key" style="width:{{item.width}}px">{{item.label}}</text></view><view wx:for="{{lotteryRows}}" wx:key="year" class="archive-tr {{year === item.year ? 'current' : ''}}" style="width:{{lotteryTableWidth}}px"><button data-year="{{item.year}}" bindtap="setYear">{{item.year}}</button><text wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key" style="width:{{cell.width}}px">{{cell.value}}</text></view></view></scroll-view><view class="archive-caption">左右滑动查看，选择年份查看对应口径说明。</view></block><view wx:else class="archive-caption">暂未收录历年公开统计</view></view></block>
        <block wx:elif="{{tab === 'logistics'}}"><view class="archive-panel"><view class="archive-h2">{{year}} 年参赛指南</view><view class="archive-caption">以下为这一届的领物与比赛日安排；历年交通管制、开放入口及服务不自动沿用到下一届。时间均为北京时间。</view><view wx:if="{{!logisticsSections.length}}" class="archive-prose">本届领物、交通与比赛日服务尚无已收录资料。</view></view><view wx:for="{{logisticsSections}}" wx:key="id" class="archive-panel"><view class="archive-h2">{{item.title}}</view><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="label" class="archive-fact"><text>{{field.label}}</text><view>{{field.value}}</view></view></view></block>
        <block wx:elif="{{tab === 'participation'}}"><view class="archive-panel"><view class="archive-h2">{{year}} 年参赛与完赛</view><view wx:for="{{participationFacts}}" wx:key="label" class="archive-fact"><text>{{item.label}}</text><view>{{item.value}}</view></view><view wx:if="{{edition.participation.note}}" class="archive-prose">{{edition.participation.note}}</view></view><view class="archive-panel"><view class="archive-h2">本届成绩</view><view wx:if="{{!edition.results.length}}" class="archive-prose">暂无本届已核验成绩。</view><view wx:for="{{edition.results}}" wx:key="index" class="archive-result"><view><text>{{item.group}}</text><view>{{item.athlete}}</view><text>{{item.timing || '计时口径待补充'}}</text></view><text>{{item.time}}</text></view></view></block>
        <block wx:elif="{{tab === 'gear'}}">
          <view class="archive-panel"><view class="archive-h2">{{year}} 年赛事物品</view><view class="archive-caption">把属于这一年的参赛包、完赛包、参赛服与奖牌，逐件留存。</view><view wx:if="{{!edition.gear.length}}" class="archive-prose">本届赛事物品资料整理中。</view>
            <view wx:for="{{edition.gear}}" wx:key="order" class="archive-gear"><view class="archive-gear-heading"><text class="archive-gear-order">{{item.order}}</text><view><text class="archive-kicker">{{item.category}}</text><view class="archive-h3">{{item.name || item.category}}</view></view></view><view class="archive-prose">{{item.description}}</view>
              <view wx:if="{{item.items.length}}" class="archive-gear-items"><text wx:for="{{item.items}}" wx:for-item="piece" wx:key="*this" class="archive-gear-pill">{{piece}}</text></view>
              <block wx:if="{{item.imageUrl && !item.imageFailed}}"><image class="archive-photo" src="{{item.imageUrl}}" mode="widthFix" data-url="{{item.imageUrl}}" data-index="{{index}}" bindtap="previewImage" binderror="gearImageError" /><view wx:if="{{item.imageCredit}}" class="archive-image-credit">{{item.imageCredit}}</view><button class="archive-external" data-url="{{item.imageUrl}}" bindtap="previewImage">查看物品大图</button></block>
            </view>
          </view>
        </block>
        <block wx:elif="{{tab === 'stories'}}"><view class="archive-panel"><view class="archive-h2">赛道之外的故事</view><view class="archive-caption">这里保留有公开出处的赛事掌故与城市记忆。</view><view wx:if="{{!archive.stories.length}}" class="archive-prose">赛事故事整理中。</view><view wx:for="{{archive.stories}}" wx:key="title" class="archive-editorial"><view class="archive-h3">{{item.title}}</view><view class="archive-prose">{{item.body}}</view></view></view></block>
      </block>
      <view wx:if="{{relatedRaces.length}}" class="archive-panel"><view class="archive-h2">单届赛事与报名信息</view><navigator wx:for="{{relatedRaces}}" wx:key="id" class="archive-related" url="/pages/race/race?id={{item.id}}"><view><view>{{item.name}}</view><text>{{item.raceDate}}</text></view><text>›</text></navigator></view>
      <view class="archive-caption archive-updated">资料更新 {{archive.updatedAt || '整理中'}} · 不同年份的资料分别记录</view>
    </view>
  </block>
</view>
