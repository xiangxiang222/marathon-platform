<view class="archive-page">
  <view wx:if="{{message}}" class="archive-state"><view>{{message}}</view><button class="archive-secondary" bindtap="load">重新加载</button><navigator class="archive-link" url="/pages/race-catalog/race-catalog">返回赛事目录</navigator></view>
  <view wx:elif="{{loading}}" class="archive-state">正在打开赛事专题…</view>
  <block wx:elif="{{race && archive}}">
    <view class="archive-hero">
      <image wx:if="{{heroUrl && !heroFailed}}" class="archive-cover" src="{{heroUrl}}" mode="aspectFill" binderror="heroError" />
      <view wx:else class="archive-cover-art"><view class="archive-orbit"></view><image wx:if="{{landmarkSrc}}" class="archive-landmark" src="{{landmarkSrc}}" mode="aspectFit" /></view>
      <view class="archive-shade"></view><navigator class="archive-directory" url="/pages/race-catalog/race-catalog">赛事目录 ↗</navigator>
      <view class="archive-hero-copy"><view class="archive-kicker light">{{race.city}} · {{race.shortName}}<text wx:if="{{foundingYear}}"> · 始于 {{foundingYear}}</text></view><view class="archive-title">{{race.name}}</view><view class="archive-lead">{{race.tagline}}</view><view class="archive-badges"><text wx:if="{{waLabel}}">世界田联 {{waLabel}}</text><text wx:if="{{caaLabel}}">中国田协 {{caaLabel}}</text></view></view>
    </view>
    <view class="archive-tabs"><button wx:for="{{tabs}}" wx:key="id" class="archive-tab {{tab === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="pickTab" aria-label="{{item.label}}">{{item.label}}</button></view>
    <view class="archive-body">
      <navigator wx:if="{{fromRace}}" class="archive-return" url="/pages/race/race?id={{fromRace.id}}"><view><text>返回报名赛事</text><view>{{fromRace.name}}</view></view><text>›</text></navigator>
      <block wx:if="{{tab === 'overview'}}">
        <view class="archive-kicker">ABOUT THE RACE</view><view class="archive-h2">走进{{race.shortName}}</view><view class="archive-intro">{{archive.intro || race.summary || race.tagline}}</view>
        <view class="archive-identity"><view wx:if="{{foundingYear}}"><view>{{foundingYear}}</view><text>创办年份</text></view><view><view>{{race.city}}</view><text>举办城市</text></view><view><view>42.195</view><text>公里 · 全程马拉松</text></view></view>
        <view class="archive-section archive-feature" data-id="route" bindtap="pickTab"><view class="archive-kicker light">THE COURSE</view><view class="archive-feature-title"><view>沿着赛道，</view><view>读一座城市。</view></view><view wx:if="{{latestEdition.route}}" class="archive-feature-copy"><view>{{latestEdition.route.start}}</view><view>至 {{latestEdition.route.finish}}</view></view><view class="archive-feature-bottom"><text>查看赛道与历年变化</text><text>↗</text></view><text class="archive-distance">42.195</text></view>
        <view wx:if="{{latestEdition}}" class="archive-latest"><view><view>{{latestEdition.year}} 年赛事记录</view><text>{{latestEdition.distance}}</text></view><text>{{latestEdition.date}}</text></view>
        <view wx:if="{{archive.highlights.length}}" class="archive-section"><view class="archive-kicker">RACE NOTES</view><view class="archive-h2">这场比赛的独特之处</view><view wx:for="{{archive.highlights}}" wx:key="title" class="archive-editorial"><view class="archive-h3">{{item.title}}</view><view class="archive-prose">{{item.body}}</view></view></view>
        <view class="archive-section"><view class="archive-section-head"><view><view class="archive-kicker">COLLECTION</view><view class="archive-h2">一届一份纪念</view></view><button class="archive-link" data-id="gallery" bindtap="pickTab">打开图鉴 ↗</button></view><view class="archive-collection-shortcuts"><button data-id="参赛服" bindtap="openGallery"><text>01</text><view>参赛服</view><text>历年设计</text></button><button data-id="奖牌" bindtap="openGallery"><text>02</text><view>奖牌</view><text>完赛记忆</text></button><button data-id="官方图集" bindtap="openGallery"><text>03</text><view>赛事影像</view><text>年度相册</text></button></view></view>
        <view wx:if="{{stories.length}}" class="archive-section"><view class="archive-section-head"><view><view class="archive-kicker">BEYOND THE FINISH</view><view class="archive-h2">赛道之外</view></view><button class="archive-link" data-id="updates" bindtap="pickTab">更多故事 ↗</button></view><view class="archive-editorial" data-type="stories" data-id="{{stories[0].id}}" bindtap="openArticle"><view class="archive-h3">{{stories[0].title}}</view><view class="archive-prose">{{stories[0].summary || stories[0].body}}</view></view></view>
      </block>
      <block wx:elif="{{tab === 'entry'}}">
        <view class="archive-section-head"><view><view class="archive-kicker">BEFORE THE START</view><view class="archive-h2">准备出发</view></view><picker wx:if="{{years.length}}" range="{{years}}" value="{{entryIndex}}" data-scope="entry" bindchange="pickYear"><view class="archive-select">{{entryYear}} 年 ⌄</view></picker></view>
        <view class="archive-subnav"><button class="{{entrySection === 'registration' ? 'on' : ''}}" data-id="registration" bindtap="pickEntrySection">报名中签</button><button class="{{entrySection === 'guide' ? 'on' : ''}}" data-id="guide" bindtap="pickEntrySection">参赛指南</button></view>
        <block wx:if="{{entryEdition && entrySection === 'registration'}}"><view class="archive-prose">{{entryEdition.registration.method}}</view><view wx:for="{{entryFacts}}" wx:key="label" class="archive-fact"><text>{{item.label}}</text><view>{{item.value}}</view></view><view wx:if="{{entryEdition.registration.lotteryNote}}" class="archive-callout">{{entryEdition.registration.lotteryNote}}</view><view wx:if="{{entryEdition.registration.note}}" class="archive-prose">{{entryEdition.registration.note}}</view>
          <view class="archive-section"><view class="archive-h3">历年报名与中签</view><view class="archive-caption">报名人数、参赛规模与抽签池分别记录，中签率不据此推算。</view><scroll-view wx:if="{{lotteryColumns.length}}" class="archive-table-scroll" scroll-x><view style="width:{{lotteryWidth}}px"><view class="archive-tr archive-thead"><text class="archive-year-cell">年份</text><text wx:for="{{lotteryColumns}}" wx:key="key">{{item.label}}</text></view><view wx:for="{{lotteryRows}}" wx:key="year" class="archive-tr {{entryYear === item.year ? 'current' : ''}}"><button class="archive-year-cell" data-year="{{item.year}}" bindtap="setEntryYear">{{item.year}}</button><text wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key">{{cell.value}}</text></view></view></scroll-view><view wx:else class="archive-caption">历年统计尚未收录。</view></view>
        </block>
        <block wx:elif="{{entryEdition && entrySection === 'guide'}}"><view class="archive-caption">{{entryYear}} 年的领物、交通与比赛日安排，时间均为北京时间。</view><view wx:for="{{guideSections}}" wx:key="id" class="archive-section"><view class="archive-h3">{{item.title}}</view><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="label" class="archive-fact"><text>{{field.label}}</text><view>{{field.value}}</view></view></view><view wx:if="{{!guideSections.length}}" class="archive-empty">本年度参赛指南尚未收录。</view></block>
        <view wx:else class="archive-empty">参赛资料尚未收录。</view>
      </block>
      <block wx:elif="{{tab === 'route'}}">
        <view class="archive-section-head"><view><view class="archive-kicker">THE COURSE</view><view class="archive-h2">赛道与城市</view></view><picker wx:if="{{years.length}}" range="{{years}}" value="{{routeIndex}}" data-scope="route" bindchange="pickYear"><view class="archive-select">{{routeYear}} 年 ⌄</view></picker></view>
        <scroll-view wx:if="{{routeVersions.length}}" scroll-x class="archive-version-scroll"><view class="archive-version-list"><button wx:for="{{routeVersions}}" wx:key="id" data-id="{{item.id}}" bindtap="pickVersion" class="archive-version {{item.selected ? 'on' : ''}}"><view>{{item.title}}</view><text>{{item.yearsLabel}}<text wx:if="{{item.match === 'similar'}}"> · 相近路线</text></text></button></view></scroll-view>
        <block wx:if="{{routeEdition}}"><view wx:if="{{routeVersionNote}}" class="archive-caption">{{routeVersionNote}}</view><view class="archive-route-visual"><view class="archive-kicker">{{routeYear}} · 道路顺序</view><view wx:for="{{routeStages}}" wx:key="order" class="archive-route-stage"><text>{{item.order}}</text><view>{{item.name}}</view></view><view class="archive-caption">按比赛道路顺序整理，非导航地图。</view></view><view wx:if="{{routeImages.length}}" class="archive-section"><image wx:for="{{routeImages}}" wx:key="url" class="archive-photo" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" data-images="{{routeImages}}" bindtap="previewImage" /><view wx:for="{{routeImages}}" wx:key="url" class="archive-image-credit">{{item.caption}} {{item.credit}}</view></view><view wx:if="{{routeEdition.route.changes}}" class="archive-section"><view class="archive-h3">这一版的变化</view><view class="archive-prose">{{routeEdition.route.changes}}</view></view><view wx:if="{{routeEdition.route.analysis.length}}" class="archive-section"><view class="archive-h3">跑法参考</view><view wx:for="{{routeEdition.route.analysis}}" wx:key="*this" class="archive-prose">{{item}}</view></view></block><view wx:else class="archive-empty">赛道资料尚未收录。</view>
      </block>
      <block wx:elif="{{tab === 'results'}}">
        <view class="archive-section-head"><view><view class="archive-kicker">AT THE FINISH</view><view class="archive-h2">冲线的时刻</view></view><picker wx:if="{{years.length}}" range="{{years}}" value="{{resultsIndex}}" data-scope="results" bindchange="pickYear"><view class="archive-select">{{resultsYear}} 年 ⌄</view></picker></view>
        <block wx:if="{{resultsEdition}}"><view class="archive-caption">{{resultsYear}} 年冠军成绩 · {{resultsEdition.date}}</view><view wx:if="{{resultsEdition.results.length}}" class="archive-champions"><view wx:for="{{resultsEdition.results}}" wx:key="key" class="archive-champion"><text class="archive-result-group">{{item.group}}</text><view class="archive-result-time">{{item.time}}</view><view class="archive-athlete">{{item.athlete}}</view><text class="archive-image-credit">{{item.timing}}</text></view></view><view wx:else class="archive-empty">本年度成绩待赛后收录。</view><view class="archive-section"><view class="archive-h3">参赛与完赛</view><view wx:for="{{resultFacts}}" wx:key="label" class="archive-fact"><text>{{item.label}}</text><view>{{item.value}}</view></view><view wx:if="{{resultsEdition.participation.note}}" class="archive-caption">{{resultsEdition.participation.note}}</view></view></block><view wx:else class="archive-empty">成绩资料尚未收录。</view>
      </block>
      <block wx:elif="{{tab === 'gallery'}}">
        <view class="archive-kicker">THE RACE COLLECTION</view><view class="archive-h2">把记忆，留在这一件</view><scroll-view scroll-x class="archive-subnav-scroll"><view class="archive-subnav"><button wx:for="{{galleryTypes}}" wx:key="*this" class="{{galleryType === item ? 'on' : ''}}" data-id="{{item}}" bindtap="pickGallery">{{item}}</button></view></scroll-view>
        <block wx:if="{{galleryType !== '官方图集'}}"><view wx:for="{{galleryGroups}}" wx:for-item="group" wx:key="year" class="archive-collection-year"><view class="archive-collection-heading"><text>{{group.year}}</text><view>{{galleryType}}</view></view><view wx:for="{{group.items}}" wx:for-item="piece" wx:key="id"><scroll-view wx:if="{{piece.images.length}}" scroll-x class="archive-gallery-scroll"><view class="archive-gallery-strip"><view wx:for="{{piece.images}}" wx:for-item="photo" wx:key="url" class="archive-gallery-item"><image src="{{photo.url}}" mode="aspectFit" data-url="{{photo.url}}" data-images="{{piece.images}}" bindtap="previewImage" /><view wx:if="{{photo.caption || photo.credit}}" class="archive-image-credit">{{photo.caption}} {{photo.credit}}</view></view></view></scroll-view><view class="archive-h3">{{piece.name || galleryType}}</view><view wx:if="{{piece.description}}" class="archive-prose">{{piece.description}}</view><view wx:if="{{piece.items.length}}" class="archive-pills"><text wx:for="{{piece.items}}" wx:for-item="label" wx:key="*this">{{label}}</text></view></view></view><view wx:if="{{!galleryGroups.length}}" class="archive-empty">{{galleryType}}资料尚未收录。</view></block>
        <block wx:else><view wx:if="{{!albums.length}}" class="archive-empty"><view class="archive-h3">留住赛道上的每一刻</view><view>赛事影像正在整理中，收录后会按年份成册。</view></view><view wx:for="{{albums}}" wx:key="id" class="archive-album" data-id="{{item.id}}" bindtap="previewAlbum"><image src="{{item.media[0].url}}" mode="aspectFill" /><view><view class="archive-h3">{{item.title || item.year + ' 年赛事影像'}}</view><text>{{item.year}} · {{item.media.length}} 张照片</text></view><text>↗</text></view></block>
      </block>
      <block wx:elif="{{tab === 'updates'}}">
        <view class="archive-kicker">BEYOND THE RACE</view><view class="archive-h2">{{race.shortName}}，不止 42 公里</view><view class="archive-subnav"><button class="{{updateType === 'stories' ? 'on' : ''}}" data-id="stories" bindtap="pickUpdateType">{{race.shortName}}新鲜事</button><button class="{{updateType === 'news' ? 'on' : ''}}" data-id="news" bindtap="pickUpdateType">相关新闻</button></view>
        <block wx:if="{{updateType === 'stories'}}"><view wx:for="{{stories}}" wx:key="id" class="archive-story" data-type="stories" data-id="{{item.id}}" bindtap="openArticle"><image wx:if="{{item.images.length}}" class="archive-story-image" src="{{item.images[0].url}}" mode="aspectFill" /><view class="archive-story-label">{{item.editionYear || item.publishedAt || '赛事故事'}} <text wx:if="{{item.tag}}"> · {{item.tag}}</text></view><view class="archive-h3">{{item.title}}</view><view class="archive-prose">{{item.summary || item.body}}</view><view class="archive-link">展开阅读 ↗</view></view><view wx:if="{{!stories.length}}" class="archive-empty">赛事故事正在整理中。</view></block>
        <block wx:else><view wx:for="{{news}}" wx:key="id" class="archive-news" data-type="news" data-id="{{item.id}}" bindtap="openArticle"><view class="archive-news-date">{{item.publishedAt || item.editionYear || '赛事消息'}}</view><view><view wx:if="{{item.tag}}" class="archive-story-label">{{item.tag}}</view><view class="archive-h3">{{item.title}}</view><view wx:if="{{item.summary}}" class="archive-prose">{{item.summary}}</view></view></view><view wx:if="{{!news.length}}" class="archive-empty">相关新闻尚未发布。</view></block>
      </block>
      <view class="archive-footer"><view>把一场比赛，慢慢读懂。</view><text>资料更新 {{archive.updatedAt || '整理中'}}</text></view>
    </view>
  </block>
  <view wx:if="{{activeArticle}}" class="archive-reader-mask" bindtap="closeArticle"><view class="archive-reader" catchtap="stopTap"><button class="archive-reader-close" bindtap="closeArticle" aria-label="关闭内容">×</button><scroll-view scroll-y class="archive-reader-scroll"><view class="archive-kicker">{{activeArticle.publishedAt || activeArticle.editionYear || '赛事故事'}}</view><view class="archive-h2">{{activeArticle.title}}</view><image wx:for="{{activeArticle.images}}" wx:key="url" class="archive-photo" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" data-images="{{activeArticle.images}}" bindtap="previewImage" /><view class="archive-prose">{{activeArticle.body || activeArticle.summary}}</view></scroll-view></view></view>
</view>
