<view class="archive-page">
  <view wx:if="{{message}}" class="archive-state"><view>{{message}}</view><button class="archive-secondary" bindtap="load">重新加载</button><navigator class="archive-external" url="/pages/race-catalog/race-catalog">返回赛事目录</navigator></view>
  <view wx:elif="{{loading}}" class="archive-state">正在加载年度档案…</view>
  <block wx:elif="{{race && archive}}">
    <view class="archive-intro"><view class="archive-topline"><text class="archive-kicker">{{race.city}} · {{race.shortName}}</text><navigator url="/pages/race-catalog/race-catalog">全部档案 ›</navigator></view><view class="archive-title">{{race.name}}</view><text class="archive-lead">{{race.tagline}}</text><view class="archive-badges"><text>世界田联 {{waLabel}}</text><text>中国田协 {{caaLabel}}</text></view></view>
    <view class="archive-edition-bar"><view><text>年度档案</text><picker range="{{years}}" value="{{yearIndex}}" bindchange="pickYear"><view class="archive-select">{{year}} 年 ⌄</view></picker></view><text>{{edition.date || '比赛日期待核验'}}</text></view>
    <scroll-view class="archive-tabs" scroll-x enable-flex show-scrollbar="{{false}}"><button wx:for="{{tabs}}" wx:key="id" class="archive-tab {{tab === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="pickTab" aria-label="{{item.label}}">{{item.label}}</button></scroll-view>
    <view class="archive-body">
      <navigator wx:if="{{fromRace}}" class="archive-return" url="/pages/race/race?id={{fromRace.id}}"><view><text>你正在了解这场报名赛事</text><view>{{fromRace.name}}</view></view><text>›</text></navigator>
      <view wx:if="{{!edition}}" class="archive-state">该年度资料尚未收录。</view>
      <block wx:else>
        <block wx:if="{{tab === 'overview'}}"><view class="archive-panel"><view class="archive-h2">关于这场比赛</view><view class="archive-prose">{{archive.intro || race.summary || race.tagline}}</view><view class="archive-fact"><text>档案年份</text><view>{{year}} 年</view></view><view class="archive-fact"><text>比赛日期</text><view>{{edition.date || '待核验'}}</view></view><view class="archive-fact"><text>比赛项目</text><view>{{edition.distance || '待核验'}}</view></view></view><view wx:if="{{archive.highlights.length}}" class="archive-panel"><view class="archive-h2">跑之前，先了解</view><view wx:for="{{archive.highlights}}" wx:key="title" class="archive-editorial"><view class="archive-h3">{{item.title}}</view><view class="archive-prose">{{item.body}}</view></view></view><view wx:if="{{edition.notes.length}}" class="archive-panel"><view class="archive-h2">{{year}} 年资料说明</view><view wx:for="{{edition.notes}}" wx:key="*this" class="archive-prose">{{item}}</view></view></block>
        <block wx:elif="{{tab === 'route'}}"><view class="archive-panel"><view class="archive-h2">{{year}} 年赛道</view><view class="archive-prose">{{edition.route.summary || '本届路线尚无已核验资料，取得本届可靠资料后补充。'}}</view><view class="archive-fact"><text>起点</text><view>{{edition.route.start || '待核验'}}</view></view><view class="archive-fact"><text>终点</text><view>{{edition.route.finish || '待核验'}}</view></view><block wx:if="{{edition.route.mapUrl && !edition.route.imageFailed}}"><image class="archive-photo" src="{{edition.route.mapUrl}}" mode="widthFix" data-url="{{edition.route.mapUrl}}" bindtap="previewImage" binderror="routeImageError" /><button class="archive-external" data-url="{{edition.route.mapUrl}}" bindtap="previewImage">查看路线大图</button></block><view wx:else class="archive-caption">{{edition.route.imageFailed ? '路线图暂时无法显示，可查看官方原文。' : '尚未收录本届官方路线图。'}}</view><button wx:if="{{edition.route.mapSourceUrl}}" class="archive-external" data-url="{{edition.route.mapSourceUrl}}" bindtap="copyUrl">复制路线官方原文链接</button></view><view wx:if="{{edition.route.changes || edition.route.analysis.length}}" class="archive-panel"><view class="archive-h2">路线变化与跑法参考</view><view wx:if="{{edition.route.changes}}" class="archive-prose">{{edition.route.changes}}</view><view wx:for="{{edition.route.analysis}}" wx:key="*this" class="archive-prose">{{item}}</view><view class="archive-caption">路线分析为编辑参考；交通与赛道安排以本届组委会公告为准。</view></view></block>
        <block wx:elif="{{tab === 'registration'}}"><view class="archive-panel"><view class="archive-h2">{{year}} 年报名与中签</view><view class="archive-prose">{{edition.registration.method || '报名方式待核验'}}</view><view wx:for="{{registrationFacts}}" wx:key="label" class="archive-fact"><text>{{item.label}}</text><view>{{item.value}}</view></view><view wx:if="{{edition.registration.lotteryNote}}" class="archive-callout">{{edition.registration.lotteryNote}}</view><view wx:if="{{edition.registration.note}}" class="archive-prose">{{edition.registration.note}}</view></view><view class="archive-panel"><view class="archive-h2">历年中签情况</view><view class="archive-caption">报名人数、抽签池与参赛规模口径不同。缺失数据不参与推算，中签率仅展示已核验公布值。</view><scroll-view class="archive-table-scroll" scroll-x><view class="archive-table"><view class="archive-tr archive-thead"><text>年份</text><text>报名人数</text><text>有效报名</text><text>抽签人数</text><text>抽签名额</text><text>直通名额</text><text>公布中签率</text></view><view wx:for="{{lotteryRows}}" wx:key="year" class="archive-tr {{year === item.year ? 'current' : ''}}"><button data-year="{{item.year}}" bindtap="setYear">{{item.year}}</button><text>{{item.applicants}}</text><text>{{item.eligible}}</text><text>{{item.pool}}</text><text>{{item.quota}}</text><text>{{item.direct}}</text><text>{{item.rate}}</text></view></view></scroll-view><view class="archive-caption">左右滑动查看，选择年份查看口径说明与来源。</view></view></block>
        <block wx:elif="{{tab === 'participation'}}"><view class="archive-panel"><view class="archive-h2">{{year}} 年参赛与完赛</view><view wx:for="{{participationFacts}}" wx:key="label" class="archive-fact"><text>{{item.label}}</text><view>{{item.value}}</view></view><view wx:if="{{edition.participation.note}}" class="archive-prose">{{edition.participation.note}}</view></view><view class="archive-panel"><view class="archive-h2">本届成绩</view><view wx:if="{{!edition.results.length}}" class="archive-prose">暂无本届已核验成绩。</view><view wx:for="{{edition.results}}" wx:key="index" class="archive-result"><view><text>{{item.group}}</text><view>{{item.athlete}}</view><text>{{item.timing || '计时口径见来源'}}</text></view><text>{{item.time}}</text></view></view></block>
        <block wx:elif="{{tab === 'gear'}}"><view class="archive-panel"><view class="archive-h2">{{year}} 年赛事物品</view><view class="archive-caption">按本届官方资料记录参赛包、完赛包、服装与奖牌；仅展示已收录的图片和清单。</view><view wx:if="{{!edition.gear.length}}" class="archive-prose">本届赛事物品资料尚未核验收录。</view><view wx:for="{{edition.gear}}" wx:key="index" class="archive-gear"><text class="archive-kicker">{{item.category}}</text><view class="archive-h3">{{item.name || item.category}}</view><view class="archive-prose">{{item.description}}</view><block wx:if="{{item.imageUrl && !item.imageFailed}}"><image class="archive-photo" src="{{item.imageUrl}}" mode="widthFix" data-url="{{item.imageUrl}}" data-index="{{index}}" bindtap="previewImage" binderror="gearImageError" /><button class="archive-external" data-url="{{item.imageUrl}}" bindtap="previewImage">查看物品大图</button></block><view wx:if="{{item.imageFailed}}" class="archive-caption">图片暂时无法显示，可查看物品原文。</view><view wx:for="{{item.items}}" wx:for-item="piece" wx:key="*this" class="archive-item">• {{piece}}</view><button wx:if="{{item.sourceUrl}}" class="archive-external" data-url="{{item.sourceUrl}}" bindtap="copyUrl">复制物品原文链接</button></view></view></block>
        <block wx:elif="{{tab === 'stories'}}"><view class="archive-panel"><view class="archive-h2">赛道之外的故事</view><view class="archive-caption">这里保留有公开出处的赛事掌故与城市记忆。</view><view wx:if="{{!archive.stories.length}}" class="archive-prose">赛事故事整理中。</view><view wx:for="{{archive.stories}}" wx:key="title" class="archive-editorial"><view class="archive-h3">{{item.title}}</view><view class="archive-prose">{{item.body}}</view></view></view></block>
      </block>
      <view wx:if="{{activeSources.length}}" class="archive-panel"><view class="archive-h2">本栏资料来源</view><view wx:for="{{activeSources}}" wx:key="id" class="archive-source"><view>{{item.title}}</view><text>{{item.publisher}}{{item.publishedAt ? ' · ' + item.publishedAt : ''}}</text><button wx:if="{{item.canCopy}}" class="archive-external" data-url="{{item.url}}" bindtap="copyUrl">复制原文链接</button></view></view>
      <view wx:if="{{relatedRaces.length}}" class="archive-panel"><view class="archive-h2">单届赛事与报名信息</view><navigator wx:for="{{relatedRaces}}" wx:key="id" class="archive-related" url="/pages/race/race?id={{item.id}}"><view><view>{{item.name}}</view><text>{{item.raceDate}}</text></view><text>›</text></navigator></view>
      <view class="archive-caption archive-updated">资料更新 {{archive.updatedAt || '整理中'}} · 不同年份的资料分别记录</view>
    </view>
  </block>
</view>
