<template name="metric-grid">
  <view class="archive-metrics">
    <view wx:for="{{cells}}" wx:key="label" class="archive-metric">
      <view class="archive-meta">{{item.label}}</view>
      <view class="archive-metric-value">{{item.value}}</view>
    </view>
  </view>
</template>

<template name="fact-list">
  <view wx:for="{{facts}}" wx:key="label" class="archive-fact">
    <text>{{item.label}}</text>
    <view>{{item.value}}</view>
  </view>
</template>

<template name="source-list">
  <view wx:for="{{sources}}" wx:key="id" class="archive-source">
    <view class="archive-source-title">{{item.title}}</view>
    <view class="archive-meta">{{item.publisher}}<text wx:if="{{item.publishedAt}}"> · {{item.publishedAt}}</text></view>
    <view wx:if="{{showChecks && (item.yearsLabel || item.checkedAt)}}" class="archive-meta">
      <text wx:if="{{item.yearsLabel}}">{{item.yearsLabel}}</text><text wx:if="{{item.checkedAt}}"> · 核验 {{item.checkedAt}}</text>
    </view>
  </view>
</template>

<view class="archive-page">
  <view wx:if="{{message}}" class="archive-state">
    <view>{{message}}</view>
    <button class="archive-secondary" bindtap="load">重新加载</button>
    <navigator class="archive-link" url="/pages/race-catalog/race-catalog">返回赛事目录</navigator>
  </view>
  <view wx:elif="{{loading}}" class="archive-state">正在打开赛事专题…</view>
  <block wx:elif="{{race && archive}}">
    <view class="archive-tabs" aria-hidden="{{!!activeArticle}}">
      <button wx:for="{{tabs}}" wx:key="id" class="archive-tab {{tab === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}" bindtap="pickTab" aria-current="{{tab === item.id ? 'page' : 'false'}}">{{item.label}}</button>
    </view>
    <scroll-view scroll-y class="archive-scroll" scroll-into-view="{{scrollTarget}}" aria-hidden="{{!!activeArticle}}">
      <view id="archive-top-a"></view>
      <view id="archive-top-b"></view>
      <view wx:if="{{tab === 'overview'}}" class="archive-hero">
        <image wx:if="{{heroUrl && !heroFailed}}" class="archive-cover" src="{{heroUrl}}" mode="aspectFill" binderror="heroError" />
        <image wx:elif="{{landmarkSrc}}" class="archive-landmark" src="{{landmarkSrc}}" mode="aspectFit" />
        <view class="archive-hero-copy">
          <view wx:if="{{foundingYear}}" class="archive-hero-meta">始于 {{foundingYear}}</view>
          <view class="archive-title">{{race.name}}</view>
          <view class="archive-hero-badges">
            <text wx:if="{{waLabel}}">世界田联 {{waLabel}}</text>
            <text wx:if="{{caaLabel}}">中国田协 {{caaLabel}}</text>
          </view>
        </view>
        <navigator class="archive-directory" url="{{directoryUrl}}">赛事目录 <text>›</text></navigator>
      </view>
      <view class="archive-body">
        <block wx:if="{{tab === 'overview'}}">
          <navigator wx:if="{{fromRace}}" class="archive-row archive-surface archive-return" url="/pages/race/race?id={{fromRace.id}}">
            <view><view class="archive-meta">返回对应赛事</view><view>{{fromRace.name}}</view></view><text class="archive-chevron">›</text>
          </navigator>
          <view class="archive-prose archive-intro">{{archive.intro || race.summary || race.tagline}}</view>
          <view wx:if="{{archive.positioning}}" class="archive-prose">{{archive.positioning}}</view>
          <view wx:if="{{latestEdition}}" class="archive-surface archive-overview-edition">
            <view class="archive-row archive-edition-title"><text>{{latestEdition.year}} 年赛事</text><text class="archive-meta">{{latestEdition.date}}</text></view>
            <button class="archive-row archive-menu-row" data-id="route" data-year="{{latestEdition.year}}" bindtap="openEdition">
              <view>赛道图<view wx:if="{{latestEdition.route.start && latestEdition.route.finish}}" class="archive-meta">{{latestEdition.route.start}}至{{latestEdition.route.finish}}</view></view><text class="archive-chevron">›</text>
            </button>
            <button class="archive-row archive-menu-row" data-id="shirt" data-year="{{latestEdition.year}}" bindtap="openEdition"><view>奖牌与参赛服</view><text class="archive-chevron">›</text></button>
            <button class="archive-row archive-menu-row" data-id="stories" data-year="{{latestEdition.year}}" bindtap="openEdition"><view>赛事动态</view><text class="archive-chevron">›</text></button>
          </view>
          <view wx:if="{{history.length}}" class="archive-section">
            <view class="archive-h3">赛事足迹</view>
            <view class="archive-surface archive-history">
              <view wx:for="{{visibleHistory}}" wx:key="index" class="archive-history-node">
                <text class="archive-meta">{{item.date || item.year}}</text>
                <view><view class="archive-item-title">{{item.title}}</view><view class="archive-prose">{{item.body}}</view></view>
              </view>
              <button wx:if="{{history.length > 5}}" class="archive-link" bindtap="toggleHistory" aria-expanded="{{historyExpanded}}">
                {{historyExpanded ? '收起历史' : '展开其余历史节点'}}
              </button>
            </view>
          </view>
          <view wx:if="{{overviewHighlights.length}}" class="archive-section">
            <view class="archive-h3">赛事特点</view>
            <view class="archive-surface">
              <view wx:for="{{overviewHighlights}}" wx:key="title" class="archive-editorial">
                <view class="archive-item-title">{{item.title}}</view><view class="archive-prose">{{item.body}}</view>
              </view>
            </view>
          </view>
          <view wx:if="{{annualCoverage.length}}" class="archive-disclosures">
            <button class="archive-disclosure" bindtap="toggleAnnual" aria-expanded="{{annualExpanded}}">
              <text>逐届资料与缺项</text><text class="archive-meta">{{annualExpanded ? '收起' : '展开'}}</text>
            </button>
            <view wx:if="{{annualExpanded}}" class="archive-disclosure-body">
              <view wx:for="{{annualCoverage}}" wx:for-item="edition" wx:key="year" class="archive-source">
                <view class="archive-item-title">{{edition.year}} 年<text wx:if="{{edition.status}}"> · {{edition.status}}</text></view>
                <view class="archive-jumps">
                  <button wx:for="{{edition.available}}" wx:for-item="section" wx:key="id" class="archive-link"
                    data-id="{{section.id}}" data-year="{{edition.year}}" bindtap="openEdition">{{section.label}}</button>
                </view>
                <view wx:if="{{edition.missing}}" class="archive-meta">待核实 · {{edition.missing}}</view>
              </view>
            </view>
          </view>
        </block>

        <block wx:elif="{{tab === 'entry'}}">
          <view class="archive-section-head">
            <view class="archive-h2">参赛安排</view>
            <picker wx:if="{{years.length}}" range="{{years}}" value="{{entryIndex}}" data-scope="entry" bindchange="pickYear">
              <view class="archive-select">{{entryYear}} 年<text class="archive-caret"></text></view>
            </picker>
          </view>
          <view wx:if="{{entryEdition}}" class="archive-subnav">
            <button class="{{entrySection === 'registration' ? 'on' : ''}}" data-id="registration" bindtap="pickEntrySection">报名与中签</button>
            <button class="{{entrySection === 'guide' ? 'on' : ''}}" data-id="guide" bindtap="pickEntrySection">参赛指南</button>
          </view>
          <block wx:if="{{entryEdition && entrySection === 'registration'}}">
            <view wx:if="{{entryMetrics.length || entrySummary.length}}" class="archive-surface">
              <template wx:if="{{entryMetrics.length}}" is="metric-grid" data="{{cells: entryMetrics}}" />
              <view wx:if="{{entrySummary.length}}" class="{{entryMetrics.length ? 'archive-entry-summary' : ''}}">
                <template is="metric-grid" data="{{cells: entrySummary}}" />
              </view>
            </view>
            <view wx:else class="archive-empty">本届报名与中签统计尚未收录</view>
            <view wx:if="{{entryFacts.length || entryEvents.length || entryEdition.registration.method || entryEdition.registration.lotteryNote || entryEdition.registration.note}}" class="archive-disclosures">
              <button class="archive-disclosure" bindtap="toggleRegistration" aria-expanded="{{registrationExpanded}}">
              <text>报名规则与数据说明</text><text class="archive-meta">{{registrationExpanded ? '收起' : '展开'}}</text>
              </button>
              <view wx:if="{{registrationExpanded}}" class="archive-disclosure-body">
                <view wx:if="{{entryStatus}}" class="archive-meta">{{entryYear}} 年 · {{entryStatus}}</view>
                <view wx:if="{{entryEdition.registration.method}}" class="archive-prose">{{entryEdition.registration.method}}</view>
                <template is="fact-list" data="{{facts: entryFacts}}" />
                <view wx:for="{{entryEvents}}" wx:key="index" class="archive-fact">
                  <text>{{item.project}}<text wx:if="{{item.distanceKm}}"> · {{item.distanceKm}} km</text></text>
                  <view><text wx:if="{{item.plannedParticipants}}">计划 {{item.plannedParticipants}} 人</text><text wx:if="{{item.fee}}"> · {{item.fee}}</text></view>
                </view>
                <view wx:if="{{entryEdition.registration.lotteryNote}}" class="archive-prose">{{entryEdition.registration.lotteryNote}}</view>
                <view wx:if="{{entryEdition.registration.note}}" class="archive-prose">{{entryEdition.registration.note}}</view>
                <view wx:for="{{entryNotes}}" wx:key="*this" class="archive-prose">{{item}}</view>
              </view>
            </view>
            <view wx:if="{{lotteryRows.length > 1}}" class="archive-section">
              <view class="archive-h3">其他年份</view>
              <block wx:for="{{lotteryRows}}" wx:key="year">
                <view wx:if="{{entryYear !== item.year}}" class="archive-surface archive-lottery-year">
                  <button class="archive-row archive-menu-row" data-year="{{item.year}}" bindtap="setEntryYear"><text>{{item.year}} 年</text><text class="archive-chevron">›</text></button>
                  <template is="metric-grid" data="{{cells: item.cells}}" />
                </view>
              </block>
            </view>
          </block>
          <block wx:elif="{{entryEdition && entrySection === 'guide'}}">
            <view wx:if="{{guideSections.length}}" class="archive-meta archive-guide-time">时间均为北京时间</view>
            <view wx:for="{{guideSections}}" wx:key="id" class="archive-surface archive-guide">
              <view class="archive-item-title">{{item.title}}</view>
              <template is="fact-list" data="{{facts: item.fields}}" />
            </view>
            <view wx:for="{{entryTips}}" wx:key="index" class="archive-surface archive-guide">
              <view class="archive-item-title">{{item.title}}</view><view class="archive-prose">{{item.body}}</view>
            </view>
            <view wx:if="{{!guideSections.length && !entryTips.length}}" class="archive-empty">本届参赛指南尚未收录</view>
          </block>
          <view wx:else class="archive-empty">参赛资料尚未收录</view>
        </block>

        <block wx:elif="{{tab === 'route'}}">
          <view class="archive-section-head">
            <view class="archive-h2">赛道图</view>
            <picker wx:if="{{years.length}}" range="{{years}}" value="{{routeIndex}}" data-scope="route" bindchange="pickYear">
              <view class="archive-select">{{routeYear}} 年<text class="archive-caret"></text></view>
            </picker>
          </view>
          <block wx:if="{{routeImages.length}}">
            <view wx:for="{{routeImages}}" wx:key="url" class="archive-map archive-surface">
              <image class="archive-photo" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" data-images="{{routeImages}}"
                bindtap="previewImage" binderror="imageError" aria-label="{{routeYear}} 年赛道图，轻触放大" />
              <view class="archive-map-footer">
                <view wx:if="{{item.caption || item.credit}}" class="archive-meta">{{item.caption}}<text wx:if="{{item.caption && item.credit}}"> · </text>{{item.credit}}</view>
                <text class="archive-meta" wx:else>轻触图片放大</text>
              </view>
            </view>
          </block>
          <view wx:else class="archive-empty">暂无该届赛道图</view>
        </block>

        <block wx:elif="{{tab === 'results'}}">
          <view class="archive-section-head">
            <view class="archive-h2">历届成绩</view>
            <picker wx:if="{{years.length}}" range="{{years}}" value="{{resultsIndex}}" data-scope="results" bindchange="pickYear">
              <view class="archive-select">{{resultsYear}} 年<text class="archive-caret"></text></view>
            </picker>
          </view>
          <view wx:if="{{resultsEdition.results.length}}" class="archive-surface archive-results">
            <view class="archive-results-date archive-meta">{{resultsEdition.date || resultsYear + ' 年'}}</view>
            <view wx:for="{{resultsEdition.results}}" wx:key="key" class="archive-result">
              <view class="archive-result-time">{{item.time}}</view>
              <view class="archive-athlete">{{item.athlete}}</view>
              <view class="archive-meta">{{item.group}}</view>
            </view>
          </view>
          <view wx:else class="archive-empty">{{resultsEdition.coverage.upcoming ? '本届尚未开赛' : '本届成绩暂未收录'}}</view>
          <view wx:if="{{records.length}}" class="archive-section archive-records">
            <view class="archive-h3">赛会纪录</view>
            <view class="archive-surface archive-results">
              <view wx:for="{{records}}" wx:key="index" class="archive-result">
                <view class="archive-result-time">{{item.time}}</view>
                <view class="archive-athlete">{{item.athlete}}</view>
                <view class="archive-meta">{{item.group || item.category}}<text wx:if="{{item.achievedAt || item.editionId}}"> · {{item.achievedAt || item.editionId}}</text></view>
              </view>
            </view>
          </view>
          <view wx:if="{{resultFacts.length}}" class="archive-section">
            <view class="archive-h3">参赛与完赛</view>
            <view class="archive-surface"><template is="metric-grid" data="{{cells: resultFacts}}" /></view>
          </view>
          <view wx:if="{{resultsEdition.participation.note || resultsEdition.results.length || records.length}}" class="archive-disclosures">
            <button class="archive-disclosure" bindtap="toggleResultNotes" aria-expanded="{{resultNotesExpanded}}">
              <text>成绩口径与核验</text><text class="archive-meta">{{resultNotesExpanded ? '收起' : '展开'}}</text>
            </button>
            <view wx:if="{{resultNotesExpanded}}" class="archive-disclosure-body">
              <view wx:if="{{resultsEdition.participation.note}}" class="archive-prose">{{resultsEdition.participation.note}}</view>
              <view wx:for="{{resultsEdition.results}}" wx:key="key" class="archive-source">
                <view class="archive-source-title">{{item.athlete}} · {{item.group}}</view><view class="archive-meta">{{item.timing || '计时口径待补充'}}</view>
              </view>
              <view wx:for="{{records}}" wx:key="index" class="archive-source">
                <view class="archive-source-title">{{item.athlete}} · 赛会纪录</view>
                <view class="archive-meta">{{item.timing || '计时口径待核实'}}<text wx:if="{{item.verifiedAt}}"> · 核验 {{item.verifiedAt}}</text></view>
              </view>
            </view>
          </view>
        </block>

        <block wx:elif="{{tab === 'gallery'}}">
          <view class="archive-section-head">
            <view class="archive-h2">历届图鉴</view>
            <picker range="{{yearFilters}}" value="{{galleryYearIndex}}" data-scope="gallery" bindchange="pickFilterYear">
              <view class="archive-select">{{galleryYear ? galleryYear + ' 年' : '全部年份'}}<text class="archive-caret"></text></view>
            </picker>
          </view>
          <view class="archive-subnav archive-gallery-nav">
            <button wx:for="{{galleryTypes}}" wx:key="*this" class="{{galleryType === item ? 'on' : ''}}"
              data-id="{{item}}" bindtap="pickGallery">{{item}}</button>
          </view>
          <block wx:if="{{galleryType !== '官方图集'}}">
            <view wx:for="{{galleryGroups}}" wx:for-item="group" wx:key="year" class="archive-exhibit">
              <view class="archive-exhibit-year">{{group.year}} 年</view>
              <view class="archive-surface">
                <view wx:for="{{group.items}}" wx:for-item="piece" wx:key="id" class="archive-exhibit-piece">
                  <view class="archive-item-title">{{piece.name}}</view>
                  <view wx:if="{{piece.labels}}" class="archive-meta">{{piece.labels}}</view>
                  <view wx:if="{{piece.images.length}}" class="archive-gallery-grid {{piece.images.length === 1 ? 'single' : ''}}">
                    <view wx:for="{{piece.images}}" wx:for-item="photo" wx:key="url" class="archive-gallery-item">
                      <image src="{{photo.url}}" mode="aspectFit" data-url="{{photo.url}}" data-images="{{piece.images}}"
                        bindtap="previewImage" binderror="imageError" lazy-load aria-label="{{piece.name}} {{photo.caption}}，轻触放大" />
                      <view wx:if="{{photo.caption}}" class="archive-photo-label">{{photo.caption}}</view>
                      <view wx:if="{{photo.credit}}" class="archive-meta">{{photo.credit}}</view>
                    </view>
                  </view>
                  <view wx:else class="archive-empty archive-piece-empty">图片待补充</view>
                </view>
                <view wx:if="{{!group.items.length}}" class="archive-empty archive-piece-empty">图片待补充</view>
              </view>
            </view>
            <view wx:if="{{!galleryGroups.length}}" class="archive-empty">图片待补充</view>
          </block>
          <block wx:else>
            <view wx:if="{{!albums.length}}" class="archive-empty">图片待补充</view>
            <button wx:for="{{albums}}" wx:key="id" class="archive-album archive-surface"
              data-id="{{item.id}}" bindtap="previewAlbum">
              <image src="{{item.media[0].url}}" mode="aspectFill" data-url="{{item.media[0].url}}" binderror="imageError" />
              <view><view class="archive-item-title">{{item.title || item.year + ' 年赛事影像'}}</view><view class="archive-meta">{{item.year}} 年 · {{item.media.length}} 张照片</view></view>
              <text class="archive-chevron">›</text>
            </button>
          </block>
        </block>

        <block wx:elif="{{tab === 'updates'}}">
          <view class="archive-section-head">
            <view class="archive-h2">赛事动态</view>
            <picker range="{{storyYearFilters}}" value="{{storyYearIndex}}" data-scope="story" bindchange="pickFilterYear">
              <view class="archive-select">{{storyYear ? storyYear + ' 年' : '全部年份'}}<text class="archive-caret"></text></view>
            </picker>
          </view>
          <button wx:for="{{stories}}" wx:key="key" class="archive-story archive-surface" data-key="{{item.key}}" bindtap="openArticle">
            <view class="archive-story-copy">
              <view class="archive-meta">{{item.publishedAt || item.editionYear}}<text wx:if="{{item.tag}}"> · {{item.tag}}</text></view>
              <view class="archive-story-title">{{item.title}}</view>
              <view class="archive-story-summary">{{item.summary}}</view>
            </view>
            <text class="archive-chevron" aria-hidden="true">›</text>
          </button>
          <view wx:if="{{!stories.length}}" class="archive-empty">暂无该年份的赛事动态</view>
        </block>

        <view wx:if="{{sources.length || gaps.length || conflicts.length}}" class="archive-disclosures archive-support">
          <block wx:if="{{sources.length}}">
            <button class="archive-disclosure" bindtap="toggleSources" aria-expanded="{{sourcesExpanded}}">
              <text>资料来源与核验 · {{sources.length}} 条</text><text class="archive-meta">{{sourcesExpanded ? '收起' : '展开'}}</text>
            </button>
            <view wx:if="{{sourcesExpanded}}" class="archive-disclosure-body">
              <template is="source-list" data="{{sources, showChecks: true}}" />
            </view>
          </block>
          <block wx:if="{{gaps.length || conflicts.length}}">
            <button class="archive-disclosure" bindtap="toggleCoverage" aria-expanded="{{coverageExpanded}}">
              <text>收录说明与待补充</text><text class="archive-meta">{{coverageExpanded ? '收起' : '展开'}}</text>
            </button>
            <view wx:if="{{coverageExpanded}}" class="archive-disclosure-body">
              <view wx:for="{{gaps}}" wx:key="index" class="archive-prose">{{item.reason || item}}</view>
              <view wx:for="{{conflicts}}" wx:key="index" class="archive-prose">{{item}}</view>
            </view>
          </block>
        </view>
        <view wx:if="{{archive.updatedAt}}" class="archive-footer archive-meta">资料更新 {{archive.updatedAt}}</view>
      </view>
    </scroll-view>
  </block>

  <view wx:if="{{activeArticle}}" class="archive-reader" catchtap="stopTap">
    <view class="archive-reader-bar"><button class="archive-link" bindtap="closeArticle">‹ 返回动态</button></view>
    <scroll-view scroll-y class="archive-reader-scroll">
      <view class="archive-reader-body">
        <view wx:if="{{activeArticle.date || activeArticle.tag}}" class="archive-meta">{{activeArticle.date}}<text wx:if="{{activeArticle.tag}}"> · {{activeArticle.tag}}</text></view>
        <view class="archive-reader-title">{{activeArticle.title}}</view>
        <view wx:for="{{activeArticle.images}}" wx:key="url" class="archive-reader-image">
          <image class="archive-photo" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" data-images="{{activeArticle.images}}"
            bindtap="previewImage" binderror="imageError" aria-label="文章配图，轻触放大" />
          <view wx:if="{{item.caption || item.credit}}" class="archive-meta">{{item.caption}} {{item.credit}}</view>
        </view>
        <view wx:for="{{activeArticle.paragraphs}}" wx:key="index" class="archive-prose archive-paragraph">{{item}}</view>
        <view wx:if="{{activeArticle.sources.length}}" class="archive-section archive-reader-sources">
          <view class="archive-h3">资料来源</view>
          <template is="source-list" data="{{sources: activeArticle.sources}}" />
        </view>
      </view>
    </scroll-view>
  </view>
</view>
