.privacy-page { min-height: 100vh; padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: transparent; }
.privacy-card {  background:var(--surface); border-color:var(--border); box-shadow:none; }
.privacy-title { margin-bottom: 24rpx; }
.privacy-copy { margin: 20rpx 0; color: var(--text-secondary); }
.contract { margin-top: 28rpx; text-align: left;  }
.contract::after,.agree::after,.decline::after { border: 0;  }
.reason { margin-top: 24rpx; color: var(--text-secondary); font-size:12px; line-height: 38rpx; }
.agree,.decline { width: 100%; height: 88rpx; margin-top: 24rpx;  font-size:14px; line-height: 88rpx; }
.agree { color:var(--surface); font-weight: 600;  }
.message { margin-top: 18rpx; color: var(--brand); font-size:12px; line-height: 38rpx; }
.full-policy {padding:25rpx;margin-top:25rpx;background: var(--page-bg);border-radius:15rpx}.full-policy>view{font-size:12px;color:var(--text-secondary);line-height:1.9;margin-bottom:10rpx}.full-policy button{background:none;margin:0;padding:15rpx 0;text-align:left;font-size:12px;line-height:1.8;min-height:44px;color:var(--brand)}.full-policy button::after{border:0}

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-privacy-privacy .privacy-card { border-radius:36rpx; }
.mini-privacy-privacy .agree, .mini-privacy-privacy .decline, .mini-privacy-privacy .contract { border-radius:24rpx; }

/* Page composition and interaction hierarchy. */
.mini-privacy-privacy { color: var(--text); }
.mini-privacy-privacy button { font-weight: 500; border-radius:24rpx; }

.privacy-page { color: var(--text); background: transparent; }
.privacy-card { padding: 36rpx; border: 1px solid var(--border); background:var(--surface); border-color:var(--border); box-shadow:none; }
.privacy-title { font-size:24px; font-weight: 600; line-height: 1.5; }
.privacy-copy { font-size:14px; line-height: 1.9; }
.agree { background: var(--brand); }
.decline { border: 1px solid var(--border); background:var(--surface); color: var(--text-secondary); }
.contract { min-height: 44px; padding: 12rpx 0; background: transparent; color: var(--brand); font-size:12px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-privacy-privacy .agree { font-size:14px; font-weight: 500; }
.mini-privacy-privacy .decline { font-size:13px; font-weight: 500; }

.privacy-page{background:var(--page-bg);font-size:14px;letter-spacing:normal}.privacy-card{border-radius:24rpx;border-color:var(--border);box-shadow:none;padding:32rpx;background:var(--surface)}.privacy-title{font-size:24px;font-weight:600;letter-spacing:normal}.privacy-copy{font-size:14px;line-height:1.85;color:var(--text)}.full-policy{background:var(--page-bg);border-radius:20rpx}.full-policy button,.contract{font-size:14px;min-height:44px;border-radius:20rpx}.agree,.decline{min-height:44px;height:auto;line-height:1.5;padding:12px 18px;border-radius:20rpx;font-size:14px;font-weight:500}.agree{background:var(--brand);color:var(--surface)}.reason,.message{font-size:12px;line-height:1.85}.privacy-page button{font-weight:500}

@import "../../utils/personal-ui.wxss";
.privacy-card { border:0; }.privacy-title { margin-bottom:32rpx; padding:32rpx; border-radius:24rpx; background:linear-gradient(135deg,#fff0f2,#fff); }.privacy-section-title { margin:40rpx 0 16rpx; font-size:18px; font-weight:600; color:#1a1a1a; line-height:1.5; }.privacy-copy { margin-top:0; }.full-policy { padding:24rpx; }.full-policy button { text-align:left; border-radius:0; border-bottom:1px solid #eee; background:transparent; }.full-policy button:last-child { border:0; }
