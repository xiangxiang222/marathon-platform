.archive-page{min-width:0;color:#1a1a1a;font-size:14px;line-height:1.6}.archive-intro{padding:24px 20px;background:#fff}.archive-kicker{display:block;font-size:12px;color:#777}.archive-title{margin:8px 0 10px;font-size:24px;line-height:1.4;font-weight:600}.archive-lead{font-size:14px;color:#555;line-height:1.8}.archive-body{padding:20px 16px}.archive-search{display:flex;align-items:center;gap:8px;padding:4px 4px 4px 12px;background:#fff;border:1px solid #eee;border-radius:8px}.archive-search input{flex:1;width:0;min-width:0;min-height:44px;padding:0;border:0;background:transparent;font-size:14px}.archive-search button{flex:none;min-height:44px;min-width:60px;padding:8px;background:#ff1838;color:#fff;border:0;border-radius:6px;font-size:14px}.archive-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.archive-filters>view{min-width:0}.archive-filters>view>text{font-size:12px;color:#777}.archive-select{display:flex;justify-content:space-between;align-items:center;min-height:44px;margin-top:5px;padding:8px 10px;background:#fff;border:1px solid #e5e5e5;border-radius:8px;font-size:14px}.archive-caption{font-size:12px;color:#777;line-height:1.8;margin:12px 0;word-break:break-all}.archive-state{padding:32px 0;color:#777;text-align:center;font-size:14px}.archive-secondary{min-height:44px;min-width:100px;margin:16px auto 0;padding:10px 16px;border:1px solid #e5e5e5;border-radius:8px;background:#fff;font-size:14px}.archive-h2{font-size:18px;font-weight:600;line-height:1.5;color:#1a1a1a}.archive-list-heading{display:flex;justify-content:space-between;align-items:center;margin:24px 0 12px}.archive-list-heading>text:last-child{font-size:12px;color:#777}.archive-directory-card{display:block;min-width:0;padding:14px;margin-bottom:12px;border:1px solid #e9e9e9;border-radius:12px;background:#fff}.archive-card-top{display:flex;align-items:center;gap:12px;min-width:0}.archive-landmark{display:block;flex:none;width:88px;height:72px}.archive-card-copy{flex:1;min-width:0}.archive-race-name{font-size:18px;font-weight:600;line-height:1.5;color:#1a1a1a;overflow-wrap:anywhere}.archive-arrow{flex:none;font-size:24px;line-height:1;color:#999}.archive-card-tagline{margin-top:6px;color:#777;font-size:12px;line-height:1.7;overflow-wrap:anywhere}.archive-badges{display:grid;gap:6px;margin-top:14px;padding-top:12px;border-top:1px solid #f0f0f0}.archive-badges>view{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;min-width:0;color:#555;font-size:12px;line-height:1.7}.archive-badges text{max-width:100%;overflow-wrap:anywhere}.archive-certification-origin{flex:none;color:#888}.archive-card-link{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:4px 12px;min-height:36px;margin-top:8px;font-size:12px;color:#888}.archive-card-link>text:last-child{margin-left:auto;color:#ff1838}
