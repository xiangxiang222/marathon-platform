@import "../../utils/mileage-pages.wxss";
.tg-page-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:4px 0 12px}.tg-total{flex:none;color:var(--text-secondary);font-size:12px}.tg-page-heading .mp-subtitle{margin-top:6px}.tg-card{margin-bottom:12px;padding:14px 16px;border:0;border-radius:12px;background:#fff}.tg-card-top{display:flex;align-items:center;gap:12px}.tg-main{flex:1;min-width:0}.tg-name{font-size:15px;font-weight:600;overflow-wrap:anywhere}.tg-pace{margin-top:5px;font-size:12px;color:var(--text-secondary);overflow-wrap:anywhere}.tg-size{display:flex;flex-direction:column;gap:2px;flex:none;font-size:22px;font-weight:600;text-align:right}.tg-size>text{font-size:12px;color:var(--text-secondary);font-weight:400}.tg-description{margin-top:10px;color:var(--text-secondary);font-size:12px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}.tg-actions{display:flex;align-items:center;justify-content:flex-end;gap:16px;margin-top:8px;border-top:1px solid var(--border)}.tg-delete{min-height:44px;font-size:12px;color:var(--text-secondary)}.tg-members{padding:14px 16px}.tg-member{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--border);min-height:72px}.tg-member:last-child{border-bottom:0}.mp-page .tg-member-link{display:flex;align-items:center;flex:1;min-width:0;gap:10px;text-align:left;min-height:56px}.tg-member-link>text{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:14px;font-weight:500}.tg-assignment{display:flex;align-items:center;gap:6px;min-height:44px;max-width:115px;font-size:12px;color:var(--text-secondary);overflow-wrap:anywhere}.tg-member picker{flex:none;min-width:44px}.training-groups>.mp-section-head{margin-top:12px}.training-groups>.mp-section-head>.mp-small-note{max-width:45%;text-align:right}
