<view class="training-groups mp-page">
  <view class="tg-page-heading"><view><view class="mp-page-title">训练组</view><view class="mp-subtitle">配速、目标与成员安排</view></view><text class="tg-total">{{groups.length}} 组</text></view>
  <view class="mp-section-head"><view class="mp-section-title">跑团训练组 <text>{{groups.length}}</text></view><button wx:if="{{staff}}" class="mp-text-action" bindtap="newGroup">＋ 新建组别</button></view>
  <view wx:if="{{loading}}" class="mp-empty">正在载入训练组…</view><view wx:if="{{message}}" class="mp-error">{{message}}<button class="mp-text-action" bindtap="load">重试</button></view>
  <view wx:for="{{groups}}" wx:key="id" class="tg-card"><view class="tg-card-top"><view class="tg-main"><view class="tg-name">{{item.name}}</view><view class="tg-pace">{{item.pace || '按个人节奏训练'}}</view></view><view class="tg-size">{{item.memberCount}}<text> 位成员</text><text class="tg-capacity">{{item.capacity ? '上限 ' + item.capacity + ' 人' : '人数不限'}}</text></view></view><view wx:if="{{item.description}}" class="tg-description">{{item.description}}</view><view wx:if="{{staff}}" class="tg-actions"><button class="mp-text-action" data-id="{{item.id}}" disabled="{{busy}}" bindtap="editGroup">编辑组别 ↗</button><button class="tg-delete" data-id="{{item.id}}" disabled="{{busy}}" bindtap="removeGroup">删除</button></view></view>
  <view wx:if="{{!loading && !groups.length}}" class="mp-empty"><view class="mp-section-title">把同频的团友，放在同一组</view><view>例如 A 组 4′30″ / km，B 组 5′30″ / km。
常用组别可直接带入每次活动。</view><button wx:if="{{staff}}" class="mp-primary" bindtap="newGroup">创建第一个训练组</button></view>
  <view class="mp-section-head"><view class="mp-section-title">{{staff ? '安排组员' : '组员名单'}} <text>{{members.length}}</text></view><text class="mp-small-note">每位团友关联一个训练组</text></view>
  <view class="mp-card tg-members"><view class="mp-search"><text>⌕</text><input value="{{query}}" bindinput="onQuery" placeholder="搜索团友昵称" aria-label="搜索组员" /></view><view wx:for="{{shownMembers}}" wx:key="id" class="tg-member"><button class="tg-member-link" data-id="{{item.id}}" bindtap="openMember"><image wx:if="{{item.avatar}}" class="mp-avatar" src="{{item.avatar}}" mode="aspectFill" /><view wx:else class="mp-avatar mp-fallback">{{item.initial}}</view><text>{{item.nickname}}</text></button><picker wx:if="{{staff}}" mode="selector" range="{{optionNames}}" value="{{item.optionIndex}}" data-id="{{item.id}}" disabled="{{busy}}" bindchange="assignMember"><view class="tg-assignment">{{item.groupName || '未分组'}} <text>⌄</text></view></picker><text wx:else class="mp-small-note">{{item.groupName || '未分组'}}</text></view><view wx:if="{{!shownMembers.length && !loading}}" class="mp-empty">没有找到这位团友。</view></view>
  <view class="mp-footnote">训练组同步用于跑量排行与活动分组；活动可单独调整配速。</view>
  <view wx:if="{{sheetOpen}}" class="mp-overlay" bindtap="closeSheet"><view class="mp-sheet" catchtap="noop"><view class="mp-section-head"><view class="mp-section-title">{{editingId ? '编辑训练组' : '新建训练组'}}</view><button class="mp-sheet-close" bindtap="closeSheet" aria-label="关闭">×</button></view><scroll-view scroll-y class="mp-sheet-body"><view class="mp-label">组别名称</view><input class="mp-input" maxlength="20" value="{{draft.name}}" data-key="name" bindinput="input" placeholder="例如 A 组、进阶组" aria-label="训练组名称" /><view class="mp-label">默认配速 / 训练目标</view><input class="mp-input" maxlength="40" value="{{draft.pace}}" data-key="pace" bindinput="input" placeholder="例如 4′30″—5′00″ / km" aria-label="默认配速" /><view class="mp-label">组别介绍</view><textarea class="mp-textarea" maxlength="300" value="{{draft.description}}" data-key="description" bindinput="input" placeholder="适合谁加入，大家通常怎样训练" aria-label="训练组介绍" /><view class="mp-form-row"><view><view class="mp-label">人数上限 · 0 为不限</view><input class="mp-input" type="number" value="{{draft.capacity}}" data-key="capacity" bindinput="input" aria-label="人数上限" /></view><view><view class="mp-label">排序</view><input class="mp-input" type="number" value="{{draft.sort}}" data-key="sort" bindinput="input" aria-label="训练组排序" /></view></view><view wx:if="{{sheetMessage}}" class="mp-error">{{sheetMessage}}</view></scroll-view><button class="mp-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveGroup">保存训练组</button></view></view>
</view>
