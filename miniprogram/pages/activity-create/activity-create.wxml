<view class="page mini-activity-create-activity-create service-page service-form">
  <view wx:if="{{loading}}" class="loading">正在准备这一次相聚…</view>
  <view wx:elif="{{!club}}" class="error-panel">{{message || '暂时无法打开发布页'}}<button class="retry" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{!club.staff}}" class="error-panel">只有跑团管理员可以发布活动和管理训练模板</view>
    <block wx:else>
      <view class="topline"><view class="eyebrow"><text class="brand-dash"></text><text class="club-name">{{club.name}}</text></view><text wx:if="{{copying}}" class="copy-tag">已复制 · 重新选日期</text><button wx:if="{{templateMode}}" class="exit-edit" bindtap="cancelTemplateEdit">返回活动</button></view>
      <view class="heading">{{templateMode ? (editingTemplateId ? '编辑训练模板' : '创建训练模板') : '发布训练'}}</view>
      <view class="page-intro">{{templateMode ? '保存常用内容，让每次发布更轻松。' : '选一份模板，或安排全新的一场。'}}</view>
      <view class="steps">
        <view class="step {{step === 1 ? 'current' : (step > 1 ? 'done' : '')}}"><text class="step-number">{{step > 1 ? '✓' : '01'}}</text><text>{{templateMode ? '常用信息' : '时间地点'}}</text></view><view class="step-line"></view>
        <view class="step {{step === 2 ? 'current' : (step > 2 ? 'done' : '')}}"><text class="step-number">{{step > 2 ? '✓' : '02'}}</text><text>训练安排</text></view><view class="step-line"></view>
        <view class="step {{step === 3 ? 'current' : ''}}"><text class="step-number">03</text><text>{{templateMode ? '确认保存' : '预览发布'}}</text></view>
      </view>
      <view wx:if="{{savedDraft && !templateMode}}" class="restore-line">
        <view class="restore-main"><view class="draft-mark">草</view><view class="restore-copy"><view class="restore-title">接着上次的安排</view><view class="subtle">草稿保存于 {{savedAt}}</view></view></view>
        <view class="restore-actions"><button class="discard-btn" bindtap="discardDraft">删除草稿</button><button class="restore-btn" bindtap="restoreDraft">继续填写 <text>↗</text></button></view>
      </view>
      <view wx:if="{{successMessage}}" class="success-note">✓ {{successMessage}}</view>
      <view wx:if="{{templateMode}}" class="editing-banner"><view><text class="editing-dot"></text>{{editingTemplateId ? '正在编辑跑团模板' : '正在新建跑团模板'}}</view><text>不会发布活动</text></view>
      <block wx:if="{{step === 1}}">
        <view class="form-area">
          <view class="section-head"><view><view class="section-kicker">01 / {{templateMode ? '常用信息' : '时间与地点'}}</view><view class="section-title">{{templateMode ? '常用信息' : '基本信息'}}</view></view><text class="step-caption">{{templateMode ? '按需填写' : '北京时间'}}</text></view>
          <block wx:if="{{templateMode}}"><view class="label">模板名称 <text class="required">必填</text></view><input class="field" maxlength="30" placeholder="例如：周三间歇、周末长距离" value="{{templateName}}" bindinput="inputTemplateName" aria-label="模板名称" /></block>
          <view class="label">{{templateMode ? '活动默认标题' : '活动名称'}} <text class="required">{{templateMode ? '可用模板名称' : '必填'}}</text></view><input class="field" maxlength="40" placeholder="{{titlePlaceholder}}" value="{{draft.title}}" data-key="title" bindinput="input" aria-label="活动名称" />
          <view class="type-row"><button wx:for="{{templates}}" wx:key="id" class="type-option {{draft.trainingType === item.id ? 'type-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseTemplate">{{item.name}}</button></view>
          <view wx:if="{{!templateMode}}" class="two-col"><view class="col"><view class="label">活动日期 <text class="required">必填</text></view><picker mode="date" value="{{draft.startDate}}" data-key="startDate" bindchange="pickDate"><view class="picker-field {{!draft.startDate ? 'placeholder' : ''}}">{{draft.startDate || '选择日期'}}<text>⌄</text></view></picker></view><view class="col"><view class="label">开始时间 <text class="required">必填</text></view><picker mode="time" value="{{draft.startTime}}" data-key="startTime" bindchange="pickTime"><view class="picker-field {{!draft.startTime ? 'placeholder' : ''}}">{{draft.startTime || '选择时间'}}<text>⌄</text></view></picker></view></view>
          <view wx:else class="two-col"><view class="col"><view class="label">常用开始时间</view><picker mode="time" value="{{draft.startTime}}" data-key="startTime" bindchange="pickTime"><view class="picker-field">{{draft.startTime || '每次另选'}}<text>⌄</text></view></picker></view><view class="col"><view class="label">预计时长 <text class="optional">分钟</text></view><input class="field" type="number" placeholder="可不填" value="{{templateTiming.durationMinutes}}" data-key="durationMinutes" bindinput="timingInput" aria-label="预计时长分钟" /></view></view>
          <view class="label">活动地点 <text class="required">{{templateMode ? '可稍后补充' : '必填'}}</text></view><input class="field" maxlength="40" placeholder="公园、跑道或训练区域" value="{{draft.place}}" data-key="place" bindinput="input" aria-label="活动地点" />
          <view class="label">具体集合点 <text class="required">{{templateMode ? '可稍后补充' : '必填'}}</text></view><input class="field" maxlength="40" placeholder="例如：南园南门，地铁 A 出口" value="{{draft.gatherPlace}}" data-key="gatherPlace" bindinput="input" aria-label="具体集合点" />
          <view class="label">计划里程 <text class="optional">公里 · 可选</text></view><input class="field" type="digit" placeholder="按本次计划填写" value="{{draft.plannedKm}}" data-key="plannedKm" bindinput="input" aria-label="计划里程公里" />
          <button class="disclosure" bindtap="toggleExtra"><view><view class="disclosure-title">更多时间与报名设置</view><view class="subtle">{{templateMode ? '集合时刻、路线与提前截止时间' : '结束时间、集合时刻、报名截止与路线'}}</view></view><text>{{extraOpen ? '−' : '＋'}}</text></button>
          <view wx:if="{{extraOpen}}" class="extra-fields">
            <block wx:if="{{!templateMode}}"><view class="two-col"><view class="col"><view class="label">结束日期</view><picker mode="date" value="{{draft.endDate}}" data-key="endDate" bindchange="pickDate"><view class="picker-field">{{draft.endDate || '不设置'}}</view></picker></view><view class="col"><view class="label">结束时间</view><view class="time-clear"><picker mode="time" value="{{draft.endTime}}" data-key="endTime" bindchange="pickTime"><view class="picker-field">{{draft.endTime || '不设置'}}</view></picker><text wx:if="{{draft.endDate || draft.endTime}}" class="clear" data-key="end" bindtap="clearTime">清空</text></view></view></view></block>
            <view class="label">集合时间 <text class="optional">可选</text></view><input class="field" maxlength="40" placeholder="例如：06:20，或提前 10 分钟集合" value="{{draft.gatherAt}}" data-key="gatherAt" bindinput="input" aria-label="集合时间说明" />
            <view wx:if="{{!templateMode}}" class="label">本次期次 <text class="optional">可选</text></view><input wx:if="{{!templateMode}}" class="field" maxlength="40" placeholder="例如：第 12 期" value="{{draft.issue}}" data-key="issue" bindinput="input" aria-label="本次期次" />
            <view class="label">路线说明 <text class="optional">可选</text></view><input class="field" maxlength="200" placeholder="路线、补水点或交通提示" value="{{draft.route}}" data-key="route" bindinput="input" aria-label="路线说明" />
            <block wx:if="{{templateMode}}"><view class="label">报名提前截止 <text class="optional">分钟 · 可选</text></view><input class="field" type="number" placeholder="例如 60，开始前 1 小时截止" value="{{templateTiming.signupLeadMinutes}}" data-key="signupLeadMinutes" bindinput="timingInput" aria-label="报名提前截止分钟" /><view class="label">取消提前截止 <text class="optional">分钟 · 可选</text></view><input class="field" type="number" placeholder="例如 120，开始前 2 小时截止" value="{{templateTiming.cancelLeadMinutes}}" data-key="cancelLeadMinutes" bindinput="timingInput" aria-label="取消提前截止分钟" /></block>
            <block wx:else><view class="two-col"><view class="col"><view class="label">报名截止日期</view><picker mode="date" value="{{draft.signupDate}}" data-key="signupDate" bindchange="pickDate"><view class="picker-field">{{draft.signupDate || '不单独设置'}}</view></picker></view><view class="col"><view class="label">截止时间</view><view class="time-clear"><picker mode="time" value="{{draft.signupTime}}" data-key="signupTime" bindchange="pickTime"><view class="picker-field">{{draft.signupTime || '不单独设置'}}</view></picker><text wx:if="{{draft.signupDate || draft.signupTime}}" class="clear" data-key="signup" bindtap="clearTime">清空</text></view></view></view><view class="two-col"><view class="col"><view class="label">取消截止日期</view><picker mode="date" value="{{draft.cancelDate}}" data-key="cancelDate" bindchange="pickDate"><view class="picker-field">{{draft.cancelDate || '不单独设置'}}</view></picker></view><view class="col"><view class="label">截止时间</view><view class="time-clear"><picker mode="time" value="{{draft.cancelTime}}" data-key="cancelTime" bindchange="pickTime"><view class="picker-field">{{draft.cancelTime || '不单独设置'}}</view></picker><text wx:if="{{draft.cancelDate || draft.cancelTime}}" class="clear" data-key="cancel" bindtap="clearTime">清空</text></view></view></view></block>
          </view>
        </view>
        <view class="template-studio">
          <view class="section-head"><view><view class="section-kicker">训练模板</view><view class="section-title">从常用训练开始</view></view></view>
          <view class="preset-row"><button wx:for="{{presets}}" wx:key="id" class="preset-card {{selectedTemplateId === 'preset:' + item.id ? 'preset-active' : ''}}" data-source="preset" data-id="{{item.id}}" bindtap="useTemplate"><view class="preset-top"><text class="preset-mark">{{item.mark}}</text><text class="preset-arrow">{{selectedTemplateId === 'preset:' + item.id ? '✓' : '↗'}}</text></view><text class="preset-name">{{item.name}}</text><text class="preset-tag">{{item.tag}}</text></button></view>
          <view wx:if="{{!templateMode}}" class="library-head"><text>跑团的训练模板 <text class="library-count">{{clubTemplates.length}}</text></text><button class="text-button" disabled="{{templateBusy}}" bindtap="newTemplate">＋ 新建模板</button></view>
          <block wx:if="{{!templateMode}}">
            <view wx:if="{{templatesLoading}}" class="library-empty">正在载入跑团模板…</view>
            <view wx:elif="{{templatesError}}" class="template-load-error"><text>{{templatesError}}</text><button class="text-button" bindtap="loadTemplates">重试</button></view>
            <view wx:elif="{{clubTemplates.length}}" class="template-scroll"><view wx:for="{{clubTemplates}}" wx:key="id" class="saved-template {{selectedTemplateId === 'saved:' + item.id ? 'saved-active' : ''}}"><button class="saved-template-use" data-source="saved" data-id="{{item.id}}" bindtap="useTemplate"><text class="saved-template-name">{{item.name}}</text><text class="saved-template-meta">{{item.config.startTime || '时间灵活'}} · {{item.config.groups.length}} 个分组</text><text class="saved-template-cta">使用模板 ↗</text></button><button class="template-menu" aria-label="管理模板" data-id="{{item.id}}" disabled="{{templateBusy}}" bindtap="manageTemplate">•••</button></view></view>
            <view wx:else class="library-empty">把每周的固定训练存下来，全团管理员都能用。</view>
          </block>
        </view>
      </block>
      <block wx:if="{{step === 2}}">
        <view class="form-area">
          <view class="section-head"><view><view class="section-kicker">02 / 分组与训练</view><view class="section-title">各有节奏，一起向前</view></view></view><view class="section-description">把分组和训练安排说清楚，团友就知道怎么跑。</view>
          <view class="training-library-head"><view><view class="label">跑团训练组</view><view class="training-library-note">选好组别，默认配速自动带入</view></view><button class="training-library-manage" bindtap="openTrainingGroups">管理 ↗</button></view>
          <view wx:if="{{trainingGroupError}}" class="training-library-note">{{trainingGroupError}}<button class="training-library-manage" bindtap="loadTrainingGroups">重试</button></view>
          <view class="training-library-scroll"><view class="training-library-options"><button wx:for="{{trainingOptions}}" wx:key="id" class="training-library-option {{item.selected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseTrainingGroup"><view><text>{{item.name}}</text><text>{{item.selected ? '✓' : '＋'}}</text></view><text>{{item.pace || '按个人节奏'}}</text></button></view></view>
          <view wx:if="{{!trainingOptions.length && !trainingGroupError}}" class="training-library-note">还没有常设训练组。可先创建，也可直接填写本次安排。</view>
          <view class="label group-section-label">本次活动分组 <text class="optional">至少启用一组 · 可调整配速</text></view>
          <view wx:if="{{!groups.length}}" class="empty-groups">添加一个分组，开始安排这次训练。</view>
          <view wx:for="{{groups}}" wx:key="key" class="group-line {{!item.enabled ? 'group-muted' : ''}}">
            <view class="group-head"><text class="group-number">分组 {{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text><view class="group-enable"><text>{{item.enabled ? '已启用' : '未启用'}}</text><switch class="group-switch" checked="{{item.enabled}}" color="#ff1838" data-index="{{index}}" bindchange="toggleGroup" /></view></view>
            <view class="group-fields"><view class="group-field-label">组别名称</view><input class="field" maxlength="20" placeholder="例如：A 组、轻松跑组" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="groupInput" aria-label="组别名称" /><view class="group-field-label">配速或训练目标</view><input class="field" maxlength="40" placeholder="例如：5′30″ / km，或轻松交流的强度" value="{{item.pace}}" data-index="{{index}}" data-key="pace" bindinput="groupInput" aria-label="配速或目标" /></view>
            <view class="two-col group-options"><view class="col"><view class="group-field-label">组别类型</view><picker mode="selector" range="{{kindNames}}" value="{{item.kindIndex}}" data-index="{{index}}" bindchange="groupKind"><view class="kind-picker">{{kindNames[item.kindIndex]}}<text>⌄</text></view></picker></view><view class="col"><view class="group-field-label">人数上限 <text>0 为不限</text></view><input class="field" type="number" value="{{item.capacity}}" data-index="{{index}}" data-key="capacity" bindinput="groupInput" aria-label="组别人数上限" /></view></view>
          </view>
          <button class="add-group" disabled="{{enabledGroupCount >= 12}}" bindtap="addGroup">{{enabledGroupCount >= 12 ? '已达 12 组上限' : '＋ 添加一个分组'}}</button>
          <view class="workout-heading"><view class="label">这一场，怎么跑</view><text class="optional">训练安排</text></view><textarea class="textarea workout-textarea" maxlength="2000" placeholder="热身 → 主训练 → 放松，写下距离、组数和配速安排" value="{{draft.workout}}" data-key="workout" bindinput="input" aria-label="训练安排" />
          <button class="disclosure" bindtap="toggleDetails"><view><view class="disclosure-title">参与须知与积分设置</view><view class="subtle">装备提醒、成团门槛、照片审核</view></view><text>{{detailsOpen ? '−' : '＋'}}</text></button>
          <view wx:if="{{detailsOpen}}" class="extra-fields"><view class="two-col metrics"><view class="col"><view class="label">成团人数</view><input class="field" type="number" value="{{draft.minPeople}}" data-key="minPeople" bindinput="input" aria-label="成团人数" /></view><view class="col"><view class="label">积分里程</view><input class="field" type="digit" value="{{draft.minKm}}" data-key="minKm" bindinput="input" aria-label="积分门槛公里" /></view><view class="col"><view class="label">活动积分</view><input class="field" type="number" value="{{draft.points}}" data-key="points" bindinput="input" aria-label="活动积分" /></view></view><view class="subtle metric-note">报名人数与每人打卡里程达标后，按现有规则记分。</view><view class="label">参与须知</view><textarea class="textarea short" maxlength="1000" placeholder="补水、装备或天气提醒" value="{{draft.notice}}" data-key="notice" bindinput="input" aria-label="参与须知" /><view class="label">补充说明</view><textarea class="textarea short" maxlength="2000" placeholder="其他想告诉团友的事项" value="{{draft.note}}" data-key="note" bindinput="input" aria-label="补充说明" /><view class="review-row"><view><view class="label">活动照片需审核</view><view class="subtle">管理员确认后向团友展示</view></view><switch checked="{{draft.review}}" color="#ff1838" bindchange="toggleReview" /></view></view>
        </view>
        <view wx:if="{{!templateMode}}" class="save-template-strip"><view><view class="strip-title">好安排，下次接着用</view><view class="subtle">地点、分组和训练内容一起保存</view></view><button bindtap="saveTemplate">存为模板 <text>↗</text></button></view>
      </block>
      <view wx:if="{{step === 3}}" class="preview">
        <view class="section-kicker">03 / {{templateMode ? '确认模板' : '准备出发'}}</view><view class="section-title">{{templateMode ? '一份模板，多次相聚' : '最后看一眼，就出发'}}</view>
        <view class="preview-hero"><view class="preview-type">{{typeName}} · {{club.name}}</view><view class="preview-title">{{draft.title || templateName || '未命名活动'}}</view><view wx:if="{{draft.plannedKm}}" class="preview-distance-line">计划 {{draft.plannedKm}} km</view><view class="preview-date">{{templateMode ? (draft.startTime ? '常用开始时间 ' + draft.startTime : '每次发布时选择日期与时间') : previewTime}}</view><view class="preview-place">{{draft.place || '地点每次补充'}}{{draft.gatherPlace ? ' · ' + draft.gatherPlace : ''}}</view></view>
        <view class="preview-section"><view class="preview-label">训练安排</view><view class="preview-copy">{{draft.workout || '按本次计划与分组约定进行'}}</view></view>
        <view class="preview-section"><view class="preview-label">报名分组</view><block wx:for="{{groups}}" wx:key="key"><view wx:if="{{item.enabled}}" class="preview-group"><view><text class="preview-group-name">{{item.name}}</text><text class="preview-group-pace">{{item.pace || kindNames[item.kindIndex]}}</text></view><text>{{item.capacity > 0 ? item.capacity + ' 人' : '人数不限'}}</text></view></block></view>
        <view wx:if="{{draft.notice}}" class="preview-section"><view class="preview-label">参与须知</view><view class="preview-copy">{{draft.notice}}</view></view><view class="preview-foot">{{templateMode ? '保存到本跑团，团长与管理员均可复用。每次发布仍需确认日期。' : '活动仅对本跑团成员开放，发布后可邀请团友报名。'}}</view>
        <button wx:if="{{!templateMode}}" class="preview-save-template" bindtap="saveTemplate">把这套安排存为模板 ↗</button>
      </view>
      <view wx:if="{{message}}" class="message" role="alert">{{message}}</view>
      <view class="bottom-actions"><button wx:if="{{!templateMode}}" class="save-action" disabled="{{busy}}" bindtap="saveDraft">保存草稿</button><button wx:else class="save-action" disabled="{{templateBusy}}" bindtap="cancelTemplateEdit">退出编辑</button><button wx:if="{{step > 1}}" class="back-action" disabled="{{busy || templateBusy}}" bindtap="back">上一步</button><button wx:if="{{step < 3}}" class="next-action" bindtap="next">继续 <text>→</text></button><button wx:elif="{{templateMode}}" class="next-action" disabled="{{templateBusy}}" bindtap="saveTemplate">保存模板 <text>✓</text></button><button wx:else class="next-action" loading="{{busy}}" disabled="{{busy}}" bindtap="publish">{{busy ? '正在发布' : '确认发布'}} <text wx:if="{{!busy}}">↗</text></button></view>
    </block>
  </block>
</view>
<view wx:if="{{templateSheetOpen && club.staff}}" class="template-overlay" bindtap="closeTemplateSheet" catchtouchmove="noop"><view class="template-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="section-kicker">留给下一次的好安排</view><view class="sheet-title">{{editingTemplateId && templateMode ? '更新跑团模板' : '保存为跑团模板'}}</view><view class="sheet-description">保留训练内容、地点、分组和常用时刻。<view>本次日期与期次不写入模板。</view></view><view class="label">模板名称</view><input class="field" maxlength="30" value="{{templateName}}" bindinput="inputTemplateName" placeholder="例如：周三间歇、周末长距离" aria-label="保存的模板名称" /><view wx:if="{{templateMessage}}" class="message">{{templateMessage}}</view><view class="sheet-actions"><button class="sheet-cancel" disabled="{{templateBusy}}" bindtap="closeTemplateSheet">再想想</button><button class="sheet-save" loading="{{templateBusy}}" disabled="{{templateBusy}}" bindtap="confirmSaveTemplate">{{templateBusy ? '正在保存' : '保存模板'}}</button></view></view></view>
