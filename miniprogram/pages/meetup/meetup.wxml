<view class="page club-detail mini-meetup-meetup service-page service-session meetup-service" wx:if="{{meetup}}">
  <view class="card detail-hero"><view class="detail-kicker">跑团约跑</view>
    <view class="h2">{{meetup.place || "跑团约跑"}}</view><view class="session-appointment"><text class="appointment-label">约跑时间</text><view>{{meetup.dateLabel}}</view></view>
    <view class="session-my-state"><text>{{meetup.statusLabel}}</text><text>{{meetup.canUncheck ? "我已打卡" : meetup.canLeave ? "我已参加" : "我的参与"}}</text></view>
    <view wx:if="{{meetup.note}}" class="src">{{meetup.note}}</view>
    <view class="sum">{{meetup.hint}}</view>
    <button class="fold-toggle" data-key="shareExpanded" bindtap="toggleDetailSection"><text>查看邀请文字</text><text>{{shareExpanded ? "−" : "+"}}</text></button><view wx:if="{{shareExpanded}}" class="share-copy">{{meetup.shareText}}</view>

  </view><view wx:if="{{meetup.canJoin || meetup.canLeave || meetup.canCheck || meetup.canUncheck || meetup.canPhoto}}" class="card stage-action"><view class="service-section-heading"><view class="h2">我的参与</view><text>{{meetup.canCheck ? "到场后打卡" : "本场约跑"}}</text></view><view class="stage-actions">
    <button wx:if="{{meetup.canJoin}}" class="btn" bindtap="join">算我一个</button>
    <button wx:if="{{meetup.canLeave}}" class="ghost" bindtap="leave">不算我了</button>
    <button wx:if="{{meetup.canCheck}}" class="btn" bindtap="check">打卡</button>
    <button wx:if="{{meetup.canUncheck}}" class="ghost" bindtap="uncheck">撤销打卡</button>
    <button wx:if="{{meetup.canPhoto}}" class="ghost" bindtap="choose">上传合影</button>
    </view></view><view class="detail-actions service-share-actions"><button class="ghost" open-type="share">邀请跑友</button><button class="ghost" data-text="{{meetup.shareText}}" bindtap="copyText">复制约跑信息</button></view>
  <view class="card">
    <view class="service-section-heading"><view class="h2">参与名单</view><text>{{meetup.joins.length}} 人</text></view>
    <view wx:for="{{meetup.joins}}" wx:key="userId" class="row"><text>{{item.nickname}}{{item.mine ? ' · 我' : ''}}</text></view>
    <view wx:if="{{!meetup.joins.length}}" class="src">还没有人预报，邀请跑友一起出发。</view>
  </view>
  <view class="card">
    <view class="service-section-heading"><view class="h2">到场打卡</view><text>{{meetup.checkCount}} 人</text></view>
    <view wx:for="{{meetup.checks}}" wx:key="userId" class="row"><text>{{item.nickname}}{{item.mine ? ' · 我' : ''}}</text></view>
    <view wx:if="{{!meetup.checks.length}}" class="src">还没有人打卡。</view>
  </view>
  <view class="card">
    <view class="service-section-heading"><view class="h2">约跑合影</view><text>{{meetup.photos.length}} 张</text></view>
    <image wx:for="{{meetup.photos}}" wx:key="id" class="qr" src="{{item.src}}" mode="widthFix" />
    <view wx:if="{{!meetup.photos.length}}" class="src">还没有合影。至少 1 张，最多 9 张。</view>
  </view>
  <view class="card management-card" wx:if="{{meetup.canStaff || meetup.canVoid}}"><button class="fold-toggle" data-key="managerExpanded" bindtap="toggleDetailSection"><text>约跑管理</text><text>{{managerExpanded ? "−" : "+"}}</text></button><view wx:if="{{managerExpanded}}"><view wx:if="{{meetup.canStaff}}">
    <view class="src">7 天内可以补打卡、补合影，再重算。作废会把已经发出的积分扣回。</view>
    <view class="src">当前：{{forName || '还没选'}}</view>
    <picker mode="selector" range="{{members}}" range-key="nickname" bindchange="selectDetailMember"><view class="detail-select">{{forName || "选择跑团成员"}}<text>⌄</text></view></picker>
    <button class="btn" bindtap="staffCheck">补打卡</button>
    <button class="ghost" bindtap="resettle">重算</button></view><button wx:if="{{meetup.canVoid}}" class="ghost" bindtap="voidRun">作废</button></view>
  </view>
  <view wx:if="{{message}}" class="src">{{message}}</view>
</view>
<view wx:else class="meetup-state service-page">
  <view class="state-title">{{loading ? '正在加载约跑…' : '暂时无法打开约跑'}}</view>
  <view wx:if="{{!loading}}" class="src">{{message || '没有找到这场约跑'}}</view>
  <button wx:if="{{!loading}}" class="btn" bindtap="load">重新加载</button>
</view>
