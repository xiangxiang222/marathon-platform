@import "../../utils/club-detail.wxss";
.src { color: var(--text-secondary); font-size: 12px; margin-top: 8rpx; white-space: pre-wrap; }
.sum { margin-top: 16rpx; font-weight: 600; }
.qr { width: 100%; margin-top: 16rpx; border-radius: 12rpx; }
.card .btn { margin-top: 16rpx;  }
.meetup-state { margin: 32rpx; padding: 48rpx 32rpx;  background: var(--page-bg); text-align: center; }
.state-title { color: var(--text); font-size: 18px; font-weight: 600; }
.meetup-state .btn { margin-top: 28rpx;  }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-meetup-meetup .card, .mini-meetup-meetup .meetup-state { border-radius:12px; }
.mini-meetup-meetup .btn, .mini-meetup-meetup .ghost, .mini-meetup-meetup .fold-toggle { border-radius:12px; }
.mini-meetup-meetup { color: var(--text); background: transparent; }
.mini-meetup-meetup button { font-weight: 500; border-radius:12px; }

.club-detail .card { border: 1px solid var(--border); }
.club-detail .title { font-size: 24px; font-weight: 600; line-height: 1.5; }
.sum,.share-copy { font-size: 14px; line-height: 1.8; }
.row { gap: 20rpx; padding: 24rpx 0; font-size: 14px; }
input,textarea { width: 100%; min-height: 44px; padding: 18rpx 22rpx; border: 1px solid var(--border); border-radius:12px; background: var(--page-bg); font-size: 14px; box-sizing: border-box; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-meetup-meetup .btn { font-size: 14px; font-weight: 500; }
.mini-meetup-meetup .ghost, .mini-meetup-meetup .fold-toggle { font-size: 13px; font-weight: 500; }
.detail-hero { background: var(--surface); box-shadow: none; }
.mini-meetup-meetup > .card:nth-child(2) { background: #ffffff; }

@import "../../utils/service-ui.wxss";
