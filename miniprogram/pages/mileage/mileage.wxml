<view class="pad mini-mileage-mileage">
  <mileage-board id="mileage-board" club-id="{{clubId}}" />
  <button class="mileage-tools-toggle" bindtap="toggleTools"><text>跑步动态、报表与计入规则</text><text>{{toolsOpen ? '收起 −' : '展开 ＋'}}</text></button>
  <block wx:if="{{toolsOpen && board}}">
  <view class="tools-range-label">跑步动态 · 选择周期</view><view class="range-filters"><button wx:for="{{toolRanges}}" wx:key="id" class="ghost {{range === item.id ? 'on' : ''}}" data-range="{{item.id}}" bindtap="pickRange">{{item.name}}</button></view>
  <view class="card">
    <view class="title">动态</view>
    <view wx:for="{{board.feed}}" wx:key="id">
      <view class="src">{{item.nickname}} · {{item.typeLabel}} · {{item.startedAt}}</view>
      <view class="src">跑量 {{item.volumeKm}} 公里 · {{item.durationLabel}} · 爬升 {{item.climb}} 米</view>
      <view class="src" wx:if="{{item.challenge}}">质疑：{{item.challenge}}</view>
      <input wx:if="{{!item.mine}}" placeholder="写一句质疑" bindinput="onReason" aria-label="写一句质疑" />
      <button wx:if="{{!item.mine}}" class="ghost" data-id="{{item.id}}" bindtap="challenge">质疑</button>
      <view wx:if="{{board.staff}}">
        <button class="ghost" data-id="{{item.id}}" data-keep="0" bindtap="decide">不计入</button>
        <button class="ghost" data-id="{{item.id}}" data-keep="1" bindtap="decide">继续计入</button>
      </view>
    </view>
  </view>
  <view class="card" wx:if="{{report}}">
    <view class="title">报表 {{report.title}}</view>
    <view class="row">
      <button class="ghost {{kind === 'week' ? 'on' : ''}}" data-kind="week" bindtap="pickKind">周报</button>
      <button class="ghost {{kind === 'month' ? 'on' : ''}}" data-kind="month" bindtap="pickKind">月报</button>
      <button class="ghost {{kind === 'year' ? 'on' : ''}}" data-kind="year" bindtap="pickKind">年报</button>
    </view>
    <view wx:for="{{report.rows}}" wx:key="userId" class="src">{{item.place}} {{item.nickname}} {{item.km}} 公里 {{item.dayText}} {{item.durationLabel}} {{item.paceLabel}} {{item.flag}}</view>
    <view class="src">合计 {{report.total.km}} 公里 · {{report.total.dayText}} 次 · {{report.total.durationLabel}}</view>
  </view>
  <view class="card" wx:if="{{board.owner && rules}}">
    <view class="title">本团规则</view>
    <view class="src">{{rules.note}}</view>
    <input data-key="effectiveOn" placeholder="生效日 2026-10-01" value="{{rules.effectiveOn}}" bindinput="onRule" aria-label="生效日 2026-10-01" />
    <button class="ghost {{rules.manualOk ? 'on' : ''}}" data-key="manualOk" bindtap="toggleRule">允许手填</button>
    <button class="ghost {{rules.runOn ? 'on' : ''}}" data-key="runOn" bindtap="toggleRule">跑步计入</button>
    <input data-key="runMin" placeholder="跑步最短公里" value="{{rules.runMin}}" bindinput="onRule" aria-label="跑步最短公里" />
    <input data-key="runMax" placeholder="跑步最长公里" value="{{rules.runMax}}" bindinput="onRule" aria-label="跑步最长公里" />
    <input data-key="paceFast" placeholder="最快配速 3:00" value="{{rules.paceFast}}" bindinput="onRule" aria-label="最快配速 3:00" />
    <input data-key="paceSlow" placeholder="最慢配速 15:00" value="{{rules.paceSlow}}" bindinput="onRule" aria-label="最慢配速 15:00" />
    <button class="ghost {{rules.trailOn ? 'on' : ''}}" data-key="trailOn" bindtap="toggleRule">越野计入</button>
    <button class="ghost {{rules.trailClimbAdd ? 'on' : ''}}" data-key="trailClimbAdd" bindtap="toggleRule">越野每 100 米爬升加 1 公里</button>
    <input data-key="trailMin" placeholder="越野最短公里" value="{{rules.trailMin}}" bindinput="onRule" aria-label="越野最短公里" />
    <input data-key="trailClimb" placeholder="最低爬升米" value="{{rules.trailClimb}}" bindinput="onRule" aria-label="最低爬升米" />
    <input data-key="flagFemale" placeholder="女生月度下限" value="{{rules.flagFemale}}" bindinput="onRule" aria-label="女生月度下限" />
    <input data-key="flagMale" placeholder="男生月度下限" value="{{rules.flagMale}}" bindinput="onRule" aria-label="男生月度下限" />
    <button class="ghost {{rules.observe ? 'on' : ''}}" data-key="observe" bindtap="toggleRule">当月入团自动观摩</button>
    <button class="btn" bindtap="saveRules">保存规则</button>
  </view>

  <view class="card" wx:if="{{board.owner}}"><view class="title">导出跑量报表</view><button class="ghost {{includeEmpty ? 'on' : ''}}" bindtap="toggleEmpty">没有记录的成员也导出</button><button class="btn" bindtap="exportSheet">复制{{kind === 'week' ? '周' : kind === 'year' ? '年' : '月'}}报表</button></view>
  </block><view wx:if="{{toolsOpen && message}}" class="err">{{message}}</view>
</view>
