olor:#5c7163;overflow-wrap:anywhere}.report-person-top>view{flex:none;color:#76987f;font-size:19px;font-weight:600;letter-spacing:-.6rpx}.report-person-top>view>text{font-size:9px;color:#abbcaf;font-weight:400}.report-person-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8rpx;margin-top:12rpx;font-size:9px;color:#abb5ad}.report-person-flag{margin-top:8rpx;font-size:9px;color:#b5aa8f}.report-chevron{color:#c0cbc2;font-size:16px;flex:none}.report-footer{margin-top:26rpx;text-align:center;font-size:9px;color:#b1bcb3}.report-empty{padding:36rpx 0;color:#a8b5aa;font-size:12px;line-height:1.8}
