.mini-mileage-mileage{padding:0 16px 24px;color:var(--text);font-size:14px}.mini-mileage-mileage .card{margin:12px 0;padding:16px;border:0;border-radius:12px;background:#fff}.title,.report-heading{margin:0;font-size:18px;font-weight:600;line-height:1.4}.src{margin-top:8px;color:var(--text-secondary);font-size:12px;line-height:1.7}.mini-mileage-mileage button{width:auto;min-height:44px;border-radius:8px;font-size:14px;font-weight:500}.mini-mileage-mileage .btn{width:100%;margin-top:12px;background:var(--brand);color:#fff}.mini-mileage-mileage .ghost{margin-top:8px;padding:0 10px;color:var(--text);background:var(--page-bg)}.mini-mileage-mileage input{box-sizing:border-box;width:100%;height:44px;min-height:44px;margin-top:10px;padding:0 12px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font-size:14px}.mini-mileage-mileage .mileage-tools-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:52px;margin:0;padding:0;border:0;border-top:1px solid var(--border);border-radius:0;background:transparent;color:var(--text);font-size:14px;text-align:left}.mileage-tools-toggle>text:last-child{flex:none;font-size:12px;color:var(--text-secondary)}.tools-range-label{margin-top:16px;font-size:12px;color:var(--text-secondary)}.range-filters{display:flex;gap:8px}.range-filters .ghost{flex:1;min-width:0;margin:8px 0;font-size:12px}.range-filters .ghost.on{background:var(--brand-soft);color:var(--brand)}
.report-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.report-eyebrow{font-size:12px;color:var(--text-secondary)}.report-kinds{display:flex;border-bottom:1px solid var(--border)}.mini-mileage-mileage .report-kind{flex:1;min-height:44px;margin:0;border:0;border-radius:0;background:transparent;color:var(--text-secondary);font-size:14px}.mini-mileage-mileage .report-kind.selected{color:var(--brand);box-shadow:inset 0 -2px var(--brand)}.report-date{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;color:var(--text);font-size:14px}.report-date>text{flex:none;font-size:12px;color:var(--text-secondary)}.report-summary{display:flex;gap:16px;padding:14px;border-radius:8px;background:var(--page-bg)}.report-summary>view{display:flex;flex-direction:column;flex:1;min-width:0;gap:6px}.report-summary>view>text:first-child{font-size:28px;font-weight:600;color:var(--text);font-variant-numeric:tabular-nums}.report-summary>view+view>text:first-child{font-size:22px}.report-summary>view>text:last-child{font-size:12px;color:var(--text-secondary)}.report-list-note{display:flex;justify-content:space-between;margin-top:12px;color:var(--text-secondary);font-size:12px}.mini-mileage-mileage .report-person{display:flex;align-items:center;gap:8px;width:100%;min-height:72px;margin:0;padding:12px 0;border:0;border-bottom:1px solid var(--border);border-radius:0;background:transparent;text-align:left;line-height:1.5}.report-place{width:14px;flex:none;color:var(--text-secondary);font-size:12px}.report-avatar{width:36px;height:36px;border-radius:8px;flex:none}.report-fallback{display:flex;align-items:center;justify-content:center;background:var(--page-bg);color:var(--text-secondary);font-size:14px}.report-person-copy{flex:1;min-width:0}.report-person-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.report-person-top>text{font-size:14px;color:var(--text);overflow-wrap:anywhere}.report-person-top>view{flex:none;color:var(--text);font-size:20px;font-weight:600}.report-person-top>view>text{font-size:12px;color:var(--text-secondary);font-weight:400}.report-person-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px;margin-top:5px;font-size:12px;color:var(--text-secondary)}.report-person-flag{margin-top:4px;font-size:12px;color:var(--text-secondary)}.report-chevron{color:var(--text-secondary);font-size:16px;flex:none}.report-footer{margin-top:12px;text-align:center;font-size:12px;color:var(--text-secondary)}.report-empty{padding:20px 0;color:var(--text-secondary);font-size:14px;line-height:1.8}
