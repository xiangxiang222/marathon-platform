input { width: 100%; height: 80rpx; margin-top: 16rpx; padding: 0 20rpx; box-sizing: border-box; }
.src { color: var(--text-secondary); font-size: 12px; margin-top: 8rpx; }

.range-filters { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.range-filters .ghost { flex: 1; margin: 0; padding: 0 12rpx;  }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-mileage-mileage .card { border-radius: 32rpx; }
.mini-mileage-mileage .btn, .mini-mileage-mileage .ghost { border-radius: 24rpx; }

/* Page composition and interaction hierarchy. */
.mini-mileage-mileage { color: var(--text); }
.mini-mileage-mileage button { font-weight: 500; border-radius: 24rpx; }

.card { border: 1px solid var(--border); }
.title { font-size: 22px; font-weight: 600; line-height: 1.45; }
.range-filters { gap: 12rpx; }
.range-filters .ghost { min-height: 36px; min-width: 72rpx; border: 1px solid var(--border); border-radius: 14rpx; background: var(--card,#fff); }
.range-filters .ghost.on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
input { min-height: 44px; border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); font-size: 14px; }
.row { gap: 24rpx; padding: 24rpx 0; font-size: 14px; }
.row > text:first-child { flex: 1; min-width: 0; }
.row > text:last-child { flex: none; font-variant-numeric: tabular-nums; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-mileage-mileage .btn { font-size: 14px; font-weight: 500; }
.mini-mileage-mileage .ghost { font-size: 14px; font-weight: 500; }
.range-filters .ghost { font-size: 12px; }
.card .title { font-size: 18px; } .card:first-child .title { font-size: 24px; }

/* Color surfaces use existing semantic page elements; layout stays unchanged. */
.mini-mileage-mileage > .card:first-child { background: var(--card,#fff); box-shadow: none; }
.mini-mileage-mileage .card:nth-child(3) { background: var(--card,#fff); }

.mini-mileage-mileage .mileage-tools-toggle { display:flex; align-items:center; justify-content:space-between; gap:16rpx; width:100%; min-height:52px; margin:24rpx 0; padding:0 12rpx; border:0; border-radius:0; background:transparent; color:var(--text-secondary); font-size:12px; }
.tools-range-label { margin-top:26rpx; font-size:12px; color:var(--text-secondary); }
.mini-mileage-mileage .mileage-report-card{padding:28rpx;border:0;background:var(--card,#fff);border-radius:28rpx}.report-eyebrow{color:var(--text-secondary);font-size:12px;letter-spacing:normal}.report-heading{margin:16rpx 0 24rpx;color:var(--text);font-size:22px;font-weight:600}.report-heading>text{color:var(--text-secondary)}.report-kinds{display:flex;gap:8rpx;padding:8rpx;background:var(--field-bg,var(--page-bg));border-radius:20rpx}.mini-mileage-mileage .report-kind{flex:1;margin:0;border:0;min-height:42px;border-radius:14rpx;background:transparent;color:var(--text-secondary);font-size:14px}.mini-mileage-mileage .report-kind.selected{background:var(--card,#fff);color:var(--text-secondary);font-weight:600}.report-date{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:54px;color:var(--text-secondary);font-size:12px}.report-date>text{color:var(--text-secondary);font-size:12px;flex:none}.report-summary{display:flex;gap:20rpx;padding:26rpx;border-radius:20rpx;background:var(--card,#fff)}.report-summary>view{flex:1;display:flex;flex-direction:column;gap:14rpx}.report-summary>view>text:first-child{font-size:24px;font-weight:600;letter-spacing:normal;color:var(--text-secondary);font-variant-numeric:tabular-nums}.report-summary>view>text:last-child{font-size:12px;color:var(--text-secondary)}.report-list-note{display:flex;justify-content:space-between;margin-top:26rpx;color:var(--text-secondary);font-size:12px}.mini-mileage-mileage .report-person{display:flex;align-items:center;gap:18rpx;width:100%;margin:0;padding:28rpx 0;border:0;border-bottom:1rpx solid var(--border);border-radius:0;background:var(--card,#fff);text-align:left;min-height:80px;line-height:1.5}.report-place{width:24rpx;flex:none;color:var(--text-secondary);font-size:12px}.report-place.leading{color:var(--text-secondary)}.report-avatar{width:66rpx;height:66rpx;border-radius:50%;flex:none}.report-fallback{display:flex;align-items:center;justify-content:center;background:var(--field-bg,var(--page-bg));color:var(--text-secondary);font-size:14px}.report-person-copy{flex:1;min-width:0}.report-person-top{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.report-person-top>text{font-size:14px;color:var(--text-secondary);overflow-wrap:anywhere}.report-person-top>view{flex:none;color:var(--text-secondary);font-size:18px;font-weight:600;letter-spacing:normal}.report-person-top>view>text{font-size:12px;color:var(--text-secondary);font-weight:400}.report-person-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8rpx;margin-top:12rpx;font-size:12px;color:var(--text-secondary)}.report-person-flag{margin-top:8rpx;font-size:12px;color:var(--text-secondary)}.report-chevron{color:var(--text-secondary);font-size:16px;flex:none}.report-footer{margin-top:26rpx;text-align:center;font-size:12px;color:var(--text-secondary)}.report-empty{padding:36rpx 0;color:var(--text-secondary);font-size:12px;line-height:1.8}

.mini-mileage-mileage { font-size:14px; color:var(--text); }
.mini-mileage-mileage>.card:first-child,.mini-mileage-mileage .mileage-report-card { border:1rpx solid var(--border); border-radius:24rpx; background:var(--card,#fff); box-shadow:none; }
.mini-mileage-mileage .mileage-tools-toggle { min-height:48px; color:var(--text); font-size:14px; border-top:1rpx solid var(--border); }
.report-eyebrow,.report-date>text,.report-list-note,.report-person-meta,.report-person-flag,.report-footer { font-size:12px; color:var(--text-secondary); letter-spacing:normal; }
.report-heading { font-size:18px; color:var(--text); font-weight:600; letter-spacing:normal; }
.report-heading>text { color:var(--brand); }
.report-kinds { background:transparent; padding:0; border-radius:0; border-bottom:1rpx solid var(--border); }
.mini-mileage-mileage .report-kind { min-height:44px; border-radius:0; color:var(--text-secondary); font-size:14px; }
.mini-mileage-mileage .report-kind.selected { background:transparent; color:var(--brand); box-shadow:inset 0 -2px var(--brand); font-weight:500; }
.report-summary { background:var(--page-bg); border-radius:20rpx; }
.report-summary>view>text:first-child { font-size:24px; color:var(--text); font-weight:600; letter-spacing:normal; }
.report-summary>view>text:last-child { font-size:12px; color:var(--text-secondary); }
.report-person-top>text { font-size:14px; color:var(--text); }
.report-person-top>view { font-size:20px; color:var(--text); font-weight:600; letter-spacing:normal; }
.report-person-top>view>text { font-size:12px; color:var(--text-secondary); }
.report-place.leading { color:var(--brand); }
.report-fallback { color:var(--text-secondary); background:var(--page-bg); }
.range-filters .ghost { min-height:44px; border-radius:20rpx; }
