input { width: 100%; height: 80rpx; margin-top: 16rpx; padding: 0 20rpx; box-sizing: border-box; }
.src { color: var(--text-secondary); font-size: 12px; margin-top: 8rpx; }

.range-filters { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.range-filters .ghost { flex: 1; margin: 0; padding: 0 12rpx;  }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-mileage-mileage .card { border-radius: 36rpx; }
.mini-mileage-mileage .btn, .mini-mileage-mileage .ghost { border-radius: 24rpx; }

/* Page composition and interaction hierarchy. */
.mini-mileage-mileage { color: var(--text); }
.mini-mileage-mileage button { font-weight: 500; border-radius: 24rpx; }

.card { border: 1px solid var(--border); }
.title { font-size: 22px; font-weight: 600; line-height: 1.45; }
.range-filters { gap: 12rpx; }
.range-filters .ghost { min-height: 36px; min-width: 72rpx; border: 1px solid var(--border); border-radius: 14rpx; background: #fff; }
.range-filters .ghost.on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
input { min-height: 44px; border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); font-size: 14px; }
.row { gap: 24rpx; padding: 24rpx 0; font-size: 14px; }
.row > text:first-child { flex: 1; min-width: 0; }
.row > text:last-child { flex: none; font-variant-numeric: tabular-nums; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-mileage-mileage .btn { font-size: 14px; font-weight: 500; }
.mini-mileage-mileage .ghost { font-size: 13px; font-weight: 500; }
.range-filters .ghost { font-size: 12px; }
.card .title { font-size: 18px; } .card:first-child .title { font-size: 24px; }

/* Color surfaces use existing semantic page elements; layout stays unchanged. */
.mini-mileage-mileage > .card:first-child { background: linear-gradient(135deg,#e9f7f2,#ffffff); box-shadow: var(--card-shadow); }
.mini-mileage-mileage .card:nth-child(3) { background: #ffffff; }

.mini-mileage-mileage .mileage-tools-toggle { display:flex; align-items:center; justify-content:space-between; gap:16rpx; width:100%; min-height:52px; margin:24rpx 0; padding:0 12rpx; border:0; border-radius:0; background:transparent; color:#849589; font-size:12px; }
.tools-range-label { margin-top:26rpx; font-size:12px; color:#8e9e92; }
