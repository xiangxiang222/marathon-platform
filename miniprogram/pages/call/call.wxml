<view class="pad" wx:if="{{call}}">
  <view class="card">
    <view class="h2">{{call.title}}</view>
    <view class="src">{{call.raceDate}} · 截止 {{call.deadlineLabel}}{{call.closed ? ' · 已截止' : ''}}</view>
    <view wx:if="{{call.note}}" class="src">{{call.note}}</view>
    <view class="sum">{{call.summary}}</view>
    <view class="src">{{call.shareText}}</view>
    <button class="btn" open-type="share">发到微信群</button>
    <button class="ghost" data-text="{{call.boardText}}" bindtap="copyText">复制成绩榜</button>
    <button class="ghost" bindtap="exportPoster">生成成绩长图</button>
  </view>
  <view class="card" wx:if="{{!call.closed}}">
    <view class="h2">填写</view>
    <view class="src">距离：{{distanceLabel || '还没选'}}</view>
    <button wx:for="{{options}}" wx:key="id" class="ghost" data-id="{{item.id}}" data-label="{{item.label}}" bindtap="pickDistance">{{item.label}}</button>
    <view class="stack">
      <input placeholder="1:32:10 或 45:30" value="{{time}}" bindinput="onTime" />
    </view>
    <button class="btn" bindtap="submitOwn">提交</button>
    <button class="ghost" bindtap="chooseSheet">证书或截图</button>
    <view class="src">先提交这条距离的成绩，再上传截图。</view>
  </view>
  <view wx:else class="card"><view class="src">已经截止。要改自己的成绩，请让团长把截止延后。</view></view>
  <view wx:for="{{call.groups}}" wx:for-item="group" wx:key="distance" class="card">
    <view class="h2">{{group.label}}</view>
    <view wx:for="{{group.rows}}" wx:for-item="row" wx:key="id">
      <view class="row">
        <text>{{row.place}} {{row.nickname}}{{row.mine ? ' · 我' : ''}}{{row.staffFilled ? ' · 管理员补录' : ''}}</text>
        <text>{{row.clock}} {{row.tag}}</text>
      </view>
      <image wx:if="{{row.sheetSrc}}" src="{{row.sheetSrc}}" mode="widthFix" />
      <text wx:if="{{staff || (row.mine && !call.closed)}}" class="drop" data-id="{{row.id}}" bindtap="removeRow">删除</text>
    </view>
  </view>
  <view class="card" wx:if="{{staff}}">
    <view class="h2">管理</view>
    <input placeholder="截止 2026-11-22 22:00" value="{{deadline}}" bindinput="onDeadline" />
    <button class="btn" bindtap="saveDeadline">改截止</button>
    <view class="src">给不会操作的成员补一条。当前：{{forName || '还没选'}} · {{forLabel || '距离'}}</view>
    <button wx:for="{{members}}" wx:key="id" class="ghost" data-id="{{item.id}}" data-name="{{item.nickname}}" bindtap="pickMember">{{item.nickname}}</button>
    <button wx:for="{{options}}" wx:key="id" class="ghost" data-id="{{item.id}}" data-label="{{item.label}}" bindtap="pickForDistance">补 {{item.label}}</button>
    <input placeholder="成绩" value="{{forTime}}" bindinput="onForTime" />
    <button class="btn" bindtap="fillFor">补录</button>
  </view>
  <view wx:if="{{!call.groups.length}}" class="empty">还没有人填写。</view>
  <view wx:if="{{message}}" class="err">{{message}}</view>
</view>
<view wx:else class="empty">{{message || '正在打开'}}</view>
<canvas type="2d" id="call-poster" class="call-poster-canvas"></canvas>
<view wx:if="{{posterPath}}" class="poster-layer" bindtap="closePoster" catchtouchmove="noop">
  <view class="poster-frame" catchtap="noop">
    <image class="poster-image" src="{{posterPath}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
    <view class="poster-hint">长按图片保存到相册 · 点击空白处关闭</view>
  </view>
</view>
