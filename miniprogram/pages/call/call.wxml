<view class="pad club-detail mini-call-call service-page service-session result-service" wx:if="{{call}}">
  <view class="card detail-hero"><view class="detail-kicker">跑团成绩接龙</view>
    <view class="h2">{{call.title}}</view>
    <view class="src">{{call.raceDate}} · 截止 {{call.deadlineLabel}}{{call.closed ? ' · 已截止' : ''}}</view>
    <view wx:if="{{call.note}}" class="src">{{call.note}}</view>
    <view class="session-my-state"><text>{{call.closed ? "接龙已截止" : "接龙进行中"}}</text><text>{{call.summary}}</text></view>
    <button class="fold-toggle" data-key="shareExpanded" bindtap="toggleDetailSection"><text>分享与导出成绩</text><text>{{shareExpanded ? "−" : "+"}}</text></button><view wx:if="{{shareExpanded}}" class="share-copy">{{call.shareText}}</view>
    <view wx:if="{{shareExpanded}}" class="detail-actions"><button class="ghost" open-type="share">邀请接龙</button>
    <button class="ghost" data-text="{{call.boardText}}" bindtap="copyText">复制成绩榜</button>
    <button class="ghost" bindtap="exportPoster">生成成绩长图</button></view>
  </view>
  <view class="card" wx:if="{{!call.closed}}">
    <view class="service-section-heading"><view class="h2">记录我的成绩</view><text>完赛用时</text></view>
    <view class="src">距离：{{distanceLabel || '还没选'}}</view>
    <view class="detail-options"><button wx:for="{{options}}" wx:key="id" class="ghost {{distance === item.id ? 'on' : ''}}" data-id="{{item.id}}" data-label="{{item.label}}" bindtap="pickDistance">{{item.label}}</button></view>
    <view class="stack">
      <input placeholder="1:32:10 或 45:30" value="{{time}}" bindinput="onTime" aria-label="1:32:10 或 45:30" />
    </view>
    <button class="btn" bindtap="submitOwn">提交</button>
    <button class="ghost" bindtap="chooseSheet">证书或截图</button>
    <view class="src">先提交这条距离的成绩，再上传截图。</view>
  </view>
  <view wx:else class="card"><view class="src">已经截止。要改自己的成绩，请让团长把截止延后。</view></view>
  <view wx:for="{{call.groups}}" wx:for-item="group" wx:key="distance" class="card">
    <view class="service-section-heading"><view class="h2">{{group.label}}</view><text>{{group.rows.length}} 位跑友</text></view>
    <view wx:for="{{group.rows}}" wx:for-item="row" wx:key="id">
      <view class="row">
        <text>{{row.place}} {{row.nickname}}{{row.mine ? ' · 我' : ''}}{{row.staffFilled ? ' · 管理员补录' : ''}}</text>
        <text>{{row.clock}} {{row.tag}}</text>
      </view>
      <image wx:if="{{row.sheetSrc}}" src="{{row.sheetSrc}}" mode="widthFix" />
      <text wx:if="{{staff || (row.mine && !call.closed)}}" class="drop" data-id="{{row.id}}" bindtap="removeRow">删除</text>
    </view>
  </view>
  <view class="card management-card" wx:if="{{staff}}"><button class="fold-toggle" data-key="managerExpanded" bindtap="toggleDetailSection"><text>接龙管理 · 截止与补录</text><text>{{managerExpanded ? "−" : "+"}}</text></button><view wx:if="{{managerExpanded}}">
    <input placeholder="截止 2026-11-22 22:00" value="{{deadline}}" bindinput="onDeadline" aria-label="截止 2026-11-22 22:00" />
    <button class="btn" bindtap="saveDeadline">改截止</button>
    <view class="src">给不会操作的成员补一条。当前：{{forName || '还没选'}} · {{forLabel || '距离'}}</view>
    <picker mode="selector" range="{{members}}" range-key="nickname" bindchange="selectDetailMember"><view class="detail-select">{{forName || "选择跑团成员"}}<text>⌄</text></view></picker>
    <view class="detail-options"><button wx:for="{{options}}" wx:key="id" class="ghost {{forDistance === item.id ? 'on' : ''}}" data-id="{{item.id}}" data-label="{{item.label}}" bindtap="pickForDistance">补 {{item.label}}</button></view>
    <input placeholder="成绩" value="{{forTime}}" bindinput="onForTime" aria-label="成绩" />
    <button class="btn" bindtap="fillFor">补录</button></view>
  </view>
  <view wx:if="{{!call.groups.length}}" class="empty">还没有人填写。</view>
  <view wx:if="{{message}}" class="err">{{message}}</view>
</view>
<view wx:else class="detail-state service-page"><view class="state-title">{{loading ? "正在打开成绩接龙…" : "暂时无法打开接龙"}}</view><view wx:if="{{!loading}}" class="src">{{message || "没有找到这场接龙"}}</view><button wx:if="{{!loading}}" class="btn" bindtap="load">重新加载</button></view>
<canvas type="2d" id="call-poster" class="call-poster-canvas"></canvas>
<view wx:if="{{posterPath}}" class="poster-layer" bindtap="closePoster" catchtouchmove="noop">
  <view class="poster-frame" catchtap="noop">
    <image class="poster-image" src="{{posterPath}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
    <view class="poster-hint">长按图片保存到相册 · 点击空白处关闭</view>
  </view>
</view>
