.src { color: #8a8e99; font-size: 26rpx; margin-top: 8rpx; white-space: pre-wrap; }
.sum { margin-top: 16rpx; font-weight: 650; }
.stack input { width: 100%; height: 80rpx; margin-top: 16rpx; background: #f5f6fa; border-radius: 16rpx; padding: 0 20rpx; box-sizing: border-box; }
image { width: 100%; margin-top: 8rpx; border-radius: 12rpx; }
.drop { color: #ff0a30; font-size: 26rpx; }
input { width: 100%; height: 80rpx; margin-top: 16rpx; background: #f5f6fa; border-radius: 16rpx; padding: 0 20rpx; box-sizing: border-box; }
.call-poster-canvas { position: fixed; left: -2000px; top: 0; width: 1px; height: 1px; pointer-events: none; }
.poster-layer { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 24rpx; box-sizing: border-box; background: rgba(20, 22, 28, .76); }
.poster-frame { width: 100%; max-width: 680rpx; max-height: 92vh; overflow-y: auto; text-align: center; }
.poster-image { display: block; width: 100%; border-radius: 12rpx; }
.poster-hint { padding: 18rpx 0; color: #fff; font-size: 24rpx; }
