@import "../../utils/club-detail.wxss";
.src { color: var(--text-secondary); font-size: 12px; margin-top: 8rpx; white-space: pre-wrap; }
.sum { margin-top: 16rpx; font-weight: 600; background: rgba(255,255,255,.65); }
.stack input { width: 100%; height: 80rpx; margin-top: 16rpx; background: var(--page-bg); border-radius: 16rpx; padding: 0 20rpx; box-sizing: border-box; }
image { width: 100%; margin-top: 8rpx; border-radius: 12rpx; }
.drop { color: var(--brand); font-size: 12px; }
input { width: 100%; height: 80rpx; margin-top: 16rpx; background: var(--page-bg); border-radius: 16rpx; padding: 0 20rpx; box-sizing: border-box; }
.call-poster-canvas { position: fixed; left: -2000px; top: 0; width: 1px; height: 1px; pointer-events: none; }
.poster-layer { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 24rpx; box-sizing: border-box; background: rgba(20, 22, 28, .76); }
.poster-frame { width: 100%; max-width: 680rpx; max-height: 92vh; overflow-y: auto; text-align: center; }
.poster-image { display: block; width: 100%; border-radius: 12rpx; }
.poster-hint { padding: 18rpx 0; color: #fff; font-size: 12px; }

.detail-state { margin: 32rpx; padding: 40rpx 28rpx;  background: var(--page-bg); text-align: center; }
.state-title { font-size: 18px; font-weight: 600; }
.detail-state .btn { margin-top: 28rpx; display: flex; align-items: center; justify-content: center; min-height:44px; line-height: 1.35;  }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-call-call .card, .mini-call-call .detail-state { border-radius:12px; }
.mini-call-call .btn, .mini-call-call .ghost, .mini-call-call .fold-toggle { border-radius:12px; }
.mini-call-call { color: var(--text); background: transparent; }
.mini-call-call button { font-weight: 500; border-radius:12px; }

.club-detail .card { border: 1px solid var(--border); }
.club-detail .title { font-size: 24px; font-weight: 600; line-height: 1.5; }
.detail-options { border-bottom: 1px solid var(--border); }
.detail-options .ghost { border-radius: 0; background: transparent; font-size: 13px; }
.detail-options .ghost.on { color: var(--text); box-shadow: none; background: transparent; }
.stack input,input { min-height: 44px; border: 1px solid var(--border); border-radius:12px; background: var(--page-bg); font-size: 14px; }
.sum { padding: 24rpx; border-radius:12px; background: rgba(255,255,255,.65); font-size: 14px; line-height: 1.8; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-call-call .btn { font-size: 14px; font-weight: 500; }
.mini-call-call .ghost, .mini-call-call .fold-toggle { font-size: 13px; font-weight: 500; }
.detail-hero { background: var(--surface); box-shadow: none; }
.mini-call-call > .card:nth-child(2) { background: #ffffff; }

@import "../../utils/service-ui.wxss";
