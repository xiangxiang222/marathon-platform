<view class="runner-page">
  <scroll-view class="view-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="view-tabs"><view wx:for="{{views}}" wx:key="key" class="view-tab {{view === item.key ? 'on' : ''}}" data-view="{{item.key}}" bindtap="pickView" role="button" aria-label="{{item.title}}">{{item.title}}</view></view>
  </scroll-view>
  <view class="page-heading"><view class="eyebrow">MY RUNNING JOURNEY</view><view class="page-title">{{currentView.title}}</view><view class="page-subtitle">{{currentView.caption}}</view><image class="heading-icon" src="{{currentView.icon}}" mode="aspectFit"/></view>

  <view wx:if="{{!ready}}" class="surface empty-state">
    <view class="empty-mark"><image src="/images/runner/stats.png" mode="aspectFit"/></view><view class="section-title">你的坚持，值得被记住</view><view class="muted">{{error || '登录后查看专属运动数据、赛事足迹和私密收藏。'}}</view><button class="primary" bindtap="login">登录，开启跑者档案</button>
  </view>
  <view wx:elif="{{loading && !payload}}" class="surface loading-state"><view class="skeleton wide"></view><view class="skeleton number"></view><view class="skeleton"></view><view class="muted">正在整理你的跑步故事…</view></view>
  <view wx:elif="{{error && !payload}}" class="surface empty-state"><view class="empty-mark"><image src="/images/runner/help.png" mode="aspectFit"/></view><view class="section-title">档案暂时没有打开</view><view class="muted">{{error}}</view><button class="primary" bindtap="load">重新加载</button></view>

  <block wx:elif="{{payload}}">
    <view wx:if="{{error}}" class="retry-strip"><text>{{error}}</text><button bindtap="load">重试</button></view>
    <block wx:if="{{view === 'stats'}}">
      <view class="period-tabs"><view wx:for="{{periods}}" wx:key="key" class="{{period === item.key ? 'on' : ''}}" data-period="{{item.key}}" bindtap="pickPeriod">{{item.label}}</view></view>
      <view class="surface training-card">
        <view class="section-head"><text class="eyebrow">RUNNING TOTAL</text><text class="privacy">仅自己可见</text></view>
        <view class="training-number">{{payload.training.kmLabel}}<text>公里</text></view>
        <view class="training-metrics"><view><text class="metric-value">{{payload.training.count}}</text><text class="metric-label">运动次数</text></view><view><text class="metric-value">{{payload.training.durationLabel}}</text><text class="metric-label">运动时间</text></view><view><text class="metric-value">{{payload.training.paceLabel || '—'}}</text><text class="metric-label">平均配速</text></view></view>
        <view class="chart-heading"><button class="period-arrow" disabled="{{period === 'all' || loading}}" data-direction="-1" bindtap="movePeriod" aria-label="上一时段">‹</button><text>{{payload.training.label}}</text><button class="period-arrow" disabled="{{offset === 0 || period === 'all' || loading}}" data-direction="1" bindtap="movePeriod" aria-label="下一时段">›</button></view>
        <scroll-view class="bar-scroll" scroll-x show-scrollbar="{{false}}"><view class="bar-chart" style="min-width: {{payload.training.bars.length * 44}}rpx;"><view wx:for="{{payload.training.bars}}" wx:key="key" class="bar-item"><view class="bar-plot"><view class="bar-fill {{item.height ? '' : 'zero'}}" style="height: {{item.height}}%;"></view></view><text class="bar-label">{{item.label}}</text><text class="bar-value">{{item.value}}</text></view></view></scroll-view>
        <view class="data-note">{{payload.training.count ? '以跑步与越野记录的实际距离统计，不与比赛里程重复累加。' : '这一时段还没有运动记录。每一次出发，都是新的积累。'}}</view>
        <view wx:if="{{payload.training.comparisonText}}" class="period-comparison"><text>{{payload.training.isCurrentWeek ? '本周小结' : '时段小结'}}</text><view>{{payload.training.comparisonText}}</view></view>
      </view>
      <view wx:if="{{payload.training.truncated}}" class="data-note center">以下展示最近 100 条运动记录，上方统计包含本时段全部有效记录。</view>
      <view class="two-summary"><view class="surface"><text class="metric-label">累计运动</text><text class="summary-value">{{payload.overview.totalKmLabel}}<text> 公里</text></text></view><view class="surface"><text class="metric-label">本月跑量</text><text class="summary-value">{{payload.overview.monthKmLabel}}<text> 公里</text></text></view></view>
      <view class="surface records-card"><view class="section-head"><view><view class="section-title">运动记录</view><view class="small-note">{{payload.training.activeDays || 0}} 个活跃日 · {{payload.training.count}} 次出发</view></view><button class="text-button" bindtap="goSport">记一笔 ›</button></view><view wx:for="{{payload.training.runs}}" wx:key="id" class="run-row"><view class="run-symbol"><image src="/images/runner/stats.png" mode="aspectFit"/></view><view class="run-copy"><view class="run-name">{{item.typeLabel}}<text wx:if="{{item.city}}"> · {{item.city}}</text></view><view class="small-note">{{item.dateLabel}}</view><view class="small-note">{{item.durationLabel}} · {{item.paceLabel || '—'}} /公里</view></view><view class="run-distance">{{item.kmLabel}}<text>公里</text></view></view><view wx:if="{{!payload.training.runs.length}}" class="inline-empty"><view class="empty-mark small"><image src="/images/runner/add.png" mode="aspectFit"/></view><view class="muted">把今天的努力，记在这里</view><button class="soft-button" bindtap="goSport">记录一次运动</button></view></view>
    </block>

    <block wx:elif="{{view === 'career'}}">
      <view class="surface career-card"><view class="section-head"><text class="eyebrow">RACE PASSPORT</text><text class="privacy">个人记录 · 未核验</text></view><view class="career-hero"><view><text class="career-number">{{payload.career.finished}}</text><text class="metric-label">累计完赛场数</text></view><view class="finish-graphic"><image src="/images/runner/career.png" mode="aspectFit"/></view></view><view class="distance-grid"><view wx:for="{{payload.career.byDistance}}" wx:key="key"><text class="metric-value">{{item.count}}</text><text class="metric-label">{{item.label}}</text></view></view><view class="career-bottom"><view><text>{{payload.career.raceYears || 0}}<text class="unit"> 年</text></text><text class="metric-label">赛事生涯</text></view><view><text>{{payload.career.kmLabel}}</text><text class="metric-label">比赛公里</text></view><view><text>{{payload.career.totalTime}}</text><text class="metric-label">完赛时间</text></view></view></view>
      <view class="surface"><view class="section-head"><view><view class="section-title">自己的最好成绩</view><view class="small-note">每一次突破，都有名字</view></view><text class="pb-stamp">PERSONAL BEST</text></view><navigator wx:for="{{payload.career.pb}}" wx:key="distance" class="pb-row" url="/pages/race/race?id={{item.race.id}}"><view><text class="pb-distance">{{item.distanceLabel}}</text><view class="pb-name">{{item.race.name}}</view><view class="small-note">{{item.race.raceDate}}</view></view><view class="pb-time">{{item.clock}}<text> ›</text></view></navigator><view wx:if="{{!payload.career.pb.length}}" class="inline-empty"><view class="muted">下一次完赛，就是你的个人最好</view><button class="soft-button" bindtap="goRaces">寻找下一场比赛</button></view></view>
      <view class="surface"><view class="section-title">一年又一年</view><view class="metric-switch"><view wx:for="{{metrics}}" wx:key="key" class="{{metric === item.key ? 'on' : ''}}" data-metric="{{item.key}}" bindtap="pickMetric">{{item.label}}</view></view><block wx:if="{{metric === 'paceSec'}}"><view class="small-note pace-direction">数值越小，配速越快 · 分/公里</view><view class="pace-list"><view wx:for="{{paceRows}}" wx:key="key" class="pace-row"><text>{{item.year}} 年</text><view><text class="pace-value {{item.available ? '' : 'unavailable'}}">{{item.value}}</text><text class="small-note">{{item.available ? '分/公里' : '暂无可计算距离'}}</text></view></view></view><view wx:if="{{!paceRows.length}}" class="muted center">记录第一场成绩后，生涯曲线从这里开始</view></block><block wx:else><view class="small-note">单位：{{metricUnit}}</view><scroll-view scroll-x show-scrollbar="{{false}}"><view class="bar-chart trend-chart" style="min-width: {{trendBars.length * 80}}rpx;"><view wx:for="{{trendBars}}" wx:key="key" class="bar-item"><text class="trend-value">{{item.value}}</text><view class="bar-plot"><view class="bar-fill {{item.height ? '' : 'zero'}}" style="height: {{item.height}}%;"></view></view><text class="bar-label">{{item.label}}</text></view></view></scroll-view><view wx:if="{{!trendBars.length}}" class="muted center">记录第一场成绩后，生涯曲线从这里开始</view></block></view>
      <view class="timeline-heading"><view class="section-title">奔跑的时间线</view><picker range="{{years}}" value="{{yearIndex}}" bindchange="pickYear"><view class="year-picker">{{years[yearIndex]}}⌄</view></picker></view><view class="kind-tabs"><view wx:for="{{kinds}}" wx:key="key" class="{{kind === item.key ? 'on' : ''}}" data-kind="{{item.key}}" bindtap="pickKind">{{item.label}}</view></view><view class="timeline"><navigator wx:for="{{filteredResults}}" wx:key="key" class="timeline-row" url="/pages/race/race?id={{item.race.id}}"><view class="timeline-date"><text>{{item.day}}</text><text>{{item.year}}</text></view><view class="timeline-card"><view class="section-head"><text class="timeline-clock">{{item.clock}}</text><text wx:if="{{item.pb}}" class="pb-tag">PB</text></view><view class="timeline-name">{{item.race.name}}</view><view class="small-note"><text wx:if="{{item.race.meet === 'online'}}">线上赛 · </text>{{item.distanceLabel}}<text wx:if="{{item.race.city}}"> · {{item.race.city}}</text></view><view wx:if="{{item.story}}" class="race-story">{{item.story}}</view></view></navigator></view><view wx:if="{{!filteredResults.length}}" class="surface inline-empty"><view class="muted">{{payload.results.length ? '这个筛选下还没有成绩，试试其他年份或类型。' : '在赛事详情记下成绩，开启属于你的时间线。'}}</view><button wx:if="{{!payload.results.length}}" class="soft-button" bindtap="goRaces">去记第一场成绩</button></view>
    </block>

    <block wx:elif="{{view === 'footprints'}}">
      <view class="footprint-hero surface"><view class="section-head"><text class="eyebrow">CITIES I HAVE RUN</text><picker range="{{years}}" value="{{yearIndex}}" bindchange="pickYear"><view class="year-picker">{{years[yearIndex]}}⌄</view></picker></view><view class="passport-title">跑过的城市，<view>都是我的主场。</view></view><view class="passport-stats"><view><text>{{cities.length}}</text><text>座城市</text></view><view><text>{{provinceCount}}</text><text>个省级地区</text></view><view><text>{{cityEventCount}}</text><text>场城市记忆</text></view></view><view class="passport-line"><view></view><view></view><view></view><view></view><view></view></view></view>
      <view class="timeline-heading"><view class="section-title">我的城市护照</view><text class="small-note">按完赛城市整理</text></view><view class="city-grid"><view wx:for="{{cities}}" wx:key="key" class="city-card {{selectedCityKey === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="pickCity" role="button" aria-label="{{item.name + '，' + item.count + ' 场完赛，点击查看成绩'}}"><view class="city-overline">{{item.province || '赛事足迹'}}<text>{{selectedCityKey === item.key ? '−' : '＋'}}</text></view><view class="city-name">{{item.name}}</view><view class="city-rule"></view><view class="city-bottom"><text>{{item.count}} 场完赛</text><text>{{item.date}}</text></view></view></view><view wx:if="{{selectedCity}}" class="surface city-results"><view class="section-head"><view><view class="section-title">{{selectedCity.name}}的完赛记忆</view><view class="small-note">{{selectedCity.count}} 场赛事 · {{selectedCity.results.length}} 条成绩</view></view><button class="text-button" data-key="{{selectedCity.key}}" bindtap="pickCity">收起</button></view><navigator wx:for="{{selectedCity.results}}" wx:key="key" class="city-result" url="/pages/race/race?id={{item.race.id}}"><view class="city-result-copy"><view class="city-result-name">{{item.race.name}}</view><view class="small-note">{{item.race.raceDate}} · {{item.distanceLabel}}</view></view><view class="city-result-clock">{{item.clock}}<text> ›</text></view></navigator></view><view wx:if="{{!cities.length}}" class="surface inline-empty"><view class="empty-mark"><image src="/images/runner/footprints.png" mode="aspectFit"/></view><view class="section-title">下一座城，等你来跑</view><view class="muted">有城市信息的完赛成绩，会自动收进城市护照。</view><button class="soft-button" bindtap="goRaces">去看看城市赛事</button></view><view class="data-note center">按个人已记录成绩统计，不读取你的实时位置。</view>
    </block>

    <block wx:elif="{{view === 'honors' || view === 'media'}}">
      <view class="collection-banner surface"><image class="collection-icon" src="{{currentView.icon}}" mode="aspectFit"/><view class="section-title">{{view === 'honors' ? '努力，有迹可循' : '这一刻，值得重温'}}</view><view class="muted">{{view === 'honors' ? galleryCounts.certificate + ' 张证书 · ' + galleryCounts.medal + ' 枚奖牌收藏' : galleryCounts.photo + ' 张照片 · ' + galleryCounts.video + ' 段视频'}}</view><view class="privacy">私密收藏，仅自己可见</view></view>
      <view class="gallery-toolbar"><view class="gallery-tabs"><block wx:if="{{view === 'honors'}}"><view class="{{galleryKind === 'certificate' ? 'on' : ''}}" data-kind="certificate" bindtap="pickGallery">证书 {{galleryCounts.certificate}}</view><view class="{{galleryKind === 'medal' ? 'on' : ''}}" data-kind="medal" bindtap="pickGallery">奖牌 {{galleryCounts.medal}}</view></block><block wx:else><view class="{{galleryKind === 'photo' ? 'on' : ''}}" data-kind="photo" bindtap="pickGallery">照片 {{galleryCounts.photo}}</view><view class="{{galleryKind === 'video' ? 'on' : ''}}" data-kind="video" bindtap="pickGallery">视频 {{galleryCounts.video}}</view></block></view><button class="upload-button" bindtap="openUpload">＋ 添加</button></view>
      <view class="gallery-filter"><picker range="{{years}}" value="{{yearIndex}}" bindchange="pickYear"><view class="year-picker">{{years[yearIndex]}}⌄</view></picker><text class="small-note">{{gallery.length}} 份珍藏</text></view><view class="gallery-grid {{galleryKind === 'video' ? 'video-grid' : ''}}"><view wx:for="{{gallery}}" wx:key="key" class="gallery-card"><video wx:if="{{item.kind === 'video'}}" src="{{item.src}}" class="gallery-video" controls show-center-play-btn enable-progress-gesture></video><image wx:else src="{{item.src}}" class="gallery-image {{view === 'honors' ? 'contain' : ''}}" mode="{{view === 'honors' ? 'aspectFit' : 'aspectFill'}}" data-key="{{item.key}}" bindtap="preview"/><view class="gallery-info"><view class="gallery-name">{{item.name}}</view><view class="small-note">{{item.year}} · {{item.distanceLabel}}</view><view class="gallery-bottom"><text class="small-note">{{item.legacy ? '原成绩附件' : '个人收藏'}}</text><button wx:if="{{!item.legacy}}" class="delete-button" data-id="{{item.id}}" loading="{{deleting === item.id}}" disabled="{{deleting > 0}}" bindtap="deleteMedia">删除</button><navigator wx:else class="small-note" url="/pages/race/race?id={{item.raceId}}">管理 ›</navigator></view></view></view></view>
      <view wx:if="{{!gallery.length}}" class="surface empty-state"><view class="empty-mark"><image src="{{currentView.icon}}" mode="aspectFit"/></view><view class="section-title">{{view === 'honors' ? '把终点的喜悦，好好收藏' : '让回忆，不止停在终点'}}</view><view class="muted">{{year ? '这个年份还没有对应收藏，可以切换其他年份。' : view === 'honors' ? '为已有成绩上传证书或奖牌照片，让坚持看得见。' : '给已记录的比赛添加照片或视频，留住奔跑的瞬间。'}}</view><button wx:if="{{payload.results.length}}" class="primary" bindtap="openUpload">添加第一份收藏</button><button wx:else class="primary" bindtap="goRaces">先记录一场完赛</button></view><view class="data-note center">证书与成绩由本人上传，未经赛事官方核验。</view>
    </block>

    <block wx:elif="{{view === 'devices'}}">
      <view class="surface source-hero"><view class="source-symbol"><image src="/images/runner/devices.png" mode="aspectFit"/></view><view class="section-title">让每一次努力，都有记录</view><view class="muted">现在可手动记录跑步与越野数据。运动记录和赛事成绩分别统计，方便回顾日常积累与比赛表现。</view><button class="primary" bindtap="goSport">记录一次运动</button></view><view class="surface"><view class="section-title">智能设备</view><view class="muted">自动同步需完成厂商接入。下面的设备目前尚未开通连接。</view><view wx:for="{{payload.devices}}" wx:key="id" class="device-row"><view class="device-badge"><image src="/images/runner/devices.png" mode="aspectFit"/></view><view class="device-copy"><view class="device-name">{{item.name}}</view><view class="small-note">{{item.reason || '暂未开放授权连接'}}</view></view><text class="device-status">待接入</text></view><view class="source-note">Apple 健康的数据授权依赖原生 App 能力，小程序暂不支持直接读取。我们不会向你索取设备平台的账号密码。</view></view><view class="surface"><view class="section-title">数据口径</view><view class="explain-row"><text>运动数据</text><view>汇总已记录的跑步、越野实际公里和时长，不等同于跑团积分里程。</view></view><view class="explain-row"><text>赛事生涯</text><view>根据你在赛事详情中填写的完赛成绩统计；同一赛事多个项目按一场赛事计算。</view></view><view class="explain-row"><text>自己的最好成绩</text><view>以个人填写的有效完赛成绩为准，不代表赛事官方认证。</view></view><view class="explain-row"><text>收藏隐私</text><view>证书、奖牌与赛事影像仅自己可见，删除收藏不会删除完赛成绩。</view></view></view>
    </block>
    <view class="as-of">数据更新至 {{payload.asOf}} · 每一程，都有记录</view>
  </block>

  <view wx:if="{{uploadOpen}}" class="modal-mask" catchtouchmove="noop" bindtap="closeUpload"><view class="upload-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="section-head"><view class="section-title">添加{{galleryKind === 'certificate' ? '成绩证书' : galleryKind === 'medal' ? '奖牌照片' : galleryKind === 'video' ? '赛事视频' : '赛事照片'}}</view><button class="close-button" disabled="{{uploading}}" bindtap="closeUpload" aria-label="关闭上传">×</button></view><view class="muted">和一场完赛关联，只放进你自己的收藏。</view><text class="field-label">选择比赛与项目</text><picker range="{{payload.resultOptions}}" value="{{uploadIndex}}" bindchange="pickUploadResult"><view class="result-picker">{{payload.resultOptions[uploadIndex]}}<text>⌄</text></view></picker><view class="small-note">{{galleryKind === 'video' ? '支持 MP4 / WebM，单个视频不超过 40MB。' : '支持 JPG / PNG / WebP，单张图片不超过 8MB。'}}</view><view wx:if="{{uploadMessage}}" class="upload-message">{{uploadMessage}}</view><button class="primary" loading="{{uploading}}" disabled="{{uploading}}" bindtap="chooseUpload">{{uploading ? '正在上传' : '选择文件并上传'}}</button></view></view>
</view>
