.city-card.selected { background: #fff2f5; border-color: #ff0a30; }.city-results { margin-top: 24rpx; }.city-result { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 26rpx 0; border-bottom: 1rpx solid #f0f1f5; }.city-result:last-child { border-bottom: 0; padding-bottom: 0; }.city-result-copy { flex: 1; min-width: 0; }.city-result-name { font-size: 25rpx; line-height: 38rpx; font-weight: 500; overflow-wrap: anywhere; }.city-result-clock { flex: none; color: #1f2026; font-size: 29rpx; font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; }.city-result-clock > text { color: #a5a9b2; }
@media(max-width:350px){ .city-result { flex-wrap: wrap; }.city-result-clock { margin-left: auto; } }

.device-import-card { padding: 36rpx 34rpx; border: 2rpx solid #ffe3e9; background: linear-gradient(135deg,#fff,#fff4f6); }.device-import-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.device-wordmark { font-size: 40rpx; line-height: 50rpx; font-weight: 800; letter-spacing: 2rpx; }.device-wordmark > text { margin-left: 10rpx; color: #a4939a; font-size: 23rpx; font-weight: 500; letter-spacing: 0; }.device-import-pill { padding: 5rpx 12rpx; border-radius: 8rpx; background: #ffe7ec; color: #ff0a30; font-size: 21rpx; line-height: 32rpx; }.device-import-title { margin-top: 46rpx; font-size: 49rpx; line-height: 72rpx; letter-spacing: -1rpx; font-weight: 700; }.device-import-copy { margin-top: 20rpx; font-size: 25rpx; line-height: 42rpx; color: #9f8e96; }.device-import-button { margin-top: 34rpx; }.device-import-button[disabled] { background: #e3bbc5; color: #fff; }.device-import-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6rpx 12rpx; margin: 12rpx 0 24rpx; color: #b39fa8; font-size: 20rpx; line-height: 34rpx; }.device-import-meta > button { padding: 8rpx 0; margin: 0; min-height: 64rpx; color: #b47e8d; background: transparent; font-size: 23rpx; line-height: 48rpx; }.device-guide-toggle { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding-top: 28rpx; border-top: 1rpx solid #f2dce3; color: #6f5a64; font-size: 25rpx; line-height: 42rpx; }.device-guide-toggle > text + text { color: #b89aa6; font-size: 22rpx; }.device-guide { margin-top: 28rpx; }.device-guide > view { display: flex; align-items: flex-start; gap: 20rpx; padding-bottom: 25rpx; }.guide-number { display: flex; align-items: center; justify-content: center; flex: none; width: 42rpx; height: 42rpx; border-radius: 13rpx; background: #ffe9ef; color: #cd7187; font-size: 23rpx; }.device-guide > view > view { flex: 1; min-width: 0; }.device-guide > view > view > text { font-size: 25rpx; font-weight: 500; line-height: 42rpx; }.device-guide > view > view > view { margin-top: 6rpx; color: #ad949f; font-size: 23rpx; line-height: 38rpx; }.device-import-rule { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx dashed #efdde2; font-size: 21rpx; line-height: 35rpx; color: #b89fa9; }.device-feedback { margin: 0 0 28rpx; padding: 22rpx 25rpx; border: 1rpx solid #f1dfe5; border-radius: 18rpx; background: #fff; color: #7e6f78; font-size: 24rpx; line-height: 38rpx; }.device-feedback.failure { border-color: #ffd3de; color: #d3445c; }.device-feedback > button { width: auto; margin: 8rpx 0 0; padding: 8rpx 0; min-height: 60rpx; background: transparent; color: #ff0a30; text-align: left; font-size: 23rpx; line-height: 44rpx; }.device-section-copy { margin-top: 18rpx; color: #9b9daa; font-size: 24rpx; line-height: 40rpx; }.device-connection { border-bottom: 1rpx solid #f0f1f5; }.device-connection:last-of-type { border: 0; }.device-connection .device-row { border: 0; padding-bottom: 25rpx; gap: 16rpx; }.device-badge.coros { background: #fff0f3; }.device-status.connected { background: #eef8f2; color: #358d6d; }.device-status.available { background: #fff0f3; color: #ff0a30; }.device-status.error { background: #fff6e9; color: #b77935; }.device-actions { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 0 28rpx 92rpx; }.device-actions > button { width: auto; margin: 0; min-height: 72rpx; padding: 0 25rpx; border-radius: 14rpx; font-size: 23rpx; line-height: 72rpx; }.device-action-primary { color: #ff0a30; background: #fff0f3; }.device-action-secondary { color: #92929e; background: #f5f5f8; }.device-actions > button[disabled] { opacity: .5; }@media(max-width:350px){ .device-import-card { padding: 30rpx; }.device-import-title { font-size: 45rpx; line-height: 66rpx; }.device-status { font-size: 18rpx; padding: 5rpx 8rpx; }.device-actions { padding-left: 0; } }

