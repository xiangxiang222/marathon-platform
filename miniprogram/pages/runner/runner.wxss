ight: 400; }.metric-switch { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 24rpx; }.metric-switch > view { flex: 1; min-width: 100rpx; padding: 13rpx 6rpx; border-radius: 12rpx; text-align: center; background: var(--page-bg); color: var(--text-secondary); font-size: 12px; white-space: nowrap; }.metric-switch > .on { background: var(--brand-soft); color: var(--brand); }.trend-chart { margin-top: 8rpx; }.trend-chart .bar-plot { height: 160rpx; }.trend-value { display: block; margin-bottom: 10rpx; color: var(--brand); font-size: 12px; white-space: nowrap; }.timeline-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 12rpx 4rpx 20rpx; }.year-picker { display: inline-block; padding: 12rpx 16rpx;  background: #fff; color: var(--text-secondary); font-size: 12px; }.kind-tabs { display: flex; gap: 14rpx; padding: 0 4rpx 24rpx;  }.kind-tabs > view { padding: 10rpx 22rpx;  background: #fff; color: var(--text-secondary); font-size: 12px; }.kind-tabs > .on { background: var(--brand-soft); color: var(--brand);  }.timeline-row { display: flex; gap: 22rpx; padding-bottom: 22rpx; }.timeline-date { position: relative; flex: none; width: 96rpx; padding-top: 20rpx; font-size: 14px; font-weight: 650; }.timeline-date > text { display: block; }.timeline-date > text + text { margin-top: 5rpx; color: var(--text-secondary); font-size: 12px; font-weight: 400; }.timeline-date::after { position: absolute; content: ''; left: 38rpx; top: 110rpx; bottom: 0; width: 2rpx; background: var(--border); }.timeline-card { flex: 1; min-width: 0; padding: 28rpx;  background: #ffffff; }.timeline-clock { color: var(--brand); font-size: 18px; line-height: 44rpx; font-weight: 700; font-variant-numeric: tabular-nums; }.timeline-name { margin-top: 14rpx; font-size: 14px; line-height: 42rpx; font-weight: 600; }.pb-tag { padding: 4rpx 10rpx;  color: var(--brand); background: var(--page-bg); font-size: 12px; font-weight: 600; }.race-story { margin-top: 20rpx; 