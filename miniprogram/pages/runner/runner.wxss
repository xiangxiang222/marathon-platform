.city-card.selected { background: var(--mint-soft); border-color: var(--brand);  }.city-results { margin-top: 24rpx; }.city-result { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--border); }.city-result:last-child { border-bottom: 0; padding-bottom: 0; }.city-result-copy { flex: 1; min-width: 0; }.city-result-name { font-size: 12px; line-height: 38rpx; font-weight: 500; overflow-wrap: anywhere; }.city-result-clock { flex: none; color: var(--text); font-size: 14px; font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; }.city-result-clock > text { color: var(--text-secondary); }
@media(max-width:350px){ .city-result { flex-wrap: wrap; }.city-result-clock { margin-left: auto; } }

.device-import-card { padding: 36rpx 34rpx; border: 2rpx solid var(--brand-soft); background: #ffffff; }.device-import-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.device-wordmark { font-size: 20px; line-height: 50rpx; font-weight: 800; letter-spacing: 2rpx; }.device-wordmark > text { margin-left: 10rpx; color: var(--text-secondary); font-size: 12px; font-weight: 500; letter-spacing: 0; }.device-import-pill { padding: 5rpx 12rpx; border-radius: 8rpx; background: var(--brand-soft); color: var(--brand); font-size: 12px; line-height: 32rpx; }.device-import-title { margin-top: 46rpx; line-height: 72rpx; letter-spacing: -1rpx; }.device-import-copy { margin-top: 20rpx; font-size: 12px; line-height: 42rpx; color: var(--text-secondary); }.device-import-button { margin-top: 34rpx; }.device-import-button[disabled] { background: var(--border); color: #fff; }.device-import-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6rpx 12rpx; margin: 12rpx 0 24rpx; color: var(--text-secondary); font-size: 12px; line-height: 34rpx; }.device-import-meta > button { padding: 8rpx 0; margin: 0; min-height:44px; color: var(--text-secondary); background: transparent; font-size: 12px; line-height: 48rpx; }.device-guide-toggle { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding-top: 28rpx; border-top: 1rpx solid var(--border); color: var(--text-secondary); font-size: 12px; line-height: 42rpx; }.device-guide-toggle > text + text { color: var(--text-secondary); font-size: 12px; }.device-guide { margin-top: 28rpx; }.device-guide > view { display: flex; align-items: flex-start; gap: 20rpx; padding-bottom: 25rpx; }.guide-number { display: flex; align-items: center; justify-content: center; flex: none; width: 42rpx; height: 42rpx; border-radius: 13rpx; background: var(--brand-soft); color: var(--text-secondary); font-size: 12px; }.device-guide > view > view { flex: 1; min-width: 0; }.device-guide > view > view > text { font-size: 12px; font-weight: 500; line-height: 42rpx; }.device-guide > view > view > view { margin-top: 6rpx; color: var(--text-secondary); font-size: 12px; line-height: 38rpx; }.device-import-rule { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx dashed var(--border); font-size: 12px; line-height: 35rpx; color: var(--text-secondary); }.device-feedback { margin: 0 0 28rpx; padding: 22rpx 25rpx; border: 1rpx solid var(--border); border-radius: 18rpx; background: #fff; color: var(--text-secondary); font-size: 12px; line-height: 38rpx; }.device-feedback.failure { border-color: var(--brand-soft); color: var(--brand); }.device-feedback > button { width: auto; margin: 8rpx 0 0; padding: 8rpx 0; min-height:44px; background: transparent; color: var(--brand); text-align: left; font-size: 12px; line-height: 44rpx; }.device-section-copy { margin-top: 18rpx; color: var(--text-secondary); font-size: 12px; line-height: 40rpx; }.device-connection { border-bottom: 1rpx solid var(--border);  }.device-connection:last-of-type { border: 0;  }.device-connection .device-row { border: 0; padding-bottom: 25rpx; gap: 16rpx;  }.device-badge.coros { background: var(--brand-soft); }.device-status.connected { background: #eef8f2; color: #358d6d;  }.device-status.available { background: var(--brand-soft); color: var(--brand);  }.device-status.error { background: var(--page-bg); color: var(--brand);  }.device-actions { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 0 28rpx 92rpx; }.device-actions > button { width: auto; margin: 0; min-height:44px; padding: 0 25rpx; line-height: 72rpx; }.device-action-primary { color: var(--brand); background: var(--brand-soft);  }.device-action-secondary { color: var(--text-secondary); background: var(--page-bg);  }.device-actions > button[disabled] { opacity: .5; }@media(max-width:350px){ .device-import-card { padding: 30rpx; background: #ffffff; }.device-import-title { font-size: 22px; line-height: 66rpx; }.device-status { font-size: 12px; padding: 5rpx 8rpx;  }.device-actions { padding-left: 0; } }

.device-import-privacy{font-size: 12px;color:var(--text-secondary);line-height:1.9;margin-top:30rpx}

.device-legal-links{display:flex;gap:32rpx;margin-top:14rpx;font-size: 12px;color:var(--brand)}.device-legal-links text{padding:12rpx 0;text-decoration:underline}

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-runner-runner .surface, .mini-runner-runner .timeline-card, .mini-runner-runner .city-card, .mini-runner-runner .gallery-card, .mini-runner-runner .collection-banner, .mini-runner-runner .device-connection { border-radius: 36rpx; }
.mini-runner-runner .primary, .mini-runner-runner .soft-button, .mini-runner-runner .upload-button, .mini-runner-runner .device-action-primary, .mini-runner-runner .device-action-secondary, .mini-runner-runner .result-picker, .mini-runner-runner .year-picker { border-radius: 24rpx; }
.mini-runner-runner .kind-tabs, .mini-runner-runner .device-status, .mini-runner-runner .pb-tag { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-runner-runner { color: var(--text); }
.mini-runner-runner button { font-weight: 500; border-radius: 24rpx; }

.runner-page { color: var(--text); background: transparent; }
.page-title { font-size: 26px; font-weight: 600; }
.surface { border: 1px solid var(--border); box-shadow: var(--card-shadow); background: #ffffff; }
.timeline-card { border: 1px solid var(--border); background: #ffffff; }
.city-card { border: 1px solid var(--border); background: #ffffff; }
.gallery-card { border: 1px solid var(--border); background: #ffffff; }
.view-tab { font-size: 14px; }
.view-tab.on::after { height: 2px; border-radius: 0; }
.period-tabs { gap: 12rpx; padding: 0; border-radius: 0; background: transparent; }
.period-tabs > view,.kind-tabs > view,.metric-switch > view { border: 1px solid var(--border); border-radius: 14rpx; background: #fff; color: var(--text-secondary); font-size: 12px; }
.period-tabs > .on,.kind-tabs > .on,.metric-switch > .on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
.kind-tabs { border-radius: 0; }
.collection-banner { background: #ffffff; border: 1px solid var(--border); }
.footprint-hero { background: linear-gradient(135deg,#e9f7f2,#ffffff); border: 1px solid var(--border); }
.device-import-card { background: #ffffff; border: 1px solid var(--border); }
.device-import-title { font-size: 24px; font-weight: 600; }
.device-import-copy,.device-section-copy,.explain-row > view { font-size: 14px; line-height: 1.8; }
.device-actions > button { border-radius: 24rpx; font-size: 12px; }
.upload-sheet button { border-radius: 24rpx; font-size: 12px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-runner-runner .primary, .mini-runner-runner .device-action-primary { font-size: 14px; font-weight: 500; }
.mini-runner-runner .soft-button, .mini-runner-runner .upload-button, .mini-runner-runner .device-action-secondary { font-size: 13px; font-weight: 500; }

/* A private poster studio, opened only from the current runner account. */
.achievement-poster-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;box-sizing:border-box;margin:0 0 24rpx;padding:26rpx 28rpx;border:1rpx solid #eee4cf;border-radius:28rpx;background:linear-gradient(110deg,#fff7e7,#fffdfa);color:#8d6f40;text-align:left;line-height:1.6}.achievement-poster-entry::after{border:0}.achievement-poster-entry>view{flex:1;min-width:0}.achievement-poster-entry>view>view{font-size:14px;font-weight:600;color:#65563e}.achievement-poster-entry>view>text{display:block;margin-top:6rpx;font-size:11px;font-weight:400;color:#a99a80}.achievement-poster-entry>text{flex:none;font-size:12px;font-weight:500;white-space:nowrap}
