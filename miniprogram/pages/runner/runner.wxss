.view-tab.on::after { height: 2px; border-radius:0; }
.period-tabs > view,.kind-tabs > view,.metric-switch > view { border: 1px solid var(--border); border-radius:7px; background: #fff; color: var(--text-secondary); font-size:12px; }
.period-tabs > .on,.kind-tabs > .on,.metric-switch > .on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
.kind-tabs { border-radius:0; }
.collection-banner { border: 1px solid var(--border); }
.footprint-hero { border: 1px solid var(--border); }
.device-import-card { border: 1px solid var(--border); }
.device-import-title { font-weight: 600; }
.device-import-copy,.device-section-copy,.explain-row > view { font-size:14px; line-height: 1.8; }
.device-actions > button { border-radius:10px; font-size:12px; }
.upload-sheet button { border-radius:10px; font-size:12px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-runner-runner .primary, .mini-runner-runner .device-action-primary { font-size:14px; font-weight: 500; }
.mini-runner-runner .soft-button, .mini-runner-runner .upload-button, .mini-runner-runner .device-action-secondary { font-size:14px; font-weight: 500; }

/* A private poster studio, opened only from the current runner account. */
.achievement-poster-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;box-sizing:border-box;color:var(--text-secondary);line-height:1.6}.achievement-poster-entry::after{border:0}.achievement-poster-entry>view{flex:1;min-width:0}.achievement-poster-entry>view>view{font-size:14px;font-weight:600;color:var(--text-secondary)}.achievement-poster-entry>view>text{display:block;margin-top:6rpx;font-size:12px;font-weight:400;color:var(--text-secondary)}.achievement-poster-entry>text{flex:none;font-weight:500;white-space:nowrap}


/* Seven views share the same reading scale and control targets. */
.runner-page{letter-spacing:normal}.surface,.timeline-card,.city-card,.gallery-card,.collection-banner,.footprint-hero,.device-import-card,.upload-sheet{border-radius:12px;background:#fff;border-color:var(--border);box-shadow:none}.section-title,.device-import-title,.upload-title{font-size:18px;font-weight:600;line-height:1.5}.timeline-name,.gallery-name,.device-name,.help-question,.city-name,.best-project{font-size:16px;font-weight:500;line-height:1.6}.page-subtitle,.device-import-copy,.device-section-copy,.explain-row>view,.faq-answer,.empty-state .muted{font-size:14px;line-height:1.75}.view-tab,.period-tabs>view,.kind-tabs>view,.metric-switch>view,.primary,.soft-button,.upload-button,.device-action-primary,.device-action-secondary,.device-actions>button,.upload-sheet button{min-height:44px;font-size:14px;border-radius:10px;box-sizing:border-box}.view-tab{display:flex;align-items:center;justify-content:center}.upload-sheet input,.upload-sheet picker{min-height:46px;font-size:14px;border-radius:10px}.training-number,.career-number,.footprint-number,.metric-value{font-size:24px;color:var(--text);letter-spacing:normal}.finish-graphic{background:var(--page-bg);box-shadow:none}.achievement-poster-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;min-height:44px;line-height:1.7}.achievement-poster-entry>view{flex:1;min-width:0;color:var(--text-secondary)}.achievement-poster-entry>text{flex:none;color:var(--brand);white-space:nowrap}.achievement-poster-entry::after{border:0}

@import "../../utils/personal-ui.wxss";

/* Data sources use the native page title and compact functional cards. */
.runner-page.devices-page { padding: 12px 16px 24px; background: #f5f5f5; }
.runner-page.devices-page .surface { padding: 16px; margin-bottom: 12px; border: 0; border-radius: 12px; background: #fff; }
.runner-page.devices-page .section-title { color: #1a1a1a; font-size: 16px; line-height: 24px; font-weight: 600; }
.runner-page.devices-page .device-section-copy,
.runner-page.devices-page .device-import-copy { margin: 6px 0 0; color: #777; font-size: 12px; line-height: 20px; }
.runner-page.devices-page .device-brand-list { margin-top: 12px; }
.runner-page.devices-page .device-connection { border: 0; border-bottom: 1rpx solid #f0f0f0; border-radius: 0; }
.runner-page.devices-page .device-connection:last-child { border-bottom: 0; }
.runner-page.devices-page .device-row { min-height: 80px; padding: 12px 0; gap: 12px; border: 0; box-sizing: border-box; }
.runner-page.devices-page .device-brand-icon { display: block; width: 56px; height: 56px; flex: none; border-radius: 12px; }
.runner-page.devices-page .device-copy { flex: 1; min-width: 0; }
.runner-page.devices-page .device-name { color: #1a1a1a; font-size: 16px; line-height: 24px; font-weight: 500; white-space: nowrap; }
.runner-page.devices-page .device-brand-subtitle { margin-top: 3px; color: #777; font-size: 12px; line-height: 18px; }
.runner-page.devices-page .device-status { display: block; padding: 3px 7px; flex: none; border: 0; border-radius: 4px; color: #888; background: #f5f5f5; font-size: 12px; line-height: 18px; white-space: nowrap; }
.runner-page.devices-page .device-actions { justify-content: flex-end; padding: 0 0 10px 68px; gap: 0; }
.runner-page.devices-page .device-action-secondary { width: auto; min-height: 44px; margin: 0; padding: 0 12px; border: 1rpx solid #eee; border-radius: 8px; background: #fff; color: #777; font-size: 12px; line-height: 42px; }
.runner-page.devices-page .device-import-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 18px 0 12px; }
.runner-page.devices-page .device-import-button { width: auto; height: 44px; min-height: 44px; padding: 0 16px; margin: 0; border: 0; border-radius: 8px; background: #ff1838; font-size: 14px; line-height: 44px; font-weight: 500; }
.runner-page.devices-page .device-import-button[disabled] { background: #e8e8e8; color: #999; }
.runner-page.devices-page .device-manual-button { flex: none; width: auto; min-height: 44px; margin: 0; padding: 0; border: 0; background: transparent; color: #777; font-size: 12px; line-height: 44px; font-weight: 400; }
.runner-page.devices-page .device-feedback { margin: 0 0 12px; padding: 12px; border: 0; border-radius: 8px; background: #f5f5f5; color: #555; font-size: 12px; line-height: 20px; }
.runner-page.devices-page .device-feedback.failure { background: #fff0f2; color: #ff1838; }
.runner-page.devices-page .device-feedback button { width: auto; min-height: 44px; margin: 4px 0 0; padding: 0; border: 0; color: #ff1838; font-size: 12px; line-height: 44px; font-weight: 400; }
.runner-page.devices-page .device-disclosure-toggle { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-height: 48px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: #555; text-align: left; font-size: 14px; line-height: 22px; font-weight: 400; }
.runner-page.devices-page .device-import-card .device-disclosure-toggle { border-top: 1rpx solid #f0f0f0; }
.runner-page.devices-page .device-disclosure-symbol { flex: none; color: #999; font-size: 18px; }
.runner-page.devices-page .device-disclosure-toggle::after,
.runner-page.devices-page .device-manual-button::after,
.runner-page.devices-page .device-feedback button::after { border: 0; }
.runner-page.devices-page .device-guide { margin-top: 12px; }
.runner-page.devices-page .device-guide > view { gap: 10px; padding: 0 0 14px; }
.runner-page.devices-page .device-guide > view:last-child { padding-bottom: 0; }
.runner-page.devices-page .guide-number { width: 22px; height: 22px; border-radius: 6px; background: #fff0f2; color: #ff1838; font-size: 12px; line-height: 22px; }
.runner-page.devices-page .device-guide > view > view > text { color: #555; font-size: 12px; line-height: 22px; font-weight: 500; }
.runner-page.devices-page .device-guide > view > view > view { margin-top: 3px; color: #777; font-size: 12px; line-height: 20px; }
.runner-page.devices-page .device-data-content { padding: 0 0 10px; }
.runner-page.devices-page .explain-row { padding-top: 12px; }
.runner-page.devices-page .explain-row > text { color: #555; font-size: 12px; font-weight: 500; }
.runner-page.devices-page .explain-row > view { margin-top: 4px; color: #777; font-size: 12px; line-height: 20px; }
.runner-page.devices-page .device-legal-links { justify-content: center; gap: 24px; margin-top: 4px; color: #777; font-size: 12px; }
.runner-page.devices-page .device-legal-links text { min-height: 44px; padding: 0; line-height: 44px; text-decoration: none; }
.runner-page.devices-page .as-of { margin-top: 0; padding-top: 0; color: #999; font-size: 12px; line-height: 20px; }

.modal-mask{background:rgba(26,26,26,.45)}.runner-page .close-button{width:44px;min-width:44px;height:44px;min-height:44px;flex:none;padding:0}.runner-page .sheet-handle{width:32px;height:4px;min-height:0;line-height:0;margin:8px auto 16px}
