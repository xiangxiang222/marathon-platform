.mini-feed-feed { padding:16px; color:var(--text); font-size:14px; }
.mini-feed-feed .card { margin:0 0 12px; padding:16px; border:1rpx solid var(--border); border-radius:12px; background:#fff; box-shadow:none; }
.feed-heading { font-size:18px; font-weight:600; }
.feed-note,.feed-time { color:var(--text-secondary); font-size:12px; line-height:1.7; }
.feed-note { margin-top:6px; }
.feed-input-row { display:flex; align-items:center; gap:8px; margin-top:12px; }
.feed-input-row input { flex:1; min-width:0; width:0; height:44px; min-height:44px; margin:0; padding:0 12px; border:1rpx solid var(--border); border-radius:8px; background:var(--page-bg); color:var(--text); font-size:14px; }
.mini-feed-feed button { display:flex; align-items:center; justify-content:center; flex:none; width:auto; min-height:44px; margin:0; padding:0 10px; border:0; border-radius:8px; font-size:14px; font-weight:500; line-height:1.5; }
.mini-feed-feed button::after { border:0; }
.feed-input-row .btn { width:56px; padding:0; background:var(--brand); color:#fff; }
.feed-post-head { display:flex; align-items:baseline; justify-content:space-between; gap:12px; }
.feed-author { min-width:0; font-size:15px; font-weight:500; overflow-wrap:anywhere; }
.feed-time { flex:none; max-width:45%; text-align:right; }
.feed-body { margin-top:12px; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; }
.feed-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:4px; }
.mini-feed-feed .ghost { background:transparent; color:var(--text-secondary); font-size:12px; }
.mini-feed-feed .is-liked { color:var(--brand); }
.feed-comments { padding:12px; border-radius:8px; background:var(--page-bg); }
.feed-comment { color:var(--text); font-size:14px; line-height:1.8; overflow-wrap:anywhere; }
.feed-comment+.feed-comment { margin-top:6px; }
.feed-comment-author { font-weight:500; }
.feed-comment-delete { display:inline-flex; align-items:center; min-height:44px; padding:0 10px; color:var(--text-secondary); font-size:12px; }
.mini-feed-feed .feed-send { width:56px; padding:0; color:var(--brand); border:1rpx solid var(--border); background:#fff; font-size:14px; }
.mini-feed-feed .feed-empty { padding:24px 16px; color:var(--text-secondary); font-size:14px; line-height:1.8; text-align:center; }
