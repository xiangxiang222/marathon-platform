.src { color: #8a8e99; font-size: 26rpx; margin-top: 8rpx; }
.title { font-size: 36rpx; font-weight: 650; }
.album.grid { display: flex; flex-wrap: wrap; }
.album.grid .shot { width: 31%; margin: 16rpx 2% 0 0; }
.album.fall .shot { margin-top: 16rpx; }
.shot image, .shot video { width: 100%; border-radius: 16rpx; }
.album.grid .shot image, .album.grid .shot video { height: 200rpx; }
.album.fall .shot image, .album.fall .shot video { height: 360rpx; }
.drop { color: #ff0a30; margin-right: 16rpx; }
.detail-state { margin: 32rpx; padding: 40rpx 28rpx; border-radius: 20rpx; background: #fff; text-align: center; }
.state-title { color: #1f2026; font-size: 30rpx; font-weight: 600; }
.detail-state .src { margin-top: 16rpx; overflow-wrap: anywhere; }
.detail-state .btn { margin-top: 28rpx; }
