.src { margin-top: 8rpx; }
.card .btn, .ghost { margin-top: 16rpx;  }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-partner-partner .card { border-radius: 32rpx; }
.mini-partner-partner .btn, .mini-partner-partner .ghost { border-radius: 24rpx; }

/* Page composition and interaction hierarchy. */
.mini-partner-partner { color: var(--text); background: transparent; }
.mini-partner-partner button { font-weight: 500; border-radius: 24rpx; }

.card { border: 1px solid var(--border); }
.title { font-size: 24px; font-weight: 600; }
input { width: 100%; min-height: 44px; margin-top: 18rpx; padding: 0 22rpx; border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); font-size: 14px; box-sizing: border-box; }
.src { color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
.row { gap: 20rpx; padding: 24rpx 0; font-size: 14px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-partner-partner .btn { font-size: 14px; font-weight: 500; }
.mini-partner-partner .ghost { font-size: 14px; font-weight: 500; }
.card .title { font-size: 18px; } .card:first-child .title { font-size: 24px; }

/* Existing semantic sections receive distinct light color surfaces. */
.mini-partner-partner > .card:first-child { background: var(--card,#fff); box-shadow: none; }
.mini-partner-partner > .card:nth-child(2) { background: var(--card,#fff); }
.mini-partner-partner > .card:nth-child(3) { background: var(--card,#fff); }

.mini-partner-partner { color:var(--text); font-size:14px; }
.mini-partner-partner>.card:first-child,.mini-partner-partner .card { border:1rpx solid var(--border); border-radius:24rpx; background:var(--card,#fff); box-shadow:none; }
.card .title,.card:first-child .title { color:var(--text); font-size:18px; font-weight:600; }
.mini-partner-partner .btn,.mini-partner-partner .ghost { min-height:44px; border-radius:20rpx; font-size:14px; font-weight:500; }
.mini-partner-partner input { min-height:44px; border-radius:20rpx; font-size:14px; color:var(--text); background:var(--page-bg); }

.mini-partner-partner { padding:16px; }
.mini-partner-partner .card { margin:0 0 12px; padding:16px; border-radius:12px; }
.mini-partner-partner button.ghost { width:auto; min-height:44px; padding:0 12px; color:var(--text); background:#fff; border:1rpx solid var(--border); border-radius:8px; }
.mini-partner-partner .row { align-items:center; gap:12px; }
.mini-partner-partner .row>text { flex:1; min-width:0; overflow-wrap:anywhere; }
.mini-partner-partner .row>text:last-child { flex:none; max-width:42%; text-align:right; }
.mini-partner-partner .row button.ghost { flex:none; width:auto; max-width:96px; min-height:44px; margin:0; font-size:12px; }
.mini-partner-partner .btn { width:100%; background:var(--brand); color:#fff; }
