.mini-partner-partner{padding:16px;color:var(--text);font-size:14px}.mini-partner-partner .card{margin:0 0 12px;padding:16px;border:0;border-radius:12px;background:#fff;box-shadow:none}.title{font-size:18px;font-weight:600}.partner-heading .title{margin-top:5px;font-size:24px}.partner-label{font-size:12px;color:var(--text-secondary)}.src{margin-top:8px;color:var(--text-secondary);font-size:12px;line-height:1.7}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);font-size:14px}.row:last-child{border-bottom:0}.row>text:first-child{flex:1;min-width:0;overflow-wrap:anywhere}.row>text:last-child{flex:none;max-width:42%;font-size:12px;color:var(--text-secondary);text-align:right}.partner-fact{display:flex;flex-direction:column;flex:1;min-width:0;gap:4px}.partner-fact>text:first-child{font-size:12px;color:var(--text-secondary)}.partner-fact>text:last-child{font-size:15px;font-weight:500}.partner-supply{padding:12px 0;border-bottom:1px solid var(--border)}.partner-supply>.src:first-child{margin-top:0;font-size:15px;font-weight:500;color:var(--text)}.mini-partner-partner button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:10px;padding:0 12px;border-radius:8px;font-size:14px;font-weight:500}.mini-partner-partner button::after{border:0}.mini-partner-partner button.ghost{width:auto;border:1px solid var(--border);background:#fff;color:var(--text)}.mini-partner-partner .row button.ghost{flex:none;width:auto;max-width:96px;margin:0;font-size:12px}.mini-partner-partner .btn{width:100%;background:var(--brand);color:#fff}
