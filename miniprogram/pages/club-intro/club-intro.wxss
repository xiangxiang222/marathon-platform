.intro-page { min-height: 100vh; box-sizing: border-box; font-weight: 400; background: transparent; }
.intro-content { padding: 24rpx 28rpx 184rpx; padding-bottom: calc(184rpx + env(safe-area-inset-bottom)); }
.intro-card { position: relative; overflow: hidden; padding: 36rpx; border: 1rpx solid var(--border);  background: var(--card,#fff); border-color: var(--border); box-shadow: none; }
.intro-card > view:not(.track-art) { position: relative;  }
.card-eyebrow { color: var(--brand); font-size: 12px; line-height: 32rpx; letter-spacing: normal; }
.track-art { position: absolute; right: -160rpx; top: -102rpx; width: 392rpx; height: 392rpx; box-sizing: border-box; border: 2rpx solid var(--border); border-radius: 50%; transform: rotate(-20deg); }
.track-line { position: absolute; border: 2rpx solid var(--border); border-radius: 50%; }
.track-line-two { inset: 28rpx; }
.track-line-three { inset: 56rpx; }
.club-mark { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; margin-top: 40rpx; border-radius:12px; color: #fff; background: var(--brand); font-size: 22px; font-weight: 600; box-shadow: none; }
.club-name { margin-top: 26rpx; color: var(--text); line-height: 1.4; overflow-wrap: anywhere; word-break: break-all; }
.card-tagline { margin-top: 12rpx; color: var(--text-secondary); font-size: 12px; line-height: 40rpx; }
.club-facts { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid var(--border); }
.club-owner { flex: 1; min-width: 0; font-size: 12px; line-height: 38rpx; }
.fact-label { display: block; color: var(--text-secondary); font-size: 12px; }
.fact-value { display: block; margin-top: 4rpx; overflow-wrap: anywhere; word-break: break-all; }
.club-count { display: flex; flex: none; align-items: baseline; gap: 8rpx; }
.count { color: var(--text); font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
.count-label { color: var(--text-secondary); font-size: 12px; }
.intro-benefits { margin-top: 24rpx; padding: 32rpx 28rpx 24rpx;  background: var(--card,#fff); }
.section-title { font-size: 20px; font-weight: 600; line-height: 44rpx; }
.benefit-list { display: flex; gap: 12rpx; margin-top: 28rpx; }
.benefit { flex: 1; min-width: 0; text-align: center; }
.benefit-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0 auto; border-radius: 22rpx; background: var(--page-bg); color: var(--brand); }
.icon-route::before, .icon-route::after { content: ""; position: absolute; width: 8rpx; height: 8rpx; border: 3rpx solid var(--brand); border-radius: 50%; }
.icon-route::before { left: 16rpx; top: 19rpx; }
.icon-route::after { right: 16rpx; bottom: 18rpx; }
.icon-route > view { width: 26rpx; height: 16rpx; border: 3rpx solid var(--brand); border-left: 0; border-right: 0; border-radius: 0 12rpx 0 12rpx; transform: rotate(-25deg); }
.icon-flag > view { position: relative; width: 22rpx; height: 32rpx; border-left: 3rpx solid var(--brand); }
.icon-flag > view::before { content: ""; position: absolute; left: 0; top: 0; width: 24rpx; height: 16rpx; border: 3rpx solid var(--brand); border-left: 0; border-radius: 0 4rpx 4rpx 0; }
.icon-rank { gap: 5rpx; align-items: flex-end; padding-bottom: 20rpx; box-sizing: border-box; }
.icon-rank > view { width: 7rpx; border-radius: 2rpx 2rpx 0 0; background: var(--brand); }
.icon-rank > view:nth-child(1) { height: 18rpx; }
.icon-rank > view:nth-child(2) { height: 32rpx; }
.icon-rank > view:nth-child(3) { height: 24rpx; }
.benefit-title { margin-top: 14rpx; line-height: 38rpx; }
.benefit-copy { margin-top: 4rpx; color: var(--text-secondary); font-size: 12px; line-height: 34rpx; }
.access-note { margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); color: var(--text-secondary); font-size: 12px; line-height: 36rpx; }
.status { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 24rpx; padding: 24rpx;  background: var(--page-bg); }
.status-dot { flex: none; width: 12rpx; height: 12rpx; margin-top: 12rpx; border-radius: 50%; background: var(--brand); }
.status-title { font-size: 14px; font-weight: 600; line-height: 40rpx; }
.status-copy { margin-top: 6rpx; color: var(--text-secondary); font-size: 12px; line-height: 38rpx; }
.status-pending .status-dot { background: var(--brand); }
.secondary-note { margin-top: 28rpx; color: var(--text-secondary); text-align: center; font-size: 12px; line-height: 36rpx; }
.intro-dock { position: fixed; z-index: 8; display: flex; align-items: center; gap: 20rpx; left: 0; right: 0; bottom: 0; padding: 20rpx 28rpx 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border); background: var(--card,#fff); }
.intro-dock button { display: flex; align-items: center; justify-content: center; min-height:44px; padding: 0 16rpx; margin: 0; border-radius: 20rpx; font-size: 14px; font-weight: 600; line-height: 1.4; }
.share-action { flex: 0 0 34%; gap: 12rpx; box-sizing: border-box; color: var(--text); background: var(--page-bg);  }
.share-glyph { position: relative; width: 26rpx; height: 26rpx; margin-top: 6rpx; border: 3rpx solid var(--text); border-top-color: transparent; border-radius: 5rpx; }
.share-glyph::before { content: ""; position: absolute; width: 3rpx; height: 22rpx; left: 11rpx; top: -12rpx; background: var(--text); }
.share-glyph::after { content: ""; position: absolute; left: 5rpx; top: -11rpx; width: 12rpx; height: 12rpx; border-top: 3rpx solid var(--text); border-left: 3rpx solid var(--text); transform: rotate(45deg); }
.action { flex: 1; color: #fff; background: var(--brand);  }
.intro-dock button.pending-action { color: var(--text-secondary); background: var(--page-bg); }
.state { padding: 140rpx 40rpx 40rpx; color: var(--text-secondary); text-align: center; font-size: 12px; line-height: 42rpx; }
.retry-action { width: 220rpx; margin: 28rpx auto 0; padding: 12rpx; min-height:44px; background: var(--card,#fff); font-size: 12px;  }
.error { margin-top: 20rpx; color: var(--brand); font-size: 12px; line-height: 38rpx; }
.share-mask, .timeline-mask { position: fixed; z-index: 20; inset: 0; background: rgba(20, 23, 32, .46); }
.share-sheet { position: absolute; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx 36rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); border-radius:12px 32rpx 0 0; background: var(--card,#fff); }
.share-sheet { max-height: calc(100vh - 48rpx); overflow-y: auto; box-sizing: border-box; }
.sheet-handle { width: 64rpx; height: 7rpx; margin: 0 auto; border-radius: 8rpx; background: var(--border); }
.sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 16rpx; }
.sheet-title { font-size: 24px; font-weight: 600; line-height: 52rpx; }
.sheet-close { display: flex; align-items: center; justify-content: center; flex: none; width: 80rpx; min-height:44px; margin-right: -16rpx; padding: 0; color: var(--text-secondary); background: transparent; font-size: 22px; font-weight: 400; line-height: 1; }
.share-preview { display: flex; align-items: center; gap: 18rpx; margin-top: 12rpx; padding: 22rpx; border: 1rpx solid var(--border); border-radius: 20rpx; background: var(--card,#fff); }
.preview-mark { display: flex; align-items: center; justify-content: center; flex: none; width: 76rpx; height: 76rpx; border-radius: 20rpx; color: #fff; background: var(--brand); font-size: 18px; font-weight: 600; }
.preview-copy { flex: 1; min-width: 0; }
.preview-name { font-size: 14px; font-weight: 600; line-height: 40rpx; overflow-wrap: anywhere; word-break: break-all; }
.preview-note { margin-top: 5rpx; color: var(--text-secondary); font-size: 12px; line-height: 34rpx; }
.share-choice { position: relative; display: flex; align-items: center; justify-content: space-between; width: 100%; min-height:44px; margin-top: 20rpx; padding: 24rpx;  text-align: left; font-size: 14px; font-weight: 500; line-height: 40rpx; }
.friend-choice { color: #fff; background: var(--brand); }
.timeline-choice { margin-top: 14rpx; color: var(--text); background: var(--page-bg); }
.choice-arrow { font-size: 20px; font-weight: 400; }
.share-foot { margin-top: 24rpx; color: var(--text-secondary); text-align: center; font-size: 12px; line-height: 36rpx; }
.timeline-mask { z-index: 21; }
.timeline-guide { position: absolute; right: 28rpx; top: 46rpx; left: 76rpx; max-width: 580rpx; padding: 32rpx;  background: var(--card,#fff); }
.timeline-guide { max-height: calc(100vh - 100rpx); overflow-y: auto; box-sizing: border-box;  }
.guide-pointer { position: absolute; top: -14rpx; right: 70rpx; width: 30rpx; height: 30rpx; border-radius: 4rpx; background: var(--card,#fff); transform: rotate(45deg); }
.guide-menu { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 44rpx; border: 2rpx solid var(--border); border-radius:12px; font-size: 20px; font-weight: 600; line-height: 1; }
.guide-title { margin-top: 24rpx; font-size: 18px; font-weight: 600; line-height: 48rpx; }
.guide-copy { margin-top: 14rpx; color: var(--text-secondary); font-size: 14px; line-height: 46rpx; }
.guide-dismiss { min-height:44px; margin-top: 28rpx;  color: #fff; background: var(--brand); font-size: 14px; line-height: 80rpx; }

@media (max-width: 350px) {
  .intro-content { padding-left: 12px; padding-right: 12px; }
  .intro-card { padding: 18px; background: var(--card,#fff); border-color: var(--border); box-shadow: none; }
  .club-name { font-size: 24px; }
  .club-owner, .card-tagline, .benefit-title, .status-copy { font-size: 14px; line-height: 1.6; }
  .card-eyebrow, .fact-label, .count-label, .benefit-copy, .access-note, .secondary-note, .share-foot, .preview-note { font-size: 12px; line-height: 1.6; }
  .intro-dock { gap: 8px; padding-left: 12px; padding-right: 12px; }
  .intro-dock button { min-height: 46px; font-size: 14px; }
  .share-action { flex-basis: 35%; gap: 6px;  }
  .share-sheet { padding-left: 16px; padding-right: 16px; }
  .share-choice, .preview-name, .guide-copy { font-size: 14px;  }
  .share-choice { min-height: 46px;  }
}

/* Match the club workspace button baseline on every public sharing surface. */
.intro-page button { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:44px; line-height:1.25; }
.intro-page button::after { border:0; }
.intro-page .sheet-close { min-height:44px; }
.intro-page .share-choice { justify-content:space-between;  }
.intro-page .guide-dismiss { width:100%; padding:20rpx;  }
.intro-page .verified-mark { justify-content:flex-start; min-height:44px; padding:12rpx 0; color:var(--text-secondary); background:transparent; font-size: 12px; }
.join-identity { margin-top:22rpx; padding:20rpx; border:1rpx solid var(--border);  color:var(--text-secondary); background: var(--page-bg); font-size: 12px; line-height:1.8; overflow-wrap:anywhere; }
.intro-page .report-link { width:100%; min-height:44px; margin-top:12rpx; padding:20rpx 0; color:var(--text-secondary); background:transparent; font-size: 12px; }
.restricted-state .report-link { display:flex; align-items:center; justify-content:center; box-sizing:border-box; }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-club-intro-club-intro .intro-card, .mini-club-intro-club-intro .intro-benefits, .mini-club-intro-club-intro .status, .mini-club-intro-club-intro .timeline-guide { border-radius:12px; }
.mini-club-intro-club-intro .action, .mini-club-intro-club-intro .share-action, .mini-club-intro-club-intro .retry-action, .mini-club-intro-club-intro .share-choice, .mini-club-intro-club-intro .guide-dismiss { border-radius:12px; }
.mini-club-intro-club-intro .join-identity { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-club-intro-club-intro { color: var(--text); }
.mini-club-intro-club-intro button { font-weight: 500; border-radius:12px; }

.intro-page { color: var(--text); background: transparent; }
.intro-card { border: 1px solid var(--border); background: var(--card,#fff); border-color: var(--border); box-shadow: none; }
.intro-benefits { border: 1px solid var(--border); background: var(--card,#fff); }
.status { border: 1px solid var(--border); background: var(--page-bg); }
.club-name { font-size: 24px; font-weight: 600; }
.card-tagline,.benefit-copy { font-size: 14px; line-height: 1.8; }
.benefit-title { font-size: 14px; font-weight: 600; }
.intro-dock button,.share-sheet button { border-radius:12px; font-size: 12px; }
.intro-dock .action { background: var(--brand); color: #fff; }
.intro-dock .share-action { border: 1px solid var(--border); background: var(--card,#fff); color: var(--text); }
.share-choice { border: 1px solid var(--border); border-radius:12px; background: var(--card,#fff); }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-club-intro-club-intro .action { font-size: 14px; font-weight: 500; }
.mini-club-intro-club-intro .share-action, .mini-club-intro-club-intro .retry-action { font-size: 14px; font-weight: 500; }
.intro-dock .action { font-size: 14px; } .intro-dock .share-action { font-size: 14px; }

.intro-page { color:var(--text); font-size:14px; background:var(--page-bg); }
.intro-card,.intro-benefits { background:var(--card,#fff); border:1rpx solid var(--border); border-radius:12px; box-shadow:none; }
.track-art { display:none; }
.club-mark { border-radius:12px; background:var(--brand); color:#fff; box-shadow:none; }
.club-name { color:var(--text); font-size:24px; font-weight:600; letter-spacing:normal; }
.section-title { color:var(--text); font-size:18px; font-weight:600; line-height:1.5; }
.card-eyebrow,.card-tagline,.count-label,.benefit-label,.status-copy { font-size:12px; color:var(--text-secondary); letter-spacing:normal; }
.benefit-icon { background:var(--brand-soft); color:var(--brand); border-radius:20rpx; }
.intro-page button,.intro-page .primary,.intro-page .secondary { min-height:44px; border-radius:20rpx; font-size:14px; font-weight:500; }

@import "../../utils/service-ui.wxss";
