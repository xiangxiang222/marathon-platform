.intro-page { min-height:100vh; color:var(--text); background:var(--page-bg); font-size:14px; line-height:1.6; }
.intro-content { padding:0 16px calc(104px + env(safe-area-inset-bottom)); }
.intro-page button { display:flex; align-items:center; justify-content:center; width:auto; min-height:44px; margin:0; padding:10px 12px; border:0; border-radius:8px; font-size:14px; font-weight:500; line-height:1.4; }
.intro-page button::after { border:0; }
.intro-card { margin:0 -16px; padding:20px 16px 16px; border:0; border-radius:0 0 16px 16px; background:linear-gradient(180deg,#fff0f2 0%,#fff 100%); }
.card-eyebrow { margin-bottom:14px; color:var(--text-secondary); font-size:12px; }
.intro-identity { display:flex; align-items:center; gap:12px; }
.intro-identity-copy { flex:1; min-width:0; }
.club-mark { display:flex; align-items:center; justify-content:center; flex:none; width:52px; height:52px; overflow:hidden; border-radius:12px; background:var(--page-bg); color:var(--text); font-size:24px; font-weight:600; }
.club-name { color:var(--text); font-size:24px; font-weight:600; line-height:1.4; overflow-wrap:anywhere; }
.card-tagline { margin-top:6px; color:var(--text-secondary); font-size:12px; }
.intro-page .verified-mark { justify-content:flex-start; width:auto; min-height:44px; padding:0; background:transparent; color:var(--brand); font-size:12px; }
.club-introduction { margin-top:16px; color:var(--text-secondary); font-size:14px; line-height:1.8; overflow-wrap:anywhere; }
.club-facts { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:16px; padding-top:12px; border-top:1px solid var(--border); }
.club-owner { display:flex; align-items:center; flex:1; min-width:0; gap:8px; }
.fact-label,.count-label { flex:none; color:var(--text-secondary); font-size:12px; }
.fact-value { min-width:0; color:var(--text); font-size:14px; overflow-wrap:anywhere; }
.club-count { display:flex; align-items:baseline; gap:4px; flex:none; }
.count { color:var(--text); font-size:22px; font-weight:600; font-variant-numeric:tabular-nums; }
.intro-benefits { margin-top:12px; padding:16px; border:0; border-radius:12px; background:#fff; }
.section-title { color:var(--text); font-size:18px; font-weight:600; line-height:1.4; }
.benefit-list { margin-top:8px; }
.benefit { padding:12px 0; }
.benefit+.benefit { border-top:1px solid var(--border); }
.benefit-title { color:var(--text); font-size:15px; font-weight:500; }
.benefit-copy { margin-top:4px; color:var(--text-secondary); font-size:12px; line-height:1.7; }
.access-note { margin-top:4px; padding-top:12px; border-top:1px solid var(--border); color:var(--text-secondary); font-size:12px; line-height:1.7; }
.status { display:flex; align-items:flex-start; gap:10px; margin-top:12px; padding:16px; border:0; border-radius:12px; background:#fff; }
.status-dot { flex:none; width:6px; height:6px; margin-top:9px; border-radius:50%; background:var(--brand); }
.status-title { color:var(--text); font-size:15px; font-weight:500; }
.status-copy { margin-top:4px; color:var(--text-secondary); font-size:12px; line-height:1.7; }
.join-identity { margin-top:16px; color:var(--text-secondary); font-size:12px; line-height:1.7; }
.intro-page .report-link { display:flex; align-items:center; justify-content:center; width:100%; min-height:44px; padding:8px 0; background:transparent; color:var(--text-secondary); font-size:12px; }
.intro-dock { position:fixed; z-index:8; display:flex; align-items:center; gap:10px; left:0; right:0; bottom:0; padding:12px 16px calc(12px + env(safe-area-inset-bottom)); border-top:1px solid var(--border); background:#fff; }
.intro-dock .share-action { flex:0 0 32%; min-width:0; color:var(--text); background:#fff; border:1px solid var(--border); }
.intro-dock .action { flex:1; min-width:0; color:#fff; background:var(--brand); }
.intro-dock .pending-action { color:var(--text-secondary); background:var(--page-bg); }
.share-glyph { display:none; }
.state { padding:64px 20px 24px; color:var(--text-secondary); text-align:center; font-size:14px; line-height:1.8; }
.intro-page .retry-action { min-width:100px; min-height:44px; margin:16px auto 0; background:#fff; color:var(--brand); font-size:14px; }
.error { margin-top:12px; color:var(--brand); font-size:12px; line-height:1.7; }
.share-mask,.timeline-mask { position:fixed; z-index:20; inset:0; background:rgba(0,0,0,.42); }
.share-sheet { position:absolute; left:0; right:0; bottom:0; max-height:calc(100vh - 24px); overflow-y:auto; padding:10px 16px calc(20px + env(safe-area-inset-bottom)); border-radius:16px 16px 0 0; background:#fff; }
.sheet-handle { width:32px; height:3px; margin:0 auto; border-radius:3px; background:var(--border); }
.sheet-header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:8px; }
.sheet-title { font-size:24px; font-weight:600; }
.intro-page .sheet-close { flex:none; width:44px; min-height:44px; padding:0; background:transparent; color:var(--text-secondary); font-size:22px; }
.share-preview { display:flex; align-items:center; gap:12px; margin-top:12px; padding:12px; border-radius:8px; background:var(--page-bg); }
.preview-mark { display:flex; align-items:center; justify-content:center; flex:none; width:44px; height:44px; border-radius:8px; background:#fff; color:var(--text); font-size:20px; font-weight:500; }
.preview-copy { flex:1; min-width:0; }
.preview-name { font-size:15px; font-weight:500; line-height:1.5; overflow-wrap:anywhere; }
.preview-note { margin-top:4px; color:var(--text-secondary); font-size:12px; line-height:1.6; overflow-wrap:anywhere; }
.intro-page .share-choice { justify-content:space-between; width:100%; min-height:48px; margin-top:12px; padding:12px; border:1px solid var(--border); color:var(--text); background:#fff; text-align:left; }
.intro-page .friend-choice { color:#fff; background:var(--brand); border-color:var(--brand); }
.choice-arrow { font-size:20px; }
.share-foot { margin-top:16px; color:var(--text-secondary); text-align:center; font-size:12px; }
.timeline-mask { z-index:21; }
.timeline-guide { position:absolute; right:16px; top:24px; left:32px; max-height:calc(100vh - 48px); overflow-y:auto; padding:20px; border-radius:12px; background:#fff; }
.guide-menu { display:flex; align-items:center; justify-content:center; width:44px; height:28px; border:1px solid var(--border); border-radius:8px; font-size:20px; }
.guide-title { margin-top:16px; font-size:18px; font-weight:600; }
.guide-copy { margin-top:12px; color:var(--text-secondary); font-size:14px; line-height:1.8; }
.intro-page .guide-dismiss { width:100%; margin-top:16px; color:#fff; background:var(--brand); }
