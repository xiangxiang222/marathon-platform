<view class="intro-page mini-club-intro-club-intro service-page">
  <view wx:if="{{loading}}" class="state">正在打开跑团…</view>
  <view wx:elif="{{club && restricted}}" class="state restricted-state"><view class="section-title">暂时无法公开查看这个跑团</view><view class="status-copy">{{club.statusMessage || '该跑团目前暂停公开展示与招募。团内记录保留，暂不能分享或申请加入。'}}</view><view class="status-copy">团号 #{{club.id}}</view><button wx:if="{{club.joined}}" class="retry-action" bindtap="enterClub">进入已加入的跑团</button><button class="report-link" bindtap="reportIdentity">提交私密说明或申诉 ›</button><navigator class="report-link" open-type="switchTab" url="/pages/clubs/clubs">返回跑团</navigator></view>
  <block wx:elif="{{club}}">
    <view class="intro-content">
      <view class="intro-card">
        <view class="card-eyebrow">跑团公开名片</view>
        <view class="intro-identity"><image wx:if="{{club.logo && !club.logoFailed}}" class="club-mark" src="{{club.logo}}" data-src="{{club.logo}}" binderror="clubLogoError" mode="aspectFill" /><view wx:else class="club-mark" aria-hidden="true">{{clubInitial}}</view><view class="intro-identity-copy"><view class="club-name">{{club.name}}</view><view class="card-tagline">{{club.city || '城市待补充'}} · 团号 #{{club.id}}</view><button wx:if="{{club.verified}}" class="verified-mark" bindtap="verifiedInfo">✓ 身份已核验 · 查看范围</button></view></view>
        <view class="club-introduction">{{club.intro || '和跑友一起，按自己的节奏出发。'}}</view>
        <view class="club-facts"><view class="club-owner"><text class="fact-label">负责人</text><text class="fact-value">{{club.leader || '跑团管理员'}}</text></view><view class="club-count"><text class="count">{{club.memberCount != null ? club.memberCount : '—'}}</text><text class="count-label">位成员</text></view></view>
      </view>
      <view class="intro-benefits"><view class="section-title">一起开跑的日常</view><view class="benefit-list"><view class="benefit"><view class="benefit-title">团练与约跑</view><view class="benefit-copy">集合时间、地点与训练分组，一次看清</view></view><view class="benefit"><view class="benefit-title">赛事与跑量</view><view class="benefit-copy">找到赛道上的团友，记录每次训练</view></view><view class="benefit"><view class="benefit-title">成员与动态</view><view class="benefit-copy">交流训练见闻，分享一起出发的照片</view></view></view><view class="access-note">申请通过后，开放团内赛事、训练安排与成员信息。</view></view>

      <view wx:if="{{club.joined}}" class="status status-in"><view class="status-dot"></view><view><view class="status-title">你已加入这个跑团</view><view class="status-copy">进入跑团，看看跑友们的新动态。</view></view></view>
      <view wx:elif="{{club.pending}}" class="status status-pending"><view class="status-dot"></view><view><view class="status-title">申请已提交</view><view class="status-copy">等待团长或管理员审核，通过后即可进入跑团。</view></view></view>
      <view wx:if="{{error}}" class="error">{{error}}</view>
      <view class="join-identity">入团申请交由本团团长或管理员审核。</view>
      <button class="report-link" bindtap="reportIdentity">名称或身份被冒用？私密反馈 ›</button>
    </view>

    <view class="intro-dock">
      <button class="share-action" bindtap="openShare"><view class="share-glyph" aria-hidden="true"></view><text>分享跑团</text></button>
      <button wx:if="{{club.joined}}" class="action" bindtap="enterClub">进入跑团</button>
      <button wx:elif="{{club.pending}}" class="action pending-action" disabled>等待审核</button>
      <button wx:else class="action" loading="{{applying}}" disabled="{{applying}}" bindtap="apply">{{applying ? '正在提交' : ready ? '申请加入' : '登录并申请加入'}}</button>
    </view>

    <view wx:if="{{shareOpen}}" class="share-mask" bindtap="closeShare">
      <view class="share-sheet" catchtap="stopTap">
        <view class="sheet-handle"></view>
        <view class="sheet-header"><view class="sheet-title">分享跑团</view><button class="sheet-close" bindtap="closeShare" aria-label="关闭分享">×</button></view>
        <view class="share-preview"><image wx:if="{{club.logo && !club.logoFailed}}" class="preview-mark" src="{{club.logo}}" data-src="{{club.logo}}" binderror="clubLogoError" mode="aspectFill" /><view wx:else class="preview-mark">{{clubInitial}}</view><view class="preview-copy"><view class="preview-name">{{club.name}}</view><view class="preview-note">{{club.city || '城市待补充'}} · 负责人 {{club.leader || '跑团管理员'}} · #{{club.id}}</view><view class="preview-note">好友打开后可申请加入</view></view></view>
        <button class="share-choice friend-choice" open-type="share">发给好友 / 微信群<text class="choice-arrow">›</text></button>
        <button class="share-choice timeline-choice" bindtap="showTimelineGuide">分享到朋友圈<text class="choice-arrow">›</text></button>
        <view class="share-foot">分享无需登录，好友加入仍需审核。</view>
      </view>
    </view>

    <view wx:if="{{timelineGuide}}" class="timeline-mask" bindtap="closeTimelineGuide">
      <view class="timeline-guide" catchtap="stopTap">
        <view class="guide-pointer" aria-hidden="true"></view>
        <view class="guide-menu" aria-hidden="true">···</view>
        <view class="guide-title">让更多跑友看见</view>
        <view class="guide-copy"><view>点右上角「···」</view><view>选择「分享到朋友圈」</view></view>
        <button class="guide-dismiss" bindtap="closeTimelineGuide">我知道了</button>
      </view>
    </view>
  </block>
  <view wx:else class="state"><view>{{error || '没有找到这个跑团'}}</view><button class="retry-action" bindtap="load">重新加载</button></view>
</view>
