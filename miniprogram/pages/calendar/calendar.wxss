.cal{min-height:100vh;background:#f7f6fa;color:#22202a;--p:#55388c;--w:#f3eefc}.calendar-scene,.nav,.day-heading,.err{display:flex;align-items:center;justify-content:space-between;gap:8px}.calendar-scene{padding:12px 16px 35px;background:linear-gradient(112deg,#e8def9,#dcd0f3 52%,#f8f5fc);color:#22202a;font-size:20px;font-weight:650}.cal button{min-height:44px;margin:0;border:0;line-height:1.4}.cal button::after{border:0}.calendar-scene button,.poster-btn,.err button{min-width:44px;padding:0 8px;border-radius:22px;background:var(--w);color:var(--p);font-size:13px}.calendar-board,.list{position:relative;margin:0 16px;border-radius:20px;background:#fff}.calendar-scene button{background:#ffffffb3}.calendar-board{margin-top:-24px;padding:4px 2px 8px}.nav{padding:3px 9px}.nav button{width:44px;padding:0;background:none;color:var(--p);font-size:24px}.ym{font-size:19px;font-weight:650}.week,.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));text-align:center}.week{padding:8px 0;color:#675e71;font-size:12px}.end,.today .num,.count{color:var(--p)}.grid .cell{display:flex;flex-direction:column;align-items:center;gap:1px;min-width:0;width:100%;min-height:54px;padding:3px 0;border-radius:10px;background:none}.num{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;font-size:15px}.grid .cell.picked{background:var(--w)}.picked .num{background:var(--p);color:#fff}.out{opacity:.52}.lunar,.count{min-height:12px;font-size:11px}.list{margin-top:12px;padding:12px}.day-heading{padding-bottom:8px}.day-heading .picked{font-size:20px;font-weight:650}.day-heading text,.meta,.err,.empty{color:#675e71;font-size:13px}.race{display:block;min-height:44px;padding:9px 2px;border-top:1px solid #efecf2;overflow-wrap:anywhere}.name{font-size:15px;font-weight:650}.personal-race-meta{display:flex;flex-wrap:wrap;gap:8px;color:var(--p);font-size:12px}.empty{text-align:center;padding:16px 0}.poster-canvas{position:fixed;left:-9999px;width:2px;height:2px}.poster-mask{position:fixed;inset:0;z-index:30;display:flex;flex-direction:column;background:#0008}.poster-scroll{flex:1;height:0;padding:12px 20px;box-sizing:border-box}.poster-img{width:100%;border-radius:12px}.poster-hint{text-align:center;color:#fff;font-size:12px;padding:8px 0 calc(12px + env(safe-area-inset-bottom))}@media(max-width:375px){.calendar-board{margin-inline:4px}}
