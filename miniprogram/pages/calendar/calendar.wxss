.cal { background: transparent; min-height: 100vh; box-sizing: border-box; }
.nav { display: flex; align-items: center; background: var(--surface); }
.nav text { font-size: 20px; color: var(--text-secondary); min-width: 48rpx; text-align: center; }
.ym { color: var(--text); }
.week { display: grid; grid-template-columns: repeat(7, 1fr); background: #ffffff; }
.grid { display: grid; grid-template-columns: repeat(7, 1fr); background: #ffffff; }
.week { padding: 16rpx 8rpx 4rpx; text-align: center; background: #ffffff; }
.end { color: var(--brand); }
.cell { min-height: 148rpx; display: flex; flex-direction: column; align-items: center; padding-top: 8rpx; }
.num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 56rpx;
  font-size: 14px;
}
.out .num { background: var(--page-bg); color: var(--text-secondary); }
.out .lunar { color: #e1e4e8; }
.today .num { background: #fff; color: var(--brand); box-shadow: none; }
.picked .num { background: var(--brand); color: #fff;  }
.lunar, .count { font-size: 12px; line-height: 1.2; min-height: 26rpx; }
.lunar { color: var(--text-secondary); }
.count { color: var(--brand); }
.list { margin-top: 20rpx; padding: 8rpx 24rpx 24rpx;  background: #ffffff; box-shadow: none; }
.picked { font-size: 14px; font-weight: 600; padding: 24rpx 0 8rpx;  }
.race { display: block; padding: 24rpx 0; border-bottom: 1rpx solid var(--border); }
.meta { margin-top: 8rpx; color: var(--text-secondary); }
.poster-btn {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
  padding: 28rpx 32rpx 28rpx 36rpx;

  color: var(--text);
  background: var(--surface); border-color: var(--border); }
.poster-day { min-width: 72rpx; color: var(--brand); font-size: 64rpx; font-weight: 600; line-height: 1; }
.poster-copy { flex: 1; margin-left: 24rpx; }
.poster-title, .poster-sub { display: block; }
.poster-title { font-size: 16px; font-weight: 600; }
.poster-sub { margin-top: 6rpx; color: var(--text-secondary); font-size: 12px; }
.poster-go { font-size: 20px; color: var(--text-secondary); }
.poster-canvas { position: fixed; left: -9999px; width: 2px; height: 2px; }
.poster-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  background: rgba(0, 0, 0, 0.45);
}
.poster-scroll { flex: 1; height: 0; padding: 24rpx 40rpx 8rpx; box-sizing: border-box; }
.poster-img { width: 100%; border-radius:24rpx; }
.poster-hint { text-align: center; color: #fff; font-size: 12px; padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom)); }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-calendar-calendar .list { border-radius: 24rpx; }
.mini-calendar-calendar .poster-btn { border-radius: 24rpx; }
.mini-calendar-calendar .picked { border-radius: 14rpx; }
.mini-calendar-calendar { color: var(--text); }
.mini-calendar-calendar button { font-weight: 500; border-radius: 24rpx; }

.cal { padding: 28rpx; color: var(--text); background: transparent; }
.nav { justify-content: space-between; padding: 12rpx 8rpx 28rpx; gap: 24rpx; background: var(--surface); }
.ym { font-size: 24px; font-weight: 600; }
.week { padding-top: 24rpx; border-radius: 24rpx 24rpx 0 0; color: var(--text-secondary); font-size: 12px; background: #ffffff; }
.grid { border-radius: 0 0 24rpx 24rpx; padding-bottom: 12rpx; background: #ffffff; }
.num { background: transparent; }
.lunar,.count { font-size: 12px; }
.list { border: 1px solid var(--border); background: #ffffff; box-shadow: none; }
.name { font-size: 16px; font-weight: 600; }
.meta { font-size: 12px; line-height: 1.65; }
.poster-btn { border: 1px solid var(--border); border-radius: 24rpx; background: var(--surface); border-color: var(--border); }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.nav .ym { font-size: 24px; } .cell.picked { padding: 8rpx 0 0; font-weight: 400; border-radius: 0; } .list > .picked { padding: 24rpx 0 8rpx; font-size: 16px; font-weight: 600; }
