.cal { background: #fff; min-height: 100vh; }
.nav { display: flex; align-items: center; justify-content: center; gap: 56rpx; padding: 12rpx 0 4rpx; }
.nav text { font-size: 40rpx; color: #666; min-width: 48rpx; text-align: center; }
.ym { font-size: 32rpx; font-weight: 650; color: #1c1c1e; }
.week, .grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.week { padding: 16rpx 8rpx 4rpx; text-align: center; font-size: 26rpx; }
.end { color: #e23b3b; }
.cell { min-height: 148rpx; display: flex; flex-direction: column; align-items: center; padding-top: 8rpx; }
.num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f3f5;
  text-align: center;
  line-height: 56rpx;
  font-size: 28rpx;
}
.out .num { background: #f7f8fa; color: #c8ccd3; }
.out .lunar { color: #e1e4e8; }
.today .num { background: #fff; color: #e23b3b; box-shadow: inset 0 0 0 3rpx #e23b3b; }
.picked .num { background: #e23b3b; color: #fff; }
.lunar, .count { font-size: 20rpx; line-height: 1.2; min-height: 26rpx; }
.lunar { color: #b4b8c0; }
.count { color: #e23b3b; }
.list { border-top: 16rpx solid #f6f7f9; padding: 8rpx 32rpx 48rpx; }
.picked { font-size: 30rpx; font-weight: 650; padding: 24rpx 0 8rpx; }
.race { display: block; padding: 24rpx 0; border-bottom: 1rpx solid #f0f1f4; }
.name { font-size: 32rpx; font-weight: 650; }
.meta { margin-top: 8rpx; color: #8e949c; font-size: 24rpx; }
.poster-btn {
  display: flex;
  align-items: center;
  margin: 8rpx 32rpx 8rpx;
  padding: 28rpx 32rpx 28rpx 36rpx;
  border-radius: 36rpx;
  color: #e7f4ff;
  background: linear-gradient(160deg, #14325a, #070b14 64%);
  box-shadow: inset 0 0 0 1rpx rgba(126, 231, 255, 0.32);
}
.poster-day { min-width: 72rpx; font-size: 64rpx; font-weight: 300; line-height: 1; }
.poster-copy { flex: 1; margin-left: 24rpx; }
.poster-title, .poster-sub { display: block; }
.poster-title { font-size: 32rpx; font-weight: 650; }
.poster-sub { margin-top: 6rpx; color: #7ee7ff; font-size: 24rpx; }
.poster-go { font-size: 40rpx; color: rgba(231, 244, 255, 0.72); }
.poster-canvas { position: fixed; left: -9999px; width: 2px; height: 2px; }
.poster-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  background: #05070e;
}
.poster-scroll { flex: 1; height: 0; padding: 24rpx 40rpx 8rpx; box-sizing: border-box; }
.poster-img { width: 100%; border-radius: 24rpx; }
.poster-hint { text-align: center; color: rgba(231, 244, 255, 0.46); font-size: 24rpx; padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom)); }
