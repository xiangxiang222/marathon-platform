.cal{min-height:100vh;padding:24rpx 28rpx;background:var(--page-bg);box-sizing:border-box;color:var(--text)}.calendar-board{overflow:hidden;border-radius:24rpx;background:#fff}.nav{display:flex;align-items:center;justify-content:space-between;padding:16rpx 24rpx}.nav>text{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;font-size:24px}.nav .ym{font-size:18px;font-weight:600}.week,.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));padding:0 8rpx}.week{padding-top:16rpx;padding-bottom:16rpx;text-align:center;color:var(--text-secondary);font-size:12px}.end{color:var(--brand)}.grid{padding-bottom:24rpx}.cell{display:flex;flex-direction:column;align-items:center;gap:4rpx;min-width:0;min-height:140rpx;padding:8rpx 0 4rpx;border-radius:12rpx;box-sizing:border-box}.num{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;border-radius:50%;font-size:15px}.out .num,.out .lunar{color:#b0b0b0}.today .num{color:var(--brand);font-weight:600}.cell.picked{background:var(--brand-soft)}.picked .num{background:var(--brand);color:#fff}.lunar,.count{min-height:28rpx;font-size:12px;line-height:1.2}.lunar{color:var(--text-secondary)}.count{color:var(--brand)}.list{margin-top:24rpx}.list>.picked{padding:24rpx 0;font-size:18px;font-weight:600}.race{display:block;margin-bottom:16rpx;padding:28rpx;border-radius:24rpx;background:#fff}.name{font-size:15px;font-weight:600;line-height:1.5}.meta{margin-top:12rpx;color:var(--text-secondary);font-size:12px;line-height:1.6}.empty{padding:48rpx 0;text-align:center;color:var(--text-secondary);font-size:14px}.poster-btn{display:flex;align-items:center;gap:24rpx;margin-top:24rpx;padding:24rpx 28rpx;border-radius:24rpx;background:#fff}.poster-day{min-width:72rpx;color:var(--brand);font-size:28px;font-weight:600;line-height:1.2}.poster-copy{flex:1;min-width:0}.poster-title,.poster-sub{display:block}.poster-title{font-size:15px;font-weight:500}.poster-sub{margin-top:8rpx;color:var(--text-secondary);font-size:12px}.poster-go{font-size:22px;color:var(--text-secondary)}.poster-canvas{position:fixed;left:-9999px;width:2px;height:2px}.poster-mask{position:fixed;inset:0;z-index:30;display:flex;flex-direction:column;background:rgba(0,0,0,.45)}.poster-scroll{flex:1;height:0;padding:24rpx 40rpx 8rpx;box-sizing:border-box}.poster-img{width:100%;border-radius:24rpx}.poster-hint{text-align:center;color:#fff;font-size:12px;padding:16rpx 0 calc(24rpx + env(safe-area-inset-bottom))}
