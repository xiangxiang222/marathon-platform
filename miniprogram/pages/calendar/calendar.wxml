<view class="cal mini-calendar-calendar">
  <view class="calendar-scene"><text>赛事日历</text><button bindtap="goToday">回到今天</button></view>
  <view class="calendar-board">
  <view class="nav">
    <button bindtap="prev" aria-label="上个月">‹</button>
    <text class="ym">{{year}}年{{month}}月</text>
    <button bindtap="next" aria-label="下个月">›</button>
  </view>
  <view class="week">
    <text wx:for="{{weeks}}" wx:key="*this" class="{{item === '日' || item === '六' ? 'end' : ''}}">{{item}}</text>
  </view>
  <view class="grid">
    <button
      wx:for="{{cells}}"
      wx:key="date"
      class="cell {{item.inMonth ? '' : 'out'}} {{item.today ? 'today' : ''}} {{item.picked ? 'picked' : ''}}"
      data-date="{{item.date}}"
      disabled="{{!item.inMonth}}"
      aria-label="{{item.date}} {{item.countText}}"
      aria-pressed="{{item.picked}}"
      bindtap="pick"
    >
      <text class="num">{{item.mark}}</text>
      <text class="lunar">{{item.lunar}}</text>
      <text class="count">{{item.countText}}</text>
    </button>
  </view>
  </view>
  <view class="list" aria-label="选中日期的赛事">
    <view class="day-heading"><view><view class="picked">{{pickedLabel}}</view><text>{{weekday}}{{ready ? ' · ' + dayRaces.length + ' 场' : ''}}</text></view><button wx:if="{{ready && dayRaces.length}}" class="poster-btn" bindtap="makePoster">生成当天长图</button></view>
    <view wx:if="{{message}}" class="err">{{message}}<button bindtap="load">重试</button></view>
    <view wx:elif="{{!ready}}" class="empty">正在加载赛事…</view>
    <view wx:if="{{posterError}}" class="err">{{posterError}}</view>
    <navigator wx:for="{{dayRaces}}" wx:key="id" url="/pages/race/race?id={{item.id}}" class="race">
      <view class="name">{{item.name}}</view>
      <view class="meta">{{item.meta}}</view>
      <view wx:if="{{item.following || item.myStatus}}" class="personal-race-meta"><text wx:if="{{item.following}}">★ 已关注</text><text wx:if="{{item.myStatus}}">我 · {{item.myStatus}}</text></view>
    </navigator>
    <view wx:if="{{ready && !dayRaces.length}}" class="empty">这一天没有赛事</view>
  </view>
  <canvas type="2d" id="day-poster" class="poster-canvas" />
  <view wx:if="{{posterPath}}" class="poster-mask" bindtap="closePoster">
    <scroll-view scroll-y class="poster-scroll" bindtap="closePoster">
      <image class="poster-img" src="{{posterPath}}" mode="widthFix" show-menu-by-longpress catchtap="keepPoster" />
    </scroll-view>
    <view class="poster-hint">长按图片可以保存</view>
  </view>
</view>
