<view class="cal">
  <view class="nav">
    <text bindtap="prev">‹</text>
    <text class="ym">{{year}}年{{month}}月</text>
    <text bindtap="next">›</text>
  </view>
  <view class="week">
    <text wx:for="{{weeks}}" wx:key="*this" class="{{item === '日' || item === '六' ? 'end' : ''}}">{{item}}</text>
  </view>
  <view class="grid">
    <view
      wx:for="{{cells}}"
      wx:key="date"
      class="cell {{item.inMonth ? '' : 'out'}} {{item.today ? 'today' : ''}} {{item.picked && !item.today ? 'picked' : ''}}"
      data-date="{{item.date}}"
      data-in="{{item.inMonth}}"
      bindtap="pick"
    >
      <text class="num">{{item.mark}}</text>
      <text class="lunar">{{item.lunar}}</text>
      <text class="count">{{item.countText}}</text>
    </view>
  </view>
  <view wx:if="{{message}}" class="err">{{message}}</view>
  <view wx:if="{{ready && dayRaces.length}}" class="poster-btn" bindtap="makePoster">
    <text class="poster-day">{{dayNum}}</text>
    <view class="poster-copy">
      <text class="poster-title">生成当天长图</text>
      <text class="poster-sub">{{weekday}} · {{dayRaces.length}} 场</text>
    </view>
    <text class="poster-go">›</text>
  </view>
  <view class="list">
    <view class="picked">{{pickedLabel}}</view>
    <navigator wx:for="{{dayRaces}}" wx:key="id" url="/pages/race/race?id={{item.id}}" class="race">
      <view class="name">{{item.name}}</view>
      <view class="meta">{{item.meta}}</view>
    </navigator>
    <view wx:if="{{ready && !dayRaces.length}}" class="empty">这一天没有赛事</view>
  </view>
  <canvas type="2d" id="day-poster" class="poster-canvas" />
  <view wx:if="{{posterPath}}" class="poster-mask" bindtap="closePoster">
    <scroll-view scroll-y class="poster-scroll" bindtap="closePoster">
      <image class="poster-img" src="{{posterPath}}" mode="widthFix" show-menu-by-longpress catchtap="keepPoster" />
    </scroll-view>
    <view class="poster-hint">长按图片可以保存</view>
  </view>
</view>
