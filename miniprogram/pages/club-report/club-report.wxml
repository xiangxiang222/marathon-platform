<view class="identity-page">
  <view class="hero"><view class="eyebrow">PRIVATE SUPPORT</view><view class="title">名称与身份申诉</view><view class="copy">同名本身不等于冒用。请说明具体的误导呈现或管理授权问题，平台核对后处理；不会把成员、账目或历史记录移交给申诉方。</view></view>
  <view wx:if="{{!ready}}" class="panel"><view class="copy">登录后私密提交，查看本人的工单进度。</view><navigator class="primary action-link" open-type="switchTab" url="/pages/mine/mine">去登录</navigator></view>
  <block wx:else>
    <view class="panel"><view class="name">{{editingReportId ? editingReportStatus === 'pending' ? '更新原工单 #' + editingReportId : editingReportStatus === 'supplement' ? '补充原工单 #' + editingReportId : '申请复核 #' + editingReportId : '提交私密工单'}}</view><view wx:if="{{club}}" class="target-card"><view class="name">{{club.name}}</view><view class="copy">{{club.city || '城市待补充'}} · 负责人 {{club.leader || '跑团管理员'}} · #{{club.id}}</view></view>
      <view class="label">涉及的跑团号 <text>必填</text></view><input type="number" maxlength="15" placeholder="公开名片中的团号，如 10482" value="{{targetId}}" data-key="targetId" bindinput="onField" disabled="{{saving || editingReportId}}" />
      <button class="secondary" bindtap="lookupTarget" disabled="{{saving || loading}}">查看这个团号的名片</button><view wx:if="{{targetMessage}}" class="copy">{{targetMessage}}</view>
      <view class="label">遇到了哪种情况</view><view class="type-choices"><button class="type-choice {{type === 'confusion' ? 'selected' : ''}}" data-type="confusion" bindtap="pickType" disabled="{{saving || editingReportId}}">同名容易混淆</button><button class="type-choice {{type === 'impersonation' ? 'selected' : ''}}" data-type="impersonation" bindtap="pickType" disabled="{{saving || editingReportId}}">组织身份被冒用</button><button class="type-choice {{type === 'management' ? 'selected' : ''}}" data-type="management" bindtap="pickType" disabled="{{saving || editingReportId}}">管理权存在争议</button></view>
      <view class="copy">{{type === 'confusion' ? '城市、简介和团号通常可以帮助辨认。平台可协助核对，同名不会自动被处罚。' : type === 'impersonation' ? '请具体说明哪里冒充组织或误导招募，并提供可核对的组织来源与授权关系。' : '请说明原有管理关系、授权来源和争议经过；新建同名跑团不产生旧团控制权。'}}</view>
      <view class="label">具体情况与依据 <text>必填</text></view><textarea maxlength="4000" placeholder="描述涉及位置、发生经过、可核对的组织授权和必要的脱敏证据。请勿提交无关的个人资料。" value="{{detail}}" data-key="detail" bindinput="onField" disabled="{{saving}}" />
      <view class="label">公共来源链接 <text>选填</text></view><input maxlength="1000" placeholder="组织主页、公共说明或活动页面链接" value="{{sourceUrl}}" data-key="sourceUrl" bindinput="onField" disabled="{{saving}}" />
      <view class="label">私密联系方式 <text>必填</text></view><input maxlength="200" placeholder="便于平台核对和通知补充的联系方式" value="{{contact}}" data-key="contact" bindinput="onField" disabled="{{saving}}" />
      <view class="copy">工单和联系方式仅本人及有权限的平台处理人员可见，不进入公开建议。提交后不会自动下架或公开给对方贴标签。</view><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{saving ? '正在提交' : editingReportStatus === 'pending' ? '保存更新' : editingReportStatus === 'supplement' ? '补充原工单' : editingReportId ? '提交复核申请' : '私密提交'}}</button><button wx:if="{{editingReportId}}" class="secondary" bindtap="cancelSupplement" disabled="{{saving}}">取消本次补充或复核</button>
    </view>
    <view wx:if="{{message}}" class="message" role="alert">{{message}}</view>
    <view class="panel"><view class="list-heading"><view class="name">我的工单进度</view><button class="refresh" bindtap="load" disabled="{{loading || saving}}">刷新</button></view><view wx:if="{{loading}}" class="copy">正在读取进度…</view><view wx:elif="{{!reports.length}}" class="copy">暂无工单，提交后会显示在这里。</view><view wx:for="{{reports}}" wx:key="id" class="report-item"><view class="report-heading"><view class="name">工单 #{{item.id}}</view><text class="state">{{item.statusLabel}}</text></view><view class="copy">{{item.clubName || '跑团'}} · #{{item.clubId}} · {{item.typeLabel}}</view><view class="report-detail">{{item.detail}}</view><view wx:if="{{item.note}}" class="decision">处理说明：{{item.note}}</view><view class="copy">提交于 {{item.createdAt}}</view><button wx:if="{{item.canRespond}}" class="secondary" data-id="{{item.id}}" bindtap="prepareReport" disabled="{{saving}}">{{item.status === 'pending' ? '更新材料' : item.status === 'supplement' ? '补充说明' : '申请复核'}}</button></view></view>
  </block>
</view>
