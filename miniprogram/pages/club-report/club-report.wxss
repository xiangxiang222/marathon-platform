@import "../club-identity/club-identity.wxss";
.type-choices { display:flex; flex-direction:column; gap:12rpx; }
.identity-page .type-choice { justify-content:flex-start; min-height:96rpx; text-align:left; color:#737b87; background:#f4f5f8; font-size:26rpx; }
.identity-page .type-choice.selected { color:#ce2748; background:#fff0f3; box-shadow:inset 0 0 0 1rpx #ffc5d0; }
.target-card { margin-top:24rpx; padding:24rpx; background:#f6f7f9; border-radius:16rpx; }
.list-heading,.report-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16rpx; }
.identity-page .refresh { width:auto; min-width:112rpx; min-height:88rpx; padding:14rpx; color:#858c98; background:transparent; font-size:24rpx; }
.report-item { margin-top:20rpx; padding-top:24rpx; border-top:1rpx solid #eceef2; }
.report-heading .state { margin:0; }
.report-detail { margin-top:14rpx; font-size:25rpx; line-height:1.7; color:#777e89; white-space:pre-wrap; overflow-wrap:anywhere; }
