@media(max-width:350px){.club-page .club-title{font-size:24px;font-weight:600;line-height:1.4;color:var(--text)}.club-page .club-letter{width:48px;height:48px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);color:var(--text);font-size:22px}.club-page .club-community{gap:8px}.club-page .avatar-line .avatar{width:27px;height:27px;margin-right:-9px;border:2px solid #fff;background:var(--page-bg);color:var(--text-secondary)}.club-page .hero-share{padding:0 8px}.club-page .next-title{font-size:18px}.club-page .service-entry .service-note{display:none}.club-page .activity-inline-actions{gap:8px}.club-page .member-filter{padding:0 8px}.club-page .member-row{gap:8px;padding-right:10px;padding-left:10px}}
.club-page .member-list{overflow:hidden;border:0;border-radius:12px;background:#fff}.club-page .member-list .member-row{border:0;border-bottom:1rpx solid var(--border)}.club-page .member-list .member-row:last-child{border-bottom:0}
.club-page .quick-line-icon{position:relative;width:19px;height:20px;border:1.5px solid var(--text-secondary);border-radius:5px;color:var(--text-secondary)}.club-page .quick-line-calendar::before{content:'';position:absolute;left:-1px;right:-1px;top:5px;border-top:1.5px solid var(--text-secondary)}.club-page .quick-line-calendar::after{content:'✓';position:absolute;left:3px;top:4px;font-size:13px}.club-page .quick-line-flag{width:17px;height:18px;border:0;border-left:1.5px solid var(--text-secondary);border-radius:0}.club-page .quick-line-flag::before{content:'';position:absolute;top:0;left:0;width:15px;height:10px;border:1.5px solid var(--text-secondary);border-radius:0 4px 4px 0}.club-page .quick-line-chart{border:0;border-bottom:1.5px solid var(--text-secondary);border-radius:0}.club-page .quick-line-chart::before{content:'';position:absolute;bottom:3px;left:2px;width:2px;height:8px;background:var(--text-secondary);box-shadow:6px -6px 0 var(--text-secondary),12px -2px 0 var(--text-secondary)}.club-page .quick-line-members{border:0;border-radius:0}.club-page .quick-line-members::before{content:'';position:absolute;top:0;left:3px;width:7px;height:7px;border:1.5px solid var(--text-secondary);border-radius:50%}.club-page .quick-line-members::after{content:'';position:absolute;bottom:0;left:0;width:15px;height:9px;border:1.5px solid var(--text-secondary);border-bottom:0;border-radius:9px 9px 0 0}

.club-page .training-status.status-open,.club-page .training-status.status-live{color:var(--text-secondary);background:var(--brand-soft)}.club-page .training-status.status-ended{color:var(--text-secondary);background:var(--page-bg)}.club-page .training-status.status-cancelled{color:var(--brand);background:var(--brand-soft)}.club-page .training-registration{display:inline-block;margin-top:7px;padding:1px 6px;border-radius:5px;background:var(--page-bg);color:var(--text-secondary);font-size:12px;line-height:1.65}.club-page .next-status-group{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:4px;min-width:0;max-width:60%}.mini-club-club .next-status-group .signup-state{max-width:none;white-space:nowrap}

.club-page .fee-person{display:block;padding:12px 0;margin:0;border:0;border-bottom:1rpx solid var(--border);border-radius:0}.club-page .fee-person>text:first-child{display:block;font-size:14px;font-weight:500}.club-page .fee-person .approval-actions{display:flex;gap:6px;margin-top:7px;flex-wrap:nowrap}.club-page .fee-person .text-action{flex:1;width:0;min-width:0;min-height:44px;justify-content:center;padding:0 4px;border-radius:8px;background:var(--page-bg);color:var(--text-secondary);font-size:12px}.club-page .fee-person .text-action.is-selected{background:var(--brand-soft);color:var(--text-secondary)}

.club-page .club-hero{margin:0 -16px;padding:12px 16px 0;border:0;border-radius:0;background:linear-gradient(180deg,#fff0f2 0%,#fff 100%)}

.club-page .club-intro-line{margin-top:5px;color:var(--text-secondary);font-size:12px;line-height:1.6;overflow-wrap:anywhere}.club-page .album-content-preview{display:flex;align-items:center;gap:12px;padding:16px;margin-top:12px;border-radius:12px;background:#fff}.club-page .album-content-preview>view:nth-child(2){flex:1;min-width:0}.club-page .album-preview-count{color:var(--text);font-size:28px;font-weight:600;white-space:nowrap}.club-page .album-preview-count text{display:block;color:var(--text-secondary);font-size:12px;font-weight:400}.club-page .album-content-preview>text{font-size:20px;color:var(--text-secondary)}
