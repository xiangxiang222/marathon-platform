.club-page { min-height: 100vh; padding: 24rpx; padding-bottom: 64rpx; box-sizing: border-box; background: #f5f6fa; color: #1f2026; font-weight: 400; }
.club-hero { padding: 24rpx; color: #1f2026; background: #fff; border-radius: 24rpx; }
.hero-meta, .club-subtitle, .avatar-line, .hero-actions, .section-head, .preview-row, .match-head, .plain-row, .member-row, .approval-row, .approval-actions, .link-row, .rank-row, .toggle-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.eyebrow { color: #8a8e99; font-size: 24rpx; }
.role { padding: 5rpx 12rpx; border: 0; background: #fff0f3; color: #ff0a30; font-size: 22rpx; border-radius: 8rpx; }
.club-title { font-size: 36rpx; line-height: 48rpx; font-weight: 600; overflow-wrap: anywhere; }
.club-subtitle { justify-content: flex-start; margin-top: 12rpx; color: #8a8e99; font-size: 24rpx; }
.dot { color: #8a8e99; margin: 0 4rpx; }
.avatar-line { justify-content: flex-start; min-height: 64rpx; margin-top: 24rpx; }
.avatar, .avatar-count { width: 58rpx; height: 58rpx; margin-right: -10rpx; box-sizing: border-box; border: 3rpx solid #fff; border-radius: 50%; }
.avatar { background: #f5f6fa; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: #1f2026; background: #f0f1f6; font-size: 24rpx; font-weight: 600; }
.avatar-count { display: flex; align-items: center; justify-content: center; color: #1f2026; background: #f0f1f6; font-size: 20rpx; }
.pending-pill { margin-left: auto; padding: 8rpx 14rpx; color: #7962ce; background: #f4f0ff; border-radius: 8rpx; font-size: 24rpx; }
.hero-actions { justify-content: flex-start; margin-top: 24rpx; }
.hero-actions button { margin: 0; height: 80rpx; line-height: 80rpx; padding: 0 24rpx; border-radius: 16rpx; font-size: 26rpx; }
.hero-actions button::after { border: 0; }
.hero-main { color: #fff; background: #ff0a30; font-weight: 600; }
.hero-share { color: #1f2026; background: #f0f1f6; }
.club-tabs { display: flex; width: 100%; margin: 16rpx 0; white-space: nowrap; }
.club-tab { position: relative; display: inline-flex; flex: none; align-items: center; justify-content: center; width: 20%; height: 80rpx; color: #1f2026; font-size: 28rpx; font-weight: 600; }
.club-tab.selected { color: #ff0a30; }
.club-tab.selected::after { position: absolute; bottom: 4rpx; left: 50%; width: 32rpx; height: 5rpx; transform: translateX(-50%); content: ''; background: #ff0a30; border-radius: 3rpx; }
.overview-stats { display: flex; background: #fff; border-radius: 24rpx; margin-bottom: 24rpx; overflow: hidden; }
.stat { flex: 1; min-width: 0; padding: 18rpx 12rpx; text-align: center; border-right: 1rpx solid #f0f1f5; }
.stat:last-child { border-right: 0; }
.stat-value { display: block; color: #1f2026; font-size: 34rpx; line-height: 1.2; font-weight: 700; }
.stat-label { display: block; margin-top: 7rpx; color: #8a8e99; font-size: 22rpx; }
.section-head { min-height: 56rpx; margin: 22rpx 2rpx 8rpx; }
.section-title { color: #1f2026; font-size: 32rpx; font-weight: 600; }
.section-link { color: #ff0a30; font-size: 24rpx; }
.preview-row, .link-row, .match-row, .rank-group, .form-section, .mileage-panel { background: #fff; border-radius: 24rpx; }
.preview-row { min-height: 112rpx; margin-bottom: 18rpx; padding: 20rpx; }
.preview-date { flex: none; width: 128rpx; color: #ff0a30; font-size: 24rpx; font-weight: 600; }
.preview-body { flex: 1; min-width: 0; }
.preview-title, .match-title { display: -webkit-box; overflow: hidden; color: #1f2026; font-size: 32rpx; font-weight: 600; line-height: 42rpx; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.preview-body .muted, .match-main .muted, .link-row .muted { margin-top: 6rpx; font-size: 24rpx; }
.preview-arrow { flex: none; color: #8a8e99; font-size: 36rpx; line-height: 1; }
.empty-row { padding: 22rpx 4rpx; color: #8a8e99; font-size: 24rpx; }
.link-list { margin-bottom: 16rpx; background: #fff; border-radius: 24rpx; overflow: hidden; }
.link-row { min-height: 96rpx; padding: 14rpx 20rpx; border-bottom: 1rpx solid #f0f1f5; }
.link-row:last-child { border-bottom: 0; }
.link-title { color: #1f2026; font-size: 26rpx; font-weight: 600; }
.muted { color: #8a8e99; font-size: 24rpx; line-height: 34rpx; }
.plain-row, .rank-row, .related-race, .member-mark { min-height: 68rpx; padding: 12rpx 4rpx; border-bottom: 1rpx solid #f0f1f5; color: #1f2026; font-size: 24rpx; }
.plain-row:last-child, .rank-row:last-child, .member-mark:last-child { border-bottom: 0; }
.plain-row { margin-bottom: 12rpx; padding: 20rpx; border-bottom: 0; border-radius: 24rpx; background: #fff; }
.plain-row > text:last-child { flex: none; color: #8a8e99; font-size: 24rpx; }
.match-row { margin-bottom: 16rpx; padding: 20rpx; }
.match-head { justify-content: flex-start; }
.match-date { flex: none; width: 120rpx; color: #ff0a30; font-size: 24rpx; }
.match-main { flex: 1; min-width: 0; }
.match-summary { margin-top: 14rpx; padding: 12rpx 14rpx; color: #1f2026; background: #f5f6fa; border-radius: 8rpx; font-size: 24rpx; }
.match-note, .unpaid-note { margin-top: 10rpx; color: #c87825; font-size: 24rpx; }
.unpaid-note { color: #c73540; }
.related-race { display: flex; justify-content: space-between; color: #8a8e99; }
.member-mark { display: flex; justify-content: space-between; color: #8a8e99; font-size: 24rpx; }
.rank-group { margin-bottom: 14rpx; padding: 18rpx 20rpx; }
.rank-label, .form-label { margin: 8rpx 0; color: #8a8e99; font-size: 24rpx; }
.rank-time { color: #ff0a30; font-variant-numeric: tabular-nums; }
.form-section { margin: 18rpx 0; padding: 22rpx 20rpx; }
.form-section .section-title { margin-bottom: 12rpx; }
.field { display: block; width: 100%; height: 80rpx; margin-top: 12rpx; padding: 0 18rpx; box-sizing: border-box; color: #1f2026; background: #f5f6fa; border: 1rpx solid #f0f1f5; border-radius: 16rpx; font-size: 24rpx; }
.form-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.form-grid .field { flex: 1; min-width: 190rpx; }
.form-hint { margin: 10rpx 0; color: #8a8e99; font-size: 22rpx; }
.choice-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 10rpx 0; }
.choice { margin: 0; padding: 0 16rpx; height: 80rpx; line-height: 80rpx; color: #1f2026; background: #f0f1f6; border-radius: 16rpx; font-size: 26rpx; }
.fee-history { margin-top: 16rpx; }
.fee-history-section { margin-top: 16rpx; }
.fee-history .choice-selected { color: #fff; background: #ff0a30; }
.choice::after { border: 0; }
.primary-btn, .secondary-btn { display: block; width: 100%; height: 80rpx; margin-top: 16rpx; line-height: 80rpx; border-radius: 16rpx; font-size: 28rpx; }
.primary-btn { color: #fff; background: #ff0a30; }
.secondary-btn { color: #1f2026; background: #f0f1f6; }
.primary-btn::after, .secondary-btn::after { border: 0; }
.mileage-panel { display: block; margin: 12rpx 0 20rpx; padding: 20rpx; }
.mileage-total { margin-top: 10rpx; color: #ff0a30; font-size: 54rpx; line-height: 1.05; font-weight: 700; font-variant-numeric: tabular-nums; }
.mileage-total text { color: #8a8e99; font-size: 24rpx; font-weight: 400; }
.member-row { justify-content: flex-start; min-height: 96rpx; padding: 12rpx 2rpx; border-bottom: 1rpx solid #f0f1f5; }
.member-avatar { flex: none; width: 68rpx; height: 68rpx; border-radius: 50%; background: #f0f1f6; }
.member-info { flex: 1; min-width: 0; }
.member-name { overflow: hidden; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.member-tools { display: flex; flex: none; flex-wrap: wrap; justify-content: flex-end; gap: 6rpx 12rpx; width: 190rpx; }
.text-action { color: #ff0a30; font-size: 21rpx; }
.text-action.danger { color: #c73540; }
.approval-row { min-height: 72rpx; border-bottom: 1rpx solid #f0f1f5; }
.approval-actions { justify-content: flex-end; }
.approve, .reject { padding: 10rpx 12rpx; font-size: 24rpx; }
.approve { color: #168b50; }
.reject { color: #c73540; }
.toggle-line { min-height: 64rpx; margin-top: 12rpx; color: #1f2026; font-size: 24rpx; }
.toggle-line text { color: #ff0a30; }
.checkin-day { margin-top: 12rpx; }
.error { margin-top: 16rpx; padding: 14rpx; color: #c73540; background: #fff0f3; border-radius: 8rpx; font-size: 24rpx; }
.loading { padding: 80rpx 24rpx; color: #8a8e99; text-align: center; }

.club-identity { display: flex; align-items: center; gap: 20rpx; }
.club-letter { display: flex; flex: none; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 20rpx; background: #fff0f3; color: #ff0a30; font-size: 38rpx; font-weight: 600; }
.club-identity-copy { flex: 1; min-width: 0; }
.club-identity .role { flex: none; }
.club-subtitle { flex-wrap: wrap; gap: 4rpx; line-height: 34rpx; }
.disclosure { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: #1f2026; font-size: 28rpx; font-weight: 600; line-height: 42rpx; text-align: left; }
.disclosure::after { border: 0; }
.disclosure-state { flex: none; color: #ff0a30; font-size: 24rpx; font-weight: 400; }
.manage-inline { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #f0f1f5; }
.plain-row > view:first-child { flex: 1; min-width: 0; }
.plain-row > text:last-child { max-width: 44%; white-space: normal; text-align: right; }
.member-mark { gap: 16rpx; }
.member-mark > text:last-child { text-align: right; }
@media (max-width: 350px) {
  .club-identity { gap: 12rpx; }
  .club-letter { width: 72rpx; height: 72rpx; }
  .club-title, .section-title { font-size: 18px; line-height: 1.4; }
  .club-letter { font-size: 20px; }
  .club-subtitle, .eyebrow, .role, .avatar-count, .pending-pill, .stat-label, .section-link, .preview-date, .preview-body .muted, .match-main .muted, .link-row .muted, .empty-row, .muted, .match-date, .match-summary, .match-note, .unpaid-note, .rank-label, .form-label, .form-hint, .disclosure-state, .error, .mileage-total text { font-size: 12px; line-height: 1.5; }
  .role { max-width: 35%; box-sizing: border-box; }
  .avatar-fallback { font-size: 12px; }
  .avatar-line { gap: 10rpx; }
  .pending-pill { flex: none; padding: 6rpx 10rpx; white-space: nowrap; }
  .hero-actions { flex-wrap: wrap; }
  .hero-actions button { height: 40px; min-height: 40px; font-size: 15px; line-height: 40px; }
  .club-tab { font-size: 15px; }
  .stat-value { font-size: 22px; }
  .preview-title, .match-title { font-size: 16px; line-height: 1.45; }
  .preview-date, .match-date { width: 70px; overflow-wrap: anywhere; }
  .preview-arrow { font-size: 20px; }
  .link-title, .plain-row, .rank-row, .related-race, .member-mark, .member-name, .text-action, .approve, .reject, .toggle-line, .loading { font-size: 15px; line-height: 1.5; }
  .plain-row > text:last-child { font-size: 12px; line-height: 1.5; }
  .plain-row, .rank-row, .related-race, .member-mark, .approval-row, .section-head, .toggle-line { flex-wrap: wrap; }
  .plain-row > text:first-child, .rank-row > text:first-child, .related-race > text:first-child, .member-mark > text:first-child, .approval-row > text:first-child { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .section-head .section-title { flex: 1; min-width: 0; }
  .section-link { flex: none; }
  .field { height: 42px; font-size: 15px; }
  .form-grid .field { min-width: 120px; }
  .choice, .primary-btn, .secondary-btn { height: 40px; min-height: 40px; font-size: 15px; line-height: 40px; }
  .disclosure { min-height: 40px; font-size: 15px; line-height: 1.5; }
  .disclosure > text:first-child { flex: 1; min-width: 0; }
  .member-tools { width: 108px; max-width: 44%; }
  .member-tools .text-action { display: inline-block; max-width: 100%; overflow-wrap: anywhere; }
  .approval-actions { max-width: 100%; flex-wrap: wrap; }
  .mileage-total { font-size: 28px; }
}

.activity-copy {display:block;padding:4rpx 8rpx 18rpx;color:#ff0a30;font-size:23rpx;text-align:right}
.activity-publish {display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:20rpx;padding:26rpx;background:#fff;border:1rpx solid #eceef2;border-left:5rpx solid #ff0a30;border-radius:12rpx}
.activity-publish>text {color:#ff0a30;font-size:34rpx}
.club-poster-canvas { position: fixed; left: -2000px; top: 0; width: 1px; height: 1px; pointer-events: none; }
.poster-layer { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 24rpx; box-sizing: border-box; background: rgba(20, 22, 28, .76); }
.poster-frame { width: 100%; max-width: 680rpx; max-height: 92vh; overflow-y: auto; text-align: center; }
.poster-image { display: block; width: 100%; border-radius: 12rpx; }
.poster-hint { padding: 18rpx 0; color: #fff; font-size: 24rpx; }
.text-action { border: 0; padding: 0; margin: 0; background: transparent; color: #ff0a30; font-size: 24rpx; line-height: 1.4; }
.text-action::after { border: 0; }
.leave-button { color: #c73540; }
