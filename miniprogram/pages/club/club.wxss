.club-page { min-height:100vh; padding:24rpx; padding-bottom:64rpx; box-sizing:border-box; background:#f5f6f8; color:#20232b; font-size:28rpx; line-height:1.5; }
.club-page button { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:88rpx; margin:0; padding:16rpx 24rpx; line-height:1.25; font-size:27rpx; font-weight:500; border-radius:16rpx; }
.club-page button::after { border:0; }
.club-page button[disabled] { opacity:.45; }
.club-hero { position:relative; overflow:hidden; padding:28rpx; background:linear-gradient(125deg,#fff 38%,#fff4f5 100%); border:1rpx solid #fff; border-radius:28rpx; }
.hero-topline,.hero-bottom,.club-identity,.club-subtitle,.avatar-line,.section-head,.preview-row,.match-head,.plain-row,.member-row,.approval-row,.approval-actions,.rank-row,.toggle-line,.next-top,.next-bottom,.publish-shortcut,.approval-banner,.member-filters { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.eyebrow { font-size:22rpx; letter-spacing:2rpx; color:#8a7a80; }
.switch-club { display:flex; align-items:center; min-height:56rpx; color:#737780; font-size:24rpx; white-space:nowrap; }
.club-identity { justify-content:flex-start; margin:20rpx 0 24rpx; }
.club-letter { display:flex; flex:none; align-items:center; justify-content:center; width:92rpx; height:92rpx; background:#ff0a30; color:#fff; border-radius:24rpx; font-size:40rpx; font-weight:700; box-shadow:0 10rpx 24rpx #ff0a3026; }
.club-identity-copy { flex:1; min-width:0; }
.club-title { font-size:40rpx; font-weight:700; line-height:1.35; overflow-wrap:anywhere; letter-spacing:-1rpx; }
.club-subtitle { flex-wrap:wrap; justify-content:flex-start; gap:8rpx 12rpx; margin-top:12rpx; color:#777c86; font-size:22rpx; }
.role { flex:none; padding:3rpx 10rpx; color:#e70027; background:#ffe9ee; border-radius:6rpx; font-size:21rpx; font-weight:600; }
.hero-bottom { padding-top:20rpx; border-top:1rpx solid #ededef; gap:8rpx; }
.avatar-line { min-width:0; justify-content:flex-start; gap:0; }
.avatar { width:42rpx; height:42rpx; flex:none; margin-right:-10rpx; border:3rpx solid #fff; box-sizing:border-box; border-radius:50%; background:#f0f1f5; }
.avatar-fallback { display:flex; align-items:center; justify-content:center; color:#777581; background:#ececf2; font-size:22rpx; font-weight:600; }
.avatar-caption { margin-left:22rpx; color:#92949c; font-size:20rpx; white-space:nowrap; }
.club-page .hero-share { flex:none; min-height:64rpx; padding:12rpx 16rpx; background:#fff; color:#e70027; border:1rpx solid #f5d8df; border-radius:12rpx; font-size:23rpx; }
.approval-banner { margin:16rpx 0 0; padding:20rpx 24rpx; border-radius:16rpx; color:#bc5d19; background:#fff1e5; font-size:24rpx; }
.approval-banner>view { display:flex; align-items:center; gap:12rpx; min-width:0; }
.approval-banner>text { flex:none; }
.notice-dot { width:10rpx; height:10rpx; background:#d97a2c; border-radius:50%; }
.club-tabs { position:sticky; top:0; z-index:5; display:flex; margin:12rpx -24rpx 22rpx; padding:0 24rpx; background:#f5f6f8; }
.club-tab { position:relative; display:flex; flex:1; align-items:center; justify-content:center; min-height:96rpx; color:#737780; font-size:30rpx; font-weight:600; }
.club-tab.selected { color:#20232b; }
.club-tab.selected::after { position:absolute; bottom:8rpx; width:32rpx; height:6rpx; border-radius:10rpx; content:''; background:#ff0a30; }
.section-head { min-height:64rpx; margin:24rpx 2rpx 14rpx; flex-wrap:wrap; gap:6rpx 12rpx; }
.section-title { min-width:0; font-size:32rpx; font-weight:700; line-height:1.4; letter-spacing:-.5rpx; }
.section-link { color:#8b8f98; font-size:23rpx; }
.muted { color:#8b8f98; font-size:23rpx; font-weight:400; line-height:1.55; overflow-wrap:anywhere; }
.next-activity { display:block; padding:28rpx; background:#fff; border:1rpx solid #f0e4e7; border-radius:24rpx; box-shadow:0 8rpx 24rpx #251a2305; }
.next-top { gap:12rpx; }
.next-label { color:#ff0a30; font-size:22rpx; font-weight:600; letter-spacing:1rpx; }
.signup-state { flex:none; max-width:48%; padding:5rpx 12rpx; border-radius:8rpx; color:#8a7980; background:#f7f3f5; font-size:21rpx; }
.signup-state.signed { color:#16875c; background:#eaf7f0; }
.next-title { margin-top:20rpx; font-size:38rpx; font-weight:700; line-height:1.45; overflow-wrap:anywhere; }
.next-meta { margin-top:12rpx; color:#777d87; font-size:25rpx; }
.next-bottom { margin-top:24rpx; padding-top:20rpx; border-top:1rpx solid #f1f2f5; color:#9699a2; font-size:23rpx; }
.next-cta { color:#ff0a30; font-weight:600; white-space:nowrap; }
.empty-card { padding:28rpx; color:#8b8f98; font-size:25rpx; background:#fff; border-radius:24rpx; line-height:1.65; }
.empty-title { margin-bottom:8rpx; color:#30343d; font-size:32rpx; font-weight:600; }
.next-empty { border:1rpx solid #f2e5e8; background:linear-gradient(120deg,#fff,#fff9fa); }
.empty-card .empty-action { display:inline-flex; align-items:center; justify-content:flex-start; width:auto; min-height:76rpx; padding:14rpx 0 0; color:#ff0a30; background:transparent; border-radius:0; font-size:26rpx; }
.compact-empty { padding:24rpx; font-size:24rpx; }
.quick-grid { display:flex; padding:26rpx 6rpx; margin:20rpx 0; border-radius:24rpx; background:#fff; }
.quick-entry { display:flex; flex:1; min-width:0; flex-direction:column; align-items:center; gap:14rpx; padding:8rpx 0; font-size:23rpx; font-weight:500; }
.quick-entry image { width:54rpx; height:54rpx; }
.publish-shortcut { margin:16rpx 0; padding:20rpx 24rpx; border:1rpx solid #f0d6dc; border-radius:18rpx; background:#fff; }
.publish-shortcut>text { color:#ff0a30; font-size:40rpx; font-weight:400; }
.checkin-card { margin:16rpx 0; overflow:hidden; border-radius:22rpx; background:#fff; }
.club-page .checkin-entry { justify-content:space-between; gap:12rpx; width:100%; min-height:112rpx; padding:22rpx 24rpx; text-align:left; background:#fff; }
.checkin-status { flex:none; color:#e70027; font-size:23rpx; font-weight:500; }
.checkin-details { padding:0 24rpx 24rpx; border-top:1rpx solid #f3f3f6; }
.service-grid { display:flex; flex-wrap:wrap; gap:2rpx; overflow:hidden; border-radius:24rpx; background:#f1f2f5; }
.service-entry { display:flex; flex-direction:column; justify-content:center; gap:8rpx; width:calc(50% - 1rpx); min-width:0; min-height:136rpx; padding:20rpx 24rpx; box-sizing:border-box; background:#fff; }
.service-entry>text:first-child { font-size:27rpx; font-weight:600; }
.service-entry>text:last-child { color:#9296a0; font-size:22rpx; }
.club-page .service-back { justify-content:flex-start; min-height:64rpx; padding:8rpx 0; color:#8b8f98; background:transparent; font-size:25rpx; }
.preview-row { padding:24rpx; background:#fff; border-radius:24rpx; }
.race-date-tag { flex:none; width:102rpx; padding:16rpx 8rpx; box-sizing:border-box; color:#ff0a30; background:#fff1f4; border-radius:12rpx; font-size:22rpx; line-height:1.5; text-align:center; overflow-wrap:anywhere; }
.preview-body,.match-main { flex:1; min-width:0; }
.preview-title,.match-title { color:#252932; font-size:29rpx; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.preview-body .muted,.match-main .muted { margin-top:6rpx; }
.preview-arrow { flex:none; color:#aaadb5; font-size:34rpx; line-height:1; }
.sub-tabs,.member-areas { display:flex; gap:6rpx; padding:6rpx; margin-bottom:22rpx; border-radius:18rpx; background:#eceef2; }
.club-page .sub-tab,.club-page .member-area { flex:1; min-width:0; min-height:76rpx; padding:14rpx 8rpx; color:#838792; background:transparent; border-radius:13rpx; font-size:26rpx; }
.club-page .sub-tab.active,.club-page .member-area.active { background:#fff; color:#252932; font-weight:600; box-shadow:0 2rpx 8rpx #17192108; }
.member-areas .member-area { font-size:24rpx; }
.plain-row { min-height:88rpx; padding:22rpx 24rpx; margin-bottom:12rpx; background:#fff; border-radius:18rpx; box-sizing:border-box; font-size:26rpx; overflow-wrap:anywhere; }
.plain-row>view:first-child,.plain-row>text:first-child { flex:1; min-width:0; }
.plain-row>text:last-child { flex:none; max-width:43%; color:#90949e; font-size:22rpx; text-align:right; }
.link-title { color:#30343d; font-size:28rpx; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.training-item { margin-bottom:16rpx; padding:0; border-radius:22rpx; background:#fff; overflow:hidden; }
.training-item .plain-row { margin-bottom:0; }
.activity-copy { display:flex; align-items:center; justify-content:flex-end; min-height:72rpx; padding:0 24rpx; border-top:1rpx solid #f3f4f6; font-size:22rpx; color:#9a858d; }
.activity-publish { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:20rpx; padding:24rpx; border:1rpx dashed #f0bdc8; border-radius:18rpx; background:#fff9fa; }
.activity-publish>text { flex:none; color:#ff0a30; font-size:34rpx; }
.empty-row { padding:28rpx 6rpx; color:#969aa3; font-size:24rpx; line-height:1.6; }
.match-row { margin-bottom:20rpx; padding:26rpx; border-radius:24rpx; background:#fff; }
.match-date { flex:none; width:100rpx; color:#ff0a30; font-size:22rpx; overflow-wrap:anywhere; }
.match-summary { margin-top:20rpx; padding:16rpx; background:#f7f8fa; border-radius:10rpx; color:#666c77; font-size:23rpx; }
.match-note,.unpaid-note { margin-top:12rpx; color:#b27d44; font-size:23rpx; }
.unpaid-note { color:#c73540; }
.related-race,.member-mark { display:flex; justify-content:space-between; align-items:center; gap:16rpx; min-height:76rpx; padding:12rpx 0; border-bottom:1rpx solid #f1f2f5; color:#737986; font-size:24rpx; overflow-wrap:anywhere; }
.related-race>text:first-child,.member-mark>text:first-child { flex:1; min-width:0; }
.member-mark>text:last-child { text-align:right; }
.club-page .roster-toggle { justify-content:space-between; width:100%; min-height:84rpx; padding:12rpx 0; color:#888e99; background:transparent; font-size:24rpx; }
.club-page .roster-toggle>text:first-child { color:#444a55; }
.rank-group,.form-section { margin:18rpx 0; padding:24rpx; background:#fff; border-radius:24rpx; }
.rank-row { min-height:78rpx; padding:12rpx 0; border-bottom:1rpx solid #f1f2f5; font-size:25rpx; }
.rank-row:last-child { border-bottom:0; }
.rank-time { color:#ff0a30; font-variant-numeric:tabular-nums; }
.rank-label,.form-label { margin:12rpx 0; color:#737a85; font-size:24rpx; font-weight:500; }
.field { display:block; width:100%; height:88rpx; margin-top:16rpx; padding:0 20rpx; box-sizing:border-box; color:#30343d; background:#f7f8fa; border:1rpx solid #eceef3; border-radius:14rpx; font-size:26rpx; }
.form-grid { display:flex; flex-wrap:wrap; gap:0 12rpx; }
.form-grid .field { flex:1; min-width:220rpx; }
.form-hint { margin:14rpx 0; color:#989da7; font-size:23rpx; line-height:1.65; }
.choice-row { display:flex; flex-wrap:wrap; gap:10rpx; margin:14rpx 0; }
.club-page .choice { min-height:80rpx; padding:14rpx 20rpx; font-size:24rpx; background:#f2f3f6; color:#5c6370; }
.club-page .choice-selected { color:#ff0a30; background:#fff0f3; }
.club-page .primary-btn,.club-page .secondary-btn { width:100%; min-height:88rpx; margin-top:18rpx; font-size:27rpx; }
.club-page .primary-btn { background:#ff0a30; color:#fff; }
.club-page .secondary-btn { background:#f1f3f6; color:#59616e; }
.club-page .disclosure { justify-content:space-between; gap:16rpx; width:100%; min-height:80rpx; padding:8rpx 0; text-align:left; color:#414753; background:transparent; font-size:27rpx; }
.disclosure>text:first-child { flex:1; min-width:0; }
.disclosure-state { flex:none; color:#ff0a30; font-size:22rpx; font-weight:400; }
.manage-inline { margin-top:18rpx; padding-top:14rpx; border-top:1rpx solid #f0f2f5; }
.fee-history-section { margin-top:22rpx; padding-top:12rpx; border-top:1rpx solid #f0f2f5; }
.mileage-panel { display:block; padding:28rpx; border:1rpx solid #f0e2e7; border-radius:24rpx; background:linear-gradient(130deg,#fff,#fff3f6); }
.mileage-panel .section-head { margin:0; }
.mileage-total { margin:24rpx 0 16rpx; color:#ff0a30; font-size:70rpx; line-height:1.1; font-weight:700; font-variant-numeric:tabular-nums; letter-spacing:-2rpx; }
.mileage-total text { color:#a19ca3; font-size:24rpx; letter-spacing:0; font-weight:400; }
.member-search { display:flex; align-items:center; gap:18rpx; min-height:88rpx; padding:0 24rpx; background:#fff; border:1rpx solid #eceef3; border-radius:16rpx; }
.search-glass { flex:none; width:22rpx; height:22rpx; border:3rpx solid #a6acb6; border-radius:50%; position:relative; }
.search-glass::after { position:absolute; right:-9rpx; bottom:-5rpx; width:12rpx; height:3rpx; content:''; background:#a6acb6; transform:rotate(45deg); }
.member-search input { flex:1; min-width:0; height:88rpx; font-size:26rpx; }
.member-filters { justify-content:flex-start; margin:14rpx 0; gap:10rpx; }
.member-filters>.muted { margin-left:auto; }
.club-page .member-filter { min-height:76rpx; padding:12rpx 18rpx; color:#9297a1; background:transparent; font-size:23rpx; }
.club-page .member-filter.is-active { color:#e70027; background:#ffeef2; }
.member-row { min-height:112rpx; justify-content:flex-start; padding:20rpx 22rpx; margin-bottom:10rpx; box-sizing:border-box; background:#fff; border-radius:18rpx; }
.member-avatar { flex:none; width:70rpx; height:70rpx; border-radius:50%; background:#f0f1f6; }
.member-info { flex:1; min-width:0; }
.member-name { overflow:hidden; color:#30343d; font-size:28rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.member-info .muted { margin-top:4rpx; font-size:22rpx; }
.club-page .member-manage { flex:none; min-height:76rpx; padding:12rpx 16rpx; color:#8c929d; background:#f7f8fa; font-size:22rpx; border-radius:12rpx; }
.pending-pill { color:#c27031; font-size:23rpx; font-weight:500; }
.approval-row { min-height:96rpx; border-bottom:1rpx solid #f1f2f5; font-size:26rpx; }
.approval-row>text { flex:1; min-width:0; overflow-wrap:anywhere; }
.approval-actions { flex-wrap:wrap; justify-content:flex-end; gap:4rpx 10rpx; }
.approve,.reject { display:flex; align-items:center; justify-content:center; min-height:72rpx; min-width:72rpx; padding:8rpx; box-sizing:border-box; font-size:24rpx; }
.approve { color:#16875c; }
.reject { color:#a6a2a8; }
.club-page .text-action { width:auto; min-height:76rpx; padding:8rpx 4rpx; color:#e70027; font-size:23rpx; background:transparent; font-weight:400; line-height:1.4; }
text.text-action { display:inline-flex; align-items:center; min-height:72rpx; box-sizing:border-box; padding:8rpx; color:#e70027; font-size:23rpx; }
.toggle-line { min-height:88rpx; padding:8rpx 0; color:#5a616f; font-size:25rpx; }
.toggle-line>text { flex:none; color:#ff0a30; }
.checkin-day { margin-top:20rpx; }
.checkin-day .plain-row { min-height:64rpx; margin:0; padding:14rpx 0; border-bottom:1rpx solid #f1f2f5; border-radius:0; }
.club-page .leave-button { color:#b14352; }
.error { margin:20rpx 0; padding:20rpx; color:#bb3d51; background:#fff0f3; border-radius:14rpx; font-size:25rpx; overflow-wrap:anywhere; }
.loading { padding:100rpx 32rpx; color:#989da7; font-size:27rpx; text-align:center; }
.club-poster-canvas { position:fixed; left:-2000px; top:0; width:1px; height:1px; pointer-events:none; }
.poster-layer { position:fixed; inset:0; z-index:50; display:flex; align-items:center; justify-content:center; padding:24rpx; box-sizing:border-box; background:rgba(20,22,28,.76); }
.poster-frame { width:100%; max-width:680rpx; max-height:92vh; overflow-y:auto; text-align:center; }
.poster-image { display:block; width:100%; border-radius:12rpx; }
.poster-hint { padding:18rpx 0; color:#fff; font-size:24rpx; }
@media (max-width:350px) {
  .club-page { padding:20rpx; padding-bottom:64rpx; }
  .club-tabs { margin-left:-20rpx; margin-right:-20rpx; padding:0 20rpx; }
  .club-hero { padding:24rpx; }
  .avatar-caption { display:none; }
  .club-title { font-size:38rpx; }
  .club-subtitle { font-size:23rpx; }
  .section-head { gap:8rpx; }
  .section-link { font-size:24rpx; }
  .section-title { font-size:32rpx; }
  .next-title { font-size:36rpx; }
  .next-bottom { flex-wrap:wrap; }
  .quick-entry { font-size:23rpx; }
  .member-areas { gap:2rpx; }
  .club-page .member-area { font-size:24rpx; padding-left:4rpx; padding-right:4rpx; }
  .plain-row { gap:12rpx; }
  .plain-row>text:last-child { max-width:42%; }
  .approval-actions { gap:4rpx; }
}

.my-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; margin:22rpx 0; }
.club-page .my-summary-card { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; gap:10rpx; min-width:0; min-height:172rpx; margin:0; padding:26rpx; border-radius:22rpx; background:#fff; text-align:left; font-weight:400; }
.my-summary-label { color:#5f6570; font-size:24rpx; }
.my-summary-value { color:#272b34; font-size:42rpx; font-weight:700; font-variant-numeric:tabular-nums; line-height:1.2; }
.my-summary-value text { font-size:22rpx; font-weight:400; color:#858b96; }
.my-summary-status { color:#272b34; font-size:30rpx; font-weight:600; line-height:1.5; }
.my-summary-hint { color:#8b919c; font-size:21rpx; line-height:1.5; }
.activity-filters { display:flex; flex-wrap:wrap; gap:14rpx; margin:0 0 20rpx; }
.club-page .activity-filter { flex:none; min-height:76rpx; width:auto; padding:14rpx 22rpx; border-radius:40rpx; color:#717985; background:#eceef2; font-size:25rpx; font-weight:500; }
.club-page .activity-filter.active { color:#e4002a; background:#ffe8ed; }
.filter-count { margin-left:12rpx; font-size:22rpx; font-variant-numeric:tabular-nums; }
.loading-title { color:#4b5361; font-size:32rpx; font-weight:600; }
.loading-message { margin-top:20rpx; line-height:1.7; }
.loading .retry-button { display:flex; align-items:center; justify-content:center; width:280rpx; min-height:88rpx; margin:38rpx auto 24rpx; border-radius:44rpx; color:#fff; background:#ff0a30; font-size:28rpx; line-height:1.2; }
.loading .retry-button::after { border:0; }
.loading-back { padding:22rpx; color:#7d8592; font-size:25rpx; }

.public-identity-line { margin:-8rpx 0 18rpx 112rpx; color:#808692; font-size:23rpx; line-height:1.7; overflow-wrap:anywhere; }
.club-page .verified-mark { justify-content:flex-start; min-height:88rpx; padding:12rpx 0; color:#5d686b; background:transparent; font-size:23rpx; }
.created-guide { margin-top:20rpx; padding:28rpx; border-radius:24rpx; background:#fff; border:1rpx solid #ffe0e6; }
.created-guide .muted { margin-top:12rpx; }
.created-actions { display:flex; flex-direction:column; gap:12rpx; margin-top:24rpx; }
.first-activity { display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:16rpx; box-sizing:border-box; border-radius:14rpx; color:#747d89; background:#f4f5f8; font-size:26rpx; }
.club-page .identity-secondary { width:100%; min-height:88rpx; margin-top:12rpx; padding:16rpx 0; color:#969ca6; background:transparent; font-size:23rpx; }
.club-page .identity-setting { justify-content:space-between; width:100%; min-height:120rpx; padding:26rpx; color:#303743; background:#fff; text-align:left; }
.identity-setting>view { flex:1; min-width:0; }
.identity-setting .section-title { font-size:29rpx; }

@media (max-width:350px) { .club-page .verified-mark,.club-page .identity-secondary,.first-activity { min-height:44px; } }
