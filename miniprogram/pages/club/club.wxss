.club-page { min-height:100vh; padding:28rpx; padding-bottom:calc(64rpx + env(safe-area-inset-bottom)); box-sizing:border-box; font-size: 14px; line-height:1.5; background: transparent; }
.club-page button { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:44px; margin:0; padding:16rpx 24rpx; line-height:1.25; font-size: 14px; font-weight:500; border-radius:16rpx; }
.club-page button::after { border:0; }
.club-page button[disabled] { opacity:.45; }
.club-hero { position:relative; overflow:hidden; padding:32rpx 36rpx 24rpx;  box-shadow: var(--card-shadow); background: linear-gradient(135deg,#eaf4ff,#ffffff); border-color: #dceaf5; }
.hero-track { position:absolute; top:-156rpx; right:-160rpx; width:440rpx; height:440rpx; pointer-events:none; transform:rotate(-28deg); opacity:.45; }
.hero-track>view { position:absolute; inset:0; border:1rpx solid var(--border); border-radius:42%; }
.hero-track>view:nth-child(2) { inset:28rpx; }
.hero-track>view:nth-child(3) { inset:56rpx; }
.hero-topline,.club-identity,.hero-bottom { position:relative; }
.hero-topline { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.hero-bottom { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.club-identity { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.club-subtitle { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.avatar-line { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.section-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.preview-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; background: #ffffff; }
.match-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.plain-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.member-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; background: #ffffff; }
.approval-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.approval-actions { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.rank-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.toggle-line { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.next-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.next-bottom { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.publish-shortcut { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.approval-banner { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.member-filters { display:flex; align-items:center; justify-content:space-between; gap:16rpx;  }
.eyebrow { display:flex; align-items:center; gap:12rpx; font-size:12px; letter-spacing:1rpx; color:var(--text-secondary); }
.eyebrow-line { width:24rpx; height:4rpx; background:var(--brand); border-radius:4rpx; }
.switch-club { display:flex; align-items:center; gap:12rpx; min-height:44px; color:var(--text-secondary); font-size:12px; white-space:nowrap; }
.switch-club>text { color:var(--brand); font-size:16px; }
.club-identity { justify-content:flex-start; align-items:flex-start; gap:24rpx; margin:22rpx 0 30rpx; }
.club-letter { position:relative; display:flex; flex:none; align-items:center; justify-content:center; width:116rpx; height:124rpx; padding-bottom:6rpx; background:var(--brand); color:#fff; border-radius:24rpx 24rpx 32rpx 8rpx; font-size:28px; font-weight:700; }
.club-letter-line { position:absolute; left:32rpx; right:32rpx; bottom:22rpx; height:3rpx; background:#fff; opacity:.5; transform:skew(-28deg); }
.club-identity-copy { flex:1; min-width:0; }
.club-title { color:var(--text); overflow-wrap:anywhere; letter-spacing:-1.5rpx; }
.club-subtitle { flex-wrap:wrap; justify-content:flex-start; gap:8rpx 12rpx; margin-top:14rpx; color:var(--text-secondary); font-size:12px; }
.role { flex:none; padding:3rpx 9rpx; color:var(--brand); background: var(--sun-soft);  font-size:12px; font-weight:500; }
.hero-bottom { padding-top:22rpx; border-top:1rpx solid var(--border); gap:12rpx; }
.club-community { display:flex; min-width:0; align-items:center; gap:14rpx; }
.avatar-line { min-width:0; justify-content:flex-start; gap:0; }
.avatar { width:46rpx; height:46rpx; flex:none; margin-right:-12rpx; border:3rpx solid #fff; box-sizing:border-box; border-radius:50%; background:var(--page-bg); }
.avatar-fallback { display:flex; align-items:center; justify-content:center; color:var(--text-secondary); background:var(--page-bg); font-size: 12px; font-weight:600; }
.avatar-line .avatar:last-child { margin-right:0; }
.avatar-line .avatar-fallback { background:var(--page-bg); color:var(--text-secondary); font-size:11px; }
.avatar-line .avatar:nth-child(2) { background:var(--page-bg); color:var(--text-secondary); }
.avatar-line .avatar:nth-child(3) { background:var(--page-bg); color:var(--text-secondary); }
.avatar-line .avatar:nth-child(4) { background:var(--page-bg); color:var(--text-secondary); }
.avatar-caption { margin-left:0; color:var(--text-secondary); font-size:12px; white-space:nowrap; }
.community-count { color:var(--text); font-weight:650; font-variant-numeric:tabular-nums; }
.club-page .hero-share { flex:none; width:auto; gap:18rpx; font-weight:600; }
.hero-share>text { font-size:17px; font-weight:400;  }
.approval-banner { margin:16rpx 0 0; padding:20rpx 24rpx; border-radius:16rpx; color:var(--brand); background:var(--brand-soft); font-size: 12px; }
.approval-banner>view { display:flex; align-items:center; gap:12rpx; min-width:0; }
.approval-banner>text { flex:none; }
.notice-dot { width:10rpx; height:10rpx; background:var(--brand); border-radius:50%; }
.club-tabs { position:sticky; top:0; z-index:5; display:flex; margin:14rpx 0 0; padding:0; border-bottom:1rpx solid var(--border); background: rgba(247,248,252,.96); }
.club-tab { position:relative; display:flex; flex:1; align-items:center; justify-content:center; min-height:56px; color:var(--text-secondary); font-size:14px; font-weight:500; }
.club-tab.selected { color:var(--text); }
.club-tab.selected::after { position:absolute; bottom:-1rpx; width:32rpx; content:''; }
.club-tab.selected { font-weight:700; }
.section-head { min-height:44px; margin:24rpx 2rpx 14rpx; flex-wrap:wrap; gap:6rpx 12rpx; }
.section-title { min-width:0; font-size: 18px; font-weight:700; line-height:1.4; letter-spacing:-.5rpx; }
.section-link { color:var(--text-secondary); font-size: 12px; }
.overview-section-head { margin:26rpx 0 16rpx; }
.overview-section-head .section-title { font-size: 18px; letter-spacing:-1rpx; }
.overview-section-head .section-link { display:flex; align-items:center; min-height:44px; }
.section-period { color:var(--brand); padding-left:4rpx; }
.link-chevron { padding-left:8rpx; font-size:16px; }
.muted { color:var(--text-secondary); font-size: 12px; font-weight:400; line-height:1.55; overflow-wrap:anywhere; }
.next-activity { display:block; position:relative; overflow:hidden; padding:32rpx; background: #ffffff; border:1rpx solid var(--border); border-top:5rpx solid var(--brand); border-color: #f4ddd0; box-shadow: var(--card-shadow); }
.next-top { gap:12rpx; }
.next-label { color:var(--brand); font-size: 12px; font-weight:600; letter-spacing:1rpx; }
.signup-state { flex:none; max-width:48%; padding:5rpx 12rpx;  color:var(--text-secondary); background:var(--page-bg); font-size: 12px; }
.signup-state.signed { color:#16875c; background: #dff5e9;  }
.next-title { margin-top:20rpx; font-size: 22px; font-weight:700; line-height:1.45; overflow-wrap:anywhere; }
.next-meta { margin-top:12rpx; color:var(--text-secondary); font-size: 12px; }
.next-bottom { margin-top:24rpx; padding-top:20rpx; border-top:1rpx solid var(--border); color:var(--text-secondary); font-size: 12px; }
.next-cta { color:var(--brand); font-weight:600; white-space:nowrap; }
.empty-card { padding:28rpx; color:var(--text-secondary); font-size: 12px; background:#fff;  line-height:1.65; }
.empty-title { margin-bottom:8rpx; color:#333333; }
.next-empty { position:relative; overflow:hidden; min-height:340rpx; padding:32rpx; border:1rpx solid var(--border); border-radius:24rpx; background: #ffffff; border-color: #f4ddd0; }
.empty-content { position:relative; z-index:1; }
.next-kicker { display:flex; align-items:center; gap:10rpx; color:var(--brand); font-size:12px; font-weight:500; letter-spacing:1rpx; }
.kicker-dot { width:8rpx; height:8rpx; border-radius:50%; background:var(--brand); }
.next-empty .empty-title { margin:16rpx 0 10rpx; color:var(--text); font-size:22px; line-height:1.4; font-weight:700; letter-spacing:-1rpx; }
.next-empty .muted { color:var(--text-secondary); }
.empty-track { position:absolute; right:-42rpx; bottom:-90rpx; width:280rpx; height:380rpx; transform:rotate(30deg); pointer-events:none; }
.empty-track-lane { position:absolute; inset:0; border:2rpx solid var(--border); border-radius:130rpx; }
.empty-track-lane.lane-two { inset:20rpx; }
.empty-track-lane.lane-three { inset:40rpx; }
.track-start { position:absolute; top:90rpx; left:0; width:56rpx; height:3rpx; background:var(--brand); }
.empty-card .empty-action { display:inline-flex; align-items:center; justify-content:center; gap:28rpx; width:auto; min-height:44px; margin-top:24rpx; padding:18rpx 26rpx; color:#fff; background:var(--brand);  font-size:12px; font-weight:600; }
.empty-action>text { font-size:17px; font-weight:400; }
.compact-empty { padding:24rpx; border:1rpx solid var(--border); border-radius:24rpx; font-size:12px; }
.quick-grid { display:flex; padding:26rpx 6rpx; margin:20rpx 0 24rpx; border:1rpx solid var(--border);  background: #ffffff; box-shadow: var(--card-shadow); }
.quick-entry { display:flex; flex:1; min-width:0; min-height:100rpx; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; padding:4rpx 0; color:var(--text); font-size:12px; font-weight:500; }
.quick-icon { display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; }
.quick-entry image { width:46rpx; height:46rpx; }
.publish-shortcut { margin:0; padding:22rpx 0; border:0; border-top:1rpx solid var(--border); border-radius:0; background:#fff; }
.publish-shortcut>text { color:var(--brand); font-size: 20px; font-weight:400; }
.checkin-card { margin:0; overflow:hidden; border-top:1rpx solid var(--border); border-radius:0; background: #ffffff; }
.club-page .checkin-entry { justify-content:space-between; gap:12rpx; width:100%; min-height:136rpx; padding:24rpx 0; border-radius:0; text-align:left; background: #ffffff; }
.checkin-copy { display:flex; align-items:center; gap:18rpx; min-width:0; }
.checkin-copy>view:last-child { min-width:0; }
.checkin-copy .link-title { font-size:14px; }
.checkin-copy .muted { margin-top:4rpx; }
.checkin-symbol { display:flex; flex:none; align-items:center; justify-content:center; width:62rpx; height:62rpx; border-radius:50%; background: #d7eee6; color:var(--text-secondary); font-size:17px; }
.checkin-symbol.is-checked { color:#16875c; background: #d4f2e5; }
.checkin-status { flex:none; color:var(--brand); font-size: 12px; font-weight:500; }
.checkin-details { padding:0 0 24rpx; border-top:1rpx solid var(--page-bg); }
.service-grid { display:flex; flex-wrap:wrap; gap:2rpx; overflow:hidden; border:1rpx solid var(--border);  background: #ffffff; }
.service-entry { display:flex; flex-direction:column; justify-content:center; gap:8rpx; width:calc(50% - 1rpx); min-width:0; min-height:136rpx; padding:20rpx 24rpx; box-sizing:border-box; background:#fff; }
.service-entry>text:first-child { font-size: 14px; font-weight:600; }
.service-entry>text:last-child { color:var(--text-secondary); font-size: 12px; }
.club-page .service-back { justify-content:flex-start; min-height:44px; padding:8rpx 0; color:var(--text-secondary); background:transparent; font-size: 12px; }
.preview-row { padding:24rpx; background: #ffffff;  }
.race-date-tag { flex:none; width:102rpx; padding:16rpx 8rpx; box-sizing:border-box; color:var(--brand); background: var(--sun-soft); border-radius:12rpx; font-size: 12px; line-height:1.5; text-align:center; overflow-wrap:anywhere; }
.preview-body,.match-main { flex:1; min-width:0; }
.preview-title,.match-title { color:var(--text); font-size: 14px; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.preview-body .muted,.match-main .muted { margin-top:6rpx; }
.preview-arrow { flex:none; color:var(--text-secondary); font-size: 18px; line-height:1; }
.sub-tabs,.member-areas { display:flex; padding:6rpx; margin-bottom:22rpx; }
.club-page .sub-tab,.club-page .member-area { flex:1; min-width:0; min-height:44px; padding:14rpx 8rpx; }
.club-page .sub-tab.active,.club-page .member-area.active { font-weight:600;  }
.member-areas .member-area { font-size: 12px;  }
.plain-row { min-height:44px; padding:22rpx 24rpx; margin-bottom:12rpx; background:#fff; border-radius:18rpx; box-sizing:border-box; font-size: 12px; overflow-wrap:anywhere; }
.plain-row>view:first-child,.plain-row>text:first-child { flex:1; min-width:0; }
.plain-row>text:last-child { flex:none; max-width:43%; color:var(--text-secondary); font-size: 12px; text-align:right; }
.link-title { color:#333333; font-size: 14px; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.training-item { margin-bottom:16rpx; padding:0;  background: #ffffff; overflow:hidden; }
.training-item .plain-row { margin-bottom:0;  }
.activity-copy { display:flex; align-items:center; justify-content:flex-end; min-height:44px; padding:0 24rpx; border-top:1rpx solid var(--page-bg); font-size: 12px; color:var(--text-secondary); }
.activity-publish { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:20rpx; padding:24rpx; border:1rpx dashed var(--border); border-radius:18rpx; background:var(--brand-soft); }
.activity-publish>text { flex:none; color:var(--brand); font-size: 18px; }
.empty-row { padding:28rpx 6rpx; color:var(--text-secondary); font-size: 12px; line-height:1.6; }
.match-row { margin-bottom:20rpx; padding:26rpx;  background:#fff; }
.match-date { flex:none; width:100rpx; color:var(--brand); font-size: 12px; overflow-wrap:anywhere; }
.match-summary { margin-top:20rpx; padding:16rpx; background: var(--sky-soft); border-radius:10rpx; color:var(--text-secondary); font-size: 12px; }
.match-note,.unpaid-note { margin-top:12rpx; color:var(--brand); font-size: 12px; }
.unpaid-note { color:var(--brand); }
.related-race,.member-mark { display:flex; justify-content:space-between; align-items:center; gap:16rpx; min-height:44px; padding:12rpx 0; border-bottom:1rpx solid var(--border); color:var(--text-secondary); font-size: 12px; overflow-wrap:anywhere; }
.related-race>text:first-child,.member-mark>text:first-child { flex:1; min-width:0; }
.member-mark>text:last-child { text-align:right; }
.club-page .roster-toggle { justify-content:space-between; width:100%; min-height:44px; padding:12rpx 0; color:var(--text-secondary); background:transparent; font-size: 12px; }
.club-page .roster-toggle>text:first-child { color:var(--text-secondary); }
.rank-group { margin:18rpx 0; padding:24rpx; background: #ffffff;  }
.form-section { margin:18rpx 0; padding:24rpx; background: #ffffff;  }
.rank-row { min-height:44px; padding:12rpx 0; border-bottom:1rpx solid var(--border); font-size: 12px; }
.rank-row:last-child { border-bottom:0; }
.rank-time { color:var(--brand); font-variant-numeric:tabular-nums; }
.rank-label,.form-label { margin:12rpx 0; color:var(--text-secondary); font-size: 12px; font-weight:500; }
.field { display:block; width:100%; height:88rpx; margin-top:16rpx; padding:0 20rpx; box-sizing:border-box; color:#333333;  font-size: 12px; }
.form-grid { display:flex; flex-wrap:wrap; gap:0 12rpx; }
.form-grid .field { flex:1; min-width:220rpx;  }
.form-hint { margin:14rpx 0; color:var(--text-secondary); font-size: 12px; line-height:1.65; }
.choice-row { display:flex; flex-wrap:wrap; gap:10rpx; margin:14rpx 0; }
.club-page .choice { min-height:44px; padding:14rpx 20rpx; font-size: 12px; background:var(--page-bg); color:var(--text-secondary);  }
.club-page .choice-selected { color:var(--brand); background:var(--brand-soft); }
.club-page .primary-btn,.club-page .secondary-btn { width:100%; min-height:44px; margin-top:18rpx; font-size: 14px;  }
.club-page .primary-btn { color:#fff;  }
.club-page .disclosure { justify-content:space-between; gap:16rpx; width:100%; min-height:44px; padding:8rpx 0; text-align:left; color:var(--text-secondary); background:transparent; font-size: 14px; }
.disclosure>text:first-child { flex:1; min-width:0; }
.disclosure-state { flex:none; color:var(--brand); font-size: 12px; font-weight:400; }
.manage-inline { margin-top:18rpx; padding-top:14rpx; border-top:1rpx solid var(--page-bg); }
.fee-history-section { margin-top:22rpx; padding-top:12rpx; border-top:1rpx solid var(--page-bg); }
.mileage-panel { display:block; padding:28rpx; border:1rpx solid var(--border);  background: #ffffff; }
.mileage-panel .section-head { margin:0;  }
.mileage-total { margin:24rpx 0 16rpx; color:var(--brand); font-size:70rpx; line-height:1.1; font-weight:700; font-variant-numeric:tabular-nums; letter-spacing:-2rpx; }
.mileage-total text { color:var(--text-secondary); font-size: 12px; letter-spacing:0; font-weight:400; }
.member-search { display:flex; align-items:center; gap:18rpx; min-height:44px; padding:0 24rpx; background:#fff; border:1rpx solid var(--border); border-radius:16rpx; }
.search-glass { flex:none; width:22rpx; height:22rpx; border:3rpx solid var(--text-secondary); border-radius:50%; position:relative; }
.search-glass::after { position:absolute; right:-9rpx; bottom:-5rpx; width:12rpx; height:3rpx; content:''; background:var(--text-secondary); transform:rotate(45deg); }
.member-search input { flex:1; min-width:0; height:88rpx; font-size: 14px; }
.member-filters { justify-content:flex-start; margin:14rpx 0; gap:10rpx; }
.member-filters>.muted { margin-left:auto; }
.club-page .member-filter { min-height:44px; padding:12rpx 18rpx; color:var(--text-secondary); background:transparent; font-size: 12px;  }
.club-page .member-filter.is-active { color:var(--brand); background:var(--brand-soft);  }
.member-row { min-height:112rpx; justify-content:flex-start; padding:20rpx 22rpx; margin-bottom:10rpx; box-sizing:border-box; background: #ffffff; border-radius:18rpx; }
.member-avatar { flex:none; width:70rpx; height:70rpx; border-radius:50%; background: var(--lilac-soft); }
.member-info { flex:1; min-width:0; }
.member-name { overflow:hidden; color:#333333; font-size: 14px; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.member-info .muted { margin-top:4rpx; font-size: 12px; }
.club-page .member-manage { flex:none; min-height:44px; padding:12rpx 16rpx; color:var(--text-secondary); background:var(--page-bg); font-size: 12px;  }
.pending-pill { color:var(--brand); font-size: 12px; font-weight:500; }
.approval-row { min-height:44px; border-bottom:1rpx solid var(--border); font-size: 12px; }
.approval-row>text { flex:1; min-width:0; overflow-wrap:anywhere; }
.approval-actions { flex-wrap:wrap; justify-content:flex-end; gap:4rpx 10rpx; }
.approve,.reject { display:flex; align-items:center; justify-content:center; min-height:44px; min-width:72rpx; padding:8rpx; box-sizing:border-box; font-size: 12px; }
.approve { color:#16875c; }
.reject { color:var(--text-secondary); }
.club-page .text-action { width:auto; min-height:44px; padding:8rpx 4rpx; color:var(--brand); font-size: 12px; background:transparent; font-weight:400; line-height:1.4; }
text.text-action { display:inline-flex; align-items:center; min-height:44px; box-sizing:border-box; padding:8rpx; color:var(--brand); font-size: 12px; }
.toggle-line { min-height:44px; padding:8rpx 0; color:var(--text-secondary); font-size: 12px; }
.toggle-line>text { flex:none; color:var(--brand); }
.checkin-day { margin-top:20rpx; }
.checkin-day .plain-row { min-height:44px; margin:0; padding:14rpx 0; border-bottom:1rpx solid var(--border); border-radius:0; }
.club-page .leave-button { color:var(--brand); }
.error { margin:20rpx 0; padding:20rpx; color:var(--brand); background:var(--brand-soft); border-radius:14rpx; font-size: 12px; overflow-wrap:anywhere; }
.loading { padding:100rpx 32rpx; color:var(--text-secondary); font-size: 14px; text-align:center; }
.club-poster-canvas { position:fixed; left:-2000px; top:0; width:1px; height:1px; pointer-events:none; }
.poster-layer { position:fixed; inset:0; z-index:50; display:flex; align-items:center; justify-content:center; padding:24rpx; box-sizing:border-box; background:rgba(20,22,28,.76); }
.poster-frame { width:100%; max-width:680rpx; max-height:92vh; overflow-y:auto; text-align:center; }
.poster-image { display:block; width:100%; border-radius:12rpx; }
.poster-hint { padding:18rpx 0; color:#fff; font-size: 12px; }
@media (max-width:350px) {
  .club-page { padding:24rpx; padding-bottom:calc(64rpx + env(safe-area-inset-bottom)); background: transparent; }
  .club-tabs { margin-left:0; margin-right:0; padding:0; background: rgba(247,248,252,.96); }
  .club-hero { padding:24rpx 28rpx 20rpx; background: linear-gradient(135deg,#eaf4ff,#ffffff); border-color: #dceaf5; box-shadow: var(--card-shadow); }
  .club-title { font-size: 26px; }
  .club-letter { width:104rpx; height:116rpx; }
  .club-identity { gap:20rpx; }
  .avatar { width:42rpx; height:42rpx; margin-right:-14rpx; }
  .club-community { gap:12rpx; }
  .club-page .hero-share { gap:12rpx; padding:16rpx 22rpx;  }
  .club-subtitle { font-size: 12px; }
  .section-head { gap:8rpx; }
  .section-link { font-size: 12px; }
  .section-title { font-size: 18px; }
  .next-title { font-size: 22px; }
  .next-bottom { flex-wrap:wrap; }
  .quick-entry { font-size: 12px; }
  .member-areas { gap:2rpx; }
  .club-page .member-area { font-size: 12px; padding-left:4rpx; padding-right:4rpx;  }
  .plain-row { gap:12rpx; }
  .plain-row>text:last-child { max-width:42%; }
  .approval-actions { gap:4rpx; }
}

.today-panel { margin:24rpx 0 30rpx; padding:26rpx 30rpx 0; background: #ffffff; border:1rpx solid var(--border);  }
.today-panel-heading { display:flex; justify-content:space-between; align-items:center; gap:12rpx; }
.today-panel-label { color:var(--text); font-size:14px; font-weight:650; }
.today-panel-note { color:var(--text-secondary); font-size:12px; }
.my-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0; margin:26rpx 0 20rpx; }
.club-page .my-summary-card { display:flex; flex-direction:column; align-items:flex-start; justify-content:flex-start; gap:12rpx; width:100%; min-width:0; min-height:162rpx; margin:0; padding:0 26rpx 0 0; border-radius:0; background:transparent; text-align:left; font-weight:400; }
.club-page .my-summary-card+.my-summary-card { padding:0 0 0 26rpx; border-left:1rpx solid var(--border); }
.my-summary-label { display:flex; justify-content:space-between; width:100%; gap:8rpx; color:var(--text-secondary); font-size:12px; }
.summary-arrow { color:var(--text-secondary); font-size:14px; }
.my-summary-value { color:var(--text); font-size:30px; font-weight:650; font-variant-numeric:tabular-nums; line-height:1.2; letter-spacing:-1rpx; }
.my-summary-value text { font-size:12px; font-weight:400; color:var(--text-secondary); }
.my-summary-status { display:flex; align-items:center; min-height:36px; color:var(--text); font-size:17px; font-weight:600; line-height:1.4; }
.my-summary-hint { color:var(--text-secondary); font-size:12px; line-height:1.5; }
.activity-filters { display:flex; flex-wrap:wrap; gap:14rpx; margin:0 0 20rpx; }
.club-page .activity-filter { flex:none; min-height:44px; width:auto; padding:14rpx 22rpx;  color:var(--text-secondary); background:var(--border); font-size: 12px; font-weight:500; }
.club-page .activity-filter.active { color:var(--brand); background:var(--brand-soft);  }
.filter-count { margin-left:12rpx; font-size: 12px; font-variant-numeric:tabular-nums; }
.loading-title { color:var(--text-secondary); font-size: 16px; font-weight:600; }
.loading-message { margin-top:20rpx; line-height:1.7; }
.loading .retry-button { display:flex; align-items:center; justify-content:center; width:280rpx; min-height:44px; margin:38rpx auto 24rpx;  color:#fff; background:var(--brand); font-size: 14px; line-height:1.2; }
.loading .retry-button::after { border:0;  }
.loading-back { padding:22rpx; color:var(--text-secondary); font-size: 12px; }

.public-identity-line { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin:10rpx 0 0; color:var(--text-secondary); font-size:12px; line-height:1.7; overflow-wrap:anywhere; }
.meta-divider { color:var(--border); }
.club-page .verified-mark { justify-content:flex-start; min-height:44px; padding:12rpx 0; color:var(--text-secondary); background:transparent; font-size: 12px; }
.created-guide { margin-top:20rpx; padding:28rpx;  background: #ffffff; border:1rpx solid var(--border); }
.created-guide .muted { margin-top:12rpx;  }
.created-actions { display:flex; flex-direction:column; gap:12rpx; margin-top:24rpx; }
.first-activity { display:flex; align-items:center; justify-content:center; min-height:44px; padding:16rpx; box-sizing:border-box;  color:var(--text-secondary); background: var(--sun-soft); font-size: 12px; }
.club-page .identity-secondary { width:100%; min-height:44px; margin-top:12rpx; padding:16rpx 0; color:var(--text-secondary); background:transparent; font-size: 12px; }
.club-page .identity-setting { justify-content:space-between; width:100%; min-height:120rpx; padding:26rpx; color:var(--text-secondary); background:#fff; text-align:left; }
.identity-setting>view { flex:1; min-width:0; }
.identity-setting .section-title { font-size: 18px; }

@media (max-width:350px) { .club-page .verified-mark { min-height:44px;  }
.club-page .identity-secondary { min-height:44px;  }
.first-activity { min-height:44px; background: var(--sun-soft); } }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-club-club .club-hero, .mini-club-club .next-activity, .mini-club-club .empty-card, .mini-club-club .quick-grid, .mini-club-club .today-panel, .mini-club-club .service-grid, .mini-club-club .preview-row, .mini-club-club .training-item, .mini-club-club .match-row, .mini-club-club .rank-group, .mini-club-club .form-section, .mini-club-club .mileage-panel, .mini-club-club .created-guide { border-radius: 36rpx; }
.mini-club-club .primary-btn, .mini-club-club .secondary-btn, .mini-club-club .hero-share, .mini-club-club .member-manage, .mini-club-club .retry-button, .mini-club-club .field, .mini-club-club .first-activity { border-radius: 24rpx; }
.mini-club-club .activity-filter, .mini-club-club .member-filter, .mini-club-club .choice, .mini-club-club .role, .mini-club-club .signup-state, .mini-club-club .sub-tab, .mini-club-club .member-area { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-club-club { color: var(--text); }
.mini-club-club button { font-weight: 500; border-radius: 24rpx; }

.club-page { color: var(--text); background: transparent; }
.club-hero { border: 1px solid var(--border); background: linear-gradient(135deg,#eaf4ff,#ffffff); border-color: #dceaf5; box-shadow: var(--card-shadow); }
.club-title { font-size: 26px; font-weight: 600; line-height: 1.4; }
.club-page .hero-share { border: 1px solid var(--brand); border-radius: 24rpx; background: var(--brand); color: #fff; padding: 0 22rpx; min-height: 44px; font-size: 12px; }
.role { border: 1px solid var(--border); background: var(--sun-soft); color: var(--text-secondary); font-size: 11px; }
.signup-state { border: 1px solid var(--border); background: var(--page-bg); color: var(--text-secondary); font-size: 11px; }
.club-tab.selected::after { height: 2px; border-radius: 0; background: var(--brand); }
.next-empty { border: 1px solid var(--border); background: #ffffff; border-color: #f4ddd0; }
.next-activity { border: 1px solid var(--border); background: #ffffff; border-color: #f4ddd0; box-shadow: var(--card-shadow); }
.quick-grid { border: 1px solid var(--border); background: #ffffff; box-shadow: var(--card-shadow); }
.today-panel { border: 1px solid var(--border); background: #ffffff; }
.service-grid { border: 1px solid var(--border); background: #ffffff; }
.form-section { border: 1px solid var(--border); background: #ffffff; }
.rank-group { border: 1px solid var(--border); background: #ffffff; }
.mileage-panel { border: 1px solid var(--border); background: #ffffff; }
.next-empty { background: #ffffff; border-color: #f4ddd0; }
.empty-title { font-size: 24px; font-weight: 600; }
.club-page .empty-action,.activity-publish { border-radius: 24rpx; background: var(--brand); color: #fff; font-size: 12px; }
.sub-tabs,.member-areas { gap: 18rpx; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; }
.club-page .sub-tab,.club-page .member-area { border-radius: 0; background: transparent; color: var(--text-secondary); font-size: 13px; }
.club-page .sub-tab.active,.club-page .member-area.active { color: var(--text); background: transparent; box-shadow: inset 0 -2px var(--brand); }
.club-page .activity-filter,.club-page .member-filter,.club-page .choice { min-height: 36px; padding: 0 18rpx; border: 1px solid var(--border); border-radius: 14rpx; background: #fff; color: var(--text-secondary); font-size: 12px; }
.club-page .activity-filter.active,.club-page .member-filter.active,.club-page .choice.selected { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
.club-page .primary-btn { border-radius: 24rpx; background: var(--brand); font-size: 12px; }
.club-page .secondary-btn { border: 1px solid var(--border); border-radius: 24rpx; background: #fff; color: var(--text-secondary); font-size: 12px; }
.field { border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); }
.member-row { border-color: var(--border); background: #ffffff; }
.training-item { border-color: var(--border); background: #ffffff; }
.match-row { border-color: var(--border); }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-club-club .primary-btn, .mini-club-club .activity-publish, .mini-club-club .hero-share, .mini-club-club .empty-action { font-size: 14px; font-weight: 500; }
.mini-club-club .secondary-btn { font-size: 13px; font-weight: 500; }
.club-page .member-filter.is-active,.club-page .choice.choice-selected { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
