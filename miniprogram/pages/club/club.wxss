/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-club-club .empty-card, .mini-club-club .service-grid, .mini-club-club .preview-row, .mini-club-club .training-item, .mini-club-club .match-row, .mini-club-club .rank-group, .mini-club-club .form-section, .mini-club-club .mileage-panel, .mini-club-club .created-guide { border-radius: 32rpx; }
.mini-club-club .primary-btn, .mini-club-club .secondary-btn, .mini-club-club .member-manage, .mini-club-club .retry-button, .mini-club-club .field, .mini-club-club .first-activity { border-radius: 24rpx; }
.mini-club-club .activity-filter, .mini-club-club .member-filter, .mini-club-club .choice, .mini-club-club .role, .mini-club-club .sub-tab, .mini-club-club .member-area { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-club-club { color: var(--text); }
.mini-club-club button { font-weight: 500; border-radius: 24rpx; }
.role { border: 1px solid var(--border); background: var(--sun-soft); color: var(--text-secondary); font-size: 12px; }
.service-grid { border: 1px solid var(--border); background: var(--card,#fff); }
.form-section { border: 1px solid var(--border); background: var(--card,#fff); }
.rank-group { border: 1px solid var(--border); background: var(--card,#fff); }
.mileage-panel { border: 1px solid var(--border); background: var(--card,#fff); }
.empty-title { font-size: 24px; font-weight: 600; }
.club-page .empty-action,.activity-publish { border-radius: 24rpx; background: var(--brand); color: #fff; font-size: 12px; }
.sub-tabs,.member-areas { gap: 18rpx; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; }
.club-page .sub-tab,.club-page .member-area { border:0; border-radius:0; background:transparent; color:var(--text-secondary); font-size:14px; }
.club-page .sub-tab.active,.club-page .member-area.active { color: var(--text); background: transparent; box-shadow: none; }
.club-page .activity-filter,.club-page .member-filter,.club-page .choice { min-height: 36px; padding: 0 18rpx; border: 1px solid var(--border); border-radius: 14rpx; background: var(--card,#fff); color: var(--text-secondary); font-size: 12px; }
.club-page .activity-filter.active,.club-page .member-filter.active,.club-page .choice.selected { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
.club-page .primary-btn { border-radius: 24rpx; background: var(--brand); font-size: 12px; }
.club-page .secondary-btn { border: 1px solid var(--border); border-radius: 24rpx; background: var(--card,#fff); color: var(--text-secondary); font-size: 12px; }
.field { border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); }
.member-row { border-color: var(--border); background: var(--card,#fff); }
.training-item { border-color: var(--border); background: var(--card,#fff); }
.match-row { border-color: var(--border); }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-club-club .primary-btn, .mini-club-club .activity-publish, .mini-club-club .empty-action { font-size: 14px; font-weight: 500; }
.mini-club-club .secondary-btn { font-size: 14px; font-weight: 500; }
.club-page .member-filter.is-active,.club-page .choice.choice-selected { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }

/* Club profile and overview: quiet surfaces, clear actions, factual status. */
.club-page { min-height:100vh; padding:0 32rpx calc(64rpx + env(safe-area-inset-bottom)); box-sizing:border-box; color:var(--text); background:var(--page-bg); font-size:14px; line-height:1.5; }
.mini-club-club .club-hero { margin:0 -32rpx; padding:0 36rpx 8rpx; border:0; border-radius:0; background:var(--card,#fff); box-shadow:none; }
.hero-topline { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.club-eyebrow { color:var(--text-secondary); font-size:12px; letter-spacing:normal; }
.switch-club { display:flex; align-items:center; gap:8rpx; min-height:44px; color:var(--text-secondary); font-size:12px; }
.switch-club > text { color:var(--text-secondary); font-size:16px; }
.club-identity { display:flex; align-items:flex-start; gap:28rpx; margin:12rpx 0 28rpx; }
.club-letter { display:flex; flex:none; align-items:center; justify-content:center; width:56px; height:56px; border-radius:12px; color:#fff; background:var(--brand); font-size:24px; font-weight:600; box-shadow:none; }
.club-identity-copy { flex:1; min-width:0; }
.club-title { color:var(--text); font-size:24px; font-weight:600; line-height:1.35; letter-spacing:normal; overflow-wrap:anywhere; }
.public-identity-line { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin-top:12rpx; color:var(--text-secondary); font-size:12px; line-height:1.6; }
.meta-divider { color:var(--text-secondary); }
.club-subtitle { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin-top:10rpx; color:var(--text-secondary); font-size:12px; line-height:1.6; }
.club-subtitle .role { padding:1rpx 9rpx; border:0; border-radius:6rpx; background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); font-size:12px; font-weight:500; }
.hero-bottom { display:flex; align-items:center; gap:20rpx; border-top:1rpx solid var(--border); }
.club-page .club-community { display:flex; flex:1; align-items:center; justify-content:flex-start; gap:20rpx; min-width:0; min-height:68px; margin:0; padding:8rpx 0; border:0; border-radius:0; background:transparent; text-align:left; box-shadow:none; }
.avatar-line { display:flex; flex:none; align-items:center; min-width:0; }
.avatar-line .avatar { display:flex; flex:none; align-items:center; justify-content:center; width:28px; height:28px; margin-right:-9px; box-sizing:border-box; border:2px solid var(--border); border-radius:50%; background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); font-size:12px; font-weight:500; }
.avatar-line .avatar:last-child { margin-right:0; }
.avatar-line .avatar:nth-child(2) { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }
.avatar-line .avatar:nth-child(3) { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }
.avatar-line .avatar:nth-child(4) { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }
.avatar-caption { min-width:0; }
.community-count { color:var(--text); font-size:12px; font-weight:500; white-space:nowrap; }
.community-hint { margin-top:4rpx; color:var(--text-secondary); font-size:12px; font-weight:400; }
.community-chevron { margin-left:0; color:var(--text-secondary); font-size:18px; font-weight:400; }
.mini-club-club .hero-share { flex:none; gap:6rpx; min-height:40px; margin:0; padding:0 22rpx; border:1rpx solid var(--border); border-radius:12px; background:var(--card,#fff); color:var(--text); font-size:14px; font-weight:500; box-shadow:none; }
.hero-share > text { color:var(--brand); font-size:18px; font-weight:400; }
.club-tabs { position:sticky; top:0; z-index:5; display:flex; margin:0 -32rpx 4rpx; padding:0 24rpx; border-bottom:1rpx solid var(--border); background:var(--card,#fff); }
.club-tab { position:relative; display:flex; flex:1; align-items:center; justify-content:center; min-height:52px; color:var(--text-secondary); font-size:14px; font-weight:400; }
.club-tab.selected { color:var(--text); font-weight:600; }
.club-tab.selected::after { position:absolute; bottom:0; width:22px; height:3px; border-radius:2px; background:var(--brand); content:''; }
.overview-section-head { margin:30rpx 0 14rpx; }
.overview-section-head .section-title { font-size:18px; font-weight:600; letter-spacing:normal; }
.overview-section-head .section-link { display:flex; align-items:center; min-height:44px; color:var(--text-secondary); font-size:12px; }
.mini-club-club .next-activity { display:block; overflow:hidden; padding:32rpx; border:0; border-radius:12px; background:var(--card,#fff); box-shadow:none; }
.next-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.next-label { display:flex; align-items:center; gap:10rpx; color:var(--brand); font-size:12px; font-weight:500; }
.activity-state-dot { width:5px; height:5px; border-radius:50%; background:currentColor; }
.activity-live .next-label { color:var(--text-secondary); }
.mini-club-club .signup-state { flex:none; max-width:50%; padding:4rpx 10rpx; border:0; border-radius:6px; background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); font-size:12px; font-weight:400; }
.signup-state.signed { color:var(--text-secondary); background:var(--field-bg,var(--page-bg)); }
.next-title { margin:24rpx 0 0; color:var(--text); font-size:22px; font-weight:600; line-height:1.45; letter-spacing:normal; overflow-wrap:anywhere; }
.next-meta { display:flex; flex-wrap:wrap; align-items:baseline; gap:16rpx; margin-top:20rpx; color:var(--text); font-size:14px; }
.next-clock { color:var(--text); font-variant-numeric:tabular-nums; font-weight:600; }
.next-location { margin-top:8rpx; color:var(--text-secondary); font-size:12px; line-height:1.6; overflow-wrap:anywhere; }
.next-bottom { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16rpx; margin-top:26rpx; padding-top:22rpx; border-top:1rpx solid var(--border); color:var(--text-secondary); font-size:12px; }
.next-cta { color:var(--text); font-weight:500; white-space:nowrap; }
.next-cta > text { padding-left:8rpx; color:var(--brand); }
.mini-club-club .next-empty { min-height:0; padding:32rpx; border:0; border-radius:12px; background:var(--card,#fff); }
.empty-content { position:relative; }
.next-empty .empty-title { margin:0 0 12rpx; color:var(--text); font-size:18px; line-height:1.45; font-weight:600; letter-spacing:normal; }
.next-empty .empty-action { margin-top:24rpx; min-height:40px; padding:0 24rpx; border:0; border-radius:12px; font-size:14px; }
.mini-club-club .quick-grid { display:flex; margin:20rpx 0 24rpx; padding:24rpx 4rpx; border:0; border-radius:12px; background:var(--card,#fff); box-shadow:none; }
.quick-entry { display:flex; flex:1; min-width:0; min-height:60px; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; color:var(--text); font-size:12px; font-weight:400; }
.quick-icon { display:flex; align-items:center; justify-content:center; width:32px; height:32px; }
.quick-entry image { display:block; width:29px; height:29px; }
.mini-club-club .today-panel { margin:24rpx 0 30rpx; padding:30rpx 32rpx 0; border:0; border-radius:12px; background:var(--card,#fff); }
.today-panel-heading { display:flex; align-items:center; justify-content:space-between; }
.today-panel-label { color:var(--text); font-size:14px; font-weight:600; }
.my-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0; margin:28rpx 0 28rpx; }
.club-page .my-summary-card { display:flex; flex-direction:column; align-items:flex-start; justify-content:flex-start; gap:10rpx; width:100%; min-width:0; min-height:92px; margin:0; padding:0 24rpx 0 0; border:0; border-radius:0; background:transparent; text-align:left; font-weight:400; box-shadow:none; }
.club-page .my-summary-card + .my-summary-card { padding:0 0 0 28rpx; border-left:1rpx solid var(--border); }
.my-summary-label { display:flex; justify-content:space-between; width:100%; gap:8rpx; color:var(--text-secondary); font-size:12px; }
.summary-arrow { color:var(--text-secondary); font-size:14px; }
.my-summary-value { color:var(--text); font-size:29px; font-weight:600; font-variant-numeric:tabular-nums; line-height:1.25; }
.my-summary-value text { color:var(--text-secondary); font-size:12px; font-weight:400; }
.my-summary-status { display:flex; align-items:center; min-height:36px; color:var(--text); font-size:18px; font-weight:600; line-height:1.4; }
.my-summary-hint { color:var(--text-secondary); font-size:12px; line-height:1.5; }
.club-page .checkin-entry { justify-content:space-between; gap:16rpx; width:100%; min-height:76px; padding:24rpx 0; border:0; border-radius:0; background:transparent; text-align:left; box-shadow:none; }
@media (max-width:350px) {
  .club-identity { gap:24rpx; }
  .club-title { font-size:22px; }
  .club-page .club-community { gap:14rpx; }
  .avatar-line .avatar { width:25px; height:25px; margin-right:-10px; }
  .avatar-line .avatar:last-child { margin-right:0; }
  .mini-club-club .hero-share { padding:0 18rpx; }
  .next-title { font-size:20px; }
}

.training-group-entry { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:60px; }
.training-group-entry .muted { margin-top:10rpx; }
.training-group-entry>text { color:var(--text-secondary); font-size:22px; }

.club-journal-entry{display:flex;align-items:center;justify-content:space-between;margin:40rpx 0 16rpx;padding:36rpx;background:var(--field-bg,var(--page-bg));border:1rpx solid var(--border);border-radius:24rpx;color:var(--text)}.journal-entry-eyebrow{font-size:12px;letter-spacing:normal;color:var(--text-secondary)}.journal-entry-title{font-size:22px;font-weight:600;margin:10rpx 0}.journal-entry-note{font-size:12px;color:var(--text-secondary)}.club-journal-entry>text{font-size:28px;color:var(--text-secondary)}

/* Club content, forms and service rows share the same compact system. */
.club-page { color:var(--text); font-size:14px; line-height:1.6; }
.club-title { color:var(--text); font-size:22px; font-weight:600; letter-spacing:normal; }
.club-letter { width:52px; height:52px; border-radius:24rpx; font-size:24px; font-weight:600; background:var(--brand); color:#fff; box-shadow:none; }
.club-tabs { border-color:var(--border); background:var(--card,#fff); }
.club-tab { min-height:48px; font-size:14px; font-weight:400; color:var(--text-secondary); }
.club-tab.selected { color:var(--brand); font-weight:500; }
.club-tab.selected::after { height:2px; border-radius:0; background:var(--brand); }
.section-title,.overview-section-head .section-title,.identity-setting .section-title,.training-group-entry .section-title { color:var(--text); font-size:18px; font-weight:600; letter-spacing:normal; line-height:1.5; }
.club-page .next-activity,.club-page .next-empty,.club-page .quick-actions,.club-page .club-moments,.club-page .form-section,.club-page .preview-row,.club-page .training-item,.club-page .rank-group,.club-page .created-guide,.club-page .empty-card,.club-page .my-club-summary { border-radius:24rpx; border-color:var(--border); background:var(--card,#fff); box-shadow:none; }
.club-page .next-title,.training-title,.link-title,.preview-title,.match-title { font-size:16px; font-weight:500; color:var(--text); }
.club-page .primary-btn,.club-page .secondary-btn { min-height:44px; border-radius:20rpx; padding:18rpx 26rpx; font-size:14px; font-weight:500; }
.club-page .primary-btn { color:#fff; background:var(--brand); border:1rpx solid var(--brand); }
.club-page .secondary-btn { color:var(--text); background:var(--card,#fff); border:1rpx solid var(--border); }
.club-page .disclosure,.club-page .identity-setting { display:flex; align-items:center; justify-content:space-between; gap:20rpx; width:100%; min-height:48px; margin:0; padding:20rpx 0; border:0; border-radius:0; background:transparent; color:var(--text); font-size:14px; font-weight:500; text-align:left; }
.club-page .identity-setting { padding:28rpx; margin:24rpx 0; border:1rpx solid var(--border); border-radius:24rpx; background:var(--card,#fff); }
.club-page .identity-setting .muted { color:var(--text-secondary); font-size:12px; font-weight:400; }
.disclosure-state { color:var(--text-secondary); font-size:12px; font-weight:400; }
.manage-inline { border-top:1rpx solid var(--border); margin-top:20rpx; }
.club-page .service-entry { min-height:52px; color:var(--text); background:transparent; border-radius:0; }
.service-entry>text:first-child { color:var(--text); font-size:14px; font-weight:400; }
.quick-icon { background:var(--brand-soft); color:var(--brand); border-radius:20rpx; }
.club-page .sub-tabs,.club-page .member-areas { padding:0; border-bottom:1rpx solid var(--border); border-radius:0; background:transparent; }
.club-page .sub-tab,.club-page .member-area { min-height:44px; padding:0 12rpx; border-radius:0; background:transparent; color:var(--text-secondary); font-size:14px; font-weight:400; }
.club-page .sub-tab.active,.club-page .member-area.active { color:var(--brand); background:transparent; box-shadow:inset 0 -2px var(--brand); font-weight:500; }
.club-page .field,.club-page textarea,.club-page .member-search { min-height:44px; border:1rpx solid var(--border); border-radius:20rpx; background:var(--page-bg); color:var(--text); font-size:14px; font-weight:400; }
.club-page .choice,.club-page .member-filter,.club-page .member-manage { min-height:44px; border-radius:20rpx; font-size:12px; font-weight:400; }
.club-page .form-hint,.club-page .muted,.club-page .rank-label,.club-page .preview-meta,.club-page .next-meta { font-size:12px; color:var(--text-secondary); font-weight:400; }
.club-page .member-name { color:var(--text); font-size:14px; font-weight:500; }
.club-page .mileage-total { color:var(--text); font-size:40px; font-weight:600; letter-spacing:normal; }
.club-page .club-journal-entry { margin:28rpx 0 16rpx; padding:28rpx; border:1rpx solid var(--border); border-radius:24rpx; color:var(--text); background:var(--card,#fff); }
.journal-entry-eyebrow { color:var(--text-secondary); font-size:12px; letter-spacing:normal; }
.journal-entry-title { color:var(--text); font-size:18px; font-weight:500; margin:8rpx 0; }
.journal-entry-note { color:var(--text-secondary); font-size:12px; }
.club-journal-entry>text { color:var(--brand); font-size:22px; }
@media(max-width:350px) { .club-title { font-size:22px; }.club-page .next-title { font-size:16px; }.club-page .mileage-total { font-size:36px; } }

@import "./club-visual.wxss";
