<view class="pad" wx:if="{{club}}">
  <view class="card">
    <view class="title">{{club.name}}</view>
    <view class="row"><text class="k">口令，发到微信群</text><text>{{club.code}}</text></view>
    <view class="tags">
      <text wx:for="{{members}}" wx:key="id" class="chip">{{item.nickname}}</text>
    </view>
  </view>
  <navigator class="card" url="/pages/mileage/mileage?id={{club.id}}">
    <view class="title">跑量</view>
    <view class="src">已计入 {{mileage.totalKm}} 公里，{{mileage.totalCount}} 次。我本月 {{mileage.mineKm}} 公里。</view>
  </navigator>
  <navigator class="card" url="/pages/partner/partner?id={{club.id}}">
    <view class="title">合作</view>
    <view class="src">{{partnerGrade}}。会费仍由跑团自己收。</view>
  </navigator>
  <view class="card">
    <view class="h2">团练签到</view>
    <view class="src">只记今天谁到了，不记公里。</view>
    <view class="field">
      <input placeholder="可写一句，比如夜跑" value="{{note}}" maxlength="40" bindinput="onNote" />
    </view>
    <button class="btn" bindtap="checkIn">{{checkedIn ? '改一句' : '签到'}}</button>
    <button wx:if="{{checkedIn}}" class="ghost" bindtap="undoCheckin">撤销今天</button>
    <view wx:if="{{!checkins.length}}" class="src">今天还没有人签到。</view>
    <view wx:for="{{checkins}}" wx:for-item="day" wx:key="date">
      <view class="src">{{day.label}}</view>
      <view wx:for="{{day.rows}}" wx:for-item="row" wx:key="userId" class="row">
        <text>{{row.nickname}}</text>
        <text>{{row.note}}</text>
      </view>
    </view>
    <view wx:if="{{checkMessage}}" class="err">{{checkMessage}}</view>
  </view>
  <view class="card" wx:if="{{ranks.length}}">
    <view class="h2">团内成绩</view>
    <view class="src">每人每项只留最好的一场。</view>
    <view wx:for="{{ranks}}" wx:for-item="group" wx:key="distance">
      <view class="src">{{group.label}}</view>
      <navigator wx:for="{{group.rows}}" wx:for-item="row" wx:key="nickname" class="row" url="/pages/race/race?id={{row.raceId}}">
        <text>{{row.place}} {{row.nickname}}</text>
        <text>{{row.clock}}</text>
      </navigator>
    </view>
  </view>
  <view class="card">
    <view class="h2">成绩统计</view>
    <view class="src">发到群里填写。填完后全团都能看。</view>
    <navigator wx:for="{{calls}}" wx:key="id" class="row" url="/pages/call/call?club={{club.id}}&id={{item.id}}">
      <text>{{item.title}}</text>
      <text>{{item.filled}} 人 · {{item.closed ? '已截止' : item.deadlineLabel}}</text>
    </navigator>
    <view wx:if="{{!calls.length}}" class="src">还没有成绩统计。</view>
    <view class="stack" wx:if="{{club.staff}}">
      <input placeholder="从赛历搜一场" value="{{raceQuery}}" data-key="raceQuery" bindinput="onDraft" bindconfirm="searchRaces" />
      <view wx:for="{{raceHits}}" wx:key="id" class="row" data-id="{{item.id}}" data-name="{{item.name}}" data-date="{{item.raceDate}}" data-distances="{{item.distanceText}}" bindtap="pickRace">
        <text>{{item.raceDate}} {{item.name}}</text>
      </view>
      <input placeholder="比赛名称" value="{{callTitle}}" maxlength="80" data-key="callTitle" bindinput="onDraft" />
      <input placeholder="比赛日 2026-11-15" value="{{callDate}}" data-key="callDate" bindinput="onDraft" />
      <view class="src">距离：{{callDistanceText || '还没选'}}</view>
      <button class="ghost" data-id="full" bindtap="toggleDistance">全马</button>
      <button class="ghost" data-id="half" bindtap="toggleDistance">半马</button>
      <button class="ghost" data-id="10k" bindtap="toggleDistance">10公里</button>
      <button class="ghost" data-id="5k" bindtap="toggleDistance">5公里</button>
      <input placeholder="其他距离，公里，可不填" value="{{callOther}}" data-key="callOther" bindinput="onDraft" />
      <input placeholder="说明，例如填净计时" value="{{callNote}}" maxlength="100" data-key="callNote" bindinput="onDraft" />
    </view>
    <button wx:if="{{club.staff}}" class="btn" bindtap="createCall">发起</button>
  </view>
  <view class="card">
    <view class="h2">活动</view>
    <view class="src">每周训练在这里报名。满人数并且每人打卡够里程才记分。</view>
    <navigator wx:for="{{activities}}" wx:key="id" class="row" url="/pages/activity/activity?club={{club.id}}&id={{item.id}}">
      <text>{{item.dateLabel}} {{item.title}}</text>
      <text>{{item.signupCount}}人 · {{item.statusLabel}}</text>
    </navigator>
    <view wx:if="{{!activities.length}}" class="src">还没有活动。</view>
    <button class="ghost" bindtap="shareRecent">分享最近 3 场</button>
  </view>
  <view class="card">
    <view class="h2">约跑</view>
    <view class="src">三人以上，当天打卡并上传合影才记积分。</view>
    <navigator wx:for="{{meetups}}" wx:key="id" class="row" url="/pages/meetup/meetup?club={{club.id}}&id={{item.id}}">
      <text>{{item.dateLabel}} {{item.place}}</text>
      <text>{{item.checkCount}} 人 · {{item.statusLabel}}</text>
    </navigator>
    <view wx:if="{{!meetups.length}}" class="src">还没有约跑。</view>
    <view class="stack">
      <input placeholder="日期 2026-10-22" value="{{meetDate}}" data-key="meetDate" bindinput="onDraft" />
      <input placeholder="地点" value="{{meetPlace}}" maxlength="40" data-key="meetPlace" bindinput="onDraft" />
      <input placeholder="说明，可不填" value="{{meetNote}}" maxlength="100" data-key="meetNote" bindinput="onDraft" />
    </view>
    <button class="btn" bindtap="createMeetup">发起约跑</button>
  </view>
  <view class="card">
    <view class="h2">队内赛</view>
    <view class="src">和每周训练分开报名。成绩不进赛历。</view>
    <navigator wx:for="{{internals}}" wx:key="id" class="row" url="/pages/internal/internal?club={{club.id}}&id={{item.id}}">
      <text>{{item.title}}</text>
      <text>{{item.signupCount}} 人 · {{item.statusLabel}}</text>
    </navigator>
    <view wx:if="{{!internals.length}}" class="src">还没有队内赛。</view>
    <view class="stack" wx:if="{{club.staff}}">
      <input placeholder="名称，例如 滨河10公里" value="{{raceTitle}}" maxlength="40" data-key="raceTitle" bindinput="onDraft" />
      <input placeholder="开赛 2026-11-01 08:00" value="{{raceWhen}}" data-key="raceWhen" bindinput="onDraft" />
      <input placeholder="地点" value="{{racePlace}}" maxlength="40" data-key="racePlace" bindinput="onDraft" />
      <input type="number" placeholder="完赛积分，0 表示不记分" value="{{racePoints}}" data-key="racePoints" bindinput="onDraft" />
    </view>
    <view wx:if="{{club.staff}}" class="src">默认男子组和女子组，10 公里。要改组别和距离，用网页。</view>
    <button wx:if="{{club.staff}}" class="btn" bindtap="createInternal">发起队内赛</button>
  </view>
  <view class="card" wx:if="{{club.staff}}">
    <view class="h2">入团申请</view>
    <view wx:if="{{!requests.length}}" class="src">没有待审核的申请。没口令的人会出现在这里。</view>
    <view wx:for="{{requests}}" wx:key="id" class="row">
      <text>{{item.nickname}}</text>
      <view>
        <text class="drop" data-id="{{item.id}}" data-decision="approve" bindtap="decide">通过</text>
        <text class="drop" data-id="{{item.id}}" data-decision="reject" bindtap="decide">拒绝</text>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="h2">相册</view>
    <navigator wx:for="{{albums}}" wx:key="id" class="row" url="/pages/album/album?club={{club.id}}&id={{item.id}}">
      <text>{{item.title}}</text>
      <text>{{item.photoCount}} 张 · {{item.videoCount}} 个视频</text>
    </navigator>
    <view wx:if="{{!albums.length}}" class="src">还没有活动照片。</view>
  </view>
  <view class="card" wx:if="{{attendance.rows}}">
    <view class="h2">出勤榜 · {{attendance.label}}</view>
    <view class="src">我 {{attendance.me.placeLabel}} · {{attendance.me.count}} 次</view>
    <view wx:for="{{attendance.rows}}" wx:key="userId" class="row" wx:if="{{item.count}}">
      <text>{{item.place}} {{item.nickname}}</text>
      <text>{{item.count}} 次</text>
    </view>
  </view>
  <view class="card" wx:if="{{club.staff}}">
    <view class="h2">发一场活动</view>
    <view class="stack">
      <input placeholder="例如 周日 LSD" value="{{actTitle}}" maxlength="40" data-key="actTitle" bindinput="onDraft" />
      <input placeholder="集合地点" value="{{actPlace}}" maxlength="40" data-key="actPlace" bindinput="onDraft" />
      <input placeholder="开始 2026-10-14 05:00" value="{{actWhen}}" data-key="actWhen" bindinput="onDraft" />
      <input placeholder="结束时间，可不填" value="{{actEnds}}" data-key="actEnds" bindinput="onDraft" />
      <input placeholder="期次，可不填" value="{{actIssue}}" maxlength="40" data-key="actIssue" bindinput="onDraft" />
      <input placeholder="集合点" value="{{actGather}}" maxlength="40" data-key="actGather" bindinput="onDraft" />
      <input placeholder="计划里程，可不填" value="{{actPlanned}}" data-key="actPlanned" bindinput="onDraft" />
      <input placeholder="说明，例如配速和路线" value="{{actNote}}" maxlength="500" data-key="actNote" bindinput="onDraft" />
      <input type="number" placeholder="成团人数" value="{{actPeople}}" data-key="actPeople" bindinput="onDraft" />
      <input type="digit" placeholder="每人至少多少公里" value="{{actKm}}" data-key="actKm" bindinput="onDraft" />
      <input type="number" placeholder="这场积分" value="{{actPoints}}" data-key="actPoints" bindinput="onDraft" />
    </view>
    <view class="src">满人数，且每人打卡不少于这个里程，才各得这场积分。人数不够，这场不计分。</view>
    <button class="btn" bindtap="createActivity">发出去</button>
  </view>
  <view class="card">
    <view class="h2">{{feeShown.name || '会费'}}</view>
    <view class="src">会费直接付给跑团。平台不经手，以团长确认为准。</view>
    <block wx:if="{{feeShown.id}}">
      <view class="src">{{feeShown.amount}} 元 · {{feeShown.startsOn}} 至 {{feeShown.endsOn}}</view>
      <view wx:if="{{feeShown.note}}" class="src">{{feeShown.note}}</view>
      <view class="src">我的状态：{{feeShown.mine.label}}</view>
      <view wx:if="{{feeShown.blockSignup}}" class="src">未交和待确认的人不能报名活动和队内赛。</view>
      <image wx:if="{{feeShown.qrSrc}}" class="qr" src="{{feeShown.qrSrc}}" mode="widthFix" show-menu-by-longpress="true" />
      <view wx:else class="src">团长还没有放收款码</view>
      <button wx:if="{{feeShown.canClaim}}" class="btn" bindtap="claimFee">我已转账</button>
      <view wx:for="{{feeShown.groups}}" wx:for-item="group" wx:key="status">
        <view class="src">{{group.label}}</view>
        <view wx:for="{{group.people}}" wx:for-item="person" wx:key="userId" class="row">
          <text>{{person.nickname}}</text>
          <view wx:if="{{club.staff}}">
            <text class="drop" data-id="{{person.userId}}" data-status="paid" bindtap="markFee">已收到</text>
            <text class="drop" data-id="{{person.userId}}" data-status="unpaid" bindtap="markFee">未收到</text>
            <text class="drop" data-id="{{person.userId}}" data-status="waived" bindtap="markFee">免交</text>
          </view>
        </view>
      </view>
      <button class="btn" data-text="{{feeShown.copyText}}" bindtap="copyText">复制名单</button>
    </block>
    <view wx:else class="src">还没有会费。</view>
    <view class="stack" wx:if="{{club.owner}}">
      <input placeholder="例如 2026 年度会费" value="{{feeName}}" maxlength="20" data-key="feeName" bindinput="onDraft" />
      <input type="number" placeholder="金额，整数元" value="{{feeAmount}}" data-key="feeAmount" bindinput="onDraft" />
      <input placeholder="开始 2026-01-01" value="{{feeStart}}" data-key="feeStart" bindinput="onDraft" />
      <input placeholder="结束 2026-12-31" value="{{feeEnd}}" data-key="feeEnd" bindinput="onDraft" />
      <input placeholder="说明" value="{{feeNote}}" maxlength="200" data-key="feeNote" bindinput="onDraft" />
      <text class="drop" bindtap="toggleFeeBlock">{{feeBlock ? '未交不能报名：开' : '未交不能报名：关'}}</text>
    </view>
    <button wx:if="{{club.owner}}" class="btn" bindtap="saveFee">{{feeCreating || !feeShown.id ? '开这一期' : '保存这一期'}}</button>
    <button wx:if="{{club.owner && feeShown.id && !feeCreating}}" class="ghost" bindtap="newPeriod">再开一期</button>
    <button wx:if="{{club.owner && feeShown.id}}" class="ghost" bindtap="chooseQr">上传收款码</button>
  </view>
  <view class="card">
    <view class="h2">成员</view>
    <view class="src">我的积分 {{myPoints}}</view>
    <view wx:for="{{members}}" wx:key="id" class="row">
      <text>{{item.nickname}}{{item.role !== 'member' ? ' · ' + item.roleLabel : ''}}</text>
      <view>
        <text>{{item.points}} 分</text>
        <text wx:if="{{club.owner && !item.owner && item.role !== 'manager'}}" class="drop" data-id="{{item.id}}" data-role="manager" data-name="{{item.nickname}}" bindtap="setRole">设为跑团管理</text>
        <text wx:if="{{club.owner && item.role === 'manager'}}" class="drop" data-id="{{item.id}}" data-role="member" data-name="{{item.nickname}}" bindtap="setRole">改为成员</text>
        <text wx:if="{{club.owner && !item.owner}}" class="drop" data-id="{{item.id}}" data-role="owner" data-name="{{item.nickname}}" bindtap="setRole">交给他当团长</text>
        <text wx:if="{{club.staff && !item.owner}}" class="drop" data-id="{{item.id}}" data-name="{{item.nickname}}" bindtap="removeMember">移出</text>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="h2">组别</view>
    <view wx:for="{{groups}}" wx:key="id" class="row">
      <text>{{item.name}}{{item.pace ? ' · ' + item.pace : ''}}</text>
      <text>{{item.capacity ? '限 ' + item.capacity + ' 人' : '不限'}}</text>
    </view>
    <view wx:if="{{!groups.length}}" class="src">还没有组别。</view>
    <view class="stack" wx:if="{{club.staff}}">
      <input placeholder="例如 A0" value="{{groupName}}" maxlength="20" data-key="groupName" bindinput="onDraft" />
      <input placeholder="配速，例如 530" value="{{groupPace}}" maxlength="20" data-key="groupPace" bindinput="onDraft" />
      <input type="number" placeholder="名额，0 表示不限" value="{{groupCap}}" data-key="groupCap" bindinput="onDraft" />
    </view>
    <button wx:if="{{club.staff}}" class="btn" bindtap="createGroup">加一组</button>
  </view>
  <view class="card">
    <view class="h2">礼品</view>
    <view class="src">用积分换，不付款。</view>
    <view wx:for="{{gifts}}" wx:key="id" class="row">
      <text>{{item.name}} · {{item.cost}} 分 · 剩 {{item.stock}}</text>
      <button class="ghost" data-id="{{item.id}}" data-name="{{item.name}}" disabled="{{!item.stock}}" bindtap="redeem">兑换</button>
    </view>
    <view wx:if="{{!gifts.length && !club.staff}}" class="src">还没有礼品。</view>
    <view class="stack" wx:if="{{club.staff}}">
      <input placeholder="礼品名" value="{{giftName}}" maxlength="20" data-key="giftName" bindinput="onDraft" />
      <input type="number" placeholder="所需积分" value="{{giftCost}}" data-key="giftCost" bindinput="onDraft" />
      <input type="number" placeholder="库存" value="{{giftStock}}" data-key="giftStock" bindinput="onDraft" />
    </view>
    <button wx:if="{{club.staff}}" class="btn" bindtap="createGift">上架</button>
  </view>
  <view wx:if="{{!board.length && !ranks.length}}" class="empty">还没有人标比赛。打开一场，标上想跑或已报名。</view>
  <view wx:for="{{board}}" wx:key="key" class="card">
    <navigator url="/pages/race/race?id={{item.race.id}}&code={{club.code}}">
      <view class="title">{{item.race.name}}</view>
      <view class="foot"><text>{{item.race.raceDate}}</text><text>{{item.race.deadlineLabel}}</text></view>
    </navigator>
    <view class="sum">{{item.title}}</view>
    <view>{{item.summary}}</view>
    <view wx:if="{{item.squadText}}" class="warn">{{item.squadText}}</view>
    <view wx:if="{{item.alternativeNote}}" class="warn">{{item.alternativeNote}}</view>
    <navigator wx:for="{{item.alternatives}}" wx:for-item="alt" wx:key="id" class="row" url="/pages/race/race?id={{alt.id}}">
      <text>{{alt.name}}</text><text>{{alt.deadlineLabel}}</text>
    </navigator>
    <view wx:if="{{item.unpaid.length}}" class="src">还没缴：{{item.unpaidText}}</view>
    <button class="btn share" open-type="share" data-id="{{item.race.id}}" data-title="{{item.title}}" bindtap="armShare">发到微信群</button>
    <view wx:for="{{item.marks}}" wx:for-item="mark" wx:key="nickname" class="row">
      <text>{{mark.nickname}}</text><text>{{mark.status}}{{mark.clock ? ' · ' + mark.clock : ''}}{{mark.pb ? ' PB' : ''}}</text>
    </view>
  </view>
  <view wx:if="{{message}}" class="err">{{message}}</view>
</view>
<view wx:else class="empty">{{message || '正在打开跑团'}}</view>
