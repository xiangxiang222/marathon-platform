<view class="pad" wx:if="{{activity}}">
  <view class="card">
    <view class="title">{{activity.title}}</view>
    <view wx:if="{{activity.issue}}" class="src">{{activity.issue}}</view>
    <view class="src">{{activity.statusLabel}} · {{activity.timeLabel}}</view>
    <view wx:if="{{activity.gatherAt}}" class="src">集合时间 {{activity.gatherAt}}</view>
    <view wx:if="{{activity.gatherPlace}}" class="src">集合点 {{activity.gatherPlace}}</view>
    <view wx:if="{{activity.place}}" class="src">地点 {{activity.place}}</view>
    <view wx:if="{{activity.plannedKm}}" class="src">计划里程 {{activity.plannedKm}} 公里</view>
    <view wx:if="{{activity.route}}" class="src">路线 {{activity.route}}</view>
    <view class="src">{{activity.signupCount}} 人报名{{activity.gendered ? ' · 男 ' + activity.men + ' · 女 ' + activity.women : ''}}</view>
    <view wx:if="{{activity.note}}" class="src">{{activity.note}}</view>
    <view class="src">{{activity.rule}}</view>
  </view>
  <view wx:for="{{groups}}" wx:key="id" class="card">
    <view class="h2">{{item.name}} {{item.pace}}</view>
    <view class="src">{{item.kindLabel}} · {{item.signed}}{{item.capacity ? '/' + item.capacity : ' · 不限'}}</view>
    <view wx:for="{{item.people}}" wx:for-item="person" wx:key="userId" class="row">
      <text>{{person.pacer ? '领跑 ' : ''}}{{person.nickname}}</text>
      <text>{{person.level}} {{person.gender}}{{person.together ? ' 一起玩过 ' + person.together + ' 次' : ''}}</text>
    </view>
  </view>
  <view class="card">
    <navigator wx:if="{{activity.action.enabled && activity.action.kind === 'signup'}}" class="btn" url="/pages/signup/signup?club={{clubId}}&id={{activityId}}">报名</navigator>
    <button wx:elif="{{activity.action.enabled}}" class="btn" bindtap="cancel">取消报名</button>
    <button wx:else class="btn" disabled>{{activity.action.label}}</button>
    <button wx:if="{{activity.mine.signed && activity.mine.groupId}}" class="ghost" bindtap="pacer">{{activity.mine.pacer ? '不领跑了' : '我来领跑'}}</button>
  </view>
  <view class="card">
    <navigator url="/pages/album/album?club={{clubId}}&id={{activityId}}">查看相册</navigator>
    <view class="src">{{album.photoCount}} 张照片 · {{album.videoCount}} 个视频</view>
  </view>
  <view class="card">
    <view class="h2">打卡</view>
    <input placeholder="公里数" value="{{km}}" bindinput="onKm" />
    <button class="btn" bindtap="check">打卡</button>
    <view wx:for="{{checks}}" wx:key="userId" class="row">
      <text>{{item.nickname}}</text><text>{{item.km}} 公里</text>
    </view>
  </view>
  <view wx:if="{{staff}}" class="card">
    <button class="ghost" bindtap="toggleEdit">{{editing ? '收起' : '改这场'}}</button>
    <block wx:if="{{editing && draft}}">
      <input data-key="title" placeholder="标题" value="{{draft.title}}" bindinput="onDraft" />
      <input data-key="issue" placeholder="期次，可不填" value="{{draft.issue}}" bindinput="onDraft" />
      <input data-key="startsAt" placeholder="开始 2026-10-14 05:00" value="{{draft.startsAt}}" bindinput="onDraft" />
      <input data-key="endsAt" placeholder="结束，可不填" value="{{draft.endsAt}}" bindinput="onDraft" />
      <input data-key="gatherAt" placeholder="集合时间，可不填" value="{{draft.gatherAt}}" bindinput="onDraft" />
      <input data-key="gatherPlace" placeholder="集合点" value="{{draft.gatherPlace}}" bindinput="onDraft" />
      <input data-key="place" placeholder="地点" value="{{draft.place}}" bindinput="onDraft" />
      <input data-key="plannedKm" placeholder="计划里程，可不填" value="{{draft.plannedKm}}" bindinput="onDraft" />
      <input data-key="route" placeholder="路线" value="{{draft.route}}" bindinput="onDraft" />
      <input data-key="cancelUntil" placeholder="取消报名截止，可不填" value="{{draft.cancelUntil}}" bindinput="onDraft" />
      <input data-key="note" placeholder="说明" value="{{draft.note}}" bindinput="onDraft" />
      <input data-key="minPeople" placeholder="成团人数" value="{{draft.minPeople}}" bindinput="onDraft" />
      <input data-key="minKm" placeholder="里程公里" value="{{draft.minKm}}" bindinput="onDraft" />
      <input data-key="points" placeholder="这场积分" value="{{draft.points}}" bindinput="onDraft" />
      <button class="btn" bindtap="saveActivity">保存</button>
    </block>
    <view class="src">加一组。当前种类：{{groupKindLabel}}</view>
    <button class="ghost" data-kind="pace" data-label="配速组" bindtap="pickKind">配速组</button>
    <button class="ghost" data-kind="finish" data-label="完赛组" bindtap="pickKind">完赛组</button>
    <button class="ghost" data-kind="volunteer" data-label="志愿者" bindtap="pickKind">志愿者</button>
    <button class="ghost" data-kind="other" data-label="非训练" bindtap="pickKind">非训练</button>
    <input data-key="groupName" placeholder="组名，例如 A2" value="{{groupName}}" bindinput="onGroup" />
    <input data-key="groupPace" placeholder="配速或目标，可不填" value="{{groupPace}}" bindinput="onGroup" />
    <input data-key="groupCap" placeholder="名额，0 表示不限" value="{{groupCap}}" bindinput="onGroup" />
    <button class="btn" bindtap="addGroup">加一组</button>
    <button class="ghost" bindtap="endActivity">结束这场</button>
    <button class="ghost" bindtap="cancelActivity">取消这场</button>
  </view>
  <view wx:if="{{message}}" class="err">{{message}}</view>
</view>
<view wx:else class="empty">{{message || '正在打开活动'}}</view>
