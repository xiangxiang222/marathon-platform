.activity-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 24rpx calc(190rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  color: #1f2026;
}
.hero {
  position: relative;
  overflow: hidden;
  margin: 0 -24rpx;
  padding: 34rpx 32rpx 30rpx;
  background: #1c1d22;
  color: #fff;
}
.hero::before {
  position: absolute;
  top: 0;
  right: 0;
  width: 12rpx;
  height: 100%;
  background: #ff0a30;
  content: "";
}
.hero-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.type-label { color: #ff647e; font-size: 22rpx; font-weight: 700; }
.status-label { padding: 4rpx 12rpx; border: 1rpx solid rgba(255,255,255,.22); border-radius: 8rpx; color: #e2e3e7; font-size: 22rpx; line-height: 1.4; }
.issue { margin-top: 34rpx; color: #aeb0b8; font-size: 22rpx; }
.hero-title { max-width: 620rpx; margin-top: 14rpx; font-size: 42rpx; line-height: 1.3; font-weight: 700; overflow-wrap: anywhere; }
.hero-distance { display: flex; align-items: baseline; gap: 14rpx; margin-top: 32rpx; }
.distance-value { color: #fff; font-size: 72rpx; line-height: 1; font-weight: 750; }
.distance-unit { color: #aeb0b8; font-size: 24rpx; }
.hero-facts { display: flex; gap: 28rpx; margin-top: 34rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.16); }
.hero-fact { flex: 1; min-width: 0; }
.fact-label { display: block; color: #aeb0b8; font-size: 21rpx; }
.fact-value { display: block; margin-top: 6rpx; font-size: 26rpx; line-height: 1.4; overflow-wrap: anywhere; }
.gather-at { margin-top: 16rpx; color: #d2d3d9; font-size: 23rpx; }
.tabs { display: flex; margin: 0 -24rpx 24rpx; padding: 0 24rpx; background: #fff; border-bottom: 1rpx solid #f0f1f5; }
.tab { position: relative; flex: 1; min-width: 0; height: 88rpx; color: #7f838d; font-size: 26rpx; line-height: 88rpx; text-align: center; }
.tab-on { color: #1f2026; font-weight: 650; }
.tab-on::after { position: absolute; right: 30%; bottom: 0; left: 30%; height: 6rpx; border-radius: 4rpx; background: #ff0a30; content: ""; }
.tab-count { margin-left: 4rpx; color: #a1a4ad; font-size: 21rpx; }
.tab-body { padding-bottom: 20rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin: 26rpx 2rpx 16rpx; }
.section-title { font-size: 31rpx; line-height: 1.35; font-weight: 650; }
.section-meta { color: #8a8e99; font-size: 22rpx; text-align: right; }
.info-list { padding: 2rpx 22rpx; border-radius: 12rpx; background: #fff; }
.info-row { display: flex; align-items: flex-start; gap: 22rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0f1f5; }
.info-row:last-child { border-bottom: 0; }
.info-label { flex: none; width: 126rpx; color: #8a8e99; font-size: 23rpx; }
.info-value { flex: 1; min-width: 0; color: #292a30; font-size: 25rpx; line-height: 1.45; text-align: right; overflow-wrap: anywhere; }
.plain-note { margin-top: 16rpx; padding: 20rpx 22rpx; border-radius: 12rpx; background: #fff; color: #686c75; font-size: 24rpx; line-height: 1.55; white-space: pre-wrap; }
.album-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 22rpx; border-radius: 12rpx; background: #fff; }
.album-copy { flex: 1; min-width: 0; }
.album-title { display: block; font-size: 27rpx; font-weight: 600; }
.album-count { display: block; margin-top: 5rpx; color: #8a8e99; font-size: 22rpx; }
.album-link { flex: none; color: #ff0a30; font-size: 24rpx; }
.check-section { margin-top: 32rpx; }
.check-form { display: flex; align-items: center; gap: 14rpx; }
.check-hint { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 22rpx; border-radius: 10rpx; background: #fff; color: #8a8e99; font-size: 24rpx; line-height: 1.5; }
.check-refresh { flex: none; min-height: 0; margin: 0; padding: 4rpx 0; background: transparent; color: #ff0a30; font-size: 24rpx; line-height: 1.5; }
.km-input { flex: 1; min-width: 0; height: 78rpx; box-sizing: border-box; padding: 0 20rpx; border-radius: 10rpx; background: #fff; font-size: 26rpx; }
.check-button { flex: none; width: 148rpx; height: 78rpx; min-height: 78rpx; padding: 0; border-radius: 10rpx; background: #ff0a30; color: #fff; font-size: 25rpx; line-height: 78rpx; }
.check-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 16rpx 4rpx; border-bottom: 1rpx solid #f0f1f5; color: #666a73; font-size: 23rpx; }
.check-person { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; min-width: 0; }
.history-label { flex: none; padding: 3rpx 8rpx; border-radius: 5rpx; background: #e9ebf1; color: #858a96; font-size: 20rpx; }
.staff-section { margin-top: 34rpx; padding-top: 20rpx; border-top: 1rpx solid #e7e8ed; }
.text-action { flex: none; min-height: 0; margin: 0; padding: 4rpx 0; background: transparent; color: #ff0a30; font-size: 23rpx; line-height: 1.5; }
.field-label { margin: 24rpx 2rpx 10rpx; color: #777b84; font-size: 22rpx; }
.type-options { display: flex; flex-wrap: wrap; gap: 10rpx; }
.type-option { min-width: 0; padding: 12rpx 16rpx; border-radius: 8rpx; background: #fff; color: #666a73; font-size: 22rpx; line-height: 1.3; }
.type-option-on { background: #fff0f3; color: #ff0a30; }
.staff-input { display: block; width: 100%; height: 78rpx; box-sizing: border-box; margin-top: 12rpx; padding: 0 18rpx; border: 0; border-radius: 10rpx; background: #fff; font-size: 24rpx; }
.staff-textarea { display: block; width: 100%; min-height: 170rpx; box-sizing: border-box; margin-top: 12rpx; padding: 16rpx 18rpx; border: 0; border-radius: 10rpx; background: #fff; font-size: 24rpx; line-height: 1.5; }
.staff-textarea.short { min-height: 108rpx; }
.staff-primary, .staff-secondary, .staff-danger { display: block; width: 100%; min-height: 76rpx; margin-top: 14rpx; border-radius: 10rpx; font-size: 25rpx; line-height: 76rpx; }
.staff-primary { background: #ff0a30; color: #fff; }
.staff-secondary { background: #fff; color: #1f2026; }
.staff-danger { background: #fff0f3; color: #d5203e; }
.group-add { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f1f5; }
.staff-actions { display: flex; gap: 12rpx; margin-top: 26rpx; }
.staff-actions button { flex: 1; min-width: 0; margin-top: 0; padding: 0 8rpx; font-size: 22rpx; }
.group-list { overflow: hidden; border-radius: 12rpx; background: #fff; }
.group-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx; border-bottom: 1rpx solid #f0f1f5; }
.group-row:last-child { border-bottom: 0; }
.group-main { flex: 1; min-width: 0; }
.group-name { font-size: 27rpx; font-weight: 600; overflow-wrap: anywhere; }
.group-pace { margin-left: 12rpx; color: #8a8e99; font-size: 22rpx; font-weight: 400; }
.group-kind { margin-top: 5rpx; color: #8a8e99; font-size: 21rpx; }
.group-capacity { flex: none; color: #8a8e99; font-size: 22rpx; }
.group-count { color: #ff0a30; font-size: 30rpx; font-weight: 650; }
.group-limit { margin-left: 3rpx; }
.roster-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin: 34rpx 2rpx 12rpx; }
.roster-list { padding: 0 20rpx; border-radius: 12rpx; background: #fff; }
.roster-row { display: flex; align-items: center; gap: 16rpx; min-height: 96rpx; border-bottom: 1rpx solid #f0f1f5; }
.roster-row:last-of-type { border-bottom: 0; }
.avatar-wrap { flex: none; width: 62rpx; height: 62rpx; overflow: hidden; border-radius: 50%; background: #f0f1f6; }
.avatar { display: block; width: 62rpx; height: 62rpx; }
.avatar-fallback { width: 62rpx; height: 62rpx; color: #6d7079; font-size: 23rpx; line-height: 62rpx; text-align: center; }
.person-copy { flex: 1; min-width: 0; }
.person-name { font-size: 24rpx; line-height: 1.35; overflow-wrap: anywhere; }
.person-group { margin-top: 4rpx; color: #8a8e99; font-size: 20rpx; line-height: 1.35; }
.person-mine, .person-pacer { display: inline-block; margin-left: 8rpx; padding: 1rpx 8rpx; border-radius: 6rpx; background: #fff0f3; color: #ff0a30; font-size: 18rpx; vertical-align: 2rpx; }
.person-pacer { background: #edf8f1; color: #168b50; }
.together-count { flex: none; max-width: 150rpx; color: #8a8e99; font-size: 19rpx; text-align: right; }
.expand-roster { display: block; width: 100%; min-height: 76rpx; margin: 0; border-top: 1rpx solid #f0f1f5; border-radius: 0; background: #fff; color: #ff0a30; font-size: 23rpx; line-height: 76rpx; }
.empty-state { padding: 36rpx 20rpx; border-radius: 12rpx; background: #fff; color: #8a8e99; font-size: 23rpx; text-align: center; }
.plan-block { margin-bottom: 18rpx; padding: 26rpx 24rpx; border-radius: 12rpx; background: #fff; }
.plan-kicker { color: #ff0a30; font-size: 19rpx; font-weight: 700; }
.plan-title { margin-top: 10rpx; font-size: 29rpx; font-weight: 650; }
.plan-copy { margin-top: 18rpx; color: #45474e; font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.plan-empty { margin-top: 14rpx; color: #8a8e99; font-size: 23rpx; }
.notice-block { border-left: 6rpx solid #ff0a30; }
.rule-note { padding: 14rpx 4rpx; color: #8a8e99; font-size: 21rpx; line-height: 1.5; }
.message-line { margin: 12rpx 0 0; color: #c73540; font-size: 23rpx; line-height: 1.5; }
.load-state { display: flex; align-items: center; flex-direction: column; justify-content: center; min-height: 70vh; padding: 40rpx; color: #777b84; font-size: 25rpx; text-align: center; }
.load-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; margin-bottom: 20rpx; border-radius: 50%; background: #1c1d22; color: #ff0a30; font-size: 25rpx; font-weight: 700; }
.retry-button { min-height: 72rpx; margin-top: 24rpx; padding: 0 28rpx; border-radius: 10rpx; background: #ff0a30; color: #fff; font-size: 24rpx; line-height: 72rpx; }
.bottom-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 14rpx; box-sizing: border-box; min-height: 116rpx; padding: 16rpx 24rpx calc(16rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e9eaf0; background: rgba(255,255,255,.98); }
.bottom-meta { display: flex; align-items: baseline; gap: 5rpx; flex: 1; min-width: 0; }
.bottom-count { color: #1f2026; font-size: 34rpx; font-weight: 700; }
.bottom-caption { color: #8a8e99; font-size: 20rpx; white-space: nowrap; }
.bottom-primary { display: block; flex: none; width: 300rpx; height: 82rpx; min-height: 82rpx; margin: 0; padding: 0 16rpx; border-radius: 10rpx; background: #ff0a30; color: #fff; font-size: 26rpx; line-height: 82rpx; text-align: center; }
.bottom-primary.disabled { background: #e8e9ed; color: #8a8e99; }
.pacer-button { flex: none; width: 128rpx; height: 82rpx; min-height: 82rpx; margin: 0; padding: 0; border-radius: 10rpx; background: #1c1d22; color: #fff; font-size: 22rpx; line-height: 82rpx; }

@media (max-width: 350px) {
  .hero { padding-right: 28rpx; padding-left: 28rpx; }
  .hero-title { font-size: 38rpx; }
  .bottom-bar { gap: 9rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .bottom-primary { width: 260rpx; font-size: 24rpx; }
  .pacer-button { width: 114rpx; font-size: 20rpx; }
  .together-count { max-width: 120rpx; }
}

.activity-share {flex:none;margin:0;padding:5rpx 14rpx;min-height:0;background:#ffffff16;border:1rpx solid #ffffff33;color:#fff;font-size:21rpx;line-height:1.6;border-radius:8rpx}
.review-setting {display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:20rpx;color:#686c75;font-size:22rpx}
