<view class="history-page mini-history-history">
  <view wx:if="{{section === 'history'}}" class="page-heading"><view class="page-title">我的参赛记录</view><view class="subtitle">历史成绩、城市与比赛照片</view></view>
  <view wx:if="{{!ready}}" class="card empty"><view class="section-title">把你的比赛，慢慢找回来</view><view class="muted">{{error || '登录后整理自己的参赛经历、成绩与回忆。新跑史和资料仅自己可见。'}}</view><button class="primary" bindtap="login">登录，打开我的跑史</button></view>
  <block wx:else>
    <view wx:if="{{section !== 'history'}}" class="back" bindtap="backHistory">‹ 我的跑史</view>
    <view wx:if="{{error}}" class="error-strip"><text>{{error}}</text><text wx:if="{{section === 'history'}}" bindtap="load">重试</text><text wx:elif="{{section === 'review'}}" bindtap="retryEntry">重试</text></view>
    <view wx:if="{{message}}" class="notice">{{message}}</view>

    <block wx:if="{{section === 'history'}}">
      <view class="toolbar"><view class="mode-tabs"><view class="{{mode === 'growth' ? 'active' : ''}}" data-mode="growth" bindtap="pickMode">看成长</view><view class="{{mode === 'memory' ? 'active' : ''}}" data-mode="memory" bindtap="pickMode">留回忆</view></view><view class="text-action" bindtap="openImport">找回旧比赛 ＋</view></view>
      <view wx:if="{{loading && !summary}}" class="card muted">正在整理你的跑史…</view>
      <block wx:else>
        <view wx:if="{{summary}}" class="stats"><view><text class="stat-number">{{summary.experienceCount || 0}}</text><text class="muted">条参赛经历</text></view><view><text class="stat-number">{{summary.finished || 0}}</text><text class="muted">场完赛</text></view><view><text class="stat-number">{{summary.cityCount || 0}}</text><text class="muted">座城市</text></view></view>
        <view wx:if="{{mode === 'growth' && hero}}" class="card growth-hero" data-id="{{hero.id}}" bindtap="openEntry"><view class="hero-top"><text class="eyebrow">成长里程碑</text><text class="pb">{{hero.isPb ? hero.distanceLabel + ' · PB' : '第一段跑史'}}</text></view><view class="hero-title">{{hero.isPb ? '刷新同项目个人最好成绩' : '已记录的参赛经历'}}</view><view class="hero-clock">{{hero.clock}}</view><view class="hero-change">{{hero.improvementLabel ? '比此前最好成绩快了 ' + hero.improvementLabel : hero.isPb ? '已记录同项目中的最好成绩' : '已记录跑史中最早的一场'}}<text>{{hero.timingLabel}}</text></view><view class="hero-foot"><view>{{hero.name}}<view class="muted">{{hero.raceDate}} · {{hero.isPb ? '仅比较已记录的同项目、同计时口径线下路跑' : '依据当前账号已记录经历生成'}} </view></view><text class="circle-arrow">›</text></view></view>

        <view class="list-heading"><view class="section-title">{{mode === 'growth' ? '走过的比赛' : '属于你的记忆'}}</view><picker range="{{years}}" value="{{yearIndex}}" bindchange="pickYear"><view class="year-picker">{{years[yearIndex]}} ⌄</view></picker></view>
        <input class="search-field" value="{{keyword}}" bindinput="searchInput" confirm-type="search" placeholder="搜索比赛或城市" maxlength="80" aria-label="搜索比赛或城市"/><view wx:if="{{mode === 'memory'}}" class="memory-note">成长也可以是陪伴、归来，或第一次站上起跑线。打开一场比赛，留下自己的那句话。</view>
        <view class="{{mode === 'growth' ? 'timeline' : 'memory-list'}}">
          <view wx:for="{{visibleEntries}}" wx:key="id" class="{{mode === 'growth' ? 'timeline-item' : 'memory-card'}}" data-id="{{item.id}}" bindtap="openEntry">
            <image wx:if="{{mode === 'memory' && item.coverSrc}}" class="memory-cover" src="{{item.coverSrc}}" mode="aspectFill"/>
            <view class="entry-body"><view class="entry-date">{{item.dateLabel}} · {{item.distanceLabel}}</view><view class="entry-line"><view class="entry-copy"><view class="entry-name">{{item.name}}</view><view wx:if="{{mode === 'growth'}}" class="muted">{{item.city ? item.city + ' · ' : ''}}{{item.statusLabel}}<text wx:if="{{item.status === 'finished'}}"> · {{item.timingLabel}}</text></view></view><view wx:if="{{mode === 'growth'}}" class="entry-clock">{{item.clock}}<text wx:if="{{item.isPb}}" class="pb">个人纪录</text></view></view><view wx:if="{{mode === 'growth' && item.growthNode}}" class="growth-node">{{item.growthNode}}</view><view wx:if="{{mode === 'memory' && item.story}}" class="memory-story">“{{item.story}}”</view><view wx:elif="{{mode === 'memory'}}" class="muted memory-story">{{item.statusLabel}} · {{item.clock}}<text>　留下这一场的感受 ›</text></view><view wx:if="{{item.tags.length}}" class="tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view></view>
          </view>
        </view>
        <view wx:if="{{!visibleEntries.length}}" class="card empty"><view class="section-title">{{keyword ? '还没有匹配的比赛' : entries.length ? '这一年还没有记录' : '你的第一条跑史，从这里开始'}}</view><view class="muted">旧比赛不在赛历里，也可以留下；没有完赛成绩，也能记录经历。</view><button class="primary" bindtap="openAdd">记下一场比赛</button></view>
        <view class="add-strip" bindtap="openImport"><text class="plus">＋</text><view><view>把以前的比赛，也找回来</view><view class="muted">成绩截图、文字与表格，核对后一起归档</view></view><text>›</text></view>
        <view class="bottom-actions"><button class="secondary" disabled="{{!!busy}}" bindtap="openAdd">手动补一场</button><button class="secondary" disabled="{{!!busy || !entries.length}}" bindtap="chooseExport">导出我的跑史</button></view>
        <view class="privacy-note">新跑史与资料仅自己可见；原有团内成绩仍按原规则展示。</view>
      </block>
    </block>

    <block wx:elif="{{section === 'review'}}">
      <view wx:if="{{loading && !selected}}" class="card muted">正在打开这一场回顾…</view>
      <block wx:if="{{selected}}">
        <view class="review-heading"><view class="eyebrow">我的比赛回顾</view><view class="review-title">{{selected.name}}</view><view class="subtitle">{{selected.raceDate}}<text wx:if="{{selected.city}}"> · {{selected.city}}</text> · {{selected.distanceLabel}} · {{selected.statusLabel}}</view></view>
        <view class="card review-stats"><view><view class="muted">{{selected.timingLabel}}<text wx:if="{{selected.status !== 'finished'}}"> · {{selected.statusLabel}}</text></view><view class="review-clock">{{selected.clock}}</view><view class="muted">{{selected.paceLabel ? '平均配速 ' + selected.paceLabel : '用时可以之后补充'}}</view></view><view wx:if="{{selected.improvementLabel}}" class="improvement"><view class="muted">比此前同口径最好成绩</view><view class="accent">快 {{selected.improvementLabel}}</view></view></view>
        <view wx:if="{{review}}" class="insight"><view class="section-title">{{review.headline}}</view><view wx:for="{{review.facts}}" wx:key="*this" class="fact">{{item}}</view></view>
        <view wx:if="{{selected.coverSrc}}" class="moment"><image src="{{selected.coverSrc}}" mode="widthFix" data-id="{{selected.coverDisplayId}}" bindtap="previewMedia"/></view>
        <view wx:if="{{selected.story}}" class="quote"><view>{{selected.story}}</view><text class="muted">我的一句感受</text></view>
        <view wx:else class="card personal-prompt" bindtap="editEntry"><view class="section-title">这场最想记住的是什么？</view><view class="muted">写一句自己的感受，让回顾留下你的声音。</view><view class="text-action">添一句话 ›</view></view>
        <view wx:if="{{selected.tags.length}}" class="tags"><text wx:for="{{selected.tags}}" wx:key="*this">{{item}}</text></view>
        <view class="card sources"><view class="section-title">这份回顾，依据什么？</view><view class="source-line">{{selected.sourceLabel}} · 本人确认，不代表官方核验</view><view wx:if="{{review}}" class="muted">{{review.scope}}</view><view wx:for="{{review.missing}}" wx:key="*this" class="missing">{{item}}</view><view wx:if="{{selected.netClock}}" class="muted">净计时 {{selected.netClock}}</view><view wx:if="{{selected.gunClock}}" class="muted">枪声时间 {{selected.gunClock}}</view></view>
        <view class="card materials"><view class="material-heading" bindtap="toggleMaterials"><view class="section-title">这场的纪念资料</view><text class="muted">{{selected.media.length}} 项 · {{materialsOpen ? '收起 −' : '展开 ＋'}}</text></view><block wx:if="{{materialsOpen}}"><view wx:for="{{selected.media}}" wx:key="id" class="material-row"><video wx:if="{{item.isVideo && item.src}}" src="{{item.src}}" controls/><image wx:elif="{{item.src}}" src="{{item.src}}" mode="aspectFill" data-id="{{item.id}}" bindtap="previewMedia"/><view class="material-copy"><view>{{item.kindLabel}}</view><view wx:if="{{selected.coverMediaId === item.id}}" class="muted">回顾代表照片</view><view wx:if="{{item.inherited}}" class="muted">来自原有收藏，可在原影像收藏中维护</view><view class="material-actions"><text wx:if="{{item.kind === 'photo' && !item.inherited && selected.coverMediaId !== item.id}}" data-id="{{item.id}}" bindtap="setCover">设为代表照片</text><text wx:if="{{!item.inherited}}" data-id="{{item.id}}" bindtap="deleteMedia">删除</text></view></view></view><view wx:if="{{!selected.media.length}}" class="muted">一张照片、一份证书，都可以慢慢补齐。</view><view class="upload-row"><picker range="{{mediaKinds}}" range-key="label" value="{{mediaKindIndex}}" bindchange="pickMediaKind"><view class="select-box">{{mediaKinds[mediaKindIndex].label}} ⌄</view></picker><button class="secondary" disabled="{{!!busy}}" bindtap="chooseMedia">上传图片</button></view><view class="muted">仅自己可见 · JPG / PNG / WebP · 不超过 8MB</view></block></view>
        <view class="bottom-actions"><button class="primary" disabled="{{!!busy}}" bindtap="editEntry">编辑这场回顾</button><button class="secondary" disabled="{{!!busy}}" bindtap="deleteEntry">移除记录</button></view>
      </block>
    </block>

    <block wx:elif="{{section === 'edit' && editor}}">
      <view class="section-title form-heading">{{editorId ? '把这场记得更清楚' : '记下一场比赛'}}</view><view class="muted form-intro">没有完赛成绩，也能保存经历。填写真实发生的比赛日期。</view>
      <view class="card form-card"><view wx:if="{{editor.raceId}}" class="notice">已关联原有赛事。如需更正比赛名称、日期或项目，可先取消关联；只改变你的私人跑史。<view class="text-action" bindtap="clearRaceAssociation">取消赛事关联</view></view>
        <view class="field"><text>比赛名称</text><input value="{{editor.name}}" data-field="name" bindinput="onEditor" maxlength="120" placeholder="例如：2025 天津马拉松" aria-label="例如：2025 天津马拉松"/></view>
        <view class="field"><text>比赛日期</text><picker mode="date" value="{{editor.raceDate}}" data-field="raceDate" bindchange="onEditor"><view class="select-box">{{editor.raceDate || '选择日期'}} ⌄</view></picker></view>
        <view class="form-grid"><view class="field"><text>城市（可选）</text><input value="{{editor.city}}" data-field="city" bindinput="onEditor" maxlength="40" placeholder="比赛城市" aria-label="比赛城市"/></view><view class="field"><text>省份（可选）</text><input value="{{editor.province}}" data-field="province" bindinput="onEditor" maxlength="40" placeholder="省份" aria-label="省份"/></view></view>
        <view class="form-grid"><view class="field"><text>比赛项目</text><picker range="{{distances}}" range-key="label" value="{{editor.distanceIndex}}" data-field="distance" bindchange="editorPick"><view class="select-box">{{editor.distanceIndex < 0 ? '请选择项目' : distances[editor.distanceIndex].label}} ⌄</view></picker></view><view class="field"><text>参与状态</text><picker range="{{statuses}}" range-key="label" value="{{editor.statusIndex}}" data-field="status" bindchange="editorPick"><view class="select-box">{{editor.statusIndex < 0 ? '请选择参与状态' : statuses[editor.statusIndex].label}} ⌄</view></picker></view></view>
        <view class="form-grid"><view class="field"><text>赛事类型</text><picker range="{{kinds}}" range-key="label" value="{{editor.kindIndex}}" data-field="kind" bindchange="editorPick"><view class="select-box">{{editor.kindIndex < 0 ? '请选择赛事类型' : kinds[editor.kindIndex].label}} ⌄</view></picker></view><view class="field"><text>参赛形式</text><picker range="{{meets}}" range-key="label" value="{{editor.meetIndex}}" data-field="meet" bindchange="editorPick"><view class="select-box">{{editor.meetIndex < 0 ? '请选择参赛形式' : meets[editor.meetIndex].label}} ⌄</view></picker></view></view>
        <view class="field"><text>用时口径</text><picker range="{{timings}}" range-key="label" value="{{editor.timingIndex}}" data-field="timing" bindchange="editorPick"><view class="select-box">{{editor.timingIndex < 0 ? '请选择计时口径' : timings[editor.timingIndex].label}} ⌄</view></picker></view>
        <view class="form-grid"><view class="field"><text>净计时{{editor.timing === 'net' && editor.status === 'finished' ? '（所选口径需填）' : '（可选）'}}</text><input value="{{editor.netTime}}" data-field="netTime" bindinput="onEditor" maxlength="8" placeholder="03:12:45" aria-label="03:12:45"/></view><view class="field"><text>枪声时间{{editor.timing === 'gun' && editor.status === 'finished' ? '（所选口径需填）' : '（可选）'}}</text><input value="{{editor.gunTime}}" data-field="gunTime" bindinput="onEditor" maxlength="8" placeholder="03:15:00" aria-label="03:15:00"/></view></view>
        <view wx:if="{{editor.timing === 'unknown'}}" class="field"><text>口径待确认的用时（可选）</text><input value="{{editor.unknownTime}}" data-field="unknownTime" bindinput="onEditor" maxlength="8" placeholder="暂不参与个人纪录比较" aria-label="暂不参与个人纪录比较"/></view>
        <view class="field"><text>号码布（可选）</text><input value="{{editor.bib}}" data-field="bib" bindinput="onEditor" maxlength="30" placeholder="你的参赛号码" aria-label="你的参赛号码"/></view>
        <view class="field"><text>这一场，想留下的一句话</text><textarea value="{{editor.story}}" data-field="story" bindinput="onEditor" maxlength="1000" placeholder="关于突破、陪伴、归来，或者只有你知道的瞬间。" auto-height aria-label="关于突破、陪伴、归来，或者只有你知道的瞬间。"/></view>
        <view class="field"><text>这场对你的意义（可选）</text><view class="tag-options"><view wx:for="{{editor.selectedTags}}" wx:key="text" class="{{item.selected ? 'chosen' : ''}}" data-tag="{{item.text}}" bindtap="toggleEditorTag">{{item.text}}</view></view></view>
      </view>
      <view wx:if="{{editorError}}" class="error-strip">{{editorError}}</view><view class="bottom-actions"><button class="primary" loading="{{busy === 'save'}}" disabled="{{!!busy}}" bindtap="saveEntry">保存到我的跑史</button><button class="secondary" disabled="{{!!busy}}" bindtap="closeEditor">取消</button></view>
    </block>

    <block wx:elif="{{section === 'import'}}">
      <view class="section-title form-heading">找回旧比赛</view><view class="muted form-intro">导入已有成绩，核对后加入你的跑史。</view>
      <view class="card import-card">
        <view class="import-step"><text>01</text><view class="section-title">添加成绩资料</view><view class="step-note">核对后保存</view></view>
        <view class="import-actions"><button class="secondary import-choice" disabled="{{!!busy}}" bindtap="chooseScreenshots"><text class="choice-icon">＋</text><view><text class="choice-title">截图识别</text><text class="choice-note">成绩截图 / 完赛证书</text></view></button><button class="secondary import-choice" disabled="{{!!busy}}" bindtap="chooseTextFile"><text class="choice-icon">↑</text><view><text class="choice-title">导入文件</text><text class="choice-note">CSV / JSON / TXT</text></view></button></view>
        <view class="file-hint">一次最多 5 张截图，单张不超过 8 MB。</view>
        <view class="field"><text>成绩文字或表格</text><textarea class="import-text" value="{{importText}}" bindinput="onImportText" maxlength="160000" placeholder="也可以直接粘贴成绩文字或表格，包含赛事、日期、项目与用时。" aria-label="成绩文字或表格"/></view>
        <button class="primary" disabled="{{!!busy || !importText}}" loading="{{busy === 'parse'}}" bindtap="previewImport">识别并核对比赛</button>
        <view class="import-privacy">原图仅临时识别，不会自动收藏。比赛资料仅自己可见。</view>
      </view>
      <view wx:if="{{busy}}" class="notice">{{busy === 'consent' || busy === 'choose' ? '正在选择资料…' : busy === 'parse' ? '正在整理比赛…' : busy === 'confirm' ? '正在加入跑史…' : busy}}</view>
      <view wx:if="{{importError}}" class="error-strip">{{importError}}</view><view wx:if="{{importSuccess}}" class="success-strip">{{importSuccess}}</view><view wx:for="{{warnings}}" wx:key="*this" class="notice">{{item}}</view>
      <view wx:if="{{candidates.length}}" class="list-heading"><view class="section-title">核对要留下的比赛</view><text class="muted">{{candidates.length}} 条候选</text></view>
      <view wx:for="{{candidates}}" wx:for-index="index" wx:key="candidateId" class="card candidate {{item.selected ? 'selected' : ''}}">
        <view class="candidate-head" data-index="{{index}}" bindtap="selectCandidate"><view class="check {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view><view class="section-title">{{item.name || '待补比赛名称'}}</view><text wx:if="{{item.duplicateId}}" class="duplicate">{{item.deletedDuplicate ? '此前已移除' : '已有记录'}}</text></view>
        <view wx:if="{{item.distanceText}}" class="candidate-warning">原资料项目：{{item.distanceText}}</view>
        <view wx:if="{{item.duplicateId}}" class="muted">{{item.deletedDuplicate ? '这条记录此前已移除，本次跳过。' : '已在跑史里找到对应记录，本次跳过。已有内容不会被覆盖。'}}</view>
        <block wx:else><view wx:for="{{item.issues}}" wx:for-item="issue" wx:key="*this" class="candidate-warning">{{issue}}</view><view class="field"><text>比赛名称</text><input value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onCandidate" maxlength="120"/></view><view class="form-grid"><view class="field"><text>比赛日期</text><picker mode="date" value="{{item.raceDate}}" data-index="{{index}}" data-field="raceDate" bindchange="onCandidate"><view class="select-box">{{item.raceDate || '选择日期'}} ⌄</view></picker></view><view class="field"><text>项目</text><picker range="{{distances}}" range-key="label" value="{{item.distanceIndex}}" data-index="{{index}}" data-field="distance" bindchange="candidatePick"><view class="select-box">{{item.distanceIndex < 0 ? '请选择项目' : distances[item.distanceIndex].label}} ⌄</view></picker></view></view><view class="form-grid"><view class="field"><text>参与状态</text><picker range="{{statuses}}" range-key="label" value="{{item.statusIndex}}" data-index="{{index}}" data-field="status" bindchange="candidatePick"><view class="select-box">{{item.statusIndex < 0 ? '请选择参与状态' : statuses[item.statusIndex].label}} ⌄</view></picker></view><view class="field"><text>用时口径</text><picker range="{{timings}}" range-key="label" value="{{item.timingIndex}}" data-index="{{index}}" data-field="timing" bindchange="candidatePick"><view class="select-box">{{item.timingIndex < 0 ? '请选择计时口径' : timings[item.timingIndex].label}} ⌄</view></picker></view></view><view class="form-grid"><view class="field"><text>净计时</text><input value="{{item.netTime}}" data-index="{{index}}" data-field="netTime" bindinput="onCandidate" maxlength="8" placeholder="可留空" aria-label="可留空"/></view><view class="field"><text>枪声时间</text><input value="{{item.gunTime}}" data-index="{{index}}" data-field="gunTime" bindinput="onCandidate" maxlength="8" placeholder="可留空" aria-label="可留空"/></view></view><view wx:if="{{item.timing === 'unknown'}}" class="field"><text>口径待确认的用时</text><input value="{{item.unknownTime}}" data-index="{{index}}" data-field="unknownTime" bindinput="onCandidate" maxlength="8" placeholder="不参与个人纪录比较" aria-label="不参与个人纪录比较"/></view><view wx:if="{{item.validationMessage}}" class="candidate-warning">{{item.validationMessage}}</view><view class="form-grid"><view class="field"><text>赛事类型</text><picker range="{{kinds}}" range-key="label" value="{{item.kindIndex}}" data-index="{{index}}" data-field="kind" bindchange="candidatePick"><view class="select-box">{{item.kindIndex < 0 ? '请选择赛事类型' : kinds[item.kindIndex].label}} ⌄</view></picker></view><view class="field"><text>参赛形式</text><picker range="{{meets}}" range-key="label" value="{{item.meetIndex}}" data-index="{{index}}" data-field="meet" bindchange="candidatePick"><view class="select-box">{{item.meetIndex < 0 ? '请选择参赛形式' : meets[item.meetIndex].label}} ⌄</view></picker></view></view><view class="field"><text>城市（可选）</text><input value="{{item.city}}" data-index="{{index}}" data-field="city" bindinput="onCandidate" maxlength="40"/></view><view class="acknowledge" data-index="{{index}}" bindtap="acknowledgeCandidate"><view class="check {{item.acknowledged ? 'checked' : ''}}">{{item.acknowledged ? '✓' : ''}}</view><text>我已核对这场的项目、日期和用时口径</text></view></block>
      </view>
      <view wx:if="{{candidates.length}}" class="confirm-panel"><view class="muted">{{selectedCount ? '已选 ' + selectedCount + ' 场，请逐条核对后勾选确认。' : '勾选要归档的比赛。识别结果不代表官方核验。'}}</view><button class="primary" disabled="{{!!busy || !canConfirm}}" loading="{{busy === 'confirm'}}" bindtap="confirmImport">确认加入 {{selectedCount}} 场</button></view>
      <view class="bottom-actions"><button class="secondary" disabled="{{!!busy}}" bindtap="openAdd">手动补一场</button><button class="secondary" bindtap="copyWebUrl">复制网页版地址</button></view><view class="privacy-note">资料仅用于你主动发起的整理。不会查询身份证或向团内自动公开。</view>
    </block>
  </block>
</view>
