.growth-node{font-size: 12px;line-height:1.8;color:var(--brand);margin-top:10rpx}

.quote>view,.memory-story{white-space:pre-wrap}

.search-field{box-sizing:border-box;display:block;width:100%;height:82rpx;padding:0 24rpx;border:1rpx solid var(--border);background:#fff;font-size: 12px;line-height:82rpx;margin:0 0 30rpx}

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-history-history .card, .mini-history-history .add-strip, .mini-history-history .memory-card, .mini-history-history .insight, .mini-history-history .moment, .mini-history-history .confirm-panel { border-radius: 36rpx; }
.mini-history-history .primary, .mini-history-history .secondary, .mini-history-history .search-field, .mini-history-history .select-box { border-radius: 24rpx; }
.mini-history-history .pb, .mini-history-history .tags, .mini-history-history .tag-options { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-history-history { color: var(--text); }
.mini-history-history button { font-weight: 500; border-radius: 24rpx; }

.history-page { color: var(--text); background: transparent; }
.page-title,.review-title { font-weight: 600; }
.card { border: 1px solid var(--border); box-shadow: var(--card-shadow); background: #ffffff; }
.memory-card { border: 1px solid var(--border); background: #ffffff; }
.add-strip { border: 1px solid var(--border); }
.confirm-panel { border: 1px solid var(--border); }
.mode-tabs { gap: 28rpx; padding: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; }
.mode-tabs > view,.mode-tabs > view.active { border-radius: 0; background: transparent; font-size: 14px; }
.mode-tabs > view.active { color: var(--text); box-shadow: inset 0 -2px var(--brand); }
.hero-title { font-size: 24px; line-height: 1.45; font-weight: 600; }
.memory-story,.quote,.fact { font-size: 14px; line-height: 1.85; }
.field input,.field textarea,.select-box { border: 1px solid var(--border); border-radius: 24rpx; background: var(--page-bg); font-size: 14px; }
.tag-options > view { border: 1px solid var(--border); border-radius: 14rpx; font-size: 12px; }
.tag-options > view.chosen { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
.tags > text { border-radius: 12rpx; font-size: 11px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-history-history .primary { font-size: 14px; font-weight: 500; }
.mini-history-history .secondary { font-size: 13px; font-weight: 500; }

/* Existing semantic sections receive distinct light color surfaces. */
.growth-hero { background: linear-gradient(135deg,#fff8e5,#ffffff); border-color: #f0e1c1; box-shadow: var(--card-shadow); }
