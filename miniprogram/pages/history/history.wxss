.growth-node{line-height:1.8}

.quote>view,.memory-story{white-space:pre-wrap}

.search-field{box-sizing:border-box;display:block;width:100%;line-height:82rpx}

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-history-history .card, .mini-history-history .add-strip, .mini-history-history .memory-card, .mini-history-history .insight, .mini-history-history .moment, .mini-history-history .confirm-panel { border-radius:24rpx; }
.mini-history-history .primary, .mini-history-history .secondary, .mini-history-history .search-field, .mini-history-history .select-box { border-radius:24rpx; }
.mini-history-history .pb, .mini-history-history .tags, .mini-history-history .tag-options { border-radius:14rpx; }
.mini-history-history { color: var(--text); }
.mini-history-history button { font-weight: 500; border-radius:24rpx; }
.page-title,.review-title { font-weight: 600; }
.add-strip { border: 1px solid var(--border); }
.confirm-panel { border: 1px solid var(--border); }
.mode-tabs { gap: 28rpx; border-bottom: 1px solid var(--border); }
.mode-tabs > view,.mode-tabs > view.active { border-radius:0; background: transparent; font-size:14px; }
.mode-tabs > view.active { color: var(--text); box-shadow:none; }
.hero-title { font-weight: 600; }
.memory-story,.quote,.fact { font-size:14px; line-height: 1.85; }
.field input,.field textarea,.select-box { border: 1px solid var(--border); border-radius:24rpx; background: var(--page-bg); font-size:14px; }
.tag-options > view { border: 1px solid var(--border); border-radius:14rpx; font-size:12px; }
.tag-options > view.chosen { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
.tags > text { border-radius:12rpx; font-size:12px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-history-history .primary { font-size:14px; font-weight: 500; }
.mini-history-history .secondary { font-size:13px; font-weight: 500; }

/* One neutral surface system, with the same brand accent as the main tabs. */
.history-page { --history-ink:#1a1a1a; --history-muted:#777; --history-line:#f5f5f5; --history-surface:#f5f5f5; }
.page-title { margin:0 0 10rpx; letter-spacing:normal; }
.subtitle { font-size:12px; color:var(--history-muted); }
.card,.memory-card,.confirm-panel { border-color:var(--history-line); box-shadow:none; border-radius:24rpx; }
.growth-hero { border-color:var(--history-line); border-top:5rpx solid var(--brand); }
.hero-clock,.review-clock,.stat-number { color:var(--history-ink); }
.stats { border-color:var(--history-line); }
.stats>view { border-color:var(--history-line); }
.insight { background:var(--history-surface); border:1rpx solid var(--history-line); border-radius:24rpx; }
.fact,.source-line,.privacy-note { color:var(--history-muted); }
.back { display:flex; align-items:center; min-height:44px; margin:0 0 18rpx; padding:0; }
.form-heading { color:var(--history-ink); font-size:24px; font-weight:600; }
.form-intro { font-size:12px; margin:10rpx 0 24rpx; }
.import-card { margin:0 0 24rpx; }
.import-step { display:flex; align-items:center; gap:16rpx; }
.import-step>text { display:flex; justify-content:center; align-items:center; width:46rpx; height:46rpx; border-radius:12rpx; color:var(--brand); background:var(--brand-soft); font-size:12px; font-weight:600; }
.import-step .section-title { font-size:15px; }
.step-note { margin-left:auto; color:var(--history-muted); white-space:nowrap; }
.import-actions { margin-top:28rpx; }
.import-choice.secondary { display:flex; align-items:center; gap:12rpx; padding:20rpx 16rpx; min-height:128rpx; text-align:left; border-color:var(--history-line); border-radius:20rpx; }
.choice-icon { display:block; width:38rpx; color:var(--brand); font-size:22px; font-weight:400; flex-shrink:0; text-align:center; }
.import-choice>view { flex:1; min-width:0; }
.choice-title { display:block; color:var(--history-ink); font-weight:600; }
.choice-note { display:block; color:var(--history-muted); line-height:1.5; margin-top:7rpx; }
.file-hint { color:var(--history-muted); font-size:12px; margin:14rpx 0 0; line-height:1.7; }
.import-card .field { margin:28rpx 0 20rpx; }
.import-card .field>text { font-size:12px; margin-bottom:14rpx; }
.import-text { height:290rpx!important; min-height:260rpx!important; background:var(--history-surface)!important; border-color:var(--history-line)!important; border-radius:20rpx!important; font-size:13px!important; line-height:1.75!important; }
.import-card .primary { margin-top:20rpx; min-height:46px; border-radius:20rpx; font-size:14px; font-weight:600; }
.import-privacy { color:var(--history-muted); font-size:12px; line-height:1.7; margin-top:18rpx; }
.primary,.secondary { min-height:44px; }
.secondary { color:var(--history-ink); border-color:var(--history-line); }
.notice,.success-strip { background:var(--history-surface); color:var(--history-ink); border:1rpx solid var(--history-line); }
.candidate-warning { background:var(--history-surface); color:var(--history-ink); }
.candidate.selected { border-color:var(--brand); }
.duplicate { background:var(--history-surface); }
@media(max-width:350px) {
  .history-page { padding-left:28rpx; padding-right:28rpx; }
  .import-choice.secondary { gap:8rpx; padding:18rpx 11rpx; }
  .choice-icon { width:30rpx; font-size:20px; }
}

