ht:1.6}.share-radio{flex:none;width:18px;height:18px;border:1.5px solid var(--border);border-radius:50%;box-sizing:border-box}.share-option.is-selected .share-radio{border:5px solid var(--brand)}.share-option-copy{flex:1;min-width:0}.share-option-copy>view{font-size:16px;font-weight:500;color:var(--text);overflow-wrap:anywhere}.share-option-copy>text{display:block;margin-top:6rpx;font-size:12px;font-weight:400;color:var(--text-secondary);line-height:1.7;overflow-wrap:anywhere}.mini-race-race .share-submit{width:100%;min-height:46px;margin:32rpx 0 0;box-sizing:border-box}.mini-race-race .poster{font-size:16px;border-radius:12px}

