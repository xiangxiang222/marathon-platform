/* Race-specific arrangements stay separate from personal participation. */
.mini-race-race .race-outings{padding:20px 18px;border:1px solid #eeeef0;border-radius:16px}.outing-heading,.outing-card-top,.outing-list-head,.outing-card-footer{display:flex;align-items:center;justify-content:space-between;gap:12px}.outing-heading .h2{font-size:18px;font-weight:600;line-height:1.5}.outing-kicker{font-size:12px;color:#ff1838;line-height:1.6;margin-bottom:3px}.race-outings button{box-sizing:border-box;width:auto;margin:0;min-height:44px;border:0;font-size:13px;line-height:20px}.race-outings button::after{border:0}.mini-race-race .outing-start{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:22px;background:#fff3f5;color:#f22446}.outing-start>text{font-size:17px}.outing-intro{font-size:13px;line-height:1.8;color:#666671;margin:14px 0 18px}.outing-intro>text{display:block;font-size:12px;color:#9999a2;margin-top:3px}.outing-list-head{padding:14px 0;border-top:1px solid #f0f0f3;font-size:13px;color:#64646e}.outing-list-head>text{flex:none}.outing-filter{display:flex;align-items:center;justify-content:flex-end;gap:9px;min-height:44px;max-width:150px;font-size:12px;color:#8a8a94;overflow-wrap:anywhere}.outing-list-head picker{min-width:0}.outing-empty{padding:20px 2px;font-size:13px;line-height:1.8;color:#92929c;text-align:center}.outing-empty>text{display:block;font-size:12px;margin-top:5px}.mini-race-race .outing-link{padding:8px 0;background:transparent;color:#8c8c96;font-size:12px}.outing-empty .outing-link{margin:8px auto 0;color:#ff1838}.outing-form{padding:18px 14px;background:#fafafb;border:1px solid #eeeef2;border-radius:12px;margin:12px 0 22px}.outing-form-title{font-size:14px;font-weight:600;color:#42424a;margin-bottom:13px}.outing-kind-options{display:flex;gap:7px;margin-bottom:18px}.mini-race-race .outing-kind-options button{flex:1;padding:10px 0;background:#fff;border:1px solid #e8e8ed;border-radius:9px;color:#81818a}.mini-race-race .outing-kind-options button.on{background:#fff2f5;border-color:#ffb8c7;color:#f22446}.o