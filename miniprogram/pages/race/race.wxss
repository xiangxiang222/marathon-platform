.outing-actions{display:flex;align-items:center;gap:12px;flex:none}.outing-card-footer>text{min-width:0}

/* Club audience selection. */
.mini-race-race .companion-settings{padding:16px;border:1px solid #eeeef0;border-radius:16px}.mini-race-race .companion-toggle{display:flex;align-items:center;gap:11px;width:100%;min-height:44px;padding:0;margin:0;background:transparent;border:0;text-align:left;line-height:1.6}.sync-group-icon{position:relative;width:34px;height:34px;flex:none;background:#fff0f4;border-radius:10px;color:#ff1838}.sync-group-icon>view{position:absolute;left:8px;top:20px;width:10px;height:7px;border:1.3px solid currentColor;border-bottom:0;border-radius:6px 6px 0 0}.sync-group-icon>view::before{position:absolute;content:'';width:6px;height:6px;left:.7px;top:-9px;border:1.3px solid currentColor;border-radius:50%}.sync-group-icon>view:last-child{left:18px;top:21px;transform:scale(.8);opacity:.65}.sync-heading{flex:1;min-width:0}.sync-heading>view:first-child{font-size:15px;font-weight:600;color:#303039}.sync-summary{margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:#a0a0aa}.sync-summary text{margin-right:8px}.sync-badge{flex:none;padding:3px 7px;border-radius:12px;font-size:12px;color:#94949e;background:#f5f5f7}.sync-badge.shared{color:#ed4562;background:#fff2f5}.sync-chevron{flex:none;width:6px;height:6px;margin:0 2px 3px 0;border-right:1.3px solid #aaaab4;border-bottom:1.3px solid #aaaab4;transform:rotate(45deg)}.sync-chevron.open{transform:rotate(225deg);margin-top:6px}.sync-panel{margin-top:17px;border-top:1px solid #f0f0f3}.sync-rule{margin:14px 0;font-size:12px;line-height:1.8;color:#92929c}.sync-choice{display:flex;align-items:center;gap:10px;min-height:68px;margin:9px 0;padding:12px;border:1px solid #eaeaf0;border-radius:11px;background:#fff}.sync-choice.selected{background:#fff6f8;border-color:#ffc3d0}.sync-avatar{display:flex;align-items:center;justify-content:center;width:32px;height:32px;flex:none;border-radius:9px;background:#f3f3f6;font-size:14px;font-weight:600;color:#92929e}.selected .sync-avatar{background:#ffe8ee;color:#eb4564}.sync-choice-copy{flex:1;min-width:0;line-height:1.7}.sync-choice-copy>view{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;color:#454550;font-weight:500}.sync-choice-copy>text{display:block;font-size:12px;color:#a0a0aa;margin-top:2px}.sync-check-wrap{position:relative;flex:none;width:19px;height:19px}.sync-native{position:absolute;z-index:1;left:-12px;top:-12px;width:44px;height:44px;opacity:0}.sync-check{width:19px;height:19px;border:1.3px solid #dcdce4;border-radius:6px;background:#fff}.selected .sync-check{position:relative;background:#ff1838;border-color:#ff1838}.selected .sync-check::after{position:absolute;content:'';width:7px;height:4px;left:4px;top:5px;border-left:1.5px solid #fff;border-bottom:1.5px solid #fff;transform:rotate(-45deg)}.sync-choice.busy{opacity:.6}.sync-footer,.sync-note-footer{display:flex;align-items:center;justify-content:space-between;gap:12px}.sync-footer{padding:13px 0 3px}.sync-footer>view{min-width:0;font-size:13px;line-height:1.7;color:#64646f}.sync-footer>view>view>text{color:#ff1838}.sync-footer>view>text{display:block;font-size:12px;color:#a0a0aa;margin-top:3px}.mini-race-race .sync-save{flex:none;width:auto;min-height:44px;margin:0;padding:11px 16px;border:0;border-radius:24px;background:#ff1838;color:#fff;font-size:13px;line-height:20px}.sync-save::after,.sync-note-footer button::after{border:0}.mini-race-race .sync-save[disabled]{background:#f1f1f4;color:#aaaab3}.sync-empty{padding:20px 0;text-align:center;font-size:14px;color:#777782;line-height:1.8}.sync-empty>text{display:block;font-size:12px;color:#aaaab3;margin-top:5px}.companion-note{margin-top:17px;padding:14px 12px 6px;background:#f8f8fa;border-radius:11px}.sync-note-heading{display:flex;justify-content:space-between;font-size:13px;color:#70707c;line-height:1.7}.sync-note-heading>text:last-child{font-size:12px;color:#aaaab4}.companion-note textarea{box-sizing:border-box;width:100%;height:88px;min-height:88px;margin-top:10px;padding:10px;background:#fff;border:1px solid #eeeef2;border-radius:8px;font-size:13px;line-height:1.8}.sync-note-footer{font-size:12px;color:#a0a0aa;line-height:1.7}.mini-race-race .sync-note-footer button{flex:none;width:auto;min-height:44px;margin:0;padding:10px 0;background:transparent;border:0;color:#858591;font-size:12px;line-height:20px}
