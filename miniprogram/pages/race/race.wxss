.tabs { display: flex; margin-bottom: 20rpx; }
.tab {
  position: relative;
  flex: 1;
  text-align: center;
  background: transparent;
  color: var(--text-secondary);
  border-radius: 0;
  line-height: 64rpx;
  font-weight: 600;
  white-space: nowrap;
}
.tab.on { background: transparent; color: var(--brand); }
.tab.on::after { position: absolute; right: 12rpx; bottom: 0; left: 12rpx; border-radius: 1px; content: ''; }
.timeline { display: flex; gap: 12rpx; overflow-x: auto; }
.tl { flex: 1; min-width: 148rpx; text-align: center; }
.dot { width: 16rpx; height: 16rpx; margin: 8rpx auto; border-radius: 50%; background: var(--brand); }
.tl-at, .tl-label { display: block; }
.tl-at { font-size: 12px; font-weight: 600; }
.tl-label { margin-top: 6rpx; color: var(--text-secondary); font-size: 12px; }
.page-title { margin-top: 28rpx; }
image.qr { width: 360rpx; height: 360rpx; margin: 24rpx auto 0; background: #fff; }
.h2 { font-size: 18px; font-weight: 600; margin-bottom: 8rpx; }
.news-item { display: block; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.news-item:last-child { border-bottom: 0; padding-bottom: 0; }
.md { display: flex; flex-wrap: wrap; margin-top: 16rpx; font-size: 14px; line-height: 1.6; }
.md-h1 { margin-top: 8rpx; font-size: 18px; font-weight: 600; line-height: 1.35; }
.md-h2 { margin-top: 28rpx; font-size: 18px; font-weight: 600; line-height: 1.35; }
.md-h3 { margin-top: 22rpx; font-size: 16px; font-weight: 600; line-height: 1.4; }
.md-h4 { margin-top: 18rpx; font-size: 14px; font-weight: 600; line-height: 1.4; }
.md-li, .md-oli { padding-left: 8rpx; }
.md-mark { margin-right: 8rpx; color: var(--text-secondary); }
.md-strong { font-weight: 600; }
.sum { margin: 8rpx 0 16rpx; }
.src { color: var(--text-secondary); font-size: 12px; margin-top: 12rpx; }
.warn { margin-top: 12rpx; color: var(--brand); font-size: 12px; }
.share { margin-top: 16rpx; }
.nick .field { margin-top: 16rpx; }
.result .field { margin-top: 16rpx; }
.result .field input { background: var(--page-bg); }
.result .btn { margin-top: 16rpx;  }
.poster { margin: 12rpx 0; padding: 36rpx 28rpx; border-radius: 8px; background: var(--brand); color: #fff; font-size: 16px; font-weight: 600; line-height: 1.6; }
.poster-canvas { position: fixed; left: -2000px; top: 0; width: 750px; height: 1000px; }
image { width: 100%; margin-top: 12rpx; border-radius: 8px; }
.sheet { width: 100%; margin-top: 16rpx;  }
.guide-text { display: block; margin-top: 12rpx; white-space: pre-wrap; line-height: 1.5; font-size: 14px; }

.race-plan { border: 1rpx solid #fff; background: #ffffff; }
.plan-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.plan-heading .h2 { margin-bottom: 0; font-size: 18px; }
.plan-status { flex-shrink: 0; padding: 6rpx 14rpx; color: var(--brand); background: var(--page-bg); }
.plan-action { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height:44px; margin: 0; padding: 18rpx 0 0;  background: transparent; color: var(--text-secondary); text-align: left; font-size: 14px; font-weight: 600; line-height: 1.5; }
.plan-action::after { border: 0;  }
.plan-action .arrow { color: var(--text-secondary); font-size: 24px; font-weight: 400; line-height: 1;  }
.plan-editor { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.plan-statuses { display: flex; flex-wrap: wrap; gap: 12rpx; }
.plan-statuses .ghost { margin: 0;  }
.race-plan .src { line-height: 1.6; }
@media (max-width: 350px) { .plan-heading .h2 { font-size: 18px; } .plan-action { font-size: 14px;  } .src, .tab { font-size: 12px; } }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-race-race .card, .mini-race-race .sheet { border-radius: 12px; }
.mini-race-race .btn, .mini-race-race .ghost, .mini-race-race .plan-status, .mini-race-race .plan-action { border-radius: 10px; }
.mini-race-race .plan-status { border-radius: 7px; }

/* Page composition and interaction hierarchy. */
.mini-race-race { color: var(--text); }
.mini-race-race button { font-weight: 500; border-radius: 10px; }

.pad { padding-top: 28rpx; }
.card { border: 1px solid var(--border); }
.title { font-size: 24px; line-height: 1.45; font-weight: 600; }
.tabs { gap: 28rpx; border-bottom: 1px solid var(--border); }
.tab { font-size: 14px; }
.tab.on::after { height: 2px; background: var(--brand); }
.md,.sum { font-size: 14px; line-height: 1.85; color: var(--text); }
.src,.tl-at,.tl-label { font-size: 12px; line-height: 1.7; }
.plan-status { border: 1px solid var(--border); border-radius: 7px; background: var(--page-bg); font-size: 12px; }
.plan-status.on { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-race-race .btn { font-size: 14px; font-weight: 500; }
.mini-race-race .ghost { font-size: 14px; font-weight: 500; }

/* A single reading scale and one native share action for the selected club. */
