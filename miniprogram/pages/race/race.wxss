.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; border-bottom: 1rpx solid #f0f1f5; }
.tab {
  position: relative;
  flex: 1;
  text-align: center;
  background: transparent;
  color: #8a8e99;
  border-radius: 0;
  font-size: 24rpx;
  line-height: 64rpx;
  font-weight: 600;
  white-space: nowrap;
}
.tab.on { background: transparent; color: #ff0a30; }
.tab.on::after { position: absolute; right: 12rpx; bottom: 0; left: 12rpx; height: 4rpx; border-radius: 2rpx; background: #ff0a30; content: ''; }
.timeline { display: flex; gap: 12rpx; overflow-x: auto; }
.tl { flex: 1; min-width: 148rpx; text-align: center; }
.dot { width: 16rpx; height: 16rpx; margin: 8rpx auto; border-radius: 50%; background: #ff0a30; }
.tl-at, .tl-label { display: block; }
.tl-at { font-size: 24rpx; font-weight: 600; }
.tl-label { margin-top: 6rpx; color: #8a8e99; font-size: 22rpx; }
.page-title { margin-top: 28rpx; }
image.qr { width: 360rpx; height: 360rpx; margin: 24rpx auto 0; background: #fff; }
.h2 { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.news-item { display: block; padding: 16rpx 0; border-bottom: 1rpx solid #f0f1f5; }
.news-item:last-child { border-bottom: 0; padding-bottom: 0; }
.md { display: flex; flex-wrap: wrap; margin-top: 16rpx; font-size: 28rpx; line-height: 1.6; }
.md-h1 { margin-top: 8rpx; font-size: 40rpx; font-weight: 700; line-height: 1.35; }
.md-h2 { margin-top: 28rpx; font-size: 36rpx; font-weight: 700; line-height: 1.35; }
.md-h3 { margin-top: 22rpx; font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.md-h4 { margin-top: 18rpx; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.md-li, .md-oli { padding-left: 8rpx; }
.md-mark { margin-right: 8rpx; color: #8a8e99; }
.md-strong { font-weight: 700; }
.sum { margin: 8rpx 0 16rpx; }
.src { color: #8a8e99; font-size: 26rpx; margin-top: 12rpx; }
.warn { margin-top: 12rpx; color: #c87825; font-size: 26rpx; }
.share { margin-top: 16rpx; }
.nick .field { margin-top: 16rpx; }
.result .field { margin-top: 16rpx; }
.result .field input { background: #f5f6fa; }
.result .btn { margin-top: 16rpx; }
.poster { margin: 12rpx 0; padding: 36rpx 28rpx; border-radius: 16rpx; background: #ff0a30; color: #fff; font-size: 32rpx; font-weight: 600; line-height: 1.6; }
.poster-canvas { position: fixed; left: -2000px; top: 0; width: 750px; height: 1000px; }
image { width: 100%; margin-top: 12rpx; border-radius: 16rpx; }
.sheet { width: 100%; margin-top: 16rpx; border-radius: 16rpx; }
.guide-text { display: block; margin-top: 12rpx; white-space: pre-wrap; line-height: 1.5; font-size: 28rpx; }

.race-plan { border: 1rpx solid #fff; }
.plan-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.plan-heading .h2 { margin-bottom: 0; font-size: 36rpx; }
.plan-status { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 10rpx; background: #fff0f3; color: #ff0a30; font-size: 24rpx; }
.plan-action { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 72rpx; margin: 0; padding: 18rpx 0 0; border-radius: 0; background: transparent; color: #20222a; text-align: left; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.plan-action::after { border: 0; }
.plan-action .arrow { color: #8a8e99; font-size: 44rpx; font-weight: 400; line-height: 1; }
.plan-editor { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f1f5; }
.plan-statuses { display: flex; flex-wrap: wrap; gap: 12rpx; }
.plan-statuses .ghost { margin: 0; }
.race-plan .src { line-height: 1.6; }
@media (max-width: 350px) { .plan-heading .h2 { font-size: 18px; } .plan-action { font-size: 15px; } .src, .tab { font-size: 12px; } }
