<view class="pad mini-race-race" wx:if="{{race}}">
  <view class="race-hero {{coverSrc ? 'has-cover' : ''}}">
    <image wx:if="{{coverSrc}}" class="race-cover" src="{{coverSrc}}" data-src="{{coverSrc}}" mode="aspectFill" lazy-load="{{true}}" binderror="coverError" bindtap="previewGuide" aria-label="查看赛事封面"/>
    <view wx:else class="track-art" aria-hidden="true"><view></view><view></view><view></view></view>
    <text class="hero-kicker">{{coverSrc ? '点击查看赛事封面' : 'RACE DAY · 下一次出发'}}</text>
  </view>
  <view class="card race-identity">
    <view class="hero-top"><text class="hero-status">{{publicStatus}}</text><text>{{meetText}}举办</text></view>
    <view class="hero-name">{{race.name}}</view>
    <view class="hero-meta"><text>{{race.raceDate || '日期未录入'}}</text><text>{{locationText}}</text></view>
    <view wx:if="{{projectLabels.length}}" class="hero-projects"><text wx:for="{{projectLabels}}" wx:key="*this">{{item}}</text></view>
    <view class="entry-node"><text class="entry-node-dot"></text><view><text>{{phaseTitle}}</text><text>{{phaseDetail}}</text></view></view>
    <view wx:if="{{officialActions.length}}" class="official-actions"><button wx:for="{{officialActions}}" wx:key="key" class="official-action {{index === 0 ? 'primary' : ''}}" data-url="{{item.url}}" data-key="{{item.key}}" bindtap="copyLink">{{item.label}}<text wx:if="{{index === 0}}">↗</text></button></view>
    <view wx:else class="entry-pending">官方入口尚未录入</view>
    <view class="official-foot"><text wx:if="{{officialActions.length}}">复制链接后，在浏览器打开</text><button wx:if="{{signupQr}}" bindtap="toggleSignupQr" aria-expanded="{{signupQrOpen}}">{{signupQrOpen ? '收起二维码' : '报名二维码'}}</button></view>
    <view wx:if="{{signupQrOpen && signupQr}}" class="official-qr"><view class="src">{{signupHint}}</view><image class="qr" src="{{signupQr}}" mode="aspectFit" show-menu-by-longpress="{{true}}"/></view>
    <view wx:if="{{askSignup}}" class="signup-confirm"><text>已在官方完成报名？</text><button bindtap="confirmSigned">记录已报名</button><button bindtap="dismissAsk">稍后</button></view>
    <view class="race-follow-row">
      <view class="follow-copy"><view class="follow-heading">{{following ? '已关注这场比赛' : '关注这场比赛'}}</view><text>报名与缴费在官方渠道完成</text></view>
      <button class="follow-action {{following ? 'following' : ''}}" bindtap="toggleFollow" disabled="{{followBusy}}" aria-pressed="{{following}}" aria-label="{{following ? '取消关注' : '关注'}}{{race.name}}"><view wx:if="{{followBusy}}" class="control-spinner" aria-hidden="true"></view><image wx:else class="personal-art" src="{{following ? '/images/race-actions/follow-active.png' : '/images/race-actions/follow.png'}}" mode="aspectFit" aria-hidden="true"/><text>{{followBusy ? '保存中' : following ? '已关注' : '关注'}}</text></button>
    </view>
  </view>


  <view class="card personal-summary {{personalOpen ? 'is-open' : ''}}">
    <button class="personal-toggle" bindtap="togglePersonal" aria-expanded="{{personalOpen}}" aria-label="我的参赛安排"><image class="personal-art" src="{{myStatus ? '/images/race-actions/plan-active.png' : '/images/race-actions/plan.png'}}" mode="aspectFit" aria-hidden="true"/><view class="personal-summary-copy"><view>我的参赛安排<text>{{myStatus || '尚未添加'}}</text></view><text>{{sharedClubIds.length ? '已同步 ' + sharedClubIds.length + ' 个跑团' : '计划仅自己可见'}} · {{visibleOutings.length ? visibleOutings.length + ' 个同行安排' : '可约团友同行'}}</text></view><view class="sync-chevron {{personalOpen ? 'open' : ''}}" aria-hidden="true"></view></button>
  </view>
  <view wx:if="{{message && !personalOpen}}" class="card plan-feedback" role="status">{{message}}</view>
  <view wx:if="{{personalOpen}}" class="personal-panel">
  <view class="card race-plan {{planOpen ? 'editing' : 'collapsed'}}">
    <view class="plan-heading"><view class="h2"><image class="personal-art" src="{{myStatus ? '/images/race-actions/plan-active.png' : '/images/race-actions/plan.png'}}" mode="aspectFit" aria-hidden="true"/>我的参赛计划</view><text class="plan-private"><text wx:if="{{!sharedClubIds.length}}" class="lock-icon" aria-hidden="true"></text>{{sharedClubIds.length ? '已同步 ' + sharedClubIds.length + ' 个跑团' : '仅自己可见'}}</text></view>
    <view class="plan-overview">
      <view class="plan-summary"><view class="plan-status {{!myStatus ? 'plan-empty' : ''}}">{{myStatus || '还没有参赛计划'}}</view></view>
      <button wx:if="{{!ready}}" class="plan-action" bindtap="loginForPlan"><text>登录后标记</text><view class="control-arrow" aria-hidden="true"></view></button>
      <button wx:else class="plan-action {{planOpen ? 'expanded' : ''}}" aria-label="{{myStatus ? '修改参赛状态' : '标记参赛状态'}}" aria-expanded="{{planOpen}}" bindtap="togglePlan"><text>{{planOpen ? '收起' : myStatus ? '修改' : '添加计划'}}</text><view class="control-arrow" aria-hidden="true"></view></button>
    </view>
    <view wx:if="{{ready && planOpen}}" class="plan-editor">
      <view class="plan-stages" role="tablist" aria-label="参赛阶段"><button wx:for="{{planStages}}" wx:key="id" class="stage {{planStage === item.id ? 'on' : ''}}" role="tab" aria-selected="{{planStage === item.id}}" aria-label="{{item.label}}" data-id="{{item.id}}" bindtap="pickPlanStage"><text class="stage-number">{{index + 1}}</text><text class="stage-label">{{item.id === 'wish' ? '意向' : item.id === 'signup' ? '报名' : item.id === 'confirmed' ? '参赛' : '赛后'}}</text></button></view>
      <view class="state-field-heading"><text>选择当前状态</text><text>{{planBusy ? '正在保存…' : '点击即保存'}}</text></view>
      <view class="plan-statuses {{stageStatuses.length === 1 ? 'single' : ''}}"><button wx:for="{{stageStatuses}}" wx:key="*this" class="plan-option {{myStatus === item ? 'on' : ''}}" data-status="{{item}}" aria-label="{{item}}" aria-pressed="{{myStatus === item}}" disabled="{{planBusy}}" bindtap="mark"><text>{{item}}</text><view class="option-check" aria-hidden="true"></view></button></view>
      <view class="plan-hint">可直接选择任一阶段，不必依次完成。</view>
      <view wx:if="{{planStage === 'finished'}}" class="record-result" role="button" data-id="result" bindtap="pickTab">去记录完赛成绩 <text aria-hidden="true">→</text></view>
      <view wx:if="{{myStatus}}" class="plan-evidence">
        <view class="evidence-heading"><view><view>报名凭证</view><text>截图仅自己可见</text></view><button class="evidence-upload" disabled="{{planBusy}}" bindtap="chooseSheet">{{hasSheet ? '更换截图' : '上传截图'}}<text aria-hidden="true">＋</text></button></view>
        <image wx:if="{{sheetSrc}}" class="evidence-preview" src="{{sheetSrc}}" mode="widthFix" />
        <button wx:if="{{hasSheet}}" class="plan-text-action" disabled="{{planBusy}}" bindtap="removeSheet">移除截图</button>
      </view>
      <view wx:if="{{myStatus}}" class="plan-footer"><text>不再安排这场比赛？</text><button class="remove-plan" disabled="{{planBusy}}" bindtap="removePlan">移除计划</button></view>
    </view>
    <view wx:if="{{planOpen}}" class="plan-disclaimer">个人记录，报名与参赛资格以官方结果为准。</view>
    <view wx:if="{{message}}" class="plan-feedback" role="status">{{message}}</view>
  </view>

  <view wx:if="{{ready}}" class="card companion-settings">
    <button class="companion-toggle" bindtap="toggleCompanion" aria-expanded="{{companionOpen}}" aria-label="{{'同步到跑团，' + (sharedClubIds.length ? '已同步' + sharedClubIds.length + '个跑团' : '仅自己可见')}}"><view class="sync-group-icon" aria-hidden="true"><view></view><view></view></view><view class="sync-heading"><view>同步到跑团</view><view class="sync-summary"><block wx:if="{{sharedClubIds.length}}"><text wx:for="{{clubs}}" wx:key="id" wx:if="{{item.synced}}">{{item.name}}</text></block><text wx:else>参赛安排默认仅自己可见</text></view></view><text class="sync-badge {{sharedClubIds.length ? 'shared' : ''}}">{{sharedClubIds.length ? sharedClubIds.length + '个跑团' : '仅自己'}}</text><view class="sync-chevron {{companionOpen ? 'open' : ''}}" aria-hidden="true"></view></button>
    <view wx:if="{{companionOpen}}" class="sync-panel">
      <view class="sync-rule">仅所选跑团可见，不会替你报名团内活动。</view>
      <checkbox-group bindchange="pickSharedClubs" aria-label="选择同步跑团"><label wx:for="{{clubs}}" wx:key="id" class="club-choice sync-choice {{item.selected ? 'selected' : ''}} {{planBusy ? 'busy' : ''}}"><view class="sync-avatar" aria-hidden="true">{{item.name ? item.name[0] : '团'}}</view><view class="sync-choice-copy"><view>{{item.name}}</view><text>{{item.mates.length ? item.mates.length + '位团友已分享计划' : '同步本场参赛状态与备注'}}</text></view><view class="sync-check-wrap"><checkbox class="sync-native" value="{{item.id + ''}}" checked="{{item.selected}}" disabled="{{planBusy}}" color="#ff1838" aria-label="{{item.name}}"/><view class="sync-check" aria-hidden="true"></view></view></label></checkbox-group>
      <view wx:if="{{!clubs.length}}" class="sync-empty"><view>还没加入跑团</view><text>个人参赛计划照常保存，加入后再同步。</text></view>
      <view wx:else class="sync-footer"><view><view>已选 <text>{{sharingDraft.length}}</text> 个跑团</view><text>{{!myStatus ? '先在上方添加参赛计划' : sharingDirty ? '选择尚未保存' : sharingDraft.length ? '已保存的范围已生效' : '不选则仅自己可见'}}</text></view><button class="sync-save" disabled="{{planBusy || !myStatus}}" bindtap="saveSharing">{{planBusy ? '保存中…' : '保存选择'}}</button></view>
      <view wx:if="{{myStatus}}" class="companion-note"><view class="sync-note-heading"><text>同行备注</text><text>选填</text></view><textarea value="{{companionNote}}" bindinput="onCompanionNote" maxlength="200" placeholder="想和团友说点什么，例如：赛后一起合影" aria-label="同行备注" disabled="{{planBusy}}"/><view class="sync-note-footer"><text>{{sharedClubIds.length ? '仅已同步跑团可见' : '当前仅自己可见'}}</text><button disabled="{{planBusy}}" bindtap="saveCompanionNote">保存备注</button></view></view>
    </view>
  </view>



  <view class="card race-outings" id="race-outings">
    <button class="outings-toggle" bindtap="toggleOutings" aria-expanded="{{outingsOpen}}"><view><text>本场同行</text><text class="outing-summary">{{visibleOutings.length ? visibleOutings.length + ' 个安排 · 拼车 / 集合 / 领物' : '拼车 / 集合 / 领物'}}</text></view><text>{{outingsOpen ? '收起' : '展开'}}</text><view class="sync-chevron {{outingsOpen ? 'open' : ''}}" aria-hidden="true"></view></button>
    <view wx:if="{{outingsOpen}}" class="outings-content"><view class="outing-heading"><view class="h2">约好这一程</view><button class="outing-start" bindtap="toggleOutingForm" disabled="{{!!outingBusy}}" aria-expanded="{{outingFormOpen}}">{{outingFormOpen ? '收起' : '发起同行'}}<text>{{outingFormOpen ? '−' : '＋'}}</text></button></view>
    <view class="outing-intro">拼车、集合、领物，在这场比赛下约好。<text>仅团内可见，与参赛计划和活动独立。</text></view>
    <view wx:if="{{outingFeedback}}" class="outing-feedback" role="status">{{outingFeedback}}</view>
    <view wx:if="{{!ready}}" class="outing-empty"><view>登录后，与团友约好这一程</view><button class="outing-link" bindtap="loginForOutings">登录查看 ›</button></view>
    <block wx:else>
      <view wx:if="{{outingFormOpen}}" class="outing-form">
        <view class="outing-form-title">发起一次同行</view>
        <view class="outing-kind-options"><button wx:for="{{outingKinds}}" wx:key="id" class="{{outingKind === item.id ? 'on' : ''}}" data-kind="{{item.id}}" bindtap="pickOutingKind" disabled="{{!!outingBusy}}" aria-pressed="{{outingKind === item.id}}">{{item.label}}</button></view>
        <view class="outing-field-label">所属跑团</view><picker mode="selector" range="{{outingClubOptions}}" range-key="name" value="{{outingClubIndex}}" bindchange="pickOutingClub" disabled="{{!!outingBusy}}"><view class="outing-input outing-select">{{outingClubOptions.length ? outingClubOptions[outingClubIndex].name : '请先加入跑团'}}<text>⌄</text></view></picker>
        <view class="outing-field-label">出发 / 集合时间 <text>北京时间</text></view>
        <view class="outing-time-fields"><picker mode="date" start="{{outingToday}}" value="{{outingDate}}" data-key="outingDate" bindchange="onOutingField" disabled="{{!!outingBusy}}"><view class="outing-input">{{outingDate || '选择日期'}}<text>⌄</text></view></picker><picker mode="time" value="{{outingTime || '07:00'}}" data-key="outingTime" bindchange="onOutingField" disabled="{{!!outingBusy}}"><view class="outing-input">{{outingTime || '选择时间'}}<text>⌄</text></view></picker></view>
        <view class="outing-field-label">地点</view><input class="outing-input" value="{{outingPlace}}" data-key="outingPlace" bindinput="onOutingField" maxlength="120" placeholder="写清上车、集合或领物地点" aria-label="同行地点" disabled="{{!!outingBusy}}"/>
        <view class="outing-field-label">总人数 <text>含发起人，1—100人</text></view><input class="outing-input" type="number" value="{{outingCapacity}}" data-key="outingCapacity" bindinput="onOutingField" maxlength="3" aria-label="同行总人数，含发起人" disabled="{{!!outingBusy}}"/>
        <view class="outing-field-label">备注 <text>选填</text></view><textarea class="outing-note" value="{{outingNote}}" data-key="outingNote" bindinput="onOutingField" maxlength="300" placeholder="例如：车费分摊方式、集合标志、领物安排" aria-label="同行备注，最多300字" disabled="{{!!outingBusy}}"/>
        <button class="outing-submit" bindtap="createOuting" disabled="{{!!outingBusy || !outingClubOptions.length}}">{{outingBusy === 'create' ? '正在发布…' : '发布并加入'}}</button><view class="outing-form-foot">发起人占1位，参赛状态不变。</view>
      </view>
      <view class="outing-list-head"><text>团友的同行安排</text><picker wx:if="{{outingFilters.length > 1}}" mode="selector" range="{{outingFilters}}" range-key="name" value="{{outingFilterIndex}}" bindchange="pickOutingFilter"><view class="outing-filter">{{outingFilters[outingFilterIndex].name}}<text>⌄</text></view></picker></view>
      <view wx:if="{{outingsError}}" class="outing-load-error"><text>{{outingsError}}</text><button class="outing-link" bindtap="loadOutings" disabled="{{outingsLoading}}">{{outingsLoading ? '重试中…' : '重新加载'}}</button></view>
      <view wx:elif="{{outingsLoading && !outings.length}}" class="outing-empty">正在加载同行安排…</view>
      <view wx:elif="{{!visibleOutings.length}}" class="outing-empty">{{outingFilterClubId ? '这个跑团还没有本场同行安排' : '还没有同行安排，来约上第一位团友'}}<text>无需先添加参赛计划，也可以发起和加入。</text></view>
      <view wx:for="{{visibleOutings}}" wx:key="id" class="outing-card">
        <view class="outing-card-top"><view class="outing-type">{{item.kindLabel}}</view><text class="outing-state {{item.past || item.full ? 'quiet' : ''}}">{{item.stateLabel}}</text></view>
        <view class="outing-place">{{item.place}}</view><view class="outing-when">{{item.timeLabel}} <text>北京时间</text></view><view class="outing-club">{{item.clubName}} · {{item.host.nickname}} 发起</view>
        <view wx:if="{{item.note}}" class="outing-card-note">{{item.note}}</view>
        <view class="outing-roster-label">同行名单 <text>{{item.memberCount}} / {{item.capacity}} 人</text></view><view class="outing-members"><text wx:for="{{item.members}}" wx:for-item="member" wx:key="userId">{{member.nickname}}{{member.userId === item.host.userId ? ' · 发起人' : ''}}</text></view>
        <view class="outing-card-footer"><text>{{item.isHost ? '你发起的同行' : item.joined ? '你已加入' : item.past ? '出发时间已过' : item.full ? '名额已满' : '与团友一起出发'}}</text><view class="outing-actions"><button wx:if="{{item.canCancel}}" class="outing-link" data-id="{{item.id}}" bindtap="cancelOuting" disabled="{{!!outingBusy}}">{{outingBusy === item.id + '' ? '处理中…' : '取消同行'}}</button><button wx:if="{{item.canJoin || item.canLeave}}" class="outing-join {{item.joined ? 'joined' : ''}}" data-id="{{item.id}}" bindtap="changeOutingMembership" disabled="{{!!outingBusy}}">{{outingBusy === item.id + '' ? '处理中…' : item.joined ? '退出同行' : '加入同行'}}</button></view></view>
      </view>
    </block>
    </view>
  </view>

    <view wx:if="{{shareChoices.length}}" class="card race-share">
      <button class="share-toggle" bindtap="toggleShare" aria-expanded="{{shareOpen}}"><text>分享赛事到跑团</text><text class="arrow">{{shareOpen ? '⌃' : '›'}}</text></button>
      <view class="src">选择跑团，分享这场比赛与跑团参赛动态。</view>
      <view wx:if="{{shareOpen}}" class="share-content">
        <view class="share-options" role="radiogroup" aria-label="选择分享跑团">
          <button wx:for="{{shareChoices}}" wx:key="selectionKey" class="share-option {{selectedShareKey === item.selectionKey ? 'is-selected' : ''}}" role="radio" aria-checked="{{selectedShareKey === item.selectionKey}}" data-key="{{item.selectionKey}}" bindtap="selectShare"><view class="share-radio"></view><view class="share-option-copy"><view>{{item.club.name}}</view><text>{{item.summary || '分享这场赛事与跑团参赛动态'}}</text></view></button>
        </view>
        <button wx:if="{{selectedShare}}" class="btn share-submit" open-type="share" data-title="{{selectedShare.title}}" data-code="{{selectedShare.club.code}}" bindtap="armShare">发到微信群</button>
      </view>
    </view>
    <view wx:for="{{clubs}}" wx:key="id" class="card">
      <view class="plan-heading"><view class="h2">{{item.name}} · 参赛记录</view><text class="src">{{item.synced ? '我的计划已同步' : '我的计划未同步'}}</text></view>
      <view class="src">团友主动同步的个人参赛状态，与同行安排分开记录。</view>
      <view wx:if="{{item.squadText}}" class="warn">{{item.squadText}}</view>
      <view wx:if="{{!item.mates.length}}" class="muted">还没有团友同步参赛计划</view>
      <view wx:for="{{item.mates}}" wx:for-item="mate" wx:key="userId" class="companion-member"><view class="row"><text>{{mate.nickname}}</text><text>{{mate.status}}</text></view><view wx:if="{{mate.note}}" class="src">{{mate.note}}</view></view>
      <view class="record-result" role="button" data-club="{{item.id}}" bindtap="showClubOutings">查看本团同行安排 ›</view><view class="src">跑团活动需单独报名，官方参赛资格仍以组委会为准。</view>
    </view>
  </view>

  <view class="tabs" role="tablist" aria-label="赛事内容">
    <button wx:for="{{tabs}}" wx:key="id" class="tab {{tab === item.id ? 'on' : ''}}" role="tab" aria-selected="{{tab === item.id}}" data-id="{{item.id}}" bindtap="pickTab">{{item.label}}</button>
  </view>

  <view class="race-tab-content">
  <block wx:if="{{tab === 'signup'}}">
  <navigator wx:if="{{race.archiveId}}" class="race-archive-entry" url="/pages/race-archive/race-archive?id={{race.archiveId}}&fromRaceId={{race.id}}"><image class="archive-art" src="/images/quick-calendar.png" mode="aspectFit"/><view><view>赛事档案</view><text>历年赛道、报名中签与完赛记忆</text></view><text>›</text></navigator>
    <view class="card" wx:if="{{race.place || race.gradeLabel || race.phone || conflicts.length}}">
      <view class="h2">赛事资料</view>
      <view wx:if="{{race.place}}" class="row"><text class="k">比赛地点</text><text>{{race.place}}</text></view><view wx:if="{{race.gradeLabel}}" class="row"><text class="k">认证</text><text>{{race.gradeLabel}}</text></view><view wx:if="{{race.phone}}" class="row"><text class="k">咨询</text><text>{{race.phone}}</text></view><view wx:for="{{conflicts}}" wx:key="text" class="warn">{{item.text}}</view>

    </view>

    <view class="card" wx:if="{{race.nodes.length}}">
      <view class="h2">赛事时间线</view>
      <view class="timeline">
        <view wx:for="{{race.nodes}}" wx:key="key" class="tl">
          <view class="dot"></view>
          <text class="tl-at">{{item.at}}</text>
          <text class="tl-label">{{item.label}}</text>
        </view>
      </view>

    </view>
    <view class="card" wx:if="{{race.fee || race.scale || race.startAt || race.kindLabels.length || race.groups.length}}">
      <view class="h2">参赛项目与规模</view>
      <view wx:if="{{race.startAt}}" class="row"><text class="k">起跑</text><text>{{race.startAt}}</text></view>
      <view wx:if="{{race.fee}}" class="row"><text class="k">报名费</text><text>{{race.fee}}</text></view>
      <view wx:if="{{race.scale}}" class="row"><text class="k">规模</text><text>{{race.scale}}</text></view>
      <view wx:if="{{race.kindLabels.length}}" class="src">{{kindText}}</view>
      <view wx:if="{{race.groups.length}}" class="src">{{groupText}}</view>
    </view>
    <view class="card" wx:if="{{drawRates.length}}">
      <view class="h2">历年中签</view>
      <view class="src">按公布的报名人数和名额计算。</view>
      <view wx:for="{{drawRates}}" wx:key="id">
        <view class="src">{{item.label}} · 报名 {{item.applicants}} · 名额 {{item.quota}} · {{item.rateText}}</view>
        <view class="src">来源 {{item.source}}</view>
      </view>
    </view>
    <view class="card race-source" wx:if="{{race.organizer || race.source || race.eventUrl || race.officialUrl}}"><button class="source-toggle" bindtap="toggleSource" aria-expanded="{{sourceOpen}}"><text>主办与资料信息</text><text>{{sourceOpen ? '收起' : '按需查看'}} ›</text></button><view wx:if="{{sourceOpen}}" class="source-content">
      <view wx:if="{{race.organizer}}" class="src">主办 {{race.organizer}}</view>
      <view wx:if="{{race.source}}" class="src">来源 {{race.source}}<text wx:if="{{race.updatedAt}}"> · 更新于 {{race.updatedAt}}</text></view>
      <button wx:if="{{race.eventUrl}}" class="official-text" data-url="{{race.eventUrl}}" bindtap="copyLink">赛事网站 ↗</button>
      <button wx:if="{{race.officialUrl}}" class="official-text" data-url="{{race.officialUrl}}" bindtap="copyLink">中国马拉松赛事页 ↗</button>

    </view></view>
  </block>

  <block wx:if="{{tab === 'guide'}}">
    <view wx:if="{{!race.route && !routeSheets.length && !race.pickup && !race.pacers && !pacerSheets.length && !race.startAt && !race.place && !guide.length && !guideBlocks.length}}" class="card content-empty">参赛指南尚未录入，后续资料将在这里更新。</view>
    <view class="card day-guide" wx:if="{{race.route || routeSheets.length || race.pickup || race.pacers || pacerSheets.length || race.startAt || race.place}}">
      <view class="h2">比赛日安排</view>
      <view wx:if="{{race.startAt || race.place}}" class="day-section"><view class="day-section-title">起跑与检录</view><view wx:if="{{race.startAt}}" class="src">起跑时间 · {{race.startAt}}</view><view wx:if="{{race.place}}" class="src">{{race.place}}</view></view>
      <view wx:if="{{race.route || routeSheets.length}}" class="day-section"><view class="day-section-title">赛道与路线</view><view wx:if="{{race.route}}" class="guide-text">{{race.route}}</view>
      <view wx:for="{{routeSheets}}" wx:key="id" class="race-media {{item.state === 'failed' ? 'media-failed' : ''}}">
        <button wx:if="{{item.state !== 'failed'}}" class="media-open" data-src="{{item.src}}" bindtap="previewGuide" aria-label="预览路线图"><image lazy-load="{{true}}" class="sheet" mode="aspectFit" src="{{item.displaySrc || item.src}}" data-kind="routeSheets" data-id="{{item.id}}" data-src="{{item.displaySrc || item.src}}" bindload="mediaLoaded" binderror="mediaError"/><text class="media-caption">路线图 {{index + 1}} · 点击查看原图</text><view wx:if="{{item.state === 'loading'}}" class="media-loading">正在加载…</view></button>
        <view wx:else class="media-error"><view>路线图加载失败</view><button data-kind="routeSheets" data-id="{{item.id}}" bindtap="retryMedia">重新加载</button></view>
      </view>
      </view>
      <view wx:if="{{race.pickup}}" class="day-section"><view class="day-section-title">领物指引</view><view class="guide-text">{{race.pickup}}</view></view>
      <view wx:if="{{race.pacers || pacerSheets.length}}" class="day-section"><view class="day-section-title">配速与官兔</view><view wx:if="{{race.pacers}}" class="guide-text">{{race.pacers}}</view>
      <view wx:for="{{pacerSheets}}" wx:key="id" class="race-media {{item.state === 'failed' ? 'media-failed' : ''}}">
        <button wx:if="{{item.state !== 'failed'}}" class="media-open" data-src="{{item.src}}" bindtap="previewGuide" aria-label="预览配速资料"><image lazy-load="{{true}}" class="sheet" mode="aspectFit" src="{{item.displaySrc || item.src}}" data-kind="pacerSheets" data-id="{{item.id}}" data-src="{{item.displaySrc || item.src}}" bindload="mediaLoaded" binderror="mediaError"/><text class="media-caption">配速资料 {{index + 1}} · 点击查看原图</text><view wx:if="{{item.state === 'loading'}}" class="media-loading">正在加载…</view></button>
        <view wx:else class="media-error"><view>配速资料加载失败</view><button data-kind="pacerSheets" data-id="{{item.id}}" bindtap="retryMedia">重新加载</button></view>
      </view>
      </view>
    </view>
    <view class="card" wx:if="{{guide.length || guideBlocks.length}}">
      <view class="h2">竞赛规程</view>
      <view wx:if="{{guideBlocks.length}}" class="src">参赛资格、关门时间和奖金以组委会规程为准。</view>
      <view wx:for="{{guideBlocks}}" wx:key="i" class="md md-{{item.kind}}"><text wx:if="{{item.mark}}" class="md-mark">{{item.mark}}</text><text wx:for="{{item.runs}}" wx:for-item="run" wx:key="j" class="{{run.strong ? 'md-strong' : ''}}">{{run.text}}</text></view>
      <view wx:if="{{guide.length}}" class="day-section-title page-title">规程原页 <text>共 {{guide.length}} 页</text></view>
      <view wx:for="{{guide}}" wx:key="id" class="race-media {{item.state === 'failed' ? 'media-failed' : ''}}">
        <button wx:if="{{item.state !== 'failed'}}" class="media-open" data-src="{{item.src}}" bindtap="previewGuide" aria-label="预览规程原页"><image lazy-load="{{true}}" class="sheet" mode="aspectFit" src="{{item.displaySrc || item.src}}" data-kind="guide" data-id="{{item.id}}" data-src="{{item.displaySrc || item.src}}" bindload="mediaLoaded" binderror="mediaError"/><text class="media-caption">规程原页 {{index + 1}} · 点击查看原图</text><view wx:if="{{item.state === 'loading'}}" class="media-loading">正在加载…</view></button>
        <view wx:else class="media-error"><view>规程原页加载失败</view><button data-kind="guide" data-id="{{item.id}}" bindtap="retryMedia">重新加载</button></view>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'news'}}">
    <view wx:if="{{!articles.length && !liveSheet && !alternatives.length}}" class="card content-empty">赛事资讯更新中</view>
    <view class="card" wx:if="{{articles.length}}">
      <view class="h2">相关资讯</view>
      <navigator wx:for="{{articles}}" wx:key="id" class="news-item" url="/pages/news/detail?id={{item.id}}">
        <view class="title">{{item.title}}</view>
        <view class="src">{{item.publishedAt}} · {{item.source}}</view>
      </navigator>
    </view>
    <view class="card" wx:if="{{liveSheet}}"><view class="h2">赛事直播</view><view class="src">组委会上传的直播二维码，点击放大后识别。</view><view class="race-media"><button wx:if="{{liveSheet.state !== 'failed'}}" class="media-open" data-src="{{liveSheet.src}}" bindtap="previewGuide" aria-label="预览直播二维码"><image lazy-load="{{true}}" class="sheet" mode="aspectFit" src="{{liveSheet.displaySrc || liveSheet.src}}" data-kind="liveSheet" data-id="{{liveSheet.id}}" data-src="{{liveSheet.displaySrc || liveSheet.src}}" bindload="mediaLoaded" binderror="mediaError"/><text class="media-caption">直播二维码 · 点击查看原图</text></button><view wx:else class="media-error"><view>直播二维码加载失败</view><button data-kind="liveSheet" data-id="{{liveSheet.id}}" bindtap="retryMedia">重新加载</button></view></view></view>
    <view class="card" wx:if="{{alternatives.length}}">
      <view class="h2">同期还开着</view>
      <view class="src">{{alternativeNote}}</view>
      <navigator wx:for="{{alternatives}}" wx:key="id" class="row" url="/pages/race/race?id={{item.id}}">
        <text>{{item.name}}</text><text>{{item.deadlineLabel}}</text>
      </navigator>
    </view>
  </block>

  <block wx:if="{{tab === 'result'}}">
    <view class="card" wx:if="{{drawText}}">
      <view class="h2">中签卡片</view>
      <view class="poster">
        <view wx:for="{{drawLines}}" wx:key="*this">{{item}}</view>
      </view>
      <button class="btn" bindtap="copyDraw">复制卡片</button>
      <button class="ghost" bindtap="savePoster">保存图片</button>
      <view wx:if="{{drawNote}}" class="src">{{drawNote}}</view>
      <view wx:if="{{drawError}}" class="err">{{drawError}}</view>
      <canvas canvas-id="poster" class="poster-canvas" />
    </view>
    <view wx:if="{{officialResultLink}}" class="card"><view class="h2">官方成绩查询</view><button class="official-action primary" data-url="{{officialResultLink}}" data-key="result" bindtap="copyLink">复制官方成绩链接 ↗</button></view>
    <view wx:if="{{!ready}}" class="card content-empty"><view>登录后记录个人成绩</view><button class="official-text" data-id="result" bindtap="loginForResult">登录记录 ›</button></view>
    <view class="card result" wx:if="{{ready}}">
      <view class="h2">个人成绩手记</view>
      <view class="src">自己记录的成绩标为未核验，与官方成绩查询分开保存。可附证书或奖牌照片。</view>

      <view wx:for="{{myResults}}" wx:key="distance" class="sum">{{item.distanceLabel}} {{item.clock}} · 配速 {{item.pace}}<text wx:if="{{item.pb}}"> · PB</text> · {{item.verifyLabel}}</view>
      <view wx:if="{{myResult && myResult.story}}" class="src">{{myResult && myResult.story}}</view>
      <image wx:if="{{proofSrc}}" src="{{proofSrc}}" mode="widthFix" />
      <view wx:if="{{myResult && myResult.proofLabel}}" class="src">{{myResult.proofLabel}} · 未核验</view>
      <button wx:for="{{distanceOptions}}" wx:key="key" class="ghost {{distance === item.key ? 'on' : ''}}" data-distance="{{item.key}}" bindtap="pickDistance">{{item.label}}</button>
      <view class="field">
        <input placeholder="3:29:59" value="{{clock}}" bindinput="onClock" aria-label="3:29:59" />
      </view>
      <view class="field">
        <input placeholder="这场想记的一句" value="{{story}}" maxlength="200" bindinput="onStory" aria-label="这场想记的一句" />
      </view>
      <button class="btn" bindtap="saveResult">记下成绩</button>
      <button wx:if="{{myResult}}" class="ghost" data-kind="certificate" bindtap="chooseProof">证书照片</button>
      <button wx:if="{{myResult}}" class="ghost" data-kind="medal" bindtap="chooseProof">奖牌照片</button>
      <button wx:if="{{myResult && myResult.hasProof}}" class="ghost" bindtap="removeProof">去掉照片</button>
      <button wx:if="{{myResult}}" class="ghost" bindtap="removeResult">去掉这项成绩</button>
      <view wx:if="{{resultMessage}}" class="err">{{resultMessage}}</view>
    </view>
  </block>
  </view>
</view>
<view wx:else class="empty race-empty-state"><view>{{loadError || '正在加载赛事…'}}</view><button wx:if="{{loadError}}" bindtap="open">重新加载</button><navigator wx:if="{{loadError}}" open-type="switchTab" url="/pages/races/races">返回赛事列表</navigator></view>
