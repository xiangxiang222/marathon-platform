<view class="pad" wx:if="{{race}}">
  <view class="card">
    <view class="teal">{{race.regStatus}}</view>
    <view class="title">{{race.name}}</view>
    <view class="row"><text class="k">比赛日</text><text>{{race.raceDate}}</text></view>
    <view class="row"><text class="k">地点</text><text>{{race.province === race.city ? race.city : race.province + ' · ' + race.city}}{{race.district ? ' · ' + race.district : ''}}{{race.place && race.place !== race.city && race.place !== race.district ? ' · ' + race.place : ''}}</text></view>
    <view class="row"><text class="k">项目</text><text>{{distanceText}}</text></view>
    <view class="row"><text class="k">举办</text><text>{{meetText}}</text></view>
    <view wx:if="{{race.phone}}" class="row"><text class="k">咨询</text><text>{{race.phone}}</text></view>
    <view class="row"><text class="k">{{race.deadlineName}}</text><text class="{{race.open && race.daysLeft <= 3 ? 'soon' : ''}}">{{race.deadlineLabel}}</text></view>
    <view wx:if="{{race.gradeLabel}}" class="src">{{race.gradeLabel}}</view>
    <view wx:for="{{conflicts}}" wx:key="text" class="warn">{{item.text}}</view>
  </view>

  <view class="card race-plan">
    <view class="plan-heading"><view class="h2">我的参赛计划</view><text class="plan-status">{{myStatus || '未标记'}}</text></view>
    <view class="src">记录想跑、报名和中签状态，已加入的跑团可同步查看。</view>
    <button wx:if="{{!ready}}" class="plan-action" bindtap="loginForPlan"><text>登录后标记</text><text class="arrow">›</text></button>
    <button wx:else class="plan-action" bindtap="togglePlan"><text>{{myStatus ? '修改参赛状态' : '标记参赛状态'}}</text><text class="arrow">{{planOpen ? '⌃' : '›'}}</text></button>
    <view wx:if="{{ready && planOpen}}" class="plan-editor">
      <view class="plan-statuses"><button wx:for="{{statuses}}" wx:key="*this" class="ghost {{myStatus === item ? 'on' : ''}}" data-status="{{item}}" bindtap="mark">{{item}}</button></view>
      <view wx:if="{{myStatus}}" class="src">可附报名成功截图，供自己与跑团留存。</view>
      <image wx:if="{{sheetSrc}}" src="{{sheetSrc}}" mode="widthFix" />
      <button wx:if="{{myStatus}}" class="ghost" bindtap="chooseSheet">上传报名截图</button>
      <button wx:if="{{hasSheet}}" class="ghost" bindtap="removeSheet">移除截图</button>
    </view>
    <view wx:if="{{message}}" class="err">{{message}}</view>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id" class="tab {{tab === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="pickTab">{{item.label}}</view>
  </view>

  <block wx:if="{{tab === 'signup'}}">
    <view class="card" wx:if="{{race.nodes.length}}">
      <view class="timeline">
        <view wx:for="{{race.nodes}}" wx:key="key" class="tl">
          <view class="dot"></view>
          <text class="tl-at">{{item.at}}</text>
          <text class="tl-label">{{item.label}}</text>
        </view>
      </view>
      <view wx:for="{{race.nodes}}" wx:key="key" wx:if="{{item.text}}" class="src">{{item.label}} {{item.text}}</view>
    </view>
    <view class="card" wx:if="{{race.fee || race.scale || race.startAt || race.kindLabels.length || race.groups.length}}">
      <view class="h2">项目</view>
      <view wx:if="{{race.startAt}}" class="row"><text class="k">起跑</text><text>{{race.startAt}}</text></view>
      <view wx:if="{{race.fee}}" class="row"><text class="k">报名费</text><text>{{race.fee}}</text></view>
      <view wx:if="{{race.scale}}" class="row"><text class="k">规模</text><text>{{race.scale}}</text></view>
      <view wx:if="{{race.kindLabels.length}}" class="src">{{kindText}}</view>
      <view wx:if="{{race.groups.length}}" class="src">{{groupText}}</view>
    </view>
    <view class="card" wx:if="{{drawRates.length}}">
      <view class="h2">历年中签</view>
      <view class="src">按公布的报名人数和名额计算。</view>
      <view wx:for="{{drawRates}}" wx:key="id">
        <view class="src">{{item.label}} · 报名 {{item.applicants}} · 名额 {{item.quota}} · {{item.rateText}}</view>
        <view class="src">来源 {{item.source}}</view>
      </view>
    </view>
    <view class="card">
      <view class="h2">官方报名信息</view>
      <view class="src">{{signupHint}}</view>
      <image wx:if="{{signupQr}}" class="qr" src="{{signupQr}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
      <button wx:if="{{signupQr}}" class="btn" data-url="{{signupUrl}}" data-key="signup" bindtap="copyLink">复制报名链接</button>
      <view wx:if="{{askSignup}}">
        <view class="src">报上了吗</view>
        <button class="btn" bindtap="confirmSigned">报上了</button>
        <button class="ghost" bindtap="dismissAsk">还没有</button>
      </view>
      <view class="src">报名和缴费请以组委会官方页面为准。</view>
    </view>
    <view wx:if="{{cards.length || card}}" class="card">
      <button class="plan-action" bindtap="toggleShare"><text>跑团赛事卡片</text><text class="arrow">{{shareOpen ? '⌃' : '›'}}</text></button>
    </view>
    <block wx:if="{{shareOpen}}">
    <view class="card" wx:for="{{cards}}" wx:key="clubId">
      <view class="h2">发到微信群 · {{item.club.name}}</view>
      <view class="title">{{item.title}}</view>
      <view class="sum">{{item.summary}}</view>
      <view wx:if="{{item.unpaid.length}}" class="src">还没缴：{{item.unpaidText}}</view>
      <button class="btn share" open-type="share" data-title="{{item.title}}" data-code="{{item.club.code}}" bindtap="armShare">发到微信群</button>
    </view>
    <view wx:if="{{card && !cards.length}}" class="card">
      <view class="h2">{{card.club.name}}</view>
      <view class="title">{{card.title}}</view>
      <view class="sum">{{card.summary}}</view>
      <view wx:if="{{card.unpaid.length}}" class="src">还没缴：{{card.unpaidText}}</view>
      <button class="btn share" open-type="share" data-title="{{card.title}}" data-code="{{card.club.code}}" bindtap="armShare">发到微信群</button>
    </view>
    </block>
    <view wx:for="{{clubs}}" wx:key="id" class="card">
      <view class="h2">{{item.name}}</view>
      <view wx:if="{{item.squadText}}" class="warn">{{item.squadText}}</view>
      <view wx:if="{{!item.mates.length}}" class="muted">团里还没人标这场</view>
      <view wx:for="{{item.mates}}" wx:for-item="mate" wx:key="nickname" class="row">
        <text>{{mate.nickname}}</text><text>{{mate.status}}</text>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'guide'}}">
    <view class="card">
      <view class="h2">竞赛规程</view>
      <view wx:if="{{guideBlocks.length}}" class="src">按标题阅读。奖金、关门时间和参赛资格以组委会原文为准。</view>
      <view wx:for="{{guideBlocks}}" wx:key="i" class="md md-{{item.kind}}">
        <text wx:if="{{item.mark}}" class="md-mark">{{item.mark}}</text>
        <text wx:for="{{item.runs}}" wx:for-item="run" wx:key="j" class="{{run.strong ? 'md-strong' : ''}}">{{run.text}}</text>
      </view>
      <view wx:if="{{guide.length}}" class="h2 page-title">原页</view>
      <view wx:if="{{guide.length && guideBlocks.length}}" class="src">正文在上面。原页留着对照。</view>
      <view wx:if="{{guide.length && !guideBlocks.length}}" class="src">正文还没整理，下面是组委会公布的原页。</view>
      <image wx:for="{{guide}}" wx:key="id" class="sheet" mode="widthFix" src="{{item.src}}" data-src="{{item.src}}" bindtap="previewGuide" />
    </view>
  </block>

  <block wx:if="{{tab === 'news'}}">
    <view class="card" wx:if="{{articles.length}}">
      <view class="h2">相关资讯</view>
      <navigator wx:for="{{articles}}" wx:key="id" class="news-item" url="/pages/news/detail?id={{item.id}}">
        <view class="title">{{item.title}}</view>
        <view class="src">{{item.publishedAt}} · {{item.source}}</view>
      </navigator>
    </view>
    <view class="card" wx:if="{{race.organizer || race.source || race.eventUrl || race.officialUrl || queryLinks.length}}">
      <view class="h2">这场的页面</view>
      <view wx:if="{{race.organizer}}" class="src">主办 {{race.organizer}}</view>
      <view wx:if="{{race.source}}" class="src">来源 {{race.source}}<text wx:if="{{race.updatedAt}}"> · 更新于 {{race.updatedAt}}</text></view>
      <view wx:if="{{race.eventUrl}}" class="src">赛事网站 {{race.eventUrl}}</view>
      <view wx:if="{{race.officialUrl}}" class="src">官网这场 {{race.officialUrl}}</view>
      <button wx:for="{{queryLinks}}" wx:key="key" class="btn" data-url="{{item.url}}" data-key="{{item.key}}" bindtap="copyLink">{{item.label}}</button>
    </view>
    <view class="card" wx:if="{{race.route || routeSheets.length || race.pickup || race.pacers || pacerSheets.length}}">
      <view class="h2">比赛日</view>
      <view wx:if="{{race.route}}" class="src">路线 {{race.route}}</view>
      <image wx:for="{{routeSheets}}" wx:key="id" class="sheet" mode="widthFix" src="{{item.src}}" data-src="{{item.src}}" bindtap="previewGuide" />
      <view wx:if="{{race.pickup}}" class="src">领物 {{race.pickup}}</view>
      <view wx:if="{{race.pacers}}" class="src">配速员 {{race.pacers}}</view>
      <image wx:for="{{pacerSheets}}" wx:key="id" class="sheet" mode="widthFix" src="{{item.src}}" data-src="{{item.src}}" bindtap="previewGuide" />
    </view>
    <view class="card" wx:if="{{liveSheet}}">
      <view class="h2">直播</view>
      <view class="src">扫组委会的二维码。</view>
      <image class="sheet" mode="widthFix" src="{{liveSheet.src}}" data-src="{{liveSheet.src}}" bindtap="previewGuide" />
    </view>
    <view class="card" wx:if="{{alternatives.length}}">
      <view class="h2">同期还开着</view>
      <view class="src">{{alternativeNote}}</view>
      <navigator wx:for="{{alternatives}}" wx:key="id" class="row" url="/pages/race/race?id={{item.id}}">
        <text>{{item.name}}</text><text>{{item.deadlineLabel}}</text>
      </navigator>
    </view>
  </block>

  <block wx:if="{{tab === 'result'}}">
    <view class="card" wx:if="{{drawText}}">
      <view class="h2">中签卡片</view>
      <view class="poster">
        <view wx:for="{{drawLines}}" wx:key="*this">{{item}}</view>
      </view>
      <button class="btn" bindtap="copyDraw">复制卡片</button>
      <button class="ghost" bindtap="savePoster">保存图片</button>
      <view wx:if="{{drawNote}}" class="src">{{drawNote}}</view>
      <view wx:if="{{drawError}}" class="err">{{drawError}}</view>
      <canvas canvas-id="poster" class="poster-canvas" />
    </view>
    <view class="card result" wx:if="{{ready}}">
      <view class="h2">成绩</view>
      <view class="src">手记的成绩标为未核验。可以附一张证书或奖牌照片。</view>

      <view wx:for="{{myResults}}" wx:key="distance" class="sum">{{item.distanceLabel}} {{item.clock}} · 配速 {{item.pace}}<text wx:if="{{item.pb}}"> · PB</text> · {{item.verifyLabel}}</view>
      <view wx:if="{{myResult.story}}" class="src">{{myResult.story}}</view>
      <image wx:if="{{proofSrc}}" src="{{proofSrc}}" mode="widthFix" />
      <view wx:if="{{myResult.proofLabel}}" class="src">{{myResult.proofLabel}} · 未核验</view>
      <button wx:for="{{distanceOptions}}" wx:key="key" class="ghost {{distance === item.key ? 'on' : ''}}" data-distance="{{item.key}}" bindtap="pickDistance">{{item.label}}</button>
      <view class="field">
        <input placeholder="3:29:59" value="{{clock}}" bindinput="onClock" />
      </view>
      <view class="field">
        <input placeholder="这场想记的一句" value="{{story}}" maxlength="200" bindinput="onStory" />
      </view>
      <button class="btn" bindtap="saveResult">记下成绩</button>
      <button wx:if="{{myResult}}" class="ghost" data-kind="certificate" bindtap="chooseProof">证书照片</button>
      <button wx:if="{{myResult}}" class="ghost" data-kind="medal" bindtap="chooseProof">奖牌照片</button>
      <button wx:if="{{myResult.hasProof}}" class="ghost" bindtap="removeProof">去掉照片</button>
      <button wx:if="{{myResult}}" class="ghost" bindtap="removeResult">去掉这项成绩</button>
      <view wx:if="{{resultMessage}}" class="err">{{resultMessage}}</view>
    </view>
  </block>
</view>
<view wx:else class="empty">{{message || '正在打开这场'}}</view>
