.person-tab-empty{margin-top:24rpx;padding:54rpx 26rpx;border-radius:28rpx;background:#fff;text-align:center;font-size:12px;line-height:1.9;color:#a7b3aa}.person-tab-empty .mp-section-title{margin:20rpx 0 14rpx}.person-empty-symbol{color:#bfd5c5;font-size:30px}.person-album-card{padding:26rpx;background:#fff;border-radius:26rpx;margin-top:20rpx}.person-album-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx}.person-album-heading>view{flex:1;min-width:0}.person-album-title{font-size:14px;font-weight:600;line-height:1.6;overflow-wrap:anywhere}.person-album-meta{margin-top:8rpx;color:#a5b0a8;font-size:10px;line-height:1.7}.mp-page .person-album-link{font-size:11px;color:#8da795;flex:none}.person-album-grid{display:flex;flex-wrap:wrap;gap:12rpx}.person-album-photo,.person-album-video{display:block;width:calc(50% - 6rpx);height:220rpx;border-radius:16rpx;background:#f0f3f0}

/* A private poster studio, opened only from the current runner account. */
.achievement-poster-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;box-sizing:border-box;margin:0 0 24rpx;padding:26rpx 28rpx;border:1rpx solid #eee4cf;border-radius:28rpx;background:linear-gradient(110deg,#fff7e7,#fffdfa);color:#8d6f40;text-align:left;line-height:1.6}.achievement-poster-entry::after{border:0}.achievement-poster-entry>view{flex:1;min-width:0}.achievement-poster-entry>view>view{font-size:14px;font-weight:600;color:#65563e}.achievement-poster-entry>view>text{display:block;margin-top:6rpx;font-size:11px;font-weight:400;color:#a99a80}.achievement-poster-entry>text{flex:none;font-size:12px;font-weight:500;white-space:nowrap}
