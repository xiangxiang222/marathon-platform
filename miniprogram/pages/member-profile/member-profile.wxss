@import "../../utils/mileage-pages.wxss";
.member-profile{color:var(--text)}.person-hero{padding:30rpx;border-radius:30rpx;background:var(--card,#fff)}.person-hero-top{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.person-hero .mp-eyebrow{color:var(--text-secondary);font-size:12px}.person-role{padding:8rpx 16rpx;border:1rpx solid var(--border);border-radius:10rpx;font-size:12px;color:var(--text-secondary)}.person-identity{display:flex;align-items:center;gap:24rpx;margin-top:28rpx}.person-avatar{flex:none;width:116rpx;height:116rpx;border-radius:50%;border:6rpx solid var(--border)}.person-fallback{display:flex;align-items:center;justify-content:center;background:var(--field-bg,var(--page-bg));color:var(--text-secondary);font-size:24px;font-weight:600}.person-main{flex:1;min-width:0}.person-name{font-size:22px;font-weight:600;overflow-wrap:anywhere;letter-spacing:normal}.person-group{margin-top:10rpx;color:var(--text-secondary);font-size:12px;line-height:1.6;overflow-wrap:anywhere}.person-joined{margin-top:8rpx;color:var(--text-secondary);font-size:12px}.person-hero-metrics{display:flex;margin-top:30rpx;padding-top:28rpx;border-top:1rpx solid var(--border)}.person-hero-metrics>view{display:flex;flex:1;min-width:0;flex-direction:column;gap:10rpx}.person-hero-metrics>view>text:first-child{font-size:24px;font-weight:600;letter-spacing:normal;font-variant-numeric:tabular-nums}.person-hero-metrics>view>text:last-child{color:var(--text-secondary);font-size:12px}
.person-tabs{display:flex;position:sticky;top:0;z-index:5;margin:16rpx -2rpx 0;padding:0 4rpx;background:var(--field-bg,var(--page-bg));border-bottom:1rpx solid var(--border)}.mp-page .person-tab{position:relative;display:flex;align-items:center;justify-content:center;flex:1;height:56px;color:var(--text-secondary);font-size:14px}.mp-page .person-tab.tab-selected{color:var(--text);font-weight:600}.person-tab-line{position:absolute;bottom:0;width:28rpx;height:5rpx;border-radius:3rpx;background:var(--field-bg,var(--page-bg))}.person-section-kicker{margin:36rpx 2rpx 10rpx;font-size:12px;color:var(--text-secondary);letter-spacing:normal}.person-section-intro{font-size:22px;font-weight:600;letter-spacing:normal}.person-section-intro>text{color:var(--text-secondary)}.person-section-caption{margin-top:8rpx;color:var(--text-secondary);font-size:12px;line-height:1.7}
.person-intro{margin-top:24rpx}.person-intro .mp-section-head{margin:0 0 10rpx}.person-introduction{font-size:14px;line-height:1.9;color:var(--text-secondary);white-space:pre-wrap;overflow-wrap:anywhere}.intro-empty{color:var(--text-secondary);font-size:12px}.person-edit-count{padding-top:10rpx;color:var(--text-secondary);font-size:12px;text-align:right}.person-edit-actions{display:flex;gap:16rpx;margin-top:16rpx}.person-edit-actions>button{flex:1}.person-edit-actions .mp-primary{margin-top:0}.mp-page .person-group-card{width:100%;display:flex;align-items:center;gap:22rpx;padding:26rpx;margin-top:18rpx;border-radius:24rpx;background:var(--card,#fff);text-align:left}.person-group-icon{display:flex;align-items:center;justify-content:center;flex:none;width:76rpx;height:76rpx;border-radius:20rpx;background:var(--field-bg,var(--page-bg));color:var(--text-secondary);font-size:20px;font-weight:600}.person-group-copy{flex:1;min-width:0}.person-group-copy>view:first-child{font-size:14px;font-weight:600}.person-group-copy>view:last-child{margin-top:10rpx;font-size:12px;color:var(--text-secondary);line-height:1.7;overflow-wrap:anywhere}.person-group-card>text{color:var(--text-secondary);font-size:24px}
.person-mini-stats{display:flex;gap:18rpx}.person-mini-stat{flex:1;min-width:0;padding:26rpx 24rpx;border-radius:24rpx}.person-mini-label{font-size:12px;opacity:.8}.person-mini-stat>view{font-size:28px;font-weight:600;letter-spacing:normal;margin-top:24rpx;font-variant-numeric:tabular-nums}.person-mini-stat>view>text{font-size:12px;font-weight:400;letter-spacing:normal}.person-mini-note{display:block;margin-top:12rpx;font-size:12px;opacity:.65;line-height:1.7}.person-next-race{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:var(--card,#fff)}.person-next-kicker{display:flex;justify-content:space-between;font-size:12px;color:var(--text-secondary)}.person-next-title{margin-top:20rpx;font-size:18px;font-weight:600;color:var(--text-secondary);line-height:1.6}.person-next-meta{margin-top:12rpx;font-size:12px;color:var(--text-secondary)}
.person-pb-preview,.person-pb-grid{display:flex;flex-wrap:wrap;gap:18rpx}.person-pb-tile{width:calc(50% - 9rpx);padding:26rpx 24rpx;border-radius:24rpx;background:var(--card,#fff)}.person-pb-top{display:flex;align-items:center;justify-content:space-between;gap:8rpx;color:var(--text-secondary);font-size:12px}.person-pb-top>text:last-child{font-size:12px;letter-spacing:normal;color:var(--text-secondary)}.person-pb-clock{margin-top:24rpx;font-size:24px;letter-spacing:normal;font-weight:600;color:var(--text-secondary);font-variant-numeric:tabular-nums}.person-pb-name{margin-top:16rpx;font-size:12px;color:var(--text-secondary);line-height:1.7;overflow-wrap:anywhere}.person-pb-date{margin-top:6rpx;color:var(--text-secondary);font-size:12px}.person-pb-tag{color:var(--text-secondary);font-size:12px;letter-spacing:normal}.person-photo-strip{display:flex;gap:12rpx}.person-photo-strip image{width:calc((100% - 24rpx) / 3);height:160rpx;border-radius:18rpx;background:var(--field-bg,var(--page-bg))}
.person-ranges{display:flex;gap:6rpx;padding:8rpx;border-radius:20rpx;background:var(--field-bg,var(--page-bg))}.mp-page .person-range{display:flex;align-items:center;justify-content:center;flex:1;min-height:42px;border-radius:14rpx;font-size:14px;color:var(--text-secondary)}.mp-page .person-range.range-selected{background:var(--card,#fff);color:var(--text);font-weight:600;box-shadow:none}.person-period-control{display:flex;justify-content:center;align-items:center}.person-period-control picker{flex:1;min-width:0}.mp-page .person-period-arrow{flex:none;width:44px;font-size:24px;color:var(--text-secondary)}.person-period{min-height:56px;display:flex;align-items:center;justify-content:center;gap:10rpx;color:var(--text-secondary);font-size:12px}.person-loading{font-size:12px;text-align:center;color:var(--text-secondary);margin:0 0 16rpx}.person-stats{padding:30rpx}.person-distance-label{font-size:12px;color:var(--text-secondary)}.person-distance{color:var(--text-secondary);display:flex;align-items:baseline;gap:10rpx;margin-top:20rpx}.person-distance>text:first-child{font-size:40px;font-weight:600;letter-spacing:normal;font-variant-numeric:tabular-nums}.person-distance-unit{font-size:12px;color:var(--text-secondary)}.person-stat-grid{display:flex;padding-top:28rpx}.person-stat-grid>view{flex:1;display:flex;flex-direction:column;gap:10rpx}.person-stat-grid>view>text:first-child{font-size:22px;color:var(--text);font-weight:600}.person-stat-grid>view>text:last-child{font-size:12px;color:var(--text-secondary)}.person-pace{display:flex;justify-content:space-between;border-top:1rpx solid var(--border);margin-top:28rpx;padding-top:24rpx;font-size:12px;color:var(--text-secondary)}.person-pace>text:last-child{color:var(--text-secondary);font-size:14px}
.person-runs{padding:6rpx 28rpx}.person-run{display:flex;align-items:center;gap:22rpx;padding:28rpx 0;border-bottom:1rpx solid var(--border)}.person-run:last-child{border-bottom:0}.person-run-date{display:flex;flex:none;flex-direction:column;gap:10rpx;width:72rpx}.person-run-date>text:first-child{font-size:14px;font-weight:600;color:var(--text-secondary)}.person-run-date>text:last-child{font-size:12px;color:var(--text-secondary)}.person-run-info{flex:1;min-width:0}.person-run-info>view:first-child{display:flex;justify-content:space-between;font-size:14px;color:var(--text-secondary)}.person-run-info>view:first-child>text{color:var(--text);font-size:22px;font-weight:600}.person-run-info>view:first-child>text>text{color:var(--text-secondary);font-size:12px;font-weight:400}.person-run-meta{display:flex;justify-content:space-between;gap:12rpx;margin-top:10rpx;color:var(--text-secondary);font-size:12px}.person-run-extra{margin-top:10rpx;font-size:12px;color:var(--text-secondary)}
.person-race-filters{display:flex;gap:12rpx;margin-bottom:24rpx}.mp-page .person-race-filter{display:flex;justify-content:center;align-items:center;flex:1;min-width:0;min-height:40px;border-radius:16rpx;color:var(--text-secondary);font-size:12px;background:var(--field-bg,var(--page-bg))}.mp-page .person-race-filter.filter-selected{color:var(--text-secondary);background:var(--field-bg,var(--page-bg));font-weight:600}.mp-page .person-race-card{width:100%;display:flex;gap:24rpx;padding:28rpx;margin-top:18rpx;border-radius:26rpx;background:var(--card,#fff);text-align:left}.person-race-date{display:flex;flex:none;align-items:center;justify-content:center;flex-direction:column;gap:12rpx;width:110rpx;height:132rpx;border-radius:18rpx}.person-race-date>text:first-child{font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}.person-race-date>text:last-child{font-size:12px;opacity:.6;letter-spacing:normal}.person-race-info{flex:1;min-width:0}.person-race-card-top{display:flex;justify-content:space-between;align-items:center}.person-status{font-size:12px;padding:6rpx 12rpx;border-radius:8rpx}.person-race-arrow{color:var(--text-secondary);font-size:16px}.person-race-name{font-size:14px;font-weight:600;margin-top:14rpx;line-height:1.6;overflow-wrap:anywhere}.person-race-location{font-size:12px;color:var(--text-secondary);margin-top:10rpx;line-height:1.6}
.mp-page .person-result-card{display:block;width:100%;padding:28rpx;border-radius:26rpx;background:var(--card,#fff);text-align:left;margin-top:18rpx}.person-result-top,.person-result-bottom{display:flex;justify-content:space-between;gap:16rpx;font-size:12px;color:var(--text-secondary)}.person-result-top>text:first-child{color:var(--text-secondary)}.person-result-main{display:flex;align-items:center;gap:16rpx;margin-top:24rpx}.person-result-main>text:first-child{font-size:31px;font-weight:600;letter-spacing:normal;color:var(--text);font-variant-numeric:tabular-nums}.person-result-pb{padding:6rpx 12rpx;border-radius:8rpx;background:var(--field-bg,var(--page-bg));color:var(--text-secondary);font-size:12px}.person-result-name{font-size:14px;color:var(--text-secondary);margin-top:18rpx;line-height:1.6}.person-result-bottom{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--border)}
.person-tab-empty{margin-top:24rpx;padding:54rpx 26rpx;border-radius:28rpx;background:var(--card,#fff);text-align:center;font-size:12px;line-height:1.9;color:var(--text-secondary)}.person-tab-empty .mp-section-title{margin:20rpx 0 14rpx}.person-empty-symbol{color:var(--text-secondary);font-size:30px}.person-album-card{padding:26rpx;background:var(--card,#fff);border-radius:26rpx;margin-top:20rpx}.person-album-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx}.person-album-heading>view{flex:1;min-width:0}.person-album-title{font-size:14px;font-weight:600;line-height:1.6;overflow-wrap:anywhere}.person-album-meta{margin-top:8rpx;color:var(--text-secondary);font-size:12px;line-height:1.7}.mp-page .person-album-link{font-size:12px;color:var(--text-secondary);flex:none}.person-album-grid{display:flex;flex-wrap:wrap;gap:12rpx}.person-album-photo,.person-album-video{display:block;width:calc(50% - 6rpx);height:220rpx;border-radius:16rpx;background:var(--field-bg,var(--page-bg))}

/* A private poster studio, opened only from the current runner account. */
.achievement-poster-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;box-sizing:border-box;margin:0 0 24rpx;padding:26rpx 28rpx;border:1rpx solid var(--border);border-radius:28rpx;background:var(--card,#fff);color:var(--text-secondary);text-align:left;line-height:1.6}.achievement-poster-entry::after{border:0}.achievement-poster-entry>view{flex:1;min-width:0}.achievement-poster-entry>view>view{font-size:14px;font-weight:600;color:var(--text)}.achievement-poster-entry>view>text{display:block;margin-top:6rpx;font-size:12px;font-weight:400;color:var(--text-secondary)}.achievement-poster-entry>text{flex:none;font-size:12px;font-weight:500;white-space:nowrap}

.member-profile { color:var(--text); font-size:14px; }
.person-hero,.person-volume,.person-runs,.person-race-card,.person-result-card,.person-album-card,.person-tab-empty { border:1rpx solid var(--border); border-radius:24rpx; background:var(--card,#fff); color:var(--text); }
.person-name { color:var(--text); font-size:22px; font-weight:600; letter-spacing:normal; }
.person-fallback { background:var(--brand-soft); color:var(--brand); font-size:24px; }
.person-group,.person-joined,.person-role { color:var(--text-secondary); font-size:12px; }
.person-hero-metrics { border-color:var(--border); }
.person-hero-metrics>view>text:first-child { color:var(--text); font-size:24px; font-weight:600; }
.person-hero-metrics>view>text:last-child { color:var(--text-secondary); font-size:12px; }
.person-volume-number { color:var(--text); font-size:40px; font-weight:600; letter-spacing:normal; }
.person-stat-grid>view>text:first-child { font-size:20px; font-weight:600; color:var(--text); }
.person-stat-grid>view>text:last-child,.person-run-date>text:last-child,.person-run-meta,.person-run-extra { color:var(--text-secondary); font-size:12px; }
.mp-page .person-race-filter { min-height:44px; border-radius:20rpx; color:var(--text-secondary); background:var(--card,#fff); border:1rpx solid var(--border); font-size:14px; font-weight:400; }
.mp-page .person-race-filter.filter-selected { color:var(--brand); background:var(--brand-soft); border-color:var(--brand); font-weight:500; }
.person-race-name { color:var(--text); font-size:16px; font-weight:500; }
.person-result-main>text:first-child { color:var(--text); font-size:28px; font-weight:600; letter-spacing:normal; }
.person-result-name,.person-album-title { color:var(--text); font-size:14px; font-weight:500; }
.person-status,.person-race-location,.person-result-top,.person-result-bottom,.person-result-pb,.person-album-meta { font-size:12px; color:var(--text-secondary); }
.person-result-pb { background:var(--brand-soft); color:var(--brand); }
.achievement-poster-entry { padding:28rpx; border:1rpx solid var(--border); border-radius:24rpx; background:var(--card,#fff); color:var(--brand); }
.achievement-poster-entry>view>view { color:var(--text); font-size:14px; font-weight:500; }
.achievement-poster-entry>view>text { color:var(--text-secondary); font-size:12px; }
.person-tabs { background:var(--card,#fff); border-color:var(--border); }
.mp-page .person-tab { height:48px; min-height:44px; font-size:14px; font-weight:400; }
.mp-page .person-tab.tab-selected { color:var(--brand); font-weight:500; }
.person-tab-line { height:2px; border-radius:0; background:var(--brand); }
.person-section-intro { color:var(--text); font-size:18px; font-weight:600; letter-spacing:normal; }
.person-ranges { padding:0; border-radius:0; border-bottom:1rpx solid var(--border); background:transparent; }
.mp-page .person-range { min-height:44px; border-radius:0; font-size:14px; font-weight:400; }
.mp-page .person-range.range-selected { color:var(--brand); background:transparent; box-shadow:inset 0 -2px var(--brand); font-weight:500; }
.person-distance>text:first-child { color:var(--text); font-size:40px; font-weight:600; letter-spacing:normal; }
.person-distance-unit { font-size:14px; color:var(--text-secondary); }
.person-tabs .person-tab,.person-ranges .person-range,.person-period-control .person-period-arrow { min-height:44px; }
