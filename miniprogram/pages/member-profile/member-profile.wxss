.person-runs{padding:6rpx 28rpx}.person-run{display:flex;align-items:center;gap:22rpx;padding:28rpx 0;border-bottom:1rpx solid #f1f4f1}.person-run:last-child{border-bottom:0}.person-run-date{display:flex;flex:none;flex-direction:column;gap:10rpx;width:72rpx}.person-run-date>text:first-child{font-size:14px;font-weight:600;color:#627e6c}.person-run-date>text:last-child{font-size:10px;color:#a8b1aa}.person-run-info{flex:1;min-width:0}.person-run-info>view:first-child{display:flex;justify-content:space-between;font-size:13px;color:#6f7c72}.person-run-info>view:first-child>text{color:#405d48;font-size:22px;font-weight:650}.person-run-info>view:first-child>text>text{color:#a2aca3;font-size:10px;font-weight:400}.person-run-meta{display:flex;justify-content:space-between;gap:12rpx;margin-top:10rpx;color:#a3ada5;font-size:10px}.person-run-extra{margin-top:10rpx;font-size:9px;color:#b2bcb5}
.person-race-filters{display:flex;gap:12rpx;margin-bottom:24rpx}.mp-page .person-race-filter{display:flex;justify-content:center;align-items:center;flex:1;min-width:0;min-height:40px;border-radius:16rpx;color:#9ca79f;font-size:12px;background:#edf0ed}.mp-page .person-race-filter.filter-selected{color:#508168;background:#e5f2e9;font-weight:650}.mp-page .person-race-card{width:100%;display:flex;gap:24rpx;padding:28rpx;margin-top:18rpx;border-radius:26rpx;background:#fff;text-align:left}.person-race-date{display:flex;flex:none;align-items:center;justify-content:center;flex-direction:column;gap:12rpx;width:110rpx;height:132rpx;border-radius:18rpx}.person-race-date>text:first-child{font-size:18px;font-weight:650;font-variant-numeric:tabular-nums}.person-race-date>text:last-child{font-size:10px;opacity:.6;letter-spacing:2rpx}.person-race-info{flex:1;min-width:0}.person-race-card-top{display:flex;justify-content:space-between;align-items:center}.person-status{font-size:9px;padding:6rpx 12rpx;border-radius:8rpx}.person-race-arrow{color:#b2beb5;font-size:16px}.person-race-name{font-size:15px;font-weight:600;margin-top:14rpx;line-height:1.6;overflow-wrap:anywhere}.person-race-location{font-size:10px;color:#a6b0a8;margin-top:10rpx;line-height:1.6}
