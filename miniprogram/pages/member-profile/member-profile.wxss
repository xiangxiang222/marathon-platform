@import "../../utils/mileage-pages.wxss";
.person-hero { padding:32rpx; border-radius:30rpx; background:linear-gradient(120deg,#eaf4ff,#f2f9ff 60%,#eaf8f0); }
.person-hero .mp-eyebrow { color:#91aab8; }.person-identity { display:flex; align-items:center; gap:24rpx; margin-top:28rpx; }.person-avatar { flex:none; width:124rpx; height:124rpx; border-radius:50%; border:6rpx solid #fff; box-sizing:border-box; }.person-fallback { display:flex; align-items:center; justify-content:center; background:#e0ecf6; color:#658fa9; font-size:28px; font-weight:600; }.person-main { flex:1; min-width:0; }.person-name { font-size:23px; font-weight:700; overflow-wrap:anywhere; letter-spacing:-.6rpx; }.person-group { margin-top:10rpx; color:#6f8c94; font-size:11px; line-height:1.6; overflow-wrap:anywhere; }.person-joined { margin-top:8rpx; color:#9aaeb5; font-size:10px; }
.person-total { display:flex; justify-content:space-between; align-items:center; border-top:1rpx solid rgba(125,161,172,.15); padding-top:26rpx; margin-top:30rpx; }.person-total-label { color:#7e9d9e; font-size:11px; }.person-total-value { margin-top:10rpx; font-size:34px; font-weight:700; letter-spacing:-1rpx; font-variant-numeric:tabular-nums; }.person-total-value>text { color:#8ea3a5; font-size:12px; font-weight:400; }.person-total-note { font-size:11px; line-height:1.9; color:#9db4ac; text-align:right; letter-spacing:3rpx; }
.person-intro { margin-top:22rpx; }.person-intro .mp-section-head { margin-top:0; margin-bottom:10rpx; }.person-introduction { font-size:13px; line-height:1.9; color:#67766e; white-space:pre-wrap; overflow-wrap:anywhere; }.intro-empty { color:#a3ada7; font-size:12px; }.person-edit-count { padding-top:10rpx; color:#a1aca5; font-size:10px; text-align:right; }.person-edit-actions { display:flex; gap:16rpx; margin-top:16rpx; }.person-edit-actions>button { flex:1; }.person-edit-actions .mp-primary { margin-top:0; }
.person-ranges { display:flex; gap:6rpx; padding:8rpx; border-radius:20rpx; background:#e9edf0; }.mp-page .person-range { flex:1; min-height:42px; border-radius:14rpx; font-size:14px; color:#89938d; }.mp-page .person-range.range-selected { background:#fff; color:#2e3c34; font-weight:650; box-shadow:0 3rpx 10rpx rgba(60,80,68,.05); }.person-period { min-height:56px; display:flex; align-items:center; justify-content:center; gap:10rpx; color:#929e96; font-size:12px; }
.person-stats { padding:30rpx; }.person-distance { color:#d8794d; display:flex; align-items:baseline; gap:10rpx; }.person-distance>text:first-child { font-size:43px; font-weight:700; letter-spacing:-2rpx; font-variant-numeric:tabular-nums; }.person-distance-unit { font-size:12px; color:#b2a69a; }.person-stat-grid { display:flex; padding-top:28rpx; }.person-stat-grid>view { flex:1; display:flex; flex-direction:column; gap:10rpx; }.person-stat-grid>view>text:first-child { font-size:22px; color:#46544a; font-weight:600; }.person-stat-grid>view>text:last-child { font-size:10px; color:#9da79e; }.person-pace { display:flex; justify-content:space-between; border-top:1rpx solid #f0f3f0; margin-top:28rpx; padding-top:24rpx; font-size:12px; color:#9ba69d; }.person-pace>text:last-child { color:#708777; font-size:15px; }
.person-runs { padding:6rpx 28rpx; }.person-run { display:flex; align-items:center; gap:22rpx; padding:28rpx 0; border-bottom:1rpx solid #f1f4f1; }.person-run:last-child { border-bottom:0; }.person-run-date { display:flex; flex:none; flex-direction:column; gap:10rpx; width:72rpx; }.person-run-date>text:first-child { font-size:14px; font-weight:600; color:#627e6c; }.person-run-date>text:last-child { font-size:10px; color:#a8b1aa; }.person-run-info { flex:1; min-width:0; }.person-run-info>view:first-child { display:flex; justify-content:space-between; font-size:13px; color:#6f7c72; }.person-run-info>view:first-child>text { color:#405d48; font-size:22px; font-weight:650; }.person-run-info>view:first-child>text>text { color:#a2aca3; font-size:10px; font-weight:400; }.person-run-meta { display:flex; justify-content:space-between; gap:12rpx; margin-top:10rpx; color:#a3ada5; font-size:10px; }
