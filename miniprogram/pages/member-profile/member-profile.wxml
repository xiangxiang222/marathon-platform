<view class="member-profile mp-page"><view wx:if="{{loading && !profile}}" class="mp-empty">正在打开团友主页…</view><view wx:if="{{message}}" class="mp-error">{{message}}<button class="mp-text-action" bindtap="load">重试</button></view><block wx:if="{{profile}}">
  <view class="person-hero"><view class="mp-eyebrow">RUNNER IN OUR CLUB</view><view class="person-identity"><image wx:if="{{profile.user.avatar}}" class="person-avatar" src="{{profile.user.avatar}}" mode="aspectFill" /><view wx:else class="person-avatar person-fallback">{{profile.initial}}</view><view class="person-main"><view class="person-name">{{profile.user.nickname}}</view><view class="person-group">{{profile.user.groupName || '未分组'}}<text wx:if="{{profile.group && profile.group.pace}}"> · {{profile.group.pace}}</text></view><view class="person-joined">{{profile.joinedLabel}} 加入跑团</view></view></view><view class="person-total"><view><text class="person-total-label">在本团跑过</text><view class="person-total-value">{{profile.allKm}}<text> km</text></view></view><view class="person-total-note">每一步 · 都留下热爱</view></view></view>
  <view class="mp-card person-intro"><view class="mp-section-head"><view class="mp-section-title">关于{{profile.mine ? '我' : '这位团友'}}</view><button wx:if="{{profile.mine && !editing}}" class="mp-text-action" bindtap="editIntroduction">编辑 ↗</button></view><view wx:if="{{!editing}}" class="person-introduction {{!profile.user.introduction ? 'intro-empty' : ''}}">{{profile.user.introduction || (profile.mine ? '写下你的跑步故事，让团友更了解你。' : '这位团友还没有填写介绍，先从一起跑步认识吧。')}}</view><block wx:else><textarea class="mp-textarea" maxlength="300" value="{{introduction}}" bindinput="inputIntroduction" placeholder="平时在哪里跑，喜欢怎样的训练，下一场想跑什么…" aria-label="个人介绍" /><view class="person-edit-count">{{introduction.length}} / 300</view><view wx:if="{{editMessage}}" class="mp-error">{{editMessage}}</view><view class="person-edit-actions"><button class="mp-secondary" disabled="{{saving}}" bindtap="cancelEdit">取消</button><button class="mp-primary" disabled="{{saving}}" loading="{{saving}}" bindtap="saveIntroduction">保存介绍</button></view></block></view>
  <view class="mp-section-head"><view class="mp-section-title">跑量档案</view><text class="mp-small-note">计入当前跑团</text></view><view class="person-ranges"><button wx:for="{{ranges}}" wx:key="id" class="person-range {{range === item.id ? 'range-selected' : ''}}" data-range="{{item.id}}" disabled="{{saving}}" bindtap="pickRange">{{item.name}}</button></view><picker wx:if="{{range !== 'all'}}" mode="date" value="{{date}}" end="{{today}}" disabled="{{saving}}" bindchange="pickDate"><view class="person-period">{{profile.period.label}} <text>⌄</text></view></picker><view wx:else class="person-period">累计至今</view>
  <view class="mp-card person-stats"><view class="person-distance"><text>{{profile.stats.kmLabel}}</text><text class="person-distance-unit">公里</text></view><view class="person-stat-grid"><view><text>{{profile.stats.times}}</text><text>跑步次数</text></view><view><text>{{profile.stats.days}}</text><text>跑步天数</text></view><view><text>{{profile.stats.hours}}</text><text>运动小时</text></view></view><view class="person-pace"><text>平均配速</text><text>{{profile.stats.paceLabel || '—'}}<text wx:if="{{profile.stats.paceLabel}}" class="mp-small-note"> / km</text></text></view></view>
  <view class="mp-section-head"><view class="mp-section-title">最近跑步</view><text class="mp-small-note">本期最近 20 次</text></view><view class="mp-card person-runs"><view wx:for="{{profile.recentRuns}}" wx:key="id" class="person-run"><view class="person-run-date"><text>{{item.day}}</text><text>{{item.time}}</text></view><view class="person-run-info"><view>{{item.typeLabel}}<text>{{item.kmLabel}}<text> km</text></text></view><view class="person-run-meta"><text>{{item.durationLabel}}</text><text>配速 {{item.paceLabel || '—'}} / km</text></view></view></view><view wx:if="{{!profile.recentRuns.length}}" class="mp-empty">这个周期还没有计入本团的跑量，
下一次出发，也许就是新的开始。</view></view><view class="mp-footnote">本页展示团内可见的介绍与跑量 · 北京时间</view>
</block></view>
