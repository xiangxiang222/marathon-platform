<view class="member-profile mp-page">
  <view wx:if="{{loading && !profile}}" class="mp-empty">正在打开团友主页…</view>
  <view wx:if="{{message}}" class="mp-error">{{message}}<button class="mp-text-action" bindtap="load">重试</button></view>
  <block wx:if="{{profile}}">
    <view class="person-hero">
      <view class="person-hero-top"><view class="mp-eyebrow">团内档案</view><text class="person-role">{{profile.user.roleLabel || '跑团成员'}}</text></view>
      <view class="person-identity"><image wx:if="{{profile.user.avatar}}" class="person-avatar" src="{{profile.user.avatar}}" mode="aspectFill" /><view wx:else class="person-avatar person-fallback">{{profile.initial}}</view><view class="person-main"><view class="person-name">{{profile.user.nickname}}</view><view class="person-group">{{profile.user.groupName || '未分组'}}<text wx:if="{{profile.group && profile.group.pace}}"> · {{profile.group.pace}}</text></view><view class="person-joined">{{profile.joinedLabel}} 加入跑团</view></view></view>
      <view class="person-hero-metrics"><view><text>{{profile.allKm}}</text><text>团内累计 · km</text></view><view><text>{{profile.totalTimes}}</text><text>运动次数</text></view><view><text>{{profile.summary.finishedRaceCount || 0}}</text><text>完赛场次</text></view></view>
    </view>
    <view class="person-tabs"><button wx:for="{{tabs}}" wx:key="id" class="person-tab {{activeTab === item.id ? 'tab-selected' : ''}}" data-tab="{{item.id}}" bindtap="pickTab">{{item.name}}<view wx:if="{{activeTab === item.id}}" class="person-tab-line"></view></button></view>
    <block wx:if="{{activeTab === 'profile'}}">

      <view class="mp-card person-intro"><view class="mp-section-head"><view class="mp-section-title">关于{{profile.mine ? '我' : '这位团友'}}</view><button wx:if="{{profile.mine && !editing}}" class="mp-text-action" bindtap="editIntroduction">编辑介绍 ↗</button></view><view wx:if="{{!editing}}" class="person-introduction {{!profile.user.introduction ? 'intro-empty' : ''}}">{{profile.user.introduction || (profile.mine ? '写下你的跑步故事，让团友更了解你。' : '这位团友还没有填写介绍，先从一起跑步认识吧。')}}</view><block wx:else><textarea class="mp-textarea" maxlength="300" value="{{introduction}}" bindinput="inputIntroduction" placeholder="平时在哪里跑，喜欢怎样的训练，下一场想跑什么…" aria-label="个人介绍" /><view class="person-edit-count">{{introduction.length}} / 300</view><view wx:if="{{editMessage}}" class="mp-error">{{editMessage}}</view><view class="person-edit-actions"><button class="mp-secondary" disabled="{{saving}}" bindtap="cancelEdit">取消</button><button class="mp-primary" disabled="{{saving}}" loading="{{saving}}" bindtap="saveIntroduction">保存介绍</button></view></block></view>
      <button class="person-group-card" bindtap="openGroups"><view class="person-group-icon">{{profile.groupInitial}}</view><view class="person-group-copy"><view>{{profile.user.groupName || '未分组'}}</view><view>{{profile.group ? profile.group.description || profile.group.pace || '同频的伙伴，一起进步' : '找到适合自己的节奏和伙伴'}}</view></view><text>›</text></button>
      <view class="mp-section-head"><view class="mp-section-title">跑步小档案</view><button class="mp-text-action" data-tab="mileage" bindtap="pickTab">查看跑量 ›</button></view><view class="person-mini-stats"><view class="person-mini-stat"><text class="person-mini-label">{{profile.yearLabel}} 年跑量</text><view>{{profile.yearKm}}<text> km</text></view><text class="person-mini-note">按本团计入规则统计</text></view><view class="person-mini-stat"><text class="person-mini-label">赛事足迹</text><view>{{profile.summary.raceCount || 0}}<text> 场</text></view><text class="person-mini-note">已记录的赛事计划与经历</text></view></view>
      <view wx:if="{{profile.nextRace}}" class="person-next-race" data-id="{{profile.nextRace.race.id}}" bindtap="openRace"><view class="person-next-kicker">下一场赛事 <text>↗</text></view><view class="person-next-title">{{profile.nextRace.race.name}}</view><view class="person-next-meta">{{profile.nextRace.dateLabel}} · {{profile.nextRace.status}}</view></view>
      <view wx:if="{{profile.summary.pb.length}}" class="mp-section-head"><view class="mp-section-title">个人最好成绩</view><button class="mp-text-action" data-tab="results" bindtap="pickTab">全部成绩 ›</button></view><view wx:if="{{profile.summary.pb.length}}" class="person-pb-preview"><view wx:for="{{profile.summary.pb}}" wx:key="key" wx:if="{{index < 2}}" class="person-pb-tile" data-id="{{item.race.id}}" bindtap="openRace"><view class="person-pb-top"><text>{{item.distanceLabel}}</text><text>PB</text></view><view class="person-pb-clock">{{item.clock}}</view><view class="person-pb-name">{{item.race.name}}</view></view></view>
      <view wx:if="{{profile.previewPhotos.length}}" class="mp-section-head"><view class="mp-section-title">活动相册</view><button class="mp-text-action" data-tab="albums" bindtap="pickTab">查看相册 ›</button></view><view wx:if="{{profile.previewPhotos.length}}" class="person-photo-strip"><image wx:for="{{profile.previewPhotos}}" wx:key="id" src="{{item.src}}" mode="aspectFill" data-id="{{item.id}}" bindtap="previewPhoto" /></view>
    </block>
    <block wx:if="{{activeTab === 'mileage'}}">
      <view class="mp-section-head"><view><view class="mp-section-title">跑量档案</view><view class="person-section-caption">按本团计入规则统计</view></view><text class="mp-small-note">计入当前跑团</text></view>
      <view class="person-ranges"><button wx:for="{{ranges}}" wx:key="id" class="person-range {{range === item.id ? 'range-selected' : ''}}" data-range="{{item.id}}" disabled="{{saving}}" bindtap="pickRange">{{item.name}}</button></view>
      <view class="person-period-control" wx:if="{{range !== 'all'}}"><button class="person-period-arrow" data-direction="-1" disabled="{{saving}}" bindtap="changePeriod" aria-label="上一统计周期">‹</button><picker mode="date" value="{{date}}" end="{{today}}" disabled="{{saving}}" bindchange="pickDate"><view class="person-period">{{profile.period.label}} <text>⌄</text></view></picker><button class="person-period-arrow" data-direction="1" disabled="{{saving || !canNext}}" bindtap="changePeriod" aria-label="下一统计周期">›</button></view><view wx:else class="person-period">累计至今</view>
      <view wx:if="{{loading}}" class="person-loading">正在更新本期跑量…</view>
      <view class="mp-card person-stats"><view class="person-distance-label">{{range === 'all' ? '累计' : '本期'}}跑量</view><view class="person-distance"><text>{{profile.stats.kmLabel}}</text><text class="person-distance-unit">公里</text></view><view class="person-stat-grid"><view><text>{{profile.stats.times}}</text><text>跑步次数</text></view><view><text>{{profile.stats.days}}</text><text>跑步天数</text></view><view><text>{{profile.stats.hours}}</text><text>运动小时</text></view></view><view class="person-pace"><text>平均配速</text><text>{{profile.stats.paceLabel || '—'}}<text wx:if="{{profile.stats.paceLabel}}" class="mp-small-note"> / km</text></text></view></view>
      <view class="mp-section-head"><view class="mp-section-title">最近跑步</view><text class="mp-small-note">本期最近 20 次</text></view><view class="mp-card person-runs"><view wx:for="{{profile.recentRuns}}" wx:key="id" class="person-run"><view class="person-run-date"><text>{{item.day}}</text><text>{{item.time}}</text></view><view class="person-run-info"><view>{{item.typeLabel}}<text>{{item.kmLabel}}<text> km</text></text></view><view class="person-run-meta"><text>{{item.durationLabel}}</text><text>配速 {{item.paceLabel || '—'}} / km</text></view><view wx:if="{{item.km !== item.distanceKm}}" class="person-run-extra">实际距离 {{item.distanceLabel}} km · 按本团规则折算</view></view></view><view wx:if="{{!profile.recentRuns.length}}" class="mp-empty">这个周期还没有计入本团的跑量，下一次出发，也许就是新的开始。</view></view>
    </block>
    <block wx:if="{{activeTab === 'races'}}">
      <view class="mp-section-head"><view><view class="mp-section-title">参赛计划</view><view class="person-section-caption">已标记的公开赛事</view></view><text class="mp-small-note">{{profile.summary.raceCount || 0}} 场赛事</text></view>
      <view class="person-race-filters"><button wx:for="{{raceFilters}}" wx:key="id" class="person-race-filter {{raceFilter === item.id ? 'filter-selected' : ''}}" data-id="{{item.id}}" bindtap="pickRaceFilter">{{item.name}}</button></view>
      <button wx:for="{{shownRaces}}" wx:key="key" class="person-race-card" data-id="{{item.race.id}}" bindtap="openRace"><view class="person-race-date tone-{{item.statusTone}}"><text>{{item.monthDay}}</text><text>{{item.year}}</text></view><view class="person-race-info"><view class="person-race-card-top"><text class="person-status tone-{{item.statusTone}}">{{item.status}}</text><text class="person-race-arrow">↗</text></view><view class="person-race-name">{{item.race.name}}</view><view class="person-race-location">{{item.location || '城市待公布'}}{{item.distanceText ? ' · ' + item.distanceText : ''}}</view></view></button>
      <view wx:if="{{!shownRaces.length}}" class="person-tab-empty"><view class="person-empty-symbol">↗</view><view class="mp-section-title">下一场期待，还在路上</view><view>这里会记录想参加的比赛、中签和参赛进展。</view></view>
    </block>
    <block wx:if="{{activeTab === 'results'}}">
      <button wx:if="{{profile.mine}}" class="achievement-poster-entry" bindtap="openAchievementPoster"><view><view>把高光，分享给朋友</view><text>用自己的 PB 与完赛成绩，做一张海报</text></view><text>制作海报 ↗</text></button>
      <view class="mp-section-head"><view><view class="mp-section-title">自己的最好成绩</view><view class="person-section-caption">用时间，记住每一次突破</view></view><text class="person-pb-tag">PERSONAL BEST</text></view>
      <view class="person-pb-grid"><view wx:for="{{profile.summary.pb}}" wx:key="key" class="person-pb-tile" data-id="{{item.race.id}}" bindtap="openRace"><view class="person-pb-top"><text>{{item.distanceLabel}}</text><text>PB</text></view><view class="person-pb-clock">{{item.clock}}</view><view class="person-pb-name">{{item.race.name}}</view><view class="person-pb-date">{{item.dateLabel}}</view></view></view>
      <view class="mp-section-head"><view class="mp-section-title">成绩履历</view><text class="mp-small-note">{{profile.summary.resultCount || 0}} 条成绩</text></view>
      <button wx:for="{{profile.results}}" wx:key="key" class="person-result-card" data-id="{{item.race.id}}" bindtap="openRace"><view class="person-result-top"><text>{{item.distanceLabel}}</text><text>{{item.dateLabel}}　›</text></view><view class="person-result-main"><text>{{item.clock}}</text><text wx:if="{{item.pb}}" class="person-result-pb">PB</text></view><view class="person-result-name">{{item.race.name}}</view><view class="person-result-bottom"><text>{{item.race.city || item.race.province}}</text><text>平均配速 {{item.pace || '—'}} / km</text></view></button>
      <view wx:if="{{!profile.results.length}}" class="person-tab-empty"><view class="person-empty-symbol">✧</view><view class="mp-section-title">每一次完赛，都值得珍藏</view><view>记录比赛成绩后，个人最好成绩会在这里汇总。</view></view>
    </block>
    <block wx:if="{{activeTab === 'albums'}}">
      <view class="mp-section-head"><view><view class="mp-section-title">把相聚，留在相册</view><view class="person-section-caption">团内共享的影像，点开看看那一天</view></view><text class="mp-small-note">{{profile.summary.photoCount || 0}} 张照片</text></view>
      <view wx:for="{{profile.albums}}" wx:for-item="album" wx:key="id" class="person-album-card"><view class="person-album-heading"><view><view class="person-album-title">{{album.title}}</view><view class="person-album-meta">{{album.dateLabel}} · {{album.photoCount}} 张照片{{album.videoCount ? ' · ' + album.videoCount + ' 个视频' : ''}}</view></view><button class="person-album-link" data-id="{{album.id}}" bindtap="openAlbum">{{profile.mine ? '管理' : '活动'}} ↗</button></view><view class="person-album-grid"><block wx:for="{{album.items}}" wx:for-item="photo" wx:key="id"><image wx:if="{{photo.kind === 'photo'}}" src="{{photo.src}}" mode="aspectFill" class="person-album-photo" data-id="{{photo.id}}" bindtap="previewPhoto" /><video wx:else class="person-album-video" src="{{photo.src}}" controls object-fit="cover" /></block></view></view>
      <view wx:if="{{!profile.albums.length}}" class="person-tab-empty"><view class="person-empty-symbol">▧</view><view class="mp-section-title">活动相册，值得留下</view><view>这里展示这位团友在本团活动中分享的影像。</view></view>
    </block>
    <view class="mp-footnote">团内成员可见 · 跑量按本团计入规则统计 · 北京时间</view>
  </block>
</view>
