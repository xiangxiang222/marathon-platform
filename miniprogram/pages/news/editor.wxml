<view class="journal-page club-journal-editor service-page service-form">
  <view class="editor-intro"><view class="editor-title">发布跑团资讯</view><text class="editor-description">团练心得、赛事回顾，或一篇值得分享的公众号文章。</text></view>
  <view wx:if="{{message}}" class="editor-message" role="alert"><text>{{message}}</text><button wx:if="{{!allowed}}" bindtap="retry" size="mini">重试</button></view><view wx:if="{{success}}" class="editor-success" role="status">{{success}}</view>
  <view wx:if="{{loading}}" class="editor-state">正在确认发布权限…</view>
  <view wx:elif="{{!allowed}}" class="editor-state"><text>仅跑团团长与管理员可以发布资讯。</text><navigator url="/pages/news/news?club={{clubId}}">返回资讯中心 →</navigator></view>
  <block wx:else>
    <view class="editor-toolbar"><view><text class="editor-state-tag">{{statusLabel}}</text><text wx:if="{{draft.id}}" class="editor-article-id">#{{draft.id}}</text></view><button bindtap="reset" disabled="{{saving}}" size="mini">＋ 新建一篇</button></view>
    <view class="editor-card"><view class="form-task-section"><view class="form-task-heading"><view class="section-title">文章内容</view><text>标题、摘要与正文</text></view><view class="editor-field"><view class="editor-label">标题<text>{{draft.title.length}}/120</text></view><input value="{{draft.title}}" maxlength="120" data-field="title" bindinput="input" disabled="{{saving}}" placeholder="给这篇故事起个名字" /></view>
      <view class="editor-field"><view class="editor-label">内容类型</view><picker mode="selector" range="{{rightsNames}}" value="{{rightsIndex}}" bindchange="rightsChanged" disabled="{{saving}}"><view class="editor-picker">{{rightsNames[rightsIndex]}}<text>⌄</text></view></picker></view>
      <view class="editor-field"><view class="editor-label">摘要<text>{{draft.summary.length}}/400</text></view><textarea value="{{draft.summary}}" maxlength="400" data-field="summary" bindinput="input" disabled="{{saving}}" placeholder="用两三句话，告诉读者这篇内容为什么值得看。" auto-height /></view>
      <view wx:if="{{draft.rights === 'link'}}" class="editor-tip">推荐文章展示标题、摘要和原文入口。读者可点击阅读公众号原文。</view>
      <view wx:if="{{draft.rights !== 'link'}}" class="editor-field"><view class="editor-label">正文<text>支持 Markdown</text></view><textarea class="editor-body-input" value="{{draft.body}}" maxlength="20000" data-field="body" bindinput="input" disabled="{{saving}}" placeholder="写下正文，可使用 ## 小标题、**重点** 和列表。" /></view>
      </view><view class="form-task-section"><view class="form-task-heading"><view class="section-title">署名与来源</view><text>{{draft.rights === "original" ? "原创文章" : "请填写原文信息"}}</text></view><view class="editor-field"><view class="editor-label">来源名称</view><input value="{{draft.source}}" maxlength="80" data-field="source" bindinput="input" disabled="{{saving}}" placeholder="跑团、作者或媒体名称" /></view><view class="editor-field"><view class="editor-label">原文 / 来源链接<text>{{draft.rights === 'original' ? '选填' : '必填'}}</text></view><input value="{{draft.sourceUrl}}" maxlength="2000" data-field="sourceUrl" bindinput="input" disabled="{{saving}}" placeholder="https://mp.weixin.qq.com/s/…" /></view>
      </view><view class="form-filled-summary"><view>{{draft.title || "文章标题待填写"}}</view><text>{{statusLabel}} · {{draft.source || "来源名称待填写"}}</text></view><text wx:if="{{draft.rights === 'authorized'}}" class="editor-help">授权转载需先获得原作者许可，再填写正文与来源。</text><view class="editor-actions"><button class="editor-publish" bindtap="save" data-status="published" loading="{{saving}}" disabled="{{saving}}">{{draft.status === 'published' ? '保存并发布' : '发布内容'}}</button><button bindtap="save" data-status="draft" disabled="{{saving}}">存为草稿</button></view><view class="editor-secondary-actions"><button bindtap="togglePreview" disabled="{{saving}}" size="mini">{{preview ? '收起预览' : '阅读预览'}}</button><button wx:if="{{draft.id && draft.status !== 'archived'}}" bindtap="save" data-status="archived" disabled="{{saving}}" size="mini">下架内容</button></view>
    </view>
    <view wx:if="{{preview}}" class="editor-preview"><text class="editor-eyebrow">阅读预览</text><view class="editor-preview-title">{{draft.title || '未填写标题'}}</view><view class="editor-preview-source">{{draft.source}}</view><view wx:if="{{draft.summary}}" class="editor-preview-summary">{{draft.summary}}</view><view wx:for="{{previewBlocks}}" wx:key="i" class="editor-md md-{{item.kind}}"><text wx:if="{{item.mark}}">{{item.mark}}</text><text wx:for="{{item.runs}}" wx:for-item="run" wx:key="j" class="{{run.strong ? 'editor-strong' : ''}}">{{run.text}}</text></view><text wx:if="{{draft.sourceUrl}}" class="editor-source-link">{{draft.rights === 'link' ? '阅读原文 ↗' : '查看来源 ↗'}}</text></view>
    <view class="editor-library"><view class="editor-library-head"><view>已保存的内容 <text>{{total}}</text></view><picker mode="selector" range="{{statusNames}}" value="{{filterIndex}}" bindchange="filterChanged" disabled="{{saving}}"><view class="editor-filter">{{statusNames[filterIndex]}} ⌄</view></picker></view><view wx:if="{{listLoading}}" class="editor-state">正在读取内容…</view><view wx:elif="{{!rows.length}}" class="editor-state">还没有这个状态的文章。</view><button wx:for="{{rows}}" wx:key="id" class="editor-saved-row" data-id="{{item.id}}" bindtap="edit" disabled="{{saving}}"><view><text class="editor-saved-title">{{item.title}}</text><text class="editor-saved-date">{{item.dateLabel}}</text></view><text class="editor-row-status status-{{item.status}}">{{item.statusLabel}} ›</text></button><view wx:if="{{pages > 1}}" class="editor-pages"><button bindtap="prevPage" disabled="{{page <= 1 || listLoading || saving}}" size="mini">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="nextPage" disabled="{{page >= pages || listLoading || saving}}" size="mini">下一页</button></view></view>
  </block>
</view>
