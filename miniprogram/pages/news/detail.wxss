.meta { margin-top: 8rpx; }
.md { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.md-h1 { margin-top: 8rpx; font-size: 20px; font-weight: 700; line-height: 1.35; }
.md-h2 { margin-top: 28rpx; font-size: 18px; font-weight: 700; line-height: 1.35; }
.md-h3 { margin-top: 22rpx; font-size: 16px; font-weight: 650; line-height: 1.4; }
.md-h4 { margin-top: 18rpx; font-size: 14px; font-weight: 650; line-height: 1.4; }
.md-mark { margin-right: 8rpx; color: var(--text-secondary); }
.md-strong { font-weight: 700; }
.race-go { margin-top: 24rpx; font-weight: 650; background: var(--peach-soft); }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-news-detail .card { border-radius: 36rpx; background: #ffffff; box-shadow: var(--card-shadow); }
.mini-news-detail .race-go { border-radius: 24rpx; }

/* Page composition and interaction hierarchy. */
.mini-news-detail { color: var(--text); background: transparent; }
.mini-news-detail button { font-weight: 500; border-radius: 24rpx; }

.card { padding: 32rpx; border: 1px solid var(--border); }
.title { font-size: 24px; font-weight: 600; line-height: 1.5; }
.meta { color: var(--text-secondary); font-size: 11px; line-height: 1.8; }
.md { color: var(--text); font-size: 15px; line-height: 1.9; }
.race-go { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 20rpx 24rpx; border: 1px solid var(--border); border-radius: 24rpx; background: var(--peach-soft); color: var(--brand); font-size: 13px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */
.mini-news-detail .race-go { font-size: 13px; font-weight: 500; }
