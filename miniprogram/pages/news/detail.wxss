@import "../../utils/journal.wxss";
.biography-copy{margin-top:22rpx}.biography-section .source-button{margin-top:8rpx}
.pacer-assignment{margin:24rpx 0;padding:28rpx;border:1rpx solid var(--border);border-radius:18rpx;background:var(--page-bg)}
.assignment-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.assignment-target{color:var(--text);font-size:24px;font-weight:600;line-height:1.4;font-variant-numeric:tabular-nums}.assignment-target>text{font-size:12px;font-weight:400;margin-left:12rpx;color:var(--text-secondary)}
.assignment-status{font-size:12px;color:var(--text-secondary);border:1rpx solid var(--border);padding:5rpx 12rpx;border-radius:8rpx;flex:none}
.assignment-title{font-size:16px;font-weight:600;line-height:1.6;margin-top:20rpx;word-break:break-all}
.assignment-meta,.assignment-note{font-size:12px;color:var(--text-secondary);line-height:1.8;margin-top:10rpx}.assignment-note{margin-top:18rpx}
.pacer-assignment .source-button{margin-top:14rpx;min-height:38px}
.profile-article{margin:42rpx 0 50rpx}.profile-article-title{font-size:18px;font-weight:600;line-height:1.55;margin-bottom:28rpx}.profile-article-lead{font-size:16px;line-height:1.95;color:var(--text-secondary);margin-bottom:38rpx}.race-badges{display:flex;gap:10rpx;flex-wrap:wrap;margin:26rpx 0}.race-badges>text{font-size:12px;line-height:1.65;padding:6rpx 12rpx;background:var(--page-bg);color:var(--text-secondary);border-radius:8rpx;word-break:break-all}.race-badges>text.provisional{background:var(--brand-soft);color:var(--brand)}.verified-races{display:flex;flex-wrap:wrap;gap:12rpx;align-items:center;margin:26rpx 0;color:var(--text-secondary);font-size:12px}.verified-races>text:not(:first-child){background:var(--page-bg);padding:8rpx 14rpx;border-radius:8rpx;font-weight:500}
