.meta { margin-top: 8rpx; color: #8a8e99; font-size: 26rpx; }
.total { margin: 16rpx 0 0; color: #8a8e99; font-size: 26rpx; }
.pager { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.pager-step { height: 64rpx; line-height: 64rpx; padding: 0 8rpx; color: #ff0a30; font-size: 28rpx; font-weight: 650; }
.pager-step.off { color: #c9ccd3; }
.pager-num { min-width: 64rpx; height: 64rpx; line-height: 64rpx; padding: 0 16rpx; border-radius: 16rpx; text-align: center; background: #f0f1f6; color: #1f2026; font-size: 28rpx; font-weight: 650; }
.pager-num.on { background: #ff0a30; color: #fff; }
