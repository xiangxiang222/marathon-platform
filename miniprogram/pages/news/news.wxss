@import "../../utils/journal.wxss";
.pacer-race-filter{display:flex;align-items:center;gap:18rpx;margin:28rpx 0 16rpx;font-size:12px;color:var(--text-secondary)}.pacer-race-filter>text{flex:none}.pacer-race-filter>picker{flex:1;min-width:0}.race-filter-value{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:0 20rpx;border:1rpx solid var(--border);border-radius:14rpx;background:var(--page-bg);color:var(--text);font-size:13px}.race-filter-value>text{flex:none}.pacer-race-filter>button{flex:none;width:auto;margin:0;padding:0 4rpx;min-height:44px;line-height:44px;color:var(--brand);background:transparent;font-size:13px}
.race-badges{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:12rpx}.race-badges>text{font-size:11px;line-height:1.65;padding:5rpx 10rpx;background:var(--page-bg);color:var(--text-secondary);border-radius:6rpx;word-break:break-all}.race-badges>text.provisional{background:var(--brand-soft);color:var(--brand)}.verified-race-label{font-size:11px;line-height:1.65;color:var(--text-secondary);margin-top:10rpx}
