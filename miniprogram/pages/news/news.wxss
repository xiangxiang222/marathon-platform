.total { margin: 16rpx 0 0; color: var(--text-secondary); font-size: 12px; }
.pager { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.pager-step { height: 64rpx; line-height: 64rpx; padding: 0 8rpx; color: var(--brand); font-weight: 650; }
.pager-step.off { color: #c9ccd3; }
.pager-num { min-width: 64rpx; height: 64rpx; line-height: 64rpx; padding: 0 16rpx;  text-align: center; background: var(--page-bg); color: var(--text); font-size: 14px; font-weight: 650; }
.pager-num.on { background: var(--brand); color: #fff;  }

/* Route geometry: surfaces, controls and compact labels have distinct roles. */
.mini-news-news .card { border-radius: 36rpx; background: #ffffff; box-shadow: var(--card-shadow); }
.mini-news-news .pager-num { border-radius: 14rpx; }

/* Page composition and interaction hierarchy. */
.mini-news-news { color: var(--text); background: transparent; }
.mini-news-news button { font-weight: 500; border-radius: 24rpx; }

.card { display: block; padding: 30rpx; border: 1px solid var(--border); }
.title { font-size: 20px; font-weight: 600; line-height: 1.55; }
.meta { margin-top: 16rpx; color: var(--text-secondary); font-size: 11px; line-height: 1.7; }
.pager-step { font-size: 12px; }

/* Primary actions read at 14px, secondary actions at 13px; compact filters stay at 12px. */

/* Existing semantic sections receive distinct light color surfaces. */
.mini-news-news .card:nth-child(even) { background: #ffffff; }
