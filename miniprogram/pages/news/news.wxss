@import "../../utils/journal.wxss";
.shortcut-kicker,.shortcut-arrow{color:#55388c}.featured-tag{color:#55388c;background:#f3eefc}
.race-badges{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:12rpx}.race-badges>text{font-size:12px;line-height:1.65;padding:5rpx 10rpx;background:var(--page-bg);color:var(--text-secondary);border-radius:6rpx;word-break:break-all}.race-badges>text.provisional{background:var(--brand-soft);color:var(--brand)}.verified-race-label{font-size:12px;line-height:1.65;color:var(--text-secondary);margin-top:10rpx}
