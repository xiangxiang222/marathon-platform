<view class="pad">
  <view wx:if="{{message}}" class="err">{{message}}</view>
  <view wx:if="{{item}}" class="card">
    <view class="title">{{item.title}}</view>
    <view class="meta">{{item.publishedAt}} · {{item.source}}</view>
    <view wx:for="{{blocks}}" wx:key="i" class="md md-{{item.kind}}">
      <text wx:if="{{item.mark}}" class="md-mark">{{item.mark}}</text>
      <text wx:for="{{item.runs}}" wx:for-item="run" wx:key="j" class="{{run.strong ? 'md-strong' : ''}}">{{run.text}}</text>
    </view>
    <navigator class="race-go" url="/pages/race/race?id={{item.raceId}}">{{item.raceName}}</navigator>
  </view>
</view>
