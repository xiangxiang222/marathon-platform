<view class="journal-page"><view wx:if="{{message}}" class="journal-state"><view class="state-icon">!</view><view class="state-title">这一页暂时无法打开</view><view>{{message}}</view><button bindtap="load">重新加载</button></view><view wx:elif="{{!ready}}" class="journal-state">正在打开…</view><view wx:elif="{{item}}" class="journal-detail"><block wx:if="{{isProfile}}"><view class="profile-hero"><view class="detail-kicker">{{item.type === 'pacer' ? '私兔人物档案' : '中国马拉松运动员'}}</view><view class="profile-name">{{item.name}}</view><view wx:if="{{item.nameEn}}" class="profile-en">{{item.nameEn}}</view><view class="pb-panel"><text>{{item.personalBestDisplay || item.personalBest ? '全程马拉松 · PB' : '公开资料'}}</text><text>{{item.personalBestDisplay || item.personalBest || '持续收录'}}</text></view></view><view wx:if="{{item.rank}}" class="profile-fact"><text>榜单名次</text><text>{{item.gender === 'women' ? '女子' : '男子'}} #{{item.rank}} · 个人最佳</text></view><view wx:if="{{item.eventName}}" class="profile-fact"><text>PB 赛事</text><text>{{item.eventName}}</text></view><view wx:if="{{item.eventDate}}" class="profile-fact"><text>比赛日期</text><text>{{item.eventDate}}</text></view><view wx:if="{{item.birthDate}}" class="profile-fact"><text>出生日期</text><text>{{item.birthDate}}</text></view><view wx:if="{{item.role}}" class="profile-fact"><text>人物身份</text><text>{{item.role}}</text></view><view class="profile-section"><view class="profile-section-title">认识 {{item.name}}</view><view class="profile-bio">{{item.bio || item.summary || '目前已收录公开比赛记录，个人经历持续补充。'}}</view></view><view wx:if="{{highlights.length}}" class="profile-section"><view class="profile-section-title">代表性大赛履历</view><view wx:for="{{highlights}}" wx:key="date" class="evidence-card"><view>{{item.date}} · {{item.title}}</view><view>第 {{item.position}} 名 · {{item.result}}</view><button class="source-button" data-url="{{item.sourceUrl}}" bindtap="openSource">查看比赛来源 ↗</button></view></view><view wx:if="{{evidence.length}}" class="profile-section"><view class="profile-section-title">带跑经历</view><view wx:for="{{evidence}}" wx:key="text" class="evidence-card"><view>{{item.text}}</view><button wx:if="{{item.url}}" class="source-button" data-url="{{item.url}}" bindtap="openSource">查看经历来源 ↗</button></view></view><view wx:if="{{item.verificationNote}}" class="ranking-note">{{item.verificationNote}}</view><view class="ranking-note">{{rankingNote}}</view></block><block wx:else><view class="detail-kicker">{{item.clubName || (isRace ? '赛事资讯' : categoryLabel)}}</view><view class="detail-title">{{item.title}}</view><view class="detail-meta"><text>{{item.source}}</text><text>{{dateLabel}}</text></view><view wx:if="{{item.summary}}" class="detail-summary">{{item.summary}}</view><view wx:for="{{blocks}}" wx:key="i" class="md md-{{item.kind}}"><text wx:if="{{item.mark}}" class="md-mark">{{item.mark}}</text><text wx:for="{{item.runs}}" wx:for-item="run" wx:key="j" class="{{run.strong ? 'md-strong' : ''}}">{{run.text}}</text></view><navigator wx:if="{{isRace && item.raceId}}" class="detail-back" url="/pages/race/race?id={{item.raceId}}">{{item.raceName}} ›</navigator></block><view wx:if="{{sources.length}}" class="source-box"><view>{{isProfile ? '资料来源 · 点击查阅原始记录' : item.rights === 'link' ? '本文为原文推荐，完整内容请前往来源阅读。' : '内容来源'}}</view><button wx:for="{{sources}}" wx:key="url" class="source-button" data-url="{{item.url}}" bindtap="openSource">{{item.label}} ↗</button></view><navigator class="detail-back" url="{{backUrl}}">‹ 返回资讯列表</navigator></view></view>
