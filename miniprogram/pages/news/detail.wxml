<view class="journal-page">
  <view wx:if="{{message}}" class="journal-state"><view class="state-icon">!</view><view class="state-title">这一页暂时无法打开</view><view>{{message}}</view><button bindtap="load">重新加载</button></view>
  <view wx:elif="{{!ready}}" class="journal-state">正在打开…</view>
  <view wx:elif="{{item}}" class="journal-detail">
    <block wx:if="{{isProfile}}">
      <view class="profile-hero">
        <view class="profile-identity"><view class="profile-hero-copy"><view class="detail-kicker">{{isOfficialPacer || isPacerPerson ? '赛事官方配速员' : item.type === 'pacer' ? '私人带跑' : '中国马拉松运动员'}}</view><view class="profile-name">{{item.name}}</view><view wx:if="{{item.nameEn}}" class="profile-en">{{item.nameEn}}</view></view><view class="profile-portrait"><text>{{isOfficialPacer ? '官兔' : item.avatarLabel}}</text><image wx:if="{{!item.imageFailed && (item.avatar || item.photo || (isOfficialPacer && item.coverUrl))}}" src="{{item.avatar || item.photo || item.coverUrl}}" mode="aspectFill" binderror="imageError" aria-label="{{item.name}}照片" /></view></view>
        <view class="pb-panel"><text>{{isPacerPerson ? '官方配速 · 完赛目标' : isOfficialPacer ? (item.edition || '') + ' · 配速组别' : item.seasonBest ? (item.seasonYear || seasonYear)+'赛季 · 最佳成绩' : '全程马拉松 · PB'}}</text><text>{{isPacerPerson ? item.pacerTarget : isOfficialPacer ? item.groupCount ? item.groupCount + ' 个配速组' : '官兔' : item.seasonBest || item.personalBestDisplay || item.personalBest || '—'}}</text></view>
      </view>
      <view wx:if="{{isPacerPerson && item.verifiedPacerRaceNames && item.verifiedPacerRaceNames.length}}" class="verified-races"><text>曾任官兔</text><text wx:for="{{item.verifiedPacerRaceNames}}" wx:key="*this">{{item}}</text></view>
      <view wx:if="{{isPacerPerson && raceBadges.length}}" class="race-badges profile-race-badges"><text wx:for="{{raceBadges}}" wx:key="raceId" class="{{item.status === 'provisional' ? 'provisional' : ''}}">{{item.label || item.raceName}} · {{item.statusLabel}}</text></view>
      <view class="profile-article"><view class="profile-article-title">{{profileArticle.title}}</view><view wx:if="{{profileArticle.lead}}" class="profile-article-lead">{{profileArticle.lead}}</view><view wx:for="{{profileBlocks}}" wx:key="i" class="md md-{{item.kind}}"><text wx:if="{{item.mark}}" class="md-mark">{{item.mark}}</text><text wx:for="{{item.runs}}" wx:for-item="run" wx:key="j" class="{{run.strong ? 'md-strong' : ''}}">{{run.text}}</text></view></view>
      <view wx:if="{{item.birthDate || item.placeOfBirth || item.team}}" class="profile-section"><view class="profile-section-title">个人资料</view><view wx:if="{{item.birthDate}}" class="profile-fact"><text>出生日期</text><text>{{item.birthDate}}</text></view><view wx:if="{{item.placeOfBirth}}" class="profile-fact"><text>籍贯</text><text>{{item.placeOfBirth}}</text></view><view wx:if="{{item.team}}" class="profile-fact"><text>所属队伍</text><text>{{item.team}}</text></view></view>
      <block wx:if="{{isPacerPerson}}">
        <view wx:if="{{item.personalBest}}" class="profile-fact"><text>全马个人最佳</text><text>{{item.personalBestDisplay || item.personalBest}}</text></view>
        <view wx:if="{{assignments.length}}" class="profile-section"><view class="profile-section-title">配速赛事</view><view wx:for="{{assignments}}" wx:key="index" class="pacer-assignment"><view class="assignment-heading"><view class="assignment-target">{{item.targetTime || '官方配速员'}}<text wx:if="{{item.targetTime}}">完赛组</text></view><text class="assignment-status">{{item.statusLabel}}</text></view><view class="assignment-title">{{item.raceName}}</view><view class="assignment-meta">{{item.metaLabel}}</view><view wx:if="{{item.pace}}" class="assignment-meta">目标配速 {{item.pace}} / km</view></view></view>
      </block>
      <block wx:elif="{{isOfficialPacer}}">
        <view wx:if="{{pacerGroups.length}}" class="profile-section"><view class="profile-section-title">配速组别 <text class="section-small">{{pacerGroups.length}} 组</text></view><view class="pacer-groups"><view wx:for="{{pacerGroups}}" wx:key="label" class="pacer-group"><view class="pacer-group-title">{{item.targetTime || item.label}}</view><view class="pacer-group-label">{{item.label}}{{item.pace ? ' · ' + item.pace + ' / km' : ''}}</view><view class="pacer-group-names">{{item.namesText}}</view></view></view></view>
      </block>
      <block wx:else>
        <view wx:if="{{item.seasonRank}}" class="profile-fact"><text>{{item.seasonYear || seasonYear}}赛季名次</text><text>{{item.gender === 'women' ? '女子' : '男子'}} #{{item.seasonRank}}</text></view>
        <view wx:if="{{item.personalBest}}" class="profile-fact"><text>全马个人最佳</text><text>{{item.personalBestDisplay || item.personalBest}}</text></view>
        <view wx:if="{{item.eventName}}" class="profile-fact"><text>PB 赛事</text><text>{{item.eventName}} · {{item.eventDate}}</text></view>
        <view wx:if="{{item.personalRecords && item.personalRecords.length}}" class="profile-section"><view class="profile-section-title">个人最好成绩</view><view class="personal-records"><view wx:for="{{item.personalRecords}}" wx:key="discipline" class="personal-record"><text>{{item.discipline}}</text><text>{{item.mark}}</text><view>{{item.date}} · {{item.venue}}</view></view></view></view>
        <view wx:if="{{highlights.length}}" class="profile-section"><view class="profile-section-title">代表性比赛</view><view wx:for="{{highlights}}" wx:key="date" class="evidence-card"><view>{{item.date}} · {{item.title}}</view><view>第 {{item.position}} 名 · {{item.result}}</view></view></view>
      </block>
      <view wx:if="{{gallery.length}}" class="profile-section"><view class="profile-section-title">赛场影像</view><view wx:for="{{gallery}}" wx:key="url" class="pacer-gallery-card"><image src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bindtap="previewPhoto" aria-label="赛场照片" /></view></view>
    </block>
    <block wx:else>
      <view class="detail-kicker">{{item.clubName || (isRace ? '赛事资讯' : categoryLabel)}}</view><view class="detail-title">{{item.title}}</view><view class="detail-meta"><text wx:if="{{authorLabel}}">{{authorLabel}}</text><text>{{dateLabel}}</text></view>
      <image wx:if="{{item.coverUrl && !item.imageFailed}}" class="detail-cover-photo" src="{{item.coverUrl}}" mode="widthFix" binderror="imageError" />
      <view wx:if="{{item.summary}}" class="detail-summary">{{item.summary}}</view>
      <view wx:for="{{blocks}}" wx:key="i" class="md md-{{item.kind}}"><text wx:if="{{item.mark}}" class="md-mark">{{item.mark}}</text><text wx:for="{{item.runs}}" wx:for-item="run" wx:key="j" class="{{run.strong ? 'md-strong' : ''}}">{{run.text}}</text></view>
      <navigator wx:if="{{isRace && item.raceId}}" class="detail-back" url="/pages/race/race?id={{item.raceId}}">{{item.raceName}} ›</navigator>
    </block>
    <navigator class="detail-back" url="{{backUrl}}">‹ 返回资讯列表</navigator>
  </view>
</view>
