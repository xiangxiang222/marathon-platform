@import "../../utils/journal.wxss";
.club-journal-editor{padding:36rpx 30rpx 80rpx;background:var(--page-bg);min-height:100vh;color:var(--text-secondary)}.editor-intro{padding:12rpx 5rpx 35rpx}.editor-eyebrow{font-size:12px;letter-spacing:normal;color:var(--text-secondary)}.editor-title{font-size:25px;line-height:1.5;font-weight:600;letter-spacing:normal;margin-top:20rpx}.editor-description{display:block;font-size:12px;line-height:1.9;color:var(--text-secondary);margin-top:16rpx;max-width:570rpx}.editor-message,.editor-success{padding:23rpx 25rpx;font-size:12px;line-height:1.8;border-radius:17rpx;background:var(--page-bg);color:var(--text-secondary);margin-bottom:24rpx}.editor-message button{margin-top:15rpx;width:110rpx;font-size:12px;min-height:60rpx}.editor-success{background:var(--page-bg);color:var(--text-secondary)}.editor-state{text-align:center;padding:50rpx 24rpx;font-size:12px;color:var(--text-secondary);line-height:1.9}.editor-state navigator{display:block;margin-top:28rpx;color:var(--text-secondary)}.editor-toolbar{display:flex;align-items:center;justify-content:space-between;padding:7rpx 3rpx 24rpx}.editor-toolbar>view{display:flex;gap:16rpx;align-items:center}.editor-toolbar button{font-size:12px;min-height:68rpx;padding:12rpx 20rpx;border:1rpx solid var(--border);border-radius:12rpx;color:var(--text-secondary);background:var(--page-bg)}.editor-state-tag{display:inline-block;padding:5rpx 14rpx;background:var(--page-bg);color:var(--text-secondary);border-radius:8rpx;font-size:12px}.editor-article-id{font-size:12px;color:var(--text-secondary)}.editor-card,.editor-library,.editor-preview{background:var(--surface);border:1rpx solid var(--border);border-radius:26rpx;padding:30rpx;margin-bottom:28rpx}.editor-field{margin-bottom:28rpx}.editor-label{display:flex;justify-content:space-between;gap:15rpx;font-size:12px;color:var(--text-secondary);margin-bottom:14rpx}.editor-label text{font-size:12px;color:var(--text-secondary)}.editor-field input,.editor-field textarea,.editor-picker{display:block;width:100%;min-width:0;padding:21rpx 22rpx;border:1rpx solid var(--border);border-radius:14rpx;background:var(--page-bg);color:var(--text-secondary);font-size:14px;line-height:1.7}.editor-field input{height:86rpx}.editor-field textarea{min-height:160rpx}.editor-field .editor-body-input{height:440rpx;min-height:440rpx}.editor-picker{display:flex;align-items:center;justify-content:space-between}.editor-picker text{color:var(--text-secondary)}.editor-tip{padding:21rpx 24rpx;background:var(--page-bg);border-radius:13rpx;color:var(--text-secondary);font-size:12px;line-height:1.85;margin:0 0 28rpx}.editor-help{display:block;font-size:12px;line-height:1.85;color:var(--text-secondary);margin-bottom:25rpx}.editor-actions{display:flex;gap:15rpx;margin-top:34rpx}.editor-actions button{flex:1;font-size:13px;padding:23rpx 12rpx;border-radius:15rpx;color:var(--text-secondary);border:1rpx solid var(--border);background:var(--page-bg)}.editor-actions .editor-publish{background:var(--page-bg);color:var(--surface);border-color:var(--border)}.editor-secondary-actions{display:flex;justify-content:space-between;gap:20rpx;margin-top:16rpx}.editor-secondary-actions button{padding:14rpx 0;min-height:64rpx;border:0;background:none;font-size:12px;color:var(--text-secondary)}.editor-preview{padding:36rpx 30rpx}.editor-preview-title{font-size:21px;font-weight:600;line-height:1.65;margin:22rpx 0 20rpx;overflow-wrap:break-word}.editor-preview-source{font-size:12px;color:var(--text-secondary);border-bottom:1rpx solid var(--border);padding-bottom:25rpx}.editor-preview-summary{font-size:14px;line-height:1.9;padding:25rpx 24rpx;background:var(--page-bg);color:var(--text-secondary);border-radius:14rpx;margin:26rpx 0}.editor-md{font-size:15px;line-height:1.95;margin:18rpx 0;overflow-wrap:break-word}.editor-md.md-h1{font-size:19px;font-weight:600}.editor-md.md-h2{font-size:17px;font-weight:600;margin-top:38rpx}.editor-md.md-h3,.editor-md.md-h4{font-size:16px;font-weight:600}.editor-strong{font-weight:600}.editor-source-link{display:block;font-size:13px;color:var(--text-secondary);margin-top:30rpx}.editor-library{padding:28rpx 0 10rpx;overflow:hidden}.editor-library-head{display:flex;justify-content:space-between;align-items:center;padding:0 27rpx 24rpx;gap:14rpx;font-size:14px;font-weight:600}.editor-library-head>view>text{font-size:12px;font-weight:400;color:var(--text-secondary);margin-left:8rpx}.editor-filter{font-size:12px;font-weight:400;color:var(--text-secondary);padding:9rpx 12rpx;border:1rpx solid var(--border);border-radius:9rpx}.editor-saved-row{display:flex;width:100%;justify-content:space-between;align-items:center;gap:20rpx;padding:26rpx 27rpx;text-align:left;background:var(--surface);border:0;border-top:1rpx solid var(--border);border-radius:0}.editor-saved-row>view{flex:1;min-width:0}.editor-saved-title{display:block;font-size:14px;line-height:1.6;overflow-wrap:break-word}.editor-saved-date{display:block;font-size:12px;color:var(--text-secondary);margin-top:10rpx}.editor-row-status{font-size:12px;color:var(--text-secondary);white-space:nowrap}.editor-row-status.status-published{color:var(--text-secondary)}.editor-row-status.status-archived{color:var(--text-secondary)}.editor-pages{display:flex;align-items:center;justify-content:center;gap:25rpx;padding:16rpx 24rpx;font-size:12px;color:var(--text-secondary)}.editor-pages button{font-size:12px;border:0;background:var(--surface);min-height:66rpx;padding:12rpx 14rpx;color:var(--text-secondary)}

.club-journal-editor{background:var(--page-bg);color:var(--text)}.editor-title{font-size:24px;line-height:1.4;letter-spacing:normal;margin-top:0}.editor-eyebrow{font-size:12px;letter-spacing:normal;color:var(--text-secondary)}.editor-description{font-size:14px}.editor-message,.editor-success{background:var(--brand-soft);color:var(--brand);font-size:14px;border-radius:20rpx}.editor-card,.editor-library,.editor-preview{border-radius:24rpx;background:var(--surface)}.editor-label{font-size:14px;color:var(--text)}.editor-label text{font-size:12px}.editor-field input,.editor-field textarea,.editor-picker{font-size:14px;color:var(--text);border-radius:20rpx;min-height:44px}.editor-filter{min-height:44px;display:flex;align-items:center;border-radius:20rpx;font-size:14px}.editor-toolbar button,.editor-message button,.editor-secondary-actions button,.editor-pages button{min-height:44px;font-size:14px}.editor-actions button{min-height:44px;font-size:14px;border-radius:20rpx;color:var(--text);background:var(--surface)}.editor-actions .editor-publish{background:var(--brand);color:var(--surface);border-color:var(--brand)}.editor-state-tag{font-size:12px;background:var(--page-bg)}.editor-row-status.status-published{color:var(--brand)}.editor-library-head{font-size:18px}.editor-preview-title{font-size:24px}.editor-md{font-size:14px;color:var(--text)}.editor-md.md-h1{font-size:24px}.editor-md.md-h2{font-size:18px}.editor-md.md-h3,.editor-md.md-h4{font-size:16px}.editor-saved-title{font-size:16px;color:var(--text)}.editor-source-link{color:var(--brand);font-size:14px}

@import "../../utils/service-ui.wxss";

