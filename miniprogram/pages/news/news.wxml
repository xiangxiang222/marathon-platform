<view class="journal-page">
  <view class="journal-intro">
    <view class="journal-heading">{{clubId ? (clubName || '跑团资讯') : '跑圈动态'}}</view>
    <view class="journal-subtitle">{{clubId ? '团练记录、赛事回顾和团友的故事' : '关注赛道上的人，也关注跑圈新鲜事'}}</view>
    <navigator wx:if="{{clubId && canManage}}" class="publish-link" url="/pages/news/editor?club={{clubId}}">发布资讯 ＋</navigator>
    <view class="journal-search"><view class="search-icon"></view><input value="{{query}}" placeholder="{{tab === 'pacer' ? '搜索赛事、配速组别或配速员' : isProfile ? '搜索运动员姓名' : '搜索资讯、赛事和跑团故事'}}" maxlength="80" bindinput="onQuery" confirm-type="search" bindconfirm="search" aria-label="搜索资讯或人物"/><button bindtap="search"><text>搜索</text></button></view>
  </view>
  <view class="journal-content">
    <scroll-view wx:if="{{!clubId}}" class="journal-tabs" scroll-x="true"><view wx:for="{{tabs}}" wx:key="id" class="journal-tab {{tab === item.id ? 'selected' : ''}}" data-tab="{{item.id}}" bindtap="switchTab">{{item.label}}</view></scroll-view>
    <view wx:if="{{!clubId && tab === 'all'}}" class="journal-shortcuts">
      <button wx:for="{{profileEntries}}" wx:for-item="entry" wx:key="id" class="profile-entry" data-tab="{{entry.id}}" bindtap="switchTab">
        <view class="shortcut-kicker">{{entry.kicker}}</view><view class="shortcut-title">{{entry.title}}</view><view class="shortcut-subtitle">{{entry.description}}</view>
        <view class="shortcut-footer">
          <view wx:if="{{previewPhotos[entry.id].length}}" class="shortcut-portraits"><view wx:for="{{previewPhotos[entry.id]}}" wx:for-item="person" wx:key="id" class="shortcut-portrait"><image src="{{person.image}}" mode="aspectFill" data-type="{{entry.id}}" data-id="{{person.id}}" binderror="previewImageError" aria-label="{{person.name}}照片" /></view></view>
          <view wx:elif="{{entry.id === 'pacer' && previewTarget}}" class="shortcut-pace"><text class="shortcut-time">{{previewTarget}}</text><text>完赛目标</text></view>
          <view wx:else class="shortcut-wordmark">{{entry.id === 'athlete' ? '42.195' : '稳稳领跑'}}<text wx:if="{{entry.id === 'athlete'}}"> km</text></view>
          <text class="shortcut-arrow">↗</text>
        </view>
      </button>
    </view>
    <view class="section-caption"><text class="caption-title">{{heading}}</text><text wx:if="{{ready && !message && total}}">{{total}} {{tab === 'pacer' ? '位官兔' : isProfile ? '位运动员' : '篇内容'}}</text></view>
    <view wx:if="{{tab === 'athlete'}}" class="athlete-season">{{seasonYear}}赛季 · 全程马拉松</view>
    <view wx:if="{{tab === 'athlete'}}" class="gender-tabs"><button class="{{gender === 'men' ? 'on' : ''}}" data-gender="men" bindtap="setGender" aria-label="查看男子运动员">男子</button><button class="{{gender === 'women' ? 'on' : ''}}" data-gender="women" bindtap="setGender" aria-label="查看女子运动员">女子</button></view>
    <view wx:if="{{tab === 'pacer'}}" class="pacer-race-filter"><text>配速赛事</text><picker range="{{raceFilterOptions}}" range-key="name" value="{{raceFilterIndex}}" bindchange="setRace"><view class="race-filter-value">{{raceFilterOptions[raceFilterIndex].name}}<text>⌄</text></view></picker><button wx:if="{{raceId || query}}" bindtap="resetPacerFilters">重置</button></view>
    <view wx:if="{{message}}" class="journal-state"><view class="state-icon">!</view><view class="state-title">内容暂时无法加载</view><view>{{message}}</view><button bindtap="load">重新加载</button></view>
    <view wx:elif="{{!ready}}" class="journal-state"><view class="loading-dot"></view>正在加载内容…</view>
    <block wx:else>
      <navigator wx:for="{{rows}}" wx:key="id" class="journal-row {{isProfile ? 'person-row' : ''}}" url="/pages/news/detail?type={{isProfile ? 'profile' : tab === 'race' ? 'race' : 'article'}}&id={{item.id}}">
        <block wx:if="{{isProfile}}">
          <text wx:if="{{tab === 'athlete'}}" class="person-number">{{item.number}}</text>
          <view class="person-portrait"><text>{{item.avatarLabel}}</text><image wx:if="{{!item.imageFailed && (item.avatar || item.photo)}}" src="{{item.avatar || item.photo}}" mode="aspectFill" data-index="{{index}}" binderror="profileImageError" aria-label="{{item.name}}照片" /></view>
          <view class="person-copy"><view class="row-kicker">{{tab === 'pacer' ? (item.gender === 'women' ? '女子 · ' : item.gender === 'men' ? '男子 · ' : '') + '官方配速员' : (item.gender === 'women' ? '女子' : '男子')+' · '+(item.editorialOrigin === 'manual' ? '运动员档案' : (item.seasonYear || seasonYear)+'赛季')}}</view><view class="person-name">{{item.name}}</view><view wx:if="{{tab !== 'pacer'}}" class="row-summary">{{item.seasonEventName || item.eventName || item.bio}}</view><block wx:else><view wx:if="{{item.raceBadges.length}}" class="race-badges"><text wx:for="{{item.raceBadges}}" wx:for-item="badge" wx:key="raceId" class="{{badge.status === 'provisional' ? 'provisional' : ''}}">{{badge.label || badge.raceName}} · {{badge.statusLabel}}</text></view><view wx:else class="row-summary">{{item.pacerRaceLabel}}</view><view wx:if="{{item.verifiedPacerRacesLabel}}" class="verified-race-label">曾任官兔 · {{item.verifiedPacerRacesLabel}}</view></block></view>
          <view class="person-time"><view>{{tab === 'pacer' ? item.pacerTarget : item.seasonBest || item.personalBestDisplay || item.personalBest}}</view><text>{{tab === 'pacer' ? '完赛目标' : item.seasonBest ? '赛季最佳' : '全马 PB'}}</text></view><text class="row-arrow">›</text>
        </block>
        <block wx:else><view class="article-copy"><view class="row-kicker">{{item.raceName ? '赛事资讯' : item.categoryLabel}} <text wx:if="{{item.featured}}" class="featured-tag">精选</text></view><view class="article-title">{{item.title}}</view><view wx:if="{{item.summary}}" class="row-summary">{{item.summary}}</view><view class="row-meta"><text>{{item.authorLabel}}</text><text>{{item.dateLabel}}</text></view></view><image wx:if="{{item.coverUrl && !item.imageFailed}}" class="article-photo" src="{{item.coverUrl}}" mode="aspectFill" data-index="{{index}}" binderror="profileImageError" /></block>
      </navigator>
      <view wx:if="{{!rows.length}}" class="journal-state"><view class="state-icon">＋</view><view class="state-title">{{query ? '还没找到相关内容' : clubId ? '还没有发布跑团资讯' : isProfile ? '人物资料正在整理' : '这个栏目还没有新内容'}}</view><view>{{query ? '换一个关键词试试。' : clubId ? '分享团练心得、赛事回顾或公众号好文。' : '稍后再来看看，或先逛逛其他栏目。'}}</view><navigator wx:if="{{clubId && canManage}}" url="/pages/news/editor?club={{clubId}}">发布第一篇</navigator><button wx:elif="{{!isProfile && !clubId}}" data-tab="athlete" bindtap="switchTab">浏览运动员档案</button></view>
      <view wx:if="{{pages > 1}}" class="journal-pager"><button disabled="{{page <= 1}}" bindtap="prevPage">上一页</button><text>{{page}} / {{pages}}</text><button disabled="{{page >= pages}}" bindtap="nextPage">下一页</button></view>
    </block>
  </view>
</view>
