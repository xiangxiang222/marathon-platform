/* Compact directory entries use the shared original artwork, never a generic portrait. */
.journal-shortcuts{gap:20rpx;margin-bottom:36rpx}
.journal-shortcuts>button{display:grid;grid-template-columns:minmax(0,1fr) 40px;grid-template-rows:36px auto;column-gap:4px;row-gap:3px;min-height:80px;padding:18rpx 22rpx;border-color:#f4e7de;border-radius:10px;background:#fff8f2}
.journal-shortcuts>button:nth-child(2){border-color:#f2e0e4;background:#fff6f7}
.shortcut-title{align-self:center;min-width:0;color:var(--text);font-size:14px;font-weight:600;line-height:1.3;white-space:nowrap}
.shortcut-art{grid-column:2;grid-row:1/3;align-self:center;width:40px;height:48px}
.shortcut-subtitle{grid-column:1;min-width:0;color:var(--text-secondary);font-size:12px;font-weight:400;line-height:1.4;white-space:normal}
.journal-search button{flex:0 0 56px;width:56px;height:44px;min-height:44px;min-width:0;padding:0;border-radius:7px;color:#fff;background:transparent;font-size:13px;font-weight:600;line-height:1.4}
.journal-search button>text{display:flex;align-items:center;justify-content:center;width:56px;height:34px;border-radius:7px;background:var(--brand)}
.journal-content{min-height:560rpx}
.journal-state{padding:60rpx 22rpx}
@media(max-width:350px){.journal-shortcuts>button{grid-template-columns:minmax(0,1fr) 32px;padding:18rpx 16rpx;column-gap:3px}.shortcut-art{width:32px;height:44px}.shortcut-subtitle{grid-column:1/-1}.journal-search{padding-right:12rpx}.journal-search input{font-size:13px}}

/* Sourced portraits and official pacer group publications. */
.journal-row.person-row{gap:18rpx;min-height:172rpx}
.person-row .person-number{width:34rpx;flex:none;font-size:13px;font-variant-numeric:tabular-nums}
.person-portrait,.profile-portrait{position:relative;display:flex;align-items:center;justify-content:center;flex:none;overflow:hidden;background:var(--page-bg);color:var(--brand);border-radius:50%;width:84rpx;height:84rpx;font-size:17px;font-weight:600}
.person-portrait image,.profile-portrait image{position:absolute;left:0;top:0;width:100%;height:100%}
.person-portrait.race-portrait{width:106rpx;height:122rpx;border-radius:14rpx;font-size:13px}
.person-row .person-copy{flex:1;min-width:0}
.person-row .person-name{font-size:16px;line-height:1.45;margin:6rpx 0}
.person-row .person-copy .row-summary{font-size:12px;line-height:1.55}
.person-row .person-time{min-width:128rpx;max-width:156rpx;flex:none}
.person-row .person-time>view{font-size:17px;line-height:1.4;font-variant-numeric:tabular-nums}
.person-row .person-time>text{font-size:12px}
.article-photo{width:186rpx;height:148rpx;flex:none;border-radius:14rpx;background:var(--page-bg)}
.profile-identity{display:flex;align-items:center;gap:26rpx}
.profile-hero-copy{flex:1;min-width:0}
.profile-identity .profile-portrait{width:136rpx;height:136rpx;font-size:23px}
.profile-identity .profile-name{font-size:24px;line-height:1.4;margin:10rpx 0}
.section-small{font-size:12px;font-weight:400;color:var(--text-secondary);margin-left:12rpx}
.pacer-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}
.pacer-group{padding:26rpx 22rpx;background:var(--page-bg);border:1rpx solid var(--border);border-radius:18rpx;min-width:0}
.pacer-group-title{display:block;color:var(--brand);font-size:22px;line-height:1.3;font-weight:600;font-variant-numeric:tabular-nums}
.pacer-group-label{font-size:12px;color:var(--text-secondary);line-height:1.6;margin-top:8rpx}
.pacer-group-names{font-size:13px;line-height:1.65;color:var(--text);margin-top:14rpx}
.pacer-gallery-card{margin:26rpx 0;overflow:hidden;background:var(--page-bg);border:1rpx solid var(--border);border-radius:18rpx}
.pacer-gallery-card image{display:block;width:100%}
.photo-caption{font-size:12px;color:var(--text-secondary);line-height:1.75;padding:18rpx 22rpx}
.pacer-gallery-card .source-button{padding:0 22rpx 14rpx;min-height:40px}
.detail-cover-photo{display:block;width:100%;margin:40rpx 0;border-radius:18rpx}
@media(max-width:350px){.person-row .person-portrait{width:70rpx;height:70rpx}.person-row .race-portrait{width:84rpx;height:106rpx}.person-row .person-time{min-width:116rpx;max-width:136rpx}.person-row .person-time>view{font-size:15px}.person-row .person-number{width:28rpx}.journal-row.person-row{gap:14rpx}.article-photo{width:144rpx;height:132rpx}.profile-identity .profile-portrait{width:106rpx;height:106rpx}.profile-identity .profile-name{font-size:22px}.pacer-group{padding:22rpx 18rpx}}
.personal-records{border:1rpx solid var(--border);border-radius:18rpx;overflow:hidden}.personal-record{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8rpx 22rpx;padding:24rpx 26rpx;border-bottom:1rpx solid var(--border);font-size:13px}.personal-record:last-child{border:0}.personal-record>text:nth-child(2){font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}.personal-record>view{font-size:12px;color:var(--text-secondary);line-height:1.6;align-self:center}.personal-record .source-button{align-self:center;font-size:12px;min-height:30px;padding:0;justify-content:flex-end}
