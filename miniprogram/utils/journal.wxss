/* Reading and profile pages share the race page's typography and controls. */
.journal-page{min-height:100vh;padding-bottom:24px;background:#fff;color:var(--text);font-size:14px}
.journal-top{display:flex;align-items:center;justify-content:space-between;min-height:56px;padding:0 16px;border-bottom:1px solid var(--border);background:#fff}
.journal-top>a:first-child{display:flex;align-items:center;width:44px;min-height:44px;font-size:24px}.journal-top>span:nth-child(2){font-size:16px;font-weight:600}.top-spacer,.edition{width:44px}.edition{color:var(--text-secondary);font-size:12px}.publish-link{display:flex;align-items:center;justify-content:flex-end;min-height:44px;color:var(--brand);font-size:14px}
.journal-intro{padding:24px 16px 0;background:#fff}.journal-heading{margin:0 0 8px;font-size:24px;line-height:1.4}.journal-subtitle{margin:0;color:var(--text-secondary);font-size:12px;line-height:1.6}
.journal-search{display:flex;align-items:center;gap:10px;height:46px;margin-top:16px;padding:0 4px 0 12px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg)}.search-icon{position:relative;flex:none;width:14px;height:14px;margin-right:3px;border:1.5px solid var(--text-secondary);border-radius:50%}.search-icon:after{position:absolute;right:-4px;bottom:-2px;width:6px;height:1.5px;background:var(--text-secondary);transform:rotate(45deg);content:''}
.journal-search input{flex:1;min-width:0;width:0;min-height:44px;padding:0;border:0;outline:0;background:transparent;font-size:14px}.journal-search button{display:flex;align-items:center;justify-content:center;flex:0 0 56px;min-height:44px;width:56px;padding:0;background:transparent;color:#fff;font-size:14px}.journal-search button>span{display:flex;align-items:center;justify-content:center;width:56px;height:34px;border-radius:6px;background:var(--brand)}
.journal-content{min-height:300px;padding:0 16px 24px;background:#fff}.journal-tabs{display:flex;justify-content:space-between;gap:16px;overflow-x:auto;margin:8px 0 20px;border-bottom:1px solid var(--border);scrollbar-width:none}.journal-tabs::-webkit-scrollbar{display:none}.journal-tab{position:relative;display:flex;align-items:center;flex:none;min-height:48px;color:var(--text-secondary);font-size:14px;white-space:nowrap}.journal-tabs .selected{color:var(--brand);font-weight:600}.journal-tabs .selected:after{position:absolute;bottom:0;left:50%;width:20px;height:3px;border-radius:2px;background:var(--brand);transform:translateX(-50%);content:''}
.journal-shortcuts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0 0 24px}.journal-shortcuts>button{display:grid;grid-template-columns:minmax(0,1fr) 12px;gap:6px;align-items:center;min-height:76px;padding:12px;border:1px solid var(--border);border-radius:8px}.shortcut-title{font-size:15px;font-weight:500}.shortcut-subtitle{grid-column:1/-1;color:var(--text-secondary);font-size:12px;line-height:1.5}.shortcut-arrow{color:var(--text-secondary);font-size:20px}
.section-caption{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 8px}.caption-title{margin:0;font-size:18px;line-height:1.5}.section-caption>text{flex:none;color:var(--text-secondary);font-size:12px}.athlete-season{margin:0 0 12px;color:var(--text-secondary);font-size:12px;line-height:1.6}.gender-tabs{display:flex;gap:8px;width:100%;min-width:0;margin:0 0 8px}.gender-tabs button{flex:1;width:0;min-width:0;min-height:44px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text-secondary);font-size:14px}.gender-tabs .on{border-color:var(--brand);background:var(--brand-soft);color:var(--brand);font-weight:500}.ranking-note{margin:12px 0;padding:12px;border-radius:8px;background:var(--page-bg);color:var(--text-secondary);font-size:12px;line-height:1.75}
.journal-row{display:flex;align-items:center;gap:12px;padding:18px 0;border-bottom:1px solid var(--border)}.article-copy,.person-copy{flex:1;min-width:0}.row-kicker{display:flex;align-items:center;gap:8px;color:var(--text-secondary);font-size:12px;line-height:1.5}.featured-tag{padding:0 4px;border-radius:3px;background:var(--brand-soft);color:var(--brand);font-size:12px;font-style:normal}.article-title{display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin:6px 0;font-size:15px;font-weight:500;line-height:1.6;overflow-wrap:anywhere}.row-summary{display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin:0 0 8px;color:var(--text-secondary);font-size:12px;line-height:1.75}.row-meta{display:flex;justify-content:space-between;gap:8px;color:var(--text-secondary);font-size:12px;line-height:1.5}.row-meta>text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-meta>text:last-child{flex:none;font-variant-numeric:tabular-nums}.article-photo{flex:none;width:88px;height:72px;border-radius:6px;background:var(--page-bg);object-fit:cover}.row-arrow{flex:none;color:var(--text-secondary);font-size:20px}
.journal-row.person-row{min-height:92px;gap:10px}.person-number{flex:none;width:20px;color:var(--text-secondary);font-size:12px;font-variant-numeric:tabular-nums}.person-portrait,.profile-portrait{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;flex:none;width:44px;height:44px;border-radius:50%;background:var(--page-bg);color:var(--text-secondary);font-size:16px;font-weight:500}.person-portrait image,.profile-portrait image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.person-name{font-size:15px;font-weight:600}.person-copy .row-summary{margin:0;-webkit-line-clamp:1}.person-time{display:flex;align-items:flex-end;flex-direction:column;flex:none;gap:4px;min-width:68px;max-width:82px;text-align:right}.person-time>view{font-size:17px;font-variant-numeric:tabular-nums;line-height:1.4;overflow-wrap:anywhere}.person-time>text{color:var(--text-secondary);font-size:12px}
.journal-state{padding:40px 16px;color:var(--text-secondary);font-size:14px;line-height:1.75;text-align:center}.state-title{display:block;color:var(--text);font-size:18px}.state-description{max-width:280px;margin:8px auto 16px;font-size:14px}.state-titleutton,.journal-state navigator{display:inline-flex;align-items:center;justify-content:center;width:auto;min-height:44px;padding:0 16px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--brand);font-size:14px}.state-icon{display:flex;align-items:center;justify-content:center;width:40px;height:40px;margin:0 auto 16px;border-radius:50%;background:var(--page-bg);font-size:22px}.loading-dot{display:block;width:20px;height:20px;margin:0 auto 12px;border:2px solid var(--border);border-top-color:var(--brand);border-radius:50%}
.journal-detail{padding:24px 16px;background:#fff}.detail-kicker{margin:0 0 12px;color:var(--text-secondary);font-size:12px;line-height:1.6}.detail-title{margin:0 0 16px;font-size:24px;line-height:1.5;overflow-wrap:anywhere}.detail-meta{display:flex;gap:16px;padding-bottom:16px;border-bottom:1px solid var(--border);color:var(--text-secondary);font-size:12px}.detail-summary{margin:24px 0;padding:0 0 0 12px;border-left:2px solid var(--border);color:var(--text-secondary);font-size:16px;line-height:1.85}.journal-detail .md{margin:20px 0;color:var(--text);font-size:16px;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere}.journal-detail .md-h1{font-size:24px;font-weight:600}.journal-detail .md-h2{margin-top:28px;font-size:18px;font-weight:600}.journal-detail .md-h3,.journal-detail .md-h4{margin-top:24px;font-size:16px;font-weight:600}.md-mark{margin-right:8px;color:var(--text-secondary)}
.profile-hero{margin:0 0 24px;padding:0 0 20px;border-bottom:1px solid var(--border)}.profile-identity{display:flex;align-items:center;gap:16px}.profile-hero-copy{flex:1;min-width:0}.profile-identity .profile-portrait{width:64px;height:64px;border-radius:8px;font-size:24px}.profile-name{margin:4px 0}.profile-en{margin:0;color:var(--text-secondary);font-size:12px}.pb-panel{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border);color:var(--text-secondary);font-size:12px}.pb-panel>text:last-child{color:var(--text);font-size:32px;font-variant-numeric:tabular-nums;text-align:right;overflow-wrap:anywhere}.profile-fact{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border);font-size:14px;line-height:1.7}.profile-fact>text:first-child{flex:none;color:var(--text-secondary)}.profile-fact>text:last-child{min-width:0;font-weight:500;text-align:right;overflow-wrap:anywhere}
.profile-section{margin:24px 0}.profile-section-title{margin:0 0 12px;font-size:18px;line-height:1.5}.section-small,.section-small{margin-left:6px;color:var(--text-secondary);font-size:12px;font-weight:400}.profile-bio{font-size:16px;line-height:1.9}.evidence-card{padding:12px 0;border-bottom:1px solid var(--border)}.evidence-card>view{margin:0;font-size:14px;line-height:1.8}.personal-records{border-top:1px solid var(--border)}.personal-record{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 12px;padding:14px 0;border-bottom:1px solid var(--border);font-size:14px}.personal-record>text:nth-child(2){font-size:18px;font-variant-numeric:tabular-nums}.personal-record>view{color:var(--text-secondary);font-size:12px;line-height:1.6}.biography-copy{white-space:pre-line}.profile-article{margin:24px 0}.profile-article-title{margin:0 0 16px;font-size:18px;line-height:1.6}.profile-article-lead{margin:0 0 24px;color:var(--text-secondary);font-size:16px;line-height:1.85}
.pacer-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pacer-group{min-width:0;padding:14px;border:1px solid var(--border);border-radius:8px}.pacer-group-title{font-size:24px;font-variant-numeric:tabular-nums}.pacer-group-label{display:block;margin-top:4px;color:var(--text-secondary);font-size:12px}.profile-section .pacer-group-names{margin:8px 0 0;font-size:14px;line-height:1.7}.pacer-assignment{margin:12px 0;padding:16px;border:1px solid var(--border);border-radius:10px}.assignment-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.assignment-target{font-size:24px;font-weight:600;font-variant-numeric:tabular-nums;line-height:1.4}.assignment-target>text{margin-left:6px;color:var(--text-secondary);font-size:12px;font-weight:400}.assignment-status{flex:none;color:var(--text-secondary);font-size:12px}.assignment-title{margin:12px 0 6px;font-size:15px;line-height:1.6}.assignment-meta{margin:4px 0;color:var(--text-secondary);font-size:12px;line-height:1.75}.pacer-gallery-card{overflow:hidden;margin:16px 0;border:1px solid var(--border);border-radius:8px}.pacer-gallery-card image,.detail-cover-photo{display:block;width:100%;height:auto}.detail-cover-photo{margin:24px 0;border-radius:8px}.pacer-gallery-card figcaption,.photo-caption{padding:12px;color:var(--text-secondary);font-size:12px;line-height:1.7}
.pacer-race-filter{display:flex;align-items:center;gap:10px;margin:12px 0;color:var(--text-secondary);font-size:12px}.pacer-race-filter>text{flex:none}.pacer-race-filter select{flex:1;min-width:0;height:44px;padding:0 10px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font-size:14px}.pacer-race-filter button{flex:none;min-height:44px;color:var(--brand);font-size:14px}.race-badges,.verified-races{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin:8px 0}.race-badges>text,.verified-races>text:not(:first-child){padding:2px 5px;border-radius:4px;background:var(--page-bg);color:var(--text-secondary);font-size:12px;line-height:1.65;font-weight:400;overflow-wrap:anywhere}.race-badges .provisional{background:var(--brand-soft);color:var(--brand)}.verified-races>text:first-child,.verified-race-label{color:var(--text-secondary);font-size:12px;line-height:1.65}
.source-box{margin-top:24px;padding-top:16px;border-top:1px solid var(--border);color:var(--text-secondary);font-size:12px;line-height:1.8}.source-box a,.source-box button,.detail-back{display:inline-flex;align-items:center;min-height:44px;padding:8px 0;color:var(--brand);font-size:14px;overflow-wrap:anywhere}.detail-back{margin-top:24px;border-top:1px solid var(--border)}
.journal-editor{padding:24px 16px}.journal-editor>p{color:var(--text-secondary);font-size:14px;line-height:1.8}.journal-editor form,.editor-preview,.editor-list{margin:20px 0;padding:16px;border:1px solid var(--border);border-radius:12px;background:#fff}.journal-editor label{display:block;margin:16px 0 8px;font-size:14px}.journal-editor input,.journal-editor select,.journal-editor textarea{width:100%;min-height:44px;padding:12px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font:inherit}.journal-editor textarea{min-height:160px;line-height:1.8}.editor-actions{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}.editor-actions button{flex:1;min-width:0;min-height:44px;padding:8px 12px;border:1px solid var(--border);border-radius:8px;background:#fff;font-size:14px}.editor-actions .editor-primary{background:var(--brand);border-color:var(--brand);color:#fff}.editor-notice{color:var(--text-secondary);font-size:12px;line-height:1.8}.editor-list h2,.editor-preview h2{font-size:18px}.editor-list>button{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:56px;border-bottom:1px solid var(--border);font-size:14px;text-align:left}.editor-list small,.editor-preview small{color:var(--text-secondary);font-size:12px}
@media(max-width:350px){.journal-tabs{gap:12px}.journal-row.person-row{gap:8px}.person-portrait{width:36px;height:36px}.person-time{min-width:66px;max-width:72px}.person-time>view{font-size:16px}.person-number{width:16px}.article-photo{width:72px;height:68px}.journal-shortcuts>button{padding:10px}.shortcut-title{font-size:14px}.pb-panel>text:last-child{font-size:28px}}

/* Native controls have their own default full-width rule; size every action explicitly. */
.journal-page button{width:auto;margin:0;box-shadow:none}.journal-shortcuts>button{width:100%;min-width:0;text-align:left;background:#fff;color:var(--text)}
.journal-tabs{display:block;white-space:nowrap}.journal-tab{display:inline-flex;margin-right:16px}.journal-tab:last-child{margin-right:0}
.journal-search button{width:56px;border:0}.journal-search button>text{display:flex;align-items:center;justify-content:center;width:56px;height:34px;border-radius:6px;background:var(--brand)}
.gender-tabs button{width:0}.journal-pager{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:24px;color:var(--text-secondary);font-size:12px}.journal-pager button{min-height:44px;padding:0 8px;border:0;background:transparent;color:var(--brand);font-size:14px}
.profile-name{font-size:24px;font-weight:600;line-height:1.5}.profile-section-title{font-weight:600}.profile-fact>text:last-child{font-weight:500}.pb-panel>text:last-child{font-weight:600}
.profile-article-title{margin:0 0 16px;font-size:18px;font-weight:600;line-height:1.6}.source-button{display:flex;align-items:center;min-height:44px;padding:8px 0;border:0;background:transparent;color:var(--brand);font-size:14px}
.pacer-race-filter>picker{flex:1;min-width:0}.race-filter-value{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;padding:0 12px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font-size:14px}
.journal-editor{padding:24px 16px}.editor-heading{font-size:24px;font-weight:600}.editor-subtitle{margin:8px 0 24px;color:var(--text-secondary);font-size:14px;line-height:1.7}.editor-label{margin:16px 0 8px;font-size:14px}.journal-editor input,.journal-editor textarea,.journal-editor picker{width:100%;min-height:44px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);font-size:14px;padding:12px}.journal-editor textarea{min-height:160px;line-height:1.8}.editor-actions button{width:0;flex:1;min-width:0;min-height:44px}.editor-list-heading{font-size:18px;font-weight:600}.editor-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:12px 0;border-bottom:1px solid var(--border);font-size:14px}.editor-row>text:last-child{flex:none;color:var(--text-secondary);font-size:12px}.editor-preview-title{font-size:18px;font-weight:600}.editor-preview{white-space:pre-wrap;font-size:16px;line-height:1.9}
