.service-page .card,.service-page .panel,.service-page .detail-state,.service-page .meetup-state { margin:0 0 12px; padding:16px; border:1px solid var(--border); border-radius:12px; background:#fff; box-shadow:none; }
.service-page .title,.service-page .hero-title,.service-page .signup-title,.service-page.intro-page .club-name,.service-page .editor-title { font-size:24px; font-weight:600; line-height:1.45; }
