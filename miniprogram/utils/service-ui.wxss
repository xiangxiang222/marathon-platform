.service-page .btn,.service-page .primary { width:100%; min-height:44px; padding:10px 16px; border:1px solid var(--brand); border-radius:8px; background:var(--brand); color:#fff; font-size:14px; font-weight:500; }
.service-page .ghost,.service-page .secondary { display:flex; align-items:center; justify-content:center; width:auto; min-height:44px; padding:8px 12px; border:1px solid var(--border); border-radius:8px; background:#fff; color:var(--text); font-size:13px; }
.service-page .row { min-height:52px; padding:12px 0; gap:12px; font-size:14px; }
.service-page .sum { margin-top:12px; padding:10px 12px; border-radius:8px; background:var(--page-bg); color:var(--text); font-size:14px; font-weight:500; }
