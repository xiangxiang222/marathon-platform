/* Service pages use the same controls and hierarchy as the race catalogue. */
.service-page { --brand:#ff1838; --brand-soft:#fff0f2; --page-bg:#f5f5f5; --surface:#fff; --text:#1a1a1a; --text-secondary:#777; --border:#eee; color:var(--text); background:var(--page-bg); font-size:14px; line-height:1.5; }
.service-page button { width:auto; min-width:44px; min-height:44px; margin:0; border-radius:8px; font-size:14px; font-weight:500; line-height:1.4; box-shadow:none; }
.service-page button::after { border:0; }
.service-page input,.service-page textarea,.service-page .picker-field { min-width:0; min-height:44px; border:1px solid var(--border); border-radius:8px; color:var(--text); background:var(--page-bg); font-size:14px; }
