/* Race-page red/black/white system for personal pages. */
.sport-page,.mine-page,.runner-page,.history-page,.studio-page,.feedback-page,.privacy-page,.legal-page {--page-bg:#f5f5f5;--surface:#fff;--text:#1a1a1a;--text-secondary:#777;--border:#eee;--brand:#ff1838;--brand-soft:#fff0f2;color:#1a1a1a;font-size:14px;font-weight:400;line-height:1.5}
.feedback-page .feedback-hero {padding:20px 16px;border:1rpx solid #eee;border-radius:12px;background:#fff}
.feedback-page .hero-title {font-size:20px;font-weight:600}
.feedback-page .hero-stats {background:#fff;border-top:1rpx solid #eee}
.feedback-page .primary {min-height:44px;border-radius:8px;background:#ff1838;color:#fff}
.privacy-page .title,.legal-page .title {font-size:24px;font-weight:600}

.achievement-studio{--page-bg:#f5f5f5;--brand:#ff1838;--brand-soft:#fff0f2;color:#1a1a1a;background:#f5f5f5;font-size:14px}
.privacy-page .privacy-copy,.legal-page .legal-copy,.legal-page .doc-paragraph,.legal-page .doc-list,.legal-page .guide-md{font-size:16px;line-height:1.8}
.privacy-page .privacy-title{font-size:24px;font-weight:600}

.header-settings{width:auto;flex:none;white-space:nowrap;min-height:44px;height:44px;color:#555}
.header-settings>text{flex:none}
.settings-gear{font-size:18px}

.legal-page .paragraph,.legal-page .list-item{font-size:16px;line-height:1.8}


/* Compact identity, personal services and activity records. */
.sport-page,.mine-page{padding:12px 16px 24px}
.sport-page button,.mine-page button{width:auto;min-width:0;font-size:14px;border-radius:8px}
.sport-page .surface,.mine-page .surface{padding:16px;margin-bottom:12px;border:0;border-radius:12px;background:#fff;box-shadow:none}
.mine-page .account-hero{padding:0;overflow:hidden;background:linear-gradient(115deg,#fff1f3,#fff 80%)}
.mine-page .identity-panel{display:block;min-height:0;padding:18px 16px 14px;background:transparent}
.mine-page .identity-copy{width:100%;min-width:0}
.mine-page .identity-kicker{display:none}
.mine-page .hero-line{display:flex;align-items:center;gap:12px;margin:0}
.mine-page .hero-avatar{width:50px;height:50px;flex:none;border:2px solid #fff;border-radius:50%;background:#fff;color:#ff1838;font-size:22px}
.mine-page .hero-copy{flex:1;min-width:0}
.mine-page .nickname{font-size:20px;line-height:1.4;font-weight:600}
.mine-page .hero-copy .subtitle{margin-top:4px;font-size:12px;line-height:1.6;color:#777}
.mine-page .role-tag{display:inline-block;margin-top:5px;padding:1px 5px;border-radius:3px;background:#fff0f2;color:#ff1838;font-size:12px}
.mine-page .account-stats{display:flex;margin:0;padding:12px 0 14px;border:0;background:rgba(255,255,255,.65)}
.mine-page .account-stats>view,.mine-page .account-stats>navigator{display:flex;flex-direction:column;align-items:center;flex:1;min-width:0;min-height:44px;padding:0;border:0;border-right:1rpx solid #eee;border-radius:0;background:transparent}
.mine-page .account-stats>navigator{border-right:0}
.mine-page .account-stats .stat-value{font-size:23px;font-weight:600;line-height:1.3;color:#1a1a1a}
.mine-page .account-stats .stat-label{margin-top:4px;font-size:12px;color:#777}
.mine-page .main-tabs{display:flex;margin:0 0 12px;padding:0;border:0;border-radius:0;background:transparent;gap:0}
.mine-page .main-tabs>view{position:relative;flex:1;min-width:0;min-height:46px;padding:0;border:0;border-radius:0;background:transparent;color:#777;font-size:14px;font-weight:400;line-height:46px;white-space:nowrap;text-align:center}
.mine-page .main-tabs>view.on{color:#1a1a1a;background:transparent;font-weight:600}
.mine-page .main-tabs>view.on::after{position:absolute;right:auto;bottom:0;left:50%;width:20px;height:3px;border-radius:2px;background:#ff1838;transform:translateX(-50%);content:''}
.mine-page .weekly-card{padding:16px}
.mine-page .dashboard-head{padding:0;margin:0;min-height:28px}
.mine-page .section-title{font-size:18px;font-weight:600}
.mine-page .dashboard-more{font-size:12px;min-height:32px;line-height:32px;color:#777}
.mine-page .weekly-content{padding:0;gap:12px;margin:10px 0 14px;align-items:flex-end}
.mine-page .weekly-value{font-size:34px;font-weight:600;line-height:1.15;letter-spacing:-.5px}
.mine-page .weekly-value>text{margin-left:6px;font-size:12px;font-weight:400;letter-spacing:0;color:#777}
.mine-page .weekly-meta{margin-top:6px;font-size:12px}
.mine-page .weekly-chart{width:128px;gap:7px}
.mine-page .weekly-bar{width:11px}
.mine-page .weekly-plot{height:44px;border-radius:3px;background:#f7f7f7}
.mine-page .weekly-fill{background:#ffb8c2;border-radius:3px}
.mine-page .weekly-fill.today{background:#ff1838}
.mine-page .weekly-bar>text{font-size:12px}
.mine-page .weekly-compare{display:none}
.mine-page .weekly-footer{min-height:34px;padding:10px 0 0;border-top:1rpx solid #f0f0f0;font-size:12px;background:transparent}
.mine-page .weekly-footer>view{font-size:12px}
.mine-page .next-race{display:flex;align-items:center;gap:12px;background:linear-gradient(110deg,#fff5f6,#fff 72%)}
.mine-page .next-days{width:46px;height:56px;flex:none;min-height:0;border:0;border-radius:7px;background:#fff;color:#ff1838}
.mine-page .next-days>text:first-child{font-size:25px;line-height:1.1;font-weight:600}
.mine-page .next-days>text:last-child{font-size:12px}
.mine-page .next-copy{flex:1;min-width:0}
.mine-page .dashboard-eyebrow{font-size:12px}
.mine-page .next-name{font-size:15px;line-height:1.45;font-weight:600;margin:3px 0}
.mine-page .next-copy .subtitle{font-size:12px;line-height:1.6}
.mine-page .career-heading{font-size:18px}
.mine-page .career-best-grid{display:flex;gap:0;margin:13px 0 0}
.mine-page .career-best-grid>navigator{flex:1;min-width:0;padding:0 12px 4px 0;border:0;border-radius:0;background:transparent}
.mine-page .career-best-grid>navigator+ navigator{padding-left:16px;border-left:1rpx solid #eee}
.mine-page .best-label,.mine-page .best-race{font-size:12px;color:#777}
.mine-page .best-time{margin-top:6px;color:#1a1a1a;font-size:25px;font-weight:600;line-height:1.2;letter-spacing:-.4px}
.mine-page .best-race{margin-top:6px}
.mine-page .compact-poster{display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:8px;margin-top:12px;padding-top:12px;border-top:1rpx solid #f0f0f0;background:transparent}
.mine-page .compact-poster>text{flex:1;min-width:0;font-size:12px;line-height:1.5}
.mine-page .compact-poster button,.mine-page .compact-poster navigator{flex:none;width:auto;min-height:36px;padding:0;margin:0;border:0;background:transparent;color:#ff1838;font-size:12px;white-space:nowrap}
.mine-page .archive-workbench{padding:16px 8px 9px;border:0;border-radius:12px;background:#fff;margin-bottom:12px}
.mine-page .dashboard-heading{padding:0 8px 4px}
.mine-page .dashboard-heading>text{display:none}
.mine-page .runner-entry-grid{display:flex;flex-wrap:wrap;margin:0;padding:0;gap:0}
.mine-page .runner-entry{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;width:25%;min-height:80px;height:auto;padding:8px 1px;border:0;border-radius:0;background:transparent;text-align:center}
.mine-page .runner-entry::before,.mine-page .runner-entry::after{display:none}
.mine-page .service-icon{width:25px;height:25px;margin:3px 0 4px}
.mine-page .entry-title{font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap}
.mine-page .profile-settings{padding:0;margin:0;border:0;border-radius:0;background:transparent}
.mine-page .profile-settings-intro{padding:0 2px 12px}
.mine-page .profile-settings-kicker{display:none}
.mine-page .profile-settings-title{font-size:18px}
.mine-page .profile-settings-note{font-size:12px;margin-top:4px}
.mine-page .profile-clubs-section{display:block}
.mine-page .profile-section{margin:0 0 12px;padding:0;border:0;border-radius:12px;background:#fff;overflow:hidden}
.mine-page .profile-section-title{padding:14px 16px 0;border:0}
.mine-page .profile-section-title>view>view{font-size:14px;font-weight:600}
.mine-page .profile-section-title text{display:none}
.mine-page .profile-section-icon{display:none}
.mine-page .profile-row{margin:0 16px;min-height:64px;padding:12px 0;border:0;border-bottom:1rpx solid #f0f0f0;border-radius:0;background:#fff}
.mine-page .profile-row:last-child{border-bottom:0}
.mine-page .row-copy>view:first-child,.mine-page .row-copy>text{font-size:15px;font-weight:500}
.mine-page .row-copy .subtitle{font-size:12px;font-weight:400}
.mine-page .profile-form,.mine-page .password-form{padding:16px;margin:-4px 0 12px;border-radius:12px;background:#fff}
.mine-page .feedback-entry{padding:14px 16px;margin:12px 0;border:0;border-radius:12px;background:#fff}
.mine-page .feedback-entry-mark{width:28px;height:28px;border:0;background:transparent;color:#555}
.mine-page .feedback-entry-copy>view>text{display:none}
.mine-page .feedback-entry-copy>text{font-size:12px}
.mine-page .career-number{font-size:22px}
.mine-page .career-clock{font-size:18px}
.mine-page .results-summary .stat-label{font-size:12px}
.mine-page .plan-row{padding:14px 0;border-bottom:1rpx solid #f0f0f0}
.mine-page .plan-row:last-child{border:0}
.mine-page .plan-row .race-name{font-size:15px;font-weight:500}
.mine-page .plan-row .subtitle{font-size:12px}
.sport-page .mileage-hero{padding:14px 16px 16px;background:linear-gradient(125deg,#fff2f4,#fff 64%)}
.sport-page .hero-top{align-items:center;gap:8px;padding:0;border:0}
.sport-page .month-caption{display:none}
.sport-page .month-control{gap:2px}
.sport-page .month-step{width:28px;min-height:40px;height:40px;padding:0;border:0;background:transparent;color:#777;font-size:22px}
.sport-page .month-value{height:40px;min-height:40px;padding:0 4px;line-height:40px;background:transparent;font-size:15px}
.sport-page .target-link{width:auto;height:40px;min-height:40px;padding:0;border:0;border-radius:0;background:transparent;color:#ff1838;font-size:12px}
.sport-page .hero-overview{display:block;min-height:0;margin:12px 0}
.sport-page .hero-kicker{font-size:12px;color:#777}
.sport-page .mileage-value{gap:7px;margin-top:3px}
.sport-page .mileage-number{font-size:36px;font-weight:600;line-height:1.2;letter-spacing:-.5px}
.sport-page .mileage-unit{font-size:12px;color:#777}
.sport-page .mileage-footnote{margin-top:5px;font-size:12px;color:#777}
.sport-page .run-metrics{display:flex;padding:12px 0 14px;border:0;gap:8px}
.sport-page .run-metrics>view{flex:1;min-width:0;text-align:left;border:0}
.sport-page .metric-value{font-size:20px;font-weight:600;line-height:1.4}
.sport-page .metric-label{margin-top:3px;font-size:12px}
.sport-page .record-actions{display:flex;margin-top:14px;gap:8px}
.sport-page .record-actions>button{flex:1;width:0;min-height:44px;border-radius:8px;font-size:14px;margin:0}
.sport-page .import-button{background:#f6f6f6;border:0;color:#333}
.sport-page .target-summary{margin:0;padding:10px 0 0;border-top:1rpx solid #eee}
.sport-page .target-copy{font-size:12px}
.sport-page .target-percent{font-size:14px}
.sport-page .progress-track{height:4px;margin:8px 0;background:#eee}
.sport-page .target-caption{margin:0;font-size:12px}
.sport-page .target-prompt{display:flex;align-items:center;gap:8px;width:100%;min-height:44px;margin:0;padding:8px 0 0;border:0;border-top:1rpx solid #eee;border-radius:0;background:transparent;text-align:left}
.sport-page .target-mark{display:none}
.sport-page .target-prompt-copy{flex:1;min-width:0}
.sport-page .target-prompt-title{font-size:13px;font-weight:500}
.sport-page .target-prompt-note{display:none}
.sport-page .target-prompt-more{margin-left:auto;font-size:12px;color:#ff1838;white-space:nowrap}
.sport-page .observe-note{font-size:12px;margin:8px 0 0}
.sport-page .weekly-chart{padding:0;margin:0;background:transparent;border-radius:0}
.sport-page .chart-title,.sport-page .records-title{font-size:18px;font-weight:600}
.sport-page .chart-subtitle{font-size:12px;color:#777;margin-top:3px}
.sport-page .bar-track{height:62px;border-radius:3px;background:#f7f7f7}
.sport-page .bar-value-fill{border-radius:3px;background:#ffb5bf}
.sport-page .bar-value-fill.peak{background:#ff1838}
.sport-page .chart-bars{margin-top:14px;gap:22px}
.sport-page .bar-value,.sport-page .bar-label{font-size:12px}
.sport-page .records-heading{margin:20px 0 10px}
.sport-page .manual-note{margin:0 0 12px;font-size:12px}
.sport-page .run-record .section-title{font-size:15px}
.sport-page .run-date{margin:4px 0 12px;font-size:12px}
.sport-page .record-data{gap:8px;padding:0;border:0}
.sport-page .record-data>view{min-width:0;align-items:flex-start;text-align:left}
.sport-page .record-number{font-size:20px;font-weight:600}
.sport-page .record-unit{font-size:12px;margin-top:3px}
.sport-page .text-button{min-height:32px;padding:0;font-size:12px}
.sport-page .record-details{padding-top:10px;margin-top:10px;border-top:1rpx solid #f0f0f0}
.sport-page .record-editor{padding-top:12px}
.sport-page .guest-state{padding:24px 16px;text-align:left}
.sport-page .guest-mark{display:none}
.sport-page .guest-title{margin:0;font-size:18px}
@media(max-width:350px){.mine-page .weekly-chart{width:104px;gap:5px}
.mine-page .weekly-bar{width:10px}
.mine-page .weekly-value{font-size:30px}
.mine-page .best-time{font-size:22px}
.mine-page .entry-title{font-size:12px}
.mine-page .compact-poster{align-items:flex-start;flex-direction:column;gap:4px}
.sport-page .mileage-number{font-size:34px}
.sport-page .chart-bars{gap:16px}
.sport-page .record-number{font-size:18px}}

/* Native runner archives use the same hierarchy as the personal overview. */
.runner-page{padding:0 16px 24px;background:#f5f5f5}
.runner-page .view-scroll{margin:0 -16px 12px;padding:0 12px;width:auto;background:#fff;border:0}
.runner-page .view-tabs{gap:0;padding:0;display:flex;justify-content:space-between}
.runner-page .view-tab{padding:10px 5px;min-height:44px;font-size:13px;border-radius:0;background:transparent;color:#777}
.runner-page .view-tab.on{background:transparent;color:#1a1a1a;box-shadow:inset 0 -3px #ff1838;font-weight:600}
.runner-page .page-heading{margin:0 -16px;padding:16px;background:linear-gradient(110deg,#fff0f2,#fff 84%)}
.runner-page .page-heading .eyebrow{display:none}
.runner-page .page-title{font-size:24px;font-weight:600;line-height:1.4}
.runner-page .surface{padding:16px;margin-bottom:12px;border:0;border-radius:12px;background:#fff;box-shadow:none}
.runner-page .section-title{font-size:18px;font-weight:600;line-height:1.4}
.runner-page .period-tabs,.runner-page .metric-switch{margin:0 0 12px;padding:3px;border:0;border-radius:8px;background:#ebebeb;gap:2px}
.runner-page .period-tabs>view,.runner-page .metric-switch>view{border:0;min-height:38px;padding:0 8px;border-radius:6px;background:transparent;line-height:38px;color:#777;font-size:13px}
.runner-page .period-tabs>view.on,.runner-page .metric-switch>view.on{background:#fff;color:#1a1a1a}
.runner-page .training-card,.runner-page .career-card{background:linear-gradient(120deg,#fff2f4,#fff 72%)}
.runner-page .training-number{margin:10px 0 12px;font-size:34px;font-weight:600;line-height:1.2;letter-spacing:-.4px}
.runner-page .training-number>text{font-size:12px;font-weight:400;color:#777;margin-left:6px;letter-spacing:0}
.runner-page .training-metrics{gap:8px;padding:0 0 14px;margin:0;border:0;border-bottom:1rpx solid #eee}
.runner-page .training-metrics .metric-value{font-size:18px;line-height:1.4}
.runner-page .metric-label{font-size:12px;margin-top:3px;line-height:1.5}
.runner-page .chart-heading{margin:10px 0;min-height:36px}
.runner-page .period-arrow{min-height:36px;height:36px;width:36px;background:transparent}
.runner-page .chart-heading>text{font-size:14px}
.runner-page .bar-plot{height:88px;border-radius:3px;background:#f7f7f7}
.runner-page .bar-fill{background:#ff1838;border-radius:3px}
.runner-page .bar-label,.runner-page .bar-value{font-size:12px}
.runner-page .data-note{font-size:12px;line-height:1.6;margin-top:12px}
.runner-page .period-comparison{margin-top:12px;padding:10px 0 0;border:0;border-top:1rpx solid #eee;background:transparent;font-size:12px}
.runner-page .two-summary{display:flex;gap:12px}
.runner-page .two-summary>.surface{flex:1;min-width:0;padding:14px 16px}
.runner-page .summary-value{font-size:23px;font-weight:600}
.runner-page .summary-value>text{font-size:12px}
.runner-page .run-row{padding:12px 0;gap:12px}
.runner-page .run-symbol{display:none}
.runner-page .run-name{font-size:15px}
.runner-page .run-distance{font-size:20px}
.runner-page .run-distance>text{font-size:12px}
.runner-page .small-note{font-size:12px;line-height:1.5}
.runner-page .career-hero{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:12px 0 0;padding:0}
.runner-page .career-number{font-size:34px;font-weight:600;line-height:1.2;letter-spacing:0}
.runner-page .career-number .unit{font-size:12px;font-weight:400;color:#777}
.runner-page .career-head-meta{display:flex;flex-direction:column;gap:7px;font-size:12px;color:#777;text-align:right}
.runner-page .career-head-meta>text:last-child{font-size:20px;color:#1a1a1a}
.runner-page .distance-grid{display:flex;flex-wrap:wrap;gap:8px 16px;padding:12px 0;margin:12px 0 0;border-top:1rpx solid #eee;background:transparent}
.runner-page .distance-grid>view{display:flex;flex-direction:row;align-items:baseline;gap:5px;padding:0;min-width:0;background:transparent}
.runner-page .distance-grid .metric-value{font-size:16px;font-weight:500}
.runner-page .career-duration{display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1rpx solid #eee;font-size:12px;color:#777}
.runner-page .career-duration>text:last-child{font-size:14px;color:#333}
.runner-page .career-bottom{margin:0;padding:10px 0 0;border-top:1rpx solid #eee;gap:10px}
.runner-page .career-bottom>view>text:first-child{font-size:16px;font-weight:500}
.runner-page .achievement-poster-entry{padding:10px 0 0;margin:12px 0 0;border:0;border-top:1rpx solid #eee;border-radius:0;background:transparent;font-size:12px;text-align:left}
.runner-page .achievement-poster-entry>view,.runner-page .achievement-poster-entry>text{font-size:12px;line-height:1.6}
.runner-page .history-entry{padding:14px 16px}
.runner-page .history-entry .section-title{font-size:15px}
.runner-page .history-entry .muted{font-size:12px;margin-top:4px}
.runner-page .pb-row{padding:14px 0;gap:10px}
.runner-page .pb-time{font-size:24px;font-weight:600;color:#1a1a1a}
.runner-page .pb-distance{font-size:15px}
.runner-page .pb-name{font-size:12px}
.runner-page .pb-stamp{display:none}
.runner-page .kind-tabs>view{border:0;background:#fff;border-radius:6px;min-height:36px;font-size:13px}
.runner-page .kind-tabs>view.on{border:0;background:#fff0f2;color:#ff1838}
.runner-page .timeline-heading{margin:18px 0 10px}
.runner-page .timeline-row{gap:10px;margin-bottom:10px}
.runner-page .timeline-card{padding:14px;border:0;border-radius:12px;background:#fff}
.runner-page .timeline-name{font-size:15px}
.runner-page .timeline-clock{font-size:22px;color:#1a1a1a}
.runner-page .timeline-date{width:42px;font-size:16px}
.runner-page .timeline-date>text:last-child{font-size:12px}
.runner-page .footprint-hero{background:linear-gradient(120deg,#fff2f4,#fff 80%)}
.runner-page .passport-title{font-size:18px;margin:8px 0 3px;line-height:1.4}
.runner-page .passport-scope{font-size:12px;color:#777}
.runner-page .passport-stats{margin:16px 0 0;padding:0;gap:12px}
.runner-page .passport-stats>view>text:first-child{font-size:26px;font-weight:600}
.runner-page .passport-stats>view>text:last-child{font-size:12px;margin-top:4px}
.runner-page .passport-line{display:none}
.runner-page .city-grid{gap:10px;grid-template-columns:repeat(2,minmax(0,1fr))}
.runner-page .city-card{padding:14px;border:0;border-radius:12px;background:#fff;text-align:left}
.runner-page .city-card.selected{background:#fff0f2;box-shadow:inset 0 0 0 1rpx #ffb8c2}
.runner-page .city-name{font-size:18px}
.runner-page .city-province,.runner-page .city-count{font-size:12px;color:#777}
.runner-page .collection-banner{background:linear-gradient(120deg,#fff2f4,#fff 80%);text-align:left}
.runner-page .collection-banner .muted{font-size:12px;margin-top:5px}
.runner-page .collection-banner .privacy{font-size:12px;margin-top:6px}
.runner-page .gallery-toolbar{gap:8px}
.runner-page .gallery-tabs{flex:1;min-width:0}
.runner-page .gallery-tabs>view{font-size:13px;min-height:38px;line-height:38px}
.runner-page .gallery-item{padding:8px;border:0;border-radius:12px;background:#fff}
.runner-page .gallery-name{font-size:14px}
.runner-page .gallery-meta{font-size:12px}
.runner-page .device-import-card{padding:16px;background:linear-gradient(120deg,#fff2f4,#fff 80%)}
.runner-page .device-wordmark{font-size:12px;font-weight:400;color:#777}
.runner-page .device-import-title{font-size:20px;margin:14px 0 7px;line-height:1.5}
