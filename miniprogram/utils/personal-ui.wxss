/* Race-page red/black/white system for personal pages. */
.sport-page,.mine-page,.runner-page,.history-page,.studio-page,.feedback-page,.privacy-page,.legal-page {--page-bg:#f5f5f5;--surface:#fff;--text:#1a1a1a;--text-secondary:#777;--border:#eee;--brand:#ff1838;--brand-soft:#fff0f2;color:#1a1a1a;font-size:14px;font-weight:400;line-height:1.5}
.runner-page .heading-icon,.runner-page .finish-graphic,.runner-page .run-symbol,.runner-page .empty-mark,.runner-page .collection-icon,.runner-page .passport-line {display:none}
.runner-page .passport-title {font-size:24px;line-height:1.5;font-weight:600}
.runner-page .career-number {font-size:40px;font-weight:600}
.runner-page .career-hero {padding:16px 0}
.runner-page .city-card {border:1rpx solid #eee;border-radius:10px;background:#fff}
.runner-page .city-card.selected {border-color:#ff1838;background:#fff0f2}
.runner-page .city-name {font-size:20px}
.runner-page .collection-banner {text-align:left;background:#fff}
.runner-page .runner-heading {font-size:24px;font-weight:600}
.history-page .history-header,.runner-page .runner-header {background:#fff}
.history-page .empty-symbol {display:none}
.feedback-page .feedback-hero {padding:20px 16px;border:1rpx solid #eee;border-radius:12px;background:#fff}
.feedback-page .hero-title {font-size:20px;font-weight:600}
.feedback-page .hero-stats {background:#fff;border-top:1rpx solid #eee}
.feedback-page .primary {min-height:44px;border-radius:8px;background:#ff1838;color:#fff}
.privacy-page .title,.legal-page .title {font-size:24px;font-weight:600}

.achievement-studio{--page-bg:#f5f5f5;--brand:#ff1838;--brand-soft:#fff0f2;color:#1a1a1a;background:#f5f5f5;font-size:14px}.achievement-studio button{width:auto;border-radius:8px;min-height:44px}.achievement-studio .studio-heading{padding:20px 16px;text-align:left;background:transparent}.achievement-studio .studio-title{font-size:24px;font-weight:600}.achievement-studio .studio-subtitle{font-size:14px;color:#777;line-height:1.7}.achievement-studio .studio-state{border-radius:12px;border:1rpx solid #eee;background:#fff}
.privacy-page .privacy-copy,.legal-page .legal-copy,.legal-page .doc-paragraph,.legal-page .doc-list,.legal-page .guide-md{font-size:16px;line-height:1.8}.privacy-page .privacy-title{font-size:24px;font-weight:600}

.header-settings{width:auto;flex:none;white-space:nowrap;min-height:44px;height:44px;color:#fff}.header-settings>text{flex:none}.settings-gear{font-size:18px}
.runner-page .bar-fill{background:#ff1838}

.legal-page .paragraph,.legal-page .list-item{font-size:16px;line-height:1.8}


