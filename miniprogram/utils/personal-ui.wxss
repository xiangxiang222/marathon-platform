/* Member identity and every content tab retain the team's visibility scope. */
.mp-page{padding:12px 16px 24px;background:#f5f5f5;color:#1a1a1a}
.mp-page .person-hero{padding:14px 16px 0;border:0;border-radius:12px;background:linear-gradient(115deg,#fff1f3,#fff 80%);overflow:hidden}
.mp-page .person-hero-top{margin:0}
.mp-page .person-role{padding:1px 5px;border:0;border-radius:3px;background:#fff0f2;color:#ff1838;font-size:12px}
.mp-page .person-identity{margin-top:12px;gap:12px}
.mp-page .person-avatar{width:50px;height:50px;border:2px solid #fff;border-radius:50%;background:#fff;color:#ff1838}
.mp-page .person-name{font-size:20px;line-height:1.4}
.mp-page .person-group,.mp-page .person-joined{font-size:12px;margin-top:4px;line-height:1.6}
.mp-page .person-hero-metrics{margin:14px -16px 0;padding:12px 0 14px;border:0;background:rgba(255,255,255,.65)}
.mp-page .person-hero-metrics>view{align-items:center;text-align:center}
.mp-page .person-hero-metrics>view>text:first-child{font-size:22px;font-weight:600;line-height:1.3}
.mp-page .person-hero-metrics>view>text:last-child{font-size:12px;margin-top:4px}
.mp-page .person-tabs{margin:0 0 12px;padding:0;border:0;background:transparent}
.mp-page .person-tab{min-height:46px;font-size:14px;background:transparent;color:#777}
.mp-page .person-tab.tab-selected{background:transparent;color:#1a1a1a}
.mp-page .person-tab-line{height:3px;width:20px;background:#ff1838}
.mp-page .mp-card,.mp-page .person-group-card,.mp-page .person-next-race,.mp-page .person-race-card,.mp-page .person-album{padding:16px;margin:0 0 12px;border:0;border-radius:12px;background:#fff;box-shadow:none}
.mp-page .mp-section-head{margin:18px 0 10px}
.mp-page .mp-card>.mp-section-head:first-child{margin:0 0 10px}
.mp-page .mp-section-title{font-size:18px;font-weight:600;line-height:1.4}
.mp-page .mp-text-action{min-height:32px;padding:0;font-size:12px;color:#ff1838;background:transparent}
.mp-page .person-introduction{font-size:14px;line-height:1.8;color:#555}
.mp-page .person-group-icon{display:none}
.mp-page .person-group-card{gap:10px;text-align:left}
.mp-page .person-group-copy>view:first-child{font-size:16px;font-weight:500}
.mp-page .person-group-copy>view:last-child{font-size:12px;line-height:1.6}
.mp-page .person-mini-stats{gap:12px;margin-bottom:12px}
.mp-page .person-mini-stat{padding:14px 16px;border:0;border-radius:12px;background:#fff}
.mp-page .person-mini-label,.mp-page .person-mini-note{font-size:12px;color:#777}
.mp-page .person-mini-stat>view{font-size:24px;font-weight:600;margin:7px 0}
.mp-page .person-mini-stat>view>text{font-size:12px;font-weight:400}
.mp-page .person-next-race{background:linear-gradient(120deg,#fff2f4,#fff 80%)}
.mp-page .person-next-kicker,.mp-page .person-next-meta{font-size:12px}
.mp-page .person-next-title{font-size:15px;font-weight:500;line-height:1.6;margin:6px 0}
.mp-page .person-pb-preview,.mp-page .person-pb-grid{gap:12px;margin-bottom:12px}
.mp-page .person-pb-tile{box-sizing:border-box;width:calc(50% - 6px);min-width:0;padding:14px 16px;border:0;border-radius:12px;background:#fff}
.mp-page .person-pb-clock{font-size:24px;font-weight:600;color:#1a1a1a}
.mp-page .person-pb-top,.mp-page .person-pb-name{font-size:12px;color:#777}
.mp-page .person-photo-strip{gap:6px}
.mp-page .person-photo-strip image{border-radius:7px}
.mp-page .person-section-caption,.mp-page .mp-small-note{font-size:12px;line-height:1.6}
.mp-page .person-ranges{margin:0 0 12px;padding:3px;border:0;border-radius:8px;background:#ebebeb;gap:2px}
.mp-page .person-range{min-height:38px;border-radius:6px;background:transparent;box-shadow:none;color:#777;font-size:13px}
.mp-page .person-range.range-selected{color:#1a1a1a;background:#fff;box-shadow:none}
.mp-page .person-period-control{margin:0 0 12px}
.mp-page .person-period-arrow{width:36px;min-height:36px;height:36px;background:transparent}
.mp-page .person-period{font-size:14px}
.mp-page .person-stats{background:linear-gradient(120deg,#fff2f4,#fff 80%)}
.mp-page .person-distance>text:first-child{font-size:34px;line-height:1.2;font-weight:600;letter-spacing:0}
.mp-page .person-distance-unit{font-size:12px}
.mp-page .person-stat-grid{margin-top:14px;padding-top:12px;border-top:1rpx solid #eee}
.mp-page .person-stat-grid>view>text:first-child{font-size:20px}
.mp-page .person-stat-grid>view>text:last-child{font-size:12px}
.mp-page .person-pace{font-size:12px}
.mp-page .person-pace>text:last-child{font-size:18px}
.mp-page .person-run{padding:12px 0;gap:12px}
.mp-page .person-run-date{font-size:12px}
.mp-page .person-run-info>view:first-child{font-size:15px}
.mp-page .person-run-info>view:first-child>text{font-size:20px}
.mp-page .person-run-meta{font-size:12px}
.mp-page .person-race-filters{margin-bottom:12px;gap:6px}
.mp-page .person-race-filter{font-size:13px;min-height:36px;border:0;border-radius:6px;background:#fff;color:#777}
.mp-page .person-race-filter.filter-selected{background:#fff0f2;color:#ff1838}
.mp-page .person-race-date,.mp-page .person-status{background:#fff0f2;color:#ff1838}
.mp-page .person-race-date.tone-gray,.mp-page .person-status.tone-gray{background:#f5f5f5;color:#777}
.mp-page .person-race-info{font-size:15px}
.mp-page .person-race-card-top{font-size:12px}
.mp-page .person-race-name{font-size:15px;line-height:1.6}
.mp-page .person-race-meta{font-size:12px}
.mp-page .person-result-clock{font-size:20px;color:#1a1a1a}
.mp-page .person-result-name{font-size:15px}
.mp-page .person-result-meta{font-size:12px}
.mp-page .person-album-grid{gap:6px}
.mp-page .person-album-grid image{border-radius:7px}
.mp-page .tone-mint,.mp-page .tone-apricot,.mp-page .tone-lilac,.mp-page .tone-blue{background:#fff;color:#777}
/* History overview and records use compact white modules instead of a long editorial lead. */
.history-page{padding:12px 16px 24px;background:#f5f5f5}
.history-page .page-heading{margin:0 -16px 12px;padding:16px;background:linear-gradient(110deg,#fff0f2,#fff 84%)}
.history-page .page-title{font-size:24px;line-height:1.4;font-weight:600}
.history-page .page-heading .subtitle{font-size:12px;margin-top:5px}
.history-page .card{padding:16px;margin-bottom:12px;border:0;border-radius:12px;background:#fff;box-shadow:none}
.history-page .section-title{font-size:18px;font-weight:600;line-height:1.4}
.history-page .toolbar{margin:0 0 12px;gap:8px}
.history-page .mode-tabs{padding:3px;border:0;border-radius:8px;background:#ebebeb}
.history-page .mode-tabs>view{min-height:38px;padding:0 14px;line-height:38px;border-radius:6px;background:transparent;font-size:14px;color:#777}
.history-page .mode-tabs>view.active{background:#fff;color:#1a1a1a}
.history-page .stats{padding:14px 16px;margin:0 0 12px;border:0;border-radius:12px;background:#fff}
.history-page .stat-number{font-size:24px;font-weight:600;line-height:1.3}
.history-page .stats .muted{font-size:12px;margin-top:4px}
.history-page .growth-hero{background:linear-gradient(120deg,#fff2f4,#fff 80%)}
.history-page .hero-title{font-size:16px;line-height:1.6;margin:10px 0 8px}
.history-page .hero-clock{font-size:32px;font-weight:600;line-height:1.2}
.history-page .hero-change{font-size:12px;line-height:1.6}
.history-page .hero-foot{margin-top:12px;padding-top:12px;border-top:1rpx solid #eee;font-size:14px}
.history-page .hero-foot .muted{font-size:12px;line-height:1.6}
.history-page .list-heading{margin:18px 0 10px}
.history-page .search-field{height:42px;min-height:42px;padding:0 12px;margin:0 0 12px;border:0;border-radius:8px;background:#fff;font-size:14px}
.history-page .timeline{padding:0;border:0}
.history-page .timeline-item{margin-bottom:10px;padding:14px 16px;border:0;border-radius:12px;background:#fff}
.history-page .timeline-item::before{display:none}
.history-page .entry-date{font-size:12px;color:#777}
.history-page .entry-name{font-size:15px;font-weight:500;line-height:1.6}
.history-page .entry-clock{font-size:22px;font-weight:600;line-height:1.3}
.history-page .entry-body .muted{font-size:12px}
.history-page .growth-node{padding:0;margin-top:8px;font-size:12px;background:transparent;color:#ff1838}
.history-page .memory-card{padding:0;margin-bottom:12px;border:0;border-radius:12px;background:#fff;overflow:hidden}
.history-page .memory-card .entry-body{padding:14px}
.history-page .memory-story{font-size:13px;line-height:1.8}
.history-page .memory-note{font-size:12px;line-height:1.7}
.history-page .review-score{padding:16px;background:linear-gradient(120deg,#fff2f4,#fff 80%)}
.history-page .review-clock{font-size:32px}
.history-page .review-card,.history-page .story-card{padding:16px;margin-bottom:12px;border:0;border-radius:12px;background:#fff}
.history-page .import-card{padding:16px}
.history-page .import-actions{gap:8px}
.history-page .import-choice{min-height:76px;padding:12px;border:0;border-radius:8px;background:#f5f5f5}
.history-page .choice-title{font-size:15px}
.history-page .choice-note{font-size:12px}
.history-page .step-note{font-size:12px}
/* Poster controls stay neutral; the generated artwork keeps its chosen theme. */
.achievement-studio{background:#f5f5f5;color:#1a1a1a;font-size:14px}
.achievement-studio button{width:auto;min-width:0}
.achievement-studio .selection-tools{display:flex;align-items:center;gap:8px}
.achievement-studio .selection-tools>text{flex:1;min-width:0;font-size:12px;line-height:1.6}
.achievement-studio .selection-tools>button{flex:none;min-width:36px;min-height:36px;padding:0;margin:0;font-size:12px}
.achievement-studio .studio-heading{padding:18px 16px 14px;text-align:left;background:linear-gradient(115deg,#fff0f2,#fff 85%)}
.achievement-studio .studio-title{font-size:24px;font-weight:600;line-height:1.4}
.achievement-studio .studio-subtitle{font-size:12px;line-height:1.6;margin-top:5px}
.achievement-studio .studio-modes{padding:3px;margin:12px 16px;border:0;border-radius:8px;background:#ebebeb;gap:3px}
.achievement-studio .studio-modes>button{min-height:42px;padding:8px;border:0;border-radius:6px;background:transparent;font-size:14px}
.achievement-studio .studio-modes>button.selected{background:#fff;color:#1a1a1a}
.achievement-studio .studio-preview-wrap{padding:16px;margin:0 16px 12px;border:0;border-radius:12px;background:#fff}
.achievement-studio .studio-preview-label{font-size:12px;margin-bottom:12px}
.achievement-studio .studio-preview{border-radius:4px;box-shadow:0 3px 14px #00000012}
.achievement-studio .studio-preview-placeholder{padding:28px 12px;min-height:160px;border:0;border-radius:8px;background:#f1f1f1}
.achievement-studio .preview-empty-title{font-size:18px}
.achievement-studio .studio-preview-hint{font-size:12px;margin-top:10px}
.achievement-studio .studio-section{padding:16px;margin:0 16px 12px;border:0;border-radius:12px;background:#fff;box-shadow:none}
.achievement-studio .studio-section-heading{margin-bottom:12px;font-size:18px;font-weight:600}
.achievement-studio .studio-section-heading>text{font-size:12px;font-weight:400;color:#777}
.achievement-studio .studio-control-row{min-height:46px;font-size:14px;gap:10px}
.achievement-studio .control-label,.achievement-studio .control-value{font-size:14px;line-height:1.7}
.achievement-studio .control-value{min-width:0;flex:1;text-align:right;white-space:normal}
.achievement-studio .studio-selection{margin-top:8px}
.achievement-studio .selection-row{padding:12px 0;gap:10px;background:transparent;border:0;border-bottom:1rpx solid #f0f0f0;border-radius:0}
.achievement-studio .selection-copy>view{font-size:14px}
.achievement-studio .selection-copy>text{font-size:12px}
.achievement-studio .selection-clock{font-size:18px;font-weight:600;color:#1a1a1a}
.achievement-studio .studio-theme{padding:8px;border:1rpx solid transparent;border-radius:8px;background:#f7f7f7}
.achievement-studio .studio-theme.theme-selected{border-color:#ffb8c2;background:#fff0f2}
.achievement-studio .theme-paper{height:52px}
.achievement-studio .studio-theme>view:last-child{font-size:12px;color:#777}
.achievement-studio .studio-state{padding:24px 16px;margin:12px 16px;border:0;border-radius:12px;background:#fff;text-align:left}
.achievement-studio .state-symbol,.achievement-studio .privacy-mark{display:none}
.achievement-studio .studio-primary,.achievement-studio .studio-outline{min-height:44px;border-radius:8px;font-size:14px}
.achievement-studio .studio-primary{background:#ff1838;border-color:#ff1838}
.achievement-studio .studio-bottom{border-top:1rpx solid #eee;background:#fff}
@media(max-width:350px){.runner-page .view-tab{font-size:12px;padding:10px 4px}
.runner-page .training-number,.runner-page .career-number{font-size:32px}
.runner-page .training-metrics .metric-value{font-size:16px}
.runner-page .pb-time{font-size:21px}
.runner-page .achievement-poster-entry{align-items:flex-start;flex-direction:column;gap:4px}
.mp-page .person-pb-clock{font-size:21px}
.mp-page .person-distance>text:first-child{font-size:32px}
.history-page .entry-clock{font-size:19px}
.achievement-studio .selection-clock{font-size:16px}
.achievement-studio .selection-row{gap:7px}}
