.club-detail { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom)); }
.club-detail .card { box-sizing: border-box; margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #edf0f3; border-radius: 32rpx; }
.club-detail .detail-hero { padding: 38rpx 32rpx; background: linear-gradient(140deg, #fff 62%, #fff4f6); }
.club-detail .detail-hero .h2 { margin: 14rpx 0 20rpx; font-size: 44rpx; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
.club-detail .detail-kicker { color: #ff0a30; font-size: 21rpx; font-weight: 600; letter-spacing: 2rpx; }
.club-detail .h2 { font-size: 31rpx; font-weight: 650; line-height: 1.4; }
.club-detail .src { color: #777d89; font-size: 25rpx; line-height: 1.65; overflow-wrap: anywhere; }
.club-detail .sum { margin-top: 28rpx; padding: 20rpx 24rpx; border-radius: 18rpx; background: #f7f8fa; color: #464b56; font-size: 25rpx; line-height: 1.6; }
.club-detail button.btn, .club-detail button.ghost, .club-detail .fold-toggle { display: flex; align-items: center; justify-content: center; min-height: 88rpx; height: auto; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.35; font-size: 27rpx; text-align: center; }
.club-detail button.btn { margin-top: 24rpx; border-radius: 20rpx; }
.club-detail button.ghost { margin: 16rpx 0 0; border: 1rpx solid #eceef2; border-radius: 20rpx; background: #f7f8fa; color: #555d69; font-size: 25rpx; }
.club-detail button.ghost.on { border-color: #ffb7c3; background: #fff0f3; color: #ff0a30; }
.club-detail button[disabled] { color: #a5a9b2; background: #f0f1f6; }
.club-detail .fold-toggle { justify-content: space-between; width: 100%; min-height: 88rpx; margin: 18rpx 0 0; padding: 16rpx 0; border-radius: 0; background: transparent; color: #777d89; font-size: 25rpx; text-align: left; }
.club-detail .fold-toggle text:last-child { color: #a4a9b2; font-size: 34rpx; }
.club-detail .management-card > .fold-toggle { margin-top: 0; color: #333944; font-size: 29rpx; font-weight: 600; }
.club-detail .share-copy { max-height: 520rpx; margin-top: 12rpx; padding: 24rpx; overflow-y: auto; border-radius: 18rpx; background: #f7f8fa; color: #646b77; font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; }
.club-detail .row { align-items: center; padding: 24rpx 0; font-size: 26rpx; }
.club-detail .row text { min-width: 0; overflow-wrap: anywhere; }
.club-detail .row text:last-child { flex-shrink: 0; max-width: 48%; text-align: right; font-variant-numeric: tabular-nums; }
.club-detail input { height: 88rpx; border: 1rpx solid #eceef2; background: #f7f8fa; font-size: 27rpx; }
.club-detail .detail-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.club-detail .detail-actions button.ghost { flex: 1; margin-top: 0; }

.club-detail .detail-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.club-detail .detail-options button.ghost { flex: 1 1 42%; min-width: 0; margin: 0; }
.club-detail .detail-select { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin-top: 20rpx; padding: 0 24rpx; border: 1rpx solid #eceef2; border-radius: 18rpx; background: #f7f8fa; color: #555d69; font-size: 26rpx; }
