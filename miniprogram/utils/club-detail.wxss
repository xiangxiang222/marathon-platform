.club-detail { min-height: 100vh; box-sizing: border-box; padding: 32rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }
.club-detail .card { box-sizing: border-box; margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #ebebed; border-radius: 36rpx; }
.club-detail .detail-hero { padding: 38rpx 32rpx; background: linear-gradient(140deg, #fff 62%, #fff8f7); }
.club-detail .detail-hero .h2 { margin: 14rpx 0 20rpx; font-size: 22px; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
.club-detail .detail-kicker { color: #e1251b; font-size: 12px; font-weight: 600; letter-spacing: 2rpx; }
.club-detail .h2 { font-size: 16px; font-weight: 600; line-height: 1.4; }
.club-detail .src { color: #737373; font-size: 12px; line-height: 1.65; overflow-wrap: anywhere; }
.club-detail .sum { margin-top: 28rpx; padding: 20rpx 24rpx; border-radius: 18rpx; background: #f7f7f8; color: #595959; font-size: 12px; line-height: 1.6; }
.club-detail button.btn, .club-detail button.ghost, .club-detail .fold-toggle { display: flex; align-items: center; justify-content: center; min-height:44px; height: auto; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.35; font-size: 14px; text-align: center; }
.club-detail button.btn { margin-top: 24rpx; border-radius:24rpx; }
.club-detail button.ghost { margin: 16rpx 0 0; border: 1rpx solid #ebebed; border-radius:24rpx; background: #f7f7f8; color: #595959; font-size: 12px; }
.club-detail button.ghost.on { border-color: #f4bdb8; background: #fff2f0; color: #e1251b; }
.club-detail button[disabled] { color: #737373; background: #f2f2f2; }
.club-detail .fold-toggle { justify-content: space-between; width: 100%; min-height:44px; margin: 18rpx 0 0; padding: 16rpx 0; border-radius: 0; background: transparent; color: #737373; font-size: 12px; text-align: left; }
.club-detail .fold-toggle text:last-child { color: #737373; font-size: 18px; }
.club-detail .management-card > .fold-toggle { margin-top: 0; color: #595959; font-size: 14px; font-weight: 600; }
.club-detail .share-copy { max-height: 520rpx; margin-top: 12rpx; padding: 24rpx; overflow-y: auto; border-radius: 18rpx; background: #f7f7f8; color: #737373; font-size: 12px; line-height: 1.6; white-space: pre-wrap; }
.club-detail .row { align-items: center; padding: 24rpx 0; font-size: 12px; }
.club-detail .row text { min-width: 0; overflow-wrap: anywhere; }
.club-detail .row text:last-child { flex-shrink: 0; max-width: 48%; text-align: right; font-variant-numeric: tabular-nums; }
.club-detail input { height: 88rpx; border: 1rpx solid #ebebed; background: #f7f7f8; font-size: 14px; }
.club-detail .detail-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.club-detail .detail-actions button.ghost { flex: 1; margin-top: 0; }

.club-detail .detail-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.club-detail .detail-options button.ghost { flex: 1 1 42%; min-width: 0; margin: 0; }
.club-detail .detail-select { display: flex; align-items: center; justify-content: space-between; min-height:44px; margin-top: 20rpx; padding: 0 24rpx; border: 1rpx solid #ebebed; border-radius: 18rpx; background: #f7f7f8; color: #595959; font-size: 12px; }
