page { background:#f5f6f8; color:#26352c; }
.mp-page { padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; }
.mp-page view,.mp-page button,.mp-page input,.mp-page textarea { box-sizing:border-box; }
.mp-page button { margin:0; padding:0; min-height:44px; border:0; border-radius:0; background:transparent; color:inherit; font-size:14px; line-height:1.4; font-weight:500; }.mp-page button::after { border:0; }.mp-page button[disabled] { opacity:.45; }
.mp-eyebrow { color:#91a096; font-size:10px; letter-spacing:3rpx; font-weight:600; }.mp-page-title { margin-top:16rpx; font-size:26px; font-weight:700; letter-spacing:-1rpx; }.mp-page-title>text { color:#eb8e61; }.mp-subtitle { margin-top:18rpx; color:#98a39b; font-size:12px; line-height:1.7; }
.mp-section-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:44px; margin:30rpx 2rpx 14rpx; }.mp-section-title { font-size:17px; color:#35483c; font-weight:650; line-height:1.5; }.mp-section-title>text { color:#acb6ae; font-size:12px; margin-left:8rpx; font-weight:400; }.mp-small-note { font-size:10px; color:#9eaaa1; line-height:1.7; }
.mp-page .mp-text-action { min-height:44px; flex:none; font-size:12px; color:#5c9275; }.mp-card { border-radius:28rpx; padding:28rpx; background:#fff; }.mp-empty { padding:36rpx 12rpx; color:#a0ada2; font-size:12px; line-height:1.9; }.mp-empty .mp-section-title { margin-bottom:14rpx; }.mp-footnote { padding:28rpx 4rpx 0; color:#a3aea5; font-size:10px; line-height:1.8; text-align:center; }
.mp-error { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:18rpx 22rpx; margin-bottom:14rpx; border-radius:16rpx; background:#fff1ea; color:#b87a5d; font-size:12px; line-height:1.6; }
.mp-search { display:flex; align-items:center; gap:14rpx; padding:0 20rpx; height:44px; border-radius:14rpx; background:#f5f7f5; color:#a4afa6; }.mp-search>text { font-size:22px; }.mp-search input { flex:1; min-width:0; height:44px; padding:0; margin:0; border:0; background:transparent; font-size:12px; }
.mp-avatar { flex:none; width:72rpx; height:72rpx; border-radius:50%; }.mp-fallback { display:flex; align-items:center; justify-content:center; background:#edf4ee; color:#7e9b86; font-size:15px; font-weight:600; }
.mp-page .mp-primary { min-height:46px; padding:16rpx 28rpx; margin-top:20rpx; background:#3e8c68; color:#fff; border-radius:18rpx; font-size:14px; font-weight:600; }.mp-page .mp-secondary { min-height:46px; padding:16rpx 28rpx; background:#f0f4f1; color:#85988b; border-radius:18rpx; font-size:14px; }
.tone-mint { background:#e9f6f0; color:#34866c; }.tone-blue { background:#ebf2ff; color:#5783bb; }.tone-apricot { background:#fff1e6; color:#cb8b53; }.tone-violet { background:#f1edfb; color:#8a76b0; }.tone-rose { background:#fceef0; color:#bb7886; }.tone-lime { background:#f1f5e5; color:#8b9b51; }
.mp-overlay { position:fixed; z-index:90; inset:0; background:rgba(34,49,40,.24); display:flex; align-items:flex-end; }.mp-sheet { width:100%; padding:24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:36rpx 36rpx 0 0; background:#fff; max-height:90vh; display:flex; flex-direction:column; }.mp-sheet .mp-section-head { margin-top:0; flex:none; }.mp-page .mp-sheet-close { width:44px; min-height:44px; font-size:28px; color:#a4b0a6; }.mp-sheet-body { max-height:62vh; min-height:0; }.mp-label { margin:22rpx 0 14rpx; color:#7d8f81; font-size:12px; }.mp-input { width:100%; height:48px; border:1rpx solid #e6ede7; border-radius:16rpx; padding:0 22rpx; margin:0; background:#f8faf8; color:#435c49; font-size:14px; }.mp-textarea { width:100%; min-height:120px; height:240rpx; padding:20rpx 22rpx; border:1rpx solid #e6ede7; border-radius:16rpx; background:#f8faf8; color:#435c49; font-size:13px; line-height:1.7; }.mp-form-row { display:flex; gap:20rpx; }.mp-form-row>view { flex:1; min-width:0; }
