page{background:var(--page-bg,#f5f5f5);color:var(--text,#1a1a1a)}.mp-page{padding:16px 16px calc(24px + env(safe-area-inset-bottom));color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:14px;line-height:1.5}.mp-page view,.mp-page button,.mp-page input,.mp-page textarea{box-sizing:border-box}.mp-page button{width:auto;min-height:44px;margin:0;padding:0;border:0;border-radius:8px;background:transparent;color:inherit;font-size:14px;line-height:1.5;font-weight:500}.mp-page button::after{border:0}.mp-page button[disabled]{opacity:.45}.mp-page-title{margin:0;font-size:24px;font-weight:600;line-height:1.4}.mp-page-title>text{color:var(--brand)}.mp-eyebrow,.mp-subtitle,.mp-small-note,.mp-footnote{color:var(--text-secondary);font-size:12px;font-weight:400;line-height:1.7}.mp-subtitle{margin-top:8px}.mp-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;margin:16px 0 8px}.mp-section-title{color:var(--text);font-size:18px;font-weight:600;line-height:1.5}.mp-section-title>text{margin-left:4px;color:var(--text-secondary);font-size:12px;font-weight:400}.mp-page .mp-text-action{flex:none;min-height:44px;color:var(--brand);font-size:12px;font-weight:500}.mp-card{padding:16px;border:0;border-radius:12px;background:var(--card,#fff)}.mp-empty{padding:20px 4px;color:var(--text-secondary);font-size:14px;line-height:1.8}.mp-empty .mp-section-title{margin-bottom:8px}.mp-footnote{padding:16px 0 0;text-align:center}.mp-error{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;padding:12px;border-radius:8px;background:var(--brand-soft);color:var(--brand);font-size:12px;line-height:1.7}.mp-search{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 10px;border-radius:8px;background:var(--page-bg);color:var(--text-secondary)}.mp-search>text{font-size:22px}.mp-search input{flex:1;min-width:0;height:44px;min-height:44px;margin:0;padding:0;border:0;background:transparent;color:var(--text);font-size:14px}.mp-avatar{flex:none;width:36px;height:36px;border-radius:8px}.mp-fallback{display:flex;align-items:center;justify-content:center;background:var(--page-bg);color:var(--text-secondary);font-size:14px;font-weight:500}.mp-page .mp-primary,.mp-page .mp-secondary{min-height:44px;margin-top:12px;padding:10px 14px;border-radius:8px;font-size:14px;font-weight:500}.mp-page .mp-primary{border:1px solid var(--brand);background:var(--brand);color:#fff}.mp-page .mp-secondary{border:1px solid var(--border);background:#fff;color:var(--text)}.tone-mint,.tone-blue,.tone-apricot,.tone-violet,.tone-rose,.tone-lime{background:var(--page-bg);color:var(--text-secondary)}.mp-overlay{position:fixed;z-index:90;inset:0;display:flex;align-items:flex-end;background:#0006}.mp-sheet{display:flex;flex-direction:column;width:100%;max-height:90vh;padding:16px 16px calc(20px + env(safe-area-inset-bottom));border-radius:12px 12px 0 0;background:var(--card,#fff);color:var(--text)}.mp-sheet .mp-section-head{margin-top:0;flex:none}.mp-page .mp-sheet-close{width:44px;min-height:44px;color:var(--text-secondary);font-size:28px}.mp-sheet-body{max-height:62vh;min-height:0}.mp-label{margin:12px 0 8px;color:var(--text);font-size:14px;font-weight:400}.mp-input,.mp-textarea{width:100%;min-height:44px;margin:0;padding:10px 12px;border:1px solid var(--border);border-radius:8px;background:var(--page-bg);color:var(--text);font-size:14px;line-height:1.7}.mp-input{height:44px}.mp-textarea{height:120px}.mp-form-row{display:flex;gap:12px}.mp-form-row>view{flex:1;min-width:0}
