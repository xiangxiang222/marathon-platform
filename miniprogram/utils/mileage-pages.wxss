page { background:var(--field-bg,var(--page-bg)); color:var(--text); }
.mp-page { padding:16px 16px calc(24px + env(safe-area-inset-bottom)); font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; }
.mp-page view,.mp-page button,.mp-page input,.mp-page textarea { box-sizing:border-box; }
.mp-page button { width:auto; margin:0; padding:0; min-height:44px; border:0; border-radius:0; background:transparent; color:inherit; font-size:14px; line-height:1.4; font-weight:500; }.mp-page button::after { border:0; }.mp-page button[disabled] { opacity:.45; }
.mp-eyebrow { color:var(--text-secondary); font-size:12px; letter-spacing:normal; font-weight:600; }.mp-page-title { margin-top:16rpx; font-size:24px; font-weight:600; letter-spacing:normal; }.mp-page-title>text { color:var(--brand); }.mp-subtitle { margin-top:18rpx; color:var(--text-secondary); font-size:12px; line-height:1.7; }
.mp-section-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:44px; margin:30rpx 2rpx 14rpx; }.mp-section-title { font-size:18px; color:var(--text); font-weight:600; line-height:1.5; }.mp-section-title>text { color:var(--text-secondary); font-size:12px; margin-left:8rpx; font-weight:400; }.mp-small-note { font-size:12px; color:var(--text-secondary); line-height:1.7; }
.mp-page .mp-text-action { min-height:44px; flex:none; font-size:12px; color:var(--text-secondary); }.mp-card { border-radius:24rpx; padding:16px; background:var(--card,#fff); }.mp-empty { padding:36rpx 12rpx; color:var(--text-secondary); font-size:12px; line-height:1.9; }.mp-empty .mp-section-title { margin-bottom:14rpx; }.mp-footnote { padding:28rpx 4rpx 0; color:var(--text-secondary); font-size:12px; line-height:1.8; text-align:center; }
.mp-error { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:18rpx 22rpx; margin-bottom:14rpx; border-radius:16rpx; background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); font-size:12px; line-height:1.6; }
.mp-search { display:flex; align-items:center; gap:14rpx; padding:0 20rpx; height:44px; border-radius:14rpx; background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }.mp-search>text { font-size:22px; }.mp-search input { flex:1; min-width:0; height:44px; padding:0; margin:0; border:0; background:transparent; font-size:12px; }
.mp-avatar { flex:none; width:72rpx; height:72rpx; border-radius:50%; }.mp-fallback { display:flex; align-items:center; justify-content:center; background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); font-size:14px; font-weight:600; }
.mp-page .mp-primary { min-height:46px; padding:16rpx 28rpx; margin-top:20rpx; background:var(--field-bg,var(--page-bg)); color:#fff; border-radius:18rpx; font-size:14px; font-weight:600; }.mp-page .mp-secondary { min-height:46px; padding:16rpx 28rpx; background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); border-radius:18rpx; font-size:14px; }
.tone-mint { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }.tone-blue { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }.tone-apricot { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }.tone-violet { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }.tone-rose { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }.tone-lime { background:var(--field-bg,var(--page-bg)); color:var(--text-secondary); }
.mp-overlay { position:fixed; z-index:90; inset:0; background:rgba(0,0,0,.4); display:flex; align-items:flex-end; }.mp-sheet { width:100%; padding:24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:24rpx 32rpx 0 0; background:var(--card,#fff); max-height:90vh; display:flex; flex-direction:column; }.mp-sheet .mp-section-head { margin-top:0; flex:none; }.mp-page .mp-sheet-close { width:44px; min-height:44px; font-size:28px; color:var(--text-secondary); }.mp-sheet-body { max-height:62vh; min-height:0; }.mp-label { margin:22rpx 0 14rpx; color:var(--text-secondary); font-size:12px; }.mp-input { width:100%; height:48px; border:1rpx solid var(--border); border-radius:16rpx; padding:0 22rpx; margin:0; background:var(--card,#fff); color:var(--text); font-size:14px; }.mp-textarea { width:100%; min-height:120px; height:240rpx; padding:20rpx 22rpx; border:1rpx solid var(--border); border-radius:16rpx; background:var(--card,#fff); color:var(--text); font-size:14px; line-height:1.7; }.mp-form-row { display:flex; gap:20rpx; }.mp-form-row>view { flex:1; min-width:0; }

/* Club tools follow the same typography, surfaces and action hierarchy. */
page { color:var(--text); background:var(--page-bg); }
.mp-page { color:var(--text); font-size:14px; letter-spacing:normal; }
.mp-page-title { margin-top:0; font-size:24px; font-weight:600; line-height:1.4; letter-spacing:normal; }
.mp-eyebrow,.mp-subtitle,.mp-small-note,.mp-footnote { color:var(--text-secondary); font-size:12px; font-weight:400; letter-spacing:normal; }
.mp-page-title>text { color:var(--brand); }
.mp-section-title { color:var(--text); font-size:18px; font-weight:600; }
.mp-section-title>text { color:var(--text-secondary); font-size:12px; }
.mp-card { border:1rpx solid var(--border); border-radius:24rpx; background:var(--card,#fff); padding:16px; }
.mp-page .mp-text-action { min-height:44px; font-size:12px; color:var(--brand); font-weight:500; }
.mp-page .mp-primary,.mp-page .mp-secondary { min-height:44px; border-radius:20rpx; padding:18rpx 28rpx; font-size:14px; font-weight:500; }
.mp-page .mp-primary { background:var(--brand); color:#fff; border:1rpx solid var(--brand); }
.mp-page .mp-secondary { background:var(--card,#fff); color:var(--text); border:1rpx solid var(--border); }
.mp-search { min-height:44px; border-radius:20rpx; background:var(--page-bg); color:var(--text-secondary); }
.mp-search input { min-height:44px; font-size:14px; color:var(--text); }
.mp-label { color:var(--text); font-size:14px; font-weight:400; }
.mp-input,.mp-textarea { border:1rpx solid var(--border); border-radius:20rpx; color:var(--text); background:var(--page-bg); font-size:14px; }
.mp-input { min-height:44px; }
.mp-sheet { border-radius:24rpx 24rpx 0 0; background:var(--card,#fff); color:var(--text); }
.mp-page .mp-sheet-close { min-height:44px; min-width:44px; color:var(--text-secondary); }
.mp-fallback,.tone-mint,.tone-blue,.tone-apricot,.tone-violet,.tone-rose,.tone-lime { background:var(--page-bg); color:var(--text-secondary); }
.mp-error { color:var(--brand); background:var(--brand-soft); }
.mp-empty { font-size:14px; color:var(--text-secondary); }
