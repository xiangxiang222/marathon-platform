:host{display:block}.mileage-board{--mb-ink:#1a1a1a;--mb-muted:#777;--mb-line:#eee;--mb-bg:#f5f5f5;--mb-red:#ff1838;--mb-red-soft:#fff0f2;padding:16px 0;background:var(--mb-bg);color:var(--mb-ink);font-size:14px;line-height:1.5}
.mileage-board view,.mileage-board button,.mileage-board input,.mileage-board picker{box-sizing:border-box}.mileage-board button{display:flex;align-items:center;justify-content:center;flex:none;width:auto;min-width:0;min-height:44px;margin:0;padding:0;border:0;border-radius:8px;background:transparent;color:inherit;font-size:14px;line-height:1.5;font-weight:400}.mileage-board button::after{border:0}
.mb-heading,.mb-section-heading,.mb-summary-top,.mb-table-head,.mb-mine{display:flex;align-items:center;justify-content:space-between;gap:12px}.mb-title,.mb-section-title{color:var(--mb-ink);font-size:18px;font-weight:600;line-height:1.4}.mb-kicker,.mb-caption{margin-top:4px;color:var(--mb-muted);font-size:12px}.mileage-board .mb-link{min-height:44px;padding:0 2px;color:var(--mb-red);font-size:12px;white-space:nowrap}.mb-link>text{padding-left:4px;font-size:16px}
.mb-period-toolbar{margin:8px 0 12px;padding:0 12px;border-radius:12px;background:#fff}.mb-ranges{display:flex;border-bottom:1px solid var(--mb-line)}.mileage-board .mb-range{flex:1;width:0;border-radius:0;color:var(--mb-muted)}.mileage-board .mb-range.is-active{color:var(--mb-red);box-shadow:inset 0 -2px var(--mb-red);font-weight:500}.mb-period{display:flex;align-items:center;gap:4px;min-height:44px;color:var(--mb-ink);font-size:14px}.mileage-board .mb-period-arrow{width:44px;height:44px;font-size:24px;color:var(--mb-muted)}.mb-period-arrow[disabled]{opacity:.35}.mb-period picker{flex:1;min-width:0}.mb-period-label{display:flex;align-items:center;justify-content:center;gap:6px;min-height:44px;white-space:nowrap}.mb-all-period{justify-content:center;color:var(--mb-muted)}
.mb-loading{padding:32px 12px;color:var(--mb-muted);text-align:center}.mb-error{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border-radius:8px;background:var(--mb-red-soft);color:var(--mb-red);font-size:12px}
.mb-summary{padding:16px;border:0;border-radius:12px;background:#fff}.mb-summary-label{min-width:0;color:var(--mb-muted);font-size:12px;word-break:break-all}.mb-summary-badge{flex:none;color:var(--mb-muted);font-size:12px}.mb-total{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;margin:10px 0 16px;color:var(--mb-ink);font-size:34px;font-weight:600;line-height:1.2;word-break:break-all;font-variant-numeric:tabular-nums}.mb-total.is-long{font-size:28px}.mb-total-value{font-size:inherit;font-weight:inherit;white-space:nowrap}.mb-total-unit{color:var(--mb-muted);font-size:12px;font-weight:400;white-space:nowrap}.mb-stats{display:flex;gap:8px;padding-top:14px;border-top:1px solid var(--mb-line)}.mb-stats>view{display:flex;flex-direction:column;flex:1;min-width:0;gap:4px}.mb-stat-number{color:var(--mb-ink);font-size:20px;font-weight:600;line-height:1.4;word-break:break-all;font-variant-numeric:tabular-nums}.mb-stat-unit,.mb-stat-label{color:var(--mb-muted);font-size:12px;font-weight:400}
.mb-groups-panel{margin-top:12px;padding:16px;border-radius:12px;background:#fff}.mb-section-heading{min-height:44px;margin:0 0 8px}.mb-group-cards{display:flex;flex-direction:column}.mileage-board .mb-group-card{display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:78px;padding:12px 0;border-top:1px solid var(--mb-line);border-radius:0;background:transparent;text-align:left}.mileage-board .mb-group-card.group-selected{margin:0 -8px;padding-left:8px;padding-right:8px;width:calc(100% + 16px);border-radius:8px;background:var(--mb-red-soft)}.mb-group-copy{flex:1;min-width:0}.mb-group-name{color:var(--mb-ink);font-size:15px;font-weight:500;line-height:1.5;word-break:break-all}.mb-group-pace,.mb-group-members{margin-top:4px;color:var(--mb-muted);font-size:12px;line-height:1.5;word-break:break-all}.mb-group-km{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:flex-end;gap:3px;flex:none;max-width:43%;color:var(--mb-ink);font-size:22px;font-weight:600;line-height:1.2;font-variant-numeric:tabular-nums;word-break:break-all}.mb-group-km.is-long{font-size:18px}.mb-group-km.is-long .mb-group-km-value{white-space:normal}.mb-group-km-value{font-size:inherit;font-weight:inherit;white-space:nowrap}.mb-group-km-unit{font-size:12px;font-weight:400;white-space:nowrap}.mb-group-arrow{font-size:18px;color:var(--mb-muted)}.mileage-board .mb-groups-toggle{width:100%;gap:8px;color:var(--mb-red);font-size:12px}.mb-empty-groups{padding:12px 0;color:var(--mb-muted);font-size:12px;line-height:1.7}.mb-empty-title{margin-bottom:6px;color:var(--mb-ink);font-size:14px;font-weight:500}.mileage-board .mb-outline{width:100%;margin-top:12px;border:1px solid var(--mb-line);color:var(--mb-red);font-size:12px}
.mb-rank-card{margin-top:12px;padding:16px;border-radius:12px;background:#fff}.mb-rank-card .mb-section-heading{margin:0;min-height:0}.mb-count{flex:none;color:var(--mb-muted);font-size:12px}.mb-rank-filters{display:flex;flex-direction:column;gap:8px;margin:12px 0}.mb-group-picker{display:block;width:100%;min-width:0}.mb-picker-row{display:flex;align-items:center;gap:12px;min-width:0;min-height:44px;padding:0 12px;border-radius:8px;background:var(--mb-bg)}.mb-picker-caption{flex:none;color:var(--mb-muted);font-size:12px}.mb-picker-value{flex:1;min-width:0;overflow:hidden;color:var(--mb-ink);font-size:14px;white-space:nowrap;text-overflow:ellipsis}.mb-picker-arrow{flex:none;color:var(--mb-muted)}.mb-search{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 10px;border-radius:8px;background:var(--mb-bg)}.mb-search-icon{position:relative;flex:none;width:12px;height:12px;margin:0 3px 2px 0;border:1.5px solid #999;border-radius:50%}.mb-search-icon::after{position:absolute;right:-5px;bottom:-3px;width:6px;height:1.5px;background:#999;transform:rotate(45deg);content:''}.mb-search input{flex:1;width:0;min-width:0;min-height:44px;height:44px;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:var(--mb-ink);font-size:14px}.mileage-board .mb-clear{width:44px;color:var(--mb-muted);font-size:20px}
.mb-mine{padding:12px;border-radius:8px;background:var(--mb-red-soft);font-size:12px}.mb-mine>text:first-child{min-width:0;font-weight:500}.mb-mine-place{display:block;margin-top:3px;color:var(--mb-muted);font-size:12px;font-weight:400}.mb-mine>text:last-child{min-width:0;font-size:22px;font-weight:600;text-align:right;word-break:break-all}.mb-mine-unit{font-size:12px;font-weight:400}.mb-table-head{margin-top:16px;padding-bottom:9px;color:var(--mb-muted);font-size:12px}
.mileage-board .mb-person{display:flex;align-items:center;gap:8px;width:100%;min-height:72px;padding:10px 0;border-bottom:1px solid var(--mb-line);border-radius:0;text-align:left}.mileage-board .mb-person.is-mine{border-radius:8px;background:#fafafa}.mb-place{flex:none;width:16px;color:#999;font-size:12px;text-align:center;font-variant-numeric:tabular-nums}.place-1,.place-2,.place-3{color:var(--mb-red)}.mb-avatar{display:flex;align-items:center;justify-content:center;flex:none;width:36px;height:36px;overflow:hidden;border-radius:8px}.mb-initial{background:var(--mb-bg);color:var(--mb-muted);font-size:14px}.mb-person-copy{flex:1;min-width:0}.mb-person-name{overflow:hidden;color:var(--mb-ink);font-size:14px;font-weight:500;line-height:1.5;white-space:nowrap;text-overflow:ellipsis}.mb-me-tag{margin-left:4px;padding:0 3px;border-radius:3px;background:var(--mb-red-soft);color:var(--mb-red);font-size:12px;font-weight:400}.mb-person-meta{margin-top:4px;overflow:hidden;color:var(--mb-muted);font-size:12px;white-space:nowrap;text-overflow:ellipsis}.mb-person-distance{flex:none;max-width:38%;color:var(--mb-ink);font-size:20px;font-weight:600;text-align:right;font-variant-numeric:tabular-nums;word-break:break-all}.mb-person-chevron{margin-left:5px;color:#999;font-size:15px;font-weight:400}.mb-progress-track{width:46px;height:3px;margin:7px 12px 0 auto;overflow:hidden;border-radius:3px;background:var(--mb-bg)}.mb-progress{height:100%;background:#999}.mb-empty-rank{padding:24px 5px;color:var(--mb-muted);font-size:14px;text-align:center}.mb-bottom-note{padding:16px 0 12px;color:var(--mb-muted);font-size:12px;line-height:1.8;text-align:center}.mileage-board .mb-tools{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:0;border-top:1px solid var(--mb-line);font-size:14px}
@media(max-width:350px){.mb-total{font-size:32px}.mb-stat-number{font-size:18px}.mb-person{gap:6px}.mb-place{width:12px}.mb-person-distance{font-size:18px}.mb-person-chevron{display:none}}
