:host { display:block; }
.mileage-board{--mb-ink:#1a1a1a;--mb-muted:#777;--mb-line:#eee;--mb-bg:#f5f5f5;--mb-red:#ff1838;--mb-red-soft:#fff0f2;padding:16px 0;border-radius:0;background:var(--mb-bg);color:var(--mb-ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.5}
.mileage-board view,.mileage-board button,.mileage-board input,.mileage-board picker { box-sizing:border-box; }
.mileage-board button { display:flex; align-items:center; justify-content:center; flex:none; width:auto; min-width:0; min-height:44px; margin:0; padding:0; border:0; border-radius:10px; background:transparent; color:inherit; font-size:13px; font-weight:400; line-height:1.5; }
.mileage-board button::after { border:0; }
.mb-heading,.mb-section-heading,.mb-summary-top,.mb-group-top,.mb-table-head,.mb-mine { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.mb-heading { padding:0; }
.mb-title{font-size:18px;font-weight:600;line-height:1.4}
.mb-kicker { margin-top:4px; color:var(--mb-muted); font-size:12px; line-height:1.6; }
.mileage-board .mb-link { flex:none; width:auto; min-height:44px; padding:0 2px; color:var(--mb-red); font-size:12px; font-weight:500; white-space:nowrap; }
.mb-link>text { padding-left:4px; font-size:16px; }
.mb-ranges{display:flex;gap:0;margin-top:12px;padding:0;border:0;border-bottom:1px solid var(--mb-line);border-radius:0;background:transparent}
.mileage-board .mb-range{flex:1;width:0;min-width:0;min-height:44px;border-radius:0;color:var(--mb-muted);font-size:14px}
.mileage-board .mb-range.is-active{background:transparent;color:var(--mb-red);font-weight:500;box-shadow:inset 0 -2px var(--mb-red)}
.mb-period { display:flex; align-items:center; gap:4px; min-height:52px; margin:4px 0 12px; color:var(--mb-muted); font-size:12px; }
.mileage-board .mb-period-arrow { flex:none; width:44px; height:44px; font-size:24px; color:var(--mb-muted); }
.mileage-board .mb-period-arrow[disabled] { opacity:.35; }
.mb-period picker { flex:1; min-width:0; }
.mb-period-label { display:flex; align-items:center; justify-content:center; gap:6px; min-height:44px; font-size:12px; white-space:nowrap; }
.mb-all-period { justify-content:center; }
.mb-loading { padding:48px 12px; color:var(--mb-muted); font-size:13px; text-align:center; }
.mb-error { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:13px; border:1px solid #f3d8dd; border-radius:12px; background:var(--mb-red-soft); color:var(--mb-red); font-size:12px; line-height:1.8; }
.mb-summary{position:relative;margin-top:4px;padding:16px;border:1px solid var(--mb-line);border-radius:12px;background:#fff;color:var(--mb-ink)}
.mb-summary-top { gap:10px; }
.mb-summary-label{min-width:0;color:var(--mb-muted);font-size:12px;word-break:break-all}
.mb-summary-badge{flex:none;padding:0;color:var(--mb-muted);border:0;border-radius:0;font-size:12px;line-height:1.5}
.mb-total{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;margin:16px 0 20px;color:var(--mb-ink);font-size:40px;font-weight:600;line-height:1.15;font-variant-numeric:tabular-nums;word-break:break-all}
.mb-total.is-long { font-size:30px; letter-spacing:-.5px; }
.mb-total .mb-total-value { margin:0; color:inherit; font-size:inherit; font-weight:inherit; white-space:nowrap; }
.mb-total .mb-total-unit{margin-left:0;color:var(--mb-muted);font-size:12px;font-weight:400;letter-spacing:normal;white-space:nowrap}
.mb-stats{display:flex;gap:10px;padding-top:14px;border-top:1px solid var(--mb-line)}
.mb-stats>view { flex:1; min-width:0; display:flex; flex-direction:column; gap:5px; }
.mb-stats>view+view{padding-left:10px;border-left:1px solid var(--mb-line)}
.mb-stat-number{color:var(--mb-ink);font-size:18px;font-weight:600;line-height:1.4;font-variant-numeric:tabular-nums;word-break:break-all}
.mb-stat-unit,.mb-stat-label{color:var(--mb-muted);font-size:12px;font-weight:400}
.mb-section-heading { min-height:44px; margin:18px 0 8px; }
.mb-section-title { color:var(--mb-ink); font-size:18px; font-weight:600; line-height:1.4; }
.mb-group-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.mileage-board .mb-group-card{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;width:100%;min-width:0;min-height:134px;padding:12px;border:1px solid var(--mb-line);border-radius:10px;background:#fff;color:var(--mb-ink);text-align:left}
.mileage-board .mb-group-card.group-selected { border-color:#ffb6c0; background:var(--mb-red-soft); }
.mb-group-top { align-items:flex-start; gap:5px; }
.mb-group-top>text { flex:none; color:var(--mb-red); font-size:14px; }
.mb-group-name{display:-webkit-box;min-height:36px;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;color:var(--mb-ink);font-size:14px;font-weight:500;line-height:18px;word-break:break-all}
.mb-group-pace { margin-top:4px; overflow:hidden; color:var(--mb-muted); font-size:12px; white-space:nowrap; text-overflow:ellipsis; }
.mb-group-km{display:flex;flex-wrap:wrap;align-items:baseline;gap:3px;margin-top:12px;color:var(--mb-ink);font-size:24px;font-weight:600;line-height:1.2;font-variant-numeric:tabular-nums;word-break:break-all}
.mb-group-km.is-long { font-size:15px; }
.mb-group-km .mb-group-km-value { color:inherit; font-size:inherit; font-weight:inherit; white-space:nowrap; }
.mb-group-km .mb-group-km-unit { font-size:12px; font-weight:400; white-space:nowrap; }
.mb-group-members { margin-top:7px; color:var(--mb-muted); font-size:12px; line-height:1.5; }
.mileage-board .mb-groups-toggle { width:100%; min-height:44px; gap:8px; margin-top:4px; color:var(--mb-red); font-size:12px; }
.mb-groups-toggle>text { font-size:16px; }
.mb-rank-card { margin-top:24px; padding:16px 14px 12px; border:1px solid var(--mb-line); border-radius:12px; background:#fff; }
.mb-rank-card .mb-section-heading { margin:0 0 14px; min-height:0; }
.mb-caption { margin-top:4px; color:var(--mb-muted); font-size:12px; line-height:1.6; }
.mb-count { flex:none; color:var(--mb-muted); font-size:12px; }
.mb-group-picker { display:block; width:100%; min-width:0; margin-bottom:10px; }
.mb-picker-row { display:flex; align-items:center; gap:12px; min-width:0; min-height:44px; padding:0 12px; border:1px solid var(--mb-line); border-radius:10px; background:var(--mb-bg); }
.mb-picker-caption { flex:none; color:var(--mb-muted); font-size:12px; }
.mb-picker-value { flex:1; min-width:0; overflow:hidden; color:var(--mb-ink); font-size:13px; white-space:nowrap; text-overflow:ellipsis; }
.mb-picker-arrow { flex:none; color:var(--mb-muted); font-size:14px; }
.mb-search { display:flex; align-items:center; gap:8px; min-height:44px; margin:0 0 12px; padding:0 10px; border:1px solid var(--mb-line); border-radius:10px; background:var(--mb-bg); }
.mb-search-icon { position:relative; flex:none; width:12px; height:12px; margin:0 3px 2px 0; border:1.5px solid #999999; border-radius:50%; }
.mb-search-icon::after { position:absolute; right:-5px; bottom:-3px; width:6px; height:1.5px; background:#999999; transform:rotate(45deg); content:''; }
.mb-search input { flex:1; width:0; min-width:0; min-height:44px; height:44px; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:var(--mb-ink); font-size:13px; }
.mileage-board .mb-clear { flex:none; width:44px; min-height:44px; color:var(--mb-muted); font-size:20px; }
.mb-mine{padding:12px;border:1px solid #ffdce2;border-left:3px solid var(--mb-red);border-radius:8px;background:var(--mb-red-soft);color:var(--mb-ink);font-size:12px}
.mb-mine>text:first-child { min-width:0; font-weight:600; }
.mb-mine-place { display:block; margin-top:3px; color:var(--mb-muted); font-size:12px; font-weight:400; }
.mb-mine>text:last-child{min-width:0;font-size:24px;font-weight:600;text-align:right;word-break:break-all}
.mb-mine-unit { font-size:12px; font-weight:400; }
.mb-table-head { margin-top:16px; padding-bottom:9px; color:var(--mb-muted); font-size:12px; }
.mileage-board .mb-person { display:flex; align-items:center; gap:8px; width:100%; min-height:76px; padding:10px 0; border-bottom:1px solid var(--mb-line); text-align:left; }
.mileage-board .mb-person.is-mine { border-radius:10px; background:#fafafa; }
.mb-person:last-child { border-bottom:0; }
.mb-place { flex:none; width:18px; color:#999999; font-size:13px; font-weight:500; text-align:center; font-variant-numeric:tabular-nums; }
.place-1,.place-2,.place-3{color:var(--mb-muted);font-weight:500}
.mb-avatar{display:flex;flex:none;align-items:center;justify-content:center;width:32px;height:32px;overflow:hidden;border:1px solid var(--mb-line);border-radius:8px}
.mb-initial{background:var(--mb-bg);color:var(--mb-muted);font-size:13px}
.mb-person-copy { flex:1; min-width:0; }
.mb-person-name { overflow:hidden; color:var(--mb-ink); font-size:13px; font-weight:500; line-height:1.5; white-space:nowrap; text-overflow:ellipsis; }
.mb-me-tag { margin-left:4px; padding:0 3px; border-radius:4px; background:var(--mb-red-soft); color:var(--mb-red); font-size:12px; font-weight:400; }
.mb-person-meta { margin-top:5px; overflow:hidden; color:var(--mb-muted); font-size:12px; white-space:nowrap; text-overflow:ellipsis; }
.mb-person-distance { flex:none; max-width:39%; color:var(--mb-ink); font-size:19px; font-weight:600; text-align:right; font-variant-numeric:tabular-nums; word-break:break-all; }
.mb-person-chevron { margin-left:5px; color:#999999; font-size:15px; font-weight:400; }
.mb-progress-track { width:46px; height:3px; margin:7px 12px 0 auto; overflow:hidden; border-radius:3px; background:var(--mb-bg); }
.mb-progress{height:100%;border-radius:0;background:#999}
.mb-empty-groups { padding:16px; border:1px solid var(--mb-line); border-radius:12px; background:#fff; color:var(--mb-muted); font-size:12px; line-height:1.7; }
.mb-empty-title { margin-bottom:6px; color:var(--mb-ink); font-size:14px; font-weight:500; }
.mileage-board .mb-outline { width:100%; min-height:44px; margin-top:12px; border:1px solid var(--mb-line); border-radius:10px; background:var(--mb-bg); color:var(--mb-red); font-size:12px; }
.mb-empty-rank { padding:26px 5px; color:var(--mb-muted); font-size:12px; line-height:1.8; text-align:center; }
.mb-bottom-note { padding:16px 0 12px; color:var(--mb-muted); font-size:12px; line-height:1.8; text-align:center; }
.mileage-board .mb-tools { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:48px; padding:0; border-top:1px solid var(--mb-line); color:var(--mb-ink); font-size:13px; }
@media(max-width:350px) { .mileage-board{--mb-ink:#1a1a1a;--mb-muted:#777;--mb-line:#eee;--mb-bg:#f5f5f5;--mb-red:#ff1838;--mb-red-soft:#fff0f2;padding:16px 0;border-radius:0;background:var(--mb-bg);color:var(--mb-ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.5}.mb-title{font-size:18px;font-weight:600;line-height:1.4}.mb-kicker { max-width:160px; }.mb-total{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;margin:16px 0 20px;color:var(--mb-ink);font-size:40px;font-weight:600;line-height:1.15;font-variant-numeric:tabular-nums;word-break:break-all}.mb-summary{position:relative;margin-top:4px;padding:16px;border:1px solid var(--mb-line);border-radius:12px;background:#fff;color:var(--mb-ink)}.mb-stats{display:flex;gap:10px;padding-top:14px;border-top:1px solid var(--mb-line)}.mb-stats>view+view{padding-left:10px;border-left:1px solid var(--mb-line)}.mb-stat-number{color:var(--mb-ink);font-size:18px;font-weight:600;line-height:1.4;font-variant-numeric:tabular-nums;word-break:break-all}.mb-total.is-long { font-size:26px; }.mb-group-km.is-long { font-size:13px; }.mb-group-cards { gap:8px; }.mileage-board .mb-group-card{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;width:100%;min-width:0;min-height:134px;padding:12px;border:1px solid var(--mb-line);border-radius:10px;background:#fff;color:var(--mb-ink);text-align:left}.mb-group-km{display:flex;flex-wrap:wrap;align-items:baseline;gap:3px;margin-top:12px;color:var(--mb-ink);font-size:24px;font-weight:600;line-height:1.2;font-variant-numeric:tabular-nums;word-break:break-all}.mb-rank-card { padding:14px 12px 12px; }.mb-person { gap:6px; }.mb-place { width:13px; }.mb-avatar{display:flex;flex:none;align-items:center;justify-content:center;width:32px;height:32px;overflow:hidden;border:1px solid var(--mb-line);border-radius:8px}.mb-person-distance { font-size:17px; }.mb-person-chevron { display:none; } }
