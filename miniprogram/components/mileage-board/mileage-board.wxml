<view class="mileage-board">
  <view class="mb-heading"><view><view class="mb-title">跑量看板</view><view class="mb-kicker">让每一份坚持，都有迹可循</view></view><button class="mb-link" bindtap="openGroups">训练组 <text>↗</text></button></view>
  <view class="mb-ranges"><button wx:for="{{ranges}}" wx:key="id" class="mb-range {{range === item.id ? 'is-active' : ''}}" data-range="{{item.id}}" bindtap="pickRange">{{item.name}}</button></view>
  <view class="mb-period" wx:if="{{range !== 'all'}}"><button class="mb-period-arrow" data-direction="-1" bindtap="changePeriod" aria-label="上一周期">‹</button><picker mode="date" value="{{date}}" end="{{today}}" bindchange="pickDate"><view class="mb-period-label">{{(board && board.period && board.period.label) || date}} <text>⌄</text></view></picker><button class="mb-period-arrow" data-direction="1" bindtap="changePeriod" disabled="{{!canNext}}" aria-label="下一周期">›</button></view>
  <view class="mb-period mb-all-period" wx:else>从加入跑团开始，记录每一次坚持</view>
  <view wx:if="{{loading}}" class="mb-loading" aria-role="status">正在整理大家的跑量…</view>
  <view wx:if="{{message}}" class="mb-error"><text>{{message}}</text><button class="mb-link" bindtap="load">重试 ↻</button></view>
  <block wx:if="{{board && !loading}}">
    <view class="mb-summary"><view class="mb-summary-top"><text class="mb-summary-label">{{selectedName}}总跑量</text><text class="mb-summary-badge">{{range === 'all' ? '累计里程' : '本期里程'}}</text></view><view class="mb-total {{board.kmLabel.length > 8 ? 'is-long' : ''}}"><text class="mb-total-value">{{board.kmLabel}}</text><text class="mb-total-unit">km</text></view><view class="mb-stats"><view><text class="mb-stat-number">{{board.summaryActiveLabel}}<text class="mb-stat-unit"> / {{board.summaryMembersLabel}}</text></text><text class="mb-stat-label">跑步成员</text></view><view><text class="mb-stat-number">{{board.summaryTimesLabel}}<text class="mb-stat-unit"> 次</text></text><text class="mb-stat-label">跑步记录</text></view><view><text class="mb-stat-number">{{board.average}}<text class="mb-stat-unit"> km</text></text><text class="mb-stat-label">成员人均</text></view></view></view>
    <view class="mb-section-heading"><view class="mb-section-title">训练组跑量</view><button class="mb-link" bindtap="openGroups">{{board.staff ? '管理组别' : '查看组别'}} ›</button></view>
    <view class="mb-group-cards"><button wx:for="{{shownGroups}}" wx:key="id" class="mb-group-card {{groupId === '' + item.id ? 'group-selected' : ''}}" data-id="{{item.id}}" bindtap="pickGroup" aria-label="查看{{item.name}}跑量"><view class="mb-group-top"><view class="mb-group-name">{{item.name}}</view><text>↗</text></view><view class="mb-group-pace">{{item.pace || '按个人节奏'}}</view><view class="mb-group-km {{item.kmLabel.length > 7 ? 'is-long' : ''}}"><text class="mb-group-km-value">{{item.kmLabel}}</text><text class="mb-group-km-unit">km</text></view><view class="mb-group-members">{{item.activeMembers}} 位活跃 · {{item.memberCount}} 位成员</view></button></view>
    <button wx:if="{{board.groups.length > 4}}" class="mb-groups-toggle" bindtap="toggleGroups" aria-expanded="{{groupsExpanded}}">{{groupsExpanded ? '收起组别' : '查看全部 ' + board.groups.length + ' 个组别'}}<text>{{groupsExpanded ? '⌃' : '⌄'}}</text></button>
    <view wx:if="{{!board.groups.length}}" class="mb-empty-groups"><view class="mb-empty-title">找到同频的训练伙伴</view><view>按配速建立 A、B、C 组，跑量与活动一起安排。</view><button class="mb-outline" bindtap="openGroups">{{board.staff ? '＋ 创建训练组' : '查看训练组'}}</button></view>
    <view class="mb-rank-card"><view class="mb-section-heading"><view><view class="mb-section-title">成员里程榜</view><view class="mb-caption">每份坚持，都值得被看见</view></view><text class="mb-count">{{board.rank.length}} 人</text></view>
      <picker class="mb-group-picker" range="{{groupOptions}}" range-key="name" value="{{selectedGroupIndex}}" bindchange="selectGroup" aria-label="选择排行榜训练组"><view class="mb-picker-row"><text class="mb-picker-caption">查看组别</text><text class="mb-picker-value">{{selectedName}}</text><text class="mb-picker-arrow">⌄</text></view></picker>
      <view class="mb-search"><view class="mb-search-icon"></view><input value="{{query}}" bindinput="onQuery" placeholder="找一位团友" maxlength="50" aria-label="搜索跑量榜成员" /><button wx:if="{{query}}" class="mb-clear" bindtap="clearQuery" aria-label="清空成员搜索">×</button></view>
      <view class="mb-mine" wx:if="{{mine}}"><text>我的本期 <text class="mb-mine-place">{{mine.km > 0 ? '第 ' + mine.place + ' 名' : '等待出发'}}</text></text><text>{{mine.kmLabel}} <text class="mb-mine-unit">km</text></text></view>
      <view class="mb-table-head"><text>排名 / 团友</text><text>跑量 · km</text></view>
      <button wx:for="{{shownRank}}" wx:key="userId" class="mb-person {{item.mine ? 'is-mine' : ''}}" data-id="{{item.userId}}" bindtap="openMember" aria-label="查看{{item.nickname}}的成员主页"><text class="mb-place place-{{item.place <= 3 && item.km > 0 ? item.place : 'other'}}">{{item.km > 0 ? item.place : '—'}}</text><image wx:if="{{item.avatar}}" class="mb-avatar" src="{{item.avatar}}" mode="aspectFill" /><view wx:else class="mb-avatar mb-initial tone-{{item.color}}">{{item.initial}}</view><view class="mb-person-copy"><view class="mb-person-name">{{item.nickname}}<text wx:if="{{item.mine}}" class="mb-me-tag">我</text></view><view class="mb-person-meta">{{item.group || '未分组'}} · {{item.times}} 次</view></view><view class="mb-person-distance"><view>{{item.kmLabel}}<text class="mb-person-chevron">›</text></view><view class="mb-progress-track"><view class="mb-progress" style="width:{{item.progress}}%;"></view></view></view></button>
      <view wx:if="{{!shownRank.length}}" class="mb-empty-rank">{{query ? '没有找到这位团友，换个昵称试试。' : '这一组还没有成员，和团友一起开始吧。'}}</view>
    </view>
    <view class="mb-bottom-note">仅统计计入本团的跑量 · 按当前训练组汇总 · 北京时间</view>
    <button wx:if="{{embedded}}" class="mb-tools" bindtap="openTools"><text>跑步动态、报表与计入规则</text><text>›</text></button>
  </block>
</view>
