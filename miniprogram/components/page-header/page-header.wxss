:host { display: block; }
.page-header { position: relative; padding-bottom: 28rpx; background: linear-gradient(135deg,#fff0f2,#fffafa); color: var(--text); }
.header-main { display: flex; align-items: center; padding-left: 32rpx; box-sizing: border-box; }
.header-title { flex: 1; min-width: 0; overflow: hidden; font-size: 24px; line-height: 1.3; font-weight: 600; letter-spacing: normal; white-space: nowrap; text-overflow: ellipsis; }
.header-subtitle { padding: 0 32rpx 24rpx; color: var(--text-secondary); font-size: 12px; line-height: 1.5; }
@media (max-width: 350px) { .header-main { padding-left: 14px; } .header-subtitle { padding-left: 14px; padding-right: 14px; } }

.header-actions { display: flex; flex: none; align-items: center; justify-content: flex-end; }

.header-actions { position: relative; color: var(--text); }
.tab-page-header { overflow: hidden; padding-bottom: 20px; background: radial-gradient(ellipse at 100% 30%,#ffe1e7 0,transparent 66%),linear-gradient(135deg,#fff0f2,#fffafa); }
.tab-page-header::before,.tab-page-header::after { position: absolute; top: 64px; right: -80px; width: 240px; height: 240px; border: 1px solid #ffffffb3; border-radius: 50%; content: ''; pointer-events: none; }
.tab-page-header::after { top: 80px; right: -64px; width: 208px; height: 208px; }
.tab-page-header .header-main { position: relative; z-index: 1; }
.tab-header-feature { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 106px; margin-top: 6px; padding: 0 16px; }
.tab-header-copy { flex: 1; min-width: 0; }
.tab-header-eyebrow { display: inline-flex; align-items: center; color: var(--brand); font-size: 12px; line-height: 1.5; }
.tab-header-eyebrow::before { width: 3px; height: 11px; margin-right: 6px; border-radius: 2px; background: currentColor; content: ''; }
.tab-header-headline { margin: 6px 0; color: var(--text); font-size: 20px; line-height: 1.4; font-weight: 600; letter-spacing: normal; }
.tab-header-subtitle { max-width: 340px; color: var(--text-secondary); font-size: 12px; line-height: 1.6; }
.tab-header-art { position: relative; display: flex; align-items: center; justify-content: center; flex: 0 0 104px; width: 104px; height: 104px; }
.tab-header-art::before { position: absolute; top: 12px; right: 2px; bottom: 4px; left: 2px; border-radius: 50%; background: #ffffff80; content: ''; }
.tab-header-art image { position: relative; display: block; width: 104px; height: 104px; }
@media (max-width: 350px) { .tab-header-feature { gap: 8px; padding-right: 14px; padding-left: 14px; }.tab-header-headline { font-size: 18px; }.tab-header-art { flex-basis: 84px; width: 84px; height: 92px; }.tab-header-art image { width: 88px; height: 88px; } }
