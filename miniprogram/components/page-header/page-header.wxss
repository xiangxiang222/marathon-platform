:host { display: block; }
.page-header { position: relative; padding-bottom: 28rpx; background: var(--brand-header); color: #fff; }
.header-main { display: flex; align-items: center; padding-left: 32rpx; box-sizing: border-box; }
.header-title { flex: 1; min-width: 0; overflow: hidden; font-size: 24px; line-height: 1.3; font-weight: 600; letter-spacing: normal; white-space: nowrap; text-overflow: ellipsis; }
.header-subtitle { padding: 0 32rpx 24rpx; color: #ffffffcf; font-size: 12px; line-height: 1.5; }
@media (max-width: 350px) { .header-main { padding-left: 14px; } .header-subtitle { padding-left: 14px; padding-right: 14px; } }

.header-actions { display: flex; flex: none; align-items: center; justify-content: flex-end; }

.header-actions { position: relative; color: #fff; }
